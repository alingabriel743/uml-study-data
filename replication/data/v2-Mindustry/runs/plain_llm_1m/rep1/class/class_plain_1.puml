@startuml CoreGameArchitecture
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Core Game Architecture

class Vars <<static>> {
    +{static} net: Net
    +{static} content: ContentLoader
    +{static} state: GameState
    +{static} world: World
    +{static} control: Control
    +{static} logic: Logic
    +{static} renderer: Renderer
    +{static} ui: UI
    +{static} netServer: NetServer
    +{static} netClient: NetClient
    +{static} platform: Platform
    +{static} mods: Mods
    +{static} maps: Maps
    +{static} pathfinder: Pathfinder
    +{static} controlPath: ControlPathfinder
    +{static} indexer: BlockIndexer
    +{static} spawner: WaveSpawner
    +{static} fogControl: FogControl
    +{static} player: Player
}

class Control {
    +saves: Saves
    +sound: SoundControl
    +input: InputHandler
    +playMap(map, rules)
    +playSector(sector)
    +update()
}

class Logic {
    +play()
    +reset()
    +runWave()
    +checkGameState()
    +gameOver(winner)
    +update()
}

class Renderer {
    +blocks: BlockRenderer
    +fog: FogRenderer
    +minimap: MinimapRenderer
    +lights: LightRenderer
    +pixelator: Pixelator
    +planets: PlanetRenderer
    +camerascale: float
    +draw()
    +update()
}

class UI {
    +menufrag: MenuFragment
    +hudfrag: HudFragment
    +chatfrag: ChatFragment
    +planet: PlanetDialog
    +research: ResearchDialog
    +schematics: SchematicsDialog
    +update()
}

class GameState {
    +wave: int
    +wavetime: float
    +map: Map
    +rules: Rules
    +teams: Teams
    +stats: GameStats
    +markers: MapMarkers
    +set(state)
    +isPaused(): boolean
    +isPlaying(): boolean
    +isCampaign(): boolean
    +getState(): State
}

class World {
    +tiles: Tiles
    +tileChanges: int
    +tile(x, y): Tile
    +build(x, y): Building
    +loadMap(map)
    +loadSector(sector)
    +resize(width, height)
    +isGenerating(): boolean
}

class ContentLoader {
    +createBaseContent()
    +createModContent()
    +init()
    +load()
    +items(): Seq<Item>
    +blocks(): Seq<Block>
    +units(): Seq<UnitType>
    +liquids(): Seq<Liquid>
    +byName(name): MappableContent
}

class Net {
    +host(port)
    +connect(ip, port)
    +disconnect()
    +send(object, reliable)
    +active(): boolean
    +server(): boolean
    +client(): boolean
}

class NetServer {
    +admins: Administration
    +clientCommands: CommandHandler
    +sendWorldData(player)
    +assignTeam(player)
    +update()
}

class NetClient {
    +connect(ip, port)
    +entitySnapshot(amount, data)
    +stateSnapshot(...)
    +sync()
    +update()
}

class Pathfinder {
    +getField(team, costType, fieldType): Flowfield
    +getTargetTile(tile, path): Tile
    +updateTile(tile)
    +start()
    +stop()
}

class ControlPathfinder {
    +getPathPosition(unit, dest, out)
    +updateTile(tile)
    +start()
    +stop()
}

class BlockIndexer {
    +getFlagged(team): Seq<Building>[]
    +getDamaged(team): Seq<Building>
    +findClosestOre(unit, item): Tile
    +findEnemyTile(team, x, y, range): Building
    +eachBlock(team, range, pred, cons)
}

class WaveSpawner {
    +spawnEnemies()
    +spawnUnit(group, x, y)
    +getSpawns(): Seq<Tile>
    +countSpawns(): int
    +isSpawning(): boolean
}

interface Platform {
    +getNet(): NetProvider
    +getUUID(): String
    +shareFile(file)
    +createScripts(): Scripts
}

class Mods {
    +load()
    +loadContent()
    +list(): Seq<LoadedMod>
    +getMod(name): LoadedMod
    +hasScripts(): boolean
}

class Maps {
    +all(): Seq<Map>
    +customMaps(): Seq<Map>
    +loadMap(file, custom): Map
    +importMap(file): Map
    +getNextMap(mode, prev): Map
}

enum State {
    paused
    playing
    menu
}

Vars ..> Control : uses
Vars ..> Logic : uses
Vars ..> Renderer : uses
Vars ..> UI : uses
Vars ..> NetServer : uses
Vars ..> NetClient : uses
Vars ..> GameState : uses
Vars ..> World : uses
Vars ..> ContentLoader : uses
Vars ..> Net : uses
Vars ..> Pathfinder : uses
Vars ..> ControlPathfinder : uses
Vars ..> BlockIndexer : uses
Vars ..> WaveSpawner : uses
Vars ..> Maps : uses
Vars ..> Mods : uses

Control ..> GameState : reads
Control ..> World : reads
Logic ..> GameState : updates
Logic ..> World : reads
Renderer ..> World : reads
NetServer ..> GameState : reads
NetClient ..> GameState : reads
GameState *-- State
GameState *-- Rules : contains
GameState *-- Teams : contains

@enduml
