@startuml ContentTypeHierarchy
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Content Type Hierarchy

abstract class Content {
    +id: short
    +minfo: ModContentInfo
    +{abstract} getContentType(): ContentType
    +init()
    +postInit()
    +load()
    +loadIcon()
    +isVanilla(): boolean
    +isModded(): boolean
}

abstract class MappableContent {
    +name: String
    +toString(): String
}

abstract class UnlockableContent {
    +localizedName: String
    +description: String
    +details: String
    +stats: Stats
    +techNode: TechNode
    +uiIcon: TextureRegion
    +fullIcon: TextureRegion
    +alwaysUnlocked: boolean
    +unlocked(): boolean
    +unlock()
    +researchRequirements(): ItemStack[]
    +createIcons(packer)
    +setStats()
    +getDependencies(cons)
}

class Item {
    +color: Color
    +explosiveness: float
    +flammability: float
    +radioactivity: float
    +charge: float
    +hardness: int
    +cost: float
    +buildable: boolean
}

class Liquid {
    +color: Color
    +gasColor: Color
    +flammability: float
    +temperature: float
    +heatCapacity: float
    +viscosity: float
    +gas: boolean
    +coolant: boolean
    +effect: StatusEffect
}

class Block {
    +size: int
    +health: int
    +solid: boolean
    +rotate: boolean
    +requirements: ItemStack[]
    +buildTime: float
    +category: Category
    +buildVisibility: BuildVisibility
    +consumers: Consume[]
}

class UnitType {
    +speed: float
    +health: float
    +armor: float
    +flying: boolean
    +hitSize: float
    +weapons: Seq<Weapon>
    +abilities: Seq<Ability>
    +constructor: Prov<Unit>
}

class StatusEffect {
    +speedMultiplier: float
    +damageMultiplier: float
    +healthMultiplier: float
    +reloadMultiplier: float
    +disarm: boolean
    +color: Color
    +effect: Effect
}

class BulletType {
    +speed: float
    +damage: float
    +lifetime: float
    +pierce: boolean
    +splashDamage: float
    +hitEffect: Effect
    +shootEffect: Effect
    +create(...): Bullet
}

class Planet {
    +radius: float
    +sectors: Seq<Sector>
    +grid: PlanetGrid
    +generator: PlanetGenerator
    +parent: Planet
    +techTree: TechNode
    +orbitRadius: float
}

class SectorPreset {
    +sector: Sector
    +planet: Planet
    +generator: FileMapGenerator
    +captureWave: int
    +difficulty: float
}

class Weather {
    +duration: float
    +status: StatusEffect
    +sound: Sound
}

class TeamEntry {
    +team: Team
}

class TechNode {
    +content: UnlockableContent
    +parent: TechNode
    +children: Seq<TechNode>
    +requirements: ItemStack[]
    +objectives: Seq<Objective>
    +depth: int
    +reset()
    +save()
}

class ContentLoader {
    +handleContent(content)
    +getByName(type, name): MappableContent
    +getBy(type): Seq<Content>
}

Content <|-- MappableContent
MappableContent <|-- UnlockableContent
Content <|-- BulletType
UnlockableContent <|-- Item
UnlockableContent <|-- Liquid
UnlockableContent <|-- Block
UnlockableContent <|-- UnitType
UnlockableContent <|-- StatusEffect
UnlockableContent <|-- Planet
UnlockableContent <|-- SectorPreset
UnlockableContent <|-- Weather
UnlockableContent <|-- TeamEntry
UnlockableContent "1" *-- "0..*" TechNode : has tech node
ContentLoader ..> Content : manages

@enduml
