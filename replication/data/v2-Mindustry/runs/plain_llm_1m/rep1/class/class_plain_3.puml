@startuml BlockBuildingHierarchy
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Block & Building Hierarchy (Key Types)

abstract class UnlockableContent

class Block {
    +size: int
    +health: int
    +solid: boolean
    +rotate: boolean
    +requirements: ItemStack[]
    +consumers: Consume[]
    +buildType: Prov<Building>
    +newBuilding(): Building
    +drawPlace(x,y,rotation,valid)
    +setStats()
    +init()
}

class Building {
    +tile: Tile
    +block: Block
    +team: Team
    +health: float
    +enabled: boolean
    +items: ItemModule
    +liquids: LiquidModule
    +power: PowerModule
    +proximity: Seq<Building>
    +updateTile()
    +draw()
    +acceptItem(source, item): boolean
    +handleItem(source, item)
    +acceptLiquid(source, liquid): boolean
    +sense(sensor): double
    +control(type, ...): void
}

package "Environment" {
    class Floor {
        +speedMultiplier: float
        +drownTime: float
        +liquidDrop: Liquid
        +isLiquid: boolean
    }
    class OverlayFloor
    class OreBlock {
        +itemDrop: Item
    }
    class StaticWall
    class Prop
    class Cliff
    class AirBlock
}

package "Defense" {
    class Wall {
        +lightningChance: float
        +chanceDeflect: float
    }
    class Door
    class ShieldWall
    class ForceProjector {
        +radius: float
        +shieldHealth: float
    }
    class MendProjector {
        +range: float
        +healPercent: float
    }
    class OverdriveProjector {
        +range: float
        +speedBoost: float
    }
}

package "Turrets" {
    abstract class BaseTurret {
        +range: float
        +rotateSpeed: float
    }
    abstract class ReloadTurret {
        +reload: float
    }
    abstract class Turret {
        +shoot: ShootPattern
        +heatColor: Color
        +drawer: DrawBlock
    }
    class ItemTurret
    class LiquidTurret
    class PowerTurret
    class ContinuousTurret
    class LaserTurret
    class PointDefenseTurret
    class TractorBeamTurret
}

package "Power" {
    class PowerBlock
    class PowerNode {
        +laserRange: float
        +maxNodes: int
    }
    class PowerDistributor
    class PowerGenerator {
        +powerProduction: float
    }
    class Battery
    class SolarGenerator
    class NuclearReactor
    class ImpactReactor
    class ConsumeGenerator
}

package "Production" {
    class GenericCrafter {
        +craftTime: float
        +outputItems: ItemStack[]
        +outputLiquids: LiquidStack[]
    }
    class AttributeCrafter {
        +attribute: Attribute
        +baseEfficiency: float
    }
    class HeatCrafter {
        +heatRequirement: float
    }
    class Drill {
        +tier: int
        +drillTime: float
    }
    class Pump {
        +pumpAmount: float
    }
}

package "Distribution" {
    class Conveyor {
        +speed: float
    }
    class Sorter
    class Router
    class Junction
    class ItemBridge {
        +range: int
    }
    class MassDriver {
        +range: float
        +reload: float
    }
}

package "Storage & Core" {
    class StorageBlock
    class CoreBlock {
        +unitType: UnitType
        +landDuration: float
    }
    class Unloader
}

package "Units" {
    class PayloadBlock {
        +payloadSpeed: float
    }
    class UnitBlock
    class UnitFactory {
        +plans: Seq<UnitPlan>
    }
    class Reconstructor {
        +upgrades: Seq<UnitType[]>
    }
    class UnitAssembler {
        +plans: Seq<AssemblerUnitPlan>
        +dronesCreated: int
    }
}

package "Logic" {
    class LogicBlock {
        +range: float
        +instructionsPerTick: int
    }
    class MemoryBlock {
        +memoryCapacity: int
    }
    class LogicDisplay {
        +displaySize: int
    }
    class MessageBlock
    class CanvasBlock
}

UnlockableContent <|-- Block

Block <|-- Floor
Floor <|-- OverlayFloor
OverlayFloor <|-- OreBlock
Block <|-- StaticWall
StaticWall <|-- Prop
Block <|-- Cliff
Floor <|-- AirBlock

Block <|-- Wall
Wall <|-- Door
Wall <|-- ShieldWall
Block <|-- ForceProjector
Block <|-- MendProjector
Block <|-- OverdriveProjector

Block <|-- BaseTurret
BaseTurret <|-- ReloadTurret
ReloadTurret <|-- Turret
Turret <|-- ItemTurret
Turret <|-- LiquidTurret
Turret <|-- PowerTurret
PowerTurret <|-- LaserTurret
ReloadTurret <|-- PointDefenseTurret
BaseTurret <|-- TractorBeamTurret
Turret <|-- ContinuousTurret

Block <|-- PowerBlock
PowerBlock <|-- PowerNode
PowerBlock <|-- PowerDistributor
PowerDistributor <|-- PowerGenerator
PowerGenerator <|-- SolarGenerator
PowerGenerator <|-- NuclearReactor
PowerGenerator <|-- ImpactReactor
PowerGenerator <|-- ConsumeGenerator
PowerDistributor <|-- Battery

Block <|-- GenericCrafter
GenericCrafter <|-- AttributeCrafter
GenericCrafter <|-- HeatCrafter
Block <|-- Drill
Block <|-- Pump

Block <|-- Conveyor
Block <|-- Sorter
Block <|-- Router
Block <|-- Junction
Block <|-- ItemBridge
Block <|-- MassDriver

Block <|-- StorageBlock
StorageBlock <|-- CoreBlock

Block <|-- PayloadBlock
PayloadBlock <|-- UnitBlock
UnitBlock <|-- UnitFactory
UnitBlock <|-- Reconstructor
PayloadBlock <|-- UnitAssembler

Block <|-- LogicBlock
Block <|-- MemoryBlock
Block <|-- LogicDisplay
Block <|-- MessageBlock
Block <|-- CanvasBlock

Block "1" -- "1..*" Building : instantiates >

@enduml
