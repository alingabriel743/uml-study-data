@startuml UnitAISystem
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Unit, AI & Entity Component System

interface UnitController {
    +updateUnit()
    +unit(unit)
    +unit(): Unit
    +hit(bullet)
    +isValidController(): boolean
    +isLogicControllable(): boolean
    +removed(unit)
    +afterRead(unit)
}

abstract class AIController {
    #unit: Unit
    #timer: Interval
    #target: Teamc
    #fallback: AIController
    +updateUnit()
    +updateMovement()
    +updateTargeting()
    +findTarget(x,y,range,air,ground)
    +pathfind(pathTarget)
    +shouldFire(): boolean
    +retarget()
    +circleAttack(circleLength)
    +moveTo(target, circleLength)
    +target(x,y,range,air,ground)
}

class CommandAI {
    +commandQueue: Seq<Position>
    +targetPos: Vec2
    +attackTarget: Teamc
    +group: UnitGroup
    +command: UnitCommand
    +stances: Bits
    +commandPosition(pos)
    +commandTarget(target)
    +setStance(stance, enabled)
    +hasStance(stance): boolean
    +command(cmd)
}

class FlyingAI {
    +updateMovement()
    +findMainTarget(...)
}

class FlyingFollowAI {
    +following: Teamc
    +updateMovement()
    +fallback()
}

class GroundAI {
    +stuckTime: float
    +updateMovement()
}

class SuicideAI {
    +updateUnit()
    +target(...)
}

class BuilderAI {
    +following: Unit
    +enemy: Teamc
    +fleeRange: float
    +alwaysFlee: boolean
    +updateMovement()
    +nearEnemy(x,y): boolean
    +useFallback(): boolean
}

class MinerAI {
    +mining: boolean
    +targetItem: Item
    +ore: Tile
    +updateMovement()
}

class RepairAI {
    +retreatDst: float
    +avoid: Teamc
    +updateMovement()
    +updateTargeting()
}

class DefenderAI {
    +updateMovement()
    +updateTargeting()
    +findTarget(...)
}

class MissileAI {
    +shooter: Unit
    +updateMovement()
    +retarget()
}

class LogicAI {
    +control: LUnitControl
    +moveX: float
    +moveY: float
    +controller: Building
    +mainTarget: Teamc
    +boost: boolean
    +shoot: boolean
    +updateMovement()
    +checkTarget(...)
}

class CargoAI {
    +unloadTarget: UnitCargoUnloadPointBuild
    +itemTarget: Item
    +updateMovement()
    +findDropTarget(...)
}

class AssemblerAI {
    +targetPos: Vec2
    +targetAngle: float
    +updateMovement()
}

class PrebuildAI {
    +updateMovement()
    +sortPlans(plans)
    +findNextPlan()
}

class HugAI {
    +updateMovement()
}

class BoostAI {
    +updateUnit()
}

' Unit entity structure
class UnitType {
    +speed: float
    +health: float
    +armor: float
    +flying: boolean
    +weapons: Seq<Weapon>
    +abilities: Seq<Ability>
    +aiController: Prov<UnitController>
    +controller: Func<Unit,UnitController>
    +constructor: Prov<Unit>
    +create(team): Unit
    +spawn(team, x, y): Unit
    +update(unit)
    +draw(unit)
}

class Weapon {
    +name: String
    +bullet: BulletType
    +reload: float
    +rotate: boolean
    +x: float
    +y: float
    +shootX: float
    +shootY: float
    +range(): float
    +update(unit, mount)
    +shoot(unit, mount, ...)
}

abstract class Ability {
    +display: boolean
    +update(unit)
    +draw(unit)
    +death(unit)
    +created(unit)
    +copy(): Ability
}

class ForceFieldAbility {
    +radius: float
    +regen: float
    +max: float
    +cooldown: float
    +sides: int
}

class RepairFieldAbility {
    +amount: float
    +reload: float
    +range: float
}

class ShieldArcAbility {
    +radius: float
    +angle: float
    +max: float
    +chanceDeflect: float
}

class UnitSpawnAbility {
    +unit: UnitType
    +spawnTime: float
}

class EnergyFieldAbility {
    +damage: float
    +reload: float
    +range: float
    +maxTargets: int
}

class SpawnDeathAbility {
    +unit: UnitType
    +amount: int
}

class MoveEffectAbility {
    +effect: Effect
    +interval: float
}

' Pathfinding
class Pathfinder {
    +{static} costTypes: Seq<PathCost>
    +{static} fieldTypes: Seq<Prov<Flowfield>>
    +getField(team, costType, fieldType): Flowfield
    +getTargetTile(tile, path): Tile
    +updateTile(tile)
}

class ControlPathfinder {
    +{static} costGround: PathCost
    +{static} costHover: PathCost
    +{static} costLegs: PathCost
    +{static} costNaval: PathCost
    +getPathPosition(unit, dest, out)
    +updateTile(tile)
    +raycast(team, type, x1,y1,x2,y2): boolean
}

interface PathCost {
    +getCost(team, tile): int
}

class Flowfield {
    +weights: int[]
    +team: Team
    +cost: PathCost
    +resolution: int
    +width: int
    +height: int
    +getNextTile(from): Tile
    +hasTargets(): boolean
    +passable(pos): boolean
}

UnitController <|.. AIController
AIController <|-- CommandAI
AIController <|-- FlyingAI
FlyingAI <|-- FlyingFollowAI
AIController <|-- GroundAI
GroundAI <|-- SuicideAI
AIController <|-- BuilderAI
AIController <|-- MinerAI
AIController <|-- RepairAI
AIController <|-- DefenderAI
AIController <|-- MissileAI
AIController <|-- LogicAI
AIController <|-- CargoAI
AIController <|-- AssemblerAI
AIController <|-- PrebuildAI
AIController <|-- HugAI
AIController <|-- BoostAI

Ability <|-- ForceFieldAbility
Ability <|-- RepairFieldAbility
Ability <|-- ShieldArcAbility
Ability <|-- UnitSpawnAbility
Ability <|-- EnergyFieldAbility
Ability <|-- SpawnDeathAbility
Ability <|-- MoveEffectAbility

UnitType "1" o-- "*" Weapon : has weapons
UnitType "1" o-- "*" Ability : has abilities
UnitType ..> UnitController : creates controller
UnitController <|.. CommandAI

Pathfinder ..> Flowfield : manages
ControlPathfinder ..> PathCost : uses
Flowfield ..> PathCost : uses

AIController ..> Pathfinder : uses
AIController ..> ControlPathfinder : uses

@enduml
