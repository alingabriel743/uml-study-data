@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Class Diagram

' ─────────────────────────────────────────
' Package: mindustry.ctype (Content hierarchy)
' ─────────────────────────────────────────
package "mindustry.ctype" {

    abstract class Content {
        +short id
        +ModContentInfo minfo
        +{abstract} ContentType getContentType()
        +void init()
        +void load()
        +void postInit()
    }

    abstract class MappableContent {
        +String name
    }

    abstract class UnlockableContent {
        +Stats stats
        +String localizedName
        +String description
        +boolean alwaysUnlocked
        +boolean hideDetails
        +boolean hideDatabase
        +void load()
        +void unlock()
    }
}

' ─────────────────────────────────────────
' Package: mindustry.type
' ─────────────────────────────────────────
package "mindustry.type" {

    class Item {
        +Color color
        +float explosiveness
        +float flammability
        +float radioactivity
        +float charge
        +int hardness
        +float cost
        +boolean lowPriority
    }

    class Liquid {
        +boolean gas
        +Color color
        +Color gasColor
        +float temperature
        +float flammability
        +float viscosity
        +float heatCapacity
    }

    class UnitType {
        +float speed
        +float boostMultiplier
        +int envRequired
        +int envEnabled
        +Seq<Weapon> weapons
        +Seq<Ability> abilities
        +float health
        +float armor
        +float range
    }

    class StatusEffect {
        +float speedMultiplier
        +float damageMultiplier
        +float healthMultiplier
        +float reloadMultiplier
        +float damage
        +boolean permanent
    }

    class Weapon {
        +String name
        +float x
        +float y
        +float reload
        +float inaccuracy
        +float damageMultiplier
        +BulletType bullet
    }

    class Sector {
        +Planet planet
        +SectorInfo info
        +boolean captured
        +boolean preset
    }

    class Planet {
        +String name
        +float radius
        +Seq<Sector> sectors
        +float orbitRadius
        +Planet parent
    }
}

' ─────────────────────────────────────────
' Package: mindustry.world
' ─────────────────────────────────────────
package "mindustry.world" {

    class Block {
        +boolean hasItems
        +boolean hasLiquids
        +boolean hasPower
        +boolean outputsLiquid
        +boolean outputsPower
        +boolean conductivePower
        +int size
        +float health
        +ItemStack[] requirements
        +Building newBuilding()
    }

    class Tile {
        +short x
        +short y
        +Building build
        -Block block
        -Floor floor
        -Floor overlay
        +Block block()
        +Floor floor()
    }

    class Floor {
        +float speedMultiplier
        +boolean isLiquid
        +boolean damageTaker
        +int blendGroup
    }
}

' ─────────────────────────────────────────
' Package: mindustry.world.blocks.defense
' ─────────────────────────────────────────
package "mindustry.world.blocks.defense" {

    class Wall {
        +boolean chanceDeflect
        +float deflectChance
        +boolean flashHit
    }

    class Door {
        +boolean opaque
        +Effect openEffect
        +Effect closeEffect
    }

    class ShieldWall {
        +float shieldHealth
        +float shieldRegen
        +Effect hitEffect
    }
}

' ─────────────────────────────────────────
' Package: mindustry.world.blocks.defense.turrets
' ─────────────────────────────────────────
package "mindustry.world.blocks.defense.turrets" {

    class BaseTurret {
        +float range
        +float rotateSpeed
        +boolean targetAir
        +boolean targetGround
    }

    class ReloadTurret {
        +float reloadTime
        +float coolantMultiplier
        +Effect shootEffect
        +Effect smokeEffect
    }

    class Turret {
        +float shootCone
        +float firstShotDelay
        +boolean accurateDelay
        +BulletType[] ammoTypes
    }

    class PowerTurret {
        +float powerUse
    }

    class LaserTurret {
        +float laserWidth
        +float shootWarmup
        +float shootDuration
    }
}

' ─────────────────────────────────────────
' Package: mindustry.core
' ─────────────────────────────────────────
package "mindustry.core" {

    class Control {
        +Saves saves
        +InputHandler input
        +AttackIndicators indicators
        +void update()
        +void init()
    }

    class Logic {
        +void update()
        +void runWave()
        +void play()
        +void reset()
        +void checkGameOver()
    }

    class World {
        +Tiles tiles
        +int tileChanges
        +int floorChanges
        +void loadMap(Map map)
        +Tile tile(int x, int y)
        +boolean isAccessible(int x, int y)
    }

    class Renderer {
        +BlockRenderer blocks
        +FogRenderer fog
        +MinimapRenderer minimap
        +OverlayRenderer overlays
        +LightRenderer lights
        +void draw()
    }

    class NetServer {
        +void update()
        +void host(int port)
        +void sendWorld(NetConnection connection)
    }

    class ContentLoader {
        +void load()
        +void createContent()
        +Content getByID(ContentType type, int id)
        +MappableContent getByName(ContentType type, String name)
    }

    class GameState {
        +int wave
        +float wavetime
        +boolean gameOver
        +boolean won
        +Rules rules
        +GameStats stats
        +Teams teams
        +Map map
        +MapMarkers markers
        +Attributes envAttrs
    }
}

' ─────────────────────────────────────────
' Package: mindustry.game
' ─────────────────────────────────────────
package "mindustry.game" {

    class Team {
        +int id
        +Color color
        +String name
        +boolean ignoreUnitCap
        +String emoji
        +{static} Team sharded
        +{static} Team crux
        +TeamData data()
    }

    class Teams {
        +Seq<TeamData> active
        +Seq<TeamData> present
        +Seq<Unit> bosses
        +TeamData get(Team team)
        +CoreBuild closestEnemyCore(float x, float y, Team team)
    }

    class Rules {
        +boolean waves
        +boolean pvp
        +boolean attackMode
        +boolean infiniteResources
        +float unitHealthMultiplier
        +float buildSpeedMultiplier
        +float enemyCoreBuildRadius
        +TeamRules teams
    }

    class Schematic {
        +Seq<Stile> tiles
        +Seq<String> labels
        +StringMap tags
        +int width
        +int height
        +ItemSeq requirements()
        +float powerProduction()
    }

    class SpawnGroup {
        +UnitType type
        +int begin
        +int end
        +int spacing
        +int max
        +int unitAmount
        +float shields
        +float shieldScaling
        +int spawn(int wave)
    }

    class Saves {
        +Seq<SaveSlot> saves
        +SaveSlot current
        +void update()
        +void save()
        +void load(SaveSlot slot)
    }

    class Universe {
        +void updateGlobal()
        +void update()
        +void setLastLoadout(Schematic schematic)
    }
}

' ─────────────────────────────────────────
' Package: mindustry.maps
' ─────────────────────────────────────────
package "mindustry.maps" {

    class Map {
        +boolean custom
        +StringMap tags
        +int width
        +int height
        +Fi file
        +int spawns
        +boolean workshop
        +String name()
        +String author()
    }
}

' ─────────────────────────────────────────
' Package: mindustry.entities.units
' ─────────────────────────────────────────
package "mindustry.entities.units" {

    interface UnitController {
        +void unit(Unit unit)
        +Unit unit()
        +void updateUnit()
        +void hit(Bullet bullet)
        +boolean isLogicControllable()
        +void removed(Unit unit)
    }

    class AIController {
        #Unit unit
        #Teamc target
        #Interval timer
        #AIController fallback
        +void updateUnit()
        +void hit(Bullet bullet)
        #boolean shouldShoot()
        #void moveTo(Position target)
    }
}

' ─────────────────────────────────────────
' Package: mindustry.ai.types
' ─────────────────────────────────────────
package "mindustry.ai.types" {

    class BuilderAI {
        +{static} float buildRadius
        +boolean alwaysFlee
        +boolean onlyAssist
        +float fleeRange
        +Unit following
    }

    class GroundAI {
        +void update()
    }

    class FlyingAI {
        +void update()
        +void circle(Position pos, float radius)
    }

    class MinerAI {
        +Item targetItem
        +Tile targetTile
    }

    class SuicideAI {
        +float explodeRange
    }

    class FlyingFollowAI {
        +Unit leader
    }
}

' ─────────────────────────────────────────
' Package: mindustry.entities.abilities
' ─────────────────────────────────────────
package "mindustry.entities.abilities" {

    abstract class Ability {
        +boolean display
        +float data
        +void update(Unit unit)
        +void draw(Unit unit)
        +void death(Unit unit)
        +void created(Unit unit)
        +void init(UnitType type)
    }

    class RegenAbility {
        +float boost
        +float warmup
        +float boostWarmup
        +Effect effect
    }

    class ForceFieldAbility {
        +float radius
        +float regen
        +float maxShield
        +Effect absorbEffect
        +Effect breakEffect
    }

    class EnergyFieldAbility {
        +float range
        +float damage
        +float healPercent
    }

    class RepairFieldAbility {
        +float range
        +float repairSpeed
        +Effect healEffect
    }
}

' ═══════════════════════════════════════
'   INHERITANCE / IMPLEMENTATION
' ═══════════════════════════════════════

' Content hierarchy
Content <|-- MappableContent
MappableContent <|-- UnlockableContent
UnlockableContent <|-- Item
UnlockableContent <|-- Liquid
UnlockableContent <|-- UnitType
UnlockableContent <|-- StatusEffect
UnlockableContent <|-- Block

' Block hierarchy
Block <|-- Floor
Block <|-- Wall
Block <|-- BaseTurret
Wall <|-- Door
Wall <|-- ShieldWall
BaseTurret <|-- ReloadTurret
ReloadTurret <|-- Turret
Turret <|-- PowerTurret
PowerTurret <|-- LaserTurret

' AI controller hierarchy
UnitController <|.. AIController
AIController <|-- BuilderAI
AIController <|-- GroundAI
AIController <|-- FlyingAI
AIController <|-- MinerAI
GroundAI <|-- SuicideAI
FlyingAI <|-- FlyingFollowAI

' Ability hierarchy
Ability <|-- RegenAbility
Ability <|-- ForceFieldAbility
Ability <|-- EnergyFieldAbility
Ability <|-- RepairFieldAbility

' Campaign
Planet *-- Sector : has sectors

' ═══════════════════════════════════════
'   COMPOSITION / AGGREGATION
' ═══════════════════════════════════════

' GameState aggregates core game data
GameState *-- Rules : "rules"
GameState *-- Teams : "teams"
GameState o-- Map : "plays on"

' Teams contain Team entries
Teams o-- Team : "active/present"

' SpawnGroup references UnitType
SpawnGroup o-- UnitType : "spawns >"

' UnitType has abilities and weapons
UnitType *-- Ability : "abilities"
UnitType *-- Weapon : "weapons"

' Tile references Block
Tile o-- Block : "block >"
Tile o-- Floor : "floor >"

' Schematic references blocks as tiles
Schematic ..> Block : "uses"

' Universe manages campaign state
Universe o-- Schematic : "lastLoadout"

' ═══════════════════════════════════════
'   DEPENDENCIES (dashed)
' ═══════════════════════════════════════
Logic ..> GameState : "reads/fires events"
Control ..> Saves : "manages"
World ..> Tile : "stores tiles"
ContentLoader ..> Content : "loads & registers"
Saves o-- Map : "tracks"

@enduml
