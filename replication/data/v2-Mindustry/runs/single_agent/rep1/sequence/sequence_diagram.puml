@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #495057
skinparam sequenceParticipantBackgroundColor #F8F9FA
skinparam sequenceLifeLineBorderColor #6C757D
skinparam sequenceGroupBorderColor #495057

title Mindustry — Core Game Loop: Wave Spawn & Game-Over Sequence

actor "LibGDX Application" as App

participant "Logic" as Logic
participant "GameState" as State
participant "WaveSpawner" as Spawner
participant "SpawnGroup" as SpawnGroup
participant "Groups" as Groups
participant "Events" as Events
participant "Control" as Control
participant "NetServer" as NetServer

== Game Start ==

App -> Logic : update()
activate Logic

Logic -> Events : fire(Trigger.update)
Logic -> State  : isGame()
activate State
State --> Logic : true
deactivate State

Logic -> State : isPaused()
activate State
State --> Logic : false
deactivate State

Logic -> State : updateTeamStats()
Logic -> State : tick += delta * 60

== Wave Timer Countdown ==

note over Logic,State : Each tick, wave countdown decreases\nuntil wavetime ≤ 0

Logic -> State : wavetime -= Time.delta
Logic -> State : wavetime <= 0 ?
activate State
State --> Logic : true (timer expired)
deactivate State

== Wave Spawn ==

Logic -> Logic : runWave()
activate Logic #CCDDFF

Logic -> Spawner : spawnEnemies()
activate Spawner

loop for each SpawnGroup in state.rules.spawns
    Spawner -> SpawnGroup : getSpawned(wave - 1)
    activate SpawnGroup
    SpawnGroup --> Spawner : spawnedCount
    deactivate SpawnGroup

    alt flying unit type
        Spawner -> Spawner : eachFlyerSpawn(group.spawn, ...)
        Spawner -> Spawner : spawnUnit(group, x, y)
    else ground unit type
        Spawner -> Spawner : eachGroundSpawn(group.spawn, ...)
        Spawner -> Spawner : doShockwave(spawnX, spawnY)
        Spawner -> Spawner : spawnUnit(group, x + spread, y + spread)
    end

    Spawner -> SpawnGroup : createUnit(team, x, y, angle, wave-1, spawnEffect)
    activate SpawnGroup
    SpawnGroup --> Spawner : unit (Unit)
    deactivate SpawnGroup
end

Spawner --> Logic : (units spawned)
deactivate Spawner

Logic -> State : wave++
Logic -> State : wavetime = waveSpacing * multiplier

Logic -> Events : fire(WaveEvent)
activate Events
Events --> Control : onWaveEvent (listener)
deactivate Events
deactivate Logic

== Entity Update ==

Logic -> Groups : update()
activate Groups
note right of Groups : Updates all entities:\nunits, buildings, bullets, weather, etc.
Groups --> Logic : (all entities updated)
deactivate Groups

Logic -> Events : fire(Trigger.afterGameUpdate)

== Game-State Check ==

Logic -> Logic : checkGameState()
activate Logic #FFDDCC

alt campaign mode — all player cores destroyed
    Logic -> State : teams.playerCores().size == 0 ?
    activate State
    State --> Logic : true
    deactivate State
    Logic -> Events : fire(GameOverEvent(waveTeam))
    activate Events
    Events --> Control  : onGameOverEvent (listener)
    activate Control
    Control --> Logic   : (acknowledged)
    deactivate Control
    deactivate Events

else wave mode — win wave reached, no enemies remain
    Logic -> State : enemies == 0 && wave >= winWave ?
    activate State
    State --> Logic : true
    deactivate State
    Logic -> Logic : Call.sectorCapture()
    Logic -> Events : fire(SectorCaptureEvent)

else campaign — sector already captured
    Logic -> State : attackMode && waveTeam not alive ?
    activate State
    State --> Logic : true
    deactivate State
    Logic -> Logic : Call.sectorCapture()
end

deactivate Logic
deactivate Logic

== Player Connection (Multiplayer) ==

note over NetServer : Parallel: player joins a hosted game

actor "Remote Client" as Client

Client -> NetServer : Connect (TCP)
activate NetServer
NetServer -> Events : fire(ConnectionEvent)

Client -> NetServer : ConnectPacket (uuid, name, mods, version)

NetServer -> NetServer : admins.isIPBanned(address)?
NetServer -> NetServer : admins.isIDBanned(uuid)?
NetServer -> NetServer : mods.getIncompatibility(packet.mods)

alt banned / incompatible mods / wrong version
    NetServer --> Client : con.kick(KickReason)
else valid connection
    NetServer -> NetServer : Player.create()
    NetServer -> NetServer : assignTeam(player)
    NetServer -> NetServer : sendWorldData(player)
    activate NetServer #CCFFCC
    NetServer --> Client : WorldStream (map + entity snapshot)
    deactivate NetServer
    NetServer -> Events : fire(PlayerJoin)
    activate Events
    Events --> Control : onPlayerJoin (listener)
    deactivate Events
end

deactivate NetServer

@enduml
