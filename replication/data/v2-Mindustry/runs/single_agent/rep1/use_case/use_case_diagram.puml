@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam ArrowColor #495057

title Mindustry — Use Case Diagram

left to right direction

actor "Player" as player
actor "Admin" as admin
actor "Enemy AI\n(Wave System)" as ai
actor "Logic Controller\n(Programmable Block)" as logic
actor "Steam Platform" as steam

rectangle "Mindustry Game System" {

    package "Campaign & Gameplay" {
        usecase "Play Campaign\n(Sector Map)" as UC1
        usecase "Play Custom Game" as UC2
        usecase "Select Difficulty" as UC3
        usecase "Choose Launch Loadout" as UC4
        usecase "Research Technology" as UC5
        usecase "View Campaign Progress" as UC6
    }

    package "In-Game Actions" {
        usecase "Place Buildings" as UC7
        usecase "Remove / Deconstruct Buildings" as UC8
        usecase "Mine Resources" as UC9
        usecase "Configure Block" as UC10
        usecase "Control Units" as UC11
        usecase "Manage Schematics" as UC12
        usecase "Issue Unit Commands" as UC13
        usecase "View Minimap" as UC14
    }

    package "Map Editor" {
        usecase "Create / Edit Map" as UC15
        usecase "Generate Map Procedurally" as UC16
        usecase "Resize Map" as UC17
        usecase "Configure Wave Groups" as UC18
        usecase "Set Map Objectives" as UC19
        usecase "Manage Editor Tools" as UC20
        usecase "Export / Import Map" as UC21
    }

    package "Multiplayer" {
        usecase "Host Server" as UC22
        usecase "Join Server" as UC23
        usecase "Browse Server List" as UC24
        usecase "Chat with Players" as UC25
        usecase "View Player List" as UC26
        usecase "Vote to Kick Player" as UC27
    }

    package "Server Administration" {
        usecase "Kick Player" as UC28
        usecase "Ban / Unban Player" as UC29
        usecase "Manage Whitelist" as UC30
        usecase "Configure Server Rules" as UC31
        usecase "Trace Player Actions" as UC32
        usecase "Manage Admins" as UC33
    }

    package "Settings & Customisation" {
        usecase "Configure Keybindings" as UC34
        usecase "Adjust Graphics / Effects" as UC35
        usecase "Change Language" as UC36
        usecase "Manage Mods" as UC37
        usecase "View Database / Content Info" as UC38
    }

    package "Save & Progress" {
        usecase "Save Game" as UC39
        usecase "Load Game" as UC40
        usecase "View Game Statistics" as UC41
    }

    package "Logic Programming" {
        usecase "Write Logic Program" as UC42
        usecase "Control Units via Logic" as UC43
        usecase "Read / Write Memory Blocks" as UC44
        usecase "Display Output on Logic Display" as UC45
    }

    package "AI & Wave Engine" {
        usecase "Spawn Enemy Waves" as UC46
        usecase "Pathfind to Core" as UC47
        usecase "Execute Unit AI Behaviour" as UC48
    }
}

