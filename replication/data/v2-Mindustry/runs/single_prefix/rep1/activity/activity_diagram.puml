@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam partition {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Game Launch & AI Pathfinding Workflow

|#BBDEFB|Android Platform\n(AndroidLauncher)|
start
:onCreate(savedInstanceState);
:checkFiles(intent);
if (Is Tablet?) then (yes)
  :Configure Tablet Layout;
else (no)
  :Configure Phone Layout;
endif
:Request Android Permissions;
:onRequestPermissionsResult(requestCode, permissions, grantResults);

|#C8E6C9|Game Core\n(ClientLauncher)|
:init();
:add(ApplicationListener module);
:fileDropped(Fi file);
:resize(width, height);

|#FFE0B2|Game State\n(Vars)|
:init();
:loadFileLogger(Fi file);
:loadAsync();
:checkLaunch();
if (Launch checks pass?) then (yes)
  :finishLaunch();
else (no)
  :Log Error;
  stop
endif

|#E1BEE7|Annotation Processing\n(BaseProcessor)|
:process(annotations, roundEnv);
if (Element valid?) then (yes)
  :instanceOf(type, other);
  :tname(pack, simple);
else (no)
  :err(message, elem);
  stop
endif

fork
  |#E1BEE7|Annotation Processing\n(BaseProcessor)|
  :LoadRegionProcessor.process(env);
  :parse(value);
  :count(str, substring);
  :Generate region load code;
fork again
  |#E1BEE7|Annotation Processing\n(BaseProcessor)|
  :LogicStatementProcessor.process(env);
  :Generate logic statement stubs;
fork again
  |#E1BEE7|Annotation Processing\n(BaseProcessor)|
  :AssetsProcess.process(env);
  :processUI(elements);
  :processSounds(classname, path, rtype, genid);
end fork

|#FCE4EC|AI Pathfinding\n(Pathfinder / ControlPathfinder)|
:getField(team, costType, fieldType);
:initializePathRequest(unit, team, costId, unitX, unitY, goalX, goalY);
if (Valid start and goal positions?) then (yes)
  fork
    :innerAstar(team, cost, minX, minY, maxX, maxY, startPos, goalPos);
    :checkEdges(request, team, pathCost, current, goal, cx, cy, connections);
    :PathfindQueue.add(node, weight);
    :PathfindQueue.siftUp / siftDown;
  fork again
    :raycastRect(initialCost, startX, startY, endX, endY, team, type, x1);
    :overlap(initialCost, team, type, x, y, startXY, endX);
  end fork
  :getTargetTile(tile, path, diagonals, avoidanceId);
  :EnemyCoreField.getPositions(out);
else (no)
  :Return null path / fallback tile;
endif

|#E0F2F1|Base Building AI\n(BaseBuilderAI / BlockIndexer)|
:BaseBuilderAI.update();
:randomPosition();
if (Build position valid?) then (yes)
  :BaseRegistry.forResource(Content item);
  :BaseRegistry.load();
  :BasePart.compareTo(other);
  :tryPlace(BasePart part, x, y);
else (no)
  :Skip — retry next update tick;
endif
:BlockIndexer.findTile(team, x, y, range, pred);
if (Enemy building in range?) then (yes)
  :findEnemyTile(team, x, y, range, priority, pred);
  :eachBlock(team, wx, wy, range, pred, cons);
  :TurretQuadtree.hitbox(build);
  :Target acquired — open fire;
else (no)
  :No target in range — idle;
endif

stop

@enduml
