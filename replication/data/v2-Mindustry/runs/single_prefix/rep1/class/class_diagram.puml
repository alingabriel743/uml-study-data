' ─────────────────────────────────────
' Package: mindustry.ai
' ─────────────────────────────────────
package "mindustry.ai" {

    class Astar {
        -{static} byte[][] rotations
        -{static} PQueue<Tile> queue
        -{static} Seq<Tile> out
        -{static} float[] costs
        +{static} DistanceHeuristic manhattan
        +{static} pathfind(Tile from, Tile to, TileHeuristic th, Boolf<Tile> passable)
        +{static} pathfind(int startX, int startY, int endX, int endY, TileHeuristic th, DistanceHeuristic dh, Boolf<Tile> passable)
    }

    interface DistanceHeuristic {
        +cost(int x1, int y1, int x2, int y2)
    }

    interface TileHeuristic {
        +cost(Tile tile)
        +cost(Tile from, Tile tile)
    }

    class BaseBuilderAI {
        -Tile calcTile
        -IntSet calcPath
        -IntSet path
        -boolean calculating, startedCalculating
        -Interval timer
        +BaseBuilderAI(TeamData data)
        +update()
        +tryPlace(BasePart part, int x, int y)
        +randomPosition()
    }

    class BaseRegistry {
        +ObjectMap<Content, Seq<BasePart>> reqParts
        +ObjectMap<Item, Floor> oreFloors
        +ObjectMap<Item, OreBlock> ores
        +Seq<BasePart> cores
        +Seq<BasePart> parts
        +load()
        +forResource(Content item)
    }

    class BasePart {
        +Block core
        +Content required
        +Schematic schematic
        +float tier
        +int centerX, centerY
        +BasePart(Schematic schematic)
        +compareTo(BasePart other)
    }

    class BlockIndexer {
        -IntSeq[][][] ores, wallOres
        -ObjectIntMap<Item> allOres, allWallOres
        -Seq<Building> breturnArray
        -Seq<Building>[] damagedTiles
        +BlockIndexer()
        +addIndex(Tile base)
        +addFloorIndex(Tile tile, Floor floor)
        +allBuildings(float x, float y, float range, Cons<Building> cons)
        +clearFlags()
    }

    class TurretQuadtree {
        +TurretQuadtree(Rect bounds)
        +hitbox(Building build)
        +newChild(Rect rect)
    }

    class ControlPathfinder {
        -Thread thread
        -Cluster[][][] clusters
        -IntFloatMap innerCosts
        -IntSet clustersToInnerUpdate
        -IntSet clustersToUpdate
        +ControlPathfinder()
        +avoid(int team, PathCost type, int tilePos)
        +checkEdges(PathRequest request, int team, int pathCost, int current, int goal, int cx, int cy, LongSeq connections)
        +addFlowCluster(FieldCache cache, int cluster, boolean addingFrontier)
    }

    class PathRequest {
        -IntFloatMap costs
        -IntIntMap cameFrom
        -PathfindQueue frontier
        -Tile lastTargetTile
        -volatile FieldCache oldCache
        +PathRequest(Unit unit, int team, int costId, int destination)
    }

    class FieldCache {
        -IntMap<int[]> fields
        -IntQueue frontier
        -PathCost cost
        -int costId
        -int goalPos
        +FieldCache(PathCost cost, int costId, int team, int goalPos)
    }

    class Cluster {
        -IntSeq[] portals
        -LongSeq[][] portalConnections
    }

    class FieldIndexStruct {
        +int costId
        +int team
        +int pos
    }

    class IntraEdgeStruct {
        +int dir
        +int portal
        +float cost
    }

    class NodeIndexStruct {
        +int dir
        +int cluster
        +int portal
    }

    class ItemUnitStance {
        -{static} ObjectMap<Item, ItemUnitStance> itemToStance
        -{static} Seq<ItemUnitStance> all
        +Item item
        +ItemUnitStance(Item item)
        +{static} all()
        +{static} getByItem(Item item)
        +getIcon()
        +localized()
    }

    class PathfindQueue {
        +float[] weights
        +int size
        +int[] queue
        +PathfindQueue()
        +PathfindQueue(int initialCapacity)
        +add(int e, float weight)
        +clear()
        +empty()
    }

    class Pathfinder {
        -Thread thread
        -Flowfield[][][] cache
        -IntSeq tmpArray
        -Seq<Flowfield> threadList, mainList
        -TaskQueue queue
        +Pathfinder()
        +clearCache()
        +get(int x, int y)
        +getField(Team team, int costType, int fieldType)
        +getTargetTile(Tile tile, Flowfield path)
    }

    class EnemyCoreField {
        -Rand rand
        -{static} BlockFlag[] randomTargets
        +getPositions(IntSeq out)
    }
}

' ─────────────────────────────────────
' Inheritance & Implementation Relationships
' ─────────────────────────────────────

' Android package
AndroidLauncher --|> AndroidApplication
AndroidContextFactory --|> ContextFactory
BaseAndroidClassLoader --|> ClassLoader
BaseAndroidClassLoader ..|> GeneratedClassLoader
FileAndroidClassLoader --|> BaseAndroidClassLoader
InMemoryAndroidClassLoader --|> BaseAndroidClassLoader

' Annotations package
BaseProcessor --|> AbstractProcessor
EntityProcess --|> BaseProcessor
AssetsProcess --|> BaseProcessor
StructProcess --|> BaseProcessor
LoadRegionProcessor --|> BaseProcessor
LogicStatementProcessor --|> BaseProcessor
RemoteProcess --|> BaseProcessor
Smethod --|> Selement
Stype --|> Selement
Svar --|> Selement
ValueVisitor ..|> Visitor

' Core package
ClientLauncher --|> ApplicationCore
ClientLauncher ..|> Platform
Vars ..|> Loadable

' AI package
TurretQuadtree --|> QuadTree
ItemUnitStance --|> UnitStance
EnemyCoreField --|> Flowfield
ControlPathfinder ..|> Runnable
Pathfinder ..|> Runnable
BasePart ..|> Comparable

' ─────────────────────────────────────
' Key Composition / Usage Relationships
' ─────────────────────────────────────
EntityProcess *-- GroupDefinition : defines
EntityProcess *-- EntityDefinition : defines
EntityDefinition o-- GroupDefinition : groups
EntityIO *-- ClassSerializer : uses
EntityIO *-- RevisionField : tracks
Revision *-- RevisionField : contains
CallGenerator ..> MethodEntry : processes
CallGenerator ..> ClassSerializer : uses
RemoteProcess ..> MethodEntry : creates
MethodEntry o-- Loc : where/local
MethodEntry o-- PacketPriority : priority
AnnotationProxyMaker *-- ValueVisitor : delegates to
TypeIOResolver ..> ClassSerializer : produces
BaseRegistry *-- BasePart : manages
BlockIndexer *-- TurretQuadtree : maintains
ControlPathfinder *-- Cluster : partitions
ControlPathfinder *-- PathRequest : tracks
ControlPathfinder *-- FieldCache : caches
PathRequest *-- PathfindQueue : uses frontier
Pathfinder *-- Flowfield : caches
Astar ..> DistanceHeuristic : uses
Astar ..> TileHeuristic : uses

@enduml
