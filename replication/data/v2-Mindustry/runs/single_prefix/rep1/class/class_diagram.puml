@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam enum {
    BackgroundColor #FFF3CD
    BorderColor #856404
}
skinparam interface {
    BackgroundColor #D1ECF1
    BorderColor #0C5460
}

title Mindustry — Class Diagram

' ─────────────────────────────────────
' External / base types (referenced)
' ─────────────────────────────────────
abstract class AndroidApplication <<external>>
abstract class ContextFactory <<external>>
abstract class ClassLoader <<external>>
interface GeneratedClassLoader <<external>>
abstract class AbstractProcessor <<external>>
abstract class ApplicationCore <<external>>
interface Platform <<external>>
interface Loadable <<external>>
interface Runnable <<external>>
abstract class QuadTree <<external>>
abstract class UnitStance <<external>>
abstract class Flowfield <<external>>
interface Visitor <<external>>
interface Comparable <<external>>

' ─────────────────────────────────────
' Package: mindustry.android
' ─────────────────────────────────────
package "mindustry.android" {

    class AndroidLauncher {
        -FileChooser chooser
        -Runnable permCallback
        -boolean doubleScaleTablets
        +{static} int PERMISSION_REQUEST_CODE
        +onCreate(Bundle savedInstanceState)
        +onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults)
        +checkFiles(Intent intent)
        +isTablet(Context context)
    }

    class AndroidRhinoContext {
        +enter(File cacheDirectory)
    }

    class AndroidContextFactory {
        -File cacheDirectory
        +AndroidContextFactory(File cacheDirectory)
        +createClassLoader(ClassLoader parent)
        +onContextReleased(Context cx)
    }

    class BaseAndroidClassLoader {
        +BaseAndroidClassLoader(ClassLoader parent)
        +defineClass(String name, byte[] data)
        +loadClass(Dex dex, String name)
        +getLastDex()
        +linkClass(Class<?> aClass)
    }

    class FileAndroidClassLoader {
        -File dexFile
        -{static} int instanceCounter
        +FileAndroidClassLoader(ClassLoader parent, File cacheDir)
        +loadClass(Dex dex, String name)
        +getLastDex()
        +reset()
    }

    class InMemoryAndroidClassLoader {
        -Dex last
        +InMemoryAndroidClassLoader(ClassLoader parent)
        +loadClass(Dex dex, String name)
        +getLastDex()
        +reset()
    }
}

' ─────────────────────────────────────
' Package: mindustry.annotations
' ─────────────────────────────────────
package "mindustry.annotations" {

    class Annotations {
    }

    enum PacketPriority {
        high
        low
        normal
    }

    enum Loc {
        both(true, true)
        client(false, true)
        none(false, false)
        server(true, false)
    }

    enum Variant {
        all(false, true)
        both(true, true)
        one(true, false)
    }

    class BaseProcessor {
        #Fi rootDirectory
        #RoundEnvironment env
        #int round
        #int rounds
        +{static} Elements elementu
        +elements(Class<? extends Annotation> type)
        +err(String message)
        +fields(Class<? extends Annotation> type)
    }

    class EntityIO {
        -MethodSpec.Builder method
        -ObjectSet<String> presentFields
        -boolean write
        -ClassSerializer serializer
        -Fi directory
        +EntityIO(String name, TypeSpec.Builder type, Seq<FieldSpec> typeFields, ClassSerializer serializer, Fi directory)
        +io(String type, String field, boolean network)
        +cont(String text, Object... fmt)
        +fieldHasAnno(RevisionField field, Seq<Svar> allFields, Class<? extends Annotation> type)
    }

    class Revision {
        -Seq<RevisionField> fields
        -int version
        +Revision(int version, Seq<RevisionField> fields)
        +equal(Seq<FieldSpec> specs)
    }

    class RevisionField {
        -String name
        -String type
        +RevisionField(String name, String type)
    }

    class EntityProcess {
        -ClassSerializer serializer
        -ObjectMap<Selement, Seq<Stype>> defComponents
        -ObjectMap<String, String> methodBlocks
        -ObjectMap<String, String> varInitializers
        -ObjectMap<String, Stype> componentNames
        +allComponents(Selement<?> type)
        +getDependencies(Stype component)
        +createName(Selement<?> elem)
        +baseName(Stype comp)
    }

    class GroupDefinition {
        -ClassName baseType
        -ObjectSet<Selement> manualInclusions
        -Seq<Stype> components
        -String name
        -boolean spatial, mapping, collides
        +GroupDefinition(String name, ClassName bestType, Seq<Stype> components, boolean spatial, boolean mapping, boolean collides)
        +toString()
    }

    class EntityDefinition {
        -TypeName extend
        -Selement naming
        -Seq<FieldSpec> fieldSpecs
        -Seq<GroupDefinition> groups
        -Seq<Stype> components
        +EntityDefinition(String name, Builder builder, Selement naming, TypeName extend, Seq<Stype> components, Seq<GroupDefinition> groups, Seq<FieldSpec> fieldSpec, boolean legacy)
        +toString()
    }

    class AssetsProcess {
        +process(RoundEnvironment env)
        +processUI(Set<? extends Element> elements)
        +processSounds(String classname, String path, String rtype, boolean genid)
        +capitalize(String s)
    }

    class StructProcess {
        +process(RoundEnvironment env)
        +typeSize(TypeKind kind)
        +typeForSize(int size)
        +bitString(int size, int totalSize)
    }

    class LoadRegionProcessor {
        +process(RoundEnvironment env)
        +parse(String value)
        +count(String str, String substring)
    }

    class LogicStatementProcessor {
        +process(RoundEnvironment env)
    }

    class CallGenerator {
        +generate(ClassSerializer serializer, Seq<MethodEntry> methods)
        +makeReader(TypeSpec.Builder typespec, MethodEntry ent, ClassSerializer serializer)
        +makeWriter(TypeSpec.Builder typespec, MethodEntry ent, ClassSerializer serializer)
        +writeCallMethod(TypeSpec.Builder classBuilder, MethodEntry ent, boolean toAll, boolean forwarded)
        +getCheckString(Loc loc)
    }

    class MethodEntry {
        +Loc local
        +Loc where
        +PacketPriority priority
        +Smethod element
        +String className
        +MethodEntry(String className, String targetMethod, String packetClassName, Loc where, Variant target, Loc local, boolean unreliable, boolean forward)
        +hashCode()
    }

    class RemoteProcess {
        +{static} String callLocation
        +process(RoundEnvironment roundEnv)
    }

    class SerializerResolver {
        +isEntity(TypeMirror mirror)
        +locate(ExecutableElement elem, TypeMirror mirror, boolean write)
    }

    class AnnotationProxyMaker {
        -Class<? extends Annotation> annoType
        -Compound anno
        +AnnotationProxyMaker(Compound var1, Class<? extends Annotation> var2)
        +generateAnnotation(Compound var0, Class<A> var1)
        +generateValue(MethodSymbol var1, Attribute var2)
        +getAllReflectedValues()
    }

    class ValueVisitor {
        -Class<?> returnClass
        -MethodSymbol meth
        -Object value
        +ValueVisitor(MethodSymbol var2)
        +getValue(Attribute var1)
        +visitArray(Array var1)
        +visitClass(com.sun.tools.javac.code.Attribute.Class var1)
    }

    class Selement {
        +T e
        +Selement(T e)
        +annotation(Class<A> annotation)
        +annotations()
        +asMethod()
        +asType()
    }

    class Smethod {
        +Smethod(ExecutableElement executableElement)
        +descString()
        +is(Modifier mod)
        +isVoid()
    }

    class Stype {
        +Stype(TypeElement typeElement)
        +allInterfaces()
        +allSuperclasses()
        +constructors()
        +fields()
    }

    class Svar {
        +Svar(VariableElement e)
        +descString()
        +enclosingType()
        +is(Modifier mod)
        +isAny(Modifier... mods)
    }

    class TypeIOResolver {
        +fix(String str)
        +resolve(BaseProcessor processor)
    }

    class ClassSerializer {
        +ObjectMap<String, String> writers
        +ObjectMap<String, String> readers
        +ObjectMap<String, String> mutatorReaders
        +ClassSerializer(ObjectMap<String, String> writers, ObjectMap<String, String> readers, ObjectMap<String, String> mutatorReaders, ObjectMap<String, String> netWriters)
        +getNetReader(String type, String fallback)
        +getNetWriter(String type, String fallback)
    }
}

