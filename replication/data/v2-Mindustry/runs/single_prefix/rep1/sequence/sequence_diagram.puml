@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
    BoxBackgroundColor #E9ECEF
    GroupBorderColor #6C757D
    GroupBackgroundColor #DEE2E6
    DividerBackgroundColor #CED4DA
    DividerBorderColor #6C757D
}

title Mindustry — Game Launch & AI Pathfinding Sequence

actor User as user
participant "AndroidLauncher" as launcher
participant "ClientLauncher" as client
participant "Vars" as vars
participant "BaseBuilderAI" as builderAI
participant "ControlPathfinder" as pathfinder
participant "PathfindQueue" as queue
participant "Astar" as astar
participant "BlockIndexer" as blockIdx
participant "Pathfinder" as flowPathfinder

== Game Initialization ==

user -> launcher : onCreate(savedInstanceState)
activate launcher

launcher -> launcher : checkFiles(intent)
activate launcher
launcher --> launcher : [file check complete]
deactivate launcher

launcher -> client : init()
activate client

client -> vars : init()
activate vars
vars -> vars : checkLaunch()
vars -> vars : loadAsync()
vars --> client : [vars initialized]
deactivate vars

client -> client : resize(width, height)
client --> launcher : [client ready]
deactivate client

launcher -> launcher : onRequestPermissionsResult(requestCode, permissions, grantResults)
launcher --> user : [app launched]
deactivate launcher

== AI Base Building ==

participant "TeamData" as teamData

builderAI -> builderAI : update()
activate builderAI

builderAI -> builderAI : randomPosition()
activate builderAI
builderAI --> builderAI : [position selected]
deactivate builderAI

builderAI -> builderAI : tryPlace(part, x, y)
activate builderAI
builderAI --> builderAI : [placement attempted]
deactivate builderAI

deactivate builderAI

== AI Pathfinding Flow ==

participant "Unit" as unit
participant "PathRequest" as pathReq
participant "FieldCache" as fieldCache

unit -> pathfinder : initializePathRequest(request, team, costId, unitX, unitY, goalX, goalY)
activate pathfinder

pathfinder -> pathReq ** : PathRequest(unit, team, costId, destination)
activate pathReq
pathReq --> pathfinder : [request created]
deactivate pathReq

pathfinder -> fieldCache ** : FieldCache(cost, costId, team, goalPos)
activate fieldCache
fieldCache --> pathfinder : [cache initialized]
deactivate fieldCache

pathfinder -> pathfinder : checkEdges(request, team, pathCost, current, goal, cx, cy, connections)
activate pathfinder

pathfinder -> queue : add(e, weight)
activate queue
queue -> queue : siftUp(k, x, weight)
queue --> pathfinder : [element enqueued]
deactivate queue

pathfinder -> pathfinder : innerAstar(team, cost, minX, minY, maxX, maxY, startPos, goalPos)
activate pathfinder

pathfinder -> astar : pathfind(startX, startY, endX, endY, th, dh, passable)
activate astar
astar --> pathfinder : [path result]
deactivate astar

deactivate pathfinder
deactivate pathfinder

pathfinder -> pathfinder : raycastRect(initialCost, startX, startY, endX, endY, team, type, x1)
activate pathfinder
pathfinder --> pathfinder : [raycast done]
deactivate pathfinder

pathfinder --> unit : [path computed]
deactivate pathfinder

== Block Search & Targeting ==

unit -> blockIdx : findEnemyTile(team, x, y, range, priority, pred)
activate blockIdx

blockIdx -> blockIdx : eachBlock(team, wx, wy, range, pred, cons)
activate blockIdx
blockIdx --> blockIdx : [blocks iterated]
deactivate blockIdx

blockIdx -> blockIdx : findTile(team, x, y, range, pred, usePriority)
activate blockIdx
blockIdx --> blockIdx : [tile found]
deactivate blockIdx

blockIdx --> unit : [enemy target acquired]
deactivate blockIdx

== Flow Field Pathfinding ==

unit -> flowPathfinder : getField(team, costType, fieldType)
activate flowPathfinder
flowPathfinder --> unit : [Flowfield]
deactivate flowPathfinder

unit -> flowPathfinder : getTargetTile(tile, path, diagonals, avoidanceId)
activate flowPathfinder
flowPathfinder --> unit : [target Tile]
deactivate flowPathfinder

@enduml
