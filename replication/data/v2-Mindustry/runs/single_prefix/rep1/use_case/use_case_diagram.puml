@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}

title Mindustry — Use Case Diagram

left to right direction

actor "Player" as player
actor "AI Opponent" as ai
actor "Android Platform" as android
actor "Build Processor" as buildproc
actor "Remote Peer\n(Multiplayer)" as remote

rectangle "Mindustry Game System" {

    ' === Game Launch & Lifecycle ===
    usecase "Launch Game" as UC_Launch
    usecase "Initialize Game State" as UC_Init
    usecase "Load File Logger" as UC_Logger
    usecase "Drop File into Game" as UC_FileDrop
    usecase "Exit Game" as UC_Exit

    ' === Android Platform ===
    usecase "Request Runtime Permissions" as UC_Perms
    usecase "Check Intent Files" as UC_CheckFiles
    usecase "Execute JavaScript\n(Rhino Scripting)" as UC_Script
    usecase "Load Class Dynamically" as UC_ClassLoad

    ' === Base Building & Strategy ===
    usecase "Build / Place Structures" as UC_Build
    usecase "Load Base Schematics" as UC_Schematics
    usecase "Find Resource-based Base" as UC_BaseForResource
    usecase "Try Place Base Part" as UC_TryPlace

    ' === Pathfinding & Navigation ===
    usecase "Pathfind Unit" as UC_Pathfind
    usecase "A* Tile Pathfinding" as UC_Astar
    usecase "Flow-field Navigation" as UC_Flowfield
    usecase "Raycast Path Check" as UC_Raycast

    ' === Combat & Targeting ===
    usecase "Find Enemy Target" as UC_FindEnemy
    usecase "Index Blocks / Turrets" as UC_IndexBlocks
    usecase "Evaluate Item Stance" as UC_ItemStance

    ' === Multiplayer / Remote Communication ===
    usecase "Send Remote Call" as UC_RemoteCall
    usecase "Receive Remote Call" as UC_ReceiveCall

    ' === Build-time Annotation Processing ===
    usecase "Process Entity Annotations" as UC_EntityProc
    usecase "Process Asset Annotations" as UC_AssetsProc
    usecase "Process Struct Annotations" as UC_StructProc
    usecase "Process Remote Annotations" as UC_RemoteProc
    usecase "Generate Entity I/O Code" as UC_EntityIO
    usecase "Resolve Serializer Types" as UC_SerializerResolve

    ' --- include / extend relationships ---
    UC_Launch ..> UC_Init : <<include>>
    UC_Launch ..> UC_Logger : <<include>>
    UC_FileDrop ..> UC_Script : <<extend>>
    UC_Script ..> UC_ClassLoad : <<include>>
    UC_Build ..> UC_Schematics : <<include>>
    UC_Build ..> UC_TryPlace : <<include>>
    UC_BaseForResource ..> UC_Schematics : <<include>>
    UC_Pathfind ..> UC_Astar : <<extend>>
    UC_Pathfind ..> UC_Flowfield : <<extend>>
    UC_Flowfield ..> UC_Raycast : <<include>>
    UC_FindEnemy ..> UC_IndexBlocks : <<include>>
    UC_RemoteProc ..> UC_RemoteCall : <<include>>
    UC_EntityProc ..> UC_EntityIO : <<include>>
    UC_EntityIO ..> UC_SerializerResolve : <<include>>
    UC_RemoteCall ..> UC_SerializerResolve : <<include>>
}

' --- Actor → Use Case associations ---
player --> UC_Launch
player --> UC_Build
player --> UC_FileDrop
player --> UC_Exit
player --> UC_Pathfind
player --> UC_FindEnemy
player --> UC_RemoteCall

ai --> UC_Build
ai --> UC_Pathfind
ai --> UC_FindEnemy
ai --> UC_BaseForResource
ai --> UC_ItemStance

android --> UC_Launch
android --> UC_Perms
android --> UC_CheckFiles
android --> UC_Script

remote --> UC_ReceiveCall
remote --> UC_RemoteCall

buildproc --> UC_EntityProc
buildproc --> UC_AssetsProc
buildproc --> UC_StructProc
buildproc --> UC_RemoteProc

@enduml
