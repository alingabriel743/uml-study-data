@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Mindustry — Game Launch & AI Pathfinding Activity Flow

|#E3F2FD|Android Platform|
start
:onCreate(savedInstanceState);
if (isTablet?) then (yes)
    :Configure tablet UI layout;
else (no)
    :Configure phone UI layout;
endif
:checkFiles(intent);
if (Game files present?) then (yes)
    :Request runtime permissions;
    if (Permissions granted?) then (yes)
        :Launch ClientLauncher;
    else (no)
        :onRequestPermissionsResult — handle denial;
        stop
    endif
else (no)
    :Show missing files error;
    stop
endif

|#E8F5E9|ClientLauncher|
:init();
:add(ApplicationListener modules);
:Register file drop handler;
fork
    :loadAsync() — async asset loading;
fork again
    :loadFileLogger(logFile);
end fork

|#FFF9C4|Vars|
:init();
:checkLaunch();
if (Launch state valid?) then (yes)
    :loadAsync() — load game content;
    fork
        :Load sounds and textures;
    fork again
        :Initialize world and maps;
    fork again
        :Register content and items;
    end fork
    :finishLaunch();
    :Game loop starts;
else (no)
    :Log launch error;
    stop
endif

|#FCE4EC|AI System — BaseBuilderAI|
:update() — AI tick;
:randomPosition() — choose build site;
:BaseRegistry.forResource(item) — find schematic;
if (Schematic available?) then (yes)
    :tryPlace(BasePart, x, y);
    if (Placement valid?) then (yes)
        :Place base component;
        :Update TeamData;
    else (no)
        :Skip — blocked or occupied;
    endif
else (no)
    :No suitable schematic — wait;
endif

|#F3E5F5|AI System — ControlPathfinder|
:initializePathRequest(unit, team, costId, startX, startY, goalX, goalY);
:PathRequest created;
:innerAstar(team, cost, minX, minY, maxX, maxY, startPos, goalPos);
repeat
    :checkEdges(request, team, pathCost, current, goal, cx, cy, connections);
    if (Edge traversable?) then (yes)
        :Add neighbor to open set via PathfindQueue;
    else (no)
        :Discard edge;
    endif
repeat while (Goal not reached and nodes remain?) is (yes)
->no;
if (Path found?) then (yes)
    :Pathfinder.getField(team, costType, fieldType);
    :getTargetTile(tile, flowfield, diagonals);
    :Return next movement tile to unit;
else (no)
    :No path available — unit waits;
endif

|#E3F2FD|Android Platform|
:Game loop active — resize(width, height) on orientation change;
:fileDropped(fi) — handle external file imports;
if (Exit requested?) then (yes)
    :exit();
    stop
else (no)
    :Continue game loop;
    stop
endif

@enduml
