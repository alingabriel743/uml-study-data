' ─────────────────────────────────────────
'  AI module
' ─────────────────────────────────────────
package "mindustry.ai" {

    class Astar {
        -rotations: byte[][]
        -queue: PQueue<Tile>
        -out: Seq<Tile>
        -costs: float[]
        +manhattan: DistanceHeuristic
        +pathfind(from: Tile, to: Tile, th: TileHeuristic, passable: Boolf<Tile>): Seq<Tile>
        +pathfind(startX: int, startY: int, endX: int, endY: int, th: TileHeuristic, passable: Boolf<Tile>): Seq<Tile>
        +pathfind(startX: int, startY: int, endX: int, endY: int, th: TileHeuristic, dh: DistanceHeuristic, passable: Boolf<Tile>): Seq<Tile>
    }

    interface DistanceHeuristic {
        +cost(x1: int, y1: int, x2: int, y2: int): float
    }

    interface TileHeuristic {
        +cost(tile: Tile): float
        +cost(from: Tile, tile: Tile): float
    }

    class BaseBuilderAI {
        -calcTile: Tile
        -calcPath: IntSet
        -path: IntSet
        -calculating: boolean
        -timer: Interval
        +BaseBuilderAI(data: TeamData)
        +randomPosition(): Tile
        +tryPlace(part: BasePart, x: int, y: int): boolean
        +update(): void
    }

    class BaseRegistry {
        +reqParts: ObjectMap<Content, Seq<BasePart>>
        +oreFloors: ObjectMap<Item, Floor>
        +ores: ObjectMap<Item, OreBlock>
        +cores: Seq<BasePart>
        +parts: Seq<BasePart>
        +forResource(item: Content): Seq<BasePart>
        +load(): void
    }

    class BasePart {
        +core: Block
        +required: Content
        +schematic: Schematic
        +tier: float
        +centerX: int
        +centerY: int
        +BasePart(schematic: Schematic)
        +compareTo(other: BasePart): int
    }

    class BlockIndexer {
        -ores: IntSeq[][][]
        -allOres: ObjectIntMap<Item>
        -breturnArray: Seq<Building>
        -damagedTiles: Seq<Building>[]
        -flagMap: Seq<Building>[][]
        +BlockIndexer()
        +addFloorIndex(tile: Tile, floor: Floor): void
        +addIndex(base: Tile): void
        +allBuildings(x: float, y: float, range: float, cons: Cons<Building>): void
        +clearFlags(): void
    }

    class TurretQuadtree {
        +TurretQuadtree(bounds: Rect)
        +hitbox(build: Building): Rect
        +newChild(rect: Rect): TurretQuadtree
    }

    class ControlPathfinder {
        -thread: Thread
        -clusters: Cluster[][][]
        -innerCosts: IntFloatMap
        -clustersToInnerUpdate: IntSet
        -clustersToUpdate: IntSet
        +ControlPathfinder()
        +addFlowCluster(cache: FieldCache, cluster: int, addingFrontier: boolean): void
        +avoid(team: int, type: PathCost, tilePos: int): void
        +checkEdges(request: PathRequest, team: int, pathCost: int, current: int, goal: int, cx: int, cy: int, connections: LongSeq): void
    }

    class PathRequest {
        -costs: IntFloatMap
        -cameFrom: IntIntMap
        -frontier: PathfindQueue
        -lastTargetTile: Tile
        -oldCache: FieldCache
        +PathRequest(unit: Unit, team: int, costId: int, destination: int)
    }

    class FieldCache {
        -fields: IntMap<int[]>
        -frontier: IntQueue
        -cost: PathCost
        -costId: int
        -goalPos: int
        +FieldCache(cost: PathCost, costId: int, team: int, goalPos: int)
    }

    class Cluster {
        +portals: IntSeq[]
        +portalConnections: LongSeq[][]
    }

    class FieldIndexStruct {
        +costId: int
        +team: int
        +pos: int
    }

    class IntraEdgeStruct {
        +dir: int
        +portal: int
        +cost: float
    }

    class NodeIndexStruct {
        +dir: int
        +cluster: int
        +portal: int
    }

    class ItemUnitStance {
        -itemToStance: ObjectMap<Item, ItemUnitStance>
        -all: Seq<ItemUnitStance>
        +item: Item
        +ItemUnitStance(item: Item)
        +all(): Seq<ItemUnitStance>
        +getByItem(item: Item): ItemUnitStance
        +getIcon(): TextureRegion
        +localized(): String
    }

    class PathfindQueue {
        +weights: float[]
        +size: int = 0
        +queue: int[]
        +PathfindQueue()
        +PathfindQueue(initialCapacity: int)
        +add(e: int, weight: float): void
        +clear(): void
        +empty(): boolean
    }

    class Pathfinder {
        -thread: Thread
        -cache: Flowfield[][][]
        -tmpArray: IntSeq
        -threadList: Seq<Flowfield>
        -queue: TaskQueue
        +Pathfinder()
        +clearCache(): void
        +get(x: int, y: int): Flowfield
        +getField(team: Team, costType: int, fieldType: int): Flowfield
        +getTargetTile(tile: Tile, path: Flowfield): Tile
    }

    class EnemyCoreField {
        -rand: Rand
        -randomTargets: BlockFlag[]
        +getPositions(out: IntSeq): void
    }
}

' ─────────────────────────────────────────
'  Inheritance / Implementation
' ─────────────────────────────────────────

' Android hierarchy
AndroidLauncher --|> AndroidApplication : extends
AndroidContextFactory --|> ContextFactory : extends
BaseAndroidClassLoader --|> ClassLoader : extends
BaseAndroidClassLoader ..|> GeneratedClassLoader : implements
FileAndroidClassLoader --|> BaseAndroidClassLoader : extends
InMemoryAndroidClassLoader --|> BaseAndroidClassLoader : extends

' Annotations processors
BaseProcessor --|> AbstractProcessor : extends
EntityProcess --|> BaseProcessor : extends
AssetsProcess --|> BaseProcessor : extends
StructProcess --|> BaseProcessor : extends
LoadRegionProcessor --|> BaseProcessor : extends
LogicStatementProcessor --|> BaseProcessor : extends
RemoteProcess --|> BaseProcessor : extends

' Annotation util hierarchy
Smethod --|> Selement : extends
Stype --|> Selement : extends
Svar --|> Selement : extends
ValueVisitor ..|> Visitor : implements

' Core hierarchy
ClientLauncher --|> ApplicationCore : extends
ClientLauncher ..|> Platform : implements
Vars ..|> Loadable : implements

' AI hierarchy
TurretQuadtree --|> QuadTree : extends
ItemUnitStance --|> UnitStance : extends
EnemyCoreField --|> Flowfield : extends
ControlPathfinder ..|> Runnable : implements
Pathfinder ..|> Runnable : implements
BasePart ..|> Comparable : implements

' Key associations
ControlPathfinder *-- PathRequest : manages
ControlPathfinder *-- FieldCache : caches
ControlPathfinder *-- Cluster : clusters
PathRequest o-- FieldCache : references
EntityProcess o-- ClassSerializer : uses
EntityIO o-- ClassSerializer : uses
TypeIOResolver ..> ClassSerializer : creates
MethodEntry o-- Loc : where / local
MethodEntry o-- PacketPriority : priority
CallGenerator ..> MethodEntry : generates from
EntityDefinition o-- GroupDefinition : groups
EntityDefinition o-- Selement : naming
GroupDefinition o-- Stype : components
Astar ..> DistanceHeuristic : uses
Astar ..> TileHeuristic : uses
BaseRegistry *-- BasePart : parts

@enduml
