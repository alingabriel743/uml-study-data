' ─────────────────────────────────────────
'  Android module
' ─────────────────────────────────────────
package "mindustry.android" {

    class AndroidLauncher {
        -chooser: FileChooser
        -permCallback: Runnable
        -doubleScaleTablets: boolean = true
        +PERMISSION_REQUEST_CODE: int = 1
        +checkFiles(intent: Intent): void
        +isTablet(context: Context): boolean
        +onCreate(savedInstanceState: Bundle): void
        +onRequestPermissionsResult(requestCode: int, permissions: String[], grantResults: int[]): void
    }

    class AndroidRhinoContext {
        +enter(cacheDirectory: File): Context
    }

    class AndroidContextFactory {
        -cacheDirectory: File
        +AndroidContextFactory(cacheDirectory: File)
        +createClassLoader(parent: ClassLoader): ClassLoader
        +onContextReleased(cx: Context): void
    }

    abstract class BaseAndroidClassLoader {
        +BaseAndroidClassLoader(parent: ClassLoader)
        +defineClass(name: String, data: byte[]): Class<?>
        +getLastDex(): Dex
        +linkClass(aClass: Class<?>): void
        +loadClass(dex: Dex, name: String): Class<?>
    }

    class FileAndroidClassLoader {
        -dexFile: File
        -instanceCounter: int
        +FileAndroidClassLoader(parent: ClassLoader, cacheDir: File)
        +getLastDex(): Dex
        +loadClass(dex: Dex, name: String): Class<?>
        +reset(): void
    }

    class InMemoryAndroidClassLoader {
        -last: Dex
        +InMemoryAndroidClassLoader(parent: ClassLoader)
        +getLastDex(): Dex
        +loadClass(dex: Dex, name: String): Class<?>
        +reset(): void
    }
}

' ─────────────────────────────────────────
'  Annotations — core
' ─────────────────────────────────────────
package "mindustry.annotations" {

    class Annotations {
    }

    enum PacketPriority {
        high
        normal
        low
    }

    enum Loc {
        both(true, true)
        client(false, true)
        server(true, false)
        none(false, false)
    }

    enum Variant {
        all(false, true)
        both(true, true)
        one(true, false)
    }

    abstract class BaseProcessor {
        #rootDirectory: Fi
        #env: RoundEnvironment
        #round: int
        #rounds: int = 1
        +elementu: Elements
        +elements(type: Class<Annotation>): Seq<Element>
        +err(message: String): void
        +fields(type: Class<Annotation>): Seq<Element>
    }
}

' ─────────────────────────────────────────
'  Annotations — entity processing
' ─────────────────────────────────────────
package "mindustry.annotations.entity" {

    class EntityProcess {
        -serializer: ClassSerializer
        -defComponents: ObjectMap
        -methodBlocks: ObjectMap
        -varInitializers: ObjectMap
        -componentNames: ObjectMap
        +allComponents(type: Selement<?>): Seq<Stype>
        +baseName(comp: Stype): String
        +createName(elem: Selement<?>): String
        +getDependencies(component: Stype): Seq<Stype>
        +getImports(elem: Element): Seq<String>
    }

    class EntityIO {
        -method: MethodSpec.Builder
        -presentFields: ObjectSet<String>
        -write: boolean
        -serializer: ClassSerializer
        -directory: Fi
        +EntityIO(name: String, type: TypeSpec.Builder, typeFields: Seq<FieldSpec>, serializer: ClassSerializer, directory: Fi)
        +cont(text: String, fmt: Object...): void
        +econt(): void
        +fieldHasAnno(field: RevisionField, allFields: Seq<Svar>, type: Class<Annotation>): boolean
        +io(type: String, field: String, network: boolean): void
    }

    class Revision {
        +fields: Seq<RevisionField>
        +version: int
        +Revision(version: int, fields: Seq<RevisionField>)
        +equal(specs: Seq<FieldSpec>): boolean
    }

    class RevisionField {
        +name: String
        +type: String
        +RevisionField(name: String, type: String)
    }

    class GroupDefinition {
        -baseType: ClassName
        -manualInclusions: ObjectSet<Selement>
        -components: Seq<Stype>
        -name: String
        -spatial: boolean
        -mapping: boolean
        -collides: boolean
        +GroupDefinition(name: String, bestType: ClassName, components: Seq<Stype>, spatial: boolean, mapping: boolean, collides: boolean)
        +toString(): String
    }

    class EntityDefinition {
        -extend: TypeName
        -naming: Selement
        -fieldSpecs: Seq<FieldSpec>
        -groups: Seq<GroupDefinition>
        -components: Seq<Stype>
        +EntityDefinition(name: String, builder: Builder, naming: Selement, extend: TypeName, components: Seq<Stype>, groups: Seq<GroupDefinition>, fieldSpec: Seq<FieldSpec>, legacy: boolean)
        +toString(): String
    }
}

