' ─────────────────────────────────────────
'  Annotations — remote processing
' ─────────────────────────────────────────
package "mindustry.annotations.remote" {

    class CallGenerator {
        +generate(serializer: ClassSerializer, methods: Seq<MethodEntry>): void
        +getCheckString(loc: Loc): String
        +makeReader(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer): void
        +makeWriter(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer): void
        +writeCallMethod(classBuilder: TypeSpec.Builder, ent: MethodEntry, toAll: boolean, forwarded: boolean): void
    }

    class MethodEntry {
        +local: Loc
        +where: Loc
        +priority: PacketPriority
        +element: Smethod
        +className: String
        +MethodEntry(className: String, targetMethod: String, packetClassName: String, where: Loc, target: Variant, local: Loc, unreliable: boolean, forward: boolean)
        +hashCode(): int
    }

    class RemoteProcess {
        +callLocation: String = "Call"
        +process(roundEnv: RoundEnvironment): void
    }

    class SerializerResolver {
        +isEntity(mirror: TypeMirror): boolean
        +locate(elem: ExecutableElement, mirror: TypeMirror, write: boolean): String
    }
}

' ─────────────────────────────────────────
'  Annotations — util
' ─────────────────────────────────────────
package "mindustry.annotations.util" {

    class Selement<T> {
        +e: T
        +Selement(e: T)
        +annotation(annotation: Class<A>): A
        +annotations(): List<Annotation>
        +asMethod(): Smethod
        +asType(): Stype
    }

    class Smethod {
        +Smethod(executableElement: ExecutableElement)
        +descString(): String
        +is(mod: Modifier): boolean
        +isAny(mod: Modifier...): boolean
        +isVoid(): boolean
    }

    class Stype {
        +Stype(typeElement: TypeElement)
        +allInterfaces(): Seq<Stype>
        +allSuperclasses(): Seq<Stype>
        +constructors(): Seq<Smethod>
        +fields(): Seq<Svar>
    }

    class Svar {
        +Svar(e: VariableElement)
        +descString(): String
        +enclosingType(): Stype
        +is(mod: Modifier): boolean
        +isAny(mods: Modifier...): boolean
    }

    class AnnotationProxyMaker {
        -annoType: Class<Annotation>
        -anno: Compound
        +AnnotationProxyMaker(anno: Compound, var2: Class<Annotation>)
        +generateAnnotation(var0: Compound, var1: Class<A>): A
        +generateValue(var1: MethodSymbol, var2: Attribute): Object
        +getAllReflectedValues(): Map<String, Object>
    }

    class ValueVisitor {
        -returnClass: Class<?>
        -meth: MethodSymbol
        -value: Object
        +ValueVisitor(var2: MethodSymbol)
        +getValue(var1: Attribute): Object
        +typeMismatch(var1: Method, var2: Attribute): void
        +visitArray(var1: Array): void
        +visitClass(var1: Attribute.Class): void
    }

    class TypeIOResolver {
        +fix(str: String): String
        +resolve(processor: BaseProcessor): ClassSerializer
    }

    class ClassSerializer {
        +writers: ObjectMap<String, String>
        +readers: ObjectMap<String, String>
        +mutatorReaders: ObjectMap<String, String>
        +ClassSerializer(writers: ObjectMap, readers: ObjectMap, mutatorReaders: ObjectMap, netWriters: ObjectMap)
        +getNetReader(type: String, fallback: String): String
        +getNetWriter(type: String, fallback: String): String
    }
}

