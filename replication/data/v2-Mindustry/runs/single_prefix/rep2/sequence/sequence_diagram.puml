@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Mindustry — Core Runtime Sequence\n(App Startup · Pathfinding · AI Base Building)

' ─── Participants ───────────────────────────────────────────────
actor       "Android OS"         as OS
participant "AndroidLauncher"    as AL
participant "ClientLauncher"     as CL
participant "Vars"               as Vars

box "AI Subsystem" #E8F4FD
    participant "BaseBuilderAI"    as BBAI
    participant "BaseRegistry"     as BReg
    participant "BlockIndexer"     as BI
    participant "TurretQuadtree"   as TQ
end box

box "Pathfinding Subsystem" #EDF7ED
    participant "ControlPathfinder" as CPF
    participant "PathRequest"       as PR
    participant "FieldCache"        as FC
    participant "PathfindQueue"     as PQ
    participant "Pathfinder"        as PF
    participant "Astar"             as Astar
end box

' ════════════════════════════════════════════════════════════════
' FLOW 1 — Application Startup
' ════════════════════════════════════════════════════════════════
== App Startup ==

OS -> AL : onCreate(savedInstanceState)
activate AL

AL -> AL : checkFiles(intent)
note right : Verify required\ngame assets exist

AL -> CL : init()
activate CL

CL -> Vars : init()
activate Vars
Vars --> CL : (core systems registered)
deactivate Vars

CL -> Vars : loadAsync()
activate Vars
note right : Background asset\nloading thread
Vars --> CL : (async load started)
deactivate Vars

CL -> CL : resize(width, height)
CL -> CL : add(applicationListener)

CL -> Vars : finishLaunch()
activate Vars
Vars --> CL : (launch complete)
deactivate Vars

CL --> AL : (client ready)
deactivate CL

AL --> OS : (activity running)
deactivate AL

' ════════════════════════════════════════════════════════════════
' FLOW 2 — Unit Pathfinding Request
' ════════════════════════════════════════════════════════════════
== Unit Pathfinding ==

[-> CPF : initializePathRequest(request, team, costId, unitX, unitY, goalX, goalY)
activate CPF

CPF -> PR : new PathRequest(unit, team, costId, destination)
activate PR
PR --> CPF : pathRequest
deactivate PR

CPF -> PF : getField(team, costType, fieldType)
activate PF
PF --> CPF : flowField
deactivate PF

CPF -> FC : new FieldCache(cost, costId, team, goalPos)
activate FC
FC --> CPF : fieldCache
deactivate FC

CPF -> PQ : new PathfindQueue(initialCapacity)
activate PQ

CPF -> CPF : innerAstar(team, cost, minX, minY, maxX, maxY, startPos, goalPos)
activate CPF #DarkSalmon

  loop until goal reached or queue empty
    CPF -> PQ : add(nodeId, weight)
    PQ -> PQ  : siftUp(k, x, weight)
    PQ --> CPF : (node enqueued)

    CPF -> CPF : checkEdges(request, team, pathCost, current, goal, cx, cy, connections)
    activate CPF #LightCoral

      opt raycast shortcut available
        CPF -> CPF : raycastRect(initialCost, startX, startY, endX, endY, team, type, x1)
        CPF -> CPF : overlap(initialCost, team, type, x, y, startX, startY, endX)
      end

    deactivate CPF
  end

  CPF --> CPF : (path field computed)
deactivate CPF

PQ --> CPF : (queue consumed)
deactivate PQ

CPF -> PF : getTargetTile(tile, flowField, diagonals, avoidanceId)
activate PF
PF -> Astar : pathfind(from, to, th, passable)
activate Astar
Astar --> PF : Seq<Tile>
deactivate Astar
PF --> CPF : nextTile
deactivate PF

CPF --> [: nextTile (unit moves toward goal)
deactivate CPF

' ════════════════════════════════════════════════════════════════
' FLOW 3 — AI Base Building Update Tick
' ════════════════════════════════════════════════════════════════
== AI Base Building (Update Tick) ==

[-> BBAI : update()
activate BBAI

BBAI -> BReg : load()
activate BReg
BReg -> BReg : forResource(item)
BReg --> BBAI : Seq<BasePart>
deactivate BReg

BBAI -> BBAI : randomPosition()
note right : Pick candidate\nbuild location

BBAI -> BI : findTile(team, x, y, range, pred, usePriority)
activate BI

BI -> TQ : hitbox(building)
activate TQ
TQ --> BI : Rect bounds
deactivate TQ

BI --> BBAI : Building candidateTile
deactivate BI

alt valid placement found
    BBAI -> BI : eachBlock(team, wx, wy, range, pred, cons)
    activate BI
    BI --> BBAI : (nearby buildings iterated)
    deactivate BI

    BBAI -> BBAI : tryPlace(part, x, y)
    note right : Places schematic\npart on tile

else enemy building nearby
    BBAI -> BI : findEnemyTile(team, x, y, range, priority, pred)
    activate BI
    BI --> BBAI : Building enemyTile
    deactivate BI
end

BBAI --> [: (tick complete)
deactivate BBAI

@enduml
