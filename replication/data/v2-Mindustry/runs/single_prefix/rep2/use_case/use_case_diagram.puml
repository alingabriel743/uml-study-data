@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #343A40
}

title Mindustry — Use Case Diagram

left to right direction

actor "Player" as player
actor "Android User" as androidUser
actor "Game AI" as gameAI
actor "Build Processor" as buildProcessor

androidUser --|> player

rectangle "Mindustry Game System" {

    package "Game Launch & Lifecycle" {
        usecase "Launch Game" as UC1
        usecase "Initialize Application" as UC2
        usecase "Launch on Android" as UC3
        usecase "Request Device Permissions" as UC4
        usecase "Drop File into Game" as UC5
        usecase "Exit Game" as UC6
    }

    package "AI & Pathfinding" {
        usecase "Pathfind Unit (A*)" as UC7
        usecase "Control Unit Path" as UC8
        usecase "Build Base (AI)" as UC9
        usecase "Find Enemy Targets" as UC10
        usecase "Index Map Blocks" as UC11
        usecase "Manage Item Unit Stance" as UC12
    }

    package "Code Generation (Build Time)" {
        usecase "Process Entity Annotations" as UC13
        usecase "Generate Remote Call Stubs" as UC14
        usecase "Process Asset Annotations" as UC15
        usecase "Resolve Type Serialization" as UC16
        usecase "Generate Struct Types" as UC17
    }
}

' Player interactions
player --> UC1
player --> UC5
player --> UC6

' Android User specific interactions
androidUser --> UC3
UC3 ..> UC4 : <<include>>
UC3 ..> UC1 : <<include>>

' Launch flow
UC1 ..> UC2 : <<include>>

' Game AI interactions
gameAI --> UC7
gameAI --> UC8
gameAI --> UC9
gameAI --> UC10
gameAI --> UC12
UC10 ..> UC11 : <<include>>
UC7 ..> UC8 : <<extend>>

' Build Processor interactions
buildProcessor --> UC13
buildProcessor --> UC14
buildProcessor --> UC15
buildProcessor --> UC17
UC13 ..> UC16 : <<include>>
UC14 ..> UC16 : <<include>>

@enduml
