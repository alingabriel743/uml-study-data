@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
    StartColor #212529
    EndColor #212529
    BarColor #495057
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Mindustry — Game Launch, Initialization & AI Pathfinding Flow

|Android / Client Launcher|
start
:App Launched\n(AndroidLauncher.onCreate / ClientLauncher.init);
if (Running on tablet?) then (yes)
    :Apply tablet UI configuration;
else (no)
    :Apply default phone/desktop configuration;
endif

:Register ApplicationListener modules\n(ClientLauncher.add);

|Game Core (Vars)|
:Initialize core game systems\n(Vars.init);
:Start async asset loading\n(Vars.loadAsync);

fork
    :Load textures and audio assets;
fork again
    :Load game content and data\n(BaseRegistry.load);
    :Map resources to bases\n(BaseRegistry.forResource);
end fork

:Finish launch sequence\n(Vars.finishLaunch);
:Initialize file logger\n(Vars.loadFileLogger);
:Check launch conditions\n(Vars.checkLaunch);

|Annotation Processor (Build-time)|
:Annotation processing triggered\n(BaseProcessor.process);
if (Annotation errors?) then (yes)
    :Report error via BaseProcessor.err;
    stop
else (no)
    :Resolve type names\n(BaseProcessor.tname / instanceOf);
endif

fork
    :Process asset regions\n(AssetsProcess.process → processUI / processSounds);
fork again
    :Process entity components\n(EntityProcess → allComponents / getDependencies);
    :Generate entity I/O\n(EntityIO.write / writeSync);
fork again
    :Process remote call stubs\n(RemoteProcess → CallGenerator.generate);
    :Write reader/writer packet methods\n(CallGenerator.makeReader / makeWriter);
fork again
    :Process struct packing\n(StructProcess.process);
    :Compute bit strings and type sizes\n(StructProcess.bitString / typeForSize);
end fork

:Annotation processing complete;

|AI & Pathfinding (Runtime)|
:Game update tick begins;
:BaseBuilderAI.update triggered\n(per TeamData);

:Select random build position\n(BaseBuilderAI.randomPosition);
if (Valid build position found?) then (yes)
    :Attempt to place base part\n(BaseBuilderAI.tryPlace);
    if (Placement successful?) then (yes)
        :Part added to team base;
    else (no)
        :Skip placement this tick;
    endif
else (no)
    :No position available — skip;
endif

:Unit requests path to target;
:Initialize PathRequest\n(ControlPathfinder.initializePathRequest);
if (Cached FieldCache available?) then (yes)
    :Retrieve cached flow field\n(Pathfinder.getField);
else (no)
    :Run inner A* search\n(ControlPathfinder.innerAstar);
    :Enqueue open nodes\n(PathfindQueue.add / siftUp);
    repeat
        :Dequeue lowest-cost node\n(PathfindQueue — siftDown);
        :Check edges for neighbors\n(ControlPathfinder.checkEdges);
        if (Goal reached?) then (yes)
            :Path found — reconstruct route;
        else (no)
            :Expand neighbors with cost heuristics\n(TileHeuristic.cost / DistanceHeuristic.cost);
        endif
    repeat while (Open set not empty and goal not reached?) is (yes)
    -> no;
    :Cache result as FieldCache;
endif

:Get next target tile from flow field\n(Pathfinder.getTargetTile);

:Query BlockIndexer for enemy buildings\n(BlockIndexer.findEnemyTile);
if (Enemy building in range?) then (yes)
    :Prioritize attack target\n(BlockIndexer.findEnemyTile with BuildingPriorityf);
else (no)
    :Continue moving toward goal tile;
endif

if (Raycast path obstructed?) then (yes)
    :Run raycast corridor check\n(ControlPathfinder.raycastRect / overlap);
    :Recalculate partial path;
else (no)
    :Follow existing flow field;
endif

|Android / Client Launcher|
:Resize viewport if window changed\n(ClientLauncher.resize);
if (File dropped on window?) then (yes)
    :Handle file drop\n(ClientLauncher.fileDropped);
else (no)
    :Continue main loop;
endif
if (Exit requested?) then (yes)
    :Shutdown game\n(ClientLauncher.exit);
    stop
else (no)
    :Return to game update tick;
    note right: Loop continues\nuntil exit
endif

stop

@enduml
