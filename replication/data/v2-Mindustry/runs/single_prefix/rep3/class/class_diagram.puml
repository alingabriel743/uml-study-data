@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Class Diagram

' ─────────────────────────────────────────────
' External base types (referenced but not defined in project)
' ─────────────────────────────────────────────
abstract class AndroidApplication   <<external>>
abstract class ContextFactory       <<external>>
abstract class ClassLoader          <<external>>
abstract class AbstractProcessor    <<external>>
abstract class QuadTree             <<external>>
abstract class UnitStance           <<external>>
abstract class Flowfield            <<external>>
abstract class ApplicationCore      <<external>>
interface GeneratedClassLoader      <<external>>
interface Platform                  <<external>>
interface Loadable                  <<external>>
interface Runnable                  <<external>>
interface Visitor                   <<external>>
interface Comparable                <<external>>

' ─────────────────────────────────────────────
package "mindustry.android" {

    class AndroidLauncher {
        -FileChooser chooser
        -Runnable permCallback
        -boolean doubleScaleTablets
        +{static} int PERMISSION_REQUEST_CODE
        +checkFiles(Intent intent)
        +isTablet(Context context)
        +onCreate(Bundle savedInstanceState)
        +onRequestPermissionsResult(int, String[], int[])
    }

    class AndroidRhinoContext {
        +enter(File cacheDirectory)
    }

    class AndroidContextFactory {
        -File cacheDirectory
        +AndroidContextFactory(File cacheDirectory)
        +createClassLoader(ClassLoader parent)
        +onContextReleased(Context cx)
    }

    class BaseAndroidClassLoader {
        +BaseAndroidClassLoader(ClassLoader parent)
        +defineClass(String name, byte[] data)
        +getLastDex()
        +linkClass(Class<?> aClass)
        +loadClass(Dex dex, String name)
    }

    class FileAndroidClassLoader {
        -File dexFile
        -{static} int instanceCounter
        +FileAndroidClassLoader(ClassLoader parent, File cacheDir)
        +getLastDex()
        +loadClass(Dex dex, String name)
        +reset()
    }

    class InMemoryAndroidClassLoader {
        -Dex last
        +InMemoryAndroidClassLoader(ClassLoader parent)
        +getLastDex()
        +loadClass(Dex dex, String name)
        +reset()
    }
}

' ─────────────────────────────────────────────
package "mindustry.annotations" {

    class Annotations

    enum PacketPriority {
        high
        normal
        low
    }

    enum Loc {
        both
        server
        client
        none
    }

    enum Variant {
        one
        both
        all
    }

    abstract class BaseProcessor {
        #Fi rootDirectory
        #RoundEnvironment env
        #int round
        #int rounds
        +{static} Elements elementu
        +elements(Class<? extends Annotation> type)
        +err(String message)
        +err(String message, Element elem)
        +fields(Class<? extends Annotation> type)
    }
}

' ─────────────────────────────────────────────
package "mindustry.annotations.entity" {

    class EntityIO {
        -MethodSpec.Builder method
        -ObjectSet<String> presentFields
        -boolean write
        -ClassSerializer serializer
        -Fi directory
        +EntityIO(String name, TypeSpec.Builder type, ...)
        +cont(String text, Object... fmt)
        +io(String type, String field, boolean network)
    }

    class Revision {
        +Seq<RevisionField> fields
        +int version
        +Revision(int version, Seq<RevisionField> fields)
        +equal(Seq<FieldSpec> specs)
    }

    class RevisionField {
        +String name
        +String type
        +RevisionField(String name, String type)
    }

    class EntityProcess {
        -ClassSerializer serializer
        -ObjectMap<Selement, Seq<Stype>> defComponents
        -ObjectMap<String, String> methodBlocks
        -ObjectMap<String, String> varInitializers
        -ObjectMap<String, Stype> componentNames
        +allComponents(Selement<?> type)
        +baseName(Stype comp)
        +createName(Selement<?> elem)
        +getDependencies(Stype component)
    }

    class GroupDefinition {
        +ClassName baseType
        +ObjectSet<Selement> manualInclusions
        +Seq<Stype> components
        +String name
        +boolean spatial
        +boolean mapping
        +boolean collides
        +GroupDefinition(String name, ClassName, ...)
        +toString()
    }

    class EntityDefinition {
        +TypeName extend
        +Selement naming
        +Seq<FieldSpec> fieldSpecs
        +Seq<GroupDefinition> groups
        +Seq<Stype> components
        +EntityDefinition(String name, Builder, ...)
        +toString()
    }
}

' ─────────────────────────────────────────────
package "mindustry.annotations.impl" {

    class AssetsProcess {
        +capitalize(String s)
        +process(RoundEnvironment env)
        +processSounds(String classname, ...)
        +processUI(Set<? extends Element> elements)
    }

    class StructProcess {
        +bitString(int offset, int size, int totalSize)
        +process(RoundEnvironment env)
        +typeForSize(int size)
        +typeSize(TypeKind kind)
    }
}

' ─────────────────────────────────────────────
package "mindustry.annotations.misc" {

    class LoadRegionProcessor {
        +count(String str, String substring)
        +parse(String value)
        +process(RoundEnvironment env)
    }

    class LogicStatementProcessor {
        +process(RoundEnvironment env)
    }
}

' ─────────────────────────────────────────────
package "mindustry.annotations.remote" {

    class CallGenerator {
        +generate(ClassSerializer serializer, Seq<MethodEntry> methods)
        +getCheckString(Loc loc)
        +makeReader(TypeSpec.Builder typespec, MethodEntry ent, ...)
        +makeWriter(TypeSpec.Builder typespec, MethodEntry ent, ...)
        +writeCallMethod(TypeSpec.Builder classBuilder, ...)
    }

    class MethodEntry {
        +Loc local
        +Loc where
        +PacketPriority priority
        +Smethod element
        +String className
        +MethodEntry(String className, ...)
        +hashCode()
    }

    class RemoteProcess {
        +{static} String callLocation
        +process(RoundEnvironment roundEnv)
    }

    class SerializerResolver {
        +isEntity(TypeMirror mirror)
        +locate(ExecutableElement elem, TypeMirror mirror, boolean write)
    }
}

' ─────────────────────────────────────────────
package "mindustry.annotations.util" {

    class AnnotationProxyMaker {
        -Class<? extends Annotation> annoType
        -Compound anno
        +generateAnnotation(Compound, Class<A>)
        +generateValue(MethodSymbol, Attribute)
        +getAllReflectedValues()
    }

    class ValueVisitor {
        -Class<?> returnClass
        -MethodSymbol meth
        -Object value
        +getValue(Attribute var1)
        +typeMismatch(Method var1, Attribute var2)
        +visitArray(Array var1)
        +visitClass(Attribute.Class var1)
    }

    class Selement {
        +T e
        +Selement(T e)
        +annotation(Class<A> annotation)
        +annotations()
        +asMethod()
        +asType()
    }

    class Smethod {
        +Smethod(ExecutableElement executableElement)
        +descString()
        +is(Modifier mod)
        +isAny(Modifier... mod)
        +isVoid()
    }

    class Stype {
        +Stype(TypeElement typeElement)
        +allInterfaces()
        +allSuperclasses()
        +constructors()
        +fields()
    }

    class Svar {
        +Svar(VariableElement e)
        +descString()
        +enclosingType()
        +is(Modifier mod)
        +isAny(Modifier... mods)
    }

    class TypeIOResolver {
        +fix(String str)
        +resolve(BaseProcessor processor)
    }

    class ClassSerializer {
        +ObjectMap<String, String> writers
        +ObjectMap<String, String> readers
        +ObjectMap<String, String> mutatorReaders
        +ClassSerializer(...)
        +getNetReader(String type, String fallback)
        +getNetWriter(String type, String fallback)
    }
}

' ─────────────────────────────────────────────
package "mindustry.core" {

    class ClientLauncher {
        -LoadRenderer loader
        -boolean finished
        -long beginTime
        -long lastTargetFps
        -long nextFrame
        +add(ApplicationListener module)
        +exit()
        +fileDropped(Fi file)
        +init()
        +pause()
    }

    class Vars {
        +{static} Player player
        +{static} AsyncCore asyncCore
        +{static} AvoidanceProcess avoidance
        +{static} BaseRegistry bases
        +{static} BeControl becontrol
        +checkLaunch()
        +finishLaunch()
        +init()
        +loadAsync()
        +loadFileLogger()
    }
}

' ─────────────────────────────────────────────
package "mindustry.ai" {

    class Astar {
        -{static} byte[][] rotations
        -{static} PQueue<Tile> queue
        -{static} float[] costs
        +{static} DistanceHeuristic manhattan
        +{static} pathfind(Tile from, Tile to, TileHeuristic th, Boolf<Tile> passable)
        +{static} pathfind(int startX, int startY, int endX, int endY, ...)
    }

    interface DistanceHeuristic {
        +cost(int x1, int y1, int x2, int y2) : float
    }

    interface TileHeuristic {
        +cost(Tile tile) : float
        +cost(Tile from, Tile tile) : float
    }

    class BaseBuilderAI {
        -Tile calcTile
        -IntSet calcPath
        -IntSet path
        -boolean calculating
        -Interval timer
        +BaseBuilderAI(TeamData data)
        +randomPosition()
        +tryPlace(BasePart part, int x, int y)
        +update()
    }

    class BaseRegistry {
        +ObjectMap<Content, Seq<BasePart>> reqParts
        +ObjectMap<Item, Floor> oreFloors
        +ObjectMap<Item, OreBlock> ores
        +Seq<BasePart> cores
        +Seq<BasePart> parts
        +forResource(Content item)
        +load()
    }

    class BasePart {
        +Block core
        +Content required
        +Schematic schematic
        +float tier
        +int centerX
        +int centerY
        +BasePart(Schematic schematic)
        +compareTo(BasePart other) : int
    }

    class BlockIndexer {
        -IntSeq[][][] ores
        -IntSeq[][][] wallOres
        -Seq<Building> breturnArray
        -Seq<Building>[] damagedTiles
        -Seq<Building>[][] flagMap
        +BlockIndexer()
        +addFloorIndex(Tile tile, Floor floor)
        +addIndex(Tile base)
        +allBuildings(float x, float y, float range, Cons<Building>)
        +clearFlags()
    }

    class TurretQuadtree {
        +TurretQuadtree(Rect bounds)
        +hitbox(Building build)
        +newChild(Rect rect)
    }

    class ControlPathfinder {
        -Thread thread
        -Cluster[][][] clusters
        -IntFloatMap innerCosts
        -IntSet clustersToInnerUpdate
        -IntSet clustersToUpdate
        +ControlPathfinder()
        +addFlowCluster(FieldCache cache, int cluster, boolean addingFrontier)
        +avoid(int team, PathCost type, int tilePos)
        +checkEdges(PathRequest request, ...)
    }

    class PathRequest {
        +IntFloatMap costs
        +IntIntMap cameFrom
        +PathfindQueue frontier
        +Tile lastTargetTile
        +FieldCache oldCache
        +PathRequest(Unit unit, int team, int costId, int destination)
    }

    class FieldCache {
        +IntMap<int[]> fields
        +IntQueue frontier
        +PathCost cost
        +int costId
        +int goalPos
        +FieldCache(PathCost cost, int costId, int team, int goalPos)
    }

    class Cluster {
        +IntSeq[] portals
        +LongSeq[][] portalConnections
    }

    class FieldIndexStruct {
        +int costId
        +int team
        +int pos
    }

    class IntraEdgeStruct {
        +int dir
        +int portal
        +float cost
    }

    class NodeIndexStruct {
        +int dir
        +int cluster
        +int portal
    }

    class ItemUnitStance {
        -{static} ObjectMap<Item, ItemUnitStance> itemToStance
        -{static} Seq<ItemUnitStance> all
        +Item item
        +ItemUnitStance(Item item)
        +all()
        +getByItem(Item item)
        +getIcon()
        +localized()
    }

    class PathfindQueue {
        +float[] weights
        +int size
        +int[] queue
        +PathfindQueue()
        +add(int e, float weight)
        +clear()
        +empty()
    }

    class Pathfinder {
        -Thread thread
        -Flowfield[][][] cache
        -IntSeq tmpArray
        -Seq<Flowfield> threadList
        -Seq<Flowfield> mainList
        -TaskQueue queue
        +Pathfinder()
        +clearCache()
        +getField(Team team, int costType, int fieldType)
        +getTargetTile(Tile tile, Flowfield path)
    }

    class EnemyCoreField {
        -Rand rand
        -{static} BlockFlag[] randomTargets
        +getPositions(IntSeq out)
    }
}

' ─────────────────────────────────────────────
' Inheritance — Android
' ─────────────────────────────────────────────
AndroidLauncher        --|> AndroidApplication
AndroidContextFactory  --|> ContextFactory
BaseAndroidClassLoader --|> ClassLoader
BaseAndroidClassLoader ..|> GeneratedClassLoader
FileAndroidClassLoader   --|> BaseAndroidClassLoader
InMemoryAndroidClassLoader --|> BaseAndroidClassLoader

' ─────────────────────────────────────────────
' Inheritance — Annotations
' ─────────────────────────────────────────────
BaseProcessor      --|> AbstractProcessor
EntityProcess      --|> BaseProcessor
AssetsProcess      --|> BaseProcessor
StructProcess      --|> BaseProcessor
LoadRegionProcessor --|> BaseProcessor
LogicStatementProcessor --|> BaseProcessor
RemoteProcess      --|> BaseProcessor

' ─────────────────────────────────────────────
' Inheritance — Annotation Utilities
' ─────────────────────────────────────────────
Smethod --|> Selement
Stype   --|> Selement
Svar    --|> Selement
ValueVisitor ..|> Visitor

' ─────────────────────────────────────────────
' Inheritance — Core
' ─────────────────────────────────────────────
ClientLauncher --|> ApplicationCore
ClientLauncher ..|> Platform
Vars           ..|> Loadable

' ─────────────────────────────────────────────
' Inheritance — AI
' ─────────────────────────────────────────────
TurretQuadtree   --|> QuadTree
ControlPathfinder ..|> Runnable
Pathfinder        ..|> Runnable
ItemUnitStance    --|> UnitStance
EnemyCoreField    --|> Flowfield
BasePart          ..|> Comparable

' ─────────────────────────────────────────────
' Composition / Association
' ─────────────────────────────────────────────
EntityIO      *-- ClassSerializer        : uses
EntityProcess *-- ClassSerializer        : uses
CallGenerator ..> ClassSerializer        : reads
CallGenerator ..> MethodEntry            : generates
EntityDefinition o-- GroupDefinition     : groups
Revision      *-- RevisionField          : fields
BaseBuilderAI ..> BasePart               : places
BaseRegistry  o-- BasePart               : "cores / parts"
BlockIndexer  ..> TurretQuadtree         : uses
Pathfinder    o-- FieldCache             : caches
ControlPathfinder *-- Cluster            : clusters
ControlPathfinder *-- PathRequest        : manages
ControlPathfinder *-- FieldCache         : field caches
PathRequest   *-- PathfindQueue          : frontier

@enduml
