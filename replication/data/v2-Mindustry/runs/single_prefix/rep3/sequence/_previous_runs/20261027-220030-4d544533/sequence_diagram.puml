@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    BoxBorderColor #6C757D
    BoxBackgroundColor #E9ECEF
}
skinparam note {
    BackgroundColor #FFF3CD
    BorderColor #856404
}

title Mindustry — Runtime Sequence: Launch & AI Pathfinding

actor "OS / User" as OS

box "Android Platform" #E9ECEF
    participant "AndroidLauncher" as AL
    participant "AndroidContextFactory" as ACF
    participant "BaseAndroidClassLoader" as BCL
end box

box "Core Game" #D4EDDA
    participant "ClientLauncher" as CL
    participant "Vars" as V
end box

box "AI Subsystem" #D1ECF1
    participant "BaseBuilderAI" as BBA
    participant "BaseRegistry" as BR
    participant "BlockIndexer" as BI
    participant "ControlPathfinder" as CP
end box

box "Pathfinding Engine" #FDE2E4
    participant "PathRequest" as PR
    participant "PathfindQueue" as PQ
    participant "Astar" as AS
    participant "Pathfinder" as PF
end box

== Application Startup ==

OS -> AL: onCreate(savedInstanceState)
activate AL
AL -> ACF: AndroidContextFactory(cacheDirectory)
activate ACF
ACF -> BCL: BaseAndroidClassLoader(parent)
activate BCL
BCL --> ACF: classLoader
deactivate BCL
ACF --> AL: factory ready
deactivate ACF

AL -> CL: init()
activate CL
CL -> V: init()
activate V
V -> V: checkLaunch()
V -> V: loadAsync()
note right of V: loads assets,\ncontent, world
V --> CL: core systems ready
deactivate V
CL --> AL: game initialised
deactivate CL
deactivate AL

== Game Loop — AI Base Building ==

loop every AI update tick
    BBA -> BBA: update()
    activate BBA

    BBA -> BR: forResource(item)
    activate BR
    BR -> BR: load()
    BR --> BBA: basePart (schematic)
    deactivate BR

    BBA -> BBA: randomPosition()
    note right of BBA: selects candidate\nbuild location

    BBA -> BI: findTile(team, x, y, range, pred, usePriority)
    activate BI
    BI -> BI: eachBlock(team, wx, wy, range, pred, cons)
    BI --> BBA: targetBuilding
    deactivate BI

    BBA -> BBA: tryPlace(part, x, y)
    activate BBA
    deactivate BBA

    deactivate BBA
end

== Pathfinding Request ==

BBA -> CP: initializePathRequest(request, team, costId, unitX, unitY, goalX, goalY)
activate CP

CP -> PR: PathRequest(unit, team, costId, destination)
activate PR
PR --> CP: pathRequest
deactivate PR

CP -> PQ: PathfindQueue(initialCapacity)
activate PQ
PQ --> CP: queue ready
deactivate PQ

CP -> PQ: add(startPos, weight)
activate PQ
PQ -> PQ: siftUp(k, x, weight)
PQ --> CP: enqueued
deactivate PQ

CP -> CP: innerAstar(team, cost, minX, minY, maxX, maxY, startPos, goalPos)
activate CP

CP -> CP: checkEdges(request, team, pathCost, current, goal, cx, cy, connections)
note right of CP: evaluates neighbouring\nnodes and clusters

CP -> CP: raycastRect(initialCost, startX, startY, endX, endY, team, type, x1)

deactivate CP

CP -> AS: pathfind(from, to, tileHeuristic, passable)
activate AS
AS -> AS: pathfind(startX, startY, endX, endY, th, dh, passable)
note right of AS: A* search with\ndistance heuristic
AS --> CP: Seq<Tile> path
deactivate AS

CP --> BBA: path resolved
deactivate CP

== Path Following ==

BBA -> PF: getField(team, costType, fieldType)
activate PF
PF -> CP: getField request (EnemyCoreField)
activate CP
CP --> PF: FieldCache
deactivate CP

PF -> PF: getTargetTile(tile, flowfield, diagonals, avoidanceId)
PF --> BBA: nextTile (movement target)
deactivate PF

@enduml
