@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    ActorBackgroundColor #E9ECEF
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Mindustry — Game Initialization & Unit AI Pathfinding

== Game Startup ==

actor User
participant "AndroidLauncher" as android
participant "ClientLauncher" as client
participant "Vars" as vars

User -> android: onCreate(savedInstanceState)
activate android
android -> android: checkFiles(intent)
android -> client: init()
activate client
client -> vars: init()
activate vars
vars -> vars: loadAsync()
vars --> client: async load complete
deactivate vars
client -> vars: finishLaunch()
activate vars
vars --> client: launch finished
deactivate vars
client --> android: initialized
deactivate client
android --> User: app ready
deactivate android

== Base Builder AI Cycle ==

participant "BaseBuilderAI" as builder
participant "BaseRegistry" as registry
participant "BlockIndexer" as indexer

[-> builder: update()
activate builder
builder -> builder: randomPosition()
builder -> registry: forResource(item)
activate registry
registry --> builder: BasePart (schematic)
deactivate registry
builder -> builder: tryPlace(part, x, y)
activate builder
builder -> indexer: findTile(team, x, y, range, pred)
activate indexer
indexer --> builder: Building or null
deactivate indexer
builder --> builder: placement result
deactivate builder
deactivate builder

== Unit Pathfinding ==

participant "Unit" as unit
participant "Pathfinder" as pathfinder
participant "ControlPathfinder" as ctrlPath
participant "PathfindQueue" as pfQueue
participant "Astar" as astar

unit -> pathfinder: getField(team, costType, fieldType)
activate pathfinder
pathfinder -> ctrlPath: initializePathRequest(request, team, costId, unitX, unitY, goalX, goalY)
activate ctrlPath
ctrlPath -> ctrlPath: checkEdges(request, team, pathCost, current, goal, cx, cy, connections)
ctrlPath -> pfQueue: add(nodePos, weight)
activate pfQueue
pfQueue -> pfQueue: siftUp(k, x, weight)
pfQueue --> ctrlPath: node enqueued
deactivate pfQueue
ctrlPath -> ctrlPath: innerAstar(team, cost, minX, minY, maxX, maxY, startPos, goalPos)
activate ctrlPath
ctrlPath -> pfQueue: add(neighbor, cost)
activate pfQueue
pfQueue --> ctrlPath: neighbor enqueued
deactivate pfQueue
ctrlPath --> ctrlPath: path field computed
deactivate ctrlPath
ctrlPath --> pathfinder: FieldCache
deactivate ctrlPath
pathfinder -> pathfinder: getTargetTile(tile, flowfield, diagonals)
pathfinder --> unit: nextTile
deactivate pathfinder

== Pathfinding Fallback (A* Direct) ==

participant "Astar" as astarDirect

unit -> astarDirect: pathfind(from, to, tileHeuristic, passable)
activate astarDirect
astarDirect -> astarDirect: pathfind(startX, startY, endX, endY, tileHeuristic, distHeuristic, passable)
activate astarDirect
astarDirect --> astarDirect: path computed
deactivate astarDirect
astarDirect --> unit: Seq<Tile> path
deactivate astarDirect

@enduml
