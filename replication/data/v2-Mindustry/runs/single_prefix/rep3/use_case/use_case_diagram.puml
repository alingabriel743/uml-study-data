@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Use Case Diagram

left to right direction

actor "Player" as player
actor "Android Player" as android
actor "AI Enemy" as ai
actor "Game Server" as server
actor "Build Tool\n(Annotation Processor)" as build

android -|> player

rectangle "Mindustry Game System" {

    rectangle "Game Launch & Platform" {
        usecase "Launch Game" as UC1
        usecase "Launch on Android" as UC2
        usecase "Grant Runtime Permissions" as UC3
        usecase "Drop / Open File" as UC4
        usecase "Initialize Game State" as UC5
        usecase "Exit Game" as UC6
    }

    rectangle "AI & Pathfinding" {
        usecase "Pathfind Unit (A*)" as UC7
        usecase "Control Unit Path (Flow Field)" as UC8
        usecase "Navigate to Target Tile" as UC9
        usecase "Build Base Structures" as UC10
        usecase "Select Base Schematic" as UC11
    }

    rectangle "Combat & Targeting" {
        usecase "Find Enemy Buildings" as UC12
        usecase "Index Blocks in Range" as UC13
        usecase "Assign Item Stance to Unit" as UC14
    }

    rectangle "Multiplayer / Networking" {
        usecase "Send Remote Call" as UC15
        usecase "Receive Remote Call" as UC16
        usecase "Forward Packet to All" as UC17
    }

    rectangle "Build-Time Code Generation" {
        usecase "Process Entity Annotations" as UC18
        usecase "Generate Entity I/O Code" as UC19
        usecase "Process Asset Annotations" as UC20
        usecase "Generate Remote Call Stubs" as UC21
        usecase "Process Struct Annotations" as UC22
        usecase "Resolve Type Serializers" as UC23
    }
}

' Player interactions
player --> UC1
player --> UC4
player --> UC6

' Android-specific
android --> UC2
android --> UC3

' Game engine / launch flow
UC2 ..> UC1 : <<extend>>
UC1 ..> UC5 : <<include>>

' AI Enemy interactions
ai --> UC7
ai --> UC8
ai --> UC9
ai --> UC10
ai --> UC12
ai --> UC14

' AI use case relationships
UC10 ..> UC11 : <<include>>
UC8 ..> UC7 : <<extend>>
UC9 ..> UC8 : <<include>>
UC12 ..> UC13 : <<include>>

' Server / networking
server --> UC15
server --> UC16
server --> UC17
UC17 ..> UC15 : <<extend>>

' Build tool
build --> UC18
build --> UC20
build --> UC21
build --> UC22
UC18 ..> UC19 : <<include>>
UC21 ..> UC23 : <<include>>

@enduml
