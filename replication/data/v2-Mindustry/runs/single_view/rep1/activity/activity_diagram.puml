@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #DEE2E6
    DiamondBorderColor #495057
}
skinparam partition {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #CED4DA
    TitleFontColor #212529
}
skinparam ArrowColor #495057

title Mindustry — Unit Command & Combat Activity Flow

|Player|
start
:Issue command\n(tap / click target on map);

|InputHandler|
:Receive input event\n(MobileInput.touchDown / tap);
if (Input type?) then (unit command)
  :drawSelection(x1, y1, x2, y2, maxLength, col1, col2);
  :commandUnits(player, unitIds,\nbuildTarget, unitTarget, posTarget,\nqueueCommand, finalBatch);
  if (Queue command?) then (yes)
    :Append to unit command queue;
  else (no)
    :Override current unit target;
  endif
else (build placement)
  if (Valid placement?) then (valid)
    :createItemTransfer(item, amount, x, y, to, done);
    :Schematics.place(schematic, x, y, team, overwrite);
    :BuildingComp.init(tile, team, shouldAdd, rotation);
  else (invalid)
    :drawBreakSelection(x1, y1, x2, y2, maxLength, useSelectPlans);
    :Show invalid placement indicator;
    stop
  endif
endif

|AI / Unit Controller|
:CommandAI receives unit assignment;
if (Attack target provided?) then (yes)
  :commandTarget(moveTo, stopAtTarget);
  :findMainTarget(x, y, range, air, ground);
  if (Target found in range?) then (yes)
    :target(x, y, range, air, ground);
    :AIController.moveTo(target, circleLength,\nsmooth, keepDistance, offset, arrive);
  else (no)
    :nearAttackTarget(x, y, range);
    if (Nearby target found?) then (yes)
      :Update target reference;
    else (no)
      :commandPosition(pos, stopWhenInRange);
      :AIController.moveTo(position, circleLength,\nsmooth, keepDistance, offset);
    endif
  endif
else (move command)
  :commandPosition(vec2, stopWhenInRange);
  :AIController.moveTo(target, circleLength,\nsmooth, keepDistance, offset, arrive);
endif

|Combat System|
:Unit enters weapon effective range;
:Weapon.findTarget(unit, x, y, range, air, ground);
if (Valid target acquired?) then (yes)
  :Weapon.checkTarget(unit, target, x, y, range);
  :Weapon.bulletRotation(unit, mount, bulletX, bulletY);
  :Weapon.shoot(unit, mount, shootX, shootY, rotation);
  fork
    :BulletType.create(owner, team, x, y,\nangle, damage, velocityScl, lifetimeScl);
    :Bullet travels toward target;
    if (Bullet hits entity?) then (yes)
      :BulletType.hitEntity(bullet, entity, health);
      if (Target is building?) then (yes)
        :BuildingComp.damage(bullet, source, damage);
        :TurretBuild.handleBullet\n(bullet, offsetX, offsetY, angleOffset);
      else (unit)
        :UnitComp takes damage;
        :Ability.death(unit) if lethal;
      endif
      :Effect.at(x, y, rotation, color, data);
      :Effect.render(id, color, life, lifetime,\nrotation, x, y, data);
    else (miss / expire)
      :Bullet expires by lifetime;
    endif
  fork again
    :TurretBuild.bullet(type, xOffset,\nyOffset, angleOffset, mover);
    :TurretBuild.handleLiquid\n(source, liquid, amount);
  end fork
else (no target)
  :Turret / unit idles or rotates toward last known;
endif

|Network|
:NetServer.clientSnapshot(player, snapshotID,\nunitID, dead, x, y, pointerX, pointerY);
if (State delta to broadcast?) then (yes)
  :NetClient.entitySnapshot(amount, data);
  :NetClient.readSyncEntity(input, read);
  :NetServer.addBinaryPacketHandler — update entity state;
else (no change)
  :Skip — suppress redundant broadcast;
endif

|Player|
:Receive updated world state;
if (Status notification needed?) then (yes)
  :UI.showInfoPopup(info, id, duration, align, ...);
endif
:Render updated frame\n(Renderer.scaleCamera / addEnvRenderer);
stop

@enduml
