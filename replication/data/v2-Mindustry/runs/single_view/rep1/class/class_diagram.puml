' =============================================
' RELATIONSHIPS — INHERITANCE
' =============================================

' Content hierarchy
MappableContent --|> Content : extends
UnlockableContent --|> MappableContent : extends
Block --|> UnlockableContent : extends
UnitType --|> UnlockableContent : extends
Planet --|> UnlockableContent : extends

' Block hierarchy
Floor --|> Block : extends
PowerBlock --|> Block : extends
PowerNode --|> PowerBlock : extends
ReloadTurret --|> Block : extends
Turret --|> ReloadTurret : extends

' Building hierarchy
CoreBuild --|> Building : extends
PayloadBlockBuild --|> Building : extends
ReloadTurretBuild --|> Building : extends
TurretBuild --|> ReloadTurretBuild : extends

' AI hierarchy
CommandAI --|> AIController : extends

' Bullet/Content
BulletType --|> Content : extends

' Input hierarchy
MobileInput --|> InputHandler : extends

' Dialog hierarchy
BaseDialog --|> Dialog : extends
PlanetDialog --|> BaseDialog : extends

' Module hierarchy
ItemModule --|> BlockModule : extends

' Annotation processor
BaseProcessor --|> AbstractProcessor : extends

' Shader
LoadShader --|> Shader : extends

' =============================================
' RELATIONSHIPS — INTERFACE IMPLEMENTATIONS
' =============================================
Block ..|> Senseable : implements
UnitType ..|> Senseable : implements

AIController ..|> UnitController : implements
PlayerComp ..|> UnitController : implements

Vars ..|> Loadable : implements
UI ..|> Loadable : implements
Mods ..|> Loadable : implements
Schematics ..|> Loadable : implements

UI ..|> ApplicationListener : implements
NetClient ..|> ApplicationListener : implements
NetServer ..|> ApplicationListener : implements
Renderer ..|> ApplicationListener : implements

ControlPathfinder ..|> Runnable : implements
BasicGenerator ..|> WorldGenerator : implements
GenerateFilter ..|> Cloneable : implements
GenerateFilter ..|> Serializable : implements

BulletType ..|> Cloneable : implements
Weapon ..|> Cloneable : implements
Ability ..|> Cloneable : implements
MapObjective ..|> Serializable : implements

CoreBuild ..|> LaunchAnimator : implements
TurretBuild ..|> ControlBlock : implements
PlanetDialog ..|> PlanetInterfaceRenderer : implements

InputHandler ..|> GestureListener : implements
InputHandler ..|> InputProcessor : implements
MobileInput ..|> GestureListener : implements

Map ..|> Publishable : implements

' =============================================
' RELATIONSHIPS — COMPOSITION / ASSOCIATION
' =============================================
Block *-- Consume : "   contains"
Block o-- DrawBlock : "   draws with"
Block o-- Effect : "uses"

UnitType o-- Weapon : "  uses"
UnitType o-- Ability : " has"
Turret o-- BulletType : "  fires"
Weapon o-- BulletType : "  fires"

BuildingComp o-- ItemModule : "  has items"

Mods *-- ContentParser : "  contains"
Mods o-- Schematics : "  references"

World o-- Tile : "  contains"

Vars ..> World : "  references"
Vars ..> ContentLoader : "  references"
Vars ..> UI : "  references"
Vars ..> Renderer : "  references"
Vars ..> NetClient : "  references"
Vars ..> NetServer : "  references"

PlanetDialog o-- Planet : "  displays"
Planet o-- Rules : "  applies"

MapObjective o-- MapObjective : "  children"

@enduml
