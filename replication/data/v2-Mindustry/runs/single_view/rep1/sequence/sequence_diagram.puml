@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderThickness 1.5
skinparam sequenceLifeLineBorderColor #495057
skinparam sequenceParticipant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequenceArrowColor #495057
skinparam sequenceActorBorderColor #495057
skinparam sequenceActivationBorderColor #6C757D
skinparam sequenceActivationBackgroundColor #DEE2E6
skinparam noteBorderColor #6C757D
skinparam noteBackgroundColor #E9ECEF

title Mindustry — Unit Command & Combat Sequence

actor Player
participant "InputHandler" as input
participant "UnitComp" as unitComp
participant "CommandAI" as cmdAI
participant "AIController" as aiCtrl
participant "Units" as units
participant "Weapon" as weapon
participant "BulletType" as bullet
participant "Effect" as effect
participant "TurretBuild" as turret
participant "NetServer" as netSrv
participant "Administration" as admin

== Player Issues Unit Command ==

Player -> input : commandUnits(player, unitIds,\nbuildTarget, unitTarget, posTarget,\nqueueCommand, finalBatch)
activate input

input -> unitComp : controller(next)
activate unitComp
note right of unitComp
  Assigns CommandAI as the
  active unit controller
end note
unitComp --> input : —
deactivate unitComp

input -> cmdAI : commandTarget(moveTo, stopAtTarget)
activate cmdAI
cmdAI --> input : —
deactivate cmdAI

input --> Player : —
deactivate input

== AI Combat Loop (per tick) ==

cmdAI -> cmdAI : findMainTarget(x, y, range, air, ground)
activate cmdAI

cmdAI -> units : bestTarget(team, x, y, range,\nunitPred, tilePred, sort)
activate units
units --> cmdAI : target (Unit or Building)
deactivate units

cmdAI -> aiCtrl : target(x, y, range, air, ground)
activate aiCtrl

aiCtrl -> units : closest(team, x, y, range,\npredicate, sort)
activate units
units --> aiCtrl : closestUnit
deactivate units

aiCtrl --> cmdAI : —
deactivate aiCtrl

deactivate cmdAI

== Weapon Firing ==

cmdAI -> weapon : shoot(unit, mount,\nshootX, shootY, rotation)
activate weapon

weapon -> weapon : findTarget(unit, x, y, range, air, ground)
activate weapon
weapon --> weapon : target
deactivate weapon

weapon -> bullet : bullet(unit, mount, xOffset, yOffset,\nangleOffset, mover)
activate bullet

bullet -> bullet : create(owner, team, x, y,\nangle, damage, velocityScl)
activate bullet
bullet --> bullet : bulletEntity
deactivate bullet

bullet -> effect : at(x, y, rotation, color, data)
activate effect
note right of effect
  Muzzle flash / shoot effect
  spawned at weapon origin
end note
effect --> bullet : —
deactivate effect

bullet --> weapon : bulletEntity
deactivate bullet

weapon --> cmdAI : —
deactivate weapon

== Bullet Impact ==

bullet -> bullet : hitEntity(b, entity, health)
activate bullet

bullet -> effect : at(x, y, rotation, color, data)
activate effect
note right of effect
  Hit effect / explosion
  spawned at impact point
end note
effect --> bullet : —
deactivate effect

deactivate bullet

== Turret Auto-Targeting (parallel subsystem) ==

turret -> bullet : bullet(type, xOffset, yOffset,\nangleOffset, mover)
activate turret
activate bullet

bullet -> bullet : create(owner, team, x, y,\nangle, damage, velocityScl, lifetimeScl)
activate bullet
bullet --> bullet : bulletEntity
deactivate bullet

bullet -> effect : at(x, y, rotation, color, data)
activate effect
effect --> bullet : —
deactivate effect

bullet --> turret : —
deactivate bullet
deactivate turret

== Multiplayer Snapshot Sync ==

netSrv -> admin : allowAction(player, type, tile, setter)
activate netSrv
activate admin

admin --> netSrv : actionAllowed
deactivate admin

netSrv -> netSrv : clientSnapshot(player, snapshotID,\nunitID, dead, x, y, pointerX, pointerY)
activate netSrv
netSrv --> netSrv : —
deactivate netSrv

deactivate netSrv

@enduml
