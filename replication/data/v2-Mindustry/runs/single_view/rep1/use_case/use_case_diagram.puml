@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}

title Mindustry — Use Case Diagram

left to right direction

actor "Player" as player
actor "Admin" as admin
actor "Mod Developer" as modder
actor "AI System" as ai
actor "Server" as server

rectangle "Mindustry Game" {

    ' ── Combat & Unit Control ──
    package "Combat & Units" {
        usecase "Command Units" as UC_CmdUnits
        usecase "Find Combat Target" as UC_FindTarget
        usecase "Navigate to Position" as UC_Navigate
        usecase "Fire Weapon / Bullet" as UC_FireWeapon
        usecase "Spawn Unit" as UC_SpawnUnit
    }

    ' ── World Interaction ──
    package "World Interaction" {
        usecase "Place Building" as UC_PlaceBuilding
        usecase "Break Building" as UC_BreakBuilding
        usecase "Transfer Items" as UC_TransferItems
        usecase "Place Schematic" as UC_PlaceSchematic
        usecase "Configure Block" as UC_ConfigBlock
    }

    ' ── Multiplayer & Networking ──
    package "Multiplayer & Networking" {
        usecase "Join Multiplayer Server" as UC_JoinServer
        usecase "Sync Game Entities" as UC_SyncEntities
        usecase "Send Chat Message" as UC_SendChat
        usecase "Handle Network Packets" as UC_HandlePackets
    }

    ' ── Server Administration ──
    package "Server Administration" {
        usecase "Kick Player" as UC_Kick
        usecase "Admin Player" as UC_AdminPlayer
        usecase "Allow / Deny Player Action" as UC_AllowAction
        usecase "Configure Game Rules" as UC_GameRules
    }

    ' ── Campaign & Progression ──
    package "Campaign & Progression" {
        usecase "Launch to Planet" as UC_LaunchPlanet
        usecase "Abandon Sector" as UC_AbandonSector
        usecase "Track Achievement" as UC_Achievement
        usecase "Define Map Objectives" as UC_MapObjective
        usecase "Generate Map" as UC_GenMap
    }

    ' ── Modding & Content ──
    package "Modding & Content" {
        usecase "Load / Install Mod" as UC_LoadMod
        usecase "Parse Mod Content" as UC_ParseContent
        usecase "Pack Mod Sprites" as UC_PackSprites
        usecase "Load Game Content" as UC_LoadContent
    }

    ' ── UI & Logic ──
    package "UI & Logic" {
        usecase "Show Dialog / Popup" as UC_ShowDialog
        usecase "Execute Logic Processor" as UC_LogicExec
        usecase "Render Game World" as UC_Render
    }
}

' ── Player relationships ──
player --> UC_CmdUnits
player --> UC_PlaceBuilding
player --> UC_BreakBuilding
player --> UC_TransferItems
player --> UC_PlaceSchematic
player --> UC_ConfigBlock
player --> UC_JoinServer
player --> UC_SendChat
player --> UC_LaunchPlanet
player --> UC_AbandonSector
player --> UC_ShowDialog
player --> UC_LogicExec

' ── Admin relationships ──
admin --> UC_Kick
admin --> UC_AdminPlayer
admin --> UC_AllowAction
admin --> UC_GameRules
admin --> UC_JoinServer
admin --|> player

' ── AI System relationships ──
ai --> UC_FindTarget
ai --> UC_Navigate
ai --> UC_FireWeapon
ai --> UC_CmdUnits

' ── Mod Developer relationships ──
modder --> UC_LoadMod
modder --> UC_ParseContent
modder --> UC_PackSprites

' ── Server relationships ──
server --> UC_SyncEntities
server --> UC_HandlePackets
server --> UC_AllowAction
server --> UC_GenMap
server --> UC_LoadContent
server --> UC_SpawnUnit
server --> UC_MapObjective
server --> UC_Achievement

' ── Include / Extend relationships ──
UC_CmdUnits ..> UC_FindTarget : <<include>>
UC_CmdUnits ..> UC_Navigate : <<include>>
UC_FireWeapon ..> UC_FindTarget : <<include>>
UC_SpawnUnit ..> UC_Navigate : <<extend>>
UC_PlaceSchematic ..> UC_PlaceBuilding : <<include>>
UC_JoinServer ..> UC_SyncEntities : <<include>>
UC_JoinServer ..> UC_HandlePackets : <<include>>
UC_LoadMod ..> UC_ParseContent : <<include>>
UC_LoadMod ..> UC_PackSprites : <<include>>
UC_LoadMod ..> UC_LoadContent : <<include>>
UC_LaunchPlanet ..> UC_GenMap : <<include>>
UC_ShowDialog ..> UC_LaunchPlanet : <<extend>>
UC_ShowDialog ..> UC_AbandonSector : <<extend>>

@enduml
