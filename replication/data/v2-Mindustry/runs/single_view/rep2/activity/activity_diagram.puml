@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #495057
    StartColor #212529
    EndColor #212529
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Mindustry — Unit Command & Combat Activity Flow

|Player / InputHandler|
start
:Player selects units and\nissues command (tap / drag);

if (Mobile or Desktop input?) then (Mobile — MobileInput.tap())
    :MobileInput resolves\nscreen coordinates;
else (Desktop — InputHandler.commandUnits())
    :InputHandler resolves\nunit IDs and target;
endif

:InputHandler.commandUnits(\n  player, unitIds,\n  buildTarget, unitTarget,\n  posTarget, queueCommand, finalBatch);

if (Valid command target?) then (no)
    :Show invalid selection\nfeedback (drawBreakSelection);
    stop
else (yes)
    :Dispatch command to\nselected units;
endif

|AI / CommandAI|
:CommandAI receives command\nfor assigned unit;

fork
    :CommandAI.commandTarget(\n  moveTo, stopAtTarget)\n[building or unit target];
fork again
    :CommandAI.commandPosition(\n  pos, stopWhenInRange)\n[position target];
end fork

:AIController.moveTo(\n  target, circleLength,\n  smooth, keepDistance, offset);

while (Unit in range of target?) is (no — keep moving)
    :Navigate along path\n(ControlPathfinder route);
    :AIController adjusts\ntrajectory towards target;
endwhile (yes — arrived / in range)

:AIController.findMainTarget(\n  x, y, range, air, ground);

if (Primary target found?) then (no)
    :AIController.findTarget(\n  fallback search);
    if (Fallback target found?) then (no)
        :Unit idles / patrols;
        stop
    else (yes)
    endif
else (yes)
endif

|Combat System|
:Weapon.checkTarget(\n  unit, target, x, y, range);

if (Target still valid and in range?) then (no)
    :Re-evaluate target;
    :CommandAI.nearAttackTarget();
else (yes)
endif

:Weapon.shoot(\n  unit, mount,\n  shootX, shootY, rotation);

:BulletType.create(\n  owner, shooter, team,\n  x, y, angle, damage, velocityScl);

:Bullet travels along\ntrajectory (Mover applied);

if (Bullet hits entity?) then (yes)
    :BulletType.hitEntity(\n  bullet, entity, health);

    :Entity receives damage\n(BuildingComp.damage or UnitComp);

    fork
        :Apply status effects\n(Ability.death if lethal);
    fork again
        :Update ItemModule /\nresource drops if building;
    end fork

    |World / Renderer|
    :Effect.at(\n  x, y, rotation, color, data)\n[spawn hit visual effect];

    :Drawf renders additive\nsprite at impact point;

    :Renderer.shake(\n  intensity, duration)\n[screen feedback];

else (no — bullet misses or expires)
    |World / Renderer|
    :Bullet lifetime ends\nwithout collision;
    :Effect.decal renders\ntrail / explosion at end-of-life;
endif

:Renderer updates scene\n(environment + entities);

stop

@enduml
