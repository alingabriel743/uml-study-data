@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EAF4FF
    BorderColor #3A7EBD
}

title Mindustry — Class Diagram

' =============================================
' External / Framework Base Types
' =============================================
package "framework (external)" #D4D4D4 {
    abstract class MappableContent
    abstract class Content
    abstract class Building
    abstract class BlockModule
    abstract class Dialog
    abstract class AbstractProcessor
    abstract class Shader
    abstract class ReloadTurret
    abstract class ReloadTurretBuild
    abstract class PowerBlock

    interface Senseable
    interface UnitController
    interface Loadable
    interface ApplicationListener
    interface WorldGenerator
    interface GestureListener
    interface InputProcessor
    interface ControlBlock
    interface LaunchAnimator
    interface PlanetInterfaceRenderer
    interface Runnable
    interface Unitc
    interface Buildingc
}

' =============================================
' mindustry.ctype
' =============================================
package "mindustry.ctype" {
    class UnlockableContent {
        #boolean unlocked
        +TechNode techNode
        +Stats stats
        +afterPatch()
        +createIcons(MultiPacker packer)
    }
    UnlockableContent --|> MappableContent
}

' =============================================
' mindustry.world
' =============================================
package "mindustry.world" {
    class Block {
        #OrderedMap barMap
        #Seq~Consume~ consumeBuilder
        +ConsumePower consPower
        +Block(String name)
        +addBar(String name, Func sup)
    }
    class Tile {
        +Tile(int x, int y, Block floor, Block overlay, Block wall)
        +adjacentTo(Tile other)
    }
    class DrawBlock {
        +draw(Building build)
        +drawPlan(Block block, BuildPlan plan, Eachable list)
    }
    class StatValues {
        +abilities(Seq abilities)
        +ammo(ObjectMap map)
    }
    class ItemModule {
        +add(Item item, int amount)
        +add(ItemModule items)
    }
    class Consume {
        +boolean booster
        +boolean optional
        +apply(Block block)
        +efficiency(Building build)
    }
    Block --|> UnlockableContent
    Block ..|> Senseable
    ItemModule --|> BlockModule
    Block o-- Consume : uses
    Block o-- DrawBlock : drawn by
}

' =============================================
' mindustry.world.blocks
' =============================================
package "mindustry.world.blocks" {
    class Floor {
        #TextureRegion edgeRegion
        +Floor(String name, int variants)
        +damages()
    }
    class Turret {
        +Effect shootEffect
        +Color heatColor
        +Turret(String name)
        +drawPlace(int x, int y, int rotation, boolean valid)
    }
    class TurretBuild {
        +Posc target
        +BlockUnitc unit
        +bullet(BulletType type, float xOff, float yOff, float angleOff, Mover mover)
        +canConsume()
    }
    class CoreBuild {
        +Vec2 commandPos
        +Team lastDamage
        +acceptItem(Building source, Item item)
        +canControlSelect(Unit player)
    }
    class PayloadBlockBuild {
        +T payload
        +Vec2 payVector
        +acceptPayload(Building source, Payload payload)
        +acceptUnitPayload(Unit unit)
    }
    class PowerNode {
        +PowerNode(String name)
        +drawLaser(float x1, float y1, float x2, float y2, int s1, int s2)
    }
    Floor --|> Block
    Turret --|> ReloadTurret
    TurretBuild --|> ReloadTurretBuild
    TurretBuild ..|> ControlBlock
    CoreBuild --|> Building
    CoreBuild ..|> LaunchAnimator
    PayloadBlockBuild --|> Building
    PowerNode --|> PowerBlock
}

' =============================================
' mindustry.type
' =============================================
package "mindustry.type" {
    class UnitType {
        #ItemStack[] totalRequirements
        +int ammoCapacity
        +UnitType(String name)
        +createController(Unit unit)
    }
    class BulletType {
        +BulletType fragBullet
        +float speed
        +BulletType(float speed, float damage)
        +hitEntity(Bullet b, Hitboxc entity, float health)
    }
    class Weapon {
        +BulletType bullet
        +Color heatColor
        +Weapon(String name)
        +bulletRotation(Unit unit, WeaponMount mount, float bulletX, float bulletY)
    }
    class Planet {
        +Planet parent
        +float radius
        +Planet(String name, Planet parent, float radius)
        +applyRules(Rules rules)
    }
    UnitType --|> UnlockableContent
    UnitType ..|> Senseable
    BulletType --|> Content
    Planet --|> UnlockableContent
    UnitType o-- Weapon : has
    Weapon o-- BulletType : fires
}

' =============================================
' mindustry.entities
' =============================================
package "mindustry.entities" {
    class BuildingComp {
        +ItemModule items
        +LiquidModule liquids
        +acceptItem(Building source, Item item)
        +acceptLiquid(Building source, Liquid liquid)
    }
    class UnitComp {
        +Tile mineTile
        +WeaponMount[] mounts
        +controller(UnitController next)
        +controller()
    }
    class PlayerComp {
        +Unit unit
        +Team team
        +Block selectedBlock
        +isValidController()
    }
    class AIController {
        #AIController fallback
        #Teamc target
        #Unit unit
        +checkTarget(Teamc target, float x, float y, float range)
        +circle(Position target, float circleLength)
    }
    class Effect {
        +boolean followParent
        +Effect(float life, Cons renderer)
        +at(Position pos)
    }
    class EntityGroup {
        -IntMap map
        -QuadTree tree
        +add(T type)
        +checkIDCollisions()
    }
    class Units {
        +any(float x, float y, float width, float height, Boolf filter)
        +anyEntities(Tile tile, boolean ground)
    }
    class Ability {
        +boolean display
        +float data
        +addStats(Table t)
        +created(Unit unit)
    }
    BuildingComp ..|> Buildingc
    BuildingComp ..|> Senseable
    UnitComp ..|> Unitc
    UnitComp ..|> Senseable
    PlayerComp ..|> UnitController
    AIController ..|> UnitController
}

' =============================================
' mindustry.ai
' =============================================
package "mindustry.ai" {
    class CommandAI {
        #AIController commandController
        #UnitCommand lastCommand
        +command(UnitCommand command)
        +commandPosition(Vec2 pos)
    }
    class ControlPathfinder {
        +avoid(int team, PathCost type, int tilePos)
        +checkEdges(PathRequest req, int team, int pathCost, int current, int goal, int cx, int cy, LongSeq connections)
    }
    CommandAI --|> AIController
    ControlPathfinder ..|> Runnable
}

' =============================================
' mindustry.input
' =============================================
package "mindustry.input" {
    class InputHandler {
        +InputHandler()
        +addLock(Boolp lock)
        +breakBlock(int x, int y)
    }
    class MobileInput {
        +Block lastBlock
        +Building buildingTapped
        +buildPlacementUI(Table table)
        +checkTargets(float x, float y)
    }
    InputHandler ..|> GestureListener
    InputHandler ..|> InputProcessor
    MobileInput --|> InputHandler
}

' =============================================
' mindustry.core
' =============================================
package "mindustry.core" {
    class UI {
        +AboutDialog about
        +UI()
        +announce(String text)
    }
    class World {
        +Tiles tiles
        +World()
        +beginMapLoad()
        +build(int x, int y)
    }
    class Renderer {
        +Renderer()
        +addEnvRenderer(int mask, Runnable render)
        +clampScale()
    }
    class ContentLoader {
        +ContentLoader()
        +block(String name)
        +blocks()
    }
    class NetClient {
        +addPacketHandler(String type, Cons handler)
        +entitySnapshot(short amount, byte[] data)
    }
    class NetServer {
        +addPacketHandler(String type, Cons2 handler)
        +getBinaryPacketHandlers(String type)
    }
    UI ..|> ApplicationListener
    UI ..|> Loadable
    Renderer ..|> ApplicationListener
    NetClient ..|> ApplicationListener
    NetServer ..|> ApplicationListener
    World o-- Tile : contains
    ContentLoader ..> Block : manages
    ContentLoader ..> UnitType : manages
}

' =============================================
' mindustry.game
' =============================================
package "mindustry.game" {
    class Rules {
        +Sector sector
        +String mission
        +blockDamage(Team team)
        +copy()
    }
    class MapObjective {
        +String completionLogicCode
        +boolean completed
        +child(MapObjective child)
        +done()
    }
    class Schematics {
        +Schematics()
        +add(Schematic schematic)
        +create(int x, int y, int x2, int y2)
    }
    Schematics ..|> Loadable
}

' =============================================
' mindustry.mod
' =============================================
package "mindustry.mod" {
    class Mods {
        +Seq~LoadedMod~ mods
        +buildFiles()
        +checkDependencies(Seq toCheck, boolean soft)
    }
    class ContentParser {
        +resolveController(String type)
        +field(Class type, JsonValue value)
    }
    Mods ..|> Loadable
    Mods o-- ContentParser : uses
}

' =============================================
' mindustry.ui.dialogs
' =============================================
package "mindustry.ui.dialogs" {
    class BaseDialog {
        #boolean shouldPause
        +BaseDialog(String title)
        +addCloseButton()
    }
    class PlanetDialog {
        +Sector selected
        +PlanetDialog()
        +abandonSectorConfirm(Sector sector, Runnable listener)
    }
    BaseDialog --|> Dialog
    PlanetDialog --|> BaseDialog
    PlanetDialog ..|> PlanetInterfaceRenderer
}

' =============================================
' mindustry.logic
' =============================================
package "mindustry.logic" {
    interface LInstruction {
        +run(LExecutor exec)
    }
    class LStatement {
        +afterRead()
        +build(Table table)
        +category()
    }
}

' =============================================
' mindustry.maps
' =============================================
package "mindustry.maps" {
    class Map {
        +boolean workshop
        +Fi file
        +addSteamID(String id)
    }
    class BasicGenerator {
        +blend(Block floor, Block around, float radius)
        +cells(int iterations)
    }
    class GenerateFilter {
        +int seed
        +apply(Tiles tiles, GenerateInput in)
        +copy()
    }
    BasicGenerator ..|> WorldGenerator
}

' =============================================
' mindustry.net
' =============================================
package "mindustry.net" {
    class Administration {
        +ObjectMap kickedIPs
        +ObjectSet dosBlacklist
        +Administration()
        +addActionFilter(ActionFilter filter)
        +addChatFilter(ChatFilter filter)
    }
}

' =============================================
' mindustry.io
' =============================================
package "mindustry.io" {
    class TypeIO {
        +readEntity(Reads read)
        +writeEntity(Writes write, Entityc entity)
        +readController(Reads read, UnitController prev)
    }
}

' =============================================
' mindustry.graphics
' =============================================
package "mindustry.graphics" {
    class Drawf {
        +additive(TextureRegion region, Color color, float x, float y)
        +additive(TextureRegion region, Color color, float x, float y, float rotation, float layer)
    }
    class LoadShader {
        +LoadShader(String frag, String vert)
    }
    LoadShader --|> Shader
}

' =============================================
' mindustry.annotations
' =============================================
package "mindustry.annotations" {
    class BaseProcessor {
        #Fi rootDirectory
        +elements(Class type)
        +err(String message)
    }
    BaseProcessor --|> AbstractProcessor
}

' =============================================
' mindustry.service
' =============================================
package "mindustry.service" {
    enum Achievement {
        active100Units
        active10Polys
        allBlocksErekir
        allBlocksSerpulo
        allTransportOneMap
    }
}

' =============================================
' mindustry (root)
' =============================================
package "mindustry" {
    class Vars {
        +Player player
        +AsyncCore asyncCore
        +AvoidanceProcess avoidance
        +checkLaunch()
        +init()
    }
    Vars ..|> Loadable
}

' =============================================
' Key cross-package relationships
' =============================================
Vars o-- World : holds
Vars o-- UI : holds
Vars o-- Renderer : holds
Vars o-- ContentLoader : holds
Vars o-- NetClient : holds
Vars o-- NetServer : holds
TurretBuild o-- BulletType : fires
UnitType o-- Ability : has
Planet o-- Rules : applies

@enduml
