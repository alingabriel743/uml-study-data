@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam arrow {
    Color #495057
    FontColor #212529
}
skinparam sequence {
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #DEE2E6
    GroupBorderColor #6C757D
    GroupBackgroundColor #F1F3F5
    DividerBorderColor #6C757D
    DividerBackgroundColor #E9ECEF
    ArrowColor #495057
    ActorBorderColor #495057
    ActorBackgroundColor #E9ECEF
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
}

title Mindustry — Combat Gameplay Sequence\n(Player Input → AI Targeting → Weapon Fire → Bullet Impact)

actor Player
participant "InputHandler\n/ MobileInput" as input
participant "NetServer" as server
participant "PlayerComp" as pc
participant "CommandAI" as ai
participant "UnitComp" as unit
participant "Weapon" as weapon
participant "BulletType" as bullet
participant "BuildingComp\n(Target)" as building
participant "Effect" as effect
participant "Renderer" as renderer

== Player Input & Network Sync ==

Player -> input : touchDown(x, y, pointer, button)
activate input

input -> server : clientSnapshot(player, snapshotID, unitID,\ndead, x, y, pointerX, pointerY)
activate server

server -> pc : handlePreviewPlans(groupId, plans)
activate pc
pc --> server : (plans accepted)
deactivate pc

server --> input : (snapshot processed)
deactivate server

== Command Dispatch to AI ==

input -> ai : commandTarget(moveTo, stopAtTarget)
activate ai

input -> ai : commandPosition(pos, stopWhenInRange)

ai -> ai : findMainTarget(x, y, range, air, ground)
note right of ai : Finds nearest enemy\nunit or building

ai -> ai : nearAttackTarget(x, y, range)
ai --> input : (target acquired)
deactivate input

== Unit Controller Assignment ==

ai -> unit : controller(next: CommandAI)
activate unit
unit -> unit : shouldUpdateController()
unit -> unit : resetController()

== Weapon Targeting & Firing ==

unit -> weapon : findTarget(unit, x, y, range, air, ground)
activate weapon
weapon -> weapon : checkTarget(unit, target, x, y, range)
note right of weapon : Validates target is\nwithin range & valid team

alt target found
    weapon -> weapon : shoot(unit, mount, shootX, shootY, rotation)
    weapon -> weapon : bulletRotation(unit, mount, bulletX, bulletY)

    weapon -> bullet : create(owner, shooter, team, x, y,\nangle, damage, velocityScl, lifetimeScl)
    activate bullet
    note right of bullet : BulletType spawns\na new bullet entity
    bullet --> weapon : bulletInstance
    deactivate bullet
end

weapon --> unit : (fire completed)
deactivate weapon
unit --> ai : (update cycle done)
deactivate unit
deactivate ai

== Bullet Impact & Damage ==

bullet -> building : damage(bullet, source, damage)
activate building
note right of building : BuildingComp applies\ndamage to health

building -> building : acceptStack(item, amount, source)
building --> bullet : (damage applied)
deactivate building

== Visual Effects ==

bullet -> effect : at(x, y, rotation, color, data)
activate effect
note right of effect : Spawns hit/explosion\nparticle effect

effect -> effect : create(x, y, rotation, color, data)
effect -> effect : add(x, y, rotation, color, data)
effect --> bullet : (effect created)
deactivate effect

== Rendering ==

renderer -> effect : render(id, color, life, lifetime, rotation, x, y, data)
activate effect
note right of renderer : Renderer draws all\nactive effects each frame
effect --> renderer : (rendered)
deactivate effect

renderer -> renderer : shake(intensity, duration)
note right of renderer : Camera shake on\nheavy impacts

@enduml
