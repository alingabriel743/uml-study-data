@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #3A7DC9
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Mindustry — Use Case Diagram

left to right direction

' ─── Actors ───────────────────────────────────────────────
actor "Player"         as player
actor "Admin"          as admin
actor "AI Unit"        as aiUnit
actor "Mod Developer"  as modDev
actor "Network Client" as netClient

' ─── System Boundary ──────────────────────────────────────
rectangle "Mindustry Game System" {

    ' --- Gameplay ---
    package "Gameplay" {
        usecase "Place / Remove Blocks"   as UC1
        usecase "Command Units"           as UC2
        usecase "Transfer Items"          as UC3
        usecase "Place Schematics"        as UC4
        usecase "Handle Build Plans"      as UC5
        usecase "Interact with Turrets"   as UC6
        usecase "Consume / Produce Items" as UC7
    }

    ' --- UI & Navigation ---
    package "UI & Navigation" {
        usecase "View Game UI"          as UC8
        usecase "Navigate Planet Map"   as UC9
        usecase "Show Info / Dialogs"   as UC10
        usecase "Use Mobile Controls"   as UC11
    }

    ' --- AI & Combat ---
    package "AI & Combat" {
        usecase "Find Enemy Target"     as UC12
        usecase "Move to Target"        as UC13
        usecase "Execute Command AI"    as UC14
        usecase "Fire Weapon / Bullet"  as UC15
    }

    ' --- Administration ---
    package "Administration" {
        usecase "Kick Player"           as UC16
        usecase "Admin / Promote Player" as UC17
        usecase "Manage Player Actions" as UC18
    }

    ' --- Mod & Content ---
    package "Mod & Content Management" {
        usecase "Load Mod"           as UC19
        usecase "Parse Mod Content"  as UC20
        usecase "Load Content by ID" as UC21
    }

    ' --- Networking ---
    package "Networking" {
        usecase "Sync Game Entities"        as UC22
        usecase "Handle Server Packets"     as UC23
        usecase "Connect / Join Server"     as UC24
    }

    ' --- World ---
    package "World Management" {
        usecase "Generate / Load Map"      as UC25
        usecase "Unlock Achievements"      as UC26
        usecase "Apply Game Rules"         as UC27
    }

}

' ─── Actor → Use Case associations ───────────────────────
player  --> UC1
player  --> UC2
player  --> UC3
player  --> UC4
player  --> UC5
player  --> UC6
player  --> UC8
player  --> UC9
player  --> UC10
player  --> UC11
player  --> UC22
player  --> UC24
player  --> UC26

admin   --> UC16
admin   --> UC17
admin   --> UC18
admin   --> UC23

aiUnit  --> UC12
aiUnit  --> UC13
aiUnit  --> UC14
aiUnit  --> UC15

modDev  --> UC19
modDev  --> UC20
modDev  --> UC21

netClient --> UC22
netClient --> UC23
netClient --> UC24

' Shared by player & system internals
player  --> UC7
player  --> UC27

' ─── Include / Extend relationships ─────────────────────
UC4  .> UC1  : <<include>>
UC14 .> UC12 : <<include>>
UC14 .> UC13 : <<extend>>
UC15 .> UC12 : <<include>>
UC20 .> UC19 : <<include>>
UC10 .> UC8  : <<extend>>
UC9  .> UC8  : <<extend>>
UC23 .> UC22 : <<include>>

@enduml
