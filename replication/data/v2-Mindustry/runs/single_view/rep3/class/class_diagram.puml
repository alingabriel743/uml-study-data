@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
}

title Mindustry — Class Diagram

' ===================================================
' EXTERNAL BASE CLASSES (stubs — defined outside IR)
' ===================================================
abstract class Content
abstract class MappableContent
abstract class Building
abstract class Dialog
abstract class BlockModule
abstract class ReloadTurret
abstract class ReloadTurretBuild
abstract class PowerBlock
abstract class AbstractProcessor
abstract class Shader

interface UnitController
interface Loadable
interface ApplicationListener
interface Senseable
interface GestureListener
interface InputProcessor
interface Cloneable
interface WorldGenerator
interface Serializable
interface Runnable
interface ControlBlock
interface LaunchAnimator

Content <|-- MappableContent

' ===================================================
' CONTENT TYPE HIERARCHY
' ===================================================
package "mindustry.ctype" {
    abstract class UnlockableContent {
        #boolean unlocked
        +TechNode techNode
        +Stats stats
        +afterPatch()
        +createIcons()
    }
    MappableContent <|-- UnlockableContent
}

' ===================================================
' WORLD
' ===================================================
package "mindustry.world" {
    class Block {
        #Seq<Consume> consumeBuilder
        +ConsumePower consPower
        +Block(String name)
        +addBar(String name, Func sup)
        +afterPatch()
    }

    class Tile {
        +Tile(int x, int y, Block floor, Block overlay, Block wall)
        +adjacentTo(Tile tile)
        +absoluteRelativeTo(int cx, int cy)
    }

    class DrawBlock {
        +String[] iconOverride
        +draw(Building build)
        +drawPlan()
        +finalIcons(Block block)
    }

    UnlockableContent <|-- Block
    Block ..|> Senseable
    Block --> DrawBlock : drawn by
}

' ===================================================
' WORLD — CONSUMERS
' ===================================================
package "mindustry.world.consumers" {
    class Consume {
        +Floatf<Building> multiplier
        +boolean optional
        +boolean booster
        +apply(Block block)
        +efficiency(Building build)
    }
}

' ===================================================
' WORLD — MODULES
' ===================================================
package "mindustry.world.modules" {
    class ItemModule {
        +add(Item item, int amount)
        +add(ItemModule items)
    }
    BlockModule <|-- ItemModule
}

' ===================================================
' WORLD — BLOCKS
' ===================================================
package "mindustry.world.blocks" {
    class Floor {
        #Bits blended
        #TextureRegion edgeRegion
        +Floor(String name)
        +damages()
        +createIcons()
    }

    class Turret {
        +Effect shootEffect
        +Effect smokeEffect
        +Turret(String name)
        +drawPlace()
        +icons()
    }

    class TurretBuild {
        +Posc target
        +SoundLoop soundLoop
        +BlockUnitc unit
        +bullet()
        +canControl()
    }

    class PowerNode {
        +PowerNode(String name)
        +drawLaser()
        +drawPlace()
        +changePlacementPath()
    }

    class CoreBuild {
        +Vec2 commandPos
        +Team lastDamage
        +acceptItem()
        +beginLaunch()
        +canControlSelect()
    }

    class PayloadBlockBuild {
        +Payload payload
        +Vec2 payVector
        +boolean carried
        +acceptPayload()
        +drawPayload()
    }

    Block <|-- Floor
    Building <|-- CoreBuild
    Building <|-- PayloadBlockBuild
    ReloadTurret <|-- Turret
    ReloadTurretBuild <|-- TurretBuild
    PowerBlock <|-- PowerNode
    CoreBuild ..|> LaunchAnimator
    TurretBuild ..|> ControlBlock
}

' ===================================================
' WORLD — META
' ===================================================
package "mindustry.world.meta" {
    class StatValues {
        +abilities(Seq<Ability> abilities)
        +ammo()
    }
}

' ===================================================
' ENTITY COMPONENTS
' ===================================================
package "mindustry.entities.comp" {
    class BuildingComp {
        +ItemModule items
        +LiquidModule liquids
        +acceptItem()
        +acceptPayload()
        +absorbLasers()
    }

    class UnitComp {
        +WeaponMount[] mounts
        +Team team
        +Vec2 vel
        +controller()
        +resetController()
    }

    class PlayerComp {
        +Team team
        +Unit unit
        +Block selectedBlock
        +isValidController()
        +bestCore()
    }

    BuildingComp ..|> Senseable
    PlayerComp ..|> UnitController
    BuildingComp --> ItemModule : items
}

' ===================================================
' ENTITIES
' ===================================================
package "mindustry.entities" {
    class Effect {
        +float life
        +Cons<EffectContainer> renderer
        +boolean followParent
        +at(Position pos)
        +add()
    }

    class Ability {
        +float data
        +boolean display
        +addStats(Table t)
        +created(Unit unit)
    }

    class EntityGroup {
        -IntMap<T> map
        -QuadTree tree
        +add(T type)
        +addIndex(T type)
    }

    class Units {
        +anyEntities()
        +any()
        +overlapping()
    }

    Ability ..|> Cloneable
}

' ===================================================
' ENTITIES — BULLET
' ===================================================
package "mindustry.entities.bullet" {
    class BulletType {
        +float speed
        +float damage
        +BulletType fragBullet
        +BulletType(float speed, float damage)
        +hitEntity()
    }

    Content <|-- BulletType
    BulletType ..|> Cloneable
    BulletType o-- BulletType : fragBullet
}

' ===================================================
' ENTITIES — UNITS (AI Base)
' ===================================================
package "mindustry.entities.units" {
    abstract class AIController {
        #Unit unit
        #Teamc target
        #Interval timer
        +afterRead(Unit unit)
        +circle(Position target, float len)
    }

    AIController ..|> UnitController
}

' ===================================================
' AI
' ===================================================
package "mindustry.ai" {
    class ControlPathfinder {
        -Cluster[][][] clusters
        +avoid()
        +checkEdges()
        +addFlowCluster()
    }

    ControlPathfinder ..|> Runnable
}

' ===================================================
' AI — TYPES
' ===================================================
package "mindustry.ai.types" {
    class CommandAI {
        #AIController commandController
        #UnitCommand lastCommand
        +command(UnitCommand cmd)
        +commandPosition()
        +clearCommands()
    }

    AIController <|-- CommandAI
}

' ===================================================
' TYPE
' ===================================================
package "mindustry.type" {
    class UnitType {
        +int ammoCapacity
        +float buildTime
        +UnitType(String name)
        +createController(Unit unit)
        +afterPatch()
    }

    class Planet {
        -CampaignStats campaignStats
        +Planet(String name, Planet parent, float radius)
        +applyRules(Rules rules)
        +addParentOffset()
    }

    class Weapon {
        +BulletType bullet
        +Color heatColor
        +Effect ejectEffect
        +Weapon(String name)
        +addStats()
    }

    UnlockableContent <|-- UnitType
    UnlockableContent <|-- Planet
    UnitType ..|> Senseable
    Weapon ..|> Cloneable
    UnitType --> Weapon : weapons
    UnitType --> Ability : abilities
    Weapon --> BulletType : fires
    Weapon --> Effect : eject effect
}

' ===================================================
' CORE SERVICES
' ===================================================
package "mindustry.core" {
    class Vars {
        +Player player
        +World world
        +UI ui
        +init()
        +loadAsync()
    }

    class World {
        +Tiles tiles
        +Context context
        +build(int x, int y)
        +beginMapLoad()
    }

    class UI {
        +AboutDialog about
        +UI()
        +announce(String text)
        +formatAmount(long number)
    }

    class Renderer {
        -Vec2 camShakeOffset
        -boolean launching
        +addEnvRenderer()
        +clampScale()
    }

    class ContentLoader {
        +block(int id)
        +bullet(int id)
        +blocks()
    }

    class NetClient {
        -DataInputStream dataStream
        +addPacketHandler()
        +entitySnapshot()
    }

    class NetServer {
        -DataOutputStream dataStream
        +addPacketHandler()
        +getPacketHandlers()
    }

    Vars ..|> Loadable
    UI ..|> ApplicationListener
    UI ..|> Loadable
    NetClient ..|> ApplicationListener
    NetServer ..|> ApplicationListener
    Renderer ..|> ApplicationListener

    Vars --> World
    Vars --> UI
    Vars --> Renderer
    Vars --> ContentLoader
}

' ===================================================
' INPUT
' ===================================================
package "mindustry.input" {
    class InputHandler {
        +add()
        +addLock(Boolp lock)
        +breakBlock(int x, int y)
        +allPlans()
    }

    class MobileInput {
        +Block lastBlock
        +Building buildingTapped
        +autoPan()
        +buildPlacementUI()
    }

    InputHandler ..|> GestureListener
    InputHandler ..|> InputProcessor
    InputHandler <|-- MobileInput
    MobileInput ..|> GestureListener
}

' ===================================================
' UI DIALOGS
' ===================================================
package "mindustry.ui.dialogs" {
    class BaseDialog {
        #boolean shouldPause
        #boolean wasPaused
        +BaseDialog(String title)
        +addCloseButton()
    }

    class PlanetDialog {
        +Sector selected
        +Sector hovered
        +PlanetDialog()
        +abandonSectorConfirm()
    }

    Dialog <|-- BaseDialog
    BaseDialog <|-- PlanetDialog
}

' ===================================================
' GAME
' ===================================================
package "mindustry.game" {
    class Rules {
        +Sector sector
        +String backgroundTexture
        +copy()
        +buildSpeed(Team team)
    }

    class Schematics {
        +Schematics()
        +add(Schematic s)
        +create()
        +all()
    }

    class MapObjective {
        -boolean completed
        +String details
        +String completionLogicCode
        +done()
        +child(MapObjective child)
    }

    Schematics ..|> Loadable
    MapObjective ..|> Serializable
    MapObjective o-- MapObjective : children
}

' ===================================================
' MAPS
' ===================================================
package "mindustry.maps" {
    class Map {
        +LoadedMod mod
        +boolean workshop
        +Map(Fi file, int width, int height, StringMap tags, boolean custom)
        +addSteamID(String id)
    }

    class BasicGenerator {
        #Rand rand
        #int width, height
        +cells(int iterations)
        +brush(Seq<Tile> path, int rad)
    }

    class GenerateFilter {
        +int seed
        +apply(Tiles tiles, GenerateInput in)
        +copy()
        +draw(Image image)
    }

    BasicGenerator ..|> WorldGenerator
    GenerateFilter ..|> Cloneable
    GenerateFilter ..|> Serializable
}

' ===================================================
' MODS
' ===================================================
package "mindustry.mod" {
    class Mods {
        +Seq<LoadedMod> mods
        +Mods()
        +buildFiles()
        +checkDependencies()
    }

    class ContentParser {
        +Seq<ParseListener> listeners
        +resolveController()
        +field(Class<?> type, JsonValue value)
    }

    Mods ..|> Loadable
    Mods --> ContentParser : uses
}

' ===================================================
' LOGIC
' ===================================================
package "mindustry.logic" {
    class LStatement {
        +String[] aligns
        +afterRead()
        +build(Table table)
        +category()
    }

    interface LInstruction {
        +run(LExecutor exec)
    }
}

' ===================================================
' NET
' ===================================================
package "mindustry.net" {
    class Administration {
        +ObjectMap<String, PlayerInfo> playerInfo
        +Seq<ActionFilter> actionFilters
        +addActionFilter()
        +addChatFilter()
    }
}

' ===================================================
' IO
' ===================================================
package "mindustry.io" {
    class TypeIO {
        +readEntity(Reads read)
        +writeEntity(Writes write, Entityc entity)
        +readController()
    }
}

' ===================================================
' GRAPHICS
' ===================================================
package "mindustry.graphics" {
    class Drawf {
        +additive()
        +arrow()
        +circle()
    }

    class LoadShader {
        +LoadShader(String frag, String vert)
    }

    Shader <|-- LoadShader
}

' ===================================================
' SERVICE
' ===================================================
package "mindustry.service" {
    enum Achievement {
        active100Units
        active10Polys
        allBlocksErekir
        allBlocksSerpulo
        allTransportOneMap
    }
}

' ===================================================
' ANNOTATIONS
' ===================================================
package "mindustry.annotations" {
    class BaseProcessor {
        #Fi rootDirectory
        #RoundEnvironment env
        +elements()
        +err()
        +fields()
    }

    AbstractProcessor <|-- BaseProcessor
}

' ===================================================
' KEY CROSS-PACKAGE RELATIONSHIPS
' ===================================================
Block --> Consume : consumes
Turret --> BulletType : fires
TurretBuild --> BulletType : fires
ContentLoader ..> Block : manages
ContentLoader ..> BulletType : manages
Vars --> Mods : mods
Vars --> NetClient : netClient
Vars --> NetServer : netServer
UnitComp ..> UnitController : controlled by
AIController ..> UnitComp : controls

@enduml
