@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    BoxBorderColor #6C757D
    BoxBackgroundColor #E9ECEF
    GroupBorderColor #6C757D
    GroupBackgroundColor #DEE2E6
    DividerBorderColor #6C757D
}

title Mindustry — Unit Combat & Game Interaction Sequence

actor Player as player
participant "InputHandler" as input
participant "CommandAI" as commandAI
participant "AIController" as aiCtrl
participant "Units" as units
participant "UnitType" as unitType
participant "UnitComp" as unitComp
participant "Weapon" as weapon
participant "BulletType" as bulletType
participant "TurretBuild" as turret
participant "BuildingComp" as building
participant "Effect" as effect

== Unit Spawn & Controller Setup ==

player -> input : touchDown(screenX, screenY, pointer, button)
activate input

input -> unitType : spawn(team, x, y, rotation)
activate unitType
unitType -> unitComp : controller(next)
activate unitComp
unitComp --> unitType : controller assigned
deactivate unitComp
unitType --> input : unit spawned
deactivate unitType

== Player Issues Attack Command ==

player -> input : commandUnits(player, unitIds, buildTarget, unitTarget, posTarget, queueCommand, finalBatch)
input -> commandAI : commandTarget(moveTo, stopAtTarget)
activate commandAI
commandAI --> input : command acknowledged
deactivate commandAI
deactivate input

== AI Targeting Loop ==

activate commandAI
commandAI -> commandAI : findMainTarget(x, y, range, air, ground)
activate commandAI

commandAI -> units : closestTarget(team, x, y, range, unitPred, tilePred)
activate units
units --> commandAI : Teamc target
deactivate units

commandAI -> aiCtrl : target(x, y, range, air, ground)
activate aiCtrl
aiCtrl -> units : bestTarget(team, x, y, range, unitPred, tilePred, sort)
activate units
units --> aiCtrl : best Teamc target
deactivate units
aiCtrl --> commandAI : target acquired
deactivate aiCtrl

deactivate commandAI

commandAI -> aiCtrl : moveTo(target, circleLength, smooth, keepDistance, offset, arrive)
activate aiCtrl
aiCtrl --> commandAI : movement applied
deactivate aiCtrl
deactivate commandAI

== Weapon Fire Sequence ==

activate weapon
weapon -> weapon : findTarget(unit, x, y, range, air, ground)
weapon -> weapon : checkTarget(unit, target, x, y, range)

weapon -> weapon : shoot(unit, mount, shootX, shootY, rotation)
activate weapon

weapon -> bulletType : create(owner, shooter, team, x, y, angle, damage, velocityScl)
activate bulletType
bulletType --> weapon : Bullet b
deactivate weapon

== Bullet Impact & Damage Resolution ==

bulletType -> bulletType : hitEntity(b, entity, health)
activate bulletType

bulletType -> building : damage(bullet, source, damage)
activate building
building --> bulletType : damage applied
deactivate building

bulletType -> effect : at(x, y, rotation, color, data)
activate effect
effect -> effect : render(id, color, life, lifetime, rotation, x, y, data)
effect --> bulletType : effect created
deactivate effect

deactivate bulletType
deactivate bulletType
deactivate weapon

== Turret Auto-Defense ==

note over turret : Turret reacts independently\nto enemy units in range

turret -> units : bestEnemy(team, x, y, range, predicate, sort)
activate turret
activate units
units --> turret : enemy Unit/Building
deactivate units

turret -> turret : handleBullet(bullet, offsetX, offsetY, angleOffset)

turret -> bulletType : create(owner, team, x, y, angle, damage, velocityScl, lifetimeScl)
activate bulletType
bulletType --> turret : Bullet b
deactivate bulletType

turret -> effect : at(x, y, rotation, color, data)
activate effect
effect --> turret : muzzle flash rendered
deactivate effect
deactivate turret

== Network Sync (Multiplayer) ==

participant "NetServer" as netServer
participant "NetClient" as netClient

netServer -> netServer : clientSnapshot(player, snapshotID, unitID, dead, x, y, pointerX, pointerY)
activate netServer

netServer -> building : init(tile, team, shouldAdd, rotation)
activate building
building --> netServer : building initialized
deactivate building

netServer --> netClient : entity snapshot data
deactivate netServer

activate netClient
netClient -> netClient : entitySnapshot(amount, data)
netClient -> netClient : readSyncEntity(input, read)
deactivate netClient

@enduml
