@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

left to right direction
title Mindustry — Use Case Diagram

actor "Player" as player
actor "Admin" as admin
actor "AI System" as ai
actor "Mod Developer" as moddev

admin --|> player

rectangle "Mindustry Game System" {

    package "Campaign & World" {
        usecase "Play Campaign" as UC1
        usecase "Launch to Planet" as UC2
        usecase "Complete Map Objective" as UC3
        usecase "Unlock Achievement" as UC4
    }

    package "Construction" {
        usecase "Build Structures" as UC5
        usecase "Place Schematics" as UC6
        usecase "Configure Block" as UC7
    }

    package "Resource Management" {
        usecase "Manage Resources" as UC8
        usecase "Control Power Grid" as UC9
    }

    package "Combat" {
        usecase "Command Units" as UC10
        usecase "Fire Weapon" as UC11
        usecase "Engage Turret" as UC12
    }

    package "Multiplayer" {
        usecase "Join Multiplayer Game" as UC13
        usecase "Send Chat Message" as UC14
        usecase "Manage Server" as UC15
        usecase "Kick Player" as UC16
    }

    package "AI Behavior" {
        usecase "Pathfind to Target" as UC17
        usecase "Find & Target Enemy" as UC18
        usecase "Execute AI Command" as UC19
    }

    package "Modding" {
        usecase "Load Mod" as UC20
        usecase "Parse Mod Content" as UC21
    }
}

' Player interactions
player --> UC1
player --> UC2
player --> UC5
player --> UC6
player --> UC7
player --> UC8
player --> UC10
player --> UC13
player --> UC14

' Admin interactions
admin --> UC15
admin --> UC16

' AI System interactions
ai --> UC17
ai --> UC18
ai --> UC19

' Mod Developer interactions
moddev --> UC20

' Use case relationships
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<extend>>
UC2 ..> UC1 : <<extend>>
UC5 ..> UC9 : <<extend>>
UC5 ..> UC7 : <<include>>
UC10 ..> UC19 : <<include>>
UC11 ..> UC12 : <<include>>
UC18 ..> UC17 : <<extend>>
UC20 ..> UC21 : <<include>>

@enduml
