@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
}
skinparam swimlane {
    BorderColor #495057
    TitleFontSize 14
}

title Mindustry — Unit & Turret Combat Workflow

|Player / InputHandler|
start
:Player selects units\n(drag-select or tap);
:Player issues command\n(tap target or position);
:commandUnits() validates\nplayer permissions via\nAdministration.allowAction();

if (Target is enemy\nunit or building?) then (yes)
    :commandTarget()\nassign attack target;
else (no)
    :commandPosition()\nassign move-to position;
endif

:Assign UnitGroup\nformation for batch;

|AIController / CommandAI|
:updateUnit() called\neach game tick;

if (useFallback()?) then (yes)
    :Delegate to\nfallback AI controller;
    detach
else (no)
endif

:updateVisuals()\nhandle rotation & wobble;
:updateTargeting();

if (unit.hasWeapons()?) then (yes)
    :updateWeapons();
    :retarget() check\ntimer interval;

    if (Retarget timer\nexpired?) then (yes)
        :findMainTarget()\nvia Units.bestTarget()\nsearch air/ground;
    else (no)
    endif

    if (Target valid?) then (yes)
        :Iterate weapon mounts;
        :Calculate mount position\n& aim direction;

        if (Single target mode?) then (yes)
            :mount.target = main target;
        else (no)
            :findTarget() per weapon\nwithin weapon range;
        endif

        :Predict intercept point\nvia Predict.intercept();
        :Set mount.shoot = true\nunit.isShooting = true;
    else (no)
        :target = null\nstopShooting();
    endif
else (no)
endif

:updateMovement()\npathfind / moveTo;

|Weapon|
:Weapon.update() called\nper mount each tick;
:Decrement mount.reload\nby Time.delta × reloadMultiplier;
:Update recoil, warmup,\ncharge, heat;

if (Weapon is autoTarget\n& !controllable?) then (yes)
    :Independently find\ntarget for this mount;
    :Check target within\nbullet.range;
    :Predict aim position;
else (no)
endif

if (Weapon rotates?) then (yes)
    :Rotate mount toward\naim point at rotateSpeed;
    if (rotationLimit < 360°?) then (yes)
        :Clamp rotation to\nallowed arc;
    else (no)
    endif
else (no)
    :mount.rotation =\nbaseRotation;
endif

:Calculate bulletX, bulletY\nshootAngle from mount;

if (mount.shoot\n&& canShoot\n&& warmup ≥ minWarmup\n&& reload ≤ 0\n&& within shootCone?) then (yes)
    :shoot() — apply\nshootStatus to unit;

    if (firstShotDelay > 0?) then (yes)
        :Begin charging\nplay chargeSound\nshow chargeEffect;
    else (no)
    endif

    :shoot.shoot() iterates\nbarrels with offsets;

    if (Delay > 0?) then (yes)
        :Time.run(delay, …)\nschedule bullet;
    else (no)
        :bullet() — spawn\nprojectile immediately;
    endif

    :Create BulletType.create()\nwith owner, team, position,\nangle, velocity, lifetime;
    :handleBullet() for\ncontinuous weapons;
    :Play shootSound\napply ejectEffect\napply shootEffect;
    :Apply recoil to unit\nscreen shake;
    :mount.reload = reload\n(reset timer);
else (no)
    if (Continuous bullet\nstill alive?) then (yes)
        :Update bullet position\n& rotation to match mount;
        :Smooth laser aim length\nvia aimChangeSpeed;
    else (no)
        :Decrease heat over\ncooldownTime;
    endif
endif

|BulletType|
:Bullet.update() each tick\nadvance position by velocity;

if (Bullet collides\nwith Hitboxc entity?) then (yes)
    :hitEntity() invoked;
    :Calculate effective damage\n(apply maxDamageFraction cap);

    if (lifesteal > 0?) then (yes)
        :Heal owner by\ndamage × lifesteal;
    else (no)
    endif

    if (pierceArmor?) then (yes)
        :damagePierce()\nignore armor;
    else (no)
        :damage() with\narmorMultiplier;
    endif

    if (Target is Unit?) then (yes)
        :Apply knockback impulse;
        :Apply status effect\n& duration;
        if (Unit killed?) then (yes)
            :Fire UnitBulletDestroyEvent;
        else (no)
        endif
    else (no)
    endif

    :handlePierce()\nreduce bullet damage\nby pierceDamageFactor;

    if (removeAfterPierce\n&& damage ≤ 0?) then (yes)
        :Remove bullet;
    else (no)
        :Continue piercing;
    endif
else (no)
    if (Bullet hits terrain\nor expires?) then (yes)
        :hit() — show hitEffect\nplay hitSound, shake;
        :createFrags() spawn\nfragment bullets;
        :createPuddles() on ground;
        :createSplashDamage()\narea-of-effect;

        if (lightning > 0?) then (yes)
            :Spawn lightning\nchains;
        else (no)
        endif

        if (suppressionRange > 0?) then (yes)
            :Apply suppression\nzone to area;
        else (no)
        endif
    else (no)
        :Continue flight;
    endif
endif

|Turret (Building)|
:updateTile() each tick;
:Validate current target\n(Units.invalidateTarget);
:Update warmup, recoil,\nheat, charge;
:updateReload()\nupdateCooling();

if (hasAmmo()?) then (yes)
    if (Target timer\nexpired?) then (yes)
        :findTarget() →\nfindEnemy(range);

        if (canHeal()?) then (yes)
            :Also search for\ndamaged ally buildings;
        else (no)
        endif
    else (no)
    endif

    if (validateTarget()?) then (yes)
        if (Player controlled?) then (yes)
            :targetPos = unit.aimXY\ncanShoot = unit.isShooting;
        else if (Logic controlled?) then (yes)
            :canShoot = logicShooting;
        else (AI controlled)
            :targetPosition() —\npredict intercept;
            :canShoot = within range;
        endif

        :turnToTarget()\nrotate at rotateSpeed;

        if (Within shootCone\n&& canShoot?) then (yes)
            :updateShooting()\nfire turret weapon;
        else (no)
        endif
    else (no)
        :target = null;
    endif
else (no)
    :Wait for ammo\nsupply;
endif
stop

@enduml
