@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam linetype ortho

title Mindustry - Class Diagram

' ============================
' CONTENT TYPE SYSTEM
' ============================
package "mindustry.ctype" {
    abstract class Content {
    }

    abstract class MappableContent {
    }

    class UnlockableContent {
        -unlocked: boolean
        +techNode: TechNode
        +stats: Stats
        +databaseCategory: String
        +UnlockableContent(name: String)
        +checkStats()
        +clearUnlock()
        +createIcons(packer: MultiPacker)
    }

    Content <|-- MappableContent
    MappableContent <|-- UnlockableContent
}

' ============================
' WORLD - BLOCKS & TILES
' ============================
package "mindustry.world" {
    class Block {
        #barMap: OrderedMap<String, Func>
        #consumeBuilder: Seq<Consume>
        +consPower: ConsumePower
        +lastConfig: Object
        +Block(name: String)
        +addBar(name: String, sup: Func)
        +addLiquidBar(liq: Liquid)
        +afterPatch()
    }

    class Tile {
        +Tile(x: int, y: int)
        +Tile(x: int, y: int, floor: Block, overlay: Block, wall: Block)
        +adjacentTo(tile: Tile): boolean
        +absoluteRelativeTo(cx: int, cy: int): int
    }

    class DrawBlock {
        +iconOverride: String[]
        +draw(build: Building)
        +drawLight(build: Building)
        +drawPlan(block: Block, plan: BuildPlan, list: Eachable)
        +finalIcons(block: Block): TextureRegion[]
    }

    class Consume {
        +booster: boolean
        +optional: boolean
        +update: boolean
        +multiplier: Floatf<Building>
        +apply(block: Block)
        +efficiency(build: Building): float
        +display(stats: Stats)
        +build(build: Building, table: Table)
    }
}

package "mindustry.world.blocks.environment" {
    class Floor {
        #blended: Bits
        #blenders: Seq<Floor>
        #edgeRegion: TextureRegion
        +Floor(name: String)
        +Floor(name: String, variants: int)
        +damages(): boolean
        +createIcons(packer: MultiPacker)
    }
}

package "mindustry.world.blocks.defense.turrets" {
    abstract class BaseTurret {
    }

    class ReloadTurret {
    }

    class Turret {
        +shootEffect: Effect
        +smokeEffect: Effect
        +heatColor: Color
        +unitFilter: Boolf<Unit>
        +Turret(name: String)
        +drawPlace(x: int, y: int, rotation: int, valid: boolean)
        +icons(): TextureRegion[]
    }

    class TurretBuild {
        +target: Posc
        +unit: BlockUnitc
        +curRecoils: float[]
        +bullet(type: BulletType, xOffset: float, yOffset: float, angleOffset: float, mover: Mover)
        +canControl(): boolean
        +activeSoundVolume(): float
    }

    BaseTurret --|> Block
    ReloadTurret --|> BaseTurret
    Turret --|> ReloadTurret
    Turret +-- TurretBuild
}

package "mindustry.world.blocks.storage" {
    class CoreBuild {
        +commandPos: Vec2
        +lastDamage: Team
        +noEffect: boolean
        +iframes: float
        +acceptItem(source: Building, item: Item)
        +canPickup(): boolean
        +beginLaunch(launching: boolean)
        +afterDestroyed()
    }
}

package "mindustry.world.blocks.payloads" {
    class PayloadBlockBuild<T> {
        +payload: T
        +payVector: Vec2
        +payRotation: float
        +carried: boolean
        +acceptPayload(source: Building, payload: Payload)
        +drawPayload()
        +acceptUnitPayload(unit: Unit)
    }
}

package "mindustry.world.blocks.power" {
    class PowerBlock {
    }

    class PowerNode {
        +PowerNode(name: String)
        +changePlacementPath(points: Seq<Point2>, rotation: int)
        +drawLaser(x1: float, y1: float, x2: float, y2: float, size1: int, size2: int)
        +drawPlace(x: int, y: int, rotation: int, valid: boolean)
    }

    PowerBlock --|> Block
    PowerNode --|> PowerBlock
}

package "mindustry.world.modules" {
    abstract class BlockModule {
    }

    class ItemModule {
        -flow: WindowedMean[]
        +add(item: Item, amount: int)
        +add(items: ItemModule)
        +add(stacks: ItemSeq)
    }

    ItemModule --|> BlockModule
}

package "mindustry.world.meta" {
    class StatValues {
        +{static} abilities(abilities: Seq<Ability>)
        +{static} ammo(map: ObjectMap, showUnit: boolean)
    }
}

package "mindustry.world.consumers" #E9ECEF {
}

' ============================
' ENTITIES
' ============================
package "mindustry.entities" {
    class Effect {
        +renderer: Cons<EffectContainer>
        +followParent: boolean
        +Effect(life: float, clipsize: float, renderer: Cons)
        +Effect(life: float, renderer: Cons)
        +at(pos: Position)
        +add(x: float, y: float, rotation: float, color: Color, data: Object)
    }

    class Units {
        +{static} any(x: float, y: float, width: float, height: float, filter: Boolf<Unit>): boolean
        +{static} anyEntities(tile: Tile): boolean
        +{static} anyEntities(x: float, y: float, size: float): boolean
    }

    class EntityGroup<T> {
        -map: IntMap<T>
        -tree: QuadTree
        -indexer: EntityIndexer
        +EntityGroup(type: Class, spatial: boolean, mapping: boolean)
        +add(type: T)
        +checkIDCollisions()
    }
}

package "mindustry.entities.comp" {
    class BuildingComp {
        +items: ItemModule
        +liquids: LiquidModule
        +team: Team
        +x: float
        +y: float
        +acceptItem(source: Building, item: Item)
        +acceptLiquid(source: Building, liquid: Liquid)
        +acceptPayload(source: Building, payload: Payload)
        +absorbLasers(): boolean
    }

    class UnitComp {
        +mounts: WeaponMount[]
        +vel: Vec2
        +mineTile: Tile
        +stack: ItemStack
        +controller(next: UnitController)
        +controller(): UnitController
        +resetController()
        +getControllerName(): String
    }

    class PlayerComp {
        +unit: Unit
        +team: Team
        +selectedBlock: Block
        +lastCommand: UnitCommand
        +bestCore(): CoreBuild
        +clearUnit()
        +afterSync()
        +checkSpawn()
    }
}

package "mindustry.entities.bullet" {
    class BulletType {
        -cachedDps: float
        +fragBullet: BulletType
        +intervalBullet: BulletType
        +lightningType: BulletType
        +shootPattern: ShootPattern
        +BulletType(speed: float, damage: float)
        +hitEntity(b: Bullet, entity: Hitboxc, health: float)
        +buildingDamage(b: Bullet): float
    }
}

package "mindustry.entities.units" {
    class AIController {
        #target: Teamc
        #fallback: AIController
        #unit: Unit
        #timer: Interval
        #bomberTarget: Teamc
        +checkTarget(target: Teamc, x: float, y: float, range: float)
        +circle(target: Position, circleLength: float, speed: float)
        +afterRead(unit: Unit)
        +alterPathfind(vec: Vec2)
    }
}

package "mindustry.entities.abilities" {
    class Ability {
        +display: boolean
        +data: float
        +addStats(t: Table)
        +copy(): Ability
        +created(unit: Unit)
        +death(unit: Unit)
    }
}

' ============================
' AI SYSTEM
' ============================
package "mindustry.ai" {
    class ControlPathfinder {
        +ControlPathfinder()
        +avoid(team: int, type: PathCost, tilePos: int)
        +addFlowCluster(cache: FieldCache, cluster: int, addingFrontier: boolean)
        +checkEdges(request: PathRequest, team: int, pathCost: int, current: int, goal: int, cx: int, cy: int, connections: LongSeq)
    }

    class CommandAI {
        #commandController: AIController
        #lastCommand: UnitCommand
        #lastTargetPos: Vec2
        #blockingUnit: boolean
        +command(command: UnitCommand)
        +commandPosition(pos: Vec2)
        +clearCommands()
        +afterRead(unit: Unit)
    }

    CommandAI --|> AIController
}

' ============================
' TYPES
' ============================
package "mindustry.type" {
    class UnitType {
        -buildTime: float
        +ammoCapacity: int
        +UnitType(name: String)
        +createController(unit: Unit): UnitController
        +allowCommand(unit: Unit, command: UnitCommand): boolean
        +checkEntityMapping(example: Unit)
    }

    class Planet {
        -campaignStats: CampaignStats
        +Planet(name: String, parent: Planet, radius: float)
        +Planet(name: String, parent: Planet, radius: float, sectorSize: int)
        +applyRules(rules: Rules)
        +addParentOffset(in: Vec3)
        +applyDefaultRules(rules: CampaignRules)
    }

    class Weapon {
        +bullet: BulletType
        +heatColor: Color
        +ejectEffect: Effect
        +shootOnDeathEffect: Effect
        +mountType: Func<Weapon, WeaponMount>
        +Weapon(name: String)
        +addStats(u: UnitType, t: Table)
        +bullet(unit: Unit, mount: WeaponMount, xOffset: float, yOffset: float, angleOffset: float, mover: Mover)
        +bulletRotation(unit: Unit, mount: WeaponMount, bulletX: float, bulletY: float): float
    }
}

' ============================
' CORE SYSTEMS
' ============================
package "mindustry.core" {
    class Vars << (S,#FF7700) Singleton >> {
        +{static} player: Player
        +{static} world: World
        +{static} ui: UI
        +{static} renderer: Renderer
        +{static} netClient: NetClient
        +{static} asyncCore: AsyncCore
        +{static} bases: BaseRegistry
        +init()
        +loadAsync()
        +checkLaunch()
    }

    class UI {
        +about: AboutDialog
        -lastAnnouncement: Element
        -labels: IntMap<Table>
        +UI()
        +announce(text: String)
        +announce(text: String, duration: float)
        +formatAmount(number: long): String
        +addDescTooltip(elem: Element, description: String)
    }

    class NetClient {
        -dataStream: DataInputStream
        -removed: IntSet
        +addPacketHandler(type: String, handler: Cons<String>)
        +addBinaryPacketHandler(type: String, handler: Cons<byte[]>)
        +entitySnapshot(amount: short, data: byte[])
        +addRemovedEntity(id: int)
    }

    class NetServer {
        -dataStream: DataOutputStream
        -buildHealthChanged: IntSet
        +addPacketHandler(type: String, handler: Cons2<Player, String>)
        +addBinaryPacketHandler(type: String, handler: Cons2<Player, byte[]>)
        +addLogicDataHandler(type: String, handler: Cons2<Player, Object>)
        +getPacketHandlers(type: String): Seq
    }

    class ContentLoader {
        -nameMap: ObjectMap<String, MappableContent>
        -lastAdded: Content
        -currentMod: LoadedMod
        +ContentLoader()
        +block(id: int): Block
        +block(name: String): Block
        +blocks(): Seq<Block>
        +bullet(id: int): BulletType
    }

    class World {
        +tiles: Tiles
        +context: Context
        -generating: boolean
        -invalidMap: boolean
        +World()
        +build(x: int, y: int): Building
        +beginMapLoad()
        +addDarkness(tiles: Tiles)
        +addMapLoader(map: Map, loader: Runnable)
    }

    class Renderer {
        -clearColor: Color
        -launching: boolean
        -glErrors: int
        +Renderer()
        +addEnvRenderer(mask: int, render: Runnable)
        +addCustomBackground(name: String, render: Runnable)
        +clampScale()
        +dispose()
    }
}

' ============================
' GAME
' ============================
package "mindustry.game" {
    class Rules {
        +sector: Sector
        +mission: String
        +planetBackground: PlanetParams
        +backgroundTexture: String
        +copy(): Rules
        +blockDamage(team: Team): float
        +buildSpeed(team: Team): float
        +buildRadius(team: Team): float
        +blockHealth(team: Team): float
    }

    class Schematics {
        -defaultLoadouts: ObjectMap<CoreBlock, Schematic>
        -errored: ObjectSet<Schematic>
        +Schematics()
        +add(schematic: Schematic)
        +all(): Seq<Schematic>
        +create(x: int, y: int, x2: int, y2: int): Schematic
        +checkLoadout(s: Schematic, customSchem: boolean)
    }

    class MapObjective {
        -completed: boolean
        -depFinished: boolean
        -children: Seq<MapObjective>
        +details: String
        +completionLogicCode: String
        +child(child: MapObjective): MapObjective
        +done(): boolean
        +dependencyFinished(): boolean
    }
}

' ============================
' INPUT
' ============================
package "mindustry.input" {
    class InputHandler {
        +InputHandler()
        +addLock(lock: Boolp)
        +breakBlock(x: int, y: int)
        +allPlans(): Seq<BuildPlan>
        +add()
    }

    class MobileInput {
        +lastBlock: Block
        +lastPlaced: BuildPlan
        +buildingTapped: Building
        +payloadTarget: Position
        +autoPan()
        +buildPlacementUI(table: Table)
        +buildUI(group: Group)
        +checkTargets(x: float, y: float)
    }

    MobileInput --|> InputHandler
}

' ============================
' UI DIALOGS
' ============================
package "mindustry.ui.dialogs" {
    class BaseDialog {
        #shouldPause: boolean
        #wasPaused: boolean
        +BaseDialog(title: String)
        +BaseDialog(title: String, style: DialogStyle)
        +addCloseButton()
        +addCloseButton(width: float)
        +addCloseListener()
    }

    class PlanetDialog {
        +selected: Sector
        +hovered: Sector
        +launchSector: Sector
        +launchCandidates: Seq<Planet>
        +PlanetDialog()
        +act(delta: float)
        +abandonSectorConfirm(sector: Sector, listener: Runnable)
        +addSurvivedInfo(sector: Sector, table: Table, wrap: boolean)
    }

    PlanetDialog --|> BaseDialog
}

' ============================
' GRAPHICS
' ============================
package "mindustry.graphics" {
    class Drawf {
        +{static} additive(region: TextureRegion, color: Color, x: float, y: float)
        +{static} additive(region: TextureRegion, color: Color, x: float, y: float, rotation: float)
    }

    class LoadShader {
        +LoadShader(frag: String, vert: String)
    }
}

' ============================
' IO
' ============================
package "mindustry.io" {
    class TypeIO {
        +{static} readEntity(read: Reads): Entityc
        +{static} writeEntity(write: Writes, entity: Entityc)
        +{static} readController(read: Reads, prev: UnitController): UnitController
        +{static} writeController(write: Writes, control: UnitController)
        +{static} readPosEntity(read: Reads): Entityc
    }
}

' ============================
' LOGIC
' ============================
package "mindustry.logic" {
    class LStatement {
        +elem: StatementElem
        +build(table: Table)
        +build(builder: LAssembler)
        +category(): LCategory
        +afterRead()
    }

    interface LInstruction {
        +run(exec: LExecutor)
    }
}

' ============================
' MAPS
' ============================
package "mindustry.maps" {
    class Map {
        +file: Fi
        +mod: LoadedMod
        +texture: Texture
        +workshop: boolean
        +teams: IntSet
        +Map(file: Fi, width: int, height: int, tags: StringMap, custom: boolean)
        +addSteamID(id: String)
    }

    class GenerateFilter {
        +seed: int
        +apply(tiles: Tiles, in: GenerateInput)
        +copy(): GenerateFilter
        +draw(image: Image)
        +chance(x: int, y: int): float
    }

    class BasicGenerator {
        #floor: Block
        #block: Block
        #ore: Block
        #tiles: Tiles
        +blend(floor: Block, around: Block, radius: float)
        +brush(path: Seq<Tile>, rad: int)
        +cells(iterations: int)
        +cliffs()
    }
}

' ============================
' MOD SYSTEM
' ============================
package "mindustry.mod" {
    class Mods {
        +mods: Seq<LoadedMod>
        -parser: ContentParser
        -scripts: Scripts
        -json: Json
        +Mods()
        +addParseListener(hook: ParseListener)
        +buildFiles()
        +checkDependencies(toCheck: Seq<LoadedMod>, soft: boolean)
        +checkWarnings()
    }

    class ContentParser {
        ~currentContent: Content
        ~currentMod: LoadedMod
        ~contentTypes: ObjectMap<Class, ContentType>
        ~listeners: Seq<ParseListener>
        +field(type: Class, value: JsonValue): Object
        +attempt(run: Runnable)
        +checkNullFields(object: Object)
        +resolveController(type: String)
    }

    Mods *-- ContentParser : parser
}

' ============================
' NETWORKING
' ============================
package "mindustry.net" {
    class Administration {
        +playerInfo: ObjectMap<String, PlayerInfo>
        +actionFilters: Seq<ActionFilter>
        +kickedIPs: ObjectMap<String, Long>
        +dosBlacklist: ObjectSet<String>
        +Administration()
        +addActionFilter(filter: ActionFilter)
        +addChatFilter(filter: ChatFilter)
        +addNameBan(regex: String)
        +addSubnetBan(ip: String)
    }
}

' ============================
' SERVICE
' ============================
package "mindustry.service" {
    enum Achievement {
        active100Units
        active10Polys
        allBlocksErekir
        allBlocksSerpulo
        allTransportOneMap
    }
}

' ============================
' ANNOTATIONS (build-time)
' ============================
package "mindustry.annotations" {
    class BaseProcessor {
        #rootDirectory: Fi
        #env: RoundEnvironment
        #round: int
        #rounds: int
        +{static} elementu: Elements
        +elements(type: Class): Set
        +err(message: String)
        +err(message: String, elem: Element)
        +fields(type: Class): Set
    }
}

' ==================================
' INHERITANCE RELATIONSHIPS
' ==================================
Block --|> UnlockableContent
Floor --|> Block
UnitType --|> UnlockableContent
Planet --|> UnlockableContent
BulletType --|> Content

CoreBuild --|> "Building"
PayloadBlockBuild --|> "Building"

' ==================================
' INTERFACE IMPLEMENTATIONS
' ==================================
interface Senseable
interface UnitController
interface Loadable
interface ApplicationListener
interface Publishable
interface WorldGenerator

Block ..|> Senseable
UnitType ..|> Senseable
Tile ..|> "Position"
Tile ..|> "QuadTreeObject"

BuildingComp ..|> "Buildingc"
BuildingComp ..|> Senseable
BuildingComp ..|> "Controllable"

UnitComp ..|> Senseable
UnitComp ..|> "Unitc"
UnitComp ..|> "Weaponsc"

PlayerComp ..|> UnitController
PlayerComp ..|> "Syncc"

AIController ..|> UnitController
InputHandler ..|> "GestureListener"
MobileInput ..|> "GestureListener"

TurretBuild ..|> "ControlBlock"
CoreBuild ..|> "LaunchAnimator"

EntityGroup ..|> "Iterable"
ControlPathfinder ..|> "Runnable"
Ability ..|> "Cloneable"
Weapon ..|> "Cloneable"
BulletType ..|> "Cloneable"
GenerateFilter ..|> "Cloneable"
GenerateFilter ..|> "Serializable"
MapObjective ..|> "Serializable"
BasicGenerator ..|> WorldGenerator
Map ..|> Publishable
Map ..|> "Comparable"

Vars ..|> Loadable
UI ..|> ApplicationListener
UI ..|> Loadable
NetClient ..|> ApplicationListener
NetServer ..|> ApplicationListener
Renderer ..|> ApplicationListener
Mods ..|> Loadable
Schematics ..|> Loadable
BaseDialog --|> "Dialog"
LoadShader --|> "Shader"
BaseProcessor --|> "AbstractProcessor"

' ==================================
' COMPOSITION & ASSOCIATIONS
' ==================================
Block *-- "0..*" Consume : consumers
Block *-- DrawBlock : drawer
Block o-- "0..1" "ConsumePower" : consPower

UnitType *-- "0..*" Weapon : weapons
UnitType *-- "0..*" Ability : abilities
Weapon --> BulletType : bullet
Weapon --> Effect : ejectEffect

Turret --> BulletType : ammo
Turret --> Effect : shootEffect

UnitComp --> UnitController : controller
PlayerComp --> "Unit" : unit
PlayerComp --> Block : selectedBlock

BuildingComp *-- ItemModule : items
BuildingComp *-- "LiquidModule" : liquids

World *-- "0..*" Tile : tiles
Tile --> Block : floor/wall

ContentLoader --> Block : manages
ContentLoader --> BulletType : manages

Vars --> World : world
Vars --> UI : ui
Vars --> Renderer : renderer
Vars --> NetClient : netClient
Vars --> NetServer : netServer
Vars --> ContentLoader : content

Mods --> ContentLoader : loads into

Planet --> Rules : applyRules
PlanetDialog --> Planet : displays

CommandAI --> AIController : commandController

MapObjective *-- "0..*" MapObjective : children

BasicGenerator --> Block : floor/block/ore
BasicGenerator --> Tile : generates

LStatement ..> LInstruction : builds

@enduml
