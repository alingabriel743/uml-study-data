@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequence {
    ParticipantBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ArrowColor #495057
    LifeLineBorderColor #ADB5BD
    LifeLineBackgroundColor #E9ECEF
    GroupBackgroundColor #F1F3F5
    GroupBorderColor #6C757D
    DividerBackgroundColor #DEE2E6
}
skinparam sequenceMessageAlign center

title Mindustry — Combat Sequence: Turret Firing & Unit AI Attack

participant "Game Loop" as loop
participant "TurretBuild" as turret
participant "AIController" as ai
participant "Units" as units
participant "EntityGroup" as group
participant "Weapon" as weapon
participant "BulletType" as btype
participant "Bullet" as bullet
participant "Healthc\n(Target)" as target
participant "Effect" as effect

== Turret Combat Cycle ==

loop every game tick
    loop -> turret: updateTile()
    activate turret

    turret -> turret: validateTarget()

    alt has ammo & timer expired
        turret -> turret: findTarget()
        activate turret #E9ECEF
        turret -> turret: findEnemy(range)
        turret -> units: bestEnemy(team, x, y, range, predicate, sort)
        activate units
        units -> group: intersect(x, y, width, height)
        activate group
        group --> units: nearby entities
        deactivate group
        units --> turret: bestTarget
        deactivate units
        deactivate turret
    end

    alt target is valid & within shoot cone
        turret -> turret: turnToTarget(targetRot)
        turret -> turret: updateShooting()
        activate turret #E9ECEF

        alt reloadCounter >= reload & warmup ready
            turret -> turret: peekAmmo(): BulletType
            turret -> turret: shoot(type)
            activate turret #DEE2E6

            turret -> turret: ShootPattern.shoot(barrelCounter, handler)
            note right: Fires one or more\nprojectiles per pattern

            loop for each shot offset
                turret -> turret: bullet(type, xOffset, yOffset, angle, mover)
                activate turret #D6D8DB
                turret -> btype: create(owner, team, x, y, angle, damage, velScl, lifeScl, data, mover, aimX, aimY)
                activate btype
                btype -> bullet: Bullet.create()
                activate bullet
                bullet -> bullet: initVel(angle, speed)
                bullet -> bullet: set(x, y)
                bullet -> bullet: add()
                bullet --> btype: bullet
                deactivate bullet
                btype --> turret: bullet
                deactivate btype

                turret -> turret: handleBullet(bullet, offsetX, offsetY, angleOffset)

                turret -> effect: shootEffect.at(x, y, rotation, hitColor)
                activate effect
                effect -> effect: create(x, y, rotation, color, data)
                deactivate effect

                turret -> effect: smokeEffect.at(x, y, rotation, hitColor)
                activate effect
                deactivate effect
                deactivate turret
            end

            turret -> turret: useAmmo()
            deactivate turret
        end
        deactivate turret
    end

    deactivate turret
end

== Bullet Hit Resolution ==

loop -> bullet: update() [on collision]
activate bullet

bullet -> btype: hitEntity(bullet, entity, health)
activate btype

alt entity instanceof Healthc
    btype -> target: damage(damage)
    activate target
    target --> btype
    deactivate target
end

alt entity instanceof Unit
    btype -> target: impulse(knockback)
    activate target
    target --> btype
    deactivate target
    btype -> target: apply(status, statusDuration)
    activate target
    target --> btype
    deactivate target
end

btype -> btype: handlePierce(bullet, health, x, y)

btype --> bullet
deactivate btype

bullet -> btype: hit(bullet, x, y)
activate btype
btype -> effect: hitEffect.at(x, y, rotation, hitColor)
activate effect
effect -> effect: create(x, y, rotation, color, data)
deactivate effect
btype -> effect: shake(hitShake, hitShake, bullet)
activate effect
deactivate effect

opt fragOnHit & fragBullet != null
    btype -> btype: createFrags(bullet, x, y)
end

opt splashDamage > 0
    btype -> units: nearby(null, x, y, range, cons)
    activate units
    units -> group: intersect(x, y, width, height)
    activate group
    group --> units: nearby units
    deactivate group
    units --> btype
    deactivate units
end

btype --> bullet
deactivate btype

bullet -> bullet: remove()
deactivate bullet

== Unit AI Combat Cycle ==

loop every game tick
    loop -> ai: updateUnit()
    activate ai
    ai -> ai: updateVisuals()
    ai -> ai: updateTargeting()
    activate ai #E9ECEF
    ai -> ai: updateWeapons()
    activate ai #DEE2E6

    alt retarget timer expired
        ai -> ai: findMainTarget(x, y, range, air, ground)
        ai -> units: closestTarget(team, x, y, range, unitPred, tilePred)
        activate units
        units -> group: intersect(x, y, width, height)
        activate group
        group --> units: nearby entities
        deactivate group
        units --> ai: bestTarget
        deactivate units
    end

    loop for each WeaponMount
        ai -> weapon: update(unit, mount)
        activate weapon

        opt mount.target != null
            weapon -> weapon: findTarget(unit, x, y, range, air, ground)
            weapon -> units: closestTarget(team, x, y, range, pred, pred)
            activate units
            units --> weapon: target
            deactivate units
        end

        alt shoot conditions met (reload, warmup, cone)
            weapon -> weapon: shoot(unit, mount, shootX, shootY, rotation)
            activate weapon #E9ECEF

            loop for each shot in pattern
                weapon -> weapon: bullet(unit, mount, xOffset, yOffset, angle, mover)
                activate weapon #DEE2E6
                weapon -> btype: create(owner, shooter, team, x, y, angle, ...)
                activate btype
                btype -> bullet: Bullet.create()
                activate bullet
                bullet -> bullet: add()
                bullet --> btype: bullet
                deactivate bullet
                btype --> weapon: bullet
                deactivate btype

                weapon -> weapon: handleBullet(unit, mount, bullet)

                weapon -> effect: shootEffect.at(x, y, angle, hitColor)
                activate effect
                deactivate effect

                weapon -> effect: ejectEffect.at(x, y, angle)
                activate effect
                deactivate effect

                weapon -> effect: shake(shake, shake, x, y)
                activate effect
                deactivate effect
                deactivate weapon
            end

            deactivate weapon
        end

        weapon --> ai
        deactivate weapon
    end

    deactivate ai
    deactivate ai
    deactivate ai
end

@enduml
