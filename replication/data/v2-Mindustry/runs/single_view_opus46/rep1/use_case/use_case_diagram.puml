@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontSize 16
    FontStyle bold
}

title Mindustry — Use Case Diagram

left to right direction

actor "Player" as player
actor "Server\nAdmin" as admin
actor "AI System" as ai
actor "Mod\nDeveloper" as modder

rectangle "Mindustry" {

    ' ── Building & Construction ──
    usecase "Place & Remove\nBlocks" as UC_Build
    usecase "Build & Configure\nTurrets" as UC_Turret
    usecase "Use Schematics" as UC_Schem
    usecase "Manage Resources" as UC_Res

    ' ── Unit & Combat ──
    usecase "Command Units" as UC_Cmd
    usecase "Engage in Combat" as UC_Combat
    usecase "Use Unit Abilities" as UC_Ability
    usecase "Control Unit\nBehavior" as UC_AICtrl

    ' ── Logic System ──
    usecase "Program Logic\nBlocks" as UC_Logic

    ' ── Campaign & World ──
    usecase "Navigate Planet\nMap" as UC_Planet
    usecase "Complete Campaign\nObjectives" as UC_Obj
    usecase "Edit Maps" as UC_Editor

    ' ── Multiplayer ──
    usecase "Join Multiplayer\nGame" as UC_MP
    usecase "Send Chat\nMessages" as UC_Chat
    usecase "Manage Players" as UC_Admin
    usecase "Configure Game\nRules" as UC_Rules

    ' ── Modding ──
    usecase "Load Mods" as UC_Mods
    usecase "Parse Custom\nContent" as UC_Parse

    ' ── Achievements ──
    usecase "Earn Achievements" as UC_Achieve
}

' ── Player relationships ──
player --> UC_Build
player --> UC_Turret
player --> UC_Schem
player --> UC_Res
player --> UC_Cmd
player --> UC_Combat
player --> UC_Logic
player --> UC_Planet
player --> UC_Editor
player --> UC_MP
player --> UC_Achieve

' ── Server Admin relationships ──
admin --> UC_Admin
admin --> UC_Rules

' ── AI System relationships ──
ai --> UC_AICtrl
ai --> UC_Combat

' ── Mod Developer relationships ──
modder --> UC_Mods

' ── Include relationships ──
UC_Build ..> UC_Res : <<include>>
UC_Planet ..> UC_Obj : <<include>>
UC_Mods ..> UC_Parse : <<include>>
UC_Cmd ..> UC_AICtrl : <<include>>

' ── Extend relationships ──
UC_Turret ..> UC_Build : <<extend>>
UC_Schem ..> UC_Build : <<extend>>
UC_Chat ..> UC_MP : <<extend>>
UC_Ability ..> UC_Combat : <<extend>>

@enduml
