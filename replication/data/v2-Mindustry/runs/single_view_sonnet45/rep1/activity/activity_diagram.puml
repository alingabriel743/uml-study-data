@startuml
title Mindustry - Unit Command and Combat Activity Flow

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #495057
}
skinparam swimlane {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

|Player / InputHandler|
start
:Receive Player Input;
:commandUnits(player, unitIds,
buildTarget, unitTarget,
posTarget, queueCommand);

|AIController|
:Initialize Unit Controller;
if (Has unit target?) then (yes)
    :target(x, y, range, air, ground);
else (no)
    if (Has position target?) then (yes)
        :Set movement goal;
    else (no)
        :findMainTarget(x, y, range, air, ground);
        note right
            Search for enemies using:
            - Units.bestEnemy()
            - Units.closestTarget()
        end note
    endif
endif

:findTarget(x, y, range, air, ground);

if (Target found?) then (no)
    |Player / InputHandler|
    :Display "No Target";
    stop
else (yes)
    |AIController|
    :Calculate path to target;
    :moveTo(target, circleLength,
    smooth, keepDistance, offset, arrive);

    |ControlPathfinder|
    :initializePathRequest(request, team,
    costId, unitX, unitY, goalX, goalY);
    :innerAstar(team, cost, minX, minY,
    maxX, maxY, startPos, goalPos);
    :checkEdges(request, team, pathCost,
    current, goal, cx, cy, connections);

    |Unit / UnitComp|
    :controller(next);
    :Move along path;

    repeat
        :Update position;
        if (Reached target range?) then (yes)
            :Stop movement;
        else (no)
            :Continue moving;
        endif
    repeat while (In range?) is (no)

    |Weapon|
    :findTarget(unit, x, y, range, air, ground);
    :checkTarget(unit, target, x, y, range);

    if (Target valid?) then (yes)
        :Calculate bullet rotation;
        :bulletRotation(unit, mount, bulletX, bulletY);
        :shoot(unit, mount, shootX, shootY, rotation);

        |Turret / TurretBuild|
        :handleBullet(bullet, offsetX, offsetY, angleOffset);
        :bullet(type, xOffset, yOffset, angleOffset, mover);
        :control(LAccess.shoot, p1, p2, p3, p4);

        |BulletType|
        :create(owner, shooter, team, x, y,
        angle, damage, velocityScl, lifetimeScl);

        fork
            :Bullet trajectory calculation;
            :Update bullet position;

            repeat
                :Move bullet;
                if (Collision detected?) then (yes)
                    |Building / BuildingComp|
                    :Check if building hit;
                    if (Building in path?) then (yes)
                        |BulletType|
                        :hitEntity(bullet, entity, health);
                        |BuildingComp|
                        :damage(bullet, source, damage);
                        :acceptStack(item, amount, source);
                    endif
                else (no)
                    :Continue flight;
                endif
            repeat while (Lifetime remaining?) is (yes)

        fork again
            |Effect|
            :Create visual effect;
            :render(id, color, life, lifetime,
            rotation, x, y, data);
            :add(x, y, rotation, color, data);

        fork again
            |Drawf|
            :Render bullet graphics;
            :additive(region, color, alpha,
            x, y, rotation, layer, originX);
            :laser(line, start, end, x, y,
            x2, y2, scale);
        end fork

        |BulletType|
        if (Hit target?) then (yes)
            :hitEntity(bullet, entity, health);
            |Unit / UnitComp|
            if (Unit destroyed?) then (yes)
                :resetController();
                |UnitType|
                :Death animation;
                stop
            else (no)
                |AIController|
                :Continue combat;
            endif
        else (no)
            :Bullet expires;
        endif

    else (no)
        |AIController|
        :Wait for valid target;
    endif
endif

|InputHandler|
:createItemTransfer(item, amount, x, y, to, done);
:Update UI;
:drawSelection(x1, y1, x2, y2,
maxLength, col1, col2, withText);

stop

@enduml
