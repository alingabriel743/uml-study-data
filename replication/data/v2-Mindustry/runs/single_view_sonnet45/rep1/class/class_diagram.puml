' Interfaces
interface Senseable
interface Cloneable
interface Serializable
interface GestureListener
interface InputProcessor
interface UnitController
interface Displayable
interface Position
interface QuadTreeObject
interface ApplicationListener
interface Loadable
interface Runnable
interface Comparable
interface Publishable
interface WorldGenerator
interface LaunchAnimator
interface PlanetInterfaceRenderer
interface ControlBlock
interface Iterable

' Inheritance relationships
MappableContent <|-- UnlockableContent
UnlockableContent <|-- Block
UnlockableContent <|-- UnitType
UnlockableContent <|-- Planet
Block <|-- Floor
Block <|-- PowerBlock
PowerBlock <|-- PowerNode
ReloadTurret <|-- Turret
Building <|-- ReloadTurretBuild
ReloadTurretBuild <|-- TurretBuild
Building <|-- CoreBuild
Building <|-- PayloadBlockBuild
Dialog <|-- BaseDialog
BaseDialog <|-- PlanetDialog
InputHandler <|-- MobileInput
AIController <|-- CommandAI
Content <|-- BulletType
BlockModule <|-- ItemModule
Shader <|-- LoadShader
AbstractProcessor <|-- BaseProcessor

' Interface implementations
Block ..|> Senseable
UnitType ..|> Senseable
BulletType ..|> Cloneable
Weapon ..|> Cloneable
GenerateFilter ..|> Cloneable
GenerateFilter ..|> Serializable
MapObjective ..|> Serializable
Ability ..|> Cloneable
InputHandler ..|> GestureListener
InputHandler ..|> InputProcessor
MobileInput ..|> GestureListener
Tile ..|> Displayable
Tile ..|> Position
Tile ..|> QuadTreeObject
AIController ..|> UnitController
TurretBuild ..|> ControlBlock
CoreBuild ..|> LaunchAnimator
Vars ..|> Loadable
UI ..|> ApplicationListener
UI ..|> Loadable
Mods ..|> Loadable
Schematics ..|> Loadable
NetClient ..|> ApplicationListener
NetServer ..|> ApplicationListener
Renderer ..|> ApplicationListener
ControlPathfinder ..|> Runnable
Map ..|> Comparable
Map ..|> Publishable
PlanetDialog ..|> PlanetInterfaceRenderer
BasicGenerator ..|> WorldGenerator
EntityGroup ..|> Iterable

' Composition relationships
Block *-- Consume : has >
Block *-- DrawBlock : uses >
UnitType *-- Weapon : equipped with >
Weapon *-- BulletType : fires >
Turret o-- BulletType : uses >
TurretBuild o-- BulletType : fires >
Building o-- ItemModule : contains >
UnitComp o-- Weapon : has >
UnitComp o-- AIController : controlled by >
World *-- Tile : contains >
EntityGroup *-- QuadTree : spatially indexes >
PlayerComp o-- UnitController : implements >
CommandAI o-- AIController : delegates to >

' Dependencies
ContentLoader ..> Content : loads
ContentParser ..> Content : parses
Mods ..> ContentParser : uses
World ..> Map : loads
Schematics ..> CoreBlock : manages
Renderer ..> LaunchAnimator : uses
UI ..> BaseDialog : creates
NetServer ..> Administration : uses
Rules ..> Planet : references

@enduml
