@startuml
title Mindustry - Turret Combat Sequence

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

actor Player
participant "InputHandler" as input
participant "TurretBuild" as turret
participant "AIController" as ai
participant "Weapon" as weapon
participant "BulletType" as bulletType
participant "Bullet" as bullet
participant "BuildingComp" as target
participant "Effect" as effect
participant "Drawf" as drawf

== Initialization ==
Player -> input: touchDown(screenX, screenY, pointer, button)
activate input
input -> turret: control(LAccess.enabled, 1, 0, 0, 0)
activate turret
turret --> input: acknowledged
deactivate input

== Target Acquisition ==
turret -> ai: findMainTarget(x, y, range, air, ground)
activate ai
ai -> ai: findTarget(x, y, range, air, ground)
ai --> turret: targetEntity
deactivate ai

== Weapon Firing ==
turret -> weapon: shoot(unit, mount, shootX, shootY, rotation)
activate weapon
weapon -> weapon: bulletRotation(unit, mount, bulletX, bulletY)
weapon -> weapon: bullet(unit, mount, xOffset, yOffset, angleOffset, mover)
weapon -> bulletType: create(owner, shooter, team, x, y, angle, damage, velocityScl)
activate bulletType
bulletType -> bullet: <<create>>
activate bullet
bulletType --> weapon: bulletInstance
deactivate bulletType
weapon --> turret: fired
deactivate weapon

== Bullet Travel & Impact ==
bullet -> bullet: update()
bullet -> target: <<collision>>
activate target
bullet -> bulletType: hitEntity(bullet, entity, health)
activate bulletType
bulletType -> target: damage(bullet, source, damage)
target -> target: acceptStack(item, amount, source)
target --> bulletType: damageApplied
deactivate bulletType
deactivate target
deactivate bullet

== Visual Feedback ==
turret -> effect: at(x, y, rotation, color, data)
activate effect
effect -> effect: render(id, color, life, lifetime, rotation, x, y, data)
effect -> drawf: additive(region, color, alpha, x, y, rotation, layer, originX)
activate drawf
drawf --> effect: rendered
deactivate drawf
effect --> turret: effectDisplayed
deactivate effect

== Continuous Control ==
turret -> turret: handleBullet(bullet, offsetX, offsetY, angleOffset)

Player -> input: pan(x, y, deltaX, deltaY)
activate input
input -> drawf: construct(x, y, region, color, rotation, progress, alpha, time)
activate drawf
drawf --> input: selectionDrawn
deactivate drawf
input --> Player: viewUpdated
deactivate input

deactivate turret

@enduml
