@startuml
title Mindustry - Use Case Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

left to right direction

' Actors
actor "Player" as player
actor "Admin" as admin
actor "AI Controller" as ai
actor "Mod Developer" as moddev
actor "Network Server" as server

' System boundary
rectangle "Mindustry Game System" {

    ' Core Gameplay
    usecase "Initialize Game" as UC1
    usecase "Launch Game Session" as UC2

    ' Unit Management
    usecase "Control Units" as UC3
    usecase "Command Unit AI" as UC4
    usecase "Find and Target Enemies" as UC5
    usecase "Move Units" as UC6

    ' Building & Construction
    usecase "Place Buildings" as UC7
    usecase "Configure Blocks" as UC8
    usecase "Manage Build Plans" as UC9
    usecase "Construct Schematics" as UC10

    ' Combat System
    usecase "Fire Weapons" as UC11
    usecase "Control Turrets" as UC12
    usecase "Create Bullets" as UC13
    usecase "Handle Damage" as UC14

    ' Resource Management
    usecase "Manage Items" as UC15
    usecase "Handle Liquids" as UC16
    usecase "Process Payloads" as UC17
    usecase "Manage Core Storage" as UC18

    ' Map & World
    usecase "Generate Maps" as UC19
    usecase "Navigate World" as UC20
    usecase "Manage Sectors" as UC21
    usecase "Control Planets" as UC22

    ' Multiplayer
    usecase "Join Network Game" as UC23
    usecase "Synchronize Entities" as UC24
    usecase "Send/Receive Packets" as UC25
    usecase "Handle Player Actions" as UC26

    ' Administration
    usecase "Administer Players" as UC27
    usecase "Kick Players" as UC28
    usecase "Manage Permissions" as UC29

    ' Content & Modding
    usecase "Load Mods" as UC30
    usecase "Parse Custom Content" as UC31
    usecase "Manage Content Loader" as UC32

    ' UI & Interaction
    usecase "Display UI Dialogs" as UC33
    usecase "Handle Input Events" as UC34
    usecase "Show Planet Dialog" as UC35
    usecase "Configure Logic" as UC36

    ' Effects & Rendering
    usecase "Render Graphics" as UC37
    usecase "Apply Effects" as UC38
    usecase "Draw Custom Elements" as UC39
}

' Player relationships
player --> UC1
player --> UC2
player --> UC3
player --> UC6
player --> UC7
player --> UC8
player --> UC9
player --> UC10
player --> UC11
player --> UC15
player --> UC19
player --> UC20
player --> UC23
player --> UC33
player --> UC34
player --> UC35
player --> UC36

' AI Controller relationships
ai --> UC4
ai --> UC5
ai --> UC6

' Admin relationships
admin --> UC27
admin --> UC28
admin --> UC29
admin --|> player

' Mod Developer relationships
moddev --> UC30
moddev --> UC31

' Network Server relationships
server --> UC23
server --> UC24
server --> UC25
server --> UC26

' Include relationships
UC3 .> UC4 : <<include>>
UC3 .> UC6 : <<include>>
UC11 .> UC13 : <<include>>
UC12 .> UC11 : <<include>>
UC7 .> UC9 : <<include>>
UC10 .> UC7 : <<include>>
UC23 .> UC24 : <<include>>
UC23 .> UC25 : <<include>>
UC2 .> UC1 : <<include>>
UC19 .> UC20 : <<include>>
UC32 .> UC31 : <<include>>
UC30 .> UC32 : <<include>>

' Extend relationships
UC5 ..> UC3 : <<extend>>
UC14 ..> UC13 : <<extend>>
UC17 ..> UC15 : <<extend>>
UC16 ..> UC15 : <<extend>>
UC18 ..> UC15 : <<extend>>
UC22 ..> UC21 : <<extend>>
UC26 ..> UC25 : <<extend>>
UC38 ..> UC37 : <<extend>>
UC39 ..> UC37 : <<extend>>

@enduml
