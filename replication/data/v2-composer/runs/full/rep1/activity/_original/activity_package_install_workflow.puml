@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 13
}
skinparam note {
    BackgroundColor #D1ECF1
    BorderColor #0C5460
}

title Package Install Workflow\n(Composer Installer::run())

|Installer|
start
:Installer::run() invoked\n(composer install / composer update);

if (updateAllowList XOR updateMirrors both set?) then (yes)
    #FFB3B3:Throw RuntimeException\n(conflicting options);
    stop
else (no)
endif

if (Lock file present?\n(Locker::isLocked)) then (no)
    :Force update = true;
else (yes)
endif

if (dryRun = true?) then (yes)
    :Set verbose mode;\n:Disable scripts, operations,\nlock write, autoloader dump;
else (no)
endif

:Configure DownloadManager:\nsetPreferSource / setPreferDist\n/ setSourceFallback;

note right
  Script events dispatched here:\n  PRE_INSTALL_CMD or PRE_UPDATE_CMD\n  (if runScripts = true)
end note

if (update = true?) then (yes)

    |Solver / Locker|
    :Load repositories;\ncreate Policy & RepositorySet;
    :Solver::solve(request)\n→ produce lockTransaction;

    if (SolverProblemsException?) then (yes)
        #FFB3B3:Return ERROR_DEPENDENCY_RESOLUTION_FAILED (2);
        stop
    else (no)
    endif

    :extractDevPackages\n(second solver pass\nfor non-dev separation);
    :Locker::setLockData\n(write composer.lock);

    |Installer|
    if (doInstall = true?) then (yes)
        :Proceed to doInstall\n(alreadySolved = true);
    else (no)
        #D4EDDA:Return 0 (update only, no install);
        stop
    endif

else (no)
    |Installer|
endif

' === doInstall path ===

|Solver / Locker|
:Locker::getLockedRepository(devMode)\n→ load locked packages;
:Verify lock file platform compatibility\nvia Solver::solve (second run);

if (Lock incompatible or solver error?) then (yes)
    #FFB3B3:Return ERROR_LOCK_FILE_INVALID (4);
    stop
else (no)
endif

|Installer|
:LocalRepoTransaction computes diff\n(locked packages vs installed packages);

|EventDispatcher|
:dispatchInstallerEvent\n(PRE_OPERATIONS_EXEC);

|Installer|
if (executeOperations = true?) then (yes)

    |InstallationManager|
    :Split all operations into batches\n(composer-plugin with plugin-modifies-downloads\nisolated in first batch);

    repeat
        :downloadAndExecuteBatch();

        fork
            :For each install/update op:\nInstallerInterface::download(package)\n[async ReactPHP promise];
        fork again
            :Other operations queued;
        end fork

        :Loop::wait()\n(await all download promises;\noptional progress bar);

        if (downloadOnly = true?) then (yes)
            :runCleanup();
            #D4EDDA:Return (download-only mode);
            stop
        else (no)
        endif

        :Split batch again:\ncomposer-plugin / composer-installer\nisolated in own sub-batch\n(for correct activation order);

        repeat
            :executeBatch();

            |EventDispatcher|
            :dispatchPackageEvent\n(PRE_PACKAGE_INSTALL /\nPRE_PACKAGE_UPDATE /\nPRE_PACKAGE_UNINSTALL);

            |InstallationManager|
            :InstallerInterface::prepare(opType, package);
            :InstallerInterface::\ninstall() / update() / uninstall();
            :InstallerInterface::cleanup(opType, package);
            :InstalledRepository::write(devMode);

            |EventDispatcher|
            :dispatchPackageEvent\n(POST_PACKAGE_INSTALL /\nPOST_PACKAGE_UPDATE /\nPOST_PACKAGE_UNINSTALL);

        repeat while (more sub-batches?) is (yes)
        ->no;

    repeat while (more batches?) is (yes)
    ->no;

else (no)
    |Installer|
    :Output operation descriptions only\n(dry run / no-execute path);
endif

|Installer|
:InstallationManager::notifyInstalls(io);

if (dumpAutoloader = true?) then (yes)
    :AutoloadGenerator::dump()\n→ generate autoload files;
    if (strictPsrAutoloader AND PSR violations?) then (yes)
        #FFB3B3:Return ERROR_PSR_AUTOLOAD_VIOLATION (6);
        stop
    else (no)
    endif
else (no)
endif

:InstallationManager::ensureBinariesPresence\n(all local packages);
:Check abandoned packages\n→ io::writeError() warnings;

if (runScripts = true?) then (yes)
    |EventDispatcher|
    :dispatchScript\n(POST_INSTALL_CMD or POST_UPDATE_CMD);
    |Installer|
else (no)
endif

if (auditConfig.audit = true?) then (yes)
    :Auditor::audit(packages)\n→ check security advisories;
    if (Audit failed?) then (yes)
        #FFB3B3:Return ERROR_AUDIT_FAILED (5);
        stop
    else (no)
    endif
else (no)
endif

#D4EDDA:Return 0 (ERROR_NONE — success);
stop

@enduml
