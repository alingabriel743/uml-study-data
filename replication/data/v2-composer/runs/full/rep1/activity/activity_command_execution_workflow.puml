@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
    StartColor #28A745
    EndColor #DC3545
}
skinparam swimlane {
    BorderColor #495057
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Command Execution Workflow\n(BaseCommand Lifecycle — Composer CLI)

|CLI User|
start
:Invoke CLI command\n(e.g. install / update / require);

|Symfony Console / BaseCommand|
:BaseCommand::initialize(\n  InputInterface, OutputInterface);
:Read flags:\n  $disablePlugins = --no-plugins\n  $disableScripts = --no-scripts;

if (Application::getDisablePluginsByDefault()?) then (yes)
  :Force $disablePlugins = true;
endif

if (Application::getDisableScriptsByDefault()?) then (yes)
  :Force $disableScripts = true;
endif

if (Command is SelfUpdateCommand?) then (yes)
  :Force $disablePlugins = true\nForce $disableScripts = true;
endif

:Call tryComposer(\n  $disablePlugins, $disableScripts);

|Application / Factory|
:Application::getComposer(\n  required=false, ...);

if (Composer instance is null?) then (yes)
  :Factory::createGlobal(\n  $io, $disablePlugins, $disableScripts);
  :Return global Composer instance;
else (no)
  :Return cached Composer instance;
endif

|Symfony Console / BaseCommand|
if (Composer resolved successfully?) then (yes)
  :Dispatch PreCommandRunEvent\nvia EventDispatcher;
endif

:Apply environment variable overrides:\n  COMPOSER_NO_DEV\n  COMPOSER_PREFER_STABLE\n  COMPOSER_PREFER_LOWEST;

if (COMPOSER_IGNORE_PLATFORM_REQS set?) then (yes)
  :Apply platform requirement filter\n(ignoreAll / fromBoolOrList);
endif

:Call parent::initialize()\n(complete Symfony Console init);

:Symfony Console calls\nsubcommand::execute(\n  InputInterface, OutputInterface);

|Subcommand (InstallCommand / UpdateCommand)|
:Call requireComposer()\n→ get validated Composer instance;

|EventDispatcher|
:Dispatch CommandEvent(\n  PluginEvents::COMMAND,\n  commandName);

|Subcommand (InstallCommand / UpdateCommand)|
:Call Installer::create(\n  $io, $composer);

:Call getPreferredInstallOptions(\n  $config, $input)\n→ read 'preferred-install' config\n  + --prefer-source / --prefer-dist flags;

if (prefer-install option?) then (source)
  :Set preferSource = true;
else if (prefer-install option?) then (dist)
  :Set preferDist = true;
else (auto)
  :No source/dist preference;
endif

:Call createPolicyConfig(\n  $config, $input)\n→ PolicyConfig::fromConfig($config);

if (--no-blocking OR\n--no-security-blocking OR\nCOMPOSER_NO_BLOCKING?) then (yes)
  :policyConfig->withBlockingDisabled();
endif

:Call createAuditConfig($input)\n→ new AuditConfig(\n    audit, auditFormat);

:Configure Installer:\n  setPreferSource / setPreferDist\n  setOptimizeAutoloader\n  setClassMapAuthoritative\n  setPolicyConfig\n  setAuditConfig;

if (--no-plugins flag set?) then (yes)
  :Installer::disablePlugins();
endif

|Installer|
:$install->run()\n→ execute package operations;
:Return integer exit code;

|CLI User|
:Receive exit code\nfrom Symfony Console;
stop

@enduml
