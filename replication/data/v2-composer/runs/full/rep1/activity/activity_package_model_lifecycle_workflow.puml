@startuml
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
}
skinparam swimlane {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    TitleBackgroundColor #DEE2E6
}

title Package Model Lifecycle Workflow

|Caller|
start
:Decide package type;

if (Is alias package?) then (yes)

    |AliasPackage / CompleteAliasPackage|
    if (aliasOf is CompletePackage?) then (yes)
        :CompleteAliasPackage.__construct(\naliasOf: CompletePackage,\nversion, prettyVersion);
        note right: Delegates directly\nto AliasPackage constructor
    else (no)
        :AliasPackage.__construct(\naliasOf: BasePackage,\nversion, prettyVersion);
    endif
    :Copy name from aliasOf.getName();
    :Set $this->version, prettyVersion, aliasOf;

    |VersionParser|
    :parseStability(version)\nreturns: stable | RC | beta | alpha | dev;

    |AliasPackage / CompleteAliasPackage|
    :Set $this->stability and $this->dev flag;
    :foreach Link::$TYPES\n  $links = aliasOf->get{Type}();
    :replaceSelfVersionDependencies($links, $type);
    note right: Rewrites 'self.version' constraints\nwith the alias's actual version;\nsets hasSelfVersionRequires=true\nfor TYPE_REQUIRE

    if (Root package alias?) then (yes)
        :setRootPackageAlias(true);
    endif
    if (Dist / source mirrors needed?) then (yes)
        :setDistMirrors / setSourceMirrors\n→ delegates to aliasOf;
    endif
    if (Installation source to track?) then (yes)
        :setInstallationSource\n→ delegates to aliasOf;
    endif

else (no)

    |Package / CompletePackage|
    if (Is CompletePackage?) then (yes)
        :CompletePackage.__construct(\nname, version, prettyVersion);
        note right: Same constructor as Package;\nextra fields defaulted to null/[]:\nlicense, keywords, authors,\ndescription, homepage, scripts,\nsupport, funding, abandoned,\narchiveName, archiveExcludes
    else (no)
        :Package.__construct(\nname, version, prettyVersion);
    endif
    :BasePackage.__construct(name)\n→ sets $this->name;
    :Set $this->version and $this->prettyVersion;

    |VersionParser|
    :parseStability(version)\nreturns: stable | RC | beta | alpha | dev;

    |Package / CompletePackage|
    :Set $this->stability and $this->dev flag;

    if (Source metadata available?) then (yes)
        :setSourceType\n→ setSourceUrl\n→ setSourceReference\n→ setSourceMirrors;
    endif
    if (Dist metadata available?) then (yes)
        :setDistType\n→ setDistUrl\n→ setDistReference\n→ setDistSha1Checksum\n→ setDistMirrors;
    endif
    if (Dependency links to set?) then (yes)
        :setRequires;
        note right: If indexed array passed\n→ convertLinksToMap (deprecated);\ncallers must pass name-keyed maps
        :→ setConflicts → setProvides\n→ setReplaces → setDevRequires\n→ setSuggests;
    endif
    if (Autoload rules to set?) then (yes)
        :setAutoload (psr-0 / psr-4 / classmap / files)\n→ setDevAutoload → setIncludePaths;
    endif
    if (Is CompletePackage with metadata?) then (yes)
        :setLicense → setKeywords → setAuthors\n→ setDescription → setHomepage\n→ setSupport → setFunding\n→ setAbandoned → setScripts\n→ setRepositories → setArchiveName\n→ setArchiveExcludes;
    endif
    if (Version replacement needed?) then (yes)
        :Package::replaceVersion(\nnewVersion, newPrettyVersion);
        |VersionParser|
        :parseStability(newVersion);
        |Package / CompletePackage|
        :Update version, prettyVersion,\nstability, dev flag;
    endif
    if (Reference update needed?) then (yes)
        :Package::setSourceDistReferences(ref);
        :setSourceReference(ref);
        if (distUrl matches GitHub / Bitbucket / GitLab?) then (yes)
            :setDistReference(ref)\n+ patch SHA in distUrl via Preg regex;
        elseif (distReference already set?) then (yes)
            :setDistReference(ref) only;
        else (no)
            :Skip dist URL update;
        endif
    endif

endif

|Caller|
if (URL resolution requested?) then (yes)
    fork
        :getDistUrls\n→ getUrls(distUrl, distMirrors,\ndistRef, distType, 'dist');
    fork again
        :getSourceUrls\n→ getUrls(sourceUrl, sourceMirrors,\nsourceRef, sourceType, 'source');
    end fork
    if (Base URL present?) then (yes)
        if (urlType = dist AND URL contains '%'?) then (yes)
            :ComposerMirror::processUrl(\nurl, name, version, ref,\ntype, prettyVersion);
        endif
        :Start URL list = [baseUrl];
        repeat
            :Compute mirrorUrl via\nprocessUrl / processGitUrl / processHgUrl;
            if (mirror.preferred?) then (yes)
                :array_unshift — prepend mirrorUrl;
            else (no)
                :array_push — append mirrorUrl;
            endif
        repeat while (more mirrors?)
        :Return ordered URL list;
    else (no)
        :Return empty array [];
    endif
endif

stop
@enduml
