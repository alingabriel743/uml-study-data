{
  "scope": "dependency_resolution_workflow",
  "title": "Dependency Resolution Workflow",
  "diagram_type": "activity",
  "key_participants": [
    "Installer",
    "RepositoryManager",
    "RepositorySet",
    "Request",
    "Pool",
    "Solver",
    "Decisions",
    "LockTransaction",
    "ArrayRepository",
    "DefaultPolicy",
    "RuleSetGenerator"
  ],
  "entry_point": "Installer::run(): int",
  "main_flow": [
    "START: Installer::run() called",
    "DECISION: $this->update == true? → branch to doUpdate / doInstall",
    "── UPDATE PATH: Installer::doUpdate(InstalledRepositoryInterface $localRepo, bool $doInstall): int",
    "  1. createPlatformRepo(true) → PlatformRepository",
    "  2. getRootAliases(true) → $aliases[]",
    "  3. locker->isLocked()? → getLockedRepository(true) → LockArrayRepository",
    "  4. createPolicy(true, $lockedRepository) → DefaultPolicy",
    "  5. createRepositorySet(true, $platformRepo, $aliases) → RepositorySet  [builds minimumStability, stabilityFlags, rootRequires]",
    "  6. repositoryManager->getRepositories() → loop: repositorySet->addRepository($repo)",
    "  7. lockedRepository != null? → repositorySet->addRepository($lockedRepository)",
    "  8. createRequest($fixedRootPackage, $platformRepo, $lockedRepository) → Request  [fixPackage(rootPackage), fixPackage(platformPackages), requirePackage(rootRequires)]",
    "  9. request->setUpdateAllowList($updateAllowList, $updateAllowTransitiveDependencies)  [if partial update]",
    "  10. repositorySet->createPool($request, $io, $eventDispatcher, ...) → Pool  [PoolBuilder loads packages from repositories]",
    "  11. new Solver($policy, $pool, $io)",
    "  12. solver->solve($request, $platformRequirementFilter) → LockTransaction",
    "      12a. setupFixedMap($request)",
    "      12b. RuleSetGenerator->getRulesFor($request, $platformRequirementFilter) → RuleSet",
    "      12c. checkForRootRequireProblems($request, $platformRequirementFilter)",
    "      12d. new Decisions($pool)",
    "      12e. new RuleWatchGraph → insert RuleWatchNode for each rule",
    "      12f. makeAssertionRuleDecisions()  [decisions->decide(literal, level, rule)]",
    "      12g. runSat()  [DPLL SAT solver; propagate → conflict? → backtrack/learn]",
    "      12h. problems > 0? → throw SolverProblemsException",
    "      12i. return new LockTransaction($pool, presentMap, fixedPackagesMap, $decisions)",
    "  13. SolverProblemsException caught? → log error, return ERROR_DEPENDENCY_RESOLUTION_FAILED",
    "  14. lockTransaction->getOperations() empty? → log 'Nothing to modify'",
    "  15. extractDevPackages($lockTransaction, $platformRepo, $aliases, $policy, $lockedRepository): int",
    "      15a. package->getDevRequires() empty? → return 0 (skip)",
    "      15b. new ArrayRepository([])  [result repo from non-dev lock packages]",
    "      15c. lockTransaction->getNewLockPackages(false) → loop: ArrayRepository->addPackage(loaded pkg)",
    "      15d. createRepositorySet(true, $platformRepo, $aliases) → new RepositorySet",
    "      15e. repositorySet->addRepository($resultRepo)",
    "      15f. createRequest($fixedRootPackage, $platformRepo)  [no locked repo — non-dev only]",
    "      15g. repositorySet->createPoolWithAllPackages() → Pool",
    "      15h. new Solver($policy, $pool, $io)",
    "      15i. solver->solve($request, $platformRequirementFilter) → nonDevLockTransaction",
    "      15j. SolverProblemsException? → return ERROR_DEPENDENCY_RESOLUTION_FAILED",
    "      15k. lockTransaction->setNonDevPackages(nonDevLockTransaction)",
    "      15l. return 0",
    "  16. extractPlatformRequirements() → $platformReqs, $platformDevReqs",
    "  17. Classify operations: InstallOperation / UpdateOperation / UninstallOperation",
    "  18. locker->setLockData(getNewLockPackages(false), getNewLockPackages(true), platformReqs, platformDevReqs, aliases, ...) → write lock file",
    "  19. doInstall == true? → call Installer::doInstall($localRepo, alreadySolved=true)",
    "── INSTALL PATH: Installer::doInstall(InstalledRepositoryInterface $localRepo, bool $alreadySolved): int",
    "  1. alreadySolved == false → createRepositorySet(false, $platformRepo, [], $lockedRepository) using locker stability data",
    "  2. createRequest from locked packages (constraint '=' per version)",
    "  3. repositorySet->createPool($request, ...) → Pool",
    "  4. new Solver($policy, $pool, $io) → solver->solve() → LockTransaction",
    "  5. lockTransaction->getOperations() not empty? → warn 'lock file not in sync'",
    "  6. new LocalRepoTransaction($localRepo, $lockTransaction) → compute install/update/uninstall ops",
    "  7. Execute operations via InstallationManager",
    "END"
  ],
  "key_relationships": [
    "Installer depends_on RepositoryManager (getRepositories, getLocalRepository)",
    "Installer creates RepositorySet (via createRepositorySet)",
    "Installer creates Request (via createRequest)",
    "RepositorySet creates Pool (createPool / createPoolWithAllPackages using PoolBuilder)",
    "Installer creates Solver(policy, pool, io)",
    "Solver creates Decisions(pool)",
    "Solver creates RuleSetGenerator → RuleSet",
    "Solver creates RuleWatchGraph",
    "Solver::solve returns LockTransaction(pool, presentMap, fixedPackagesMap, decisions)",
    "LockTransaction extends Transaction",
    "Installer::extractDevPackages creates ArrayRepository to hold non-dev result packages",
    "ArrayRepository implements RepositoryInterface (loadPackages, findPackage, addPackage)",
    "Locker provides getLockedRepository() → LockArrayRepository used as lockedRepository input"
  ],
  "branching_conditions": [
    "$this->update == true → doUpdate path; else doInstall path",
    "$this->locker->isLocked() → load lockedRepository; else null",
    "$this->updateAllowList != null → setUpdateAllowList on request (partial update)",
    "$this->dryRun == true → verbose=true, runScripts=false, executeOperations=false, writeLock=false",
    "SolverProblemsException thrown → return ERROR_DEPENDENCY_RESOLUTION_FAILED (code 2)",
    "lockTransaction->getOperations() empty → log 'Nothing to modify'",
    "package->getDevRequires() empty → skip extractDevPackages",
    "doInstall == true (in doUpdate) → chain to doInstall after writing lock",
    "alreadySolved == true (in doInstall) → skip re-solving, use existing lockTransaction"
  ],
  "important_notes": "SAT solver (DPLL) in Solver::runSat(). Two solver passes: (1) full update in doUpdate, (2) dev-package extraction via extractDevPackages using ArrayRepository populated from first pass result. LockTransaction wraps Decisions to produce install/update/uninstall operations. PoolBuilder (via RepositorySet::createPool) lazy-loads packages from repositories only as needed by the request.",
  "error_codes": {
    "ERROR_NONE": 0,
    "ERROR_GENERIC_FAILURE": 1,
    "ERROR_DEPENDENCY_RESOLUTION_FAILED": 2,
    "ERROR_NO_LOCK_FILE_FOR_PARTIAL_UPDATE": 3,
    "ERROR_LOCK_FILE_INVALID": 4,
    "ERROR_AUDIT_FAILED": 5
  },
  "source_files_analyzed": [
    "src/src/Composer/Installer.php",
    "src/src/Composer/Repository/ArrayRepository.php",
    "src/src/Composer/DependencyResolver/Solver.php",
    "src/src/Composer/DependencyResolver/Decisions.php",
    "src/src/Composer/DependencyResolver/LockTransaction.php"
  ]
}
