@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Command Layer

namespace Symfony.Component.Console.Command {
  abstract class Command {
    +configure(): void
    +execute(input, output): int
    +run(input, output): int
  }
}

package "Composer\\Command" {

  package "Base Commands" #D6EAF8 {

    abstract class BaseCommand {
      -$composer: Composer|null
      -$io: IOInterface
      +getApplication(): Application
      +requireComposer(?disablePlugins, ?disableScripts): Composer
      +tryComposer(?disablePlugins, ?disableScripts): ?Composer
      +setComposer(Composer): void
      +resetComposer(): void
      +getIO(): IOInterface
      +setIO(IOInterface): void
      +isProxyCommand(): bool
      +complete(input, suggestions): void
      #initialize(input, output): void
      #createComposerInstance(input, io, config, ...): Composer
      #getPreferredInstallOptions(config, input): bool[]
      #getPlatformRequirementFilter(input): PlatformRequirementFilterInterface
      #formatRequirements(array): array
      #getAuditFormat(input, optName): string
      #createPolicyConfig(config, input): PolicyConfig
      #createAuditConfig(input): AuditConfig
    }

    abstract class BaseConfigCommand {
      #$config: Config
      #$configFile: JsonFile
      #$configSource: JsonConfigSource
      #initialize(input, output): void
      #getComposerConfigFile(input, config): string
      #getAuthConfigFile(input, config): string
    }

    abstract class BaseDependencyCommand {
      #execute(input, output): int
    }
  }

  package "Config Commands" #D5F5E3 {

    class ConfigCommand {
      #CONFIGURABLE_PACKAGE_PROPERTIES: string[]
      #$authConfigFile: JsonFile
      #$authConfigSource: JsonConfigSource
      +configure(): void
      #execute(input, output): int
    }

    class RepositoryCommand {
      ' command: repositories
    }

    class PolicyCommand {
      ' command: policy
    }
  }

  package "Dependency Commands" #FDEBD0 {

    class DependsCommand {
      ' command: depends
    }

    class ProhibitsCommand {
      ' command: prohibits
    }
  }

  package "Package Management Commands" #EBF5FB {

    class RequireCommand {
      -$newlyCreated: bool
      -$firstRequire: bool
      -$json: JsonFile
      -$file: string
      -$composerBackup: string
      -$lockBackup: ?string
      -$dependencyResolutionCompleted: bool
      +configure(): void
      #execute(input, output): int
    }

    class UpdateCommand {
      +configure(): void
      #execute(input, output): int
    }

    class InstallCommand {
      +configure(): void
      #execute(input, output): int
    }

    class RemoveCommand {
      ' command: remove (alias: rm)
    }

    class AuditCommand {
      ' command: audit
    }

    class BumpCommand <<final>> {
      ' command: bump
    }
  }

  package "Project Commands" #F9EBEA {

    class InitCommand {
      ' command: init
    }

    class CreateProjectCommand {
      ' command: create-project
    }

    class DiagnoseCommand {
      ' command: diagnose
    }

    class ReinstallCommand {
      ' command: reinstall
    }
  }

  package "Information Commands" #FAD7A0 {

    class ShowCommand {
      #$versionParser: VersionParser
      #$colors: string[]
      -$repositorySet: ?RepositorySet
      +configure(): void
      #execute(input, output): int
    }

    class OutdatedCommand {
      ' command: outdated
    }

    class SearchCommand {
      ' command: search
    }

    class LicensesCommand {
      ' command: licenses
    }

    class SuggestsCommand {
      ' command: suggests
    }

    class HomeCommand {
      ' command: home
    }

    class FundCommand {
      ' command: fund
    }
  }

  package "Utility Commands" #E8DAEF {

    class ArchiveCommand {
      ' command: archive
    }

    class GlobalCommand {
      ' command: global
    }

    class RunScriptCommand {
      ' command: run-script
    }

    class ScriptAliasCommand {
      ' command: (script aliases)
    }

    class StatusCommand {
      ' command: status
    }

    class ValidateCommand {
      ' command: validate
    }

    class CheckPlatformReqsCommand {
      ' command: check-platform-reqs
    }

    class ClearCacheCommand {
      ' command: clear-cache
    }

    class DumpAutoloadCommand {
      ' command: dump-autoload
    }

    class ExecCommand {
      ' command: exec
    }

    class AboutCommand {
      ' command: about
    }

    class SelfUpdateCommand {
      ' command: self-update
    }
  }

  package "Traits" #F5EEF8 {
    class CompletionTrait <<Trait>> {
      +suggestPackageBasedOnMode(input, suggestions): void
      +suggestInstalledPackage(input, suggestions): void
    }

    class PackageDiscoveryTrait <<Trait>> {
      +findBestVersionAndNameForPackage(io, name, ...): array
    }
  }

}

' ─────────────────── Inheritance ───────────────────

BaseCommand                --|> Symfony.Component.Console.Command.Command
BaseConfigCommand          --|> BaseCommand
BaseDependencyCommand      --|> BaseCommand

ConfigCommand              --|> BaseConfigCommand
RepositoryCommand          --|> BaseConfigCommand
PolicyCommand              --|> BaseConfigCommand

DependsCommand             --|> BaseDependencyCommand
ProhibitsCommand           --|> BaseDependencyCommand

ShowCommand                --|> BaseCommand
RequireCommand             --|> BaseCommand
UpdateCommand              --|> BaseCommand
InstallCommand             --|> BaseCommand
RemoveCommand              --|> BaseCommand
AuditCommand               --|> BaseCommand
BumpCommand                --|> BaseCommand

InitCommand                --|> BaseCommand
CreateProjectCommand       --|> BaseCommand
DiagnoseCommand            --|> BaseCommand
ReinstallCommand           --|> BaseCommand

OutdatedCommand            --|> BaseCommand
SearchCommand              --|> BaseCommand
LicensesCommand            --|> BaseCommand
SuggestsCommand            --|> BaseCommand
HomeCommand                --|> BaseCommand
FundCommand                --|> BaseCommand

ArchiveCommand             --|> BaseCommand
GlobalCommand              --|> BaseCommand
RunScriptCommand           --|> BaseCommand
ScriptAliasCommand         --|> BaseCommand
StatusCommand              --|> BaseCommand
ValidateCommand            --|> BaseCommand
CheckPlatformReqsCommand   --|> BaseCommand
ClearCacheCommand          --|> BaseCommand
DumpAutoloadCommand        --|> BaseCommand
ExecCommand                --|> BaseCommand
AboutCommand               --|> BaseCommand
SelfUpdateCommand          --|> BaseCommand

' ─────────────────── Trait Usage ───────────────────

ShowCommand          ..> CompletionTrait          : <<uses>>
RequireCommand       ..> CompletionTrait          : <<uses>>
UpdateCommand        ..> CompletionTrait          : <<uses>>
InstallCommand       ..> CompletionTrait          : <<uses>>
RemoveCommand        ..> CompletionTrait          : <<uses>>
InitCommand          ..> CompletionTrait          : <<uses>>
BumpCommand          ..> CompletionTrait          : <<uses>>
ArchiveCommand       ..> CompletionTrait          : <<uses>>
OutdatedCommand      ..> CompletionTrait          : <<uses>>
DependsCommand       ..> CompletionTrait          : <<uses>>
ProhibitsCommand     ..> CompletionTrait          : <<uses>>
CreateProjectCommand ..> CompletionTrait          : <<uses>>
ReinstallCommand     ..> CompletionTrait          : <<uses>>
HomeCommand          ..> CompletionTrait          : <<uses>>
SuggestsCommand      ..> CompletionTrait          : <<uses>>

RequireCommand       ..> PackageDiscoveryTrait    : <<uses>>
InitCommand          ..> PackageDiscoveryTrait    : <<uses>>

@enduml
