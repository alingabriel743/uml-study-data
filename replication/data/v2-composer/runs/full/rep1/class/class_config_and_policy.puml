@startuml class_config_and_policy

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Config and Policy

package "Composer" {

    class Config {
        +{static} SOURCE_DEFAULT: string
        +{static} SOURCE_COMMAND: string
        +{static} SOURCE_UNKNOWN: string
        +{static} RELATIVE_PATHS: int
        -{static} $defaultConfig: array
        -{static} $defaultRepositories: array
        -$config: array
        -$baseDir: ?string
        -$repositories: array
        -$configSource: ConfigSourceInterface
        -$authConfigSource: ConfigSourceInterface
        -$localAuthConfigSource: ?ConfigSourceInterface
        -$useEnvironment: bool
        -$sourceOfConfigValue: array
        +__construct(bool $useEnvironment, ?string $baseDir)
        +setBaseDir(?string): void
        +setConfigSource(ConfigSourceInterface): void
        +getConfigSource(): ConfigSourceInterface
        +setAuthConfigSource(ConfigSourceInterface): void
        +getAuthConfigSource(): ConfigSourceInterface
        +setLocalAuthConfigSource(ConfigSourceInterface): void
        +getLocalAuthConfigSource(): ?ConfigSourceInterface
        +merge(array $config, string $source): void
        +getRepositories(): array
        +get(string $key, int $flags): mixed
        +all(int $flags): array
        +has(string $key): bool
        +raw(): array
        +prohibitUrlByConfig(string $url, ?IOInterface $io, array $repoOptions): void
        +{static} disableProcessTimeout(): void
        -process($value, int $flags): mixed
        -getComposerEnv(string $var): string|false
    }

}

package "Composer\\Config" {

    interface ConfigSourceInterface {
        +addRepository(string $name, array|false $config, bool $append): void
        +insertRepository(string $name, array|false $config, string $referenceName, int $offset): void
        +setRepositoryUrl(string $name, string $url): void
        +removeRepository(string $name): void
        +addConfigSetting(string $name, mixed $value): void
        +removeConfigSetting(string $name): void
        +addProperty(string $name, string|string[] $value): void
        +removeProperty(string $name): void
        +addLink(string $type, string $name, string $value): void
        +removeLink(string $type, string $name): void
        +getName(): string
    }

    class JsonConfigSource {
        -$file: JsonFile
        -$authConfig: bool
        +__construct(JsonFile $file, bool $authConfig)
        +getName(): string
        +addRepository(string, array|false, bool): void
        +insertRepository(string, array|false, string, int): void
        +setRepositoryUrl(string, string): void
        +removeRepository(string): void
        +addConfigSetting(string, mixed): void
        +removeConfigSetting(string): void
        +addProperty(string, string|string[]): void
        +removeProperty(string): void
        +addLink(string, string, string): void
        +removeLink(string, string): void
        -manipulateJson(string $method, callable $fallback, ...$args): void
    }

}

package "Composer\\Advisory" {

    class AuditConfig <<readonly>> {
        +$audit: bool
        +$auditFormat: string
        +__construct(bool $audit, string $auditFormat)
    }

}

package "Composer\\Policy" {

    class PolicyConfig <<final readonly>> {
        +{static} RESERVED_NAMES: string[]
        +{static} BUILTIN_LIST_NAMES: string[]
        +{static} FUTURE_RESERVED_PREFIXES: string[]
        +{static} NON_LIST_KEYS: string[]
        +$enabled: bool
        +$advisories: AdvisoriesPolicyConfig
        +$malware: MalwarePolicyConfig
        +$abandoned: AbandonedPolicyConfig
        +$customLists: array
        +$ignoreUnreachable: IgnoreUnreachable
        +__construct(bool, AdvisoriesPolicyConfig, MalwarePolicyConfig, ListPolicyConfig, array, IgnoreUnreachable)
        +{static} fromConfig(Config $config): self
        +getAllLists(): array
        +getActiveAuditFilterLists(): array
        +getActiveBlockFilterLists(string $blockScope): array
        +getCustomListsWithSources(): array
        +withBlockingDisabled(): self
        +withIgnoreUnreachable(string ...$scopes): self
        +withIgnoreSeverity(list): self
        +withAudit(?string $abandoned, ?string $filtered): static
    }

    abstract class ListPolicyConfig <<readonly>> {
        +{static} AUDIT_IGNORE: string
        +{static} AUDIT_REPORT: string
        +{static} AUDIT_FAIL: string
        +{static} BLOCK_SCOPE_UPDATE: string
        +{static} BLOCK_SCOPE_INSTALL: string
        +{static} BLOCK_SCOPE_ALL: string
        +$name: string
        +$block: bool
        +$audit: string
        +$ignore: array
        +__construct(string $name, bool $block, string $audit, array $ignore)
        +shouldBlock(string $blockScope): bool
        +getIgnoreForOperation(string $operation): array
        +getFlatIgnoreForOperation(string $operation): array
        +{abstract} withBlockingDisabled(): static
        +{abstract} withAudit(string $audit): static
        #supportsInstallBlockScope(): bool
    }

    class AdvisoriesPolicyConfig <<final readonly>> {
        +{static} NAME: string
        +$ignoreId: array
        +$ignoreSeverity: array
        +__construct(bool $block, string $audit, array $ignore, array $ignoreId, array $ignoreSeverity)
        +getIgnoreIdForOperation(string): array
        +getIgnoreListForOperation(string): array
        +getIgnoreSeverityForOperation(string): array
        +withBlockingDisabled(): static
        +withAudit(string): static
        +withIgnoreSeverity(list): static
        +{static} fromRawConfig(array $policyConfig, array $auditConfig, VersionParser): self
        +{static} disabled(): self
    }

    class AbandonedPolicyConfig <<final readonly>> {
        +{static} NAME: string
        +__construct(bool $block, string $audit, array $ignore)
        +withBlockingDisabled(): static
        +withAudit(string): static
        +{static} fromRawConfig(array $policyConfig, array $auditConfig, VersionParser): self
        +{static} disabled(): self
    }

    class MalwarePolicyConfig <<final>> {
        +{static} NAME: string
        +$blockScope: string
        +$ignoreSource: array
        +__construct(bool $block, string $audit, string $blockScope, array $ignore, array $ignoreSource)
        +shouldBlock(string $blockScope): bool
        +withBlockingDisabled(): static
        +withAudit(string): static
        +{static} fromRawConfig(array, VersionParser): self
        +{static} disabled(): self
        #supportsInstallBlockScope(): bool
    }

    class CustomListPolicyConfig <<internal>> {
        +$sources: array
        +__construct(string $name, bool $block, string $audit, array $ignore, array $sources)
        +withBlockingDisabled(): static
        +withAudit(string): static
        +{static} fromRawConfig(string $name, mixed $listConfig, VersionParser): self
    }

    class IgnorePackageRule <<readonly>> {
        +$packageName: string
        +$constraint: ConstraintInterface
        +$reason: ?string
        +$onBlock: bool
        +$onAudit: bool
        +$packageNameRegex: ?string
        +__construct(string $packageName, ConstraintInterface $constraint, ?string $reason, bool $onBlock, bool $onAudit)
        +{static} parseIgnoreMap(array, VersionParser): array
        +{static} filterByOperation(array, string): array
    }

    class IgnoreIdRule <<readonly>> {
        +$id: string
        +$reason: ?string
        +$onBlock: bool
        +$onAudit: bool
        +__construct(string $id, ?string $reason, bool $onBlock, bool $onAudit)
        +{static} parseIgnoreIdMap(array): array
    }

    class IgnoreSeverityRule <<readonly>> {
        +$severity: string
        +$reason: ?string
        +$onBlock: bool
        +$onAudit: bool
        +__construct(string $severity, ?string $reason, bool $onBlock, bool $onAudit)
        +{static} parseIgnoreSeverityMap(array): array
    }

    class IgnoreUnreachable {
        +{static} default(): self
        +{static} all(): self
        +{static} fromRawPolicyConfig(array): self
        +{static} fromRawAuditConfig(array): self
        +with(string ...$scopes): self
    }

}

' Relationships — Config and ConfigSource
Config o-- ConfigSourceInterface : $configSource\n$authConfigSource\n$localAuthConfigSource

JsonConfigSource ..|> ConfigSourceInterface
JsonConfigSource *-- "1" JsonFile : $file

' PolicyConfig ← Config factory
PolicyConfig ..> Config : fromConfig(Config)

' PolicyConfig aggregates policy sub-configs
PolicyConfig *-- "1" AdvisoriesPolicyConfig : $advisories
PolicyConfig *-- "1" MalwarePolicyConfig : $malware
PolicyConfig *-- "1" AbandonedPolicyConfig : $abandoned
PolicyConfig *-- "0..*" CustomListPolicyConfig : $customLists
PolicyConfig *-- "1" IgnoreUnreachable : $ignoreUnreachable

' Inheritance: ListPolicyConfig subclasses
AdvisoriesPolicyConfig --|> ListPolicyConfig
AbandonedPolicyConfig --|> ListPolicyConfig
MalwarePolicyConfig --|> ListPolicyConfig
CustomListPolicyConfig --|> ListPolicyConfig

' ListPolicyConfig aggregates ignore rules
ListPolicyConfig o-- "0..*" IgnorePackageRule : $ignore
AdvisoriesPolicyConfig o-- "0..*" IgnoreIdRule : $ignoreId
AdvisoriesPolicyConfig o-- "0..*" IgnoreSeverityRule : $ignoreSeverity

@enduml
