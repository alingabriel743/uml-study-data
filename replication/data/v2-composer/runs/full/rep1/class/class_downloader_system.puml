@startuml class_downloader_system

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Downloader System — Composer\\Downloader

package "Composer\\Downloader" {

    interface DownloaderInterface {
        +getInstallationSource(): string
        +download(PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
        +prepare(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
        +install(PackageInterface $package, string $path): PromiseInterface
        +update(PackageInterface $initial, PackageInterface $target, string $path): PromiseInterface
        +remove(PackageInterface $package, string $path): PromiseInterface
        +cleanup(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
    }

    interface ChangeReportInterface {
        +getLocalChanges(PackageInterface $package, string $path): ?string
    }

    interface VcsCapableDownloaderInterface {
        +getVcsReference(PackageInterface $package, string $path): ?string
    }

    interface DvcsDownloaderInterface {
        +getUnpushedChanges(PackageInterface $package, string $path): ?string
    }

    class FileDownloader {
        #io: IOInterface
        #config: Config
        #httpDownloader: HttpDownloader
        #filesystem: Filesystem
        #cache: ?Cache
        #eventDispatcher: ?EventDispatcher
        #process: ProcessExecutor
        +{static} downloadMetadata: array
        +{static} responseHeaders: array
        -lastCacheWrites: array
        -additionalCleanupPaths: array
        +__construct(IOInterface $io, Config $config, HttpDownloader $httpDownloader, ?EventDispatcher $eventDispatcher, ?Cache $cache, ?Filesystem $filesystem, ?ProcessExecutor $process)
        +getInstallationSource(): string
        +download(PackageInterface $package, string $path, ?PackageInterface $prevPackage, bool $output): PromiseInterface
        +prepare(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
        +install(PackageInterface $package, string $path, bool $output): PromiseInterface
        +update(PackageInterface $initial, PackageInterface $target, string $path): PromiseInterface
        +remove(PackageInterface $package, string $path, bool $output): PromiseInterface
        +getLocalChanges(PackageInterface $package, string $path): ?string
        +cleanup(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
        #getFileName(PackageInterface $package, string $path): string
        #getDistPath(PackageInterface $package, int $component): string
        #processUrl(PackageInterface $package, string $url): string
        #getInstallOperationAppendix(PackageInterface $package, string $path): string
        #clearLastCacheWrite(PackageInterface $package): void
        #addCleanupPath(PackageInterface $package, string $path): void
        #removeCleanupPath(PackageInterface $package, string $path): void
    }

    abstract class VcsDownloader {
        #io: IOInterface
        #config: Config
        #process: ProcessExecutor
        #filesystem: Filesystem
        #hasCleanedChanges: array
        +__construct(IOInterface $io, Config $config, ?ProcessExecutor $process, ?Filesystem $fs)
        +getInstallationSource(): string
        +download(PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
        +prepare(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
        +install(PackageInterface $package, string $path): PromiseInterface
        +update(PackageInterface $initial, PackageInterface $target, string $path): PromiseInterface
        +remove(PackageInterface $package, string $path): PromiseInterface
        +getVcsReference(PackageInterface $package, string $path): ?string
        +cleanup(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage): PromiseInterface
        #cleanChanges(PackageInterface $package, string $path, bool $update): PromiseInterface
        #reapplyChanges(string $path): void
        -{abstract} prepareUrls(array $urls): array
        #{abstract} doDownload(PackageInterface $package, string $path, string $url, ?PackageInterface $prevPackage): PromiseInterface
        #{abstract} doInstall(PackageInterface $package, string $path, string $url): PromiseInterface
        #{abstract} doUpdate(PackageInterface $initial, PackageInterface $target, string $path, string $url): PromiseInterface
        #{abstract} getCommitLogs(string $fromReference, string $toReference, string $path): string
        #{abstract} hasMetadataRepository(string $path): bool
        #{abstract} getLocalChanges(PackageInterface $package, string $path): ?string
    }

}

package "Composer\\Package" {
    interface PackageInterface {
        +getRepository(): RepositoryInterface
        +__toString(): string
        +getAutoload(): array
        +getBinaries(): array
    }
}

package "Composer\\Util" {
    class HttpDownloader
    class Filesystem
    class ProcessExecutor
    class Cache
    class VersionGuesser
    class ArrayDumper
    class Comparer
}

package "Composer\\Config" {
    class Config
}

package "Composer\\IO" {
    interface IOInterface
}

package "Composer\\EventDispatcher" {
    class EventDispatcher
}

package "React\\Promise" {
    interface PromiseInterface
}

' --- Implementations ---
FileDownloader ..|> DownloaderInterface
FileDownloader ..|> ChangeReportInterface
VcsDownloader ..|> DownloaderInterface
VcsDownloader ..|> ChangeReportInterface
VcsDownloader ..|> VcsCapableDownloaderInterface

' --- Concrete DVCS subclasses implement DvcsDownloaderInterface (noted via comment) ---
note bottom of DvcsDownloaderInterface
  Implemented by concrete DVCS subclasses
  (e.g. GitDownloader, HgDownloader)
  NOT by VcsDownloader base
end note

' --- Compositions / Dependencies for FileDownloader ---
FileDownloader *-- IOInterface : io
FileDownloader *-- Config : config
FileDownloader *-- HttpDownloader : httpDownloader
FileDownloader *-- Filesystem : filesystem
FileDownloader o-- Cache : cache (optional)
FileDownloader o-- EventDispatcher : eventDispatcher (optional)
FileDownloader *-- ProcessExecutor : process
FileDownloader ..> Comparer : uses in getLocalChanges()
FileDownloader ..> PackageInterface : parameter

' --- Compositions / Dependencies for VcsDownloader ---
VcsDownloader *-- IOInterface : io
VcsDownloader *-- Config : config
VcsDownloader *-- ProcessExecutor : process
VcsDownloader *-- Filesystem : filesystem
VcsDownloader ..> VersionGuesser : uses in getVcsReference()
VcsDownloader ..> ArrayDumper : uses in getVcsReference()
VcsDownloader ..> PackageInterface : parameter

' --- Return type dependencies ---
FileDownloader ..> PromiseInterface : returns
VcsDownloader ..> PromiseInterface : returns

@enduml
