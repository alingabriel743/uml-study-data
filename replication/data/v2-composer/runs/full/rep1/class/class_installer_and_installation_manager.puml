@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EDF2FB
    BorderColor #4361EE
}

title Installer and Installation Manager

package "Composer" {
    class Installer {
        +{static} ERROR_NONE: int = 0
        +{static} ERROR_GENERIC_FAILURE: int = 1
        +{static} ERROR_DEPENDENCY_RESOLUTION_FAILED: int = 2
        +{static} ERROR_NO_LOCK_FILE_FOR_PARTIAL_UPDATE: int = 3
        +{static} ERROR_LOCK_FILE_INVALID: int = 4
        +{static} ERROR_AUDIT_FAILED: int = 5
        +{static} ERROR_PSR_AUTOLOAD_VIOLATION: int = 6
        +{static} ERROR_TRANSPORT_EXCEPTION: int = 100
        --
        #io: IOInterface
        #config: Config
        #package: RootPackageInterface
        #downloadManager: DownloadManager
        #repositoryManager: RepositoryManager
        #locker: Locker
        #installationManager: InstallationManager
        #eventDispatcher: EventDispatcher
        #autoloadGenerator: AutoloadGenerator
        #preferSource: bool
        #preferDist: bool
        #devMode: bool
        #dryRun: bool
        #downloadOnly: bool
        #update: bool
        #install: bool
        #dumpAutoloader: bool
        #runScripts: bool
        #writeLock: bool
        #executeOperations: bool
        #audit: bool
        #updateMirrors: bool
        #updateAllowList: ?array
        -auditConfig: ?AuditConfig
        -policyConfig: ?PolicyConfig
        -ignoredTypes: list<string>
        #suggestedPackagesReporter: SuggestedPackagesReporter
        #platformRequirementFilter: PlatformRequirementFilterInterface
        --
        +__construct(IOInterface, Config, RootPackageInterface, DownloadManager, RepositoryManager, Locker, InstallationManager, EventDispatcher, AutoloadGenerator): void
        +{static} create(io: IOInterface, composer: Composer): self
        +run(): int
        #doUpdate(repo: InstalledRepositoryInterface, install: bool): int
        #doInstall(repo: InstalledRepositoryInterface, alreadySolved: bool = false): int
        +setDryRun(bool): self
        +setDownloadOnly(bool): self
        +setPreferSource(bool): self
        +setPreferDist(bool): self
        +setUpdate(bool): self
        +setInstall(bool): self
        +setDevMode(bool): self
        +setDumpAutoloader(bool): self
        +setRunScripts(bool): self
        +setVerbose(bool): self
        +setWriteLock(bool): self
        +setExecuteOperations(bool): self
        +setAudit(bool): self
        +setErrorOnAudit(bool): self
        +setAuditConfig(AuditConfig): self
        +setPolicyConfig(PolicyConfig): self
        +setUpdateAllowList(array): self
        +setUpdateMirrors(bool): self
        +setIgnoredTypes(array): self
        +setPlatformRequirementFilter(PlatformRequirementFilterInterface): self
        +setSuggestedPackagesReporter(SuggestedPackagesReporter): self
        +setConfig(Config): self
    }
}

package "Composer\\Installer" {
    class InstallationManager {
        -installers: list<InstallerInterface>
        -cache: array<string, InstallerInterface>
        -notifiablePackages: array<string, PackageInterface[]>
        -loop: Loop
        -io: IOInterface
        -eventDispatcher: ?EventDispatcher
        -outputProgress: bool
        --
        +__construct(loop: Loop, io: IOInterface, eventDispatcher: ?EventDispatcher): void
        +reset(): void
        +addInstaller(installer: InstallerInterface): void
        +removeInstaller(installer: InstallerInterface): void
        +disablePlugins(): void
        +getInstaller(type: string): InstallerInterface
        +isPackageInstalled(InstalledRepositoryInterface, PackageInterface): bool
        +ensureBinariesPresence(PackageInterface): void
        +execute(InstalledRepositoryInterface, OperationInterface[], devMode: bool, runScripts: bool, downloadOnly: bool): void
        +download(PackageInterface): ?PromiseInterface
        +install(InstalledRepositoryInterface, InstallOperation): ?PromiseInterface
        +update(InstalledRepositoryInterface, UpdateOperation): ?PromiseInterface
        +uninstall(InstalledRepositoryInterface, UninstallOperation): ?PromiseInterface
        +markAliasInstalled(InstalledRepositoryInterface, MarkAliasInstalledOperation): void
        +markAliasUninstalled(InstalledRepositoryInterface, MarkAliasUninstalledOperation): void
        +getInstallPath(PackageInterface): ?string
        +setOutputProgress(bool): void
        +notifyInstalls(IOInterface): void
        -downloadAndExecuteBatch(InstalledRepositoryInterface, array, array, bool, bool, bool, array): void
        -executeBatch(InstalledRepositoryInterface, array, array, bool, bool, array): void
        -waitOnPromises(array): void
        -markForNotification(PackageInterface): void
        -runCleanup(array): void
    }

    interface InstallerInterface {
        +supports(packageType: string): bool
        +isInstalled(InstalledRepositoryInterface, PackageInterface): bool
        +download(PackageInterface, prevPackage: ?PackageInterface): ?PromiseInterface
        +prepare(type: string, PackageInterface, prevPackage: ?PackageInterface): ?PromiseInterface
        +install(InstalledRepositoryInterface, PackageInterface): ?PromiseInterface
        +update(InstalledRepositoryInterface, initial: PackageInterface, target: PackageInterface): ?PromiseInterface
        +uninstall(InstalledRepositoryInterface, PackageInterface): ?PromiseInterface
        +cleanup(type: string, PackageInterface, prevPackage: ?PackageInterface): ?PromiseInterface
        +getInstallPath(PackageInterface): ?string
    }
}

' ── Supporting stubs ────────────────────────────────────────────────────────
interface IOInterface
interface InstalledRepositoryInterface
interface OperationInterface
interface RootPackageInterface
interface PlatformRequirementFilterInterface

class Config
class DownloadManager
class RepositoryManager
class Locker
class EventDispatcher
class AutoloadGenerator
class Loop
class AuditConfig
class PolicyConfig
class SuggestedPackagesReporter

' ── Relationships ────────────────────────────────────────────────────────────

' Installer composes its core collaborators
Installer *-right- InstallationManager : #installationManager
Installer *-- DownloadManager          : #downloadManager
Installer *-- RepositoryManager        : #repositoryManager
Installer *-- Locker                   : #locker
Installer *-- EventDispatcher          : #eventDispatcher
Installer *-- AutoloadGenerator        : #autoloadGenerator
Installer ..> IOInterface              : uses
Installer ..> Config                   : uses
Installer ..> RootPackageInterface     : uses
Installer ..> PlatformRequirementFilterInterface : uses

' InstallationManager aggregates typed installers and holds a Loop
InstallationManager o-- InstallerInterface : -installers (by package type)
InstallationManager *-- Loop               : -loop
InstallationManager ..> IOInterface        : uses
InstallationManager ..> EventDispatcher    : optional

@enduml
