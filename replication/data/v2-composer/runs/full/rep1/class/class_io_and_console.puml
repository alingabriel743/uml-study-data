@startuml class_io_and_console

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title IO and Console — Composer\\IO

package "Psr\\Log" {
    interface LoggerInterface {
        +emergency($message, array $context): void
        +alert($message, array $context): void
        +critical($message, array $context): void
        +error($message, array $context): void
        +warning($message, array $context): void
        +notice($message, array $context): void
        +info($message, array $context): void
        +debug($message, array $context): void
        +log($level, $message, array $context): void
    }
}

package "Symfony\\Console" {
    interface InputInterface
    interface OutputInterface
    interface ConsoleOutputInterface
    interface StreamableInputInterface
    interface OutputFormatterInterface
    class HelperSet
    class ProgressBar
    class "Table" as SfTable
    class StringInput
    class StreamOutput
    class QuestionHelper
}

package "Composer\\Config" {
    class Config
}

package "Composer\\IO" {

    interface IOInterface {
        {field} +QUIET = 1
        {field} +NORMAL = 2
        {field} +VERBOSE = 4
        {field} +VERY_VERBOSE = 8
        {field} +DEBUG = 16
        --
        +isInteractive(): bool
        +isVerbose(): bool
        +isVeryVerbose(): bool
        +isDebug(): bool
        +isDecorated(): bool
        +write($messages, bool $newline, int $verbosity): void
        +writeError($messages, bool $newline, int $verbosity): void
        +writeRaw($messages, bool $newline, int $verbosity): void
        +writeErrorRaw($messages, bool $newline, int $verbosity): void
        +overwrite($messages, bool $newline, ?int $size, int $verbosity): void
        +overwriteError($messages, bool $newline, ?int $size, int $verbosity): void
        +ask(string $question, $default): mixed
        +askConfirmation(string $question, bool $default): bool
        +askAndValidate(string $question, callable $validator, ?int $attempts, $default): mixed
        +askAndHideAnswer(string $question): ?string
        +select(string $question, array $choices, $default, ...): mixed
        +getAuthentications(): array
        +hasAuthentication(string $repositoryName): bool
        +getAuthentication(string $repositoryName): array
        +setAuthentication(string $repositoryName, string $username, ?string $password): void
        +loadConfiguration(Config $config): void
    }

    abstract class BaseIO {
        #authentications: array
        --
        +getAuthentications(): array
        +resetAuthentications(): void
        +hasAuthentication($repositoryName): bool
        +getAuthentication($repositoryName): array
        +setAuthentication($repositoryName, $username, $password): void
        +writeRaw($messages, bool $newline, int $verbosity): void
        +writeErrorRaw($messages, bool $newline, int $verbosity): void
        #checkAndSetAuthentication(string $repositoryName, string $username, ?string $password): void
        +loadConfiguration(Config $config): void
        +emergency($message, array $context): void
        +alert($message, array $context): void
        +critical($message, array $context): void
        +error($message, array $context): void
        +warning($message, array $context): void
        +notice($message, array $context): void
        +info($message, array $context): void
        +debug($message, array $context): void
        +log($level, $message, array $context): void
    }

    class ConsoleIO {
        #input: InputInterface
        #output: OutputInterface
        #helperSet: HelperSet
        #lastMessage: string
        #lastMessageErr: string
        -sendTimestamps: string|false
        -startTime: float
        -verbosityMap: array
        --
        +__construct(InputInterface $input, OutputInterface $output, HelperSet $helperSet)
        +enableDebugging(float $startTime): void
        +enableTimestamps(string $format): void
        +isInteractive(): bool
        +isDecorated(): bool
        +isVerbose(): bool
        +isVeryVerbose(): bool
        +isDebug(): bool
        +write($messages, bool $newline, int $verbosity): void
        +writeError($messages, bool $newline, int $verbosity): void
        +writeRaw($messages, bool $newline, int $verbosity): void
        +writeErrorRaw($messages, bool $newline, int $verbosity): void
        -doWrite($messages, bool $newline, bool $stderr, int $verbosity, bool $raw): void
        +overwrite($messages, bool $newline, ?int $size, int $verbosity): void
        +overwriteError($messages, bool $newline, ?int $size, int $verbosity): void
        -doOverwrite($messages, bool $newline, ?int $size, bool $stderr, int $verbosity): void
        +getProgressBar(int $max): ProgressBar
        +ask($question, $default): mixed
        +askConfirmation($question, $default): bool
        +askAndValidate($question, $validator, $attempts, $default): mixed
        +askAndHideAnswer($question): mixed
        +select($question, $choices, $default, ...): mixed
        +getTable(): Table
        +{static} sanitize($messages, bool $allowNewlines): string|array
        -getErrorOutput(): OutputInterface
        -{static} ensureValidUtf8(string $string): string
    }

    class NullIO {
        --
        +isInteractive(): bool
        +isVerbose(): bool
        +isVeryVerbose(): bool
        +isDebug(): bool
        +isDecorated(): bool
        +write($messages, bool $newline, int $verbosity): void
        +writeError($messages, bool $newline, int $verbosity): void
        +overwrite($messages, bool $newline, ?int $size, int $verbosity): void
        +overwriteError($messages, bool $newline, ?int $size, int $verbosity): void
        +ask($question, $default): mixed
        +askConfirmation($question, $default): bool
        +askAndValidate($question, $validator, $attempts, $default): mixed
        +askAndHideAnswer($question): ?string
        +select($question, $choices, $default, ...): mixed
    }

    class BufferIO {
        --
        +__construct(string $input, int $verbosity, ?OutputFormatterInterface $formatter)
        +getOutput(): string
        +setUserInputs(array $inputs): void
        -createStream(array $inputs): resource
    }

}

' Inheritance & Implementation
IOInterface ..|> LoggerInterface : extends
BaseIO ..|> IOInterface : implements
ConsoleIO --|> BaseIO : extends
NullIO --|> BaseIO : extends
BufferIO --|> ConsoleIO : extends

' ConsoleIO dependencies on Symfony Console
ConsoleIO o-- InputInterface : input
ConsoleIO o-- OutputInterface : output
ConsoleIO o-- HelperSet : helperSet
ConsoleIO ..> ConsoleOutputInterface : uses (error output)
ConsoleIO ..> ProgressBar : creates
ConsoleIO ..> SfTable : creates

' BufferIO dependencies on Symfony Console
BufferIO ..> StringInput : creates
BufferIO ..> StreamOutput : creates
BufferIO ..> StreamableInputInterface : uses
BufferIO ..> OutputFormatterInterface : uses
BufferIO ..> QuestionHelper : uses

' BaseIO dependency on Config
BaseIO ..> Config : loadConfiguration()

note right of NullIO
  Silent/non-interactive stub.
  All write/overwrite are no-ops.
  All ask/select return $default.
end note

note right of BufferIO
  In-memory IO for testing.
  Backed by php://memory stream.
  getOutput() reads buffered content.
  setUserInputs() simulates user input.
end note

note bottom of BaseIO
  PSR log methods (emergency..debug)
  all delegate to log(), which routes
  to writeError() with HTML-like tags.
  loadConfiguration() reads credentials
  from Config and calls
  ProcessExecutor::setTimeout().
end note

@enduml
