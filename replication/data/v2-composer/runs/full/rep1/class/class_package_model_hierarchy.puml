@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #D0E8FF
    BorderColor #3A7BD5
}

title Package Model Hierarchy\n<size:11>(Composer\\Package)</size>

package "Composer\\Package" {

    interface PackageInterface {
        +{static} DISPLAY_SOURCE_REF_IF_DEV: int = 0
        +{static} DISPLAY_SOURCE_REF: int = 1
        +{static} DISPLAY_DIST_REF: int = 2
        ..
        +getName(): string
        +getPrettyName(): string
        +getNames(bool $provides=true): array
        +getVersion(): string
        +getType(): string
        +isDev(): bool
        +getRequires(): array
        +getRepository(): ?RepositoryInterface
        +setRepository(RepositoryInterface): void
        +getUniqueName(): string
        +getFullPrettyVersion(bool, int): string
        +getStability(): string
        +__toString(): string
    }

    interface CompletePackageInterface {
        +getScripts(): array
        +getLicense(): array
        +getKeywords(): array
        +getAuthors(): array
        +getDescription(): ?string
        +getHomepage(): ?string
        +isAbandoned(): bool
        +getReplacementPackage(): ?string
        +getArchiveName(): ?string
        +getArchiveExcludes(): array
    }

    interface RootPackageInterface {
        +getAliases(): array
        +setAliases(array): void
        +getMinimumStability(): string
        +setMinimumStability(string): void
        +getStabilityFlags(): array
        +getReferences(): array
        +getPreferStable(): bool
        +getConfig(): array
        +setRequires(array): void
        +setDevRequires(array): void
    }

    abstract class BasePackage {
        +{static} STABILITIES: array
        +{static} STABILITY_STABLE: int = 0
        +{static} STABILITY_RC: int = 5
        +{static} STABILITY_BETA: int = 10
        +{static} STABILITY_ALPHA: int = 15
        +{static} STABILITY_DEV: int = 20
        ..
        +$id: int
        #$name: string
        #$prettyName: string
        #$repository: ?RepositoryInterface
        ..
        +__construct(string $name)
        +getName(): string
        +getPrettyName(): string
        +getNames(bool $provides=true): array
        +setId(int): void
        +getId(): int
        +setRepository(RepositoryInterface): void
        +getRepository(): ?RepositoryInterface
        +isPlatform(): bool
        +getUniqueName(): string
        +equals(PackageInterface): bool
        +__toString(): string
        +getStabilityPriority(): int
        +__clone()
        +{static} packageNameToRegexp(string, string): string
    }

    class Package {
        -$type: string
        -$targetDir: ?string
        -$installationSource: ?string
        -$sourceType: ?string
        -$sourceUrl: ?string
        -$sourceReference: ?string
        -$sourceMirrors: ?array
        -$distType: ?string
        -$distUrl: ?string
        -$distReference: ?string
        -$distSha1Checksum: ?string
        -$distMirrors: ?array
        -$version: string
        -$prettyVersion: string
        -$dev: bool
        -$stability: string
        -$requires: array
        -$conflicts: array
        -$provides: array
        -$replaces: array
        -$devRequires: array
        -$suggests: array
        -$autoload: array
        -$devAutoload: array
        -$binaries: array
        -$extra: array
        -$isDefaultBranch: bool
        -$transportOptions: array
        ..
        +__construct(string $name, string $version, string $prettyVersion)
        +getSourceUrls(): array
        +getDistUrls(): array
        +setSourceDistReferences(string): void
        +replaceVersion(string, string): void
        #getUrls(?string, ?array, ?string, ?string, string): array
    }

    class CompletePackage {
        -$repositories: array
        -$license: array
        -$keywords: array
        -$authors: array
        -$description: ?string
        -$homepage: ?string
        -$scripts: array
        -$support: array
        -$funding: array
        -$abandoned: bool|string
        -$archiveName: ?string
        -$archiveExcludes: array
    }

    class RootPackage {
        +{static} DEFAULT_PRETTY_VERSION: string
        ..
        -$minimumStability: string = 'stable'
        -$preferStable: bool = false
        -$stabilityFlags: array
        -$config: array
        -$references: array
        -$aliases: array
    }

    class AliasPackage {
        -$version: string
        -$prettyVersion: string
        -$dev: bool
        -$stability: string
        -$rootPackageAlias: bool
        -$hasSelfVersionRequires: bool
        -$requires: array
        -$devRequires: array
        -$conflicts: array
        -$provides: array
        -$replaces: array
        ..
        +__construct(BasePackage $aliasOf, string $version, string $prettyVersion)
        +getAliasOf(): BasePackage
        +setRootPackageAlias(bool): void
        +isRootPackageAlias(): bool
        +hasSelfVersionRequires(): bool
        +replaceSelfVersionDependencies(array, string): array
        +__toString(): string
        /' All other getters delegate to $aliasOf (Decorator) '/
    }

    class CompleteAliasPackage {
        ..
        +__construct(CompletePackage $aliasOf, string $version, string $prettyVersion)
        +getAliasOf(): CompletePackage
        /' All CompletePackageInterface methods delegate to $aliasOf '/
    }

    class RootAliasPackage {
        ..
        +__construct(RootPackage $aliasOf, string $version, string $prettyVersion)
        +getAliasOf(): RootPackage
        /' All RootPackageInterface methods delegate to $aliasOf '/
    }

}

interface RepositoryInterface <<external>>
class Link <<external>> {
    +getSource(): string
    +getTarget(): string
    +getConstraint(): ConstraintInterface
    +getDescription(): string
}

' ─── Interface hierarchy ───
CompletePackageInterface --|> PackageInterface
RootPackageInterface --|> CompletePackageInterface

' ─── Abstract base implements interface ───
BasePackage ..|> PackageInterface

' ─── Package class chain (concrete) ───
Package --|> BasePackage
CompletePackage --|> Package
CompletePackage ..|> CompletePackageInterface
RootPackage --|> CompletePackage
RootPackage ..|> RootPackageInterface

' ─── AliasPackage chain (Decorator) ───
AliasPackage --|> BasePackage
CompleteAliasPackage --|> AliasPackage
CompleteAliasPackage ..|> CompletePackageInterface
RootAliasPackage --|> CompleteAliasPackage
RootAliasPackage ..|> RootPackageInterface

' ─── Decorator associations ($aliasOf) ───
AliasPackage "1" *--> "1" BasePackage : $aliasOf
CompleteAliasPackage "1" *--> "1" CompletePackage : $aliasOf
RootAliasPackage "1" *--> "1" RootPackage : $aliasOf

' ─── Repository association ───
BasePackage "1" o--> "0..1" RepositoryInterface : $repository

' ─── Link usage (dependency arrays) ───
Package ..> Link : uses\n(requires/conflicts\nprovides/replaces)

note bottom of AliasPackage
  <b>Decorator Pattern</b>
  Wraps a BasePackage and proxies
  ~25 interface methods to $aliasOf.
  Allows aliasing without full duplication.
end note

note right of BasePackage
  <b>STABILITIES map</b>
  stable=0, RC=5, beta=10
  alpha=15, dev=20
end note

@enduml
