@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Plugin System

package "Composer\\Plugin" {

    class PluginManager {
        #$composer: Composer
        #$io: IOInterface
        #$globalComposer: ?PartialComposer
        #$versionParser: VersionParser
        #$disablePlugins: bool|'local'|'global'
        #$plugins: PluginInterface[]
        #$registeredPlugins: array
        -$allowPluginRules: array|null
        -$allowGlobalPluginRules: array|null
        -$runningInGlobalDir: bool
        -{static}$classCounter: int
        +__construct(IOInterface, Composer, ?PartialComposer, $disablePlugins): void
        +loadInstalledPlugins(): void
        +deactivateInstalledPlugins(): void
        +getPlugins(): PluginInterface[]
        +getRegisteredPlugins(): string[]
        +registerPackage(PackageInterface, bool, bool): void
        +addPlugin(PluginInterface, bool, ?PackageInterface): void
        +removePlugin(PluginInterface): void
        +uninstallPlugin(PluginInterface): void
        +getPluginCapability(PluginInterface, string, array): ?Capability
        +getPluginCapabilities(string, array): Capability[]
        +arePluginsDisabled(string): bool
        +disablePlugins(): void
        +isPluginAllowed(string, bool, bool, bool): bool
        #getPluginApiVersion(): string
        #getCapabilityImplementationClassName(PluginInterface, string): ?string
        -loadRepository(RepositoryInterface, bool, ?RootPackageInterface): void
        -parseAllowedPlugins($config, ?Locker): ?array
    }

    interface PluginInterface {
        {static} PLUGIN_API_VERSION = '2.9.0'
        +activate(Composer, IOInterface): void
        +deactivate(Composer, IOInterface): void
        +uninstall(Composer, IOInterface): void
    }

    interface Capable {
        +getCapabilities(): string[]
    }

    class PluginEvents <<constants>> {
        {static} INIT = 'init'
        {static} COMMAND = 'command'
        {static} PRE_FILE_DOWNLOAD = 'pre-file-download'
        {static} POST_FILE_DOWNLOAD = 'post-file-download'
        {static} PRE_COMMAND_RUN = 'pre-command-run'
        {static} PRE_POOL_CREATE = 'pre-pool-create'
    }

    class PluginBlockedException {
    }

    class CommandEvent {
        -$commandName: string
        -$input: InputInterface
        -$output: OutputInterface
        +__construct(string, string, InputInterface, OutputInterface, array, array): void
        +getCommandName(): string
        +getInput(): InputInterface
        +getOutput(): OutputInterface
    }

    class PreFileDownloadEvent {
        -$httpDownloader: HttpDownloader
        -$processedUrl: string
        -$customCacheKey: ?string
        -$type: string
        -$context: mixed
        -$transportOptions: array
        +getHttpDownloader(): HttpDownloader
        +getProcessedUrl(): string
        +setProcessedUrl(string): void
        +getCustomCacheKey(): ?string
        +setCustomCacheKey(?string): void
        +getTransportOptions(): array
        +setTransportOptions(array): void
    }

    class PostFileDownloadEvent {
        -$fileName: ?string
        -$checksum: ?string
        -$url: string
        -$context: mixed
        -$type: string
        +getFileName(): ?string
        +getChecksum(): ?string
        +getUrl(): string
        +getContext(): mixed
        +getType(): string
    }

    class PreCommandRunEvent {
        -$input: InputInterface
        -$command: string
        +getInput(): InputInterface
        +getCommand(): string
    }

    class PrePoolCreateEvent {
        -$repositories: RepositoryInterface[]
        -$request: Request
        -$acceptableStabilities: array
        -$stabilityFlags: array
        -$packages: BasePackage[]
        -$unacceptableFixedPackages: BasePackage[]
        +getRepositories(): RepositoryInterface[]
        +getRequest(): Request
        +getPackages(): BasePackage[]
        +setPackages(array): void
        +setUnacceptableFixedPackages(array): void
    }

}

package "Composer\\Plugin\\Capability" {

    interface Capability <<marker>> {
    }

    interface CommandProvider {
        +getCommands(): BaseCommand[]
    }

}

' External base types
abstract class "EventDispatcher\\Event" <<external>> {
}

class UnexpectedValueException <<external>> {
}

' ─── Inheritance / Implementation ───────────────────────────────────────

CommandProvider ..|> Capability

CommandEvent --|> "EventDispatcher\\Event"
PreFileDownloadEvent --|> "EventDispatcher\\Event"
PostFileDownloadEvent --|> "EventDispatcher\\Event"
PreCommandRunEvent --|> "EventDispatcher\\Event"
PrePoolCreateEvent --|> "EventDispatcher\\Event"

PluginBlockedException --|> UnexpectedValueException

' ─── PluginManager relationships ────────────────────────────────────────

PluginManager o-- PluginInterface : manages >
PluginManager ..> Capable : instanceof check
PluginManager ..> Capability : resolves capability
PluginManager ..> PluginEvents : event name constants

' ─── Note: concrete plugins (external) implement PluginInterface
' ─── and optionally also implement Capable to expose capabilities

note bottom of PluginManager
  addPlugin: if plugin is EventSubscriberInterface
  → eventDispatcher.addSubscriber(plugin)
  isPluginAllowed: validates allow-plugins config;
  throws PluginBlockedException if denied
end note

note right of Capable
  Optional interface — plugins that expose
  capabilities implement both PluginInterface
  and Capable simultaneously
end note

@enduml
