@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    FontColor #1A5276
}

title Repository System\n<size:11>Composer\\Repository — interfaces, array-backed repo, Composer registry repo, and VCS repo</size>

' ─────────────────────────────────────────────
' External interfaces (abbreviated)
' ─────────────────────────────────────────────
interface Countable <<PHP SPL>> {
    +count(): int
}

' ─────────────────────────────────────────────
package "Repository Interfaces" {

    interface RepositoryInterface {
        {static} +SEARCH_FULLTEXT: int = 0
        {static} +SEARCH_NAME: int = 1
        {static} +SEARCH_VENDOR: int = 2
        +hasPackage(package: PackageInterface): bool
        +findPackage(name: string, constraint): ?BasePackage
        +findPackages(name: string, constraint=null): BasePackage[]
        +getPackages(): BasePackage[]
        +loadPackages(packageNameMap: array, acceptableStabilities: array, stabilityFlags: array, alreadyLoaded: array=[]): array
        +search(query: string, mode: int=0, type: ?string=null): array[]
        +getProviders(packageName: string): array[]
        +getRepoName(): string
    }

    interface WritableRepositoryInterface {
        +write(devMode: bool, installationManager: InstallationManager): void
        +addPackage(package: PackageInterface): void
        +removePackage(package: PackageInterface): void
        +getCanonicalPackages(): PackageInterface[]
        +reload(): void
        +setDevPackageNames(devPackageNames: array): void
        +getDevPackageNames(): string[]
    }

    interface InstalledRepositoryInterface {
        +getDevMode(): bool|null
        +isFresh(): bool
    }

    interface ConfigurableRepositoryInterface {
        +getRepoConfig(): mixed[]
    }

    interface AdvisoryProviderInterface {
        +hasSecurityAdvisories(): bool
        +getSecurityAdvisories(packageConstraintMap: array, allowPartialAdvisories: bool=false): array
    }

    interface FilterListProviderInterface {
        +hasFilter(): bool
        +getFilter(packageConstraintMap: array, configuredLists: array): array
        +getFilterLists(): array
    }

    interface VersionCacheInterface {
        +getVersionPackage(version: string, identifier: string): mixed[]|null|false
    }

}

' ─────────────────────────────────────────────
package "Array-Backed Implementations" {

    class ArrayRepository {
        #packages: ?array
        #packageMap: ?array
        +__construct(packages: array=[])
        +getRepoName(): string
        +findPackage(name: string, constraint): ?BasePackage
        +findPackages(name: string, constraint=null): BasePackage[]
        +search(query: string, mode: int=0, type: ?string=null): array[]
        +hasPackage(package: PackageInterface): bool
        +addPackage(package: PackageInterface): void
        +getProviders(packageName: string): array[]
        +removePackage(package: PackageInterface): void
        +getPackages(): BasePackage[]
        +loadPackages(...): array
        +count(): int
        #initialize(): void
        #createAliasPackage(package: BasePackage, alias: string, prettyAlias: string): AliasPackage
    }

    class WritableArrayRepository {
        #devPackageNames: string[]
        -devMode: bool|null
        +getDevMode(): bool|null
        +setDevPackageNames(devPackageNames: array): void
        +getDevPackageNames(): string[]
        +write(devMode: bool, installationManager: InstallationManager): void
        +reload(): void
    }

    class FilesystemRepository {
        ' Persists packages to JSON file on disk
    }

    class InstalledArrayRepository {
        +isFresh(): bool
    }

    class InstalledFilesystemRepository {
    }

    class LockArrayRepository {
        ' Holds lock-file packages
    }

    class RootPackageRepository {
        ' Holds the root package
    }

    note right of LockArrayRepository : Holds packages from\ncomposer.lock
    note right of RootPackageRepository : Holds the root\npackage only

}

' ─────────────────────────────────────────────
package "Registry & VCS Repositories" {

    class VcsRepository {
        #url: string
        #packageName: ?string
        #isVerbose: bool
        #isVeryVerbose: bool
        #io: IOInterface
        #config: Config
        #versionParser: VersionParser
        #type: string
        #loader: ?LoaderInterface
        #repoConfig: array
        #httpDownloader: HttpDownloader
        #processExecutor: ProcessExecutor
        -drivers: array
        -driver: ?VcsDriverInterface
        -versionCache: ?VersionCacheInterface
        -emptyReferences: list<string>
        +__construct(repoConfig: array, io: IOInterface, config: Config, httpDownloader: HttpDownloader, ...)
        +getRepoName(): string
        +getRepoConfig(): array
        +setLoader(loader: LoaderInterface): void
        +getDriver(): ?VcsDriverInterface
        +hadInvalidBranches(): bool
        +getEmptyReferences(): array
        +getVersionTransportExceptions(): array
    }

    class ComposerRepository {
        -repoConfig: array
        -url: string
        -baseUrl: string
        -io: IOInterface
        -httpDownloader: HttpDownloader
        -loop: Loop
        #cache: Cache
        #notifyUrl: ?string
        #searchUrl: ?string
        #hasProviders: bool
        #providersUrl: ?string
        #lazyProvidersUrl: ?string
        #hasAvailablePackageList: bool
        #loader: ArrayLoader
        -allowSslDowngrade: bool
        -eventDispatcher: ?EventDispatcher
        -degradedMode: bool
        +__construct(repoConfig: array, io: IOInterface, config: Config, httpDownloader: HttpDownloader, ...)
        +getRepoName(): string
        +getRepoConfig(): array
        +findPackage(name: string, constraint): ?BasePackage
        +findPackages(name: string, constraint=null): BasePackage[]
        +getPackages(): BasePackage[]
        +getPackageNames(packageFilter: ?string=null): array
        +loadPackages(packageNameMap: array, ...): array
        +search(query: string, mode: int=0, type: ?string=null): array
        +hasSecurityAdvisories(): bool
        +getSecurityAdvisories(packageConstraintMap: array, ...): array
        +hasFilter(): bool
        +getFilter(packageConstraintMap: array, configuredLists: array): array
        +getFilterLists(): array
        +getProviders(packageName: string): array
        +addPackage(package: PackageInterface): void
    }

    class PackageRepository {
        ' Mirrors advisory+filter from ComposerRepository\n' for a specific package set
    }

}

' ─────────────────────────────────────────────
' Trait (shown as abstract class with stereotype)
' ─────────────────────────────────────────────
class CanonicalPackagesTrait <<trait>> {
    +getCanonicalPackages(): PackageInterface[]
}

' ─────────────────────────────────────────────
' Interface hierarchy
' ─────────────────────────────────────────────
RepositoryInterface --|> Countable
WritableRepositoryInterface --|> RepositoryInterface
InstalledRepositoryInterface --|> WritableRepositoryInterface

' ─────────────────────────────────────────────
' Class → Interface implementations
' ─────────────────────────────────────────────
ArrayRepository ..|> RepositoryInterface

WritableArrayRepository --|> ArrayRepository
WritableArrayRepository ..|> WritableRepositoryInterface
WritableArrayRepository ..> CanonicalPackagesTrait : <<uses>>

FilesystemRepository --|> WritableArrayRepository

InstalledArrayRepository --|> WritableArrayRepository
InstalledArrayRepository ..|> InstalledRepositoryInterface

InstalledFilesystemRepository --|> FilesystemRepository
InstalledFilesystemRepository ..|> InstalledRepositoryInterface

LockArrayRepository --|> ArrayRepository
RootPackageRepository --|> ArrayRepository

VcsRepository --|> ArrayRepository
VcsRepository ..|> ConfigurableRepositoryInterface
VcsRepository ..> VersionCacheInterface : <<uses>>

ComposerRepository --|> ArrayRepository
ComposerRepository ..|> ConfigurableRepositoryInterface
ComposerRepository ..|> AdvisoryProviderInterface
ComposerRepository ..|> FilterListProviderInterface

PackageRepository --|> ArrayRepository
PackageRepository ..|> AdvisoryProviderInterface
PackageRepository ..|> FilterListProviderInterface

@enduml
