@startuml class_utilities

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Utilities — Composer\\Util

package "Composer\\Util" {

    class Filesystem {
        -processExecutor: ?ProcessExecutor
        --
        +__construct(?ProcessExecutor $executor = null)
        +remove(string $file): bool
        +isDirEmpty(string $dir): bool
        +emptyDirectory(string $dir, bool $ensureDirectoryExists): void
        +removeDirectory(string $directory): bool
        +removeDirectoryAsync(string $directory): PromiseInterface
        +removeDirectoryPhp(string $directory): bool
        +ensureDirectoryExists(string $directory): void
        +unlink(string $path): bool
        +rmdir(string $path): bool
        +copy(string $source, string $target): void
        +copyThenRemove(string $source, string $target): void
        +rename(string $source, string $target): void
        +normalizePath(string $path): string
        +isAbsolutePath(string $path): bool
        +findShortestPath(string $from, string $to, ...): string
        +findShortestPathCode(string $from, string $to, ...): string
        +relativeSymlink(string $target, string $link): void
        +isSymlinkedDirectory(string $directory): bool
        +junction(string $target, string $junction): void
        +isJunction(string $junction): bool
        +removeJunction(string $junction): bool
        +filePutContentsIfModified(string $path, string $content): void
        +safeCopy(string $source, string $target): void
        +size(string $path): int
        #directorySize(string $directory): int
        #getProcess(): ProcessExecutor
        -removeEdgeCases(string $directory, bool $fallbackToPhp): ?bool
        -unlinkImplementation(string $path): bool
        -filesAreEqual(string $a, string $b): bool
    }

    class ProcessExecutor {
        #captureOutput: bool = false
        #errorOutput: string = ''
        #io: ?IOInterface
        -jobs: array = []
        -runningJobs: int = 0
        -maxJobs: int = 10
        -idGen: int = 0
        -allowAsync: bool = false
        --
        +__construct(?IOInterface $io = null)
        +execute($command, &$output = null, ?string $cwd = null): int
        +executeTty($command, ?string $cwd = null): int
        +executeAsync($command, ?string $cwd = null): PromiseInterface
        +setMaxJobs(int $maxJobs): void
        +resetMaxJobs(): void
        +enableAsync(): void
        +wait($index = null): void
        +countActiveJobs($index = null): int
        +getErrorOutput(): string
        +splitLines(?string $output): array
        +requiresGitDirEnv($command): bool
        #outputHandler(string $type, string $buffer): void
        -runProcess($command, ?string $cwd, ?array $env, bool $tty, &$output): ?int
        -doExecute($command, ?string $cwd, bool $tty, &$output): int
        -startJob(int $id): void
        -markJobDone(): void
        -outputCommandRun($command, ?string $cwd, bool $async): void
    }

    class HttpDownloader {
        -io: IOInterface
        -config: Config
        -jobs: array = []
        -options: array = []
        -runningJobs: int = 0
        -maxJobs: int = 12
        -curl: ?CurlDownloader
        -rfs: ?RemoteFilesystem
        -idGen: int = 0
        -disabled: bool
        -allowAsync: bool = false
        --
        +__construct(IOInterface $io, Config $config, array $options = [], bool $disableTls = false)
        +get(string $url, array $options = []): Response
        +add(string $url, array $options = []): PromiseInterface
        +copy(string $url, string $to, array $options = []): Response
        +addCopy(string $url, string $to, array $options = []): PromiseInterface
        +getOptions(): array
        +setOptions(array $options): void
        +enableAsync(): void
        +wait(?int $index = null): void
        +countActiveJobs(?int $index = null): int
        -addJob(array $request, bool $sync = false): array
        -startJob(int $id): void
        -markJobDone(): void
        -getResponse(int $index): Response
        -canUseCurl(array $job): bool
    }

    class Perforce {
        #path: string
        #p4Depot: ?string
        #p4Client: string
        #p4User: ?string
        #p4Password: ?string
        #p4Port: string
        #p4Stream: ?string
        #p4ClientSpec: ?string
        #p4DepotType: ?string
        #p4Branch: ?string
        #process: ProcessExecutor
        #uniquePerforceClientName: string
        #windowsFlag: bool
        #commandResult: int
        #io: IOInterface
        #filesystem: Filesystem
        --
        +__construct($repoConfig, string $port, string $path, ProcessExecutor $process, bool $isWindows, IOInterface $io)
        +initialize($repoConfig): void
        +initializeDepotAndBranch(?string $depot, ?string $branch): void
        +generateUniquePerforceClientName(): string
        +getClient(): string
        +setStream(string $stream): void
        +isStream(): bool
        +getStream(): string
        +getP4ClientSpec(): string
        +getUser(): ?string
        +setUser(?string $user): void
        +queryP4User(): void
        +queryP4Password(): ?string
        +generateP4Command(array $arguments, bool $useClient = true): array
        +isLoggedIn(): bool
        +connectClient(): void
        +syncCodeBase(?string $sourceReference): void
        +writeP4ClientSpec(): void
        +p4Login(): void
        +getComposerInformation(string $identifier): ?array
        +getBranches(): array
        +getTags(): array
        +checkStream(): bool
        +getFilesystem(): Filesystem
        +setFilesystem(Filesystem $fs): void
        #executeCommand($command): int
        #getPath(): string
        #getPort(): string
        #getP4variable(string $name): ?string
        #getChangeList(string $reference): mixed
        -getP4Executable(): string
    }

}

package "Composer\\IO" {
    interface IOInterface {
        +write(string $text): void
        +isDebug(): bool
        +ask(string $question, $default): mixed
    }
}

package "Composer" {
    class Config {
        +get(string $key): mixed
    }
}

package "Composer\\Util\\Http" {
    class CurlDownloader {
        +get(string $url, array $options): void
    }
    class Response {
        +getStatusCode(): int
        +getBody(): string
    }
}

package "Composer\\Util (other)" {
    class RemoteFilesystem {
        +getContents(string $originUrl, string $fileUrl, bool $progress): string
    }
    class Platform {
        +{static} isWindows(): bool
        +{static} getEnv(string $name): string|false
    }
}

package "React\\Promise" {
    interface PromiseInterface {
        +then(callable $onFulfilled): PromiseInterface
    }
}

' ── Relationships ─────────────────────────────────────────────────────────────

' Filesystem composes ProcessExecutor (lazy-initialized)
Filesystem *-- ProcessExecutor : uses (lazy)

' Perforce composes ProcessExecutor (constructor injection)
Perforce *-- ProcessExecutor : executes p4 commands

' Perforce composes Filesystem (lazy via setter)
Perforce *-- Filesystem : file operations

' Perforce depends on IOInterface
Perforce ..> IOInterface : logging

' ProcessExecutor depends on IOInterface (optional)
ProcessExecutor ..> IOInterface : optional logging

' HttpDownloader depends on IOInterface and Config
HttpDownloader ..> IOInterface : logging
HttpDownloader ..> Config : HTTP settings

' HttpDownloader optionally uses CurlDownloader or RemoteFilesystem
HttpDownloader o-- CurlDownloader : curl backend (optional)
HttpDownloader o-- RemoteFilesystem : stream fallback (optional)

' HttpDownloader returns Response
HttpDownloader ..> Response : produces

' Async operations return PromiseInterface
Filesystem ..> PromiseInterface : removeDirectoryAsync
ProcessExecutor ..> PromiseInterface : executeAsync
HttpDownloader ..> PromiseInterface : add / addCopy

' Filesystem uses Platform for OS detection
Filesystem ..> Platform : OS detection (static)

@enduml
