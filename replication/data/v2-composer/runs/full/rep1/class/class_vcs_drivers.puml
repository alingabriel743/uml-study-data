@startuml class_vcs_drivers

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title VCS Drivers

package "Composer\\Repository\\Vcs" {

    interface VcsDriverInterface {
        + initialize(): void
        + getComposerInformation(string $identifier): ?array
        + getFileContent(string $file, string $identifier): ?string
        + getChangeDate(string $identifier): ?DateTimeImmutable
        + getRootIdentifier(): string
        + getBranches(): array
        + getTags(): array
        + getDist(string $identifier): ?array
        + getSource(string $identifier): array
        + getUrl(): string
        + hasComposerFile(string $identifier): bool
        + cleanup(): void
        + {static} supports(IOInterface $io, Config $config, string $url, bool $deep = false): bool
    }

    abstract class VcsDriver {
        # $url: string
        # $originUrl: string
        # $repoConfig: array
        # $io: IOInterface
        # $config: Config
        # $process: ProcessExecutor
        # $httpDownloader: HttpDownloader
        # $infoCache: array
        # $cache: ?Cache
        --
        + {final} __construct(array $repoConfig, IOInterface $io, Config $config, HttpDownloader $httpDownloader, ProcessExecutor $process)
        # shouldCache(string $identifier): bool
        + getComposerInformation(string $identifier): ?array
        # getBaseComposerInformation(string $identifier): ?array
        + hasComposerFile(string $identifier): bool
        # getScheme(): string
        # getContents(string $url): Response
        + cleanup(): void
    }

    class GitHubDriver {
        # $owner: string
        # $repository: string
        # $tags: array
        # $branches: array
        # $rootIdentifier: string
        # $repoData: array
        # $hasIssues: bool
        # $isPrivate: bool
        - $isArchived: bool
        - $fundingInfo: array|false|null
        - $allowGitFallback: bool
        # $gitDriver: ?GitDriver
        --
        + initialize(): void
        + getRepositoryUrl(): string
        + getRootIdentifier(): string
        + getUrl(): string
        # getApiUrl(): string
        + getSource(string $identifier): array
        + getDist(string $identifier): ?array
        + getComposerInformation(string $identifier): ?array
        - getFundingInfo(): array|false
        + getFileContent(string $file, string $identifier): ?string
        + getChangeDate(string $identifier): ?DateTimeImmutable
        + getTags(): array
        + getBranches(): array
        + {static} supports(IOInterface $io, Config $config, string $url, bool $deep = false): bool
        + getRepoData(): ?array
        # generateSshUrl(): string
        # getContents(string $url, bool $fetchingRepoData = false): Response
        # fetchRootIdentifier(): void
        # attemptCloneFallback(?Throwable $e = null): bool
        # setupGitDriver(string $url): void
        # getNextPage(Response $response): ?string
    }

    class GitLabDriver {
        {field} URL_REGEX: string
        - $scheme: string
        - $namespace: string
        - $repository: string
        - $project: array
        - $commits: array
        - $tags: array
        - $branches: array
        # $gitDriver: ?GitDriver
        # $protocol: string
        - $isPrivate: bool
        - $hasNonstandardOrigin: bool
        --
        + initialize(): void
        + setHttpDownloader(HttpDownloader $httpDownloader): void
        + getComposerInformation(string $identifier): ?array
        + getFileContent(string $file, string $identifier): ?string
        + getChangeDate(string $identifier): ?DateTimeImmutable
        + getRepositoryUrl(): string
        + getUrl(): string
        + getDist(string $identifier): ?array
        + getSource(string $identifier): array
        + getRootIdentifier(): string
        + getBranches(): array
        + getTags(): array
        + getApiUrl(): string
        - urlEncodeAll(string $string): string
        # getReferences(string $type): array
        # fetchProject(): void
        # attemptCloneFallback(): bool
        # generateSshUrl(): string
        # generatePublicUrl(): string
        # setupGitDriver(string $url): void
        # getContents(string $url, bool $fetchingRepoData = false): Response
        + {static} supports(IOInterface $io, Config $config, string $url, bool $deep = false): bool
        + getRepoData(): ?array
        # getNextPage(Response $response): ?string
        - {static} determineOrigin(array $configuredDomains, string $guessedDomain, array &$urlParts, ?string $portNumber): string|false
    }

}

package "Composer\\Repository\\Vcs (Git fallback)" {
    class GitDriver {
    }
}

package "Composer\\Util" {
    class HttpDownloader {
    }
    class ProcessExecutor {
    }
    class Cache {
    }
    class GitHub <<utility>> {
    }
    class GitLab <<utility>> {
    }
}

package "Composer\\IO" {
    interface IOInterface {
    }
}

package "Composer\\Config" {
    class Config {
    }
}

' Inheritance & Implementation
VcsDriver ..|> VcsDriverInterface : implements
GitHubDriver --|> VcsDriver : extends
GitLabDriver --|> VcsDriver : extends

' Composition — nullable git fallback driver
GitHubDriver o-- GitDriver : $gitDriver (fallback)
GitLabDriver o-- GitDriver : $gitDriver (fallback)

' VcsDriver dependencies
VcsDriver ..> HttpDownloader : uses
VcsDriver ..> IOInterface : uses
VcsDriver ..> Config : uses
VcsDriver ..> ProcessExecutor : uses
VcsDriver ..> Cache : uses (optional)

' Subclass-specific utility dependencies
GitHubDriver ..> GitHub : OAuth handling
GitLabDriver ..> GitLab : OAuth + token refresh

@enduml
