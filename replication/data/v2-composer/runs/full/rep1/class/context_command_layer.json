  "traits": [
    "CompletionTrait — used by: ShowCommand, RequireCommand, UpdateCommand, InstallCommand, RemoveCommand, InitCommand, BumpCommand, ArchiveCommand, OutdatedCommand, DependsCommand, ProhibitsCommand, CreateProjectCommand, ReinstallCommand, HomeCommand, SuggestsCommand",
    "PackageDiscoveryTrait — used by: RequireCommand, InitCommand"
  ],
  "classes": {
    "BaseCommand": {
      "type": "abstract class",
      "extends": "Command",
      "attributes": [
        "private $composer: Composer|null",
        "private $io: IOInterface"
      ],
      "methods": [
        "getApplication(): Application",
        "requireComposer(?bool $disablePlugins, ?bool $disableScripts): Composer",
        "tryComposer(?bool $disablePlugins, ?bool $disableScripts): ?Composer",
        "getComposer(bool $required, ?bool $disablePlugins, ?bool $disableScripts): Composer|null [deprecated]",
        "setComposer(Composer $composer): void",
        "resetComposer(): void",
        "getIO(): IOInterface",
        "setIO(IOInterface $io): void",
        "isProxyCommand(): bool",
        "complete(CompletionInput $input, CompletionSuggestions $suggestions): void",
        "initialize(InputInterface $input, OutputInterface $output): void [protected]",
        "createComposerInstance(InputInterface, IOInterface, $config, ?bool, ?bool): Composer [protected]",
        "getPreferredInstallOptions(Config, InputInterface, bool): bool[] [protected]",
        "getPlatformRequirementFilter(InputInterface): PlatformRequirementFilterInterface [protected]",
        "formatRequirements(array<string>): array<string,string> [protected]",
        "normalizeRequirements(array<string>): list [protected]",
        "renderTable(array, OutputInterface): void [protected]",
        "getTerminalWidth(): int [protected]",
        "getAuditFormat(InputInterface, string $optName): string [protected]",
        "createPolicyConfig(Config, ?InputInterface): PolicyConfig [protected]",
        "createAuditConfig(InputInterface): AuditConfig [protected]"
      ]
    },
    "BaseConfigCommand": {
      "type": "abstract class",
      "extends": "BaseCommand",
      "attributes": [
        "protected $config: Config",
        "protected $configFile: JsonFile",
        "protected $configSource: JsonConfigSource"
      ],
      "methods": [
        "initialize(InputInterface, OutputInterface): void [protected]",
        "getComposerConfigFile(InputInterface, Config): string [protected]",
        "getAuthConfigFile(InputInterface, Config): string [protected]"
      ]
    },
    "ConfigCommand": {
      "type": "class",
      "extends": "BaseConfigCommand",
      "command_name": "config",
      "attributes": [
        "protected const CONFIGURABLE_PACKAGE_PROPERTIES: string[]",
        "protected $authConfigFile: JsonFile",
        "protected $authConfigSource: JsonConfigSource"
      ],
      "methods": [
        "configure(): void",
        "execute(InputInterface, OutputInterface): int [protected]"
      ]
    },
    "RepositoryCommand": {
      "type": "class",
      "extends": "BaseConfigCommand",
      "command_name": "repositories"
    },
    "PolicyCommand": {
      "type": "class",
      "extends": "BaseConfigCommand",
      "command_name": "policy"
    },
    "BaseDependencyCommand": {
      "type": "abstract class",
      "extends": "BaseCommand",
      "methods": [
        "execute(InputInterface, OutputInterface): int [protected]"
      ]
    },
    "DependsCommand": {
      "type": "class",
      "extends": "BaseDependencyCommand",
      "traits": ["CompletionTrait"],
      "command_name": "depends"
    },
    "ProhibitsCommand": {
      "type": "class",
      "extends": "BaseDependencyCommand",
      "traits": ["CompletionTrait"],
      "command_name": "prohibits"
    },
    "ShowCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "traits": ["CompletionTrait"],
      "command_name": "show",
      "aliases": ["info"],
      "attributes": [
        "protected $versionParser: VersionParser",
        "protected $colors: string[]",
        "private $repositorySet: ?RepositorySet"
      ],
      "methods": [
        "configure(): void",
        "execute(InputInterface, OutputInterface): int [protected]"
      ],
      "key_options": ["--all", "--locked", "--installed", "--platform", "--available", "--self", "--name-only", "--path", "--tree", "--latest", "--outdated", "--direct"]
    },
    "RequireCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "traits": ["CompletionTrait", "PackageDiscoveryTrait"],
      "command_name": "require",
      "aliases": ["r"],
      "attributes": [
        "private $newlyCreated: bool",
        "private $firstRequire: bool",
        "private $json: JsonFile",
        "private $file: string",
        "private $composerBackup: string",
        "private $lock: string",
        "private $lockBackup: ?string",
        "private $dependencyResolutionCompleted: bool"
      ],
      "methods": [
        "configure(): void",
        "execute(InputInterface, OutputInterface): int [protected]"
      ],
      "key_options": ["--dev", "--dry-run", "--prefer-install", "--no-update", "--no-audit"]
    },
    "UpdateCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "traits": ["CompletionTrait"],
      "command_name": "update",
      "aliases": ["u", "upgrade"],
      "methods": [
        "configure(): void",
        "execute(InputInterface, OutputInterface): int [protected]"
      ],
      "key_options": ["--with", "--dry-run", "--no-dev", "--lock", "--no-install", "--no-audit", "--with-dependencies", "--with-all-dependencies"]
    },
    "InstallCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "traits": ["CompletionTrait"],
      "command_name": "install",
      "aliases": ["i"],
      "methods": [
        "configure(): void",
        "execute(InputInterface, OutputInterface): int [protected]"
      ]
    },
    "RemoveCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "traits": ["CompletionTrait"],
      "command_name": "remove",
      "aliases": ["rm"]
    },
    "InitCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "traits": ["CompletionTrait", "PackageDiscoveryTrait"],
      "command_name": "init"
    },
    "BumpCommand": {
      "type": "final class",
      "extends": "BaseCommand",
      "traits": ["CompletionTrait"],
      "command_name": "bump"
    },
    "AuditCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "command_name": "audit"
    },
    "SelfUpdateCommand": {
      "type": "class",
      "extends": "BaseCommand",
      "command_name": "self-update"
    }
  },
  "key_relationships": [
    "BaseCommand extends Symfony\\Component\\Console\\Command\\Command",
    "BaseCommand aggregates Composer (nullable, lazy via Application)",
    "BaseCommand aggregates IOInterface (nullable, lazy via Application)",
    "BaseCommand depends_on Factory (createGlobal, create)",
    "BaseCommand depends_on Application (getComposer, getIO, resetComposer)",
    "BaseConfigCommand extends BaseCommand",
    "BaseConfigCommand aggregates Config, JsonFile, JsonConfigSource",
    "BaseConfigCommand depends_on Factory (createConfig)",
    "ConfigCommand extends BaseConfigCommand; adds authConfigFile, authConfigSource",
    "RepositoryCommand extends BaseConfigCommand",
    "PolicyCommand extends BaseConfigCommand",
    "BaseDependencyCommand extends BaseCommand",
    "DependsCommand extends BaseDependencyCommand uses CompletionTrait",
    "ProhibitsCommand extends BaseDependencyCommand uses CompletionTrait",
    "ShowCommand extends BaseCommand uses CompletionTrait; depends_on RepositorySet, VersionParser",
    "RequireCommand extends BaseCommand uses CompletionTrait+PackageDiscoveryTrait; depends_on Installer, JsonFile, JsonManipulator",
    "UpdateCommand extends BaseCommand uses CompletionTrait; depends_on Installer",
    "InstallCommand extends BaseCommand uses CompletionTrait; depends_on Installer",
    "CompletionTrait is a PHP trait (not a class), mixed into commands for tab-completion suggestions",
    "PackageDiscoveryTrait is a PHP trait for interactive package discovery (used in require/init)"
  ],
  "important_notes": "BaseCommand is abstract; all concrete commands override configure()+execute(). initialize() in BaseCommand handles plugin/script disable flags, env-var option overrides, and dispatches PreCommandRunEvent. BaseConfigCommand.initialize() additionally sets up config file references. CompletionTrait provides suggestPackageBasedOnMode/suggestInstalledPackage helpers. PackageDiscoveryTrait provides package search for interactive require/init. SelfUpdateCommand gets special treatment in BaseCommand.initialize() (plugins+scripts always disabled). Factory is the central dependency for creating Composer and Config instances.",
  "source_files_analyzed": [
