{
  "scope": "command_layer",
  "title": "Command Layer",
  "diagram_type": "class",
  "namespace": "Composer\\Command",
  "inheritance_hierarchy": [
    "Symfony\\Component\\Console\\Command\\Command (external root)",
    "  └─ BaseCommand (abstract) extends Command",
