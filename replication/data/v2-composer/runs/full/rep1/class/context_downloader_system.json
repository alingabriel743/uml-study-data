        "public static array $responseHeaders",
        "private array $lastCacheWrites",
        "private array $additionalCleanupPaths"
      ],
      "methods": [
        "__construct(IOInterface $io, Config $config, HttpDownloader $httpDownloader, ?EventDispatcher $eventDispatcher, ?Cache $cache, ?Filesystem $filesystem, ?ProcessExecutor $process)",
        "getInstallationSource(): string  // returns 'dist'",
        "download(PackageInterface $package, string $path, ?PackageInterface $prevPackage = null, bool $output = true): PromiseInterface",
        "prepare(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage = null): PromiseInterface",
        "cleanup(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage = null): PromiseInterface",
        "install(PackageInterface $package, string $path, bool $output = true): PromiseInterface",
        "update(PackageInterface $initial, PackageInterface $target, string $path): PromiseInterface",
        "remove(PackageInterface $package, string $path, bool $output = true): PromiseInterface",
        "getLocalChanges(PackageInterface $package, string $path): ?string",
        "protected getFileName(PackageInterface $package, string $path): string",
        "protected getDistPath(PackageInterface $package, int $component): string",
        "protected processUrl(PackageInterface $package, string $url): string",
        "protected getInstallOperationAppendix(PackageInterface $package, string $path): string",
        "protected clearLastCacheWrite(PackageInterface $package): void",
        "protected addCleanupPath(PackageInterface $package, string $path): void",
        "protected removeCleanupPath(PackageInterface $package, string $path): void"
      ],
      "key_behaviors": [
        "download(): tries up to 3 retries per URL, iterates distUrls; dispatches PRE_FILE_DOWNLOAD and POST_FILE_DOWNLOAD events; uses Cache (sha1 key) to avoid re-downloads",
        "install(): empties target dir, renames temp file, chmod binaries",
        "update(): calls remove() then install()",
        "getLocalChanges(): downloads to a _compare temp dir, uses Comparer to diff, removes temp dir"
      ]
    },
    {
      "name": "VcsDownloader",
      "type": "abstract class",
      "implements": ["DownloaderInterface", "ChangeReportInterface", "VcsCapableDownloaderInterface"],
      "attributes": [
        "protected IOInterface $io",
        "protected Config $config",
        "protected ProcessExecutor $process",
        "protected Filesystem $filesystem",
        "protected array $hasCleanedChanges"
      ],
      "methods": [
        "__construct(IOInterface $io, Config $config, ?ProcessExecutor $process = null, ?Filesystem $fs = null)",
        "getInstallationSource(): string  // returns 'source'",
        "download(PackageInterface $package, string $path, ?PackageInterface $prevPackage = null): PromiseInterface",
        "prepare(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage = null): PromiseInterface",
        "cleanup(string $type, PackageInterface $package, string $path, ?PackageInterface $prevPackage = null): PromiseInterface",
        "install(PackageInterface $package, string $path): PromiseInterface",
        "update(PackageInterface $initial, PackageInterface $target, string $path): PromiseInterface",
        "remove(PackageInterface $package, string $path): PromiseInterface",
        "getVcsReference(PackageInterface $package, string $path): ?string",
        "protected cleanChanges(PackageInterface $package, string $path, bool $update): PromiseInterface",
        "protected reapplyChanges(string $path): void",
        "private prepareUrls(array $urls): array",
        "abstract protected doDownload(PackageInterface $package, string $path, string $url, ?PackageInterface $prevPackage = null): PromiseInterface",
        "abstract protected doInstall(PackageInterface $package, string $path, string $url): PromiseInterface",
        "abstract protected doUpdate(PackageInterface $initial, PackageInterface $target, string $path, string $url): PromiseInterface",
        "abstract protected getCommitLogs(string $fromReference, string $toReference, string $path): string",
        "abstract protected hasMetadataRepository(string $path): bool"
      ],
      "key_behaviors": [
        "download(): delegates to doDownload() with URL fallback loop",
        "install(): delegates to doInstall() with URL fallback loop",
        "update(): delegates to doUpdate(); logs commit history via getCommitLogs() if verbose",
        "prepare(): on update calls cleanChanges(); on install emptyDirectory; on uninstall calls cleanChanges(false)",
        "cleanup(): on update calls reapplyChanges() if changes were cleaned",
        "getVcsReference(): uses VersionGuesser + ArrayDumper to detect current commit",
        "prepareUrls(): resolves local file:// paths via realpath"
      ]
    }
  ],

  "relationships": [
    "FileDownloader implements DownloaderInterface",
    "FileDownloader implements ChangeReportInterface",
    "VcsDownloader implements DownloaderInterface",
    "VcsDownloader implements ChangeReportInterface",
    "VcsDownloader implements VcsCapableDownloaderInterface",
    "FileDownloader depends_on HttpDownloader (composition — stored field)",
    "FileDownloader depends_on Cache (optional composition)",
    "FileDownloader depends_on EventDispatcher (optional composition)",
    "FileDownloader depends_on Filesystem (composition)",
    "FileDownloader depends_on ProcessExecutor (composition)",
    "FileDownloader depends_on Comparer (usage in getLocalChanges)",
    "VcsDownloader depends_on ProcessExecutor (composition)",
    "VcsDownloader depends_on Filesystem (composition)",
    "VcsDownloader depends_on VersionGuesser (usage in getVcsReference)",
    "VcsDownloader depends_on ArrayDumper (usage in getVcsReference)",
    "Both classes depend_on IOInterface (composition)",
    "Both classes depend_on Config (composition)",
    "Both classes depend_on PackageInterface (parameter/usage)",
    "DvcsDownloaderInterface exists independently — extends nothing; implemented by concrete DVCS VcsDownloader subclasses (e.g. GitDownloader)"
  ],

  "important_notes": [
    "FileDownloader is a CONCRETE class handling dist (archive/file) downloads; VcsDownloader is ABSTRACT for source VCS downloads",
    "VcsDownloader subclasses must implement: doDownload, doInstall, doUpdate, getCommitLogs, hasMetadataRepository, getLocalChanges",
    "FileDownloader.getInstallationSource() returns 'dist'; VcsDownloader returns 'source'",
    "Both use React\\Promise\\PromiseInterface for async operations",
    "FileDownloader uses a 3-retry + URL-fallback mechanism with cache (sha1 key-based)",
    "VcsDownloader.prepare()/cleanup() form a stash/restore pair for uncommitted changes across updates",
    "DvcsDownloaderInterface adds getUnpushedChanges() for DVCS systems (Git, Mercurial) — not implemented by VcsDownloader base"
  ],

