  "classes": [
    {
      "name": "FileDownloader",
      "type": "class",
      "implements": ["DownloaderInterface", "ChangeReportInterface"],
      "attributes": [
        "protected IOInterface $io",
        "protected Config $config",
        "protected HttpDownloader $httpDownloader",
        "protected Filesystem $filesystem",
