    "Installer depends_on AutoloadGenerator (composition)",
    "InstallationManager aggregates InstallerInterface (list<InstallerInterface> $installers, dynamic dispatch by package type)",
    "InstallationManager depends_on Loop (composition — for async promise waiting)",
    "InstallationManager depends_on EventDispatcher (optional, for package events)",
    "InstallationManager dispatches to InstallerInterface: install, update, uninstall, prepare, cleanup, download, getInstallPath"
  ],

  "interaction_flow": [
    "Installer::create(IOInterface, Composer): self — static factory pulling all deps from Composer",
    "Installer::run(): int — entry point; calls doUpdate() or doInstall() based on $update flag",
    "Installer::run() → eventDispatcher->dispatchScript(PRE_INSTALL_CMD | PRE_UPDATE_CMD)",
    "Installer::run() → doUpdate(localRepo, $install) OR doInstall(localRepo)",
    "Installer::doInstall() → installationManager->execute(repo, operations, devMode, runScripts, downloadOnly)",
    "InstallationManager::execute() → batches operations, calls downloadAndExecuteBatch() per batch",
    "InstallationManager::downloadAndExecuteBatch() → calls installer->download() for each op, then executeBatch()",
    "InstallationManager::executeBatch() → for each op: dispatcher->dispatchPackageEvent(PRE_*) → installer->prepare() → install/update/uninstall → cleanup → repo->write() → dispatcher->dispatchPackageEvent(POST_*)",
    "InstallationManager::getInstaller(type) → iterates $installers, calls installer->supports(type), caches result",
    "InstallationManager::install(repo, op) → getInstaller(type)->install(repo, package)",
    "InstallationManager::update(repo, op) → if same type: getInstaller->update(); else: uninstall then install",
    "InstallationManager::uninstall(repo, op) → getInstaller(type)->uninstall(repo, package)",
    "Installer::run() → installationManager->notifyInstalls(io) after operations complete"
  ],

  "important_notes": [
    "Installer is the top-level orchestrator; it uses fluent builder setters (return $this) for configuration",
    "Installer::run() returns int matching ERROR_* constants (0 = success)",
    "InstallationManager dispatches all per-package operations to registered InstallerInterface implementations",
    "Operations are batched: composer-plugin/composer-installer packages get their own batch to ensure activation order",
    "InstallationManager uses React/Promise for async download + install steps; Loop::wait() synchronizes",
    "Signal handling (SIGINT/SIGTERM/SIGHUP) in execute() runs cleanup promises before exit",
    "InstallerInterface is the extension point — any new package type registers a custom installer via addInstaller()",
    "Cache in InstallationManager maps package type string → InstallerInterface for O(1) repeated lookups"
  ],

