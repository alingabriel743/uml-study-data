{
  "scope": "package_model_hierarchy",
  "title": "Package Model Hierarchy",
  "diagram_type": "class",
  "namespace": "Composer\\Package",

  "interfaces": [
    {
      "name": "PackageInterface",
      "constants": ["DISPLAY_SOURCE_REF_IF_DEV=0", "DISPLAY_SOURCE_REF=1", "DISPLAY_DIST_REF=2"],
      "key_methods": [
        "getName(): string",
        "getPrettyName(): string",
        "getNames(bool $provides=true): array",
        "setId(int $id): void", "getId(): int",
        "isDev(): bool",
        "getType(): string",
        "getTargetDir(): ?string",
        "getExtra(): array",
        "setInstallationSource(?string $type): void", "getInstallationSource(): ?string",
        "getSourceType(): ?string", "getSourceUrl(): ?string", "getSourceUrls(): array",
        "getSourceReference(): ?string", "setSourceReference(?string $reference): void",
        "getSourceMirrors(): ?array", "setSourceMirrors(?array $mirrors): void",
        "getDistType(): ?string", "getDistUrl(): ?string", "getDistUrls(): array",
        "getDistReference(): ?string", "setDistReference(?string $reference): void",
        "getDistSha1Checksum(): ?string",
        "getDistMirrors(): ?array", "setDistMirrors(?array $mirrors): void",
        "getVersion(): string", "getPrettyVersion(): string",
        "getFullPrettyVersion(bool $truncate=true, int $displayMode): string",
        "getReleaseDate(): ?DateTimeInterface",
        "getStability(): string",
        "getRequires(): array", "getConflicts(): array", "getProvides(): array",
        "getReplaces(): array", "getDevRequires(): array", "getSuggests(): array",
        "getAutoload(): array", "getDevAutoload(): array",
        "getIncludePaths(): array", "getPhpExt(): ?array",
        "setRepository(RepositoryInterface): void", "getRepository(): ?RepositoryInterface",
        "getBinaries(): array",
        "getUniqueName(): string", "getNotificationUrl(): ?string",
        "__toString(): string", "getPrettyString(): string",
        "isDefaultBranch(): bool",
        "getTransportOptions(): array", "setTransportOptions(array): void",
        "setDistUrl(?string): void", "setDistType(?string): void",
        "setSourceDistReferences(string): void"
      ]
    },
    {
      "name": "CompletePackageInterface",
      "extends": "PackageInterface",
      "key_methods": [
        "getScripts(): array", "setScripts(array): void",
        "getRepositories(): array", "setRepositories(array): void",
        "getLicense(): array", "setLicense(array): void",
        "getKeywords(): array", "setKeywords(array): void",
        "getDescription(): ?string", "setDescription(?string): void",
        "getHomepage(): ?string", "setHomepage(?string): void",
        "getAuthors(): array", "setAuthors(array): void",
        "getSupport(): array", "setSupport(array): void",
        "getFunding(): array", "setFunding(array): void",
        "isAbandoned(): bool", "getReplacementPackage(): ?string", "setAbandoned(bool|string): void",
        "getArchiveName(): ?string", "setArchiveName(?string): void",
        "getArchiveExcludes(): array", "setArchiveExcludes(array): void"
      ]
    },
    {
      "name": "RootPackageInterface",
      "extends": "CompletePackageInterface",
      "key_methods": [
        "getAliases(): array", "setAliases(array): void",
        "getMinimumStability(): string", "setMinimumStability(string): void",
        "getStabilityFlags(): array", "setStabilityFlags(array): void",
        "getReferences(): array", "setReferences(array): void",
        "getPreferStable(): bool", "setPreferStable(bool): void",
        "getConfig(): array", "setConfig(array): void",
        "setRequires(array): void", "setDevRequires(array): void",
        "setConflicts(array): void", "setProvides(array): void",
        "setReplaces(array): void",
        "setAutoload(array): void", "setDevAutoload(array): void",
        "setSuggests(array): void", "setExtra(array): void"
      ]
    }
  ],

  "abstract_classes": [
    {
      "name": "BasePackage",
      "implements": "PackageInterface",
      "modifier": "abstract",
      "static_properties": [
        "$supportedLinkTypes: array (require/conflict/provide/replace/require-dev → Link::TYPE_*)",
        "$stabilities: array (deprecated readonly)",
        "STABILITIES: array<string,int>",
        "STABILITY_STABLE=0, STABILITY_RC=5, STABILITY_BETA=10, STABILITY_ALPHA=15, STABILITY_DEV=20"
      ],
      "properties": [
        "$id: int (public, READ-ONLY, solver use)",
        "$name: string (protected)",
        "$prettyName: string (protected)",
        "$repository: ?RepositoryInterface (protected)"
      ],
      "constructor": "__construct(string $name) — lowercases name, sets id=-1",
      "key_methods": [
        "getName(): string", "getPrettyName(): string",
        "getNames(bool $provides=true): array — merges provides+replaces targets",
        "setId(int): void", "getId(): int",
        "setRepository(RepositoryInterface): void — throws LogicException if already in different repo",
        "getRepository(): ?RepositoryInterface",
        "isPlatform(): bool — checks instanceof PlatformRepository",
        "getUniqueName(): string — name-version",
        "equals(PackageInterface): bool — unwraps AliasPackage via getAliasOf()",
        "__toString(): string — calls getUniqueName()",
        "getPrettyString(): string",
        "getFullPrettyVersion(bool, int): string",
        "getStabilityPriority(): int",
        "__clone() — resets repository=null, id=-1",
        "packageNameToRegexp(string, string): string (static)",
        "packageNamesToRegexp(array, string): string (static)"
      ]
    }
  ],

  "concrete_classes": [
    {
      "name": "Package",
      "extends": "BasePackage",
      "constructor": "__construct(string $name, string $version, string $prettyVersion) — calls parent::__construct($name); sets version, stability via VersionParser::parseStability()",
      "key_properties": [
        "$type, $targetDir, $installationSource (source|dist|null)",
        "$sourceType, $sourceUrl, $sourceReference, $sourceMirrors",
        "$distType, $distUrl, $distReference, $distSha1Checksum, $distMirrors",
        "$version, $prettyVersion, $releaseDate",
        "$extra, $binaries, $dev, $stability, $notificationUrl",
        "$requires, $conflicts, $provides, $replaces, $devRequires (array<string,Link>)",
        "$suggests (array<string,string>), $autoload, $devAutoload",
        "$includePaths, $isDefaultBranch, $transportOptions, $phpExt"
      ],
      "key_methods": [
        "getSourceUrls(): array — delegates to getUrls(sourceUrl, sourceMirrors, ...)",
        "getDistUrls(): array — delegates to getUrls(distUrl, distMirrors, ...)",
        "setSourceDistReferences(string): void — updates source ref + dist URL for GitHub/GitLab/Bitbucket",
        "replaceVersion(string, string): void — updates version+stability",
        "convertLinksToMap(array, string): array (private) — deprecated indexed-array conversion",
        "getUrls(?string, ?array, ?string, ?string, string): array (protected)"
      ]
    },
    {
      "name": "CompletePackage",
      "extends": "Package",
      "implements": "CompletePackageInterface",
      "added_properties": [
        "$repositories, $license, $keywords",
        "$authors (array<array{name?,homepage?,email?,role?}>)",
        "$description, $homepage",
        "$scripts (array<string,string[]>)",
        "$support, $funding",
        "$abandoned (bool|string)",
        "$archiveName, $archiveExcludes"
      ],
      "note": "Package containing additional metadata not used by the solver"
    },
    {
      "name": "RootPackage",
      "extends": "CompletePackage",
      "implements": "RootPackageInterface",
      "added_properties": [
        "$minimumStability: string = 'stable'",
        "$preferStable: bool = false",
        "$stabilityFlags: array<string, STABILITY_*>",
        "$config: mixed[]",
        "$references: array<string,string>",
        "$aliases: list<array{package,version,alias,alias_normalized}>"
      ],
      "constant": "DEFAULT_PRETTY_VERSION = '1.0.0+no-version-set'",
      "note": "Represents the project's composer.json root"
    },
    {
      "name": "AliasPackage",
      "extends": "BasePackage",
      "constructor": "__construct(BasePackage $aliasOf, string $version, string $prettyVersion) — clones link arrays from aliasOf, calls replaceSelfVersionDependencies()",
      "key_properties": [
        "$version, $prettyVersion, $dev, $stability",
        "$rootPackageAlias: bool",
        "$hasSelfVersionRequires: bool",
        "$aliasOf: BasePackage",
        "$requires, $devRequires, $conflicts, $provides, $replaces: Link[]"
      ],
      "key_methods": [
        "getAliasOf(): BasePackage",
        "setRootPackageAlias(bool): void", "isRootPackageAlias(): bool",
        "hasSelfVersionRequires(): bool",
        "replaceSelfVersionDependencies(array, linkType): array — replaces self.version constraints",
        "__toString(): string — appends '(alias of X)'",
        "All other getters/setters DELEGATE to $aliasOf (Decorator pattern)"
      ],
      "note": "Decorator wrapping BasePackage — most calls proxied to aliasOf"
    },
    {
      "name": "CompleteAliasPackage",
      "extends": "AliasPackage",
      "implements": "CompletePackageInterface",
      "constructor": "__construct(CompletePackage $aliasOf, string $version, string $prettyVersion)",
      "key_properties": ["$aliasOf: CompletePackage (override type)"],
      "note": "All CompletePackageInterface methods delegate to $aliasOf (CompletePackage). getAliasOf() returns CompletePackage."
    },
    {
      "name": "RootAliasPackage",
      "extends": "CompleteAliasPackage",
      "implements": "RootPackageInterface",
      "constructor": "__construct(RootPackage $aliasOf, string $version, string $prettyVersion)",
      "key_properties": ["$aliasOf: RootPackage (override type)"],
      "note": "All RootPackageInterface methods delegate to $aliasOf (RootPackage)."
    }
  ],

  "inheritance_hierarchy": [
    "PackageInterface",
    "  └─ CompletePackageInterface extends PackageInterface",
    "       └─ RootPackageInterface extends CompletePackageInterface",
    "BasePackage implements PackageInterface (abstract)",
    "  └─ Package extends BasePackage",
    "       └─ CompletePackage extends Package, implements CompletePackageInterface",
    "            └─ RootPackage extends CompletePackage, implements RootPackageInterface",
    "  └─ AliasPackage extends BasePackage",
    "       └─ CompleteAliasPackage extends AliasPackage, implements CompletePackageInterface",
    "            └─ RootAliasPackage extends CompleteAliasPackage, implements RootPackageInterface"
  ],

  "key_relationships": [
    "BasePackage implements PackageInterface",
    "Package extends BasePackage (adds version/dist/source/dependency fields)",
    "CompletePackage extends Package + implements CompletePackageInterface (adds metadata: license, keywords, authors, etc.)",
    "RootPackage extends CompletePackage + implements RootPackageInterface (adds stability config, aliases, references)",
    "AliasPackage extends BasePackage (Decorator — wraps BasePackage $aliasOf, proxies most calls)",
    "CompleteAliasPackage extends AliasPackage + implements CompletePackageInterface (wraps CompletePackage)",
    "RootAliasPackage extends CompleteAliasPackage + implements RootPackageInterface (wraps RootPackage)",
    "AliasPackage composition: $aliasOf: BasePackage",
    "CompleteAliasPackage composition: $aliasOf: CompletePackage",
    "RootAliasPackage composition: $aliasOf: RootPackage",
    "BasePackage association: $repository: RepositoryInterface",
    "Package/AliasPackage use Link[] for dependency relationships (requires/conflicts/provides/replaces/devRequires)"
  ],

  "design_patterns": [
    "Decorator pattern: AliasPackage wraps BasePackage and proxies interface calls — allows aliasing a package version without full duplication",
    "Template Method: BasePackage provides base getName/getNames/equals; subclasses provide getVersion/getStability",
    "Two parallel hierarchies (Package chain vs AliasPackage chain) mirroring interface hierarchy"
  ],

  "important_notes": "All interfaces (PackageInterface and derivatives) are considered internal — not for external extension. AliasPackage delegates ~25 methods directly to $aliasOf. BasePackage::equals() unwraps AliasPackage via getAliasOf() before comparison. BasePackage::getNames() collects provides+replaces targets. Package::setSourceDistReferences() auto-updates dist URL for GitHub/GitLab/Bitbucket URLs. Stability constants: STABLE=0, RC=5, BETA=10, ALPHA=15, DEV=20.",

  "source_files_analyzed": [
    "src/Composer/Package/PackageInterface.php",
    "src/Composer/Package/BasePackage.php",
    "src/Composer/Package/Package.php",
    "src/Composer/Package/AliasPackage.php",
    "src/Composer/Package/CompletePackage.php",
    "src/Composer/Package/CompleteAliasPackage.php",
    "src/Composer/Package/CompletePackageInterface.php",
    "src/Composer/Package/RootPackageInterface.php",
    "src/Composer/Package/RootPackage.php",
    "src/Composer/Package/RootAliasPackage.php"
  ]
}
