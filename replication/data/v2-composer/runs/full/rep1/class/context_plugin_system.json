  "relationships": [
    "PluginManager aggregates PluginInterface[] (plugins registry)",
    "PluginManager depends_on Composer (constructor injection)",
    "PluginManager depends_on IOInterface (constructor injection)",
    "PluginManager depends_on PartialComposer (global composer, optional)",
    "PluginManager uses PackageInterface (registerPackage / deactivatePackage)",
    "PluginManager uses Capability\\Capability (getPluginCapability return type)",
    "PluginManager checks Capable interface to determine if plugin has capabilities",
    "PluginManager dispatches events via EventDispatcher (addSubscriber on activate, removeListener on remove)",
    "PluginInterface is implemented by concrete plugins (external)",
    "Capable extends nothing — standalone interface implemented alongside PluginInterface",
    "Capability\\CommandProvider extends Capability\\Capability",
    "CommandEvent extends EventDispatcher\\Event",
    "PreFileDownloadEvent extends EventDispatcher\\Event",
    "PostFileDownloadEvent extends EventDispatcher\\Event",
    "PreCommandRunEvent extends EventDispatcher\\Event",
    "PrePoolCreateEvent extends EventDispatcher\\Event",
    "PluginBlockedException extends UnexpectedValueException",
    "PluginEvents provides string constants consumed by EventDispatcher"
  ],

  "key_flows": [
    "loadInstalledPlugins → loadRepository → registerPackage → addPlugin → plugin.activate(composer, io)",
    "addPlugin: if plugin is EventSubscriberInterface → eventDispatcher.addSubscriber(plugin)",
    "removePlugin → plugin.deactivate(composer, io) → eventDispatcher.removeListener(plugin)",
    "uninstallPlugin → plugin.uninstall(composer, io)",
    "getPluginCapability: checks plugin instanceof Capable → getCapabilityImplementationClassName → instantiates capability class",
    "getPluginCapabilities: iterates all plugins → calls getPluginCapability per plugin",
    "registerPackage: validates composer-plugin-api version, checks isPluginAllowed, builds autoloader, evals class if already loaded to rename, then calls addPlugin",
    "isPluginAllowed: checks allowPluginRules map (regex patterns); throws PluginBlockedException if blocked"
  ],

  "important_notes": [
    "PluginInterface.PLUGIN_API_VERSION = '2.9.0'",
    "Plugins can optionally implement Capable to expose capabilities (e.g. CommandProvider)",
    "PluginManager handles both 'local' and 'global' plugin scopes independently",
    "allow-plugins security feature: plugins must be explicitly allowed in composer.json",
    "Legacy composer-installer type (type='composer-installer') is also supported for BC",
    "If a plugin class is already loaded, PluginManager evals a renamed copy (classCounter suffix) to avoid conflicts",
    "PluginEvents is a pure constants class — no instantiation needed",
    "PrePoolCreateEvent allows plugins to filter packages before dependency resolution"
  ],

  "external_dependencies": [
    "Composer\\EventDispatcher\\Event (base for all event classes)",
    "Composer\\EventDispatcher\\EventSubscriberInterface (implemented by subscribing plugins)",
    "Composer\\Installer\\InstallerInterface (legacy BC for composer-installer type)",
    "Composer\\Package\\PackageInterface, CompletePackage, RootPackageInterface",
    "Composer\\Repository\\RepositoryInterface, InstalledRepository",
    "Symfony\\Component\\Console\\Input\\InputInterface",
    "Symfony\\Component\\Console\\Output\\OutputInterface"
  ],

