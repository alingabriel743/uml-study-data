{
  "scope": "repository_system",
  "title": "Repository System",
  "diagram_type": "class",
  "namespace": "Composer\\Repository",

  "interfaces": [
    {
      "name": "RepositoryInterface",
      "extends": ["\\Countable"],
      "constants": ["SEARCH_FULLTEXT=0", "SEARCH_NAME=1", "SEARCH_VENDOR=2"],
      "methods": [
        "hasPackage(PackageInterface $package): bool",
        "findPackage(string $name, $constraint): ?BasePackage",
        "findPackages(string $name, $constraint=null): BasePackage[]",
        "getPackages(): BasePackage[]",
        "loadPackages(array $packageNameMap, array $acceptableStabilities, array $stabilityFlags, array $alreadyLoaded=[]): array",
        "search(string $query, int $mode=0, ?string $type=null): array[]",
        "getProviders(string $packageName): array[]",
        "getRepoName(): string"
      ]
    },
    {
      "name": "WritableRepositoryInterface",
      "extends": ["RepositoryInterface"],
      "methods": [
        "write(bool $devMode, InstallationManager $installationManager): void",
        "addPackage(PackageInterface $package): void",
        "removePackage(PackageInterface $package): void",
        "getCanonicalPackages(): PackageInterface[]",
        "reload(): void",
        "setDevPackageNames(array $devPackageNames): void",
        "getDevPackageNames(): string[]"
      ]
    },
    {
      "name": "InstalledRepositoryInterface",
      "extends": ["WritableRepositoryInterface"],
      "methods": [
        "getDevMode(): bool|null",
        "isFresh(): bool"
      ]
    },
    {
      "name": "ConfigurableRepositoryInterface",
      "extends": [],
      "methods": [
        "getRepoConfig(): mixed[]"
      ]
    },
    {
      "name": "AdvisoryProviderInterface",
      "extends": [],
      "methods": [
        "hasSecurityAdvisories(): bool",
        "getSecurityAdvisories(array $packageConstraintMap, bool $allowPartialAdvisories=false): array"
      ]
    },
    {
      "name": "FilterListProviderInterface",
      "extends": [],
      "methods": [
        "hasFilter(): bool",
        "getFilter(array $packageConstraintMap, array $configuredLists): array",
        "getFilterLists(): array"
      ]
    },
    {
      "name": "VersionCacheInterface",
      "extends": [],
      "methods": [
        "getVersionPackage(string $version, string $identifier): mixed[]|null|false"
      ]
    }
  ],

  "classes": [
