  "key_relationships": [
    "RepositoryInterface extends \\Countable",
    "WritableRepositoryInterface extends RepositoryInterface",
    "InstalledRepositoryInterface extends WritableRepositoryInterface",
    "ArrayRepository implements RepositoryInterface",
    "WritableArrayRepository extends ArrayRepository, implements WritableRepositoryInterface, uses CanonicalPackagesTrait",
    "FilesystemRepository extends WritableArrayRepository",
    "InstalledArrayRepository extends WritableArrayRepository, implements InstalledRepositoryInterface",
    "InstalledFilesystemRepository extends FilesystemRepository, implements InstalledRepositoryInterface",
    "LockArrayRepository extends ArrayRepository",
    "RootPackageRepository extends ArrayRepository",
    "VcsRepository extends ArrayRepository, implements ConfigurableRepositoryInterface",
    "ComposerRepository extends ArrayRepository, implements ConfigurableRepositoryInterface + AdvisoryProviderInterface + FilterListProviderInterface",
    "PackageRepository extends ArrayRepository, implements AdvisoryProviderInterface + FilterListProviderInterface",
    "VcsRepository depends_on VcsDriverInterface (via $driver)",
    "VcsRepository depends_on VersionCacheInterface",
    "ComposerRepository depends_on HttpDownloader, Cache, EventDispatcher, Loop, ArrayLoader",
    "ComposerRepository depends_on ComposerRepositoryFilterInformation, FilterListApiClient"
  ],

  "important_notes": [
    "ArrayRepository is the central base class — all concrete repos extend it",
    "RepositoryInterface defines the core contract: hasPackage, findPackage, findPackages, getPackages, loadPackages, search, getProviders, getRepoName",
    "ConfigurableRepositoryInterface is a marker/accessor interface: only getRepoConfig(). Implemented by both VcsRepository and ComposerRepository",
    "AdvisoryProviderInterface adds security advisory queries; FilterListProviderInterface adds filter list queries. ComposerRepository implements both",
    "VcsRepository selects a VcsDriverInterface implementation at runtime (github/gitlab/bitbucket/git/hg/svn etc) based on repoConfig type",
    "WritableRepositoryInterface adds write/reload/canonical-packages contract; InstalledRepositoryInterface further adds isFresh/getDevMode",
    "CanonicalPackagesTrait provides getCanonicalPackages() implementation shared across WritableArrayRepository subclasses",
    "ComposerRepository uses lazy providers / available package list for large Packagist-style repositories; supports partial packages and degraded mode"
  ],

