    {
      "name": "PackageRepository",
      "extends": "ArrayRepository",
      "implements": ["AdvisoryProviderInterface", "FilterListProviderInterface"],
      "notes": "Mirrors advisory and filter capabilities from a ComposerRepository for a specific package set"
    }
