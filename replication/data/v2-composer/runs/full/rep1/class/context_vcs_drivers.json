{
  "scope": "vcs_drivers",
  "title": "VCS Drivers",
  "diagram_type": "class",
  "namespace": "Composer\\Repository\\Vcs",

  "classes": [
    {
      "name": "VcsDriverInterface",
      "type": "interface",
      "methods": [
        "initialize(): void",
        "getComposerInformation(string $identifier): ?array",
        "getFileContent(string $file, string $identifier): ?string",
        "getChangeDate(string $identifier): ?DateTimeImmutable",
        "getRootIdentifier(): string",
        "getBranches(): array",
        "getTags(): array",
        "getDist(string $identifier): ?array",
        "getSource(string $identifier): array",
        "getUrl(): string",
        "hasComposerFile(string $identifier): bool",
        "cleanup(): void",
        "static supports(IOInterface $io, Config $config, string $url, bool $deep = false): bool"
      ]
    },
    {
      "name": "VcsDriver",
      "type": "abstract class",
      "implements": ["VcsDriverInterface"],
      "properties": [
        "# $url: string",
        "# $originUrl: string",
        "# $repoConfig: array",
        "# $io: IOInterface",
        "# $config: Config",
        "# $process: ProcessExecutor",
        "# $httpDownloader: HttpDownloader",
        "# $infoCache: array",
        "# $cache: ?Cache"
      ],
      "methods": [
        "+ final __construct(array $repoConfig, IOInterface $io, Config $config, HttpDownloader $httpDownloader, ProcessExecutor $process)",
        "# shouldCache(string $identifier): bool",
        "+ getComposerInformation(string $identifier): ?array",
        "# getBaseComposerInformation(string $identifier): ?array",
        "+ hasComposerFile(string $identifier): bool",
        "# getScheme(): string",
        "# getContents(string $url): Response",
        "+ cleanup(): void"
      ],
      "notes": "Constructor is final; getContents() uses $httpDownloader->get(); getBaseComposerInformation() fetches composer.json via getFileContent()"
    },
    {
      "name": "GitHubDriver",
      "type": "class",
      "extends": "VcsDriver",
      "properties": [
        "# $owner: string",
        "# $repository: string",
        "# $tags: array",
        "# $branches: array",
        "# $rootIdentifier: string",
        "# $repoData: array",
        "# $hasIssues: bool",
        "# $isPrivate: bool",
        "- $isArchived: bool",
        "- $fundingInfo: array|false|null",
        "- $allowGitFallback: bool",
        "# $gitDriver: ?GitDriver"
      ],
      "methods": [
        "+ initialize(): void",
        "+ getRepositoryUrl(): string",
        "+ getRootIdentifier(): string",
        "+ getUrl(): string",
        "# getApiUrl(): string",
        "+ getSource(string $identifier): array",
        "+ getDist(string $identifier): ?array",
        "+ getComposerInformation(string $identifier): ?array",
        "- getFundingInfo(): array|false",
        "+ getFileContent(string $file, string $identifier): ?string",
        "+ getChangeDate(string $identifier): ?DateTimeImmutable",
        "+ getTags(): array",
        "+ getBranches(): array",
        "+ static supports(IOInterface $io, Config $config, string $url, bool $deep = false): bool",
        "+ getRepoData(): ?array",
        "# generateSshUrl(): string",
        "# getContents(string $url, bool $fetchingRepoData = false): Response",
        "# fetchRootIdentifier(): void",
        "# attemptCloneFallback(?Throwable $e = null): bool",
        "# setupGitDriver(string $url): void",
        "# getNextPage(Response $response): ?string"
      ],
      "notes": "Uses GitHub REST API (api.github.com or /api/v3 for GHE). Delegates to $gitDriver when set. fetchRootIdentifier() calls getContents($repoDataUrl, true). On 401/403/404 TransportException: attempts OAuth, then interactive auth, then SSH clone fallback."
    },
    {
      "name": "GitLabDriver",
      "type": "class",
      "extends": "VcsDriver",
      "constants": ["URL_REGEX"],
      "properties": [
        "- $scheme: string (https|http)",
        "- $namespace: string",
        "- $repository: string",
        "- $project: array",
        "- $commits: array",
        "- $tags: array",
        "- $branches: array",
        "# $gitDriver: ?GitDriver",
        "# $protocol: string",
        "- $isPrivate: bool",
        "- $hasNonstandardOrigin: bool"
      ],
      "methods": [
        "+ initialize(): void",
        "+ setHttpDownloader(HttpDownloader $httpDownloader): void",
        "+ getComposerInformation(string $identifier): ?array",
        "+ getFileContent(string $file, string $identifier): ?string",
        "+ getChangeDate(string $identifier): ?DateTimeImmutable",
        "+ getRepositoryUrl(): string",
        "+ getUrl(): string",
        "+ getDist(string $identifier): ?array",
        "+ getSource(string $identifier): array",
        "+ getRootIdentifier(): string",
        "+ getBranches(): array",
        "+ getTags(): array",
        "+ getApiUrl(): string",
        "- urlEncodeAll(string $string): string",
        "# getReferences(string $type): array",
        "# fetchProject(): void",
        "# attemptCloneFallback(): bool",
        "# generateSshUrl(): string",
        "# generatePublicUrl(): string",
        "# setupGitDriver(string $url): void",
        "# getContents(string $url, bool $fetchingRepoData = false): Response",
        "+ static supports(IOInterface $io, Config $config, string $url, bool $deep = false): bool",
        "+ getRepoData(): ?array",
        "# getNextPage(Response $response): ?string",
        "- static determineOrigin(array $configuredDomains, string $guessedDomain, array &$urlParts, ?string $portNumber): string|false"
      ],
      "notes": "Uses GitLab API v4 (/api/v4/projects/namespace%2Frepo). getBranches/getTags both delegate to getReferences(). Handles OAuth token refresh via GitLab util. On auth failure falls back to GitDriver (SSH or public HTTP)."
    }
  ],

  "key_relationships": [
    "VcsDriver implements VcsDriverInterface",
    "GitHubDriver extends VcsDriver",
    "GitLabDriver extends VcsDriver",
    "GitHubDriver composes GitDriver (fallback, nullable)",
    "GitLabDriver composes GitDriver (fallback, nullable)",
    "VcsDriver depends_on HttpDownloader (HTTP calls)",
    "VcsDriver depends_on IOInterface (user interaction)",
    "VcsDriver depends_on Config (configuration)",
    "VcsDriver depends_on ProcessExecutor (shell commands)",
    "VcsDriver depends_on Cache (response caching)",
    "GitHubDriver depends_on GitHub utility (OAuth handling)",
    "GitLabDriver depends_on GitLab utility (OAuth + token refresh)"
  ],

  "inheritance_chain": "VcsDriverInterface <- VcsDriver (abstract) <- GitHubDriver | GitLabDriver",

  "fallback_pattern": "Both GitHubDriver and GitLabDriver hold a ?GitDriver $gitDriver. When API access fails (auth error, no-api flag), setupGitDriver(url) instantiates GitDriver and delegates all method calls to it.",

  "api_patterns": {
    "GitHubDriver": "GET https://api.github.com/repos/{owner}/{repo} + pagination via Link header",
    "GitLabDriver": "GET https://{origin}/api/v4/projects/{namespace}%2F{repo} + pagination via Link header"
  },

  "caching": "VcsDriver.shouldCache() returns true for 40-char hex SHA identifiers. Cache read/write in getComposerInformation() in both subclasses.",

  "source_files_analyzed": [
    "src/Composer/Repository/Vcs/VcsDriverInterface.php",
    "src/Composer/Repository/Vcs/VcsDriver.php",
    "src/Composer/Repository/Vcs/GitHubDriver.php",
    "src/Composer/Repository/Vcs/GitLabDriver.php"
  ]
}
