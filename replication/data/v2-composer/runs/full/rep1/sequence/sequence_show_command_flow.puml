@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    GroupBorderColor #6C757D
    GroupBackgroundColor #DEE2E6
    GroupFontColor #212529
    DividerBorderColor #6C757D
    DividerBackgroundColor #E9ECEF
    DividerFontColor #212529
    BoxBorderColor #ADB5BD
    BoxBackgroundColor #F1F3F5
}
skinparam note {
    BackgroundColor #FFF3CD
    BorderColor #FFC107
}

title Show Command Flow

actor User
participant "ShowCommand" as show
participant "BaseCommand" as base
participant "Application" as app
participant "Composer" as composer
participant "EventDispatcher" as events
participant "RepositoryManager" as repoMgr
participant "InstalledRepository" as instRepo
participant "ComposerRepository" as compRepo
participant "RepositorySet\n/ Pool" as repoSet
participant "DefaultPolicy\n/ VersionSelector" as policy
participant "ConsoleIO" as io

== Initialization ==

User -> show : composer show [package] [version] [options]
activate show

show -> base : tryComposer()
activate base
base -> app : getComposer(false)
activate app
app --> base : Composer|null
deactivate app
base --> show : Composer|null
deactivate base

show -> base : getIO()
activate base
base -> app : getIO()
activate app
app --> base : IOInterface
deactivate app
base --> show : IOInterface (ConsoleIO)
deactivate base

show -> base : getPlatformRequirementFilter(input)
activate base
base --> show : PlatformRequirementFilterInterface
deactivate base

== Repository Initialization ==

alt --self option
    show -> composer : getPackage()
    activate composer
    composer --> show : RootPackage
    deactivate composer
    show -> instRepo : new InstalledRepository([RootPackageRepository])
    activate instRepo
    instRepo --> show : installedRepo
    deactivate instRepo

else --platform option
    show -> instRepo : new InstalledRepository([PlatformRepository])
    activate instRepo
    instRepo --> show : installedRepo
    deactivate instRepo

else --available option
    show -> composer : getRepositoryManager()
    activate composer
    composer --> show : RepositoryManager
    deactivate composer
    show -> repoMgr : getRepositories()
    activate repoMgr
    repoMgr --> show : repos[]
    deactivate repoMgr
    show -> instRepo : new CompositeRepository(repos)
    activate instRepo
    instRepo --> show : compositeRepo
    deactivate instRepo

else --locked option
    show -> composer : getLocker().getLockedRepository()
    activate composer
    composer --> show : lockedRepo
    deactivate composer
    show -> instRepo : new InstalledRepository([lockedRepo])
    activate instRepo
    instRepo --> show : installedRepo
    deactivate instRepo

else default / --installed
    show -> composer : getRepositoryManager()
    activate composer
    composer --> show : RepositoryManager
    deactivate composer
    show -> repoMgr : getLocalRepository()
    activate repoMgr
    repoMgr --> show : localRepo
    deactivate repoMgr
    show -> instRepo : new InstalledRepository([rootRepo, localRepo])
    activate instRepo
    instRepo --> show : installedRepo
    deactivate instRepo
end

== Plugin / Event Hook ==

show -> composer : getEventDispatcher()
activate composer
composer --> show : EventDispatcher
deactivate composer
show -> events : dispatch(CommandEvent('show'))
activate events
events --> show : (plugins notified)
deactivate events

== Single Package Resolution ==

opt Single package requested (no wildcard)
    show -> repoSet : new RepositorySet('dev')
    activate repoSet
    show -> repoSet : addRepository(repos)
    show -> repoSet : createPoolForPackage(name)
    repoSet --> show : Pool
    show -> repoSet : Pool::whatProvides(name, constraint)
    repoSet --> show : PackageInterface[]
    deactivate repoSet

    show -> policy : DefaultPolicy::selectPreferredPackages(pool, literals)
    activate policy
    policy --> show : preferredIds[]
    show -> policy : Pool::literalToPackage(id)
    policy --> show : CompletePackageInterface
    deactivate policy
end

== Tree Mode ==

opt --tree flag
    show -> show : generatePackageTree(package, installedRepo, repos)
    activate show #DDE8FF
    show -> show : package.getRequires()
    note right : returns Link[]
    loop for each dependency link
        show -> show : addTree(name, link, installedRepo, repos, packagesInTree)
        note right : recursive; circular\ndeps tracked via\n$packagesInTree
    end
    deactivate show #DDE8FF

    show -> show : displayPackageTree(arrayTree)
    activate show #DDE8FF
    loop for each tree node
        show -> show : displayTree(require, packagesInTree, treeBar, level)
        show -> io : write(treeLineFormatted)
        activate io
        io --> show : (output rendered)
        deactivate io
    end
    deactivate show #DDE8FF
end

== Package Listing Mode ==

opt Package list (no single package, no tree)
    show -> show : RepositoryUtils::flattenRepositories(repos)
    note right : returns flattened repo[]

    loop for each ComposerRepository
        show -> compRepo : getPackageNames(packageFilter)
        activate compRepo
        note right : lazy remote listing —\navoids full metadata download
        compRepo --> show : string[]
        deactivate compRepo
    end

    loop for other repositories
        show -> instRepo : getPackages()
        activate instRepo
        instRepo --> show : PackageInterface[]
        deactivate instRepo
    end

    opt --latest flag
        show -> show : findLatestPackage(pkg, composer, platformRepo, flags, filter)
        activate show #DDE8FF
        show -> repoSet : getRepositorySet(composer)
        activate repoSet
        repoSet --> show : RepositorySet + CompositeRepository
        deactivate repoSet
        show -> policy : new VersionSelector(repositorySet, platformRepo)
        activate policy
        show -> policy : findBestCandidate(name, targetVersion, stability, platformReqFilter)
        policy --> show : latestPackage|false
        deactivate policy
        deactivate show #DDE8FF
    end
end

== Output Rendering ==

alt JSON output
    show -> io : write(JsonFile::encode(viewData))
    activate io
    io --> show : (JSON printed)
    deactivate io

else Text output — single package
    show -> show : printPackageInfo(package, versions, installedRepo, latestPackage)
    activate show #DDE8FF
    show -> io : write(name / description / keywords / version / type / ...)
    activate io
    io --> show : ok
    deactivate io
    show -> instRepo : findPackages(name)
    activate instRepo
    instRepo --> show : installedVersions[]
    deactivate instRepo
    show -> io : write(versions)
    activate io
    io --> show : ok
    deactivate io
    loop for each link type (require, require-dev, suggest, ...)
        show -> io : write(target + constraint)
        activate io
        io --> show : ok
        deactivate io
    end
    deactivate show #DDE8FF

else Text output — package list
    show -> show : printPackages(io, packages, indent, ...)
    activate show #DDE8FF
    loop for each package
        show -> io : write(formattedRow)
        activate io
        io --> show : ok
        deactivate io
    end
    deactivate show #DDE8FF
end

show --> User : exit code 0
deactivate show

@enduml
