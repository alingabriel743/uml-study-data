@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBackgroundColor #F8F9FA
skinparam sequenceParticipantBorderColor #495057
skinparam sequenceLifeLineBorderColor #6C757D
skinparam sequenceGroupBackgroundColor #E9ECEF
skinparam sequenceGroupBorderColor #6C757D
skinparam noteBorderColor #6C757D
skinparam noteBackgroundColor #FFF9C4

title VCS Downloader Flow

participant "InstallationManager" as im
participant "VcsDownloader\n<<abstract>>" as vcs
participant "GitDownloader\n<<concrete>>" as git
participant "PackageInterface" as pkg
participant "Filesystem" as fs
participant "IOInterface" as io

== Download Phase ==

im -> vcs: download(package, path, prevPackage?)
activate vcs

vcs -> pkg: getSourceReference()
activate pkg
pkg --> vcs: sourceRef\n[throws InvalidArgumentException if null]
deactivate pkg

vcs -> pkg: getSourceUrls()
activate pkg
pkg --> vcs: urls[]
deactivate pkg

vcs -> vcs: prepareUrls(urls)\n[resolve local file:// paths via realpath()]

loop for each url in urls
    vcs -> git: doDownload(package, path, url, prevPackage?)
    activate git
    alt doDownload succeeds
        git --> vcs: PromiseInterface (resolved)
        deactivate git
    else doDownload fails and more URLs remain
        git --> vcs: Exception
        deactivate git
        vcs -> io: writeError('Failed to clone from url, will try next url')
        activate io
        io --> vcs: void
        deactivate io
    else doDownload fails on last URL
        vcs -> vcs: rethrow last Exception
    end
end

vcs --> im: PromiseInterface
deactivate vcs

== Prepare Phase (install) ==

im -> vcs: prepare('install', package, path)
activate vcs
vcs -> fs: emptyDirectory(path)
activate fs
fs --> vcs: void
deactivate fs
vcs --> im: PromiseInterface
deactivate vcs

== Prepare Phase (update) ==

im -> vcs: prepare('update', package, path, prevPackage)
activate vcs
vcs -> vcs: cleanChanges(prevPackage, path, stash=true)
note right: stash local modifications\nbefore updating
vcs -> vcs: hasCleanedChanges[prevPackage.uniqueName] = true
vcs --> im: PromiseInterface
deactivate vcs

== Prepare Phase (uninstall) ==

im -> vcs: prepare('uninstall', package, path)
activate vcs
vcs -> vcs: cleanChanges(package, path, stash=false)
note right: discard local changes\n(no stash needed for removal)
vcs --> im: PromiseInterface
deactivate vcs

== Install Phase ==

im -> vcs: install(package, path)
activate vcs
vcs -> io: writeError('  - Installing <package> (<version>)')
activate io
io --> vcs: void
deactivate io
vcs -> pkg: getSourceUrls()
activate pkg
pkg --> vcs: urls[]
deactivate pkg
vcs -> git: doInstall(package, path, url)
activate git
git --> vcs: PromiseInterface
deactivate git
vcs --> im: PromiseInterface
deactivate vcs

== Update Phase ==

im -> vcs: update(initial, target, path)
activate vcs
vcs -> io: writeError('  - Updating <package> (<from> => <to>)')
activate io
io --> vcs: void
deactivate io
vcs -> pkg: getSourceUrls()
activate pkg
pkg --> vcs: urls[]
deactivate pkg
vcs -> git: doUpdate(initial, target, path, url)
activate git
git --> vcs: PromiseInterface
deactivate git

opt isVerbose && hasMetadataRepository(path)
    vcs -> git: getCommitLogs(fromRef, toRef, path)
    activate git
    git --> vcs: string logs
    deactivate git
    vcs -> io: writeError(logs)
    activate io
    io --> vcs: void
    deactivate io
end

vcs --> im: PromiseInterface
deactivate vcs

== Remove Phase ==

im -> vcs: remove(package, path)
activate vcs
vcs -> io: writeError('  - Removing <package> (<version>)')
activate io
io --> vcs: void
deactivate io
vcs -> fs: removeDirectoryAsync(path)
activate fs
fs --> vcs: Promise<bool>
deactivate fs

alt result == false
    vcs -> vcs: throw RuntimeException\n('Could not completely delete ' + path)
end

vcs --> im: PromiseInterface
deactivate vcs

== Cleanup Phase (post-update) ==

im -> vcs: cleanup('update', package, path, prevPackage)
activate vcs
vcs -> vcs: reapplyChanges(path)
note right: re-apply stashed changes\nfrom prepare('update')
vcs -> vcs: unset hasCleanedChanges\n[prevPackage.uniqueName]
vcs --> im: PromiseInterface
deactivate vcs

@enduml
