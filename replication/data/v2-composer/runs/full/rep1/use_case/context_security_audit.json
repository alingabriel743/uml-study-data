{
  "scope": "security_audit",
  "title": "Security Audit",
  "diagram_type": "use_case",
  "description": "Developer runs composer audit; AuditConfig and advisory policies check installed packages for known vulnerabilities.",

  "actors": [
    "Developer"
  ],

  "use_cases": [
    "Run Security Audit (composer audit)",
    "Configure Audit Policy (block / report / fail)",
    "Ignore Advisory by ID (CVE / GHSA)",
    "Ignore Advisory by Severity",
    "Ignore Abandoned Packages",
    "Override Policy via Environment Variable",
    "Block Insecure Packages (install / update)",
    "View Audit Results (table / plain / json / summary)"
  ],

  "key_participants": [
    "Developer",
    "AuditCommand",
    "Auditor",
    "AuditConfig",
    "PolicyConfig",
    "AdvisoriesPolicyConfig",
    "AbandonedPolicyConfig",
    "ListPolicyConfig",
    "ComposerRepository"
  ],

  "interaction_flow": [
    "Developer → AuditCommand: composer audit [--format] [--abandoned] [--no-dev] [--filtered]",
    "AuditCommand → PolicyConfig: createPolicyConfig(Config, InputInterface)",
    "PolicyConfig → AdvisoriesPolicyConfig: fromRawConfig(policyConfig, auditConfig, VersionParser)",
    "PolicyConfig → AbandonedPolicyConfig: fromRawConfig(policyConfig, auditConfig, VersionParser)",
    "AuditCommand → Auditor: new Auditor()",
    "AuditCommand → Auditor: audit(IOInterface, RepositorySet, PolicyConfig, packages, format, warningOnly)",
    "Auditor → ComposerRepository: getMatchingSecurityAdvisories(packages, summarize, ignoreUnreachable)",
    "Auditor → AdvisoriesPolicyConfig: getIgnoreListForOperation('audit')",
    "Auditor → AdvisoriesPolicyConfig: getIgnoreSeverityForOperation('audit')",
    "Auditor → AbandonedPolicyConfig: getFlatIgnoreForOperation('audit')",
    "Auditor → Developer: output results in FORMAT_TABLE / FORMAT_PLAIN / FORMAT_JSON / FORMAT_SUMMARY"
  ],

  "key_relationships": [
    "AdvisoriesPolicyConfig extends ListPolicyConfig",
    "AbandonedPolicyConfig extends ListPolicyConfig",
    "PolicyConfig composes AdvisoriesPolicyConfig (1:1)",
    "PolicyConfig composes AbandonedPolicyConfig (1:1)",
    "AuditCommand depends_on Auditor",
    "AuditCommand depends_on PolicyConfig",
    "Auditor depends_on ComposerRepository (RepositorySet)",
    "Auditor depends_on PolicyConfig",
    "AuditConfig used_by AuditCommand (audit enabled flag + format)"
  ],

  "class_details": {
    "AuditConfig": {
      "namespace": "Composer\\Advisory",
      "modifiers": ["readonly", "internal"],
      "attributes": ["audit: bool = true", "auditFormat: Auditor::FORMAT_* = FORMAT_SUMMARY"],
      "constructor": "__construct(bool $audit, string $auditFormat)"
    },
    "ListPolicyConfig": {
      "namespace": "Composer\\Policy",
      "type": "abstract",
      "constants": ["AUDIT_IGNORE", "AUDIT_REPORT", "AUDIT_FAIL", "BLOCK_SCOPE_UPDATE", "BLOCK_SCOPE_INSTALL", "BLOCK_SCOPE_ALL"],
      "attributes": ["name: string", "block: bool", "audit: AUDIT_*", "ignore: array<string, list<IgnorePackageRule>>"],
      "key_methods": ["shouldBlock(blockScope): bool", "getIgnoreForOperation(operation): array", "getFlatIgnoreForOperation(operation): array", "withBlockingDisabled(): static (abstract)", "withAudit(audit): static (abstract)"]
    },
    "AdvisoriesPolicyConfig": {
      "namespace": "Composer\\Policy",
      "extends": "ListPolicyConfig",
      "modifiers": ["final", "readonly", "internal"],
      "const": "NAME = 'advisories'",
      "extra_attributes": ["ignoreId: array<string, IgnoreIdRule>", "ignoreSeverity: array<string, IgnoreSeverityRule>"],
      "key_methods": [
        "getIgnoreIdForOperation(operation): array",
        "getIgnoreListForOperation(operation): array",
        "getIgnoreSeverityForOperation(operation): array",
        "withBlockingDisabled(): static",
        "withAudit(audit): static",
        "withIgnoreSeverity(severities[]): static",
        "fromRawConfig(policyConfig, auditConfig, VersionParser): self",
        "disabled(): self"
      ]
    },
    "AbandonedPolicyConfig": {
      "namespace": "Composer\\Policy",
      "extends": "ListPolicyConfig",
      "modifiers": ["final", "readonly", "internal"],
      "const": "NAME = 'abandoned'",
      "key_methods": [
        "withBlockingDisabled(): static",
        "withAudit(audit): static",
        "fromRawConfig(policyConfig, auditConfig, VersionParser): self",
        "disabled(): self"
      ]
    },
    "PolicyConfig": {
      "namespace": "Composer\\Policy",
      "aggregates": ["AdvisoriesPolicyConfig", "AbandonedPolicyConfig"],
      "key_methods": [
        "getAllLists(): array",
        "getActiveAuditFilterLists(): array",
        "getActiveBlockFilterLists(blockScope): array",
        "fromRawConfig(...): self"
      ],
      "env_overrides": ["COMPOSER_POLICY_ADVISORIES_BLOCK", "COMPOSER_POLICY_ABANDONED_BLOCK", "COMPOSER_SECURITY_BLOCKING_ABANDONED"]
    },
    "Auditor": {
      "namespace": "Composer\\Advisory",
      "formats": ["FORMAT_TABLE", "FORMAT_PLAIN", "FORMAT_JSON", "FORMAT_SUMMARY"],
      "key_methods": ["audit(IOInterface, RepositorySet, PolicyConfig, packages, format, warningOnly, FilterListProviderSet): int"]
    }
  },

  "policy_audit_levels": ["ignore", "report", "fail"],
  "block_scopes": ["update", "install", "all"],
  "ignore_rule_types": ["IgnorePackageRule (by package name + version constraint)", "IgnoreIdRule (by CVE/GHSA ID)", "IgnoreSeverityRule (by severity level)"],
  "audit_formats": ["table", "plain", "json", "summary"],

  "important_notes": "AuditCommand (composer audit CLI) orchestrates the flow: builds PolicyConfig, creates Auditor, calls audit(). PolicyConfig.fromRawConfig() handles both legacy (audit.block-insecure) and new (policy.advisories / policy.abandoned) config formats. Each ListPolicyConfig supports operation-scoped rules: 'block' (installer) vs 'audit' (audit command). AdvisoriesPolicyConfig additionally supports ignore-by-ID and ignore-by-severity. AbandonedPolicyConfig default block=false (opt-in). Environment variables (COMPOSER_POLICY_*) override file-based config.",

  "source_files_analyzed": [
    "src/src/Composer/Advisory/AuditConfig.php",
    "src/src/Composer/Policy/AdvisoriesPolicyConfig.php",
    "src/src/Composer/Policy/AbandonedPolicyConfig.php",
    "src/src/Composer/Policy/ListPolicyConfig.php",
    "src/src/Composer/Advisory/Auditor.php (grep)",
    "src/src/Composer/Policy/PolicyConfig.php (grep)",
    "src/src/Composer/Command/AuditCommand.php (grep)"
  ]
}
