@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}

title Configuration Management

left to right direction

actor "Developer" as dev

rectangle "Composer Config Command Layer" {

    usecase "List All Configuration Settings" as UC_List
    usecase "Get Configuration Value" as UC_Get
    usecase "Set Configuration Value" as UC_Set
    usecase "Unset Configuration Value" as UC_Unset
    usecase "Open Config File in External Editor" as UC_Editor

    usecase "Manage Global Configuration\n(--global flag)" as UC_Global
    usecase "Manage Auth Credentials\n(github-oauth, gitlab-oauth,\nhttp-basic, bearer, bitbucket-oauth)" as UC_Auth
    usecase "Manage Repositories\n(add, remove, disable)" as UC_Repos
    usecase "Manage Package Properties\n(name, type, description, license,\nextra, suggest, scripts, keywords)" as UC_Props
    usecase "Set Policy / Audit Settings\n(audit.*, policy.*)" as UC_Policy
    usecase "Manage Preferred-Install\nPer Package" as UC_PrefInstall
    usecase "Manage allow-plugins Settings" as UC_Plugins

    usecase "Validate Setting Value" as UC_Validate
    usecase "Normalize Setting Value" as UC_Normalize
    usecase "Write to JsonConfigSource" as UC_Write
    usecase "Read from Config" as UC_Read
}

' Actor → primary use cases
dev --> UC_List
dev --> UC_Get
dev --> UC_Set
dev --> UC_Unset
dev --> UC_Editor
dev --> UC_Global
dev --> UC_Auth
dev --> UC_Repos
dev --> UC_Props
dev --> UC_Policy
dev --> UC_PrefInstall
dev --> UC_Plugins

' Include relationships for Set
UC_Set ..> UC_Validate   : <<include>>
UC_Set ..> UC_Normalize  : <<include>>
UC_Set ..> UC_Write      : <<include>>

' Include relationship for Get
UC_Get ..> UC_Read       : <<include>>

' Extend relationships
UC_Global ..> UC_Set     : <<extend>>
UC_Global ..> UC_Get     : <<extend>>
UC_Editor ..> UC_Global  : <<extend>>

' Auth, Repos, Props write through JsonConfigSource
UC_Auth      ..> UC_Write : <<include>>
UC_Repos     ..> UC_Write : <<include>>
UC_Props     ..> UC_Write : <<include>>
UC_Policy    ..> UC_Write : <<include>>
UC_PrefInstall ..> UC_Write : <<include>>
UC_Plugins   ..> UC_Write : <<include>>

@enduml
