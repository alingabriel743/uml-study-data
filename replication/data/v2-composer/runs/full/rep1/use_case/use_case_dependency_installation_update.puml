@startuml use_case_dependency_installation_update

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #2C6FAC
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Dependency Installation and Update

left to right direction

actor "Developer" as developer

rectangle "Composer — Dependency Installation & Update" {

    ' Primary commands (developer-facing)
    usecase "Install Dependencies\n(composer install)" as UC_Install
    usecase "Update Dependencies\n(composer update)" as UC_Update
    usecase "Require New Package\n(composer require)" as UC_Require
    usecase "Remove Package\n(composer remove)" as UC_Remove

    ' Internal pipeline use cases
    usecase "Resolve Dependencies\n(Solver)" as UC_Resolve
    usecase "Write Lock File\n(Locker)" as UC_Lock
    usecase "Download Packages\n(DownloadManager)" as UC_Download
    usecase "Execute Install/Update/\nUninstall Operations\n(InstallationManager)" as UC_Execute
    usecase "Generate Autoloader\n(AutoloadGenerator)" as UC_Autoload
    usecase "Run Lifecycle Scripts\n(EventDispatcher)" as UC_Scripts
    usecase "Run Security Audit\n(Auditor)" as UC_Audit
}

' Actor → primary use cases
developer --> UC_Install
developer --> UC_Update
developer --> UC_Require
developer --> UC_Remove

' Require / Remove delegate to Update
UC_Require .> UC_Update : <<include>>
UC_Remove  .> UC_Update : <<include>>

' Install includes
UC_Install .> UC_Resolve  : <<include>>
UC_Install .> UC_Execute  : <<include>>
UC_Install .> UC_Autoload : <<include>>

' Update includes
UC_Update .> UC_Resolve  : <<include>>
UC_Update .> UC_Lock     : <<include>>
UC_Update .> UC_Execute  : <<include>>
UC_Update .> UC_Autoload : <<include>>

' Execute always downloads first
UC_Execute .> UC_Download : <<include>>

' Optional extensions
UC_Install .> UC_Scripts : <<extend>>
UC_Update  .> UC_Scripts : <<extend>>
UC_Update  .> UC_Audit   : <<extend>>

@enduml
