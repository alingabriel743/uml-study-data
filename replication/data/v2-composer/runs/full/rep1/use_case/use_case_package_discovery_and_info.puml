@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}

title Package Discovery and Information

left to right direction

actor "Developer" as dev
actor "Packagist\nHTTP API" as packagist #E3F2FD

rectangle "Composer — Package Discovery and Information" {

    package "Search (composer search)" {
        usecase "Search packages\nby name" as UC_SEARCH_NAME
        usecase "Search packages\nfulltext" as UC_SEARCH_FULLTEXT
        usecase "Search packages\nby vendor" as UC_SEARCH_VENDOR
    }

    package "Show / Info (composer show)" {
        usecase "Show package\ninformation" as UC_SHOW_INFO
        usecase "List installed\npackages" as UC_LIST_INSTALLED
        usecase "List available /\nall packages" as UC_LIST_AVAILABLE
        usecase "List locked\npackages" as UC_LIST_LOCKED
        usecase "Browse dependency\ntree (--tree)" as UC_TREE
        usecase "Filter packages\nby wildcard" as UC_WILDCARD
        usecase "Show package\npath (--path)" as UC_PATH
        usecase "Show latest /\noutdated versions" as UC_LATEST_OUTDATED
        usecase "Show root\npackage info (--self)" as UC_SELF
        usecase "Display package\ninfo as JSON" as UC_JSON
        usecase "Filter by direct\ndependencies (--direct)" as UC_DIRECT
        usecase "Show platform\npackages (--platform)" as UC_PLATFORM
    }
}

' Developer → Search use cases
dev --> UC_SEARCH_NAME
dev --> UC_SEARCH_FULLTEXT
dev --> UC_SEARCH_VENDOR

' Developer → Show use cases
dev --> UC_SHOW_INFO
dev --> UC_LIST_INSTALLED
dev --> UC_LIST_AVAILABLE
dev --> UC_LIST_LOCKED
dev --> UC_TREE
dev --> UC_WILDCARD
dev --> UC_PATH
dev --> UC_LATEST_OUTDATED
dev --> UC_SELF

' Extend relationships for display modifiers
UC_JSON ..> UC_SHOW_INFO : <<extend>>
UC_DIRECT ..> UC_LIST_INSTALLED : <<extend>>
UC_PLATFORM ..> UC_LIST_AVAILABLE : <<extend>>

' Include relationships — search triggers remote API
UC_SEARCH_FULLTEXT ..> packagist : <<include>>

@enduml
