@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}

title Package Download and Filesystem Operations

left to right direction

actor "Developer" as developer

actor "DownloadManager" as dm
actor "FileDownloader" as fd
actor "VcsDownloader" as vcs
actor "Filesystem" as fs
actor "Cache" as cache
actor "HttpDownloader" as http

rectangle "Composer Download and Filesystem Layer" {
    usecase "Download Package" as UC1
    usecase "Install Package" as UC2
    usecase "Update Package" as UC3
    usecase "Remove Package" as UC4

    usecase "Select Download Source\n(dist vs source)" as UC15
    usecase "Prepare Download" as UC5
    usecase "Cleanup After Download" as UC6
    usecase "Fall Back to\nAlternative Source" as UC14

    usecase "Download File via HTTP" as UC7
    usecase "Load Package from Cache" as UC8
    usecase "Verify File Checksum" as UC9
    usecase "Compare Package Changes" as UC13

    usecase "Ensure Directory Exists" as UC11
    usecase "Copy and Move Files" as UC12
    usecase "Remove Directory" as UC10
}

' --- Developer initiates top-level use cases ---
developer --> UC1
developer --> UC2
developer --> UC3
developer --> UC4

' --- Include relationships ---
UC1 ..> UC15 : <<include>>
UC1 ..> UC5  : <<include>>
UC1 ..> UC6  : <<include>>
UC2 ..> UC7  : <<include>>
UC2 ..> UC9  : <<include>>
UC3 ..> UC1  : <<include>>
UC3 ..> UC2  : <<include>>
UC4 ..> UC10 : <<include>>

' --- Extend relationships ---
UC7  ..> UC8  : <<extend>>
UC14 ..> UC1  : <<extend>>

' --- DownloadManager: orchestrates all downloads ---
dm --> UC1
dm --> UC2
dm --> UC3
dm --> UC4
dm --> UC5
dm --> UC6
dm --> UC14
dm --> UC15

' --- FileDownloader: dist (archive) downloads ---
fd --> UC7
fd --> UC8
fd --> UC9
fd --> UC11
fd --> UC12
fd --> UC13

' --- VcsDownloader: source (VCS) installs ---
vcs --> UC11

' --- Filesystem: directory and file utilities ---
fs --> UC10
fs --> UC11
fs --> UC12

' --- Cache: archive caching by SHA1 ---
cache --> UC8

' --- HttpDownloader: HTTP transport ---
http --> UC7

@enduml
