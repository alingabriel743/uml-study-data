@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam ArrowColor #495057

title Plugin Management

left to right direction

actor "Plugin Author" as PluginAuthor
actor "Developer" as Developer
actor "PluginManager" as PluginManager
actor "BaseCommand" as BaseCommand
actor "Config" as Config

rectangle "Plugin Management System" {

    usecase "Create Plugin Package" as UC_Create
    usecase "Declare composer-plugin-api\nVersion Requirement" as UC_Declare
    usecase "Publish Plugin with\nextra.class Entry" as UC_Publish

    usecase "Enable Plugin via\nallow-plugins Config" as UC_Enable
    usecase "Interactively Approve\nPlugin Trust Prompt" as UC_Approve
    usecase "Run Composer Command\nwith --no-plugins Flag" as UC_NoPlugins

    usecase "Load Installed Plugins\nfrom Local/Global Repository" as UC_Load
    usecase "Register Plugin Package\nand Autoload Classes" as UC_Register
    usecase "Validate Plugin API\nVersion Compatibility" as UC_Validate
    usecase "Check Plugin Allowed\nby allow-plugins Rules" as UC_Check
    usecase "Activate Plugin Instance\nvia PluginInterface::activate()" as UC_Activate
    usecase "Subscribe Plugin to\nEventDispatcher" as UC_Subscribe
    usecase "Deactivate Plugin\nvia PluginInterface::deactivate()" as UC_Deactivate
    usecase "Remove EventDispatcher\nListener" as UC_RemoveListener
    usecase "Uninstall Plugin\nvia PluginInterface::uninstall()" as UC_Uninstall

    usecase "Dispatch PRE_COMMAND_RUN\nEvent" as UC_Dispatch
    usecase "Resolve allow-plugins\nSetting from composer.json" as UC_Resolve

}

' --- Plugin Author associations ---
PluginAuthor --> UC_Create
PluginAuthor --> UC_Declare
PluginAuthor --> UC_Publish

' --- Developer associations ---
Developer --> UC_Enable
Developer --> UC_Approve
Developer --> UC_NoPlugins

' --- PluginManager associations ---
PluginManager --> UC_Load
PluginManager --> UC_Register
PluginManager --> UC_Validate
PluginManager --> UC_Check
PluginManager --> UC_Activate
PluginManager --> UC_Subscribe
PluginManager --> UC_Deactivate
PluginManager --> UC_Uninstall

' --- BaseCommand associations ---
BaseCommand --> UC_Dispatch

' --- Config associations ---
Config --> UC_Resolve

' --- Include/Extend relationships ---
UC_Load ..> UC_Register : <<include>>
UC_Register ..> UC_Validate : <<include>>
UC_Register ..> UC_Check : <<include>>
UC_Register ..> UC_Activate : <<include>>
UC_Activate ..> UC_Subscribe : <<extend>>\n(if EventSubscriberInterface)
UC_Deactivate ..> UC_RemoveListener : <<include>>
UC_Uninstall ..> UC_Deactivate : <<include>>
UC_Check ..> UC_Approve : <<extend>>\n(if interactive, no rule found)
UC_Dispatch ..> UC_Load : <<include>>\n(PRE_COMMAND_RUN triggers plugin init)

@enduml
