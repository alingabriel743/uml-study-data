@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Project Initialization

left to right direction

actor "Developer" as developer

rectangle "Composer — Project Initialization" {
    usecase "Run composer init" as UC_INIT
    usecase "Run composer create-project" as UC_CREATE

    usecase "Provide Package Metadata\n(name, description, author,\ntype, license)" as UC_METADATA
    usecase "Add require /\nrequire-dev Dependencies" as UC_DEPS
    usecase "Configure Autoload\n(PSR-4)" as UC_AUTOLOAD
    usecase "Confirm composer.json\nGeneration" as UC_CONFIRM
    usecase "Add vendor to .gitignore" as UC_GITIGNORE
    usecase "Install Project\nDependencies" as UC_INSTALL
    usecase "Bootstrap Composer\nInstance" as UC_BOOTSTRAP
    usecase "Install Root Package\nfrom VCS / dist" as UC_ROOTPKG
    usecase "Add Custom\nRepositories" as UC_REPOS
    usecase "Run Post-Install\nScripts" as UC_SCRIPTS
}

developer --> UC_INIT
developer --> UC_CREATE

UC_INIT ..> UC_METADATA    : <<include>>
UC_INIT ..> UC_DEPS        : <<include>>
UC_INIT ..> UC_AUTOLOAD    : <<extend>>\n[--autoload flag]
UC_INIT ..> UC_CONFIRM     : <<extend>>\n[interactive mode]
UC_INIT ..> UC_GITIGNORE   : <<extend>>\n[interactive + git present]
UC_INIT ..> UC_INSTALL     : <<extend>>\n[interactive + has deps]

UC_CREATE ..> UC_BOOTSTRAP : <<include>>
UC_CREATE ..> UC_SCRIPTS   : <<include>>
UC_CREATE ..> UC_ROOTPKG   : <<extend>>\n[packageName provided]
UC_CREATE ..> UC_INSTALL   : <<extend>>\n[unless --no-install]
UC_CREATE ..> UC_REPOS     : <<extend>>\n[--add-repository flag]

@enduml
