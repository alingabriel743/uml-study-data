@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BorderColor #495057
    FontColor #212529
}
skinparam ArrowColor #495057

title Repository Management

left to right direction

actor "Developer" as developer
actor "Plugin" as plugin
actor "RepositoryManager" as repoManager

rectangle "Repository Management" {

    usecase "Register Repository Type" as UC1
    usecase "Create Repository Instance" as UC2
    usecase "Apply Repository Filter" as UC12
    usecase "Add Repository to Chain" as UC3
    usecase "Prepend Repository to Chain" as UC4
    usecase "Set Local Repository" as UC5
    usecase "Get Local Repository" as UC6
    usecase "List All Repositories" as UC7
    usecase "Find Package Across Repositories" as UC8
    usecase "Find All Matching Packages" as UC9
    usecase "Configure Composer (HTTP) Repository" as UC10
    usecase "Configure VCS Repository" as UC11

}

developer --> UC1
developer --> UC2
developer --> UC3
developer --> UC5
developer --> UC6
developer --> UC7
developer --> UC8
developer --> UC9
developer --> UC10
developer --> UC11

plugin --> UC4

repoManager --> UC12

UC2 .> UC12 : <<include>>
UC4 .> UC3 : <<extend>>

note right of UC2
  Throws InvalidArgumentException
  if type not registered.
end note

note right of UC12
  Wraps repository in FilterRepository
  when 'only', 'exclude', or 'canonical'
  config keys are present.
end note

note bottom of UC4
  Uses array_unshift to ensure
  plugin repo is checked first
  during package resolution.
end note

@enduml
