@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Script and Event Handling

left to right direction

actor "Developer" as developer
actor "Plugin\n(EventSubscriberInterface)" as plugin

rectangle "Composer: Script & Event Handling" {

    ' ── Developer-facing use cases ──────────────────────────────────────────
    usecase "Run Lifecycle Script\n(pre/post-install-cmd,\npre/post-update-cmd)" as UC_Lifecycle
    usecase "Run Custom Script\n(composer run-script <name>)" as UC_Custom
    usecase "Allow / Block Plugin\n(allow-plugins config)" as UC_AllowPlugin

    ' ── Plugin-facing use cases ──────────────────────────────────────────────
    usecase "Activate Plugin\n(plugin.activate)" as UC_Activate
    usecase "Deactivate Plugin\n(plugin.deactivate)" as UC_Deactivate
    usecase "Uninstall Plugin\n(plugin.uninstall)" as UC_Uninstall
    usecase "Register as Event Subscriber\n(EventSubscriberInterface)" as UC_Subscribe

    ' ── Internal / supporting use cases ─────────────────────────────────────
    usecase "Dispatch Script Event\n(EventDispatcher.dispatchScript)" as UC_DispatchScript
    usecase "Dispatch Package Event\n(pre/post-package-install,\npre/post-package-update,\npre/post-package-uninstall)" as UC_DispatchPackage
    usecase "Dispatch Installer Event" as UC_DispatchInstaller
    usecase "Add Event Listener\n(EventDispatcher.addListener /\naddSubscriber)" as UC_AddListener

}

' ── Developer associations ───────────────────────────────────────────────────
developer --> UC_Lifecycle
developer --> UC_Custom
developer --> UC_AllowPlugin

' ── Plugin associations ──────────────────────────────────────────────────────
plugin --> UC_Activate
plugin --> UC_Deactivate
plugin --> UC_Uninstall
plugin --> UC_Subscribe

' ── <<include>> relationships ────────────────────────────────────────────────
UC_Lifecycle  ..> UC_DispatchScript   : <<include>>
UC_Custom     ..> UC_DispatchScript   : <<include>>

UC_DispatchScript  ..> UC_DispatchPackage   : <<extend>>

UC_Subscribe  ..> UC_AddListener      : <<include>>
UC_Activate   ..> UC_Subscribe        : <<include>>

UC_Lifecycle   ..> UC_DispatchInstaller : <<extend>>
UC_Custom      ..> UC_DispatchInstaller : <<extend>>

' ── Notes ────────────────────────────────────────────────────────────────────
note right of UC_AllowPlugin
  PluginManager checks allow-plugins
  config before calling addPlugin();
  prompts interactively if key missing.
  --no-plugins flag disables all plugins.
end note

note bottom of UC_DispatchScript
  Creates Script\\Event carrying
  Composer + IOInterface.
  Listeners sourced from composer.json
  scripts[] and plugin subscribers.
end note

note bottom of UC_DispatchPackage
  Fired by InstallationManager.executeBatch()
  before (PRE_*) and after (POST_*) each
  install / update / uninstall operation.
  Guard: runScripts=true AND
  eventDispatcher != null.
end note

@enduml
