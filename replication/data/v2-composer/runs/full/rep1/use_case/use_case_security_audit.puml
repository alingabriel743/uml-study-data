@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #3A6EA5
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Security Audit

left to right direction

actor "Developer" as dev
actor "Packagist\n(Advisory Source)" as packagist
actor "Environment\n(COMPOSER_POLICY_*)" as env

rectangle "Composer Security Audit System" {

    usecase "Run Security Audit\n(composer audit)" as UC1
    usecase "Configure Audit Policy\n(ignore / report / fail)" as UC2
    usecase "Fetch Security Advisories\nfrom Repository" as UC3
    usecase "Apply Advisory Filters\n(PolicyConfig)" as UC4
    usecase "Ignore Advisory by ID\n(CVE / GHSA)" as UC5
    usecase "Ignore Advisory\nby Severity" as UC6
    usecase "Ignore Abandoned\nPackages" as UC7
    usecase "View Audit Results\n(table / plain / json / summary)" as UC8
    usecase "Block Insecure Packages\n(install / update)" as UC9
    usecase "Override Policy via\nEnvironment Variable" as UC10

}

' --- Developer associations ---
dev --> UC1
dev --> UC2
dev --> UC9

' --- Packagist provides advisory data ---
packagist --> UC3

' --- Environment variable overrides ---
env --> UC10

' --- Include relationships ---
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC8 : <<include>>
UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>
UC4 ..> UC7 : <<include>>
UC9 ..> UC4 : <<include>>

' --- Extend relationships ---
UC10 ..> UC2 : <<extend>>
UC2 ..> UC1 : <<extend>>

@enduml
