@startuml
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

left to right direction

title VCS Source Integration\n(Composer\\Repository\\Vcs + Composer\\Downloader)

actor "Developer" as Developer
actor "GitLab API" as GitLabAPI
actor "Git Remote" as GitRemote

rectangle "Composer — VCS Source Integration" {

    ' --- Repository configuration ---
    usecase "Configure VCS\nRepository URL" as UC1
    usecase "Auto-detect\nVCS Driver Type" as UC2
    usecase "Initialize Driver\n(Fetch Project Metadata)" as UC3

    ' --- Metadata retrieval ---
    usecase "Read composer.json\nfrom VCS Ref" as UC4
    usecase "List Repository Tags" as UC5
    usecase "List Repository Branches" as UC6
    usecase "Cache VCS Metadata" as UC8

    ' --- Download ---
    usecase "Download Package\nfrom VCS Source" as UC11
    usecase "Get Dist URL\nfor Identifier" as UC9
    usecase "Get Source URL\nfor Identifier" as UC10

    ' --- Authentication ---
    usecase "Authenticate via\nOAuth (GitLab)" as UC12
    usecase "Refresh OAuth Token" as UC13
    usecase "Prompt Interactive\nCredentials" as UC14

    ' --- Fallback ---
    usecase "Fall Back to\nGit Clone\n(GitLabDriver → GitDriver)" as UC15
}

' ── Actor associations ──────────────────────────────────────────
Developer   --> UC1
Developer   --> UC11

GitLabAPI   --> UC3
GitLabAPI   --> UC4
GitLabAPI   --> UC5
GitLabAPI   --> UC6
GitLabAPI   --> UC12
GitLabAPI   --> UC13

GitRemote   --> UC15

' ── <<include>> relationships ────────────────────────────────────
UC1  .> UC2  : <<include>>
UC2  .> UC3  : <<include>>
UC4  .> UC8  : <<include>>
UC5  .> UC4  : <<include>>
UC6  .> UC4  : <<include>>
UC11 .> UC9  : <<include>>
UC11 .> UC10 : <<include>>

' ── <<extend>> relationships ─────────────────────────────────────
UC15 .> UC3  : <<extend>>
UC14 .> UC12 : <<extend>>
UC13 .> UC12 : <<extend>>

@enduml
