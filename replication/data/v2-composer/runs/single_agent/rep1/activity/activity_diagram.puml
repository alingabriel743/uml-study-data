@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #DEE2E6
    TitleFontColor #212529
}

title Composer v2 — Package Installation & Update Workflow

|User / CLI|
start
:Run **composer install**\nor **composer update**;

|Installer|
:Initialize Installer\n(load config, root package,\nrepositories, locker);

if (Dry-run mode?) then (yes)
    :Disable scripts, operations\nand lock file writes;
endif

if (Lock file present?) then (no)
    :Force **update** mode;
    note right
      No composer.lock found —
      cannot install from lock,
      must resolve dependencies.
    end note
endif

if (Dry-run mode?) then (yes)
    :Mock local repositories\n(no real side effects);
endif

:Dispatch **PRE_INSTALL_CMD** or\n**PRE_UPDATE_CMD** script event;

:Configure DownloadManager\n(prefer-source / prefer-dist);

if (Update mode?) then (yes)
    |Installer|
    :Output "Loading composer repositories\nwith package information";
    :Create **PlatformRepository**\n(PHP version + extensions);
    :Create **RepositorySet**\nfrom composer.json requires;
    :Add all remote repositories\nto RepositorySet;
    :Build **solver Request**\n(root constraints + update allow-list);

    |DependencyResolver|
    :Create **dependency Pool**\n(apply type / security filters);
    :Run **SAT Solver**\n(resolve full dependency graph);

    if (SolverProblemsException?) then (yes)
        :Format pretty error message\n(conflicting constraints);
        |User / CLI|
        :Display resolution failure\nand exit (code 2);
        stop
    endif

    |Installer|
    :Run second solver pass\nfor **dev packages extraction**\n(non-dev subset only);
    :Collect lock-file operations:\nInstall / Update / Uninstall;
    :Write **composer.lock**\n(packages, hashes, metadata,\nplatform requirements);
    note right
      Skipped when writeLock=false
      or executeOperations=false.
    end note

    if (Install after update?) then (no)
        :Output update summary\n(suggested packages);
        stop
    endif
endif

' ── INSTALL PHASE ──────────────────────────────────────────
|Installer|
:Read **composer.lock**\n(get lockedRepository);

if (Already verified by\nupdate phase?) then (no)
    :Output "Verifying lock file\ncontents for current platform";
    :Create PlatformRepository\nfrom lock file overrides;

    |DependencyResolver|
    :Solve platform requirements\n(verify lock is installable);

    if (Lock file incompatible\nwith platform?) then (yes)
        |User / CLI|
        :Report lock file error\n"run composer update";
        stop
    endif
endif

|Installer|
:Compute **LocalRepoTransaction**\n(diff: locked repo vs installed repo);

if (Nothing to install,\nupdate or remove?) then (yes)
    :Output "Nothing to install,\nupdate or remove";
else (operations exist)
    :Report operation counts\n(installs / updates / removals);

    if (Execute operations?) then (yes)
        |InstallationManager|
        fork
            :Prefetch & **download**\nall packages in parallel;
        fork again
            :Uninstall **removed** packages\n(delete vendor dirs);
        end fork
        :Install **new** packages\n(extract into vendor/);
        :Update **existing** packages\n(replace vendor dirs);
        :Install / update **binaries**\n(symlinks in vendor/bin);
        :Touch vendor/ directory\n(update mtime);
    else (dry-run / no exec)
        :Show planned operations\n(no file changes);
    endif
endif

' ── POST-INSTALL PHASE ─────────────────────────────────────
|Installer|
if (notify-on-install?) then (yes)
    :Send install notification\nto package servers;
endif

:Scan for **abandoned packages**\nand emit warnings;

if (Dump autoloader?) then (yes)
    |AutoloadGenerator|
    :Collect all installed packages\n(PSR-0 / PSR-4 / classmap / files);

    if (Optimize autoloader?) then (yes)
        :Scan source files\nand build **optimized classmap**;
    else (standard)
        :Generate standard\nautoload map;
    endif

    :Write **vendor/autoload.php**\nand autoload_*.php files;

    if (Strict PSR autoloader?) then (yes)
        if (PSR violations found?) then (yes)
            |User / CLI|
            :Report PSR autoload\nviolations and exit (code 6);
            stop
        endif
    endif
endif

|Installer|
:Ensure binaries present\nfor all installed packages;

:Dispatch **POST_INSTALL_CMD** or\n**POST_UPDATE_CMD** script event;

if (Audit enabled?) then (yes)
    :Build RepositorySet\nfor advisory lookup;
    :Run **security audit**\nagainst installed packages;

    if (Vulnerabilities found\nAND errorOnAudit=true?) then (yes)
        |User / CLI|
        :Report audit failure\nand exit (code 5);
        stop
    else (warnings only or disabled)
        :Display vulnerability\nsummary (warnings);
    endif
endif

|User / CLI|
:Display funding information\nand suggested packages;
:Exit with code **0** (success);
stop

@enduml
