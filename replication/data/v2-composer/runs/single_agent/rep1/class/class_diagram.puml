@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Composer v2 — Class Diagram

' ============================================================
' CORE
' ============================================================
package "Composer (Core)" {

    class PartialComposer {
        -global: bool
        -package: RootPackageInterface
        -loop: Loop
        -repositoryManager: RepositoryManager
        -installationManager: InstallationManager
        -config: Config
        -eventDispatcher: EventDispatcher
        +getPackage(): RootPackageInterface
        +getConfig(): Config
        +getRepositoryManager(): RepositoryManager
        +getInstallationManager(): InstallationManager
        +getEventDispatcher(): EventDispatcher
        +isGlobal(): bool
    }

    class Composer {
        +{static} VERSION: string
        +{static} RUNTIME_API_VERSION: string
        -locker: Locker
        -downloadManager: DownloadManager
        -pluginManager: PluginManager
        -autoloadGenerator: AutoloadGenerator
        -archiveManager: ArchiveManager
        +{static} getVersion(): string
        +getLocker(): Locker
        +getDownloadManager(): DownloadManager
        +getPluginManager(): PluginManager
        +getAutoloadGenerator(): AutoloadGenerator
    }

    class Config {
        -config: array
        -baseDir: string
        +get(key: string, flags: int): mixed
        +set(key: string, value: mixed): void
        +merge(config: array): void
        +has(key: string): bool
        +all(): array
    }

    class Factory {
        +{static} create(io: IOInterface, config: string|array|null): Composer
        +{static} createGlobal(io: IOInterface): Composer
        +{static} createConfig(io: IOInterface): Config
        +{static} createDefaultDirs(config: Config): void
    }

    class Installer {
        #io: IOInterface
        #config: Config
        #package: RootPackageInterface
        #downloadManager: DownloadManager
        #repositoryManager: RepositoryManager
        #locker: Locker
        #installationManager: InstallationManager
        +run(): int
        +setUpdate(update: bool): self
        +setDryRun(dryRun: bool): self
        +setDevMode(devMode: bool): self
        +{static} create(io: IOInterface, composer: Composer): self
    }
}

' ============================================================
' PACKAGE
' ============================================================
package "Composer\\Package" {

    interface PackageInterface {
        +getName(): string
        +getPrettyName(): string
        +getVersion(): string
        +getPrettyVersion(): string
        +getType(): string
        +getRequires(): array
        +getDevRequires(): array
        +getConflicts(): array
        +getProvides(): array
        +getStability(): string
    }

    interface CompletePackageInterface {
        +getDescription(): string|null
        +getKeywords(): array
        +getLicense(): array
        +getAuthors(): array
        +getHomepage(): string|null
    }

    interface RootPackageInterface {
        +getMinimumStability(): string
        +setMinimumStability(minimumStability: string): void
        +getAliases(): array
        +getStabilityFlags(): array
    }

    abstract class BasePackage {
        #name: string
        #prettyName: string
        +{static} parseLinks(loadedLinks: array): array
        +getName(): string
        +getPrettyName(): string
        +getNames(): array
    }

    class Package {
        -version: string
        -prettyVersion: string
        -type: string
        -requires: array
        -devRequires: array
        -conflicts: array
        -provides: array
        -sourceUrl: string|null
        -distUrl: string|null
        +getVersion(): string
        +getRequires(): array
        +getType(): string
        +getSourceUrl(): string|null
    }

    class AliasPackage {
        -aliasOf: Package
        -version: string
        +getAliasOf(): Package
        +getVersion(): string
    }

    class CompletePackage {
        -description: string|null
        -keywords: array
        -license: array
        -authors: array
        -homepage: string|null
        +getDescription(): string|null
        +getLicense(): array
        +getAuthors(): array
    }

    class RootPackage {
        -minimumStability: string
        -aliases: array
        -stabilityFlags: array
        -requires: array
        +getMinimumStability(): string
        +setMinimumStability(minimumStability: string): void
        +getAliases(): array
    }

    class Locker {
        -lockFile: JsonFile
        -installationManager: InstallationManager
        -contentHash: string
        +isLocked(): bool
        +isFresh(): bool
        +getLockData(): array
        +setLockData(packages: array, devPackages: array): bool
        +getLockedRepository(devMode: bool): LockArrayRepository
    }

    class Link {
        -source: string
        -target: string
        -constraint: ConstraintInterface|null
        -description: string
        +getSource(): string
        +getTarget(): string
        +getConstraint(): ConstraintInterface|null
        +getDescription(): string
    }
}

' ============================================================
' IO
' ============================================================
package "Composer\\IO" {

    interface IOInterface {
        +isInteractive(): bool
        +isVerbose(): bool
        +isDebug(): bool
        +write(messages: string|array, newline: bool): void
        +writeError(messages: string|array, newline: bool): void
        +ask(question: string, default: mixed): mixed
        +askConfirmation(question: string, default: bool): bool
        +select(question: string, choices: array, default: mixed): string
        +setAuthentication(repositoryName: string, username: string): void
        +hasAuthentication(repositoryName: string): bool
    }

    abstract class BaseIO {
        #authentications: array
        +setAuthentication(repositoryName: string, username: string): void
        +getAuthentications(): array
        +hasAuthentication(repositoryName: string): bool
        +getAuthentication(repositoryName: string): array
    }

    class NullIO {
        +isInteractive(): bool
        +isVerbose(): bool
        +write(messages: string|array, newline: bool): void
        +ask(question: string, default: mixed): mixed
    }

    class ConsoleIO {
        -input: InputInterface
        -output: OutputInterface
        -helperSet: HelperSet
        -startTime: float
        +write(messages: string|array, newline: bool): void
        +ask(question: string, default: mixed): mixed
        +isInteractive(): bool
        +isVerbose(): bool
    }

    class BufferIO {
        +getOutput(): string
    }
}

' ============================================================
' REPOSITORY
' ============================================================
package "Composer\\Repository" {

    interface RepositoryInterface {
        +hasPackage(package: PackageInterface): bool
        +findPackage(name: string, constraint: mixed): PackageInterface|null
        +findPackages(name: string, constraint: mixed): array
        +getPackages(): array
        +count(): int
    }

    interface WritableRepositoryInterface {
        +addPackage(package: PackageInterface): void
        +removePackage(package: PackageInterface): void
        +getDevPackageNames(): array
        +write(devMode: bool, installationManager: InstallationManager): void
    }

    class ArrayRepository {
        #packages: array
        +addPackage(package: PackageInterface): void
        +removePackage(package: PackageInterface): void
        +getPackages(): array
        +hasPackage(package: PackageInterface): bool
        +findPackage(name: string, constraint: mixed): PackageInterface|null
    }

    class WritableArrayRepository {
        +write(devMode: bool, installationManager: InstallationManager): void
    }

    class FilesystemRepository {
        -file: JsonFile
        +reload(): void
        +write(devMode: bool, installationManager: InstallationManager): void
    }

    class ComposerRepository {
        -url: string
        -httpDownloader: HttpDownloader
        -cache: Cache
        -repoConfig: array
        +loadPackages(packageNameMap: array, acceptableStabilities: array): array
        +search(query: string, mode: int, type: string): array
        +getSecurityAdvisories(): array
    }

    class VcsRepository {
        -url: string
        -vcsDrivers: array
        -type: string
        +getDriver(): VcsDriverInterface|null
    }

    class RepositoryManager {
        -localRepository: WritableRepositoryInterface
        -repositories: array
        -repositoryClasses: array
        +findPackage(name: string, constraint: mixed): PackageInterface|null
        +addRepository(repository: RepositoryInterface): void
        +getLocalRepository(): WritableRepositoryInterface
        +getRepositories(): array
        +createRepository(type: string, config: array): RepositoryInterface
    }
}

' ============================================================
' DOWNLOADER
' ============================================================
package "Composer\\Downloader" {

    interface DownloaderInterface {
        +getInstallationSource(): string
        +download(package: PackageInterface, path: string): PromiseInterface|null
        +prepare(type: string, package: PackageInterface, path: string): PromiseInterface|null
        +install(package: PackageInterface, path: string): PromiseInterface|null
        +update(initial: PackageInterface, target: PackageInterface, path: string): PromiseInterface|null
        +remove(package: PackageInterface, path: string): PromiseInterface|null
        +cleanup(type: string, package: PackageInterface, path: string): PromiseInterface|null
    }

    interface ChangeReportInterface {
        +getLocalChanges(package: PackageInterface, path: string): string|null
    }

    class FileDownloader {
        #io: IOInterface
        #config: Config
        #httpDownloader: HttpDownloader
        #filesystem: Filesystem
        +download(package: PackageInterface, path: string): PromiseInterface|null
        +install(package: PackageInterface, path: string): PromiseInterface|null
        +getLocalChanges(package: PackageInterface, path: string): string|null
    }

    abstract class ArchiveDownloader {
        +extract(package: PackageInterface, file: string, path: string): PromiseInterface|null
    }

    class ZipDownloader {
        +extract(package: PackageInterface, file: string, path: string): PromiseInterface|null
    }

    class TarDownloader {
        +extract(package: PackageInterface, file: string, path: string): PromiseInterface|null
    }

    abstract class VcsDownloader {
        #io: IOInterface
        #config: Config
        #process: ProcessExecutor
        +download(package: PackageInterface, path: string): PromiseInterface|null
        +update(initial: PackageInterface, target: PackageInterface, path: string): PromiseInterface|null
        +remove(package: PackageInterface, path: string): PromiseInterface|null
        +getLocalChanges(package: PackageInterface, path: string): string|null
    }

    class GitDownloader {
        +doDownload(package: PackageInterface, path: string, url: string): PromiseInterface|null
        +doUpdate(initial: PackageInterface, target: PackageInterface, path: string, url: string): PromiseInterface|null
    }

    class HgDownloader {
        +doDownload(package: PackageInterface, path: string, url: string): PromiseInterface|null
    }

    class DownloadManager {
        -downloaders: array
        -io: IOInterface
        +addDownloader(type: string, downloader: DownloaderInterface): void
        +getDownloader(type: string): DownloaderInterface
        +download(package: PackageInterface, targetDir: string): PromiseInterface
        +install(package: PackageInterface, targetDir: string): PromiseInterface
        +update(initial: PackageInterface, target: PackageInterface, targetDir: string): PromiseInterface
    }
}

' ============================================================
' DEPENDENCY RESOLVER
' ============================================================
package "Composer\\DependencyResolver" {

    interface PolicyInterface {
        +versionCompare(a: PackageInterface, b: PackageInterface, operator: string): bool
        +selectPreferredPackages(pool: Pool, literals: array, requiredPackage: string|null): array
    }

    class DefaultPolicy {
        -preferStable: bool
        -preferLowest: bool
        +selectPreferredPackages(pool: Pool, literals: array, requiredPackage: string|null): array
        +versionCompare(a: PackageInterface, b: PackageInterface, operator: string): bool
    }

    class Solver {
        -policy: PolicyInterface
        -pool: Pool
        -decisions: Decisions
        -rules: RuleSet
        +solve(request: Request, ignorePlatformReqs: bool|array): Transaction
    }

    class Pool {
        -packages: array
        -packageByName: array
        +addPackage(package: BasePackage): void
        +whatProvides(name: string): array
        +count(): int
    }

    class Request {
        -fixedPackages: array
        -jobs: array
        +requireName(packageName: string, constraint: ConstraintInterface|null): void
        +fixPackage(package: BasePackage, lockData: array|null): void
        +getJobs(): array
    }

    class Transaction {
        -policy: PolicyInterface
        -pool: Pool
        -decisions: Decisions
        #operations: array
        +getOperations(): array
    }

    interface OperationInterface {
        +getOperationType(): string
        +show(lock: bool): string
        +__toString(): string
    }

    abstract class SolverOperation {
        +getOperationType(): string
    }

    class InstallOperation {
        -package: PackageInterface
        +getPackage(): PackageInterface
        +getOperationType(): string
    }

    class UpdateOperation {
        -initialPackage: PackageInterface
        -targetPackage: PackageInterface
        +getInitialPackage(): PackageInterface
        +getTargetPackage(): PackageInterface
        +getOperationType(): string
    }

    class UninstallOperation {
        -package: PackageInterface
        +getPackage(): PackageInterface
        +getOperationType(): string
    }
}

' ============================================================
' INSTALLER (package managers)
' ============================================================
package "Composer\\Installer" {

    interface InstallerInterface {
        +supports(packageType: string): bool
        +isInstalled(repo: InstalledRepositoryInterface, package: PackageInterface): bool
        +download(package: PackageInterface, prevPackage: PackageInterface|null): PromiseInterface|null
        +install(repo: InstalledRepositoryInterface, package: PackageInterface): PromiseInterface|null
        +update(repo: InstalledRepositoryInterface, initial: PackageInterface, target: PackageInterface): PromiseInterface|null
        +uninstall(repo: InstalledRepositoryInterface, package: PackageInterface): PromiseInterface|null
    }

    class LibraryInstaller {
        #io: IOInterface
        #downloadManager: DownloadManager
        #filesystem: Filesystem
        #vendorDir: string
        #binDir: string
        +supports(packageType: string): bool
        +install(repo: InstalledRepositoryInterface, package: PackageInterface): PromiseInterface|null
        +update(repo: InstalledRepositoryInterface, initial: PackageInterface, target: PackageInterface): PromiseInterface|null
        +uninstall(repo: InstalledRepositoryInterface, package: PackageInterface): PromiseInterface|null
    }

    class PluginInstaller {
        -pluginManager: PluginManager
        +install(repo: InstalledRepositoryInterface, package: PackageInterface): PromiseInterface|null
        +update(repo: InstalledRepositoryInterface, initial: PackageInterface, target: PackageInterface): PromiseInterface|null
    }

    class MetapackageInstaller {
        -io: IOInterface
        +supports(packageType: string): bool
        +install(repo: InstalledRepositoryInterface, package: PackageInterface): PromiseInterface|null
    }

    class InstallationManager {
        -installers: array
        -notifiableInstallers: array
        -loop: Loop
        +addInstaller(installer: InstallerInterface): void
        +removeInstaller(installer: InstallerInterface): void
        +getInstaller(type: string): InstallerInterface
        +isPackageInstalled(repo: InstalledRepositoryInterface, package: PackageInterface): bool
        +execute(repo: InstalledRepositoryInterface, operations: array): void
    }
}

' ============================================================
' PLUGIN
' ============================================================
package "Composer\\Plugin" {

    interface PluginInterface {
        +activate(composer: Composer, io: IOInterface): void
        +deactivate(composer: Composer, io: IOInterface): void
        +uninstall(composer: Composer, io: IOInterface): void
    }

    class PluginManager {
        -composer: Composer
        -io: IOInterface
        -plugins: array
        -registeredPlugins: array
        +addPlugin(plugin: PluginInterface): void
        +removePlugin(plugin: PluginInterface): void
        +getPlugins(): array
        +loadInstalledPlugins(): void
        +isPluginAllowed(package: string, isRootRequire: bool): bool
    }
}

' ============================================================
' EVENT DISPATCHER
' ============================================================
package "Composer\\EventDispatcher" {

    class Event {
        -name: string
        -args: array
        -flags: array
        +getName(): string
        +getArguments(): array
        +stopPropagation(): void
        +isPropagationStopped(): bool
    }

    class EventDispatcher {
        -composer: Composer
        -io: IOInterface
        -listeners: array
        +dispatch(eventName: string, event: Event|null): int
        +addListener(eventName: string, listener: callable, priority: int): void
        +removeListener(eventName: string, listener: callable): void
        +hasEventListeners(event: Event): bool
    }
}

' ============================================================
' ADVISORY
' ============================================================
package "Composer\\Advisory" {

    class PartialSecurityAdvisory {
        +advisoryId: string
        +packageName: string
        +affectedVersions: string
        +title: string
        +cve: string|null
        +link: string
    }

    class SecurityAdvisory {
        +sources: array
        +reportedAt: DateTimeImmutable
        +composerRepository: string|null
    }

    class IgnoredSecurityAdvisory {
        +ignoreReason: string
    }

    class Auditor {
        -httpDownloader: HttpDownloader
        +audit(io: IOInterface, packages: array, auditFormat: string): int
        +getAuditConfig(): AuditConfig
    }
}

' ============================================================
' INHERITANCE RELATIONSHIPS
' ============================================================

' Core
Composer --|> PartialComposer

' Package interfaces
CompletePackageInterface --|> PackageInterface
RootPackageInterface --|> CompletePackageInterface

' Package classes
BasePackage ..|> PackageInterface
Package --|> BasePackage
AliasPackage --|> BasePackage
CompletePackage --|> Package
CompletePackage ..|> CompletePackageInterface
RootPackage --|> CompletePackage
RootPackage ..|> RootPackageInterface

' IO
BaseIO ..|> IOInterface
NullIO --|> BaseIO
ConsoleIO --|> BaseIO
BufferIO --|> ConsoleIO

' Repository interfaces
WritableRepositoryInterface --|> RepositoryInterface

' Repository classes
ArrayRepository ..|> RepositoryInterface
WritableArrayRepository --|> ArrayRepository
WritableArrayRepository ..|> WritableRepositoryInterface
FilesystemRepository --|> WritableArrayRepository
ComposerRepository --|> ArrayRepository
VcsRepository --|> ArrayRepository

' Downloader
FileDownloader ..|> DownloaderInterface
FileDownloader ..|> ChangeReportInterface
ArchiveDownloader --|> FileDownloader
ZipDownloader --|> ArchiveDownloader
TarDownloader --|> ArchiveDownloader
VcsDownloader ..|> DownloaderInterface
VcsDownloader ..|> ChangeReportInterface
GitDownloader --|> VcsDownloader
HgDownloader --|> VcsDownloader

' DependencyResolver
DefaultPolicy ..|> PolicyInterface
SolverOperation ..|> OperationInterface
InstallOperation --|> SolverOperation
UpdateOperation --|> SolverOperation
UninstallOperation --|> SolverOperation

' Installer
LibraryInstaller ..|> InstallerInterface
PluginInstaller --|> LibraryInstaller
MetapackageInstaller ..|> InstallerInterface

' Advisory
SecurityAdvisory --|> PartialSecurityAdvisory
IgnoredSecurityAdvisory --|> SecurityAdvisory

' ============================================================
' COMPOSITION / AGGREGATION
' ============================================================

' Core composition
PartialComposer o-- RepositoryManager : repositoryManager
PartialComposer o-- InstallationManager : installationManager
PartialComposer o-- EventDispatcher : eventDispatcher
PartialComposer o-- Config : config

Composer o-- Locker : locker
Composer o-- DownloadManager : downloadManager
Composer o-- PluginManager : pluginManager

' Relationships
Solver ..> PolicyInterface : uses
Solver ..> Pool : builds from
Solver ..> Request : reads
Solver ..> Transaction : produces

InstallationManager o-- InstallerInterface : installers
DownloadManager o-- DownloaderInterface : downloaders

PluginManager ..> PluginInterface : manages
PluginManager ..> Composer : references

EventDispatcher ..> Composer : references

Installer ..> DownloadManager : uses
Installer ..> RepositoryManager : uses
Installer ..> Locker : reads/writes

LibraryInstaller ..> DownloadManager : uses

@enduml
