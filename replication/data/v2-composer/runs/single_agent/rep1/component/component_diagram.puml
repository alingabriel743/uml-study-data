@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam component {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam arrow {
    Color #495057
}

title Composer v2 — Component Architecture

' ============================================================
' CLI Layer
' ============================================================
package "CLI Layer" {
    [Console\nApplication] as Console
    [Command\n(install, require, update\nremove, show, …)] as Command
    [IO\n(ConsoleIO / NullIO\n/ BufferIO)] as IO
    [Question] as Question
}

' ============================================================
' Core / Orchestration Layer
' ============================================================
package "Core / Orchestration Layer" {
    [Composer\n(main context)] as ComposerCore
    [Factory\n(bootstrap)] as Factory
    [Installer\n(top-level workflow)] as InstallerCore
    [EventDispatcher\n(scripts & hooks)] as EventDispatcher
    [Plugin\n(PluginManager)] as Plugin
    [Script\n(ScriptEvents)] as Script
}

' ============================================================
' Package Management Layer
' ============================================================
package "Package Management Layer" {
    package "Package Model" {
        [Package\n(models, Locker\nRootPackage, …)] as Package
        [Package\Version\n(VersionParser\nVersionBumper)] as PackageVersion
        [Package\Loader\n(ArrayLoader\nRootPackageLoader)] as PackageLoader
        [Package\Dumper\n(ArrayDumper)] as PackageDumper
        [Package\Archiver\n(ArchiveManager\nZipArchiver)] as PackageArchiver
    }

    package "Repository" {
        [Repository\n(RepositoryManager\nComposerRepository\nVcsRepository…)] as Repository
        [Repository\Vcs\n(GitDriver, SvnDriver\nGitHubDriver…)] as RepositoryVcs
    }

    package "Solver" {
        [DependencyResolver\n(Solver, Pool\nRequest, Transaction)] as DependencyResolver
        [DependencyResolver\nOperation\n(Install / Update\n/ Uninstall)] as SolverOperation
    }

    [InstallationManager\n(LibraryInstaller\nMetapackageInstaller)] as InstallationMgr
    [Downloader\n(DownloadManager\nGitDownloader, ZipDownloader…)] as Downloader
    [Autoload\n(AutoloadGenerator\nClassLoader)] as Autoload
}

' ============================================================
' Infrastructure / Support Layer
' ============================================================
package "Infrastructure / Support Layer" {
    [Config\n(JsonConfigSource)] as Config
    [Json\n(JsonFile\nJsonManipulator)] as Json
    [Util\n(HttpDownloader\nProcessExecutor\nGit / GitHub / GitLab)] as Util
    [Util\Http\n(CurlDownloader\nProxyManager)] as UtilHttp
    [Cache] as Cache
    [Platform\n(Version, Runtime\nHhvmDetector)] as Platform
    [Filter\n(PlatformRequirementFilter)] as Filter
}

' ============================================================
' Security Layer
' ============================================================
package "Security Layer" {
    [Advisory\n(Auditor\nSecurityAdvisory)] as Advisory
    [FilterList\n(FilterListAuditor\nFilterListApiClient)] as FilterList
    [Policy\n(PolicyConfig\nAdvisoriesPolicyConfig)] as Policy
}

' ============================================================
' External / System
' ============================================================
package "External Systems" {
    [Packagist /\nComposer Repos] as Packagist
    [VCS Remotes\n(GitHub, GitLab\nBitbucket, SVN…)] as VCSRemotes
    [File System\n& PHP Runtime] as FileSystem
}

' ============================================================
' Dependencies — CLI Layer → Core
' ============================================================
Console --> Command : invokes
Console --> IO : uses
Command --> ComposerCore : accesses
Command --> IO : reads/writes
Command --> Question : prompts via

' ============================================================
' Dependencies — Core Layer
' ============================================================
Factory --> ComposerCore : creates
ComposerCore --> InstallerCore : delegates to
ComposerCore --> EventDispatcher : fires events via
ComposerCore --> Plugin : manages via
Plugin --> EventDispatcher : subscribes to
EventDispatcher --> Script : dispatches script events

' ============================================================
' Dependencies — Core → Package Management
' ============================================================
InstallerCore --> DependencyResolver : resolves deps with
InstallerCore --> Repository : queries packages from
InstallerCore --> InstallationMgr : executes operations via
InstallerCore --> Downloader : downloads packages with
InstallerCore --> Autoload : regenerates autoloader via
InstallerCore --> Advisory : audits packages with
InstallerCore --> FilterList : filters pool with
InstallerCore --> Filter : filters platform reqs with
InstallerCore --> Policy : applies audit policy via

' ============================================================
' Dependencies — Package Management internal
' ============================================================
DependencyResolver --> Package : resolves against
DependencyResolver --> SolverOperation : produces
DependencyResolver --> FilterList : pool filter via
Repository --> Package : provides
Repository --> RepositoryVcs : delegates VCS to
PackageLoader --> Package : constructs
PackageDumper --> Package : serializes
PackageArchiver --> Package : archives
PackageVersion --> Package : versions

' ============================================================
' Dependencies — Package Management → Infrastructure
' ============================================================
Repository --> Json : reads metadata via
Repository --> Cache : caches metadata in
Repository --> Util : HTTP requests via
Downloader --> Util : downloads via
Downloader --> Cache : stores downloads in
Autoload --> Json : writes autoload via
Config --> Json : reads/writes config via
RepositoryVcs --> Util : HTTP / process via

' ============================================================
' Dependencies — Infrastructure internal
' ============================================================
Util --> UtilHttp : delegates HTTP to
Util --> Platform : detects platform via

' ============================================================
' Dependencies — External
' ============================================================
Repository ..> Packagist : fetches metadata
RepositoryVcs ..> VCSRemotes : clones / fetches
Downloader ..> VCSRemotes : clones / downloads
InstallationMgr ..> FileSystem : installs files to
Autoload ..> FileSystem : writes autoload files
Cache ..> FileSystem : persists cache

@enduml
