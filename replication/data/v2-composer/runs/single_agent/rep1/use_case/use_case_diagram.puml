@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #495057
    FontColor #212529
}

title Composer v2 — Use Case Diagram

left to right direction

actor "Developer" as dev
actor "Package\nRepository\n(Packagist / Private)" as repo
actor "VCS\n(Git / SVN)" as vcs
actor "PHP Runtime" as php

rectangle "Composer v2 — PHP Package Manager" {

    package "Dependency Management" {
        usecase "Install Dependencies" as UC_Install
        usecase "Update Dependencies" as UC_Update
        usecase "Add Package Requirement" as UC_Require
        usecase "Remove Package" as UC_Remove
        usecase "Reinstall Packages" as UC_Reinstall
        usecase "Bump Version Constraints" as UC_Bump
    }

    package "Project Setup" {
        usecase "Initialize Project\n(composer.json)" as UC_Init
        usecase "Create Project\nfrom Template" as UC_CreateProject
        usecase "Validate Configuration" as UC_Validate
    }

    package "Package Discovery & Information" {
        usecase "Search Packages" as UC_Search
        usecase "Show Package Information" as UC_Show
        usecase "List Outdated Packages" as UC_Outdated
        usecase "View Package Licenses" as UC_Licenses
        usecase "Check Dependency Graph" as UC_Depends
        usecase "Check Package Conflicts" as UC_Prohibits
        usecase "View Funding Information" as UC_Fund
        usecase "Browse Package Homepage" as UC_Home
        usecase "List Package Suggestions" as UC_Suggests
    }

    package "Configuration & Policy" {
        usecase "Configure Composer Settings" as UC_Config
        usecase "Manage Repositories" as UC_Repo
        usecase "Manage Version Policies" as UC_Policy
        usecase "Run Commands Globally" as UC_Global
    }

    package "Script & Automation" {
        usecase "Execute Vendor Binary" as UC_Exec
        usecase "Run Lifecycle Scripts" as UC_RunScript
        usecase "Dump Autoloader" as UC_DumpAutoload
    }

    package "Security & Diagnostics" {
        usecase "Audit Security Vulnerabilities" as UC_Audit
        usecase "Diagnose System Issues" as UC_Diagnose
        usecase "Check Platform Requirements" as UC_PlatformReqs
        usecase "Archive Package" as UC_Archive
    }

    package "Maintenance" {
        usecase "Clear Composer Cache" as UC_ClearCache
        usecase "Self-Update Composer" as UC_SelfUpdate
        usecase "Show Modified Vendor Files" as UC_Status
    }
}

' --- Developer interactions ---
dev --> UC_Install
dev --> UC_Update
dev --> UC_Require
dev --> UC_Remove
dev --> UC_Reinstall
dev --> UC_Bump

dev --> UC_Init
dev --> UC_CreateProject
dev --> UC_Validate

dev --> UC_Search
dev --> UC_Show
dev --> UC_Outdated
dev --> UC_Licenses
dev --> UC_Depends
dev --> UC_Prohibits
dev --> UC_Fund
dev --> UC_Home
dev --> UC_Suggests

dev --> UC_Config
dev --> UC_Repo
dev --> UC_Policy
dev --> UC_Global

dev --> UC_Exec
dev --> UC_RunScript
dev --> UC_DumpAutoload

dev --> UC_Audit
dev --> UC_Diagnose
dev --> UC_PlatformReqs
dev --> UC_Archive

dev --> UC_ClearCache
dev --> UC_SelfUpdate
dev --> UC_Status

' --- External actor interactions ---
UC_Search --> repo
UC_Install --> repo
UC_Update --> repo
UC_Require --> repo
UC_Outdated --> repo
UC_CreateProject --> repo
UC_Audit --> repo

UC_Install --> vcs
UC_Update --> vcs
UC_Require --> vcs
UC_CreateProject --> vcs

UC_PlatformReqs --> php
UC_Diagnose --> php

' --- Include / Extend relationships ---
UC_Install ..> UC_DumpAutoload : <<include>>
UC_Update ..> UC_DumpAutoload : <<include>>
UC_Require ..> UC_Install : <<include>>
UC_Global ..> UC_Install : <<extend>>
UC_Global ..> UC_Update : <<extend>>
UC_Global ..> UC_Require : <<extend>>

@enduml
