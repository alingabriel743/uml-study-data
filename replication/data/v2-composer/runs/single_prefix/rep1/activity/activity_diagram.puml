@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}

skinparam swimlane {
    BackgroundColor #FEFEFE
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 13
}

title Composer — Security Audit Workflow

|User / CLI|
start
:Run **composer audit** command;

|AuditCommand|
:configure()\nRegister options, arguments\nand output format flags;
:execute($input, $output)\nInitialise IO and Composer instance;
:getPackages($composer, $input)\nResolve installed package list;

|Auditor|
:audit($io, $repoSet, $policyConfig,\n$packages, $format, $warningOnly,\n$filterListProviderSet);

fork
    :Query security advisories\nfrom repository set;
    :Match package versions\nagainst affected version ranges;
    if (Vulnerabilities found?) then (yes)
        :Iterate over matching advisories;
        if (Advisory in ignore list?) then (yes)
            :Create IgnoredSecurityAdvisory\n(preserves reason & metadata);
        else (no)
            :Create SecurityAdvisory\n(CVE, link, affectedVersions);
            :Add to vulnerable packages list;
        endif
    else (no)
        :No known vulnerabilities;
    endif
fork again
    :Evaluate each package\nagainst abandonment criteria;
    if (Abandoned packages found?) then (yes)
        :Mark packages as abandoned\nfor reporting;
    else (no)
        :All packages actively maintained;
    endif
fork again
    :Apply filter list provider\nto exclude allowed advisories;
    if (Filtered advisories present?) then (yes)
        :Collect filtered package entries;
    else (no)
        :No filtered advisories;
    endif
end fork

:calculateBitmask(\n$hasVulnerablePackages,\n$hasAbandonedPackages,\n$hasFilteredPackages)\nCompute integer exit-code bitmask;

|AuditCommand|
if (warningOnly mode?) then (yes)
    :Emit all findings\nas non-fatal warnings only;
else (no)
    if (Vulnerabilities present?) then (yes)
        :outputAdvisories($io,\n$advisories, $format)\nPrint CVE details & affected versions;
    endif
    if (Abandoned packages present?) then (yes)
        :outputAbandonedPackages($io,\n$packages, $format)\nList unmaintained packages;
    endif
    if (Filtered packages present?) then (yes)
        :outputFilteredPackages($io,\n$filteredPackages, $format)\nList suppressed advisories;
    endif
endif

|User / CLI|
if (Exit bitmask == 0?) then (yes)
    :Return exit code 0\nAudit passed — no issues;
    stop
else (no)
    :Return non-zero exit code\nIssues detected — review output;
    stop
endif

@enduml
