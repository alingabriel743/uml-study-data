@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam component {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}

title Composer — Component Diagram

package "CLI Layer" {
    [Console Application] as console
    [Command Handlers] as commands
    [Console Input] as input
}

package "Core" {
    [Composer Engine] as engine
    [Configuration] as config
    [Cache] as cache
    [Factory] as factory
}

package "Package Model" {
    [Package] as pkg
    [Package Archiver] as archiver
    [Package Comparer] as comparer
}

package "Dependency Resolution" {
    [Dependency Resolver] as resolver
    [Solver Operations] as operations
    [Platform Requirement Filter] as platfilter
}

package "Installation" {
    [Installation Manager] as installer
    [Downloader] as downloader
}

package "Security & Advisory" {
    [Auditor] as auditor
    [FilterList] as filterlist
    [FilterList Providers] as flproviders
    [FilterList Sources] as flsources
}

package "Autoloading" {
    [Autoload Generator] as autoload
    [Class Loader] as classloader
    [Class Map Generator] as classmapgen
}

package "Infrastructure" {
    [IO] as io
    [JSON Utilities] as json
    [Event Dispatcher] as events
    [Exception Handling] as exceptions
}

package "Static Analysis" {
    [PHPStan Extensions] as phpstan
}

' CLI Layer internal
console --> commands
console --> input

' CLI to Core
commands --> engine
commands --> config
commands --> io

' Core relationships
engine --> factory
engine --> cache
engine --> config
factory --> config

' Core to other layers
engine --> resolver
engine --> installer
engine --> autoload
engine --> events

' Dependency Resolution
resolver --> operations
resolver --> platfilter
resolver --> pkg

' Installation
installer --> downloader
installer --> pkg
installer --> events

' Package Model
archiver --> pkg
comparer --> pkg

' Security
auditor --> filterlist
filterlist --> flproviders
filterlist --> flsources

' Commands to security
commands --> auditor

' Autoloading
autoload --> classloader
autoload --> classmapgen

' Infrastructure usage
installer --> io
downloader --> io
downloader --> exceptions
resolver --> exceptions

' Config infrastructure
config --> json
engine --> json

' PHPStan
phpstan --> config
phpstan --> resolver

@enduml
