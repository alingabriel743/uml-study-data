@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequenceArrowThickness 2
skinparam roundcorner 8
skinparam sequenceParticipant underline
skinparam sequenceBoxBackgroundColor #E9ECEF
skinparam sequenceBoxBorderColor #6C757D
skinparam sequenceLifeLineBorderColor #495057
skinparam sequenceActiveBorderColor #343A40
skinparam sequenceActiveBackgroundColor #DEE2E6
skinparam noteBorderColor #6C757D
skinparam noteBackgroundColor #F8F9FA

title Composer — Security Audit & Autoload Generation Sequence

actor "Developer" as dev

box "CLI Layer" #E9ECEF
    participant "BaseCommand" as base
    participant "AuditCommand" as auditCmd
    participant "CreateProjectCommand" as createCmd
end box

box "Advisory Subsystem" #FFF3CD
    participant "Auditor" as auditor
    participant "SecurityAdvisory" as secAdvisory
    participant "PartialSecurityAdvisory" as partialAdvisory
    participant "IgnoredSecurityAdvisory" as ignoredAdvisory
end box

box "Autoload Subsystem" #D1ECF1
    participant "AutoloadGenerator" as autoloadGen
    participant "ClassMapGenerator" as classMapGen
    participant "ClassLoader" as classLoader
end box

participant "Cache" as cache

== Security Audit Flow ==

dev -> auditCmd : execute($input, $output)
activate auditCmd

auditCmd -> base : getComposer($required, $disablePlugins, $disableScripts)
activate base
base -> base : createComposerInstance($input, $io, $config, ...)
base --> auditCmd : $composer
deactivate base

auditCmd -> auditCmd : getPackages($composer, $input)
activate auditCmd
auditCmd --> auditCmd : $packages
deactivate auditCmd

auditCmd -> base : createPolicyConfig($config, $input)
activate base
base --> auditCmd : $policyConfig
deactivate base

auditCmd -> auditor : audit($io, $repoSet, $policyConfig, $packages, $format, $warningOnly, $filterListProviderSet)
activate auditor

    auditor -> partialAdvisory : create($packageName, $data, $parser)
    activate partialAdvisory
    partialAdvisory --> auditor : $advisory
    deactivate partialAdvisory

    auditor -> secAdvisory : __construct($packageName, $advisoryId, $affectedVersions, $title, ...)
    activate secAdvisory
    secAdvisory --> auditor : SecurityAdvisory instance
    deactivate secAdvisory

    alt advisory is ignored
        auditor -> secAdvisory : toIgnoredAdvisory($ignoreReason)
        activate secAdvisory
        secAdvisory -> ignoredAdvisory : __construct($packageName, $advisoryId, $affectedVersions, ...)
        activate ignoredAdvisory
        ignoredAdvisory --> secAdvisory : IgnoredSecurityAdvisory instance
        deactivate ignoredAdvisory
        secAdvisory --> auditor : $ignoredAdvisory
        deactivate secAdvisory
    end

    auditor -> auditor : outputAdvisories($io, $advisories, $format)
    activate auditor
    auditor -> secAdvisory : jsonSerialize()
    activate secAdvisory
    secAdvisory --> auditor : advisory data[]
    deactivate secAdvisory
    deactivate auditor

    auditor -> auditor : outputAbandonedPackages($io, $packages, $format)
    activate auditor
    auditor --> auditor
    deactivate auditor

    auditor -> auditor : outputFilteredPackages($io, $filteredPackages, $format)
    activate auditor
    auditor --> auditor
    deactivate auditor

    auditor -> auditor : calculateBitmask($hasVulnerablePackages, $hasAbandonedPackages, $hasFilteredPackages)
    activate auditor
    note right : Bitwise result:\n0 = clean\n1 = vulnerable\n2 = abandoned\n4 = filtered
    auditor --> auditor : $exitCode
    deactivate auditor

auditor --> auditCmd : $exitCode
deactivate auditor

auditCmd --> dev : exit code (0 = secure)
deactivate auditCmd

== Autoload Dump Flow (CreateProject) ==

dev -> createCmd : execute($input, $output)
activate createCmd

createCmd -> createCmd : installProject($io, $config, $input, $packageName, $directory, ...)
activate createCmd

    createCmd -> createCmd : installRootPackage($input, $io, $config, $packageName, ...)
    activate createCmd
    createCmd --> createCmd : root package installed
    deactivate createCmd

    createCmd -> autoloadGen : dump($config, $localRepo, $rootPackage, $installationManager, $targetDir, ...)
    activate autoloadGen

        autoloadGen -> classMapGen : createMap($path, $excluded, $io, $namespace, $autoloadType, $scannedFiles)
        activate classMapGen
        classMapGen --> autoloadGen : $classMap[]
        deactivate classMapGen

        autoloadGen -> autoloadGen : getAutoloadRealFile($useClassMap, $useIncludePath, ...)
        activate autoloadGen
        autoloadGen --> autoloadGen : $realFile content
        deactivate autoloadGen

        autoloadGen -> autoloadGen : getIncludePathsFile($packageMap, $filesystem, ...)
        activate autoloadGen
        autoloadGen --> autoloadGen : include_paths.php
        deactivate autoloadGen

        autoloadGen -> autoloadGen : getIncludeFilesFile($files, $filesystem, ...)
        activate autoloadGen
        autoloadGen --> autoloadGen : include_files.php
        deactivate autoloadGen

        autoloadGen -> cache : write($file, $contents)
        activate cache
        cache --> autoloadGen : bool
        deactivate cache

        autoloadGen -> classLoader : addPsr4($prefix, $paths, $prepend)
        activate classLoader
        classLoader --> autoloadGen : registered
        deactivate classLoader

        autoloadGen -> classLoader : setPsr4($prefix, $paths)
        activate classLoader
        classLoader --> autoloadGen : registered
        deactivate classLoader

        autoloadGen -> classMapGen : dump($dirs, $file)
        activate classMapGen
        classMapGen --> autoloadGen : classmap file written
        deactivate classMapGen

    autoloadGen --> createCmd : autoloader dumped
    deactivate autoloadGen

deactivate createCmd
createCmd --> dev : project created successfully
deactivate createCmd

@enduml
