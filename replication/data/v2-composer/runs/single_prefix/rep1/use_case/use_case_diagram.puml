@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #336699
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam ArrowColor #495057

left to right direction

title Composer — PHP Dependency Manager: Use Case Diagram

actor "Developer" as dev
actor "Package Repository\n(Packagist)" as repo
actor "CI/CD Pipeline" as ci

rectangle "Composer" {

    package "Package Management" {
        usecase "Create Project" as UC_CREATE
        usecase "Archive Package" as UC_ARCHIVE
        usecase "Bump Dependency Versions" as UC_BUMP
        usecase "Select Package Version" as UC_SELECT_PKG
    }

    package "Dependency Analysis" {
        usecase "Inspect Dependencies" as UC_DEPENDS
        usecase "Check Platform Requirements" as UC_PLATFORM
        usecase "Print Dependency Tree" as UC_TREE
    }

    package "Security & Auditing" {
        usecase "Audit Security Vulnerabilities" as UC_AUDIT
        usecase "Report Security Advisories" as UC_ADVISORY
        usecase "Ignore Security Advisory" as UC_IGNORE
    }

    package "Autoloading" {
        usecase "Generate Autoloader" as UC_AUTOLOAD
        usecase "Build Class Map" as UC_CLASSMAP
        usecase "Register PSR-4 Namespaces" as UC_PSR4
    }

    package "Configuration & Maintenance" {
        usecase "Manage Configuration" as UC_CONFIG
        usecase "Clear Cache" as UC_CLEAR_CACHE
        usecase "Diagnose Environment" as UC_DIAGNOSE
    }

    package "General" {
        usecase "View About Info" as UC_ABOUT
    }
}

' Developer interactions
dev --> UC_CREATE
dev --> UC_ARCHIVE
dev --> UC_BUMP
dev --> UC_DEPENDS
dev --> UC_PLATFORM
dev --> UC_AUDIT
dev --> UC_CONFIG
dev --> UC_CLEAR_CACHE
dev --> UC_DIAGNOSE
dev --> UC_ABOUT
dev --> UC_AUTOLOAD

' CI/CD Pipeline interactions
ci --> UC_AUDIT
ci --> UC_PLATFORM
ci --> UC_AUTOLOAD
ci --> UC_BUMP

' Package Repository interactions
repo --> UC_CREATE
repo --> UC_ADVISORY

' Include/Extend relationships
UC_CREATE ..> UC_SELECT_PKG : <<include>>
UC_ARCHIVE ..> UC_SELECT_PKG : <<include>>

UC_AUDIT ..> UC_ADVISORY : <<include>>
UC_ADVISORY ..> UC_IGNORE : <<extend>>

UC_AUTOLOAD ..> UC_CLASSMAP : <<include>>
UC_AUTOLOAD ..> UC_PSR4 : <<include>>

UC_DEPENDS ..> UC_TREE : <<include>>

@enduml
