@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #495057
}

skinparam swimlane {
    BorderColor #6C757D
    TitleFontColor #212529
    TitleFontSize 13
}

title Composer Security Audit Workflow

|User / CLI|
start
:Run **composer audit** command;

|AuditCommand|
:configure() — register options\n(format, locked, no-dev, etc.);
:execute($input, $output);
:getPackages($composer, $input);

if (Packages found?) then (yes)
    :Retrieve installed package list\nfrom local repository;
else (no)
    :Log "No packages to audit";
    stop
endif

:createPolicyConfig($config, $input);
:Initialise AuditConfig\n($audit, $auditFormat);

|Auditor|
:audit($io, $repoSet, $policyConfig,\n$packages, $format, $warningOnly,\n$filterListProviderSet);

fork
    :Fetch security advisories\nfor all packages;
fork again
    :Identify abandoned\npackages in repository;
end fork

:Match packages against\naffected version ranges\n(SecurityAdvisory / PartialSecurityAdvisory);

if (Ignored advisories present?) then (yes)
    :Convert SecurityAdvisory\n→ IgnoredSecurityAdvisory\n(toIgnoredAdvisory($ignoreReason));
else (no)
endif

:Apply filter list\n(filterListProviderSet);

if (Vulnerable packages found?) then (yes)
    :outputAdvisories($io, $advisories, $format);
    :Serialize advisories via\njsonSerialize();
    note right
      Reports CVE ID, title,
      affected versions and link
    end note
else (no)
    :Log "No security advisories found";
endif

if (Abandoned packages found?) then (yes)
    :outputAbandonedPackages\n($io, $packages, $format);
else (no)
endif

if (Filtered (suppressed) packages?) then (yes)
    :outputFilteredPackages\n($io, $filteredPackages, $format);
else (no)
endif

:calculateBitmask(\n  $hasVulnerablePackages,\n  $hasAbandonedPackages,\n  $hasFilteredPackages\n);

|AuditCommand|
if (warningOnly mode?) then (yes)
    :Return exit code 0\n(warnings, not errors);
else (no)
    if (Bitmask > 0?) then (yes)
        :Return non-zero exit code\n(signals failure to caller);
    else (no)
        :Return exit code 0\n(all packages safe);
    endif
endif

|User / CLI|
:Display audit report\n(table / JSON / summary format);
stop

@enduml
