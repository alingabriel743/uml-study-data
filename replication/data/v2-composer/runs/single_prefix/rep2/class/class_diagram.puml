@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Composer — Class Diagram

' ─────────────────────────────────────────
' External / framework types
' ─────────────────────────────────────────
interface JsonSerializable <<external>>
class Command <<external>>

' ─────────────────────────────────────────
' Advisory package
' ─────────────────────────────────────────
package "Composer\\Advisory" {

    class AuditConfig {
        -$audit
        -$auditFormat
        +__construct($audit, $auditFormat)
    }

    class Auditor {
        +audit($io, $repoSet, $policyConfig, $packages, $format, $warningOnly, $filterListProviderSet)
        +filterAbandonedPackages($packages, $ignoreAbandoned)
        -calculateBitmask($hasVulnerablePackages, $hasAbandonedPackages, $hasFilteredPackages)
        -countAdvisories($advisories)
        -getAdvisoryId($advisory)
    }

    class PartialSecurityAdvisory {
        -$packageName
        -$advisoryId
        -$affectedVersions
        +__construct($packageName, $advisoryId, $affectedVersions)
        +create($packageName, $data, $parser)
        +jsonSerialize()
    }

    class SecurityAdvisory {
        -$cve
        -$link
        -$reportedAt
        -$severity
        -$sources
        +__construct($packageName, $advisoryId, $affectedVersions, $title, $sources, $reportedAt, $cve, $link)
        +jsonSerialize()
        +toIgnoredAdvisory($ignoreReason)
    }

    class IgnoredSecurityAdvisory {
        -$ignoreReason
        +__construct($packageName, $advisoryId, $affectedVersions, $title, $sources, $reportedAt, $cve, $link)
        +jsonSerialize()
    }

    PartialSecurityAdvisory ..|> JsonSerializable
    SecurityAdvisory --|> PartialSecurityAdvisory
    IgnoredSecurityAdvisory --|> SecurityAdvisory
}

' ─────────────────────────────────────────
' Autoload package
' ─────────────────────────────────────────
package "Composer\\Autoload" {

    class AutoloadGenerator {
        -$apcu
        -$apcuPrefix
        -$classMapAuthoritative
        -$devMode
        -$dryRun
        +__construct($eventDispatcher, $io)
        +buildPackageMap($installationManager, $rootPackage, $packages)
        +createLoader($autoloads, $vendorDir)
        +dump($config, $localRepo, $rootPackage, $installationManager, $targetDir, $scanPsrPackages, $suffix, $locker)
        -buildExclusionRegex($dir, $excluded)
    }

    class ClassLoader {
        -$apcuPrefix
        -$classMap
        -$classMapAuthoritative
        -$fallbackDirsPsr0
        -$fallbackDirsPsr4
        +__construct($vendorDir)
        +add($prefix, $paths, $prepend)
        +addClassMap($classMap)
        +addPsr4($prefix, $paths, $prepend)
        +findFile($class)
    }

    class ClassMapGenerator {
        +createMap($path, $excluded, $io, $namespace, $autoloadType, $scannedFiles)
        +dump($dirs, $file)
    }
}

' ─────────────────────────────────────────
' Cache
' ─────────────────────────────────────────
package "Composer" {

    class Cache {
        -$allowlist
        -$cacheCollected
        -$enabled
        -$filesystem
        -$io
        +__construct($io, $cacheDir, $allowlist, $filesystem, $readOnly)
        +clear()
        +copyFrom($file, $source)
        +copyTo($file, $target)
        +gc($ttl, $maxSize)
    }
}

' ─────────────────────────────────────────
' Command package
' ─────────────────────────────────────────
package "Composer\\Command" {

    class BaseCommand {
        #$composer
        #$io
        +complete($input, $suggestions)
        #createAuditConfig($input)
        #createComposerInstance($input, $io, $config, $disablePlugins, $disableScripts)
        #createPolicyConfig($config, $input)
        #formatRequirements($requirements)
    }

    class BaseConfigCommand {
        #$config
        #$configFile
        #$configSource
        #getAuthConfigFile($input, $config)
        #getComposerConfigFile($input, $config)
        #initialize($input, $output)
    }

    class BaseDependencyCommand {
        #$colors
        #doExecute($input, $output, $inverted)
        #initStyles($output)
        #printTable($output, $results)
        #printTree($results, $prefix, $level)
        -writeTreeLine($line)
    }

    class AboutCommand {
        #configure()
        #execute($input, $output)
    }

    class ArchiveCommand {
        #configure()
        #execute($input, $output)
        #archive($io, $config, $packageName, $version, $format, $dest, $fileName, $ignoreFilters)
        #selectPackage($io, $packageName, $version)
    }

    class AuditCommand {
        #configure()
        #execute($input, $output)
        -getPackages($composer, $input)
    }

    class BumpCommand {
        #configure()
        #execute($input, $output)
        +doBump($io, $devOnly, $noDevOnly, $dryRun, $packagesFilter, $devOnlyFlagHint)
        -updateFileCleanly($json, $updates)
    }

    class CheckPlatformReqsCommand {
        #configure()
        #execute($input, $output)
        #printTable($output, $results, $format)
    }

    class ClearCacheCommand {
        #configure()
        #execute($input, $output)
    }

    class ConfigCommand {
        -$authConfigFile
        -$authConfigSource
        #configure()
        #execute($input, $output)
        #handleMultiValue($key, $callbacks, $values, $method)
        #handleSingleValue($key, $callbacks, $values, $method)
        -flattenSettingKeys($config, $prefix)
    }

    class CreateProjectCommand {
        -$suggestedPackagesReporter
        #configure()
        #execute($input, $output)
        +installProject($io, $config, $input, $packageName, $directory, $packageVersion, $stability, $preferSource)
        #installRootPackage($input, $io, $config, $packageName, $platformRequirementFilter, $directory, $packageVersion, $stability)
    }

    class DependsCommand {
        #configure()
        #execute($input, $output)
    }

    class DiagnoseCommand {
        -$exitCode
        -$httpDownloader
        -$process
        -checkComposerAudit($config)
        -checkComposerLockSchema($locker)
        -checkComposerNetworkHttpEnablement()
        -checkComposerRepo($url, $config)
        -checkComposerSchema()
    }

    trait CompletionTrait {
        +requireComposer($disablePlugins, $disableScripts)
        -suggestAvailablePackage($max)
        -suggestAvailablePackageInclPlatform()
        -suggestInstalledPackage($includeRootPackage, $includePlatformPackages)
        -suggestInstalledPackageTypes($includeRootPackage)
    }

    ' Inheritance
    BaseCommand --|> Command
    BaseConfigCommand --|> BaseCommand
    BaseDependencyCommand --|> BaseCommand

    AboutCommand --|> BaseCommand
    ArchiveCommand --|> BaseCommand
    AuditCommand --|> BaseCommand
    BumpCommand --|> BaseCommand
    CheckPlatformReqsCommand --|> BaseCommand
    ClearCacheCommand --|> BaseCommand
    CreateProjectCommand --|> BaseCommand
    DiagnoseCommand --|> BaseCommand

    ConfigCommand --|> BaseConfigCommand
    DependsCommand --|> BaseDependencyCommand
}

@enduml
