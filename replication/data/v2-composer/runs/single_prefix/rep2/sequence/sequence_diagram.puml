@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Composer — Package Audit Sequence

actor "Developer" as dev

box "Command Layer" #E8F4FD
    participant "AuditCommand" as auditCmd
    participant "BaseCommand" as baseCmd
end box

box "Advisory Layer" #FDF3E8
    participant "Auditor" as auditor
    participant "PartialSecurityAdvisory" as partialAdvisory
    participant "SecurityAdvisory" as secAdvisory
    participant "IgnoredSecurityAdvisory" as ignoredAdvisory
end box

box "Infrastructure" #EDF7ED
    participant "Cache" as cache
    participant "AutoloadGenerator" as autoloadGen
end box

== Command Initialisation ==

dev -> auditCmd : execute($input, $output)
activate auditCmd

auditCmd -> baseCmd : getComposer($required, $disablePlugins, $disableScripts)
activate baseCmd
baseCmd -> baseCmd : createComposerInstance($input, $io, $config,\n  $disablePlugins, $disableScripts)
activate baseCmd
baseCmd --> baseCmd : Composer instance
deactivate baseCmd
baseCmd --> auditCmd : $composer
deactivate baseCmd

auditCmd -> baseCmd : createPolicyConfig($config, $input)
activate baseCmd
baseCmd --> auditCmd : $policyConfig
deactivate baseCmd

== Package Collection ==

auditCmd -> auditCmd : getPackages($composer, $input)
activate auditCmd
auditCmd --> auditCmd : $packages[]
deactivate auditCmd

== Security Audit ==

auditCmd -> auditor : audit($io, $repoSet, $policyConfig,\n  $packages, $format, $warningOnly,\n  $filterListProviderSet)
activate auditor

loop for each package in $packages
    auditor -> partialAdvisory : create($packageName, $data, $parser)
    activate partialAdvisory
    partialAdvisory --> auditor : PartialSecurityAdvisory
    deactivate partialAdvisory
end

loop for each advisory requiring full data
    auditor -> secAdvisory : __construct($packageName, $advisoryId,\n  $affectedVersions, $title, $sources,\n  $reportedAt, $cve, $link)
    activate secAdvisory
    secAdvisory --> auditor : SecurityAdvisory
    deactivate secAdvisory
end

opt advisory matches ignore list
    auditor -> secAdvisory : toIgnoredAdvisory($ignoreReason)
    activate secAdvisory
    secAdvisory -> ignoredAdvisory : __construct($packageName, $advisoryId,\n  $affectedVersions, $title, $sources,\n  $reportedAt, $cve, $link)
    activate ignoredAdvisory
    ignoredAdvisory --> secAdvisory : IgnoredSecurityAdvisory
    deactivate ignoredAdvisory
    secAdvisory --> auditor : IgnoredSecurityAdvisory
    deactivate secAdvisory
end

== Output Phase ==

auditor -> auditor : outputAdvisories($io, $advisories, $format)
activate auditor
note right : Formats and writes\nvulnerability report
auditor --> auditor
deactivate auditor

auditor -> auditor : outputAbandonedPackages($io, $packages, $format)
activate auditor
note right : Reports deprecated\nor abandoned packages
auditor --> auditor
deactivate auditor

auditor -> auditor : outputFilteredPackages($io, $filteredPackages, $format)
activate auditor
auditor --> auditor
deactivate auditor

auditor -> auditor : calculateBitmask($hasVulnerablePackages,\n  $hasAbandonedPackages, $hasFilteredPackages)
activate auditor
auditor --> auditor : $exitCode (bitmask)
deactivate auditor

auditor --> auditCmd : $exitCode
deactivate auditor

== Autoload Regeneration (post-install) ==

auditCmd -> autoloadGen : dump($config, $localRepo, $rootPackage,\n  $installationManager, $targetDir,\n  $scanPsrPackages, $suffix, $locker)
activate autoloadGen

autoloadGen -> cache : write($file, $contents)
activate cache
cache --> autoloadGen : bool
deactivate cache

autoloadGen --> auditCmd : void
deactivate autoloadGen

auditCmd --> dev : exit $exitCode
deactivate auditCmd

@enduml
