@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #336699
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Composer — PHP Dependency Manager: Use Case Diagram

left to right direction

actor "Developer" as dev
actor "Packagist\n(Package Registry)" as packagist
actor "VCS\n(GitHub / GitLab)" as vcs

rectangle "Composer" {

    package "Package Management" {
        usecase "Install / Update\nDependencies" as UC_Install
        usecase "Remove Dependency" as UC_Remove
        usecase "Require New\nPackage" as UC_Require
        usecase "Bump Version\nConstraints" as UC_Bump
        usecase "Create New\nProject" as UC_CreateProject
    }

    package "Security & Auditing" {
        usecase "Audit Packages\nfor Vulnerabilities" as UC_Audit
        usecase "Ignore Security\nAdvisory" as UC_IgnoreAdvisory
        usecase "View Security\nAdvisories" as UC_ViewAdvisories
    }

    package "Autoloading" {
        usecase "Generate\nAutoload Files" as UC_Autoload
        usecase "Dump Autoloader" as UC_DumpAutoload
    }

    package "Dependency Analysis" {
        usecase "Check Package\nDependencies" as UC_Depends
        usecase "Check Platform\nRequirements" as UC_CheckPlatform
        usecase "Diagnose\nEnvironment" as UC_Diagnose
    }

    package "Configuration & Cache" {
        usecase "Manage\nConfiguration" as UC_Config
        usecase "Clear Cache" as UC_ClearCache
        usecase "Archive Package" as UC_Archive
        usecase "Show About\nInformation" as UC_About
    }
}

' Developer interactions
dev --> UC_Install
dev --> UC_Remove
dev --> UC_Require
dev --> UC_Bump
dev --> UC_CreateProject
dev --> UC_Audit
dev --> UC_Autoload
dev --> UC_DumpAutoload
dev --> UC_Depends
dev --> UC_CheckPlatform
dev --> UC_Diagnose
dev --> UC_Config
dev --> UC_ClearCache
dev --> UC_Archive
dev --> UC_About

' External system interactions
UC_Install --> packagist : <<resolves packages>>
UC_Require --> packagist : <<searches packages>>
UC_CreateProject --> packagist : <<fetches package>>
UC_Audit --> packagist : <<fetches advisories>>
UC_Archive --> vcs : <<clones source>>
UC_CreateProject --> vcs : <<clones repository>>
UC_Install --> vcs : <<downloads source>>

' Include relationships
UC_Audit ..> UC_ViewAdvisories : <<include>>
UC_Audit ..> UC_IgnoreAdvisory : <<extend>>
UC_DumpAutoload ..> UC_Autoload : <<include>>
UC_Install ..> UC_DumpAutoload : <<include>>
UC_Diagnose ..> UC_CheckPlatform : <<include>>

@enduml
