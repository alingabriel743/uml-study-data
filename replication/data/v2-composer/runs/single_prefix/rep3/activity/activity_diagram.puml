@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam swimlane {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    TitleFontColor #212529
}

title Composer Security Audit Workflow\n(composer audit command)

|User / CLI|
start
:Run "composer audit" command;

|AuditCommand|
:configure() — register options\n(--format, --locked, --abandoned, --ignore-severity, etc.);
:execute($input, $output);
:getPackages($composer, $input)\nResolve installed packages from lock file or repository;

if (No packages found?) then (yes)
    :Output "No packages to audit";
    stop
endif

:createPolicyConfig($config, $input)\nBuild PolicyConfig with ignore lists,\nseverity filters, and abandoned policy;

|Auditor|
:audit($io, $repoSet, $policyConfig,\n$packages, $format, $warningOnly, $filterListProviderSet);
:Retrieve ignore list and ignored severities\nfrom policyConfig;
:repoSet.getMatchingSecurityAdvisories($packages)\nFetch matching advisories (optimized or full);

if (FORMAT_SUMMARY and ignore list present\nand only PartialAdvisories returned?) then (yes)
    :Re-fetch full SecurityAdvisory data\nfor accurate ignore-list matching;
endif

:processAdvisories()\nSplit all advisories into:\n- Active advisories\n- Ignored advisories (by ID, CVE, severity, package name);

if (Abandoned policy = AUDIT_IGNORE?) then (yes)
    :Skip abandoned package detection;
else (no)
    :filterAbandonedPackages()\nIdentify abandoned packages\nnot in the ignore list;
endif

if (FilterListProviderSet present\nand active filter lists configured?) then (yes)
    :FilterListAuditor.collectFilterLists()\nFetch filter lists from provider set;
    :Match packages against filter list entries;
    :Count packages in AUDIT_FAIL lists → filteredCount;
endif

:calculateBitmask(\n  hasVulnerablePackages,\n  hasAbandonedPackages,\n  hasFilteredPackages)\nProduce STATUS_OK / STATUS_VULNERABLE\n/ STATUS_ABANDONED / STATUS_FILTERED bitmask;

if (FORMAT_JSON?) then (yes)
    :Serialize advisories, ignored advisories,\nabandoned packages, filter matches\nto JSON and write to output;
    |AuditCommand|
    :Return auditBitmask as exit code;
    stop
endif

if (Active or ignored advisories found?) then (yes)
    :Output ignored advisories count\n"Found N ignored security vulnerability advisories";
    :outputAdvisories() for ignored advisories\n(table / plain format with ignore reason);
    if (Active advisories count > 0?) then (yes)
        :Output "Found N security vulnerability advisories\naffecting M packages";
        :outputAdvisories() for active advisories\n(Package, Severity, CVE, Title, URL, Affected versions);
    endif
else (no)
    :Output "No security vulnerability advisories found.";
endif

if (Unreachable repositories detected?) then (yes)
    :Output warning listing\nunreachable repository URLs;
endif

if (Abandoned packages found\nand format != SUMMARY?) then (yes)
    :outputAbandonedPackages()\nList abandoned packages with\nsuggested replacement or "No replacement";
endif

if (Filtered packages found?) then (yes)
    :outputFilteredPackages()\nList packages matching filter lists\n(package, constraint, list name, reason, URL);
endif

|AuditCommand|
if (warningOnly = true?) then (yes)
    :Return exit code 0\n(audit issues are warnings only);
else (no)
    if (auditBitmask > STATUS_OK?) then (yes)
        :Return non-zero exit code\n(signals vulnerability / abandonment / filter hit);
    else (no)
        :Return exit code 0\n(all clear);
    endif
endif

|User / CLI|
:Display formatted audit results\nand interpret exit code;
stop

@enduml
