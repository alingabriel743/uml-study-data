@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    ActorBackgroundColor #F8F9FA
    ActorFontColor #212529
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
}

title Composer — Security Audit Flow\n(AuditCommand → Auditor → SecurityAdvisory)

actor Developer as dev
participant "AuditCommand" as auditCmd
participant "BaseCommand" as baseCmd
participant "Auditor" as auditor
participant "Cache" as cache
participant "SecurityAdvisory" as secAdvisory
participant "IgnoredSecurityAdvisory" as ignoredAdvisory

== Command Initialisation ==

dev -> auditCmd : execute($input, $output)
activate auditCmd

auditCmd -> baseCmd : getComposer($required, $disablePlugins, $disableScripts)
activate baseCmd
baseCmd -> baseCmd : createComposerInstance($input, $io, $config, ...)
baseCmd --> auditCmd : $composer
deactivate baseCmd

== Package Resolution ==

auditCmd -> auditCmd : getPackages($composer, $input)
activate auditCmd #DDD
note right of auditCmd
  Resolves installed packages
  from the local repository
end note
auditCmd --> auditCmd : $packages[]
deactivate auditCmd

auditCmd -> baseCmd : createPolicyConfig($config, $input)
activate baseCmd
baseCmd --> auditCmd : $policyConfig
deactivate baseCmd

== Advisory Audit ==

auditCmd -> auditor : audit($io, $repoSet, $policyConfig, $packages,\n  $format, $warningOnly, $filterListProviderSet)
activate auditor

auditor -> cache : read($advisoryCacheFile)
activate cache
cache --> auditor : $cachedAdvisories
deactivate cache

loop for each $package in $packages
    auditor -> secAdvisory : __construct($packageName, $advisoryId,\n  $affectedVersions, $title, $sources,\n  $reportedAt, $cve, $link)
    activate secAdvisory
    secAdvisory --> auditor : $advisory
    deactivate secAdvisory

    alt advisory matches ignore list
        auditor -> secAdvisory : toIgnoredAdvisory($ignoreReason)
        activate secAdvisory
        secAdvisory -> ignoredAdvisory : __construct($packageName, $advisoryId,\n  $affectedVersions, $title, $sources,\n  $reportedAt, $cve, $link)
        activate ignoredAdvisory
        ignoredAdvisory --> secAdvisory : $ignoredAdvisory
        deactivate ignoredAdvisory
        secAdvisory --> auditor : $ignoredAdvisory
        deactivate secAdvisory
    end
end

== Bitmask Calculation ==

auditor -> auditor : calculateBitmask($hasVulnerablePackages,\n  $hasAbandonedPackages, $hasFilteredPackages)
activate auditor #DDD
auditor --> auditor : $bitmask
deactivate auditor

== Output Reporting ==

opt vulnerable packages found
    auditor -> auditor : outputAdvisories($io, $advisories, $format)
    activate auditor #DDD
    note right of auditor
      Formats and writes advisory
      details to IO (table / JSON / summary)
    end note
    deactivate auditor
end

opt abandoned packages found
    auditor -> auditor : outputAbandonedPackages($io, $packages, $format)
    activate auditor #DDD
    deactivate auditor
end

opt filtered packages present
    auditor -> auditor : outputFilteredPackages($io, $filteredPackages, $format)
    activate auditor #DDD
    deactivate auditor
end

auditor -> cache : write($advisoryCacheFile, $updatedAdvisories)
activate cache
cache --> auditor : ok
deactivate cache

auditor --> auditCmd : $exitCode
deactivate auditor

auditCmd --> dev : exit code (0 = clean, >0 = issues found)
deactivate auditCmd

@enduml
