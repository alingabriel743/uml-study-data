@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Composer — Use Case Diagram

left to right direction

actor "Developer" as dev
actor "Packagist\n(Package Repository)" as packagist
actor "VCS\n(GitHub / GitLab)" as vcs

rectangle "Composer" {

    package "Dependency Management" {
        usecase "Install / Update\nDependencies" as UC_install
        usecase "Create New Project" as UC_create
        usecase "Bump Version\nConstraints" as UC_bump
        usecase "Show Dependency\nTree" as UC_depends
        usecase "Generate Autoload\nFiles" as UC_autoload
    }

    package "Security & Audit" {
        usecase "Audit Security\nAdvisories" as UC_audit
        usecase "Check Platform\nRequirements" as UC_platform
        usecase "Ignore Security\nAdvisory" as UC_ignore
    }

    package "Configuration & Environment" {
        usecase "Manage Configuration" as UC_config
        usecase "Diagnose Environment" as UC_diagnose
        usecase "Clear Cache" as UC_cache
        usecase "Archive Package" as UC_archive
        usecase "View Composer Info" as UC_about
    }

}

' Developer interactions
dev --> UC_install
dev --> UC_create
dev --> UC_bump
dev --> UC_depends
dev --> UC_audit
dev --> UC_platform
dev --> UC_config
dev --> UC_diagnose
dev --> UC_cache
dev --> UC_archive
dev --> UC_about

' Include relationships
UC_install ..> UC_autoload : <<include>>
UC_create ..> UC_install : <<include>>
UC_audit ..> UC_ignore : <<extend>>

' External system interactions
UC_install --> packagist : resolves packages
UC_create --> packagist : fetches package metadata
UC_install --> vcs : clones / downloads source
UC_archive --> vcs : fetches VCS source
UC_diagnose --> packagist : checks connectivity

@enduml
