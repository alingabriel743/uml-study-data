@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam swimlane {
    BorderColor #6C757D
    TitleFontColor #212529
    TitleBackgroundColor #E9ECEF
}

title Composer Package Installation Workflow

|CLI / BaseCommand|
start
:User invokes composer install / update;
:BaseCommand.getComposer() called;

if (Config & environment valid?) then (yes)
  :createComposerInstance(input, io, config)\nLoad configuration and authentication;
  :getPreferredInstallOptions()\nDetermine prefer-source vs prefer-dist;
else (no)
  :Report error via ConsoleIO;
  stop
endif

|Installer / RepositoryManager|
:Installer.__construct()\nInitialize with IO, Config, DownloadManager,\nRepositoryManager, InstallationManager;

:createRepositorySet(forUpdate, platformRepo)\nBuild the set of available package sources;

fork
  :RepositoryManager.createRepository("composer")\nCreate ComposerRepository for Packagist;
fork again
  :RepositoryManager.createRepository("vcs")\nCreate VcsRepository for VCS sources;
end fork

:RepositoryManager.addRepository()\nRegister all configured repositories;

:ComposerRepository.loadPackages()\nFetch and cache package metadata\nfrom remote or local cache;

if (Lock file exists?) then (yes)
  :Read locked packages\nand constraints from composer.lock;
else (no)
  :Resolve all version constraints\nfrom composer.json requires;
endif

:Installer.createRequest(rootPackage, platformRepo)\nBuild dependency resolution request;

:Run dependency solver\nagainst the full repository set;

if (Resolution successful?) then (yes)
  :Generate ordered list of\ninstall / update / remove operations;
else (no)
  |CLI / BaseCommand|
  :Report dependency conflict\nvia ConsoleIO;
  stop
endif

:Installer.extractDevPackages()\nSeparate dev dependencies\nfrom production packages;

|DownloadManager / Downloaders|
:DownloadManager.prepare(type, package, targetPath)\nPrepare target directories and cleanup;

if (Package source type?) then (VCS)
  :VcsDownloader.doDownload(package, path, url)\nClone or checkout from VCS remote;
  :VcsDriver.getComposerInformation(identifier)\nRead composer.json from VCS ref;
  :VcsRepository.preProcess(driver, data, identifier)\nNormalize VCS package data;
else (File / Archive)
  :FileDownloader.download(package, path)\nFetch archive file via HTTP downloader;
  :FileDownloader.prepare(type, package, path)\nExtract archive to target directory;
endif

:DownloadManager.download(package, path)\nCoordinate parallel download batch;

|InstallationManager / PluginManager|
:InstallationManager.execute(repo, operations)\nBegin processing all resolved operations;

repeat
  :InstallationManager.downloadAndExecuteBatch()\nDownload a batch of packages concurrently;
  :InstallationManager.executeBatch()\nApply operations from the batch;
  :InstallationManager.install(repo, operation)\nInstall individual package to vendor/;

  if (Installed package is a plugin?) then (yes)
    :PluginManager.isPluginAllowed(package)\nCheck configured allow list\nor prompt user for approval;
    if (Plugin allowed?) then (yes)
      :PluginManager.addPlugin(plugin)\nActivate plugin and register capabilities;
      :PluginManager.loadRepository(repo)\nLoad any repositories provided by plugin;
    else (no)
      :PluginManager.deactivateRepository(repo)\nSkip plugin — not activated;
    endif
  endif

  if (Post-install scripts defined?) then (yes)
    :ProcessExecutor.execute(command, cwd)\nRun composer scripts in subprocess;
    :ProcessExecutor.outputHandler(type, buffer)\nCapture and stream script output to IO;
  endif

repeat while (More operation batches?) is (yes)
-> no;

|CLI / BaseCommand|
:Output installation summary\nvia ConsoleIO (packages installed/updated/removed);
stop

@enduml
