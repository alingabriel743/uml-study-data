@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam component {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Composer — Component Architecture

' ─── Presentation Layer ────────────────────────────────────────
package "Presentation Layer" #D6EAF8 {
    [Console\n(Application, HtmlOutputFormatter)] as Console
    [Command\n(BaseCommand, ShowCommand,\nInitCommand, RequireCommand)] as Command
    [IO\n(ConsoleIO, BaseIO, IOInterface)] as IO
}

' ─── Core Layer ────────────────────────────────────────────────
package "Core Layer" #D5F5E3 {
    [Composer Core\n(Installer, Config, Factory,\nCache, PartialComposer)] as ComposerCore
    [Config Source\n(JsonConfigSource,\nConfigSourceInterface)] as ConfigSrc
    [JSON Utilities\n(JsonFile, JsonManipulator,\nJsonFormatter)] as JsonUtil
}

' ─── Package Management Layer ──────────────────────────────────
package "Package Management" #FAD7A0 {
    [Package Model\n(Package, AliasPackage,\nCompletePackage)] as PackageModel
    [Package Loader\n(ArrayLoader, ValidatingArrayLoader,\nRootPackageLoader)] as PackageLoader
    [Package Versioning\n(VersionParser, VersionGuesser,\nVersionSelector, VersionBumper)] as Versioning
    [Package Archiver\n(ArchiveManager, ZipArchiver,\nPharArchiver)] as Archiver
}

' ─── Repository Layer ──────────────────────────────────────────
package "Repository Layer" #E8DAEF {
    [Repository\n(ComposerRepository, ArrayRepository,\nVcsRepository, PlatformRepository)] as Repository
    [VCS Drivers\n(VcsDriver, GitHubDriver,\nGitLabDriver, SvnDriver)] as VcsDrivers
}

' ─── Dependency Resolution Layer ───────────────────────────────
package "Dependency Resolution" #FDEBD0 {
    [Dependency Resolver\n(Pool, PoolBuilder,\nDecisions, Request, Rule)] as Resolver
    [Solver Operations\n(InstallOperation, UpdateOperation,\nUninstallOperation)] as Operations
    [Platform Filter\n(PlatformRequirementFilterInterface,\nIgnoreListPlatformRequirementFilter)] as PlatformFilter
}

' ─── Installation Layer ────────────────────────────────────────
package "Installation Layer" #D1F2EB {
    [Installation Manager\n(InstallationManager, LibraryInstaller,\nProjectInstaller)] as InstallMgr
    [Downloader\n(DownloadManager, VcsDownloader,\nFileDownloader, GitDownloader)] as Downloader
    [Autoload\n(AutoloadGenerator, ClassLoader,\nClassMapGenerator)] as Autoload
}

' ─── Infrastructure / Utilities Layer ──────────────────────────
package "Infrastructure" #EBF5FB {
    [Utilities\n(Filesystem, ProcessExecutor,\nGit, Perforce, RemoteFilesystem)] as Utilities
    [HTTP Client\n(CurlDownloader, ProxyManager,\nCurlResponse, RequestProxy)] as HttpClient
}

' ─── Extension Layer ───────────────────────────────────────────
package "Extension Layer" #F9EBEA {
    [Plugin Manager\n(PluginManager, PrePoolCreateEvent,\nPreFileDownloadEvent)] as PluginMgr
    [Event Dispatcher\n(EventDispatcher, Event,\nEventSubscriberInterface)] as EventDisp
    [Script Events\n(ScriptEvents, ScriptExecutionException)] as Scripts
}

' ─── Security Layer ────────────────────────────────────────────
package "Security & Audit" #FDEDEC {
    [Auditor\n(Auditor, SecurityAdvisory,\nPartialSecurityAdvisory)] as AuditComp
    [Policy\n(PolicyConfig, AdvisoriesPolicyConfig,\nMalwarePolicyConfig)] as Policy
}

' ─── Relationships ─────────────────────────────────────────────

' User enters via Console → Command
Console --> Command : <<uses>>
Command --> IO : <<uses>>

' Command drives the Core
Command --> ComposerCore : <<drives>>

' Core uses Config + JSON
ComposerCore --> ConfigSrc : <<reads/writes>>
ComposerCore --> JsonUtil : <<serialises>>
ConfigSrc --> JsonUtil : <<depends>>

' Core orchestrates Package management
ComposerCore --> PackageModel : <<manages>>
ComposerCore --> PackageLoader : <<loads packages>>
PackageLoader --> Versioning : <<resolves versions>>
PackageLoader --> JsonUtil : <<parses JSON>>

' Core uses Repository to discover packages
ComposerCore --> Repository : <<queries>>
Repository --> VcsDrivers : <<delegates VCS>>
Repository --> PackageModel : <<returns>>
Repository --> HttpClient : <<HTTP requests>>

' Dependency resolution
ComposerCore --> Resolver : <<solves>>
Resolver --> Repository : <<pools>>
Resolver --> PackageModel : <<evaluates>>
Resolver --> PlatformFilter : <<applies>>
Resolver --> Operations : <<produces>>

' Installation
ComposerCore --> InstallMgr : <<installs>>
InstallMgr --> Operations : <<executes>>
InstallMgr --> Downloader : <<downloads via>>
InstallMgr --> Autoload : <<generates autoload>>
Downloader --> HttpClient : <<HTTP>>
Downloader --> Utilities : <<filesystem>>

' VCS utilities
VcsDrivers --> Utilities : <<uses Git/SVN>>
VcsDrivers --> HttpClient : <<API calls>>

' Archiver
Command --> Archiver : <<archive cmd>>
Archiver --> Utilities : <<filesystem>>

' Events & Plugins
ComposerCore --> EventDisp : <<dispatches>>
EventDisp --> PluginMgr : <<notifies>>
EventDisp --> Scripts : <<runs scripts>>
PluginMgr --> Downloader : <<pre-download hook>>

' Security
ComposerCore --> AuditComp : <<audits>>
AuditComp --> Policy : <<evaluates policy>>
AuditComp --> Repository : <<queries advisories>>

@enduml
