@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequence {
    ParticipantBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
    BoxBackgroundColor #F1F3F5
    GroupBorderColor #6C757D
    GroupBackgroundColor #E9ECEF20
    NoteBackgroundColor #FFF3CD
    NoteBorderColor #FFC107
}

title Composer — Package Installation Flow

actor "Developer" as dev
participant "BaseCommand" as cmd
participant "Installer" as installer
participant "ComposerRepository" as composerRepo
participant "VcsRepository" as vcsRepo
participant "VcsDriver\n(GitHub/GitLab)" as vcsDriver
participant "InstallationManager" as installMgr
participant "FileDownloader\n/ VcsDownloader" as downloader
participant "PluginManager" as pluginMgr
participant "ConsoleIO" as io
participant "Filesystem" as fs

== Bootstrap ==

dev -> cmd : composer install
activate cmd

cmd -> cmd : getComposer($required, $disablePlugins)
activate cmd #LightBlue
cmd -> cmd : createComposerInstance($input, $io, $config)
cmd --> cmd : Composer instance
deactivate cmd

cmd -> io : doWrite("Loading composer repositories...")
activate io
io --> cmd
deactivate io

== Repository Setup ==

cmd -> installer : __construct($io, $config, $package,\n  $downloadManager, $repositoryManager,\n  $locker, $installationManager, $eventDispatcher)
activate installer

installer -> installer : createRepositorySet($forUpdate, $platformRepo,\n  $rootAliases, $lockedRepository)
activate installer #LightBlue
installer --> installer : RepositorySet
deactivate installer

== Package Loading ==

installer -> composerRepo : loadPackages($packageNameMap,\n  $acceptableStabilities, $stabilityFlags, $alreadyLoaded)
activate composerRepo

composerRepo -> composerRepo : fetchFile($filename, $cacheKey, $sha256)
activate composerRepo #LightBlue
note right of composerRepo : Fetches packages.json\nfrom Packagist or\ncustom Composer repo
composerRepo --> composerRepo : file data
deactivate composerRepo

composerRepo -> composerRepo : loadAsyncPackages($packageNames,\n  $acceptableStabilities, $stabilityFlags)
activate composerRepo #LightBlue
composerRepo -> composerRepo : isVersionAcceptable($constraint, $name, $versionData)
composerRepo --> composerRepo : filtered packages
deactivate composerRepo

composerRepo --> installer : packages[]
deactivate composerRepo

opt VCS packages present

installer -> vcsRepo : loadPackages() / preProcess($driver, $data, $identifier)
activate vcsRepo

vcsRepo -> vcsRepo : validateBranch($branch)
activate vcsRepo #LightBlue
vcsRepo --> vcsRepo
deactivate vcsRepo

vcsRepo -> vcsDriver : getComposerInformation($identifier)
activate vcsDriver

vcsDriver -> vcsDriver : getContents($url)
activate vcsDriver #LightBlue
note right of vcsDriver : GitHubDriver or GitLabDriver\nfetches raw composer.json\nfrom repository API
vcsDriver --> vcsDriver : raw content
deactivate vcsDriver

vcsDriver -> vcsDriver : getFileContent($file, $identifier)
activate vcsDriver #LightBlue
vcsDriver --> vcsDriver : decoded content
deactivate vcsDriver

vcsDriver --> vcsRepo : composerInfo[]
deactivate vcsDriver

vcsRepo -> vcsRepo : getCachedPackageVersion($version, $identifier,\n  $isVerbose, $isVeryVerbose, $isDefaultBranch)
activate vcsRepo #LightBlue
vcsRepo --> vcsRepo : cachedPackage | null
deactivate vcsRepo

vcsRepo --> installer : packages[]
deactivate vcsRepo

end

== Dependency Resolution ==

installer -> installer : createRequest($rootPackage, $platformRepo, $lockedRepository)
activate installer #LightBlue
note right of installer : Builds solver Request\nfrom root package\nrequirements
installer --> installer : Request
deactivate installer

installer -> installer : extractDevPackages($lockTransaction, $platformRepo,\n  $aliases, $policy, $lockedRepository)
activate installer #LightBlue
installer --> installer : devPackages[]
deactivate installer

== Plugin Initialisation ==

installer -> pluginMgr : isPluginAllowed($package, $isGlobalPlugin, $optional, $prompt)
activate pluginMgr
pluginMgr --> installer : bool
deactivate pluginMgr

installer -> pluginMgr : addPlugin($plugin, $isGlobalPlugin, $sourcePackage)
activate pluginMgr
pluginMgr -> pluginMgr : loadRepository($repo, $isGlobalRepo, $rootPackage)
activate pluginMgr #LightBlue
pluginMgr --> pluginMgr
deactivate pluginMgr
pluginMgr --> installer
deactivate pluginMgr

== Installation ==

installer -> installMgr : execute($repo, $operations, $devMode, $runScripts)
activate installMgr

installMgr -> installMgr : downloadAndExecuteBatch($repo, $operations,\n  $cleanupPromises, $devMode, $runScripts, $downloadOnly)
activate installMgr #LightBlue

loop for each package operation

installMgr -> downloader : prepare($type, $package, $path, $prevPackage)
activate downloader
downloader --> installMgr
deactivate downloader

installMgr -> downloader : download($package, $path, $prevPackage, $output)
activate downloader
note right of downloader : FileDownloader fetches\narchives via HTTP;\nVcsDownloader clones repos
downloader --> installMgr : Promise
deactivate downloader

end
deactivate installMgr

installMgr -> installMgr : executeBatch($repo, $operations,\n  $cleanupPromises, $devMode, $runScripts)
activate installMgr #LightBlue

loop for each resolved operation

installMgr -> installMgr : install($repo, $operation)
activate installMgr #ADD8E6
installMgr -> downloader : install($package, $path, $output)
activate downloader

downloader -> fs : copy($source, $target)
activate fs
fs --> downloader
deactivate fs

downloader -> fs : filePutContentsIfModified($path, $content)
activate fs
fs --> downloader
deactivate fs

downloader --> installMgr : installed
deactivate downloader

downloader -> downloader : cleanup($type, $package, $path, $prevPackage)
activate downloader #LightBlue
downloader --> downloader
deactivate downloader

installMgr --> installMgr
deactivate installMgr

end

deactivate installMgr
installMgr --> installer : done
deactivate installMgr

== Output ==

installer -> io : doWrite("Writing lock file")
activate io
io --> installer
deactivate io

installer --> cmd : exitCode
deactivate installer

cmd -> io : doWrite("Installing packages from lock file")
activate io
io --> cmd
deactivate io

cmd --> dev : exit 0
deactivate cmd

@enduml
