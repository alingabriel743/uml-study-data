@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Composer — Use Case Diagram

left to right direction

' ── Actors ──────────────────────────────────────────────
actor "Developer" as developer
actor "Plugin Author" as pluginAuthor
actor "Package Registry\n(Packagist / VCS)" as registry

' ── System Boundary ──────────────────────────────────────
rectangle "Composer — PHP Dependency Manager" {

    ' Dependency Management
    package "Dependency Management" {
        usecase "Install Dependencies" as UC_Install
        usecase "Update Dependencies" as UC_Update
        usecase "Remove Package" as UC_Remove
        usecase "Require New Package" as UC_Require
    }

    ' Package Discovery
    package "Package Discovery" {
        usecase "Search for Packages" as UC_Search
        usecase "Show Package Information" as UC_Show
        usecase "View Dependency Tree" as UC_Tree
    }

    ' Download & Installation
    package "Package Download" {
        usecase "Download Package Files" as UC_Download
        usecase "Download from VCS\n(Git / SVN / Perforce)" as UC_VCSDownload
        usecase "Fetch Package Metadata" as UC_FetchMeta
    }

    ' Repository Management
    package "Repository Management" {
        usecase "Add / Configure Repository" as UC_AddRepo
        usecase "Load Repository" as UC_LoadRepo
        usecase "Resolve Package Versions" as UC_Resolve
    }

    ' Plugin Management
    package "Plugin Management" {
        usecase "Load Plugin" as UC_LoadPlugin
        usecase "Allow / Block Plugin" as UC_PluginPolicy
    }

    ' Configuration & Scripting
    package "Configuration & Scripting" {
        usecase "Configure Composer Settings" as UC_Config
        usecase "Run Scripts / Hooks" as UC_Scripts
        usecase "Manage Autoload" as UC_Autoload
    }

}

' ── Actor → Use Case associations ────────────────────────
developer --> UC_Install
developer --> UC_Update
developer --> UC_Remove
developer --> UC_Require
developer --> UC_Search
developer --> UC_Show
developer --> UC_Tree
developer --> UC_AddRepo
developer --> UC_Config
developer --> UC_PluginPolicy

pluginAuthor --> UC_LoadPlugin

registry --> UC_FetchMeta
registry --> UC_VCSDownload

' ── Include relationships ─────────────────────────────────
UC_Install    .> UC_Resolve     : <<include>>
UC_Install    .> UC_Download    : <<include>>
UC_Install    .> UC_Scripts     : <<include>>
UC_Install    .> UC_Autoload    : <<include>>

UC_Update     .> UC_Resolve     : <<include>>
UC_Update     .> UC_Download    : <<include>>
UC_Update     .> UC_Scripts     : <<include>>

UC_Require    .> UC_FetchMeta   : <<include>>
UC_Require    .> UC_Install     : <<include>>

UC_Resolve    .> UC_FetchMeta   : <<include>>
UC_Resolve    .> UC_LoadRepo    : <<include>>

UC_AddRepo    .> UC_LoadRepo    : <<include>>

UC_Tree       .> UC_LoadRepo    : <<include>>
UC_Show       .> UC_FetchMeta   : <<include>>

' ── Extend relationships ──────────────────────────────────
UC_VCSDownload .> UC_Download   : <<extend>>
UC_LoadPlugin  .> UC_LoadRepo   : <<extend>>

@enduml
