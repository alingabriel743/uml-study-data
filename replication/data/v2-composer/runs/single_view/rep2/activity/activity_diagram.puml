@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Composer — Package Installation Workflow

|CLI / User|
start
:Invoke **composer install** or **composer update**\nwith optional flags (--no-dev, --no-scripts, --prefer-source);

|BaseCommand|
:Call getComposer()\nwith required=true, disablePlugins, disableScripts flags;
if (Composer instance already cached?) then (yes)
    :Return existing instance;
else (no)
    :createComposerInstance()\nLoads config, sets up IO (ConsoleIO);
    :getPreferredInstallOptions()\nDetermines source vs. dist preference;
    :createPolicyConfig()\nBuilds advisory + abandoned policies;
endif

|RepositoryManager|
:createRepository()\nfor each repository entry in composer.json;
if (Repository reachable / valid?) then (yes)
    :addRepository() or prependRepository()\nregisters it in the manager;
else (no)
    :Log warning and\nskip unreachable repository;
endif
:setLocalRepository()\nregisters the installed-packages repo;

|Installer|
:createRepositorySet()\nCombines platform repo + locked repo + remote repos;
:createRequest()\nBuilds constraint set from root package requires;
if (Dev packages requested?) then (yes)
    :extractDevPackages()\nAdds require-dev constraints to request;
endif
:Resolve dependency graph\nvia Solver / DependencyResolver;

|ComposerRepository|
:loadPackages()\nwith packageNameMap + acceptableStabilities;
if (Package data in local cache?) then (yes)
    :Return cached package list;
else (no)
    :fetchFile()\nGET packages.json / provider JSON from remote;
    :loadAsyncPackages()\nFetch multiple provider files in parallel;
    :isVersionAcceptable()\nFilter by stability flags + version constraint;
endif
:Return resolved PackageInterface list;

|PluginManager|
:isPluginAllowed()\nChecks allow-plugins config;
if (Plugin allowed?) then (yes)
    :loadRepository()\nActivates plugin's repository contributions;
    :addPlugin()\nRegisters plugin capabilities;
else (no)
    :Skip / deactivateRepository()\nLogs plugin blocked message;
endif

|Installer|
if (Lock file up-to-date?) then (yes)
    :Use locked package versions\n(no re-resolution needed);
else (no)
    :Apply full solver result\nas new lock transaction;
endif
:Determine operations:\nInstall / Update / Uninstall per package;

|InstallationManager|
:execute()\nReceives full operations list, devMode, runScripts flags;
:downloadAndExecuteBatch()\nGroups operations for parallel downloading;

|DownloadManager|
:prepare()\nSets up target directories for each package;
fork
    :download() — dist mode\nFetch archive via **FileDownloader**;
    :FileDownloader.download()\nHTTP GET + verify checksum;
    :FileDownloader.install()\nExtract archive to vendor path;
fork again
    :download() — source mode\nClone/fetch via **VcsDownloader**;
    :VcsDownloader.doDownload()\nRun git/svn/hg clone;
    :VcsDownloader.doUpdate()\nPull latest commits if updating;
end fork
:cleanup()\nRemove temp files / partial downloads;

|InstallationManager|
:executeBatch()\nFinalise all resolved operations sequentially;
:install()\nDelegate each install op to correct package installer;
if (Scripts enabled?) then (yes)
    :Dispatch **Event** (post-install-cmd / post-update-cmd)\nvia EventDispatcher;
    :ProcessExecutor.execute()\nRuns each script command in subprocess;
    :outputHandler()\nStreams script stdout/stderr to ConsoleIO;
endif

|CLI / User|
:Display operation summary\n(packages installed / updated / removed);
:Show any security advisories\nfrom AuditConfig / AdvisoriesPolicyConfig;
stop

@enduml
