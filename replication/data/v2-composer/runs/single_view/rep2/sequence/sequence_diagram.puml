@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    ActorBackgroundColor #F8F9FA
    ActorFontColor #212529
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
}

title Composer Package Installation Flow

actor User

participant "BaseCommand" as cmd #F8F9FA
participant "ConsoleIO" as io #F8F9FA
participant "Installer" as installer #D4EDDA
participant "ComposerRepository" as compRepo #FFF3CD
participant "ArrayRepository" as arrayRepo #FFF3CD
participant "VcsRepository" as vcsRepo #FFF3CD
participant "VcsDriver\n(GitHub/GitLab)" as driver #FFE8CC
participant "InstallationManager" as instMgr #D4EDDA
participant "FileDownloader" as fileDl #CCE5FF
participant "PluginManager" as pluginMgr #F8D7DA
participant "Filesystem" as fs #F8F9FA

== Bootstrap: Command Initialisation ==

User -> cmd : execute($input, $output)
activate cmd

cmd -> io : new ConsoleIO($input, $output)
activate io
io --> cmd : $io
deactivate io

cmd -> cmd : getComposer($required=true)
activate cmd
cmd -> cmd : createComposerInstance($input, $io, $config)
note right of cmd
  Reads composer.json,
  resolves config and\ncreates Composer instance
end note
cmd --> cmd : $composer
deactivate cmd

== Plugin Activation ==

cmd -> pluginMgr : new PluginManager($io, $composer)
activate pluginMgr
pluginMgr -> pluginMgr : loadRepository($repo, $isGlobalRepo, $rootPackage)
pluginMgr -> pluginMgr : isPluginAllowed($package, $isGlobalPlugin)
pluginMgr -> pluginMgr : addPlugin($plugin, $isGlobalPlugin, $sourcePackage)
pluginMgr --> cmd : $pluginManager (ready)
deactivate pluginMgr

== Installer Setup ==

cmd -> installer : new Installer($io, $config, $package,\n  $downloadManager, $repositoryManager,\n  $locker, $installationManager, $eventDispatcher)
activate installer

installer -> installer : createRepositorySet($forUpdate, $platformRepo,\n  $rootAliases, $lockedRepository)
activate installer
note right of installer
  Builds a composite\nrepository pool
end note
deactivate installer

== Package Discovery ==

installer -> compRepo : loadPackages($packageNameMap,\n  $acceptableStabilities, $stabilityFlags, $alreadyLoaded)
activate compRepo

compRepo -> compRepo : fetchFile($filename, $cacheKey, $sha256)
note right of compRepo
  Downloads packages.json\nfrom Packagist / remote repo
end note

compRepo -> compRepo : loadAsyncPackages($packageNames,\n  $acceptableStabilities, $stabilityFlags, $alreadyLoaded)
compRepo -> compRepo : isVersionAcceptable($constraint, $name, $versionData,\n  $acceptableStabilities, $stabilityFlags)

compRepo --> installer : loaded packages
deactivate compRepo

installer -> arrayRepo : loadPackages($packageNameMap,\n  $acceptableStabilities, $stabilityFlags, $alreadyLoaded)
activate arrayRepo
arrayRepo -> arrayRepo : findPackage($name, $constraint)
arrayRepo -> arrayRepo : findPackages($name, $constraint)
arrayRepo --> installer : matched packages
deactivate arrayRepo

== VCS Package Resolution ==

installer -> vcsRepo : getCachedPackageVersion($version, $identifier, ...)
activate vcsRepo

vcsRepo -> driver : getComposerInformation($identifier)
activate driver
driver -> driver : getBaseComposerInformation($identifier)
driver -> driver : getContents($url)
driver -> driver : hasComposerFile($identifier)
driver --> vcsRepo : composer.json data
deactivate driver

vcsRepo -> vcsRepo : preProcess($driver, $data, $identifier)
vcsRepo -> vcsRepo : validateBranch($branch)
vcsRepo --> installer : resolved VCS packages
deactivate vcsRepo

== Dependency Resolution ==

installer -> installer : createRequest($rootPackage, $platformRepo, $lockedRepository)
activate installer
note right of installer
  Builds solver request\nfrom root package\nrequirements
end note
installer --> installer : $request
deactivate installer

installer -> installer : extractDevPackages($lockTransaction, $platformRepo,\n  $aliases, $policy, $lockedRepository)
activate installer
deactivate installer

== Package Installation ==

installer -> instMgr : execute($repo, $operations, $devMode, $runScripts)
activate instMgr

instMgr -> instMgr : downloadAndExecuteBatch($repo, $operations,\n  $cleanupPromises, $devMode, $runScripts, $downloadOnly)
activate instMgr

instMgr -> fileDl : prepare($type, $package, $path, $prevPackage)
activate fileDl

fileDl -> fileDl : download($package, $path, $prevPackage, $output)
note right of fileDl
  Downloads dist archive\nfrom resolved URL
end note

fileDl -> fileDl : install($package, $path, $output)

fileDl -> fs : copy($source, $target)
activate fs
fs --> fileDl : copied
deactivate fs

fileDl -> fs : filePutContentsIfModified($path, $content)
activate fs
fs --> fileDl : written
deactivate fs

fileDl --> instMgr : package prepared
deactivate fileDl

instMgr -> instMgr : executeBatch($repo, $operations,\n  $cleanupPromises, $devMode, $runScripts)
activate instMgr
instMgr -> instMgr : install($repo, $operation)
deactivate instMgr

deactivate instMgr

instMgr --> installer : installation complete
deactivate instMgr

== Cleanup ==

installer -> fileDl : cleanup($type, $package, $path, $prevPackage)
activate fileDl
fileDl --> installer : cleaned up
deactivate fileDl

installer --> cmd : exit code (0 = success)
deactivate installer

cmd --> User : "Package operations completed"
deactivate cmd

@enduml
