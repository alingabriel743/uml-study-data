@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #3A6EA5
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Composer — Use Case Diagram

left to right direction

' ─── Actors ───────────────────────────────────────────────────────────────────
actor "Developer" as developer
actor "Plugin Developer" as pluginDev
actor "Package Registry\n(Packagist)" as registry
actor "VCS Server\n(GitHub / GitLab / Perforce)" as vcsServer

' ─── System boundary ─────────────────────────────────────────────────────────
rectangle "Composer" {

    ' Package lifecycle
    usecase "Install Packages" as UC_INSTALL
    usecase "Update Packages" as UC_UPDATE
    usecase "Remove Packages" as UC_REMOVE

    ' Discovery
    usecase "Search Packages" as UC_SEARCH
    usecase "Show Package Information" as UC_SHOW

    ' Core internals
    usecase "Resolve Dependencies" as UC_RESOLVE
    usecase "Download Package Files" as UC_DOWNLOAD
    usecase "Manage Autoload" as UC_AUTOLOAD

    ' Repository management
    usecase "Manage Repositories" as UC_REPOS
    usecase "Load Packages from Registry" as UC_LOAD_REGISTRY
    usecase "Load Packages from VCS" as UC_LOAD_VCS

    ' Plugin & script management
    usecase "Manage Plugins" as UC_PLUGINS
    usecase "Execute Scripts / Events" as UC_SCRIPTS

    ' Configuration & I/O
    usecase "Configure Project" as UC_CONFIG
    usecase "Interact via Console" as UC_CONSOLE
}

' ─── Developer associations ───────────────────────────────────────────────────
developer --> UC_INSTALL
developer --> UC_UPDATE
developer --> UC_REMOVE
developer --> UC_SEARCH
developer --> UC_SHOW
developer --> UC_REPOS
developer --> UC_CONFIG
developer --> UC_CONSOLE

' ─── Plugin Developer associations ───────────────────────────────────────────
pluginDev --> UC_PLUGINS
pluginDev --> UC_SCRIPTS

' ─── External system associations ─────────────────────────────────────────────
registry --> UC_LOAD_REGISTRY
vcsServer --> UC_LOAD_VCS

' ─── Include relationships ────────────────────────────────────────────────────
UC_INSTALL .> UC_RESOLVE   : <<include>>
UC_INSTALL .> UC_DOWNLOAD  : <<include>>
UC_INSTALL .> UC_AUTOLOAD  : <<include>>

UC_UPDATE .> UC_RESOLVE    : <<include>>
UC_UPDATE .> UC_DOWNLOAD   : <<include>>
UC_UPDATE .> UC_AUTOLOAD   : <<include>>

UC_RESOLVE .> UC_LOAD_REGISTRY : <<include>>

' ─── Extend relationships ─────────────────────────────────────────────────────
UC_DOWNLOAD .> UC_LOAD_VCS : <<extend>>

' ─── Internal include ─────────────────────────────────────────────────────────
UC_REPOS .> UC_LOAD_REGISTRY : <<include>>
UC_REPOS .> UC_LOAD_VCS      : <<include>>

UC_INSTALL .> UC_SCRIPTS : <<extend>>
UC_UPDATE  .> UC_SCRIPTS : <<extend>>
UC_REMOVE  .> UC_SCRIPTS : <<extend>>

@enduml
