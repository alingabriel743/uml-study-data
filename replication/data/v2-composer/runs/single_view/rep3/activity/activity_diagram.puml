@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
    StartColor #212529
    EndColor #212529
}

skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Composer Package Installation / Update Workflow

|User / CLI|
start
:Run **composer install** or **composer update**;

|BaseCommand|
:createComposerInstance($input, $io, $config);
if (Composer instance available?) then (yes)
    :getComposer($required, $disablePlugins,\n$disableScripts);
else (no)
    :Log error to ConsoleIO;
    stop
endif
:getPreferredInstallOptions($config, $input);
:createPolicyConfig($config, $input);

|PluginManager|
:isPluginAllowed($package, $isGlobalPlugin);
if (Plugin allowed?) then (yes)
    :addPlugin($plugin, $isGlobalPlugin, $sourcePackage);
    :loadRepository($repo, $isGlobalRepo, $rootPackage);
else (no)
    :Skip plugin activation;
endif

|Installer|
:__construct($io, $config, $package,\n$downloadManager, $repositoryManager,\n$locker, $installationManager, $eventDispatcher);
:createRepositorySet($forUpdate, $platformRepo,\n$rootAliases, $lockedRepository);
:createRequest($rootPackage, $platformRepo,\n$lockedRepository);

|RepositoryManager|
:createRepository($type, $config, $name);
:addRepository($repository);
fork
    :prependRepository($repository) [priority repos];
fork again
    :setLocalRepository($repository) [local repo];
end fork

|ComposerRepository|
:loadPackages($packageNameMap, $acceptableStabilities,\n$stabilityFlags, $alreadyLoaded);
if (Package data in cache?) then (yes)
    :Return cached packages;
else (no)
    :fetchFile($filename, $cacheKey,\n$sha256, $storeLastModifiedTime);
    :loadAsyncPackages($packageNames,\n$acceptableStabilities, $stabilityFlags, $alreadyLoaded);
    fork
        :isVersionAcceptable($constraint, $name,\n$versionData, $acceptableStabilities, $stabilityFlags);
    fork again
        :Resolve package aliases via AliasPackage;
    end fork
endif

|Installer|
:extractDevPackages($lockTransaction, $platformRepo,\n$aliases, $policy, $lockedRepository);
if (Dependency conflicts?) then (yes)
    :Report conflicts via ConsoleIO;
    stop
else (no)
    :Compute install / update / remove operations;
endif

|DownloadManager|
:prepare($type, $package, $targetDir, $prevPackage);
if (Prefer source?) then (yes)
    |VcsDownloader|
    :doDownload($package, $path, $url, $prevPackage);
    if (Previous version exists?) then (yes)
        :doUpdate($initial, $target, $path, $url);
    else (no)
        :Clone VCS repository;
    endif
    :cleanup($type, $package, $path, $prevPackage);
else (no)
    |FileDownloader|
    :download($package, $path, $prevPackage, $output);
    :install($package, $path, $output);
    :cleanup($type, $package, $path, $prevPackage);
endif

|InstallationManager|
:execute($repo, $operations, $devMode,\n$runScripts, $downloadOnly);
:downloadAndExecuteBatch($repo, $operations,\n$cleanupPromises, $devMode, $runScripts,\n$downloadOnly, $allOperations);
fork
    :executeBatch($repo, $operations,\n$cleanupPromises, $devMode, $runScripts,\n$allOperations);
fork again
    :install($repo, $operation) [install ops];
end fork

|ProcessExecutor|
:execute($command, $output, $cwd);
:doExecute($command, $cwd, $tty, $output);
:runProcess($command, $cwd, $env, $tty, $output);
:outputCommandRun($command, $cwd, $async);

|InstallationManager|
if (All operations succeeded?) then (yes)
    :Write updated lock file;
    :Dispatch post-install/update events via Event;
else (no)
    :Report failures via ConsoleIO;
    stop
endif

|User / CLI|
:Display installation summary;
stop

@enduml
