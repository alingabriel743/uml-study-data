@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam sequence {
    ParticipantBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #DEE2E6
    ActorBackgroundColor #E9ECEF
    ActorBorderColor #495057
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
    NoteBackgroundColor #FFF3CD
    NoteBorderColor #FFC107
}

title Composer — Package Installation Sequence

actor User as user
participant "BaseCommand" as base  #F8F9FA
participant "ConsoleIO" as io      #F8F9FA
participant "Installer" as inst    #F8F9FA
participant "ComposerRepository" as repo  #F8F9FA
participant "PluginManager" as pm  #F8F9FA
participant "InstallationManager" as im   #F8F9FA
participant "FileDownloader" as fd        #F8F9FA
participant "Filesystem" as fs            #F8F9FA

user -> base : execute($input, $output)
activate base

base -> io : doWrite("Loading composer ...")
activate io
io --> base : void
deactivate io

base -> base : getComposer($required, $disablePlugins, $disableScripts)
activate base #E9ECEF
base -> base : createComposerInstance($input, $io, $config, ...)
base --> base : Composer instance
deactivate base

base -> inst : new Installer($io, $config, $package,\n  $downloadManager, $repositoryManager,\n  $locker, $installationManager, $eventDispatcher)
activate inst

inst -> inst : createRepositorySet($forUpdate=true,\n  $platformRepo, $rootAliases, ...)
activate inst #E9ECEF

inst -> repo : loadPackages($packageNameMap,\n  $acceptableStabilities, $stabilityFlags, $alreadyLoaded)
activate repo

repo -> repo : fetchFile($filename, $cacheKey,\n  $sha256, $storeLastModifiedTime)
activate repo #E9ECEF
note right of repo : Fetches packages.json\nfrom remote repository
repo --> repo : file data
deactivate repo

repo -> repo : isVersionAcceptable($constraint, $name,\n  $versionData, $acceptableStabilities, ...)
activate repo #E9ECEF
repo --> repo : bool
deactivate repo

repo -> repo : loadAsyncPackages($packageNames,\n  $acceptableStabilities, $stabilityFlags, ...)
activate repo #E9ECEF
repo --> repo : async package data
deactivate repo

repo --> inst : packages[]
deactivate repo

inst --> inst : repositorySet
deactivate inst

inst -> inst : createRequest($rootPackage,\n  $platformRepo, $lockedRepository)
activate inst #E9ECEF
inst --> inst : Request object
deactivate inst

inst -> pm : loadRepository($repo, $isGlobalRepo, $rootPackage)
activate pm
pm -> pm : isPluginAllowed($package, $isGlobalPlugin, ...)
activate pm #E9ECEF
pm --> pm : bool
deactivate pm
pm -> pm : addPlugin($plugin, $isGlobalPlugin, $sourcePackage)
activate pm #E9ECEF
pm --> pm : void
deactivate pm
pm --> inst : plugins loaded
deactivate pm

inst -> inst : extractDevPackages($lockTransaction, $platformRepo,\n  $aliases, $policy, $lockedRepository)
activate inst #E9ECEF
inst --> inst : dev packages resolved
deactivate inst

inst -> im : execute($repo, $operations, $devMode, $runScripts, $downloadOnly)
activate im

im -> im : downloadAndExecuteBatch($repo, $operations,\n  $cleanupPromises, $devMode, $runScripts, ...)
activate im #E9ECEF

im -> fd : prepare($type, $package, $path, $prevPackage)
activate fd
fd --> im : void
deactivate fd

im -> fd : download($package, $path, $prevPackage, $output)
activate fd
note right of fd : Downloads package archive\nfrom resolved URL
fd --> im : Promise<void>
deactivate fd

im --> im : download phase done
deactivate im

im -> im : executeBatch($repo, $operations,\n  $cleanupPromises, $devMode, $runScripts, ...)
activate im #E9ECEF

im -> fd : install($package, $path, $output)
activate fd

fd -> fs : copy($source, $target)
activate fs
fs --> fd : true
deactivate fs

fd -> fs : filePutContentsIfModified($path, $content)
activate fs
fs --> fd : void
deactivate fs

fd --> im : installed
deactivate fd

im -> fd : cleanup($type, $package, $path, $prevPackage)
activate fd
fd --> im : void
deactivate fd

im --> im : batch executed
deactivate im

im --> inst : exit code (0 = success)
deactivate im

inst --> base : exit code
deactivate inst

base -> io : doWrite("Installation complete.")
activate io
io --> base : void
deactivate io

base --> user : 0 (success)
deactivate base

@enduml
