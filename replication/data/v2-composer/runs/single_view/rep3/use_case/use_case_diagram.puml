@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #3A7FC1
    FontColor #1a1a2e
}

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}

title Composer — PHP Dependency Manager: Use Case Diagram

left to right direction

actor "Developer" as dev
actor "CI/CD System" as cicd
actor "Package Repository\n(Packagist / VCS)" as repo
actor "Plugin" as plugin

rectangle "Composer" {

    usecase "Install Dependencies" as UC_INSTALL
    usecase "Update Dependencies" as UC_UPDATE
    usecase "Require Package" as UC_REQUIRE
    usecase "Remove Package" as UC_REMOVE
    usecase "Show Package Information" as UC_SHOW
    usecase "Search Packages" as UC_SEARCH
    usecase "Configure Composer" as UC_CONFIG
    usecase "Audit Security" as UC_AUDIT

    usecase "Resolve Dependencies" as UC_RESOLVE
    usecase "Download Package" as UC_DOWNLOAD
    usecase "Manage Lock File" as UC_LOCK
    usecase "Manage Repositories" as UC_REPOS
    usecase "Load VCS Repository" as UC_VCS
    usecase "Execute Scripts / Events" as UC_SCRIPTS
    usecase "Manage Plugins" as UC_PLUGINS

}

' Developer interactions
dev --> UC_INSTALL
dev --> UC_UPDATE
dev --> UC_REQUIRE
dev --> UC_REMOVE
dev --> UC_SHOW
dev --> UC_SEARCH
dev --> UC_CONFIG
dev --> UC_AUDIT

' CI/CD System interactions
cicd --> UC_INSTALL
cicd --> UC_SCRIPTS

' Package Repository interactions
repo --> UC_DOWNLOAD : provides packages
repo --> UC_SHOW : provides metadata

' Plugin interactions
plugin --> UC_PLUGINS : registered via

' Include relationships
UC_INSTALL ..> UC_RESOLVE : <<include>>
UC_INSTALL ..> UC_DOWNLOAD : <<include>>
UC_INSTALL ..> UC_LOCK : <<include>>
UC_UPDATE ..> UC_RESOLVE : <<include>>
UC_UPDATE ..> UC_DOWNLOAD : <<include>>
UC_UPDATE ..> UC_LOCK : <<include>>
UC_REQUIRE ..> UC_RESOLVE : <<include>>
UC_REQUIRE ..> UC_DOWNLOAD : <<include>>
UC_DOWNLOAD ..> UC_REPOS : <<include>>

' Extend relationships
UC_VCS ..> UC_REPOS : <<extend>>
UC_SCRIPTS ..> UC_INSTALL : <<extend>>
UC_PLUGINS ..> UC_INSTALL : <<extend>>

@enduml
