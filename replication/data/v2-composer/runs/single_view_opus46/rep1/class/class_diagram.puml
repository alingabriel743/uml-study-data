@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Composer — Class Diagram

' ============================================================
'  Package hierarchy
' ============================================================
package "Composer\\Package" {
    interface PackageInterface {
        +getRepository()
        +setRepository($repository)
        +__toString()
        +getAutoload(): array
        +getBinaries(): array
    }

    interface CompletePackageInterface {
        +getArchiveExcludes(): array
        +getArchiveName(): string
        +getAuthors(): array
        +getDescription(): string
        +getFunding(): array
    }

    interface RootPackageInterface {
        +getAliases(): array
        +getConfig(): array
        +getMinimumStability(): string
        +getPreferStable(): bool
        +getReferences(): array
    }

    class BasePackage {
        -$id: int
        -$name: string
        -$prettyName: string
        -$repository: RepositoryInterface
        -$stabilities: array
        +__construct($name)
        +getRepository()
        +setRepository($repository)
        +__toString()
        +__clone()
    }

    class Package {
        -$autoload: array
        -$binaries: array
        -$conflicts: array
        -$dev: bool
        -$devAutoload: array
        +__construct($name, $version, $prettyVersion)
        -convertLinksToMap($links, $source): array
        +getAutoload(): array
        +getBinaries(): array
        +getConflicts(): array
    }

    class AliasPackage {
        -$aliasOf: PackageInterface
        -$conflicts: array
        -$devRequires: array
        -$hasSelfVersionRequires: bool
        +__construct($aliasOf, $version, $prettyVersion)
        +getAliasOf(): PackageInterface
        +__toString()
        +getAutoload(): array
        +getBinaries(): array
    }

    class CompletePackage {
        -$abandoned: string
        -$archiveExcludes: array
        -$archiveName: string
        -$authors: array
        -$description: string
        +getArchiveExcludes(): array
        +getArchiveName(): string
        +getAuthors(): array
        +getDescription(): string
        +getFunding(): array
    }

    class CompleteAliasPackage {
        -$aliasOf: CompletePackage
        +__construct($aliasOf, $version, $prettyVersion)
        +getAliasOf(): CompletePackage
        +getArchiveExcludes(): array
        +getArchiveName(): string
        +getAuthors(): array
    }
}

' ============================================================
'  Repository hierarchy
' ============================================================
package "Composer\\Repository" {
    interface RepositoryInterface {
        +hasPackage($package): bool
        +findPackage($name, $constraint): BasePackage
        +findPackages($name, $constraint): array
        +getPackages(): array
        +search($query, $mode, $type): array
        +getRepoName(): string
    }

    interface ConfigurableRepositoryInterface <<interface>>

    class ArrayRepository {
        -$packageMap: array
        -$packages: array
        +__construct($packages)
        +addPackage($package)
        +count(): int
        #createAliasPackage($package, $alias, $prettyAlias)
        +findPackage($name, $constraint)
    }

    class ComposerRepository {
        -$allowSslDowngrade: bool
        -$baseUrl: string
        -$cache: Cache
        -$availablePackagePatterns: array
        +__construct($repoConfig, $io, $config, $httpDownloader, $eventDispatcher)
        +addPackage($package)
        -asyncFetchFile($filename, $cacheKey, $lastModifiedTime)
        -canonicalizeUrl($url)
        #configurePackageTransportOptions($package)
    }

    class VcsRepository {
        -$config: Config
        -$driver: VcsDriverInterface
        -$drivers: array
        -$emptyReferences: array
        +__construct($repoConfig, $io, $config, $httpDownloader, $dispatcher, $process, $drivers, $versionCache)
        +getDriver(): VcsDriverInterface
        +getEmptyReferences(): array
        +getRepoConfig(): array
        -getCachedPackageVersion($version, $identifier, $isVerbose, $isVeryVerbose, $isDefaultBranch)
    }
}

' ============================================================
'  VCS Drivers
' ============================================================
package "Composer\\Repository\\Vcs" {
    interface VcsDriverInterface {
        +initialize(): void
        +getComposerInformation($identifier): array
        +getFileContent($file, $identifier): string
        +getRootIdentifier(): string
        +getBranches(): array
        +getTags(): array
        +getUrl(): string
        +cleanup(): void
    }

    class VcsDriver {
        #$cache: Cache
        #$config: Config
        #$httpDownloader: HttpDownloader
        #$infoCache: array
        #$io: IOInterface
        +__construct($repoConfig, $io, $config, $httpDownloader, $process)
        +cleanup()
        #getBaseComposerInformation($identifier)
        +getComposerInformation($identifier)
        #getContents($url)
    }

    class GitHubDriver {
        -$allowGitFallback: bool
        -$branches: array
        -$fundingInfo: array
        -$gitDriver: GitDriver
        -$hasIssues: bool
        +getRepositoryUrl(): string
        #attemptCloneFallback($e)
        #fetchRootIdentifier()
        #generateSshUrl(): string
        #getApiUrl(): string
    }

    class GitLabDriver {
        -$branches: array
        -$commits: array
        -$gitDriver: GitDriver
        -$isPrivate: bool
        +getRepositoryUrl(): string
        #attemptCloneFallback()
        -determineOrigin($configuredDomains, $guessedDomain, $urlParts, $portNumber)
        #fetchProject()
        #generatePublicUrl(): string
    }
}

' ============================================================
'  Downloaders
' ============================================================
package "Composer\\Downloader" {
    interface DownloaderInterface {
        +getInstallationSource(): string
        +download($package, $path, $prevPackage): PromiseInterface
        +prepare($type, $package, $path, $prevPackage): PromiseInterface
        +install($package, $path): PromiseInterface
        +update($initial, $target, $path): PromiseInterface
        +remove($package, $path): PromiseInterface
        +cleanup($type, $package, $path, $prevPackage): PromiseInterface
    }

    interface ChangeReportInterface <<interface>>
    interface VcsCapableDownloaderInterface <<interface>>

    class VcsDownloader {
        #$config: Config
        #$filesystem: Filesystem
        -$hasCleanedChanges: bool
        #$io: IOInterface
        #$process: ProcessExecutor
        +__construct($io, $config, $process, $fs)
        #hasMetadataRepository($path): bool
        #cleanChanges($package, $path, $update)
        +cleanup($type, $package, $path, $prevPackage)
        #doDownload($package, $path, $url, $prevPackage)
    }

    class FileDownloader {
        -$additionalCleanupPaths: array
        -$cache: Cache
        -$config: Config
        -$downloadMetadata: array
        -$eventDispatcher: EventDispatcher
        +__construct($io, $config, $httpDownloader, $eventDispatcher, $cache, $filesystem, $process)
        #addCleanupPath($package, $path)
        +cleanup($type, $package, $path, $prevPackage)
        #clearLastCacheWrite($package)
        +download($package, $path, $prevPackage, $output)
    }
}

' ============================================================
'  Commands
' ============================================================
package "Composer\\Command" {
    abstract class BaseCommand <<Symfony Console>> {
        #$composer: Composer
        #$io: IOInterface
        +complete($input, $suggestions)
        #createAuditConfig($input): AuditConfig
        #createComposerInstance($input, $io, $config, $disablePlugins, $disableScripts)
        #createPolicyConfig($config, $input)
        #formatRequirements($requirements): array
    }

    class ShowCommand {
        -$colors: array
        -$repositorySet: RepositorySet
        -$versionParser: VersionParser
        -getRepositorySet($composer): RepositorySet
        #addTree($name, $link, $installedRepo, $remoteRepos, $packagesInTree)
        -appendAutoload($json, $package)
        -appendLicenses($json, $package)
        -appendLink($json, $package, $linkType)
    }
}

' ============================================================
'  IO
' ============================================================
package "Composer\\IO" {
    interface IOInterface {
        +isInteractive(): bool
        +isVerbose(): bool
        +isVeryVerbose(): bool
        +write($messages, $newline, $verbosity)
        +ask($question, $default)
    }

    abstract class BaseIO {
        #$authentications: array
        +getAuthentications(): array
        +resetAuthentications(): void
    }

    class ConsoleIO {
        -$helperSet: HelperSet
        -$input: InputInterface
        -$lastMessage: string
        -$lastMessageErr: string
        -$output: OutputInterface
        +__construct($input, $output, $helperSet)
        +ask($question, $default)
        +askAndHideAnswer($question)
        +askAndValidate($question, $validator, $attempts, $default)
        +askConfirmation($question, $default)
    }
}

' ============================================================
'  Events
' ============================================================
package "Composer\\EventDispatcher" {
    class "Event" as BaseEvent {
        -$args: array
        -$flags: array
        -$name: string
        -$propagationStopped: bool
    }
}

package "Composer\\Script" {
    class ScriptEvent {
        -$composer: Composer
        -$devMode: bool
        -$io: IOInterface
        -$originatingEvent: ScriptEvent
        +__construct($name, $composer, $io, $devMode, $args, $flags)
        -calculateOriginatingEvent($event)
        +getComposer(): Composer
        +getIO(): IOInterface
        +getOriginatingEvent(): ScriptEvent
    }
}

' ============================================================
'  Core services
' ============================================================
package "Composer" {
    class Installer {
        -$additionalFixedRepository: RepositoryInterface
        -$allowedTypes: array
        -$apcuAutoloader: bool
        -$audit: AuditConfig
        +__construct($io, $config, $package, $downloadManager, $repositoryManager, $locker, $installationManager, $eventDispatcher)
        +{static} create($io, $composer): Installer
        +setAdditionalFixedRepository($additionalFixedRepository)
        -createRepositorySet($forUpdate, $platformRepo, $rootAliases, $lockedRepository)
        -createFilterListPoolFilter($blockScope)
    }
}

package "Composer\\Installer" {
    class InstallationManager {
        -$cache: array
        -$eventDispatcher: EventDispatcher
        -$installers: array
        -$io: IOInterface
        -$loop: Loop
        +__construct($loop, $io, $eventDispatcher)
        +addInstaller($installer)
        +disablePlugins()
        +download($package)
        -downloadAndExecuteBatch($repo, $operations, $cleanupPromises, $devMode, $runScripts, $downloadOnly, $allOperations)
    }
}

package "Composer\\Plugin" {
    class PluginManager {
        -$allowGlobalPluginRules: array
        -$allowPluginRules: array
        -$autoloadedPackages: array
        -$composer: Composer
        +__construct($io, $composer, $globalComposer, $disablePlugins)
        +addPlugin($plugin, $isGlobalPlugin, $sourcePackage)
        +arePluginsDisabled($type): bool
        -deactivateRepository($repo, $isGlobalRepo)
        -loadRepository($repo, $isGlobalRepo, $rootPackage)
    }
}

' ============================================================
'  Utilities
' ============================================================
package "Composer\\Util" {
    class Filesystem {
        -$processExecutor: ProcessExecutor
        +__construct($executor)
        +copy($source, $target): bool
        +copyThenRemove($source, $target)
        #directorySize($directory): int
        +emptyDirectory($dir, $ensureDirectoryExists)
    }

    class Perforce {
        -$commandResult: string
        -$filesystem: Filesystem
        -$io: IOInterface
        -$p4Branch: string
        -$p4Client: string
        +__construct($repoConfig, $port, $path, $process, $isWindows, $io)
        +{static} checkServerExists($url, $processExecutor): bool
        +checkStream()
        +cleanupClientSpec()
        +connectClient()
    }
}

' ============================================================
'  INHERITANCE  RELATIONSHIPS
' ============================================================

' -- Package interface chain --
CompletePackageInterface --|> PackageInterface
RootPackageInterface --|> CompletePackageInterface

' -- Package class chain --
BasePackage ..|> PackageInterface
Package --|> BasePackage
AliasPackage --|> BasePackage
CompletePackage --|> Package
CompletePackage ..|> CompletePackageInterface
CompleteAliasPackage --|> AliasPackage
CompleteAliasPackage ..|> CompletePackageInterface

' -- Repository class chain --
ArrayRepository ..|> RepositoryInterface
ComposerRepository --|> ArrayRepository
ComposerRepository ..|> ConfigurableRepositoryInterface
VcsRepository --|> ArrayRepository
VcsRepository ..|> ConfigurableRepositoryInterface

' -- VCS Driver chain --
VcsDriver ..|> VcsDriverInterface
GitHubDriver --|> VcsDriver
GitLabDriver --|> VcsDriver

' -- Downloader chain --
VcsDownloader ..|> DownloaderInterface
VcsDownloader ..|> ChangeReportInterface
VcsDownloader ..|> VcsCapableDownloaderInterface
FileDownloader ..|> DownloaderInterface
FileDownloader ..|> ChangeReportInterface

' -- IO chain --
BaseIO ..|> IOInterface
ConsoleIO --|> BaseIO

' -- Event chain --
ScriptEvent --|> BaseEvent

' ============================================================
'  COMPOSITION / DEPENDENCY  RELATIONSHIPS
' ============================================================

' -- Core wiring --
Installer *-- InstallationManager : installationManager
Installer o-- PluginManager : via Composer
Installer ..> RepositoryInterface : repositoryManager
Installer ..> IOInterface : io

' -- Repository → Driver --
VcsRepository o-- VcsDriverInterface : driver

' -- Downloader → Util --
VcsDownloader o-- Filesystem : filesystem

' -- Manager → Interface --
InstallationManager ..> DownloaderInterface : delegates to
PluginManager ..> PackageInterface : manages plugins for

' -- Event wiring --
ScriptEvent o-- IOInterface : io

@enduml
