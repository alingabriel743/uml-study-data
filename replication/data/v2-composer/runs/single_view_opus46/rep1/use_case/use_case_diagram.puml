@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Composer — Dependency Manager for PHP\nUse Case Diagram

left to right direction

actor "Developer" as developer
actor "Package\nRepository" as repo <<external>>
actor "Plugin" as plugin <<external>>
actor "VCS Provider\n(Git/SVN/Hg)" as vcs <<external>>

rectangle "Composer" {

    ' ── Project Setup ──
    usecase "Initialize\nProject" as UC_INIT
    usecase "Create Project\nfrom Package" as UC_CREATE

    ' ── Dependency Management ──
    usecase "Install\nDependencies" as UC_INSTALL
    usecase "Update\nDependencies" as UC_UPDATE
    usecase "Require\nPackage" as UC_REQUIRE
    usecase "Remove\nPackage" as UC_REMOVE
    usecase "Reinstall\nPackages" as UC_REINSTALL
    usecase "Bump Version\nConstraints" as UC_BUMP

    ' ── Package Information ──
    usecase "Show Package\nInfo" as UC_SHOW
    usecase "Search\nPackages" as UC_SEARCH
    usecase "Check Outdated\nPackages" as UC_OUTDATED
    usecase "View\nLicenses" as UC_LICENSES

    ' ── Configuration & Validation ──
    usecase "Configure\nSettings" as UC_CONFIG
    usecase "Validate\ncomposer.json" as UC_VALIDATE
    usecase "Manage\nRepositories" as UC_REPO

    ' ── Autoloading & Scripts ──
    usecase "Dump\nAutoload" as UC_AUTOLOAD
    usecase "Run\nScripts" as UC_SCRIPT

    ' ── Security & Diagnostics ──
    usecase "Audit Security\nAdvisories" as UC_AUDIT
    usecase "Diagnose\nIssues" as UC_DIAGNOSE
    usecase "Self-Update\nComposer" as UC_SELFUPDATE
    usecase "Clear\nCache" as UC_CACHE

    ' ── Archive ──
    usecase "Archive\nPackage" as UC_ARCHIVE

    ' ── Internal (included) ──
    usecase "Resolve\nDependencies" as UC_RESOLVE
    usecase "Download\nPackages" as UC_DOWNLOAD
    usecase "Generate Autoload\nFiles" as UC_GENLOAD
    usecase "Manage\nLock File" as UC_LOCK
    usecase "Load\nPlugins" as UC_PLUGINS
}

' ── Developer interactions ──
developer --> UC_INIT
developer --> UC_CREATE
developer --> UC_INSTALL
developer --> UC_UPDATE
developer --> UC_REQUIRE
developer --> UC_REMOVE
developer --> UC_REINSTALL
developer --> UC_BUMP
developer --> UC_SHOW
developer --> UC_SEARCH
developer --> UC_OUTDATED
developer --> UC_LICENSES
developer --> UC_CONFIG
developer --> UC_VALIDATE
developer --> UC_REPO
developer --> UC_AUTOLOAD
developer --> UC_SCRIPT
developer --> UC_AUDIT
developer --> UC_DIAGNOSE
developer --> UC_SELFUPDATE
developer --> UC_CACHE
developer --> UC_ARCHIVE

' ── Include relationships ──
UC_INSTALL ..> UC_RESOLVE : <<include>>
UC_UPDATE ..> UC_RESOLVE : <<include>>
UC_REQUIRE ..> UC_RESOLVE : <<include>>
UC_CREATE ..> UC_RESOLVE : <<include>>

UC_INSTALL ..> UC_DOWNLOAD : <<include>>
UC_UPDATE ..> UC_DOWNLOAD : <<include>>
UC_CREATE ..> UC_DOWNLOAD : <<include>>
UC_REINSTALL ..> UC_DOWNLOAD : <<include>>

UC_INSTALL ..> UC_GENLOAD : <<include>>
UC_UPDATE ..> UC_GENLOAD : <<include>>
UC_AUTOLOAD ..> UC_GENLOAD : <<include>>

UC_INSTALL ..> UC_LOCK : <<include>>
UC_UPDATE ..> UC_LOCK : <<include>>
UC_REQUIRE ..> UC_LOCK : <<include>>

UC_INSTALL ..> UC_PLUGINS : <<include>>
UC_UPDATE ..> UC_PLUGINS : <<include>>

' ── Extend relationships ──
UC_OUTDATED ..> UC_SHOW : <<extend>>

' ── External system interactions ──
repo --> UC_RESOLVE
repo --> UC_SEARCH
repo --> UC_AUDIT

vcs --> UC_DOWNLOAD
vcs --> UC_CREATE

plugin --> UC_PLUGINS

@enduml
