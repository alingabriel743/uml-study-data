@startuml
title Composer Package Installation/Update Workflow

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

|User|
start
:Run Composer Command;

|BaseCommand|
:getComposer();
:createComposerInstance();

|Installer|
:Initialize Installer;
:run();
:Disable Garbage Collection;

if (Lock file exists?) then (no)
    :Set update mode = true;
    :Display warning message;
else (yes)
endif

if (Dry run mode?) then (yes)
    :Disable write operations;
    :Mock local repositories;
else (no)
endif

:Configure DownloadManager\n(setPreferSource, setPreferDist);

if (Update mode?) then (yes)
    |Installer|
    :doUpdate();

    |RepositoryManager|
    :Load composer repositories;

    |Installer|
    :createRepositorySet();
    :createRequest();
    :requirePackagesForUpdate();

    if (Partial update?) then (yes)
        :Apply update allow list;
    else (no)
    endif

    :createPool();

    |DependencyResolver|
    :Create Solver;
    :solve(request);

    if (Can resolve dependencies?) then (no)
        :Display error message;
        :getPrettyString();
        stop
    else (yes)
        :Generate lock transaction;
    endif

    |Installer|
    if (Operations exist?) then (no)
        :Display "Nothing to modify";
    else (yes)
    endif

else (no)
    |Installer|
    :doInstall();
    :Read lock file;

    |RepositoryManager|
    :getLockedRepository();

    |Installer|
    :Verify lock file is fresh;

    if (Lock file is valid?) then (no)
        :Display warning/error;
        if (Allow missing requirements?) then (no)
            stop
        else (yes)
        endif
    else (yes)
    endif

    :createRepositorySet();
    :createRequest();
    :Fix locked packages;

    |DependencyResolver|
    :Create Solver;
    :solve(request);

    if (Lock compatible with platform?) then (no)
        :Display error;
        stop
    else (yes)
    endif

endif

|Installer|
:Calculate local repository transaction;
:extractDevPackages();

if (Execute operations?) then (yes)

    fork
        |DownloadManager|
        :Prepare downloads;

        while (For each package) is (more packages)
            if (Package type?) then (dist)
                :FileDownloader.download();
            else (source)
                :VcsDownloader.doDownload();
            endif
            :Extract to target directory;
        endwhile (done)

    fork again
        |InstallationManager|
        :execute(operations);

        while (For each operation) is (more operations)
            if (Operation type?) then (install)
                :install(package);
            else if (update) then
                :update(initial, target);
            else (uninstall)
                :uninstall(package);
            endif

            |ProcessExecutor|
            :Execute install scripts;
            :outputHandler();
        endwhile (done)

    end fork

    |InstallationManager|
    if (Notify on install?) then (yes)
        :notifyInstalls();
    else (no)
    endif

else (no)
    :Skip execution (dry run);
endif

|Installer|
if (Write lock file?) then (yes)
    :Generate lock file content;
    :Write composer.lock;
else (no)
endif

if (Dump autoloader?) then (yes)
    |AutoloadGenerator|
    :Generate autoload files;

    if (Optimize autoloader?) then (yes)
        :Generate optimized classmap;
    else (no)
        :Generate standard autoload;
    endif

    if (PSR violations exist?) then (yes)
        if (Strict PSR mode?) then (yes)
            :Return PSR violation error;
            stop
        else (no)
        endif
    else (no)
    endif

else (no)
endif

|Installer|
:Ensure binaries presence;

if (Check for abandoned packages?) then (found)
    while (For each abandoned package) is (more)
        :Display warning;
        :Show replacement if available;
    endwhile (done)
else (none)
endif

if (Show funding info?) then (yes)
    :Display funding suggestions;
else (no)
endif

if (Run post-scripts?) then (yes)
    |EventDispatcher|
    if (Update mode?) then (yes)
        :dispatchScript(POST_UPDATE_CMD);
    else (no)
        :dispatchScript(POST_INSTALL_CMD);
    endif

    |ProcessExecutor|
    :runProcess(script commands);
    :outputHandler();
else (no)
endif

|Installer|
:Re-enable Garbage Collection;
:Return success code;

|User|
stop

@enduml
