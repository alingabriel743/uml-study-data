@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Composer - Class Diagram

package "Package Domain Model" {
    interface PackageInterface {
        +getRepository()
        +setRepository($repository)
        +__toString()
        +getAutoload()
        +getBinaries()
    }

    abstract class BasePackage {
        -$id
        -$name
        -$prettyName
        -$repository
        -$stabilities
        +__construct($name)
        +__clone()
        +__toString()
        +getRepository()
        +setRepository($repository)
    }

    class Package {
        -$autoload
        -$binaries
        -$conflicts
        -$dev
        -$devAutoload
        +__construct($name, $version, $prettyVersion)
        +getAutoload()
        +getBinaries()
        +getConflicts()
        -convertLinksToMap($links, $source)
    }

    class AliasPackage {
        -$aliasOf
        -$conflicts
        -$dev
        -$devRequires
        -$hasSelfVersionRequires
        +__construct($aliasOf, $version, $prettyVersion)
        +__toString()
        +getAliasOf()
        +getAutoload()
        +getBinaries()
    }

    interface CompletePackageInterface {
        +getArchiveExcludes()
        +getArchiveName()
        +getAuthors()
        +getDescription()
        +getFunding()
    }

    class CompletePackage {
        -$abandoned
        -$archiveExcludes
        -$archiveName
        -$authors
        -$description
        +getArchiveExcludes()
        +getArchiveName()
        +getAuthors()
        +getDescription()
        +getFunding()
    }

    class CompleteAliasPackage {
        -$aliasOf
        +__construct($aliasOf, $version, $prettyVersion)
        +getAliasOf()
        +getArchiveExcludes()
        +getArchiveName()
        +getAuthors()
    }

    interface RootPackageInterface {
        +getAliases()
        +getConfig()
        +getMinimumStability()
        +getPreferStable()
        +getReferences()
    }
}

package "Repository" {
    interface RepositoryInterface

    class ArrayRepository {
        -$packageMap
        -$packages
        +__construct($packages)
        +addPackage($package)
        +count()
        +findPackage($name, $constraint)
        #createAliasPackage($package, $alias, $prettyAlias)
    }

    interface ConfigurableRepositoryInterface
    interface AdvisoryProviderInterface
    interface FilterListProviderInterface

    class ComposerRepository {
        -$allowSslDowngrade
        -$availablePackagePatterns
        -$availablePackages
        -$baseUrl
        -$cache
        +__construct($repoConfig, $io, $config, $httpDownloader, $eventDispatcher)
        +addPackage($package)
        #configurePackageTransportOptions($package)
        -asyncFetchFile($filename, $cacheKey, $lastModifiedTime)
        -canonicalizeUrl($url)
    }

    class VcsRepository {
        -$branchErrorOccurred
        -$config
        -$driver
        -$drivers
        -$emptyReferences
        +__construct($repoConfig, $io, $config, $httpDownloader, $dispatcher, $process, $drivers, $versionCache)
        +getDriver()
        +getEmptyReferences()
        +getRepoConfig()
        -getCachedPackageVersion($version, $identifier, $isVerbose, $isVeryVerbose, $isDefaultBranch)
    }
}

package "VCS Drivers" {
    interface VcsDriverInterface

    abstract class VcsDriver {
        -$cache
        -$config
        -$httpDownloader
        -$infoCache
        -$io
        +__construct($repoConfig, $io, $config, $httpDownloader, $process)
        +cleanup()
        +getComposerInformation($identifier)
        #getBaseComposerInformation($identifier)
        #getContents($url)
    }

    class GitHubDriver {
        -$allowGitFallback
        -$branches
        -$fundingInfo
        -$gitDriver
        -$hasIssues
        +getRepositoryUrl()
        #attemptCloneFallback($e)
        #fetchRootIdentifier()
        #generateSshUrl()
        #getApiUrl()
    }

    class GitLabDriver {
        -$branches
        -$commits
        -$gitDriver
        -$hasNonstandardOrigin
        -$isPrivate
        +getRepositoryUrl()
        #attemptCloneFallback()
        #fetchProject()
        #generatePublicUrl()
        -determineOrigin($configuredDomains, $guessedDomain, $urlParts, $portNumber)
    }
}

package "Downloaders" {
    interface DownloaderInterface
    interface ChangeReportInterface
    interface VcsCapableDownloaderInterface

    class VcsDownloader {
        -$config
        -$filesystem
        -$hasCleanedChanges
        -$io
        -$process
        +__construct($io, $config, $process, $fs)
        +cleanup($type, $package, $path, $prevPackage)
        #cleanChanges($package, $path, $update)
        #doDownload($package, $path, $url, $prevPackage)
        #hasMetadataRepository($path)
    }

    class FileDownloader {
        -$additionalCleanupPaths
        -$cache
        -$config
        -$downloadMetadata
        -$eventDispatcher
        +__construct($io, $config, $httpDownloader, $eventDispatcher, $cache, $filesystem, $process)
        +download($package, $path, $prevPackage, $output)
        +cleanup($type, $package, $path, $prevPackage)
        #addCleanupPath($package, $path)
        #clearLastCacheWrite($package)
    }
}

package "Installation" {
    class Installer {
        -$additionalFixedRepository
        -$allowedTypes
        -$apcuAutoloader
        -$apcuAutoloaderPrefix
        -$audit
        +__construct($io, $config, $package, $downloadManager, $repositoryManager, $locker, $installationManager, $eventDispatcher)
        +create($io, $composer)
        +setAdditionalFixedRepository($additionalFixedRepository)
        -createRepositorySet($forUpdate, $platformRepo, $rootAliases, $lockedRepository)
        -createFilterListPoolFilter($blockScope)
    }

    class InstallationManager {
        -$cache
        -$eventDispatcher
        -$installers
        -$io
        -$loop
        +__construct($loop, $io, $eventDispatcher)
        +addInstaller($installer)
        +disablePlugins()
        +download($package)
        -downloadAndExecuteBatch($repo, $operations, $cleanupPromises, $devMode, $runScripts, $downloadOnly, $allOperations)
    }
}

package "Commands" {
    class Command

    class BaseCommand {
        -$composer
        -$io
        +complete($input, $suggestions)
        #createAuditConfig($input)
        #createComposerInstance($input, $io, $config, $disablePlugins, $disableScripts)
        #createPolicyConfig($config, $input)
        #formatRequirements($requirements)
    }

    class ShowCommand {
        -$colors
        -$repositorySet
        -$versionParser
        #addTree($name, $link, $installedRepo, $remoteRepos, $packagesInTree)
        -getRepositorySet($composer)
        -appendAutoload($json, $package)
        -appendLicenses($json, $package)
        -appendLink($json, $package, $linkType)
    }
}

package "IO" {
    class BaseIO

    class ConsoleIO {
        -$helperSet
        -$input
        -$lastMessage
        -$lastMessageErr
        -$output
        +__construct($input, $output, $helperSet)
        +ask($question, $default)
        +askAndHideAnswer($question)
        +askAndValidate($question, $validator, $attempts, $default)
        +askConfirmation($question, $default)
    }
}

package "Plugin" {
    class PluginManager {
        -$allowGlobalPluginRules
        -$allowPluginRules
        -$autoloadedPackages
        -$classCounter
        -$composer
        +__construct($io, $composer, $globalComposer, $disablePlugins)
        +addPlugin($plugin, $isGlobalPlugin, $sourcePackage)
        +arePluginsDisabled($type)
        -deactivateRepository($repo, $isGlobalRepo)
        -loadRepository($repo, $isGlobalRepo, $rootPackage)
    }
}

package "Events" {
    class BaseEvent

    class Event {
        -$composer
        -$devMode
        -$io
        -$originatingEvent
        +__construct($name, $composer, $io, $devMode, $args, $flags)
        +getComposer()
        +getIO()
        +getOriginatingEvent()
        -calculateOriginatingEvent($event)
    }
}

package "Utilities" {
    class Filesystem {
        -$processExecutor
        +__construct($executor)
        +copy($source, $target)
        +copyThenRemove($source, $target)
        +emptyDirectory($dir, $ensureDirectoryExists)
        #directorySize($directory)
    }

    class Perforce {
        -$commandResult
        -$filesystem
        -$io
        -$p4Branch
        -$p4Client
        +__construct($repoConfig, $port, $path, $process, $isWindows, $io)
        +checkServerExists($url, $processExecutor)
        +checkStream()
        +cleanupClientSpec()
        +connectClient()
    }
}

' Package Relationships
BasePackage ..|> PackageInterface
Package --|> BasePackage
AliasPackage --|> BasePackage
CompletePackageInterface --|> PackageInterface
CompletePackage --|> Package
CompletePackage ..|> CompletePackageInterface
CompleteAliasPackage --|> AliasPackage
CompleteAliasPackage ..|> CompletePackageInterface
RootPackageInterface --|> CompletePackageInterface

' Repository Relationships
ArrayRepository ..|> RepositoryInterface
ComposerRepository --|> ArrayRepository
ComposerRepository ..|> ConfigurableRepositoryInterface
ComposerRepository ..|> AdvisoryProviderInterface
ComposerRepository ..|> FilterListProviderInterface
VcsRepository --|> ArrayRepository
VcsRepository ..|> ConfigurableRepositoryInterface

' VCS Driver Relationships
VcsDriver ..|> VcsDriverInterface
GitHubDriver --|> VcsDriver
GitLabDriver --|> VcsDriver

' Downloader Relationships
VcsDownloader ..|> DownloaderInterface
VcsDownloader ..|> ChangeReportInterface
VcsDownloader ..|> VcsCapableDownloaderInterface
FileDownloader ..|> DownloaderInterface
FileDownloader ..|> ChangeReportInterface

' Command Relationships
BaseCommand --|> Command
ShowCommand --|> BaseCommand

' IO Relationships
ConsoleIO --|> BaseIO

' Event Relationships
Event --|> BaseEvent

' Key Associations
ArrayRepository o-- PackageInterface : manages
VcsRepository o-- VcsDriver : uses
Installer o-- InstallationManager : uses
PluginManager o-- PackageInterface : manages plugins

@enduml
