@startuml
title Composer Package Installation Flow

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

actor User
participant "BaseCommand" as cmd
participant "Installer" as installer
participant "ComposerRepository" as repo
participant "VcsRepository" as vcs
participant "VcsDriver" as driver
participant "InstallationManager" as instMgr
participant "FileDownloader" as fileDown
participant "VcsDownloader" as vcsDown
participant "Filesystem" as fs
participant "PluginManager" as pluginMgr

User -> cmd: execute install command
activate cmd

cmd -> cmd: getComposer($required, $disablePlugins, $disableScripts)
activate cmd
cmd -> cmd: createComposerInstance($input, $io, $config, $disablePlugins, $disableScripts)
deactivate cmd

cmd -> installer: **construct($io, $config, $package, $downloadManager,\n$repositoryManager, $locker, $installationManager, $eventDispatcher)
activate installer

cmd -> installer: run installation
installer -> installer: createRepositorySet($forUpdate, $platformRepo, $rootAliases, $lockedRepository)
activate installer
deactivate installer

installer -> installer: createRequest($rootPackage, $platformRepo, $lockedRepository)

installer -> repo: loadPackages($packageNameMap, $acceptableStabilities, $stabilityFlags, $alreadyLoaded)
activate repo

repo -> repo: loadAsyncPackages($packageNames, $acceptableStabilities, $stabilityFlags, $alreadyLoaded)
activate repo

repo -> repo: fetchFile($filename, $cacheKey, $sha256, $storeLastModifiedTime)
activate repo
repo -> repo: isVersionAcceptable($constraint, $name, $versionData,\n$acceptableStabilities, $stabilityFlags)
deactivate repo

repo --> installer: packages loaded
deactivate repo
deactivate repo

installer -> vcs: __construct($repoConfig, $io, $config, $httpDownloader,\n$dispatcher, $process, $drivers, $versionCache)
activate vcs

vcs -> driver: getComposerInformation($identifier)
activate driver
driver -> driver: getBaseComposerInformation($identifier)
activate driver
driver -> driver: hasComposerFile($identifier)
driver -> driver: getContents($url)
deactivate driver
driver --> vcs: composer data
deactivate driver

vcs -> vcs: preProcess($driver, $data, $identifier)
vcs -> vcs: validateBranch($branch)
vcs -> vcs: getCachedPackageVersion($version, $identifier, $isVerbose,\n$isVeryVerbose, $isDefaultBranch)
vcs --> installer: repository data
deactivate vcs

installer -> installer: extractDevPackages($lockTransaction, $platformRepo,\n$aliases, $policy, $lockedRepository)

installer -> instMgr: execute($repo, $operations, $devMode, $runScripts, $downloadOnly)
activate instMgr

instMgr -> instMgr: downloadAndExecuteBatch($repo, $operations, $cleanupPromises,\n$devMode, $runScripts, $downloadOnly, $allOperations)
activate instMgr

alt File Package
    instMgr -> fileDown: download($package, $path, $prevPackage, $output)
    activate fileDown
    fileDown -> fileDown: prepare($type, $package, $path, $prevPackage)
    fileDown -> fileDown: install($package, $path, $output)
    activate fileDown

    fileDown -> fs: copy($source, $target)
    activate fs
    fs -> fs: filesAreEqual($a, $b)
    fs --> fileDown: file copied
    deactivate fs

    fileDown -> fs: filePutContentsIfModified($path, $content)
    activate fs
    fs --> fileDown: file written
    deactivate fs

    fileDown -> fileDown: cleanup($type, $package, $path, $prevPackage)
    deactivate fileDown
    fileDown --> instMgr: download complete
    deactivate fileDown
else VCS Package
    instMgr -> vcsDown: doDownload($package, $path, $url, $prevPackage)
    activate vcsDown
    vcsDown -> vcsDown: hasMetadataRepository($path)
    vcsDown -> fs: emptyDirectory($dir, $ensureDirectoryExists)
    activate fs
    fs --> vcsDown: directory prepared
    deactivate fs
    vcsDown --> instMgr: vcs download complete
    deactivate vcsDown
end

instMgr -> instMgr: executeBatch($repo, $operations, $cleanupPromises,\n$devMode, $runScripts, $allOperations)

instMgr -> instMgr: install($repo, $operation)
activate instMgr
deactivate instMgr

instMgr --> installer: execution complete
deactivate instMgr
deactivate instMgr

installer -> pluginMgr: loadRepository($repo, $isGlobalRepo, $rootPackage)
activate pluginMgr
pluginMgr -> pluginMgr: isPluginAllowed($package, $isGlobalPlugin, $optional, $prompt)
pluginMgr -> pluginMgr: addPlugin($plugin, $isGlobalPlugin, $sourcePackage)
pluginMgr --> installer: plugins loaded
deactivate pluginMgr

installer --> cmd: installation complete
deactivate installer

cmd --> User: success message
deactivate cmd

@enduml
