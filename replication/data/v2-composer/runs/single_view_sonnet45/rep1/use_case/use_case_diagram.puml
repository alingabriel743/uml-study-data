@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Composer - Use Case Diagram

left to right direction

actor "Developer" as dev
actor "Plugin" as plugin
actor "Version Control\nSystem" as vcs
actor "Package\nRepository" as repo

rectangle "Composer System" {
    usecase "Install Packages" as UC1
    usecase "Update Packages" as UC2
    usecase "Download Packages" as UC3
    usecase "Search Packages" as UC4
    usecase "Show Package\nInformation" as UC5
    usecase "Configure\nComposer" as UC6
    usecase "Manage Plugins" as UC7
    usecase "Execute Scripts" as UC8
    usecase "Manage\nRepositories" as UC9
    usecase "Handle Version\nControl" as UC10
    usecase "Create Package\nAliases" as UC11
    usecase "Validate Package\nDependencies" as UC12
    usecase "Manage File\nOperations" as UC13
}

' Developer interactions
dev --> UC1
dev --> UC2
dev --> UC4
dev --> UC5
dev --> UC6
dev --> UC7
dev --> UC8

' Plugin interactions
plugin --> UC7

' External system interactions
vcs --> UC10
repo --> UC3

' Include relationships
UC1 ..> UC3 : <<include>>
UC2 ..> UC3 : <<include>>
UC1 ..> UC12 : <<include>>
UC2 ..> UC12 : <<include>>
UC3 ..> UC10 : <<include>>
UC1 ..> UC13 : <<include>>
UC2 ..> UC13 : <<include>>

' Extend relationships
UC3 ..> UC11 : <<extend>>
UC9 ..> UC4 : <<extend>>

' Additional relationships
dev --> UC9
UC7 ..> UC8 : <<include>>

@enduml
