@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleFontColor #212529
    TitleFontSize 13
    BackgroundColor #FAFAFA
}

title v2-Evolver: Autonomous Code Evolution Cycle

|Evolver Daemon|
start

:Check for wake signal\nor wait for scheduled interval;

if (Wake signal pending?\n[evolver_wake.signal exists]) then (yes)
  :Clear wake signal file;
else (no)
  :Resume from scheduled timer;
endif

:Read system signals from MEMORY.md;
:Analyze past failure patterns\n(extract top 3 recent failures);
:Scan skill categories for stagnation;\nGenerate innovation ideas if needed;

:Select Gene\n(strategy + mutation template);
:Apply mutation to working tree\n(edit code files);
:Compute blast radius\n(files changed, lines affected);

|Validation Pipeline|
:Run Constraint Check\n(blast radius ≤ A2A_MAX_FILES / A2A_MAX_LINES,\nno forbidden paths, ethics check, HARD CAP);

if (Constraints violated?) then (yes)
  :Log violations\n(max_files_exceeded, forbidden_path,\nhard_cap_breach, ethics_violation);
  |Evolver Daemon|
  :Revert mutation;
  :Record outcome: constraint_fail;
  :Run Cleanup\n(delete stale GEP artifacts);
  stop
else (no)
  :Run validation commands\n(npm test, eslint, node validate);
endif

if (All validations pass?) then (yes)
  :Run Canary check\n(fork child process:\nrequire index.js, exit 0 = safe);
else (no)
  :Collect error signatures\n(TypeError, ECONNRESET, HTTP_5xx, ...);
  |Evolver Daemon|
  :Run Git Self-Repair\n(abort rebase/merge,\nremove stale index.lock,\ngit fetch origin);
  :Revert mutation;
  :Record outcome: validation_failed;
  stop
endif

if (Canary passed?\n[exit code 0]) then (yes)
  if (LLM Review enabled?\n[EVOLVER_LLM_REVIEW=true]) then (yes)
    :Build review prompt\n(diff preview up to 6000 chars,\ngene ID + category,\nsignals list, mutation rationale);
    :Execute LLM Review\n(check regression, blast radius,\nsecurity concerns, signal coverage);
    if (Review approved?\n[approved=true]) then (yes)
    else (no)
      :Log review concerns;
      |Evolver Daemon|
      :Revert mutation;
      :Record outcome: review_rejected;
      stop
    endif
  else (no)
  endif
else (no)
  :Log canary failure\n(stderr from child process);
  |Evolver Daemon|
  :Revert mutation;
  :Record outcome: canary_failed;
  stop
endif

|Git / Solidify|
:git commit changes\n(stage mutation files);
:git push to origin/main;

if (Push succeeded?) then (yes)
  |Evolver Daemon|
  :Build desensitized Execution Trace\n(gene_id, files_changed_count,\nvalidation_result, blast_radius,\nerror_signatures, tool_chain);
  :Record EvolutionEvent\n(outcome: success,\nwith execution trace);
  :Update capsule confidence score\nand success streak count;
  if (Capsule broadcast eligible?\n[score≥0.7 AND streak≥2\nAND blast radius safe]) then (yes)
    :Assign asset_id + schema_version\nto capsule;
    :Export eligible Capsule\nto A2A Hub\n(external_candidate status);
  else (no)
    :Skip A2A broadcast\n(eligibility criteria not met);
  endif
else (no)
  |Evolver Daemon|
  :Run Git Self-Repair\n(abort pending rebase/merge,\nremove stale index.lock;\nif EVOLVE_GIT_RESET=true\n→ git reset --hard origin/main);
  :Record EvolutionEvent\n(outcome: push_failed);
endif

|Evolver Daemon|
:Run Cleanup\n(delete old gep_prompt_*.json/txt,\nkeep MIN_KEEP most recent files,\nhard cap: max CLEANUP_MAX_FILES);

:Sleep until next evolution cycle\n(scheduled interval or wake signal);

stop
@enduml
