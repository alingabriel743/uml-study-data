@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title v2-evolver — Class Diagram\n(Agent Transaction Protocol + Gene Evolution Protocol)

' ─────────────────────────────────────────────
' Package: ATP — Agent Transaction Protocol
' ─────────────────────────────────────────────
package "ATP (Agent Transaction Protocol)" {

    class ConsumerAgent {
        -_initialized: boolean
        +orderService(opts): Promise
        +confirmDelivery(orderId): Promise
        +requestAiJudge(orderId): Promise
        +settle(orderId): Promise
        +dispute(orderId, reason): Promise
        +checkOrder(orderId): Promise
        +getPolicy(): Promise
        +orderAndWait(opts): Promise
        -ensureInitialized(): Promise
    }

    class MerchantAgent {
        -_running: boolean
        -_pollInterval: Interval
        +start(opts): Promise
        +stop(): void
        +isRunning(): boolean
        +getStatus(): Promise
    }

    class HubClient {
        +placeOrder(params): Promise
        +verifyDelivery(orderId, mode): Promise
        +settleOrder(orderId): Promise
        +disputeOrder(orderId, reason): Promise
        +getOrderStatus(orderId): Promise
        +getAtpPolicy(): Promise
        +submitDelivery(orderId, payload): Promise
        +getMerchantTier(): Promise
        +listProofs(params): Promise
    }

    class ServiceHelper {
        +publishService(svc): Promise
    }

    class AutoBuyer {
        +checkAndBuy(opts): Promise
        +isEnabled(): boolean
    }

    class AutoDeliver {
        +start(opts): void
        +stop(): void
        +isRunning(): boolean
    }

    class AtpTaskPickup {
        +processTask(task): Promise
        +claimAndExecute(taskId): Promise
    }

    class AtpExecute {
        +execute(opts): Promise
        +publishAndComplete(gene, capsule): Promise
    }

    class DefaultHandler {
        +handleOrder(order): Promise
        +getConfig(): object
    }

    class QuestionComposer {
        +compose(opts): string
        +buildPrompt(context): string
    }

    class HeartbeatSignalsHandler {
        +handle(signals): void
        +process(heartbeatData): object
    }
}

' ─────────────────────────────────────────────
' Package: GEP — Gene Evolution Protocol
' ─────────────────────────────────────────────
package "GEP (Gene Evolution Protocol)" {

    class AssetStore {
        -LOCK_TIMEOUT_MS: number
        +loadGenes(): Gene[]
        +loadCapsules(): Capsule[]
        +readAllEvents(): EvolutionEvent[]
        +getLastEventId(): string
        +upsertGene(gene): void
        +appendCapsule(capsule): void
        +upsertCapsule(capsule): void
        +appendEventJsonl(event): void
        +appendCandidateJsonl(candidate): void
        +appendExternalCandidateJsonl(obj): void
        +readRecentCandidates(limit): object[]
        +appendFailedCapsule(capsule): void
        +ensureAssetFiles(): void
        +withFileLock(path, fn): any
        -writeJsonAtomic(path, obj): void
        -ensureGenesSeeded(): void
    }

    class A2A {
        +isAllowedA2AAsset(obj): boolean
        +lowerConfidence(asset, opts): object
        +isBlastRadiusSafe(blastRadius): boolean
        +computeCapsuleSuccessStreak(params): number
        +isCapsuleBroadcastEligible(capsule, opts): boolean
        +exportEligibleCapsules(params): Capsule[]
        +isGeneBroadcastEligible(gene): boolean
        +exportEligibleGenes(params): Gene[]
        +parseA2AInput(text): object[]
        +readTextIfExists(filePath): string
    }

    class A2AProtocol <<obfuscated>> {
        +getNodeId(): string
        +sendHelloToHub(): Promise
        +startHeartbeat(): void
        +stopHeartbeat(): void
        +consumeAvailableWork(): object[]
        +unwrapAssetFromMessage(msg): object
    }

    class ContentHash {
        +SCHEMA_VERSION: string
        +computeAssetId(obj): string
        +hashObject(obj): string
    }

    class Analyzer {
        +analyzeFailures(): AnalysisResult
    }

    class CandidateEval {
        +evaluate(candidate): EvalResult
        +scoreCandidate(candidate, context): number
    }

    class Candidates {
        +selectCandidate(signals, genes): Candidate
        +rankCandidates(candidates): Candidate[]
    }

    class Epigenetics {
        +computeBoost(gene, events): number
        +applyEpigeneticMarks(gene, context): Gene
    }

    class Curriculum {
        +buildCurriculum(genes): CurriculumPlan
        +selectNextLesson(state): Lesson
    }

    class DirectoryClient {
        +searchServices(capabilities): Promise
        +registerNode(nodeInfo): Promise
        +lookupNode(nodeId): Promise
    }

    class FeatureFlags {
        +isEnabled(flag): boolean
        +getFlags(): object
    }

    class ExecutionTrace {
        +record(event): void
        +getTrace(): TraceEntry[]
        +summarize(): string
    }

    class ValidationReport {
        +build(results): ValidationReport
        +isSuccess(): boolean
        +toJSON(): object
    }

    class LlmReview {
        +reviewCapsule(capsule): Promise
        +scoreOutcome(outcome): number
    }
}

' ─────────────────────────────────────────────
' Package: GEP Schemas
' ─────────────────────────────────────────────
package "GEP Schemas" {

    class Gene <<entity>> {
        +type: string
        +id: string
        +category: string
        +signals_match: string[]
        +preconditions: string[]
        +strategy: string[]
        +constraints: object
        +validation: string[]
        +anti_patterns: string[]
        +schema_version: string
        +asset_id: string
    }

    class Capsule <<entity>> {
        +type: string
        +id: string
        +confidence: number
        +outcome: object
        +blast_radius: object
        +a2a: object
        +schema_version: string
        +asset_id: string
    }

    class EvolutionEvent <<entity>> {
        +type: string
        +id: string
        +capsule_id: string
        +outcome: object
        +timestamp: string
    }

    class Task <<entity>> {
        +type: string
        +task_id: string
        +title: string
        +signals: string
        +status: string
        +claimed_by: string
        +bounty_id: string
        +bounty_amount: number
        +complexity_score: number
        +expires_at: string
        +body: string
        +validation_commands: string[]
        +atp_order_id: string
        +createTask(partial): Task
        +validateTask(t): boolean
    }
}

' ─────────────────────────────────────────────
' Package: Evolve Pipeline
' ─────────────────────────────────────────────
package "Evolve Pipeline" {

    class EvolveGuards {
        +checkBlastRadius(edit): boolean
        +checkRepairLoopThreshold(events): boolean
        +isForbiddenPath(filePath): boolean
    }

    class PipelineCollect {
        +collectSignals(context): Signal[]
        +readMemory(memDir): MemoryData
        +aggregateContext(sources): Context
    }

    class PipelineSelect {
        +selectGene(signals, genes): Gene
        +applyEpigenetics(gene, history): Gene
        +buildPrompt(gene, context): string
    }

    class PipelineEnrich {
        +enrich(context, gene): EnrichedContext
        +fetchExternalContext(nodeId): Promise
    }

    class PipelineDispatch {
        +dispatch(task, gene): Promise
        +claimTask(taskId): Promise
        +submitResult(taskId, result): Promise
    }

    class PipelineHub {
        +fetchTasks(opts): Promise
        +pollForWork(interval): Promise
        +syncWithHub(): Promise
    }

    class PipelineSignals {
        +parseSignals(text): Signal[]
        +matchGeneToSignals(gene, signals): number
        +extractKeywords(content): string[]
    }

    class EvolveUtils {
        +nowIso(): string
        +safeNumber(x, fallback): number
        +buildDiff(before, after): string
    }
}

' ─────────────────────────────────────────────
' Package: Ops
' ─────────────────────────────────────────────
package "Ops" {

    class Trigger {
        -WAKE_FILE: string
        +send(): boolean
        +clear(): void
        +isPending(): boolean
    }

    class SelfRepair {
        +repair(gitRoot): string[]
    }

    class Cleanup {
        +cleanOldSessions(maxAgeMs): number
        +removeStaleFiles(dir): void
    }

    class Commentary {
        +generate(context): string
        +summarizeRun(events): string
    }

    class HealthCheck {
        +check(): HealthReport
        +isHealthy(): boolean
    }

    class Innovation {
        +suggest(context): Suggestion[]
        +applyInnovation(suggestion): Promise
    }
}

' ─────────────────────────────────────────────
' Package: Adapters
' ─────────────────────────────────────────────
package "Adapters" {

    class HookAdapter {
        +onSessionStart(context): void
        +onSessionEnd(context): void
        +onSignalDetect(signal): void
    }

    class ClaudeCodeAdapter {
        +adapt(event): AdaptedEvent
        +getHookScript(): string
    }

    class CodexAdapter {
        +adapt(event): AdaptedEvent
        +getHookScript(): string
    }

    class CursorAdapter {
        +adapt(event): AdaptedEvent
        +getHookScript(): string
    }

    class Config {
        +HELLO_TIMEOUT_MS: number
        +HEARTBEAT_INTERVAL_MS: number
        +VALIDATION_TIMEOUT_MS: number
        +BLAST_RADIUS_HARD_CAP_FILES: number
        +BLAST_RADIUS_HARD_CAP_LINES: number
        +MIN_PUBLISH_SCORE: number
        +PROMPT_MAX_CHARS: number
        +MAX_SILENCE_MS: number
        +PUBLIC_DEFAULT_HUB_URL: string
        +resolveHubUrl(): string
        +envInt(key, fallback): number
        +envFloat(key, fallback): number
        +envStr(key, fallback): string
    }
}

' ─────────────────────────────────────────────
' Relationships — ATP
' ─────────────────────────────────────────────
ConsumerAgent ..> HubClient : uses
ConsumerAgent ..> A2AProtocol : registers via
MerchantAgent ..> HubClient : submits via
MerchantAgent ..> A2AProtocol : heartbeat via
MerchantAgent ..> ServiceHelper : publishes via
AtpTaskPickup ..> HubClient : claims tasks from
AtpExecute ..> HubClient : completes orders via
AutoBuyer ..> HubClient : places orders via
AutoDeliver ..> HubClient : submits deliveries via
DefaultHandler ..> HubClient : uses
DefaultHandler ..> QuestionComposer : uses

' ─────────────────────────────────────────────
' Relationships — GEP
' ─────────────────────────────────────────────
A2A ..> AssetStore : reads events from
A2A ..> A2AProtocol : unwraps messages via
A2A ..> ContentHash : computes asset IDs via
AssetStore ..> ContentHash : computes asset IDs via
AssetStore o-- Gene : stores >
AssetStore o-- Capsule : stores >
AssetStore o-- EvolutionEvent : appends >
CandidateEval ..> Gene : evaluates
Candidates ..> Gene : selects
Candidates ..> Epigenetics : boosts via
LlmReview ..> Capsule : reviews
ValidationReport ..> Task : validates

' ─────────────────────────────────────────────
' Relationships — Evolve Pipeline
' ─────────────────────────────────────────────
PipelineSelect ..> Gene : selects
PipelineSelect ..> Candidates : uses
PipelineSelect ..> Epigenetics : applies
PipelineCollect ..> AssetStore : reads events from
PipelineDispatch ..> HubClient : dispatches tasks via
PipelineDispatch ..> Task : submits
PipelineHub ..> HubClient : fetches tasks from
PipelineSignals ..> Gene : matches signals to
EvolveGuards ..> Config : reads limits from
PipelineEnrich ..> DirectoryClient : fetches context via

' ─────────────────────────────────────────────
' Relationships — Ops
' ─────────────────────────────────────────────
SelfRepair ..> Config : reads lock threshold from
Cleanup ..> Config : reads cleanup config from
Trigger ..> Config : uses paths from

' ─────────────────────────────────────────────
' Relationships — Adapters
' ─────────────────────────────────────────────
ClaudeCodeAdapter --|> HookAdapter : implements
CodexAdapter --|> HookAdapter : implements
CursorAdapter --|> HookAdapter : implements
HookAdapter ..> PipelineCollect : triggers
HookAdapter ..> AssetStore : records events via

@enduml
