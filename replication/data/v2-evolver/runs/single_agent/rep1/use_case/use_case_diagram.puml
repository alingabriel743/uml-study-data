@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}

title v2-Evolver — Use Case Diagram

left to right direction

' ─── Actors ───────────────────────────────────────────────────────────────────
actor "Developer / Admin" as developer
actor "Consumer Agent"    as consumerAgent
actor "Merchant Agent"    as merchantAgent
actor "ATP Hub"           as hub          <<external>>
actor "Evolver Engine"    as evolver      <<autonomous>>

' ─── System Boundary ──────────────────────────────────────────────────────────
rectangle "v2-Evolver System" {

    ' ── WebUI / Observation ────────────────────────────────────────────────
    package "WebUI Monitoring" {
        usecase "View System Status"          as UC_Status
        usecase "Monitor Safety State"        as UC_Safety
        usecase "Browse Evolution Runs"       as UC_Runs
        usecase "View Assets\n(Genes, Capsules, Events)" as UC_Assets
        usecase "Track Asset Lineage"         as UC_Lineage
        usecase "View Agent Interactions"     as UC_Interactions
        usecase "View Personality &\nMemory Graph" as UC_Personality
        usecase "List Skills"                 as UC_Skills
        usecase "View Evolver Log"            as UC_Log
    }

    ' ── Self-Evolution ─────────────────────────────────────────────────────
    package "Self-Evolution Engine" {
        usecase "Trigger Evolution Cycle"     as UC_Trigger
        usecase "Generate Innovation Ideas"   as UC_Innovate
        usecase "Analyze Past Failures"       as UC_Analyze
        usecase "Perform Git Self-Repair"     as UC_Repair
        usecase "Generate Cycle Commentary"   as UC_Commentary
    }

    ' ── ATP Consumer (Buyer) ───────────────────────────────────────────────
    package "ATP Consumer (Buyer)" {
        usecase "Place Service Order"         as UC_PlaceOrder
        usecase "Verify Delivery"             as UC_Verify
        usecase "Request AI Judge"            as UC_AIJudge
        usecase "Settle Order"                as UC_Settle
        usecase "Dispute Order"               as UC_Dispute
        usecase "Check Order Status"          as UC_CheckOrder
        usecase "Get ATP Policy"              as UC_Policy
    }

    ' ── ATP Merchant (Seller) ──────────────────────────────────────────────
    package "ATP Merchant (Seller)" {
        usecase "Publish Services"            as UC_Publish
        usecase "Pick Up Assigned Tasks"      as UC_Pickup
        usecase "Process Incoming Orders"     as UC_ProcessOrder
        usecase "Submit Delivery Proof"       as UC_Deliver
        usecase "Get Merchant Tier"           as UC_Tier
    }

    ' ── A2A Asset Exchange ─────────────────────────────────────────────────
    package "A2A Asset Exchange" {
        usecase "Export Eligible Capsules"    as UC_ExportCapsules
        usecase "Export Eligible Genes"       as UC_ExportGenes
        usecase "Ingest External Assets"      as UC_IngestAssets
        usecase "Validate Blast Radius"       as UC_BlastRadius
    }
}

' ─── Developer / Admin Associations ──────────────────────────────────────────
developer --> UC_Status
developer --> UC_Safety
developer --> UC_Runs
developer --> UC_Assets
developer --> UC_Lineage
developer --> UC_Interactions
developer --> UC_Personality
developer --> UC_Skills
developer --> UC_Log
developer --> UC_Trigger

' ─── Consumer Agent Associations ─────────────────────────────────────────────
consumerAgent --> UC_PlaceOrder
consumerAgent --> UC_Verify
consumerAgent --> UC_AIJudge
consumerAgent --> UC_Settle
consumerAgent --> UC_Dispute
consumerAgent --> UC_CheckOrder
consumerAgent --> UC_Policy

' ─── Merchant Agent Associations ─────────────────────────────────────────────
merchantAgent --> UC_Publish
merchantAgent --> UC_Pickup
merchantAgent --> UC_ProcessOrder
merchantAgent --> UC_Deliver
merchantAgent --> UC_Tier

' ─── Evolver Engine Associations ─────────────────────────────────────────────
evolver --> UC_Trigger
evolver --> UC_Innovate
evolver --> UC_Analyze
evolver --> UC_Repair
evolver --> UC_Commentary
evolver --> UC_ExportCapsules
evolver --> UC_ExportGenes
evolver --> UC_IngestAssets
evolver --> UC_Pickup

' ─── ATP Hub Associations (external system) ──────────────────────────────────
hub --> UC_PlaceOrder
hub --> UC_Verify
hub --> UC_Settle
hub --> UC_Publish
hub --> UC_Deliver

' ─── Include / Extend Relationships ──────────────────────────────────────────
UC_Verify ..> UC_AIJudge      : <<extend>>
UC_ExportCapsules ..> UC_BlastRadius : <<include>>
UC_ExportGenes ..> UC_BlastRadius    : <<include>>
UC_PlaceOrder ..> UC_CheckOrder      : <<include>>
UC_ProcessOrder ..> UC_Deliver       : <<include>>
UC_Pickup ..> UC_ProcessOrder        : <<include>>

@enduml
