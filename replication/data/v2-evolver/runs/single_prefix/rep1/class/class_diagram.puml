@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title EvoMap Proxy — Class Diagram

package "Error Types" {
    class Error <<builtin>> {
    }

    class CycleTimeoutError {
        +constructor(timeoutMs, phase, cycleNum)
    }

    class AuthError {
        +constructor(message, statusCode)
    }
}

package "proxy" {
    class EvoMapProxy {
        +constructor()
        +start()
        +mailbox()
        +_getHubMailboxStatus()
        +_proxyHttp(path, body)
    }
}

package "proxy.extensions" {
    class DmHandler {
        +constructor()
        +ack(messageIds)
        +list()
        +poll()
        +send()
    }

    class SessionHandler {
        +constructor()
        +createSession()
        +delegateSubtask()
        +joinSession()
        +leaveSession()
    }

    class SkillUpdater {
        +constructor()
        +pollAndApply()
        +processSkillUpdate(message)
        +setSkillPath(filePath)
    }
}

package "proxy.lifecycle" {
    class LifecycleManager {
        +constructor()
        +_buildHeaders()
        +_dropLocalSecret(reason)
        +_emitManualResetNeeded()
        +_resolveNodeSecret()
        +_shouldUpgrade(minVersion)
    }
}

package "proxy.mailbox" {
    class MailboxStore {
        +constructor()
        +_appendMessage(msg)
        +_appendUpdate(id, fields)
        +_evictFromIndex(id)
        +_loadState()
        +_persistState()
    }
}

package "proxy.server" {
    class ProxyHttpServer {
        +constructor(routes)
        +start()
        +stop()
        +_handleRequest(req, res)
        +_matchRoute(method, pathname)
    }
}

package "proxy.sync" {
    class SyncEngine {
        +constructor()
        +_handleAuthError(source)
        +_isIdle()
        +_scheduleInbound(delayMs)
        +_scheduleOutbound(delayMs)
    }

    class InboundSync {
        +constructor()
        +ackDelivered()
        +pull()
    }

    class OutboundSync {
        +constructor()
        +flush()
    }
}

package "proxy.task" {
    class TaskMonitor {
        +constructor()
        +getHeartbeatMeta()
        +getMetrics()
        +recordClaim(taskId)
        +_restoreStats()
    }
}

package "webui.server" {
    class WebUiServer {
        +constructor()
        +start()
        +stop()
        +_handle(req, res)
    }
}

' Inheritance
CycleTimeoutError --|> Error
AuthError --|> Error

' EvoMapProxy composition
EvoMapProxy *-- MailboxStore : store
EvoMapProxy *-- LifecycleManager : lifecycle
EvoMapProxy *-- TaskMonitor : taskMonitor
EvoMapProxy *-- SkillUpdater : skillUpdater
EvoMapProxy *-- DmHandler : dmHandler
EvoMapProxy *-- SessionHandler : sessionHandler
EvoMapProxy *-- SyncEngine : sync
EvoMapProxy *-- ProxyHttpServer : server

' SyncEngine composition
SyncEngine *-- InboundSync : inbound
SyncEngine *-- OutboundSync : outbound

' Dependencies (MailboxStore used by extensions and lifecycle)
DmHandler ..> MailboxStore : uses
SessionHandler ..> MailboxStore : uses
SkillUpdater ..> MailboxStore : uses
LifecycleManager ..> MailboxStore : uses
TaskMonitor ..> MailboxStore : uses
InboundSync ..> MailboxStore : uses
OutboundSync ..> MailboxStore : uses

' Auth error dependency
SyncEngine ..> AuthError : handles
LifecycleManager ..> AuthError : throws

@enduml
