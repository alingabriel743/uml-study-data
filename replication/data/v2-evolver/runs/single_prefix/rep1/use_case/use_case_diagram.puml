@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Evolver System — Use Case Diagram

left to right direction

actor "Operator" as operator
actor "Evolver Node" as node
actor "Hub" as hub
actor "A2A Peer" as peer
actor "Web UI User" as webuser

rectangle "Evolver System" {

    package "Direct Messaging" {
        usecase "Send Direct Message" as UC_SendDM
        usecase "List Messages" as UC_ListMsg
        usecase "Poll Messages" as UC_PollMsg
        usecase "Acknowledge Messages" as UC_AckMsg
    }

    package "Session Management" {
        usecase "Create Session" as UC_CreateSession
        usecase "Join Session" as UC_JoinSession
        usecase "Send Session Message" as UC_SendSessionMsg
        usecase "Delegate Subtask" as UC_Delegate
        usecase "Submit Result" as UC_SubmitResult
    }

    package "Lifecycle & Connection" {
        usecase "Register with Hub" as UC_Hello
        usecase "Send Heartbeat" as UC_Heartbeat
        usecase "Re-authenticate" as UC_ReAuth
        usecase "Start/Stop Proxy" as UC_ProxyCtrl
    }

    package "Synchronization" {
        usecase "Pull Inbound Messages" as UC_PullInbound
        usecase "Flush Outbound Messages" as UC_FlushOutbound
        usecase "Acknowledge Delivery" as UC_AckDelivery
    }

    package "Skill Management" {
        usecase "Update Skill Definition" as UC_UpdateSkill
        usecase "Poll & Apply Skill Updates" as UC_PollSkill
        usecase "Analyze by Skill" as UC_AnalyzeSkill
    }

    package "A2A Operations" {
        usecase "Export A2A Assets" as UC_ExportA2A
        usecase "Ingest A2A Data" as UC_IngestA2A
        usecase "Promote A2A Candidate" as UC_PromoteA2A
    }

    package "Monitoring & Reporting" {
        usecase "Monitor Task Progress" as UC_MonitorTask
        usecase "Subscribe to Task Updates" as UC_SubTask
        usecase "Generate Personality Report" as UC_PersonReport
        usecase "Generate Human Report" as UC_HumanReport
        usecase "View Web Dashboard" as UC_WebUI
    }

    package "System Operations" {
        usecase "Extract Logs" as UC_ExtractLogs
        usecase "Append Evolution Event" as UC_AppendEvent
        usecase "Build Binaries" as UC_BuildBinaries
    }

}

' Operator interactions
operator --> UC_ProxyCtrl
operator --> UC_ExtractLogs
operator --> UC_AppendEvent
operator --> UC_BuildBinaries
operator --> UC_AnalyzeSkill
operator --> UC_ExportA2A
operator --> UC_IngestA2A
operator --> UC_PromoteA2A
operator --> UC_PersonReport
operator --> UC_HumanReport

' Web UI User interactions
webuser --> UC_WebUI
webuser --> UC_MonitorTask

' Evolver Node interactions
node --> UC_SendDM
node --> UC_ListMsg
node --> UC_PollMsg
node --> UC_AckMsg
node --> UC_CreateSession
node --> UC_JoinSession
node --> UC_SendSessionMsg
node --> UC_Delegate
node --> UC_SubmitResult
node --> UC_Hello
node --> UC_Heartbeat
node --> UC_ReAuth
node --> UC_PullInbound
node --> UC_FlushOutbound
node --> UC_AckDelivery
node --> UC_UpdateSkill
node --> UC_PollSkill
node --> UC_SubTask

' Hub (external system) interactions
hub --> UC_Hello
hub --> UC_Heartbeat
hub --> UC_PullInbound
hub --> UC_FlushOutbound

' A2A Peer interactions
peer --> UC_ExportA2A
peer --> UC_IngestA2A

' Include relationships
UC_Heartbeat ..> UC_Hello : <<include>>
UC_PollSkill ..> UC_UpdateSkill : <<include>>
UC_AckDelivery ..> UC_PullInbound : <<include>>
UC_ReAuth ..> UC_Hello : <<extend>>

@enduml
