@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Evolver — Class Diagram

class Error <<built-in>> {
    +message: string
    +stack: string
}

package "proxy" {

    class EvoMapProxy {
        +constructor()
        +start()
        +mailbox()
        +_proxyHttp(path, body)
        +_getHubMailboxStatus()
    }

}

package "proxy.lifecycle" {

    class AuthError {
        +constructor(message, statusCode)
    }

    class LifecycleManager {
        +constructor()
        +_buildHeaders()
        +_resolveNodeSecret()
        +_dropLocalSecret(reason)
        +_shouldUpgrade(minVersion)
        +_emitManualResetNeeded()
    }

}

package "proxy.extensions" {

    class DmHandler {
        +constructor()
        +send()
        +poll()
        +list()
        +ack(messageIds)
    }

    class SessionHandler {
        +constructor()
        +createSession()
        +joinSession()
        +leaveSession()
        +delegateSubtask()
    }

    class SkillUpdater {
        +constructor()
        +setSkillPath(filePath)
        +pollAndApply()
        +processSkillUpdate(message)
    }

}

package "proxy.mailbox" {

    class MailboxStore {
        +constructor()
        +_loadState()
        +_persistState()
        +_appendMessage(msg)
        +_appendUpdate(id, fields)
        +_evictFromIndex(id)
    }

}

package "proxy.server" {

    class ProxyHttpServer {
        +constructor(routes)
        +start()
        +stop()
        +_matchRoute(method, pathname)
        +_handleRequest(req, res)
    }

}

package "proxy.sync" {

    class SyncEngine {
        +constructor()
        +_isIdle()
        +_scheduleInbound(delayMs)
        +_scheduleOutbound(delayMs)
        +_handleAuthError(source)
    }

    class InboundSync {
        +constructor()
        +pull()
        +ackDelivered()
    }

    class OutboundSync {
        +constructor()
        +flush()
    }

}

package "proxy.task" {

    class TaskMonitor {
        +constructor()
        +_restoreStats()
        +recordClaim(taskId)
        +getHeartbeatMeta()
        +getMetrics()
    }

}

package "webui.server" {

    class WebUiServer {
        +constructor()
        +start()
        +stop()
        +_handle(req, res)
    }

}

class CycleTimeoutError {
    +constructor(timeoutMs, phase, cycleNum)
}

' Inheritance
CycleTimeoutError --|> Error : extends
AuthError --|> Error : extends

' EvoMapProxy compositions / dependencies
EvoMapProxy *-- LifecycleManager : manages lifecycle
EvoMapProxy *-- DmHandler : handles DMs
EvoMapProxy *-- SessionHandler : manages sessions
EvoMapProxy *-- SkillUpdater : updates skills
EvoMapProxy *-- MailboxStore : stores mailbox
EvoMapProxy *-- SyncEngine : drives sync
EvoMapProxy *-- TaskMonitor : monitors tasks
EvoMapProxy *-- ProxyHttpServer : serves HTTP

' SyncEngine compositions
SyncEngine *-- InboundSync : inbound
SyncEngine *-- OutboundSync : outbound
SyncEngine ..> AuthError : handles

@enduml
