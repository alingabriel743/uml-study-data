@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Evolver — AI Agent Evolution & Proxy System\nUse Case Diagram

left to right direction

actor "Local Agent / Node" as agent
actor "EvoMap Hub" as hub
actor "System Operator" as operator
actor "A2A Protocol" as a2a

rectangle "Evolver System" {

    package "Direct Messaging" {
        usecase "Send Direct Message" as UC1
        usecase "Acknowledge Messages" as UC2
        usecase "List Messages" as UC3
        usecase "Poll Messages" as UC4
    }

    package "Session Management" {
        usecase "Create Collaboration Session" as UC5
        usecase "Join Session" as UC6
        usecase "Send Session Message" as UC7
        usecase "Delegate Subtask" as UC8
        usecase "Submit Task Result" as UC9
    }

    package "Lifecycle & Authentication" {
        usecase "Authenticate with Hub" as UC10
        usecase "Maintain Heartbeat" as UC11
        usecase "Re-authenticate" as UC12
        usecase "Check Hub Mailbox Status" as UC13
    }

    package "Skill Management" {
        usecase "Poll Skill Updates" as UC14
        usecase "Apply Skill Update" as UC15
    }

    package "Synchronization" {
        usecase "Pull Inbound Messages" as UC16
        usecase "Flush Outbound Messages" as UC17
    }

    package "Task Monitoring" {
        usecase "Subscribe to Task" as UC18
        usecase "Unsubscribe from Task" as UC19
        usecase "Record Task Outcome" as UC20
    }

    package "Evolution Analysis" {
        usecase "Export A2A Asset" as UC21
        usecase "Ingest A2A Decision" as UC22
        usecase "Promote A2A Candidate" as UC23
        usecase "Analyze Skill Evolution" as UC24
        usecase "Append Evolution Event" as UC25
        usecase "Generate Personality Report" as UC26
        usecase "Generate Human Report" as UC27
    }

    package "System Management" {
        usecase "Start / Stop Proxy" as UC28
        usecase "Access Web UI" as UC29
        usecase "Build Distribution Binaries" as UC30
    }
}

' Local Agent / Node interactions
agent --> UC1
agent --> UC2
agent --> UC3
agent --> UC4
agent --> UC5
agent --> UC6
agent --> UC7
agent --> UC8
agent --> UC9
agent --> UC18
agent --> UC19
agent --> UC20

' EvoMap Hub interactions
hub --> UC13
UC16 --> hub
UC17 --> hub
UC11 --> hub

' System Operator interactions
operator --> UC28
operator --> UC29
operator --> UC30
operator --> UC24
operator --> UC25
operator --> UC26
operator --> UC27
operator --> UC10

' A2A Protocol interactions
a2a --> UC21
a2a --> UC22
a2a --> UC23

' Include / Extend relationships
UC11 .> UC10 : <<include>>
UC12 .> UC10 : <<extend>>
UC14 .> UC15 : <<include>>
UC16 .> UC2  : <<include>>

@enduml
