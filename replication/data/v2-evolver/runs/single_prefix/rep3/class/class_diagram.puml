@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Evolver — Class Diagram

class Error <<builtin>> {
}

class CycleTimeoutError {
    +constructor(timeoutMs, phase, cycleNum)
}

package "proxy" {

    class EvoMapProxy {
        -_getHubMailboxStatus()
        -_proxyHttp(path, body)
        +constructor()
        +mailbox()
        +start()
    }

    package "proxy.extensions" {
        class DmHandler {
            +constructor()
            +ack(messageIds)
            +list()
            +poll()
            +send()
        }

        class SessionHandler {
            +constructor()
            +createSession()
            +delegateSubtask()
            +joinSession()
            +leaveSession()
        }

        class SkillUpdater {
            +constructor()
            +pollAndApply()
            +processSkillUpdate(message)
            +setSkillPath(filePath)
        }
    }

    package "proxy.lifecycle" {
        class AuthError {
            +constructor(message, statusCode)
        }

        class LifecycleManager {
            -_buildHeaders()
            -_dropLocalSecret(reason)
            -_emitManualResetNeeded()
            -_resolveNodeSecret()
            -_shouldUpgrade(minVersion)
        }
    }

    package "proxy.mailbox" {
        class MailboxStore {
            -_appendMessage(msg)
            -_appendUpdate(id, fields)
            -_evictFromIndex(id)
            -_loadState()
            -_persistState()
        }
    }

    package "proxy.server" {
        class ProxyHttpServer {
            -_handleRequest(req, res)
            -_matchRoute(method, pathname)
            +constructor(routes)
            +start()
            +stop()
        }
    }

    package "proxy.sync" {
        class SyncEngine {
            -_handleAuthError(source)
            -_isIdle()
            -_scheduleInbound(delayMs)
            -_scheduleOutbound(delayMs)
            +constructor()
        }

        class InboundSync {
            +constructor()
            +ackDelivered()
            +pull()
        }

        class OutboundSync {
            +constructor()
            +flush()
        }
    }

    package "proxy.task" {
        class TaskMonitor {
            -_restoreStats()
            +constructor()
            +getHeartbeatMeta()
            +getMetrics()
            +recordClaim(taskId)
        }
    }
}

package "webui" {
    class WebUiServer {
        -_handle(req, res)
        +constructor()
        +start()
        +stop()
    }
}

' Inheritance
CycleTimeoutError --|> Error
AuthError --|> Error

' EvoMapProxy composes its subsystems
EvoMapProxy *-- MailboxStore : store
EvoMapProxy *-- LifecycleManager : lifecycle
EvoMapProxy *-- TaskMonitor : taskMonitor
EvoMapProxy *-- SkillUpdater : skillUpdater
EvoMapProxy *-- DmHandler : dmHandler
EvoMapProxy *-- SessionHandler : sessionHandler
EvoMapProxy *-- SyncEngine : sync
EvoMapProxy *-- ProxyHttpServer : server

' SyncEngine composes sync directions
SyncEngine *-- InboundSync : inbound
SyncEngine *-- OutboundSync : outbound

@enduml
