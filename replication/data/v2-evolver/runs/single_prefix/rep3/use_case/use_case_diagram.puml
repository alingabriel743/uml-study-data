@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Evolver Agent System — Use Case Diagram

left to right direction

actor "Agent Node" as agent
actor "EvoMap Hub" as hub
actor "Operator" as operator
actor "Web UI User" as webuser

rectangle "Evolver Agent System" {

    package "Direct Messaging" {
        usecase "Send Direct Message" as UC_SendDM
        usecase "Poll Incoming Messages" as UC_PollDM
        usecase "Acknowledge Messages" as UC_AckDM
        usecase "List Messages" as UC_ListDM
    }

    package "Session Management" {
        usecase "Create Collaboration Session" as UC_CreateSession
        usecase "Join Session" as UC_JoinSession
        usecase "Send Session Message" as UC_SendMsg
        usecase "Delegate Subtask" as UC_Delegate
        usecase "Submit Result" as UC_SubmitResult
    }

    package "Lifecycle & Authentication" {
        usecase "Register with Hub" as UC_Hello
        usecase "Send Heartbeat" as UC_Heartbeat
        usecase "Re-authenticate" as UC_ReAuth
        usecase "Resolve Node Secret" as UC_ResolveSecret
    }

    package "Skill Management" {
        usecase "Update Agent Skill" as UC_UpdateSkill
        usecase "Poll and Apply Skill Updates" as UC_PollSkill
    }

    package "Message Synchronization" {
        usecase "Sync Inbound Messages" as UC_SyncIn
        usecase "Sync Outbound Messages" as UC_SyncOut
    }

    package "Task Monitoring" {
        usecase "Subscribe to Task Events" as UC_Subscribe
        usecase "Record Task Progress" as UC_RecordTask
    }

    package "A2A Operations" {
        usecase "Export A2A Assets" as UC_Export
        usecase "Ingest A2A Data" as UC_Ingest
        usecase "Promote A2A Assets" as UC_Promote
    }

    package "Reporting and Analysis" {
        usecase "Analyze Evolution by Skill" as UC_Analyze
        usecase "Generate Personality Report" as UC_PersReport
        usecase "Generate Human Report" as UC_HumanReport
        usecase "Extract and Parse Logs" as UC_Logs
        usecase "Generate Recall Verify Report" as UC_RecallReport
    }

    package "Web Dashboard" {
        usecase "Access Web Dashboard" as UC_WebUI
    }

}

' Agent Node interactions
agent --> UC_SendDM
agent --> UC_PollDM
agent --> UC_AckDM
agent --> UC_ListDM
agent --> UC_CreateSession
agent --> UC_JoinSession
agent --> UC_SendMsg
agent --> UC_Delegate
agent --> UC_SubmitResult
agent --> UC_Hello
agent --> UC_Heartbeat
agent --> UC_ReAuth
agent --> UC_SyncIn
agent --> UC_SyncOut
agent --> UC_Subscribe
agent --> UC_RecordTask

' EvoMap Hub interactions
hub --> UC_SyncIn
hub --> UC_SyncOut
hub --> UC_Heartbeat

' Operator interactions
operator --> UC_Export
operator --> UC_Ingest
operator --> UC_Promote
operator --> UC_Analyze
operator --> UC_PersReport
operator --> UC_HumanReport
operator --> UC_Logs
operator --> UC_RecallReport
operator --> UC_UpdateSkill
operator --> UC_PollSkill

' Web UI User interactions
webuser --> UC_WebUI

' Include / Extend relationships
UC_Heartbeat ..> UC_Hello : <<include>>
UC_ReAuth ..> UC_Hello : <<include>>
UC_ReAuth ..> UC_ResolveSecret : <<include>>
UC_PollDM ..> UC_AckDM : <<include>>
UC_PollSkill ..> UC_UpdateSkill : <<extend>>

@enduml
