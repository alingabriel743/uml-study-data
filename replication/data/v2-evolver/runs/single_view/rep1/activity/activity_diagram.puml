@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
    StartColor #212529
    EndColor #212529
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Evolver System — Main Activity Flow

|Startup & Lifecycle|
start
:Initialize EvoMapProxy;
:LifecycleManager.hello()
(build headers, env fingerprint);

if (Authentication successful?) then (yes)
    :Start Heartbeat Loop
    (startHeartbeatLoop);
else (no)
    :reAuthenticate();
    :Emit Manual Reset Needed;
    stop
endif

|Proxy & Servers|
fork
    :Start ProxyHttpServer
    (bind HTTP routes);
fork again
    :Start WebUiServer
    (serve web UI assets);
fork again
    :Start SyncEngine
    (schedule inbound & outbound);
end fork

|Sync Engine|
:SyncEngine.start()
Schedule initial inbound pull;

repeat
    :_scheduleInbound()
    Pull messages from Hub;
    :InboundSync.pull()
    Fetch inbound batch;

    if (Auth error on pull?) then (yes)
        :_handleAuthError()
        Trigger reAuthentication;
    else (no)
        :InboundSync.ackDelivered()
        Confirm delivery to Hub;
        :Write inbound batch
        to MailboxStore;
    endif

    :_scheduleOutbound()
    Count pending outbound;

    if (Pending outbound messages?) then (yes)
        :OutboundSync.flush()
        Update status batch & push;
        :notifyNewOutbound()
        Reschedule outbound timer;
    else (no)
        :Wait for next outbound cycle;
    endif
repeat while (SyncEngine running?) is (yes)
->no;

|Request Routing|
:ProxyHttpServer._handleRequest()
Match route pattern;

if (Request type?) then (session)
    |Session Handling|
    :SessionHandler.createSession()
    Invite nodes, set max turns;

    if (Node joins session?) then (yes)
        :SessionHandler.joinSession()
        Validate role, record join;
    else (no)
        :SessionHandler.sendMessage()
        Forward message to participants;
    endif

    if (Subtask delegation needed?) then (yes)
        :SessionHandler.delegateSubtask()
        Send to target node;
    else (no)
        :SessionHandler.submitResult()
        Finalize session result;
    endif

else (direct message)
    |Mailbox & DM|
    :DmHandler.send()
    Store in MailboxStore;
    :DmHandler.poll()
    Retrieve pending messages;
    :DmHandler.ack()
    Acknowledge message IDs;

else (task)
    |Evolution Pipeline|
    :TaskMonitor.recordClaim()
    Mark task as in-progress;

    :collect()
    Gather candidates & signals;

    :detectSignals()
    Extract regex, score & LLM signals;

    :_mergeSignals()
    Combine regexSignals + scoreSignals
    + llmSignals into unified set;

    :enrich()
    Augment candidates with context;

    :buildStandardCandidates()
    Generate question/gene candidates;

    :select()
    Rank and score candidates;

    if (Gene candidate accepted?) then (yes)

        :synthesizeGene()
        Build gene from parsed skill;

        :assembleCapsule()
        Package gene + execution metadata;

        :dispatch()
        Route gene to appropriate handler;

        :publishBundleChannel()
        Publish via A2A bundle channel;

        |Hub Communication|
        :updateSkillOnHub()
        Send skill update to Hub;

        :publishSkillToHub()
        Upload gene package;

        :_publishBundle()
        Sign & POST to ATP endpoint;

        if (Hub publish successful?) then (yes)
            |Evolution Pipeline|
            :SkillUpdater.pollAndApply()
            Poll mailbox for skill updates;

            :SkillUpdater.processSkillUpdate()
            Write updated skill.md to disk;

            :TaskMonitor.recordComplete()
            Compute latency metrics;

        else (no)
            :TaskMonitor.recordFailed()
            Log failure, update state;
        endif

    else (no)
        :TaskMonitor.recordFailed()
        No viable gene candidate;
    endif
endif

|Startup & Lifecycle|
:LifecycleManager.heartbeat()
Report events, countPending,
send keepalive to Hub;

if (System shutdown requested?) then (yes)
    :EvoMapProxy.stop()
    Close HTTP servers,
    stop heartbeat loop;
    stop
else (no)
    :Continue lifecycle loop;
endif

@enduml
