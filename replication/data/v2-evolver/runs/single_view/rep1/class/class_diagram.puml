@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title EvoMap Proxy — Class Diagram

package "proxy" {

    class EvoMapProxy {
        -hubUrl: string
        -dataDir: string
        -port: number
        -_skillPath: string
        -_started: boolean
        +start(): object
        +stop(): void
        +mailbox(): MailboxStore
        +_proxyHttp(path, body): object
        +_getHubMailboxStatus(): object
    }

    package "proxy/mailbox" {
        class MailboxStore {
            +_appendMessage(msg): void
            +_appendUpdate(id, fields): void
            +_evictFromIndex(id): void
            +_loadState(): void
            +_persistState(): void
        }
    }

    package "proxy/lifecycle" {
        class LifecycleManager {
            +_buildHeaders(): object
            +_dropLocalSecret(reason): void
            +_emitManualResetNeeded(): void
            +_resolveNodeSecret(): void
            +_shouldUpgrade(minVersion): boolean
        }

        class AuthError {
            +constructor(message, statusCode)
        }
    }

    package "proxy/sync" {
        class SyncEngine {
            -_running: boolean
            -_lastActivity: number
            +constructor()
            +start(): void
            +stop(): void
            +notifyNewOutbound(): void
            +_isIdle(): boolean
            +_handleAuthError(source): void
            +_scheduleInbound(delayMs): void
            +_scheduleOutbound(delayMs): void
        }

        class InboundSync {
            +constructor()
            +pull(): object
            +ackDelivered(): void
        }

        class OutboundSync {
            +constructor()
            +flush(): object
        }
    }

    package "proxy/task" {
        class TaskMonitor {
            +constructor()
            +getHeartbeatMeta(): object
            +getMetrics(): object
            +recordClaim(taskId): void
            +_restoreStats(): void
        }
    }

    package "proxy/extensions" {
        class SkillUpdater {
            +constructor()
            +pollAndApply(): void
            +processSkillUpdate(message): void
            +setSkillPath(filePath): void
        }

        class DmHandler {
            +constructor()
            +send(): void
            +poll(): void
            +list(): void
            +ack(messageIds): void
        }

        class SessionHandler {
            +constructor()
            +createSession(): void
            +joinSession(): void
            +leaveSession(): void
            +delegateSubtask(): void
        }
    }

    package "proxy/server" {
        class ProxyHttpServer {
            +constructor(routes)
            +start(): object
            +stop(): void
            +_handleRequest(req, res): void
            +_matchRoute(method, pathname): object
        }
    }
}

package "webui/server" {
    class WebUiServer {
        +constructor()
        +start(): void
        +stop(): void
        +_handle(req, res): void
    }
}

class CycleTimeoutError {
    +constructor(timeoutMs, phase, cycleNum)
}

' EvoMapProxy composes its core components
EvoMapProxy *-- MailboxStore : store
EvoMapProxy *-- LifecycleManager : lifecycle
EvoMapProxy *-- SyncEngine : sync
EvoMapProxy *-- ProxyHttpServer : server
EvoMapProxy *-- TaskMonitor : taskMonitor
EvoMapProxy *-- SkillUpdater : skillUpdater
EvoMapProxy *-- DmHandler : dmHandler
EvoMapProxy *-- SessionHandler : sessionHandler

' SyncEngine composes sync workers
SyncEngine *-- InboundSync : inbound
SyncEngine *-- OutboundSync : outbound

' SyncEngine depends on AuthError for error handling
SyncEngine ..> AuthError : handles

' AuthError is co-located with LifecycleManager
AuthError ..> LifecycleManager : defined alongside

@enduml
