@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #343A40
    FontColor #212529
}

title Evolver Agent System — Use Case Diagram

left to right direction

actor "Node Agent" as agent
actor "ATP Hub" as hub <<external>>
actor "Developer / Operator" as dev
actor "Web UI User" as webuser

rectangle "Evolver Agent System" {

    package "Session Management" {
        usecase "Create Session" as UC_CreateSession
        usecase "Join Session" as UC_JoinSession
        usecase "Send Message" as UC_SendMessage
        usecase "Delegate Subtask" as UC_DelegateSubtask
        usecase "Submit Result" as UC_SubmitResult
    }

    package "Direct Messaging" {
        usecase "Send Direct Message" as UC_SendDM
        usecase "Poll Messages" as UC_PollMessages
        usecase "Acknowledge Messages" as UC_AckMessages
        usecase "List Messages" as UC_ListMessages
    }

    package "Service Lifecycle (ATP)" {
        usecase "Publish Service" as UC_PublishService
        usecase "Update Service" as UC_UpdateService
        usecase "Order Service" as UC_OrderService
        usecase "Resolve ATP Services" as UC_ResolveServices
        usecase "Search Services by Signals" as UC_SearchServices
    }

    package "Skill & Gene Evolution (GEP)" {
        usecase "Publish Skill to Hub" as UC_PublishSkill
        usecase "Update Skill on Hub" as UC_UpdateSkill
        usecase "Synthesize Gene" as UC_SynthesizeGene
        usecase "Run LLM Review" as UC_LlmReview
        usecase "Process Skill Updates" as UC_ProcessSkillUpdates
        usecase "Upload Encrypted Blob" as UC_UploadBlob
    }

    package "Task Management" {
        usecase "Select Best Task" as UC_SelectTask
        usecase "Estimate Capability Match" as UC_EstimateCapability
        usecase "Record Task Claim" as UC_RecordClaim
        usecase "Record Task Completion" as UC_RecordComplete
    }

    package "Proxy & Communication" {
        usecase "Start Proxy" as UC_StartProxy
        usecase "Sync Inbound Messages" as UC_SyncInbound
        usecase "Sync Outbound Messages" as UC_SyncOutbound
        usecase "Authenticate / Heartbeat" as UC_Heartbeat
        usecase "Re-authenticate Node" as UC_ReAuth
    }

    package "Monitoring & Web UI" {
        usecase "View Asset Overview" as UC_AssetOverview
        usecase "Monitor Task Status" as UC_MonitorTasks
        usecase "Auto Heal Skills" as UC_AutoHeal
        usecase "Build Report Payload" as UC_BuildReport
        usecase "Find & Report Issues" as UC_ReportIssues
    }
}

' --- Node Agent interactions ---
agent --> UC_CreateSession
agent --> UC_JoinSession
agent --> UC_SendMessage
agent --> UC_DelegateSubtask
agent --> UC_SubmitResult
agent --> UC_SendDM
agent --> UC_PollMessages
agent --> UC_AckMessages
agent --> UC_PublishService
agent --> UC_UpdateService
agent --> UC_OrderService
agent --> UC_ResolveServices
agent --> UC_PublishSkill
agent --> UC_UpdateSkill
agent --> UC_SynthesizeGene
agent --> UC_SelectTask
agent --> UC_EstimateCapability
agent --> UC_RecordClaim
agent --> UC_RecordComplete
agent --> UC_SyncInbound
agent --> UC_SyncOutbound
agent --> UC_Heartbeat

' --- ATP Hub interactions (external system) ---
UC_PublishService --> hub
UC_UpdateService --> hub
UC_SearchServices --> hub
UC_PublishSkill --> hub
UC_UpdateSkill --> hub
UC_UploadBlob --> hub
UC_SyncInbound --> hub
UC_SyncOutbound --> hub
UC_Heartbeat --> hub

' --- Developer / Operator interactions ---
dev --> UC_StartProxy
dev --> UC_AutoHeal
dev --> UC_BuildReport
dev --> UC_ReportIssues

' --- Web UI User interactions ---
webuser --> UC_AssetOverview
webuser --> UC_MonitorTasks
webuser --> UC_ListMessages

' --- Include / Extend relationships ---
UC_OrderService .> UC_ResolveServices : <<include>>
UC_SynthesizeGene .> UC_LlmReview : <<include>>
UC_PublishSkill .> UC_UploadBlob : <<include>>
UC_StartProxy .> UC_Heartbeat : <<include>>
UC_ProcessSkillUpdates .> UC_AckMessages : <<include>>
UC_ReAuth .> UC_Heartbeat : <<extend>>

@enduml
