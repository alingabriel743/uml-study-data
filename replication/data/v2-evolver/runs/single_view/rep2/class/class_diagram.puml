@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Evolver — Class Diagram

package "proxy" {
    class EvoMapProxy {
        +constructor()
        +start()
        +mailbox()
        -_getHubMailboxStatus()
        -_proxyHttp(path, body)
    }
}

package "proxy.server" {
    class ProxyHttpServer {
        +constructor(routes)
        +start()
        +stop()
        -_handleRequest(req, res)
        -_matchRoute(method, pathname)
    }
}

package "proxy.lifecycle" {
    class LifecycleManager {
        -_buildHeaders()
        -_dropLocalSecret(reason)
        -_emitManualResetNeeded()
        -_resolveNodeSecret()
        -_shouldUpgrade(minVersion)
    }

    class AuthError {
        +constructor(message, statusCode)
    }

    LifecycleManager ..> AuthError : throws
}

package "proxy.mailbox" {
    class MailboxStore {
        -_appendMessage(msg)
        -_appendUpdate(id, fields)
        -_evictFromIndex(id)
        -_loadState()
        -_persistState()
    }
}

package "proxy.sync" {
    class SyncEngine {
        +constructor()
        -_handleAuthError(source)
        -_isIdle()
        -_scheduleInbound(delayMs)
        -_scheduleOutbound(delayMs)
    }

    class InboundSync {
        +constructor()
        +ackDelivered()
        +pull()
    }

    class OutboundSync {
        +constructor()
        +flush()
    }

    SyncEngine *-- InboundSync : drives >
    SyncEngine *-- OutboundSync : drives >
    SyncEngine ..> AuthError : handles
}

package "proxy.extensions" {
    class SessionHandler {
        +constructor()
        +createSession()
        +delegateSubtask()
        +joinSession()
        +leaveSession()
    }

    class DmHandler {
        +constructor()
        +ack(messageIds)
        +list()
        +poll()
        +send()
    }

    class SkillUpdater {
        +constructor()
        +pollAndApply()
        +processSkillUpdate(message)
        +setSkillPath(filePath)
    }
}

package "proxy.task" {
    class TaskMonitor {
        +constructor()
        +getHeartbeatMeta()
        +getMetrics()
        +recordClaim(taskId)
        -_restoreStats()
    }
}

package "webui.server" {
    class WebUiServer {
        +constructor()
        +start()
        +stop()
        -_handle(req, res)
    }
}

class CycleTimeoutError {
    +constructor(timeoutMs, phase, cycleNum)
}

' Core proxy compositions
EvoMapProxy *-- SyncEngine : orchestrates >
EvoMapProxy *-- LifecycleManager : manages lifecycle >
EvoMapProxy *-- ProxyHttpServer : served via >
EvoMapProxy *-- TaskMonitor : monitors tasks via >
EvoMapProxy *-- MailboxStore : stores messages in >
EvoMapProxy o-- SessionHandler : handles sessions >
EvoMapProxy o-- DmHandler : handles DMs >
EvoMapProxy o-- SkillUpdater : updates skills >

' Sync engine reads from mailbox
SyncEngine ..> MailboxStore : reads/writes

' Timeout error used in main pipeline
EvoMapProxy ..> CycleTimeoutError : raises

@enduml
