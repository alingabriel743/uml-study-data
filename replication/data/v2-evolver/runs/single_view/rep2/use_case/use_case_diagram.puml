@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Evolver — Use Case Diagram

left to right direction

actor "AI Agent / Node" as Agent
actor "Hub" as Hub <<external>>
actor "Operator" as Operator
actor "Web UI User" as WebUser

rectangle "Evolver Agent System" {

    package "Lifecycle Management" {
        usecase "Authenticate with Hub" as UC_Auth
        usecase "Send Heartbeat" as UC_Heartbeat
        usecase "Re-authenticate" as UC_ReAuth
        usecase "Resolve Node Secret" as UC_Secret
    }

    package "Session Management" {
        usecase "Create Session" as UC_CreateSession
        usecase "Join Session" as UC_JoinSession
        usecase "Send Message" as UC_SendMessage
        usecase "Delegate Subtask" as UC_Delegate
        usecase "Submit Result" as UC_Submit
    }

    package "Direct Messaging" {
        usecase "Send Direct Message" as UC_SendDM
        usecase "Poll Messages" as UC_Poll
        usecase "Acknowledge Messages" as UC_Ack
        usecase "List Messages" as UC_List
    }

    package "Task Management" {
        usecase "Monitor Tasks" as UC_Monitor
        usecase "Claim Task" as UC_Claim
        usecase "Complete Task" as UC_Complete
        usecase "Subscribe to Task Events" as UC_Subscribe
    }

    package "Skill & Gene Management" {
        usecase "Publish Skill to Hub" as UC_PublishSkill
        usecase "Update Skill on Hub" as UC_UpdateSkill
        usecase "Search Skills by Signals" as UC_SearchSkill
        usecase "Process Skill Update" as UC_ProcessSkill
        usecase "Synthesize Gene" as UC_SynthGene
        usecase "Run LLM Review" as UC_LlmReview
        usecase "Auto-heal Skills" as UC_AutoHeal
    }

    package "Service (ATP)" {
        usecase "Order Service" as UC_Order
        usecase "Publish Service" as UC_PublishSvc
        usecase "Update Service" as UC_UpdateSvc
        usecase "Resolve ATP Services" as UC_Resolve
    }

    package "Evolution Pipeline" {
        usecase "Collect Pipeline Data" as UC_Collect
        usecase "Enrich Pipeline Data" as UC_Enrich
        usecase "Select Candidates" as UC_Select
        usecase "Run Validation in Sandbox" as UC_Sandbox
        usecase "Build Validation Report" as UC_Report
    }

    package "Web UI" {
        usecase "View Asset Overview" as UC_Assets
        usecase "View Pipeline Status" as UC_Pipeline
        usecase "Monitor Memory Graph" as UC_Memory
    }

    package "Security & Privacy" {
        usecase "Upload Encrypted Blob" as UC_Encrypt
        usecase "Sync Inbound Messages" as UC_SyncIn
        usecase "Sync Outbound Messages" as UC_SyncOut
    }
}

' --- AI Agent / Node ---
Agent --> UC_Auth
Agent --> UC_Heartbeat
Agent --> UC_ReAuth
Agent --> UC_CreateSession
Agent --> UC_JoinSession
Agent --> UC_SendMessage
Agent --> UC_Delegate
Agent --> UC_Submit
Agent --> UC_SendDM
Agent --> UC_Poll
Agent --> UC_Ack
Agent --> UC_List
Agent --> UC_Claim
Agent --> UC_Complete
Agent --> UC_Subscribe
Agent --> UC_Order
Agent --> UC_Resolve
Agent --> UC_Collect
Agent --> UC_Enrich
Agent --> UC_Select
Agent --> UC_Encrypt
Agent --> UC_SyncIn
Agent --> UC_SyncOut

' --- Hub (external system) ---
Hub --> UC_PublishSkill
Hub --> UC_UpdateSkill
Hub --> UC_SearchSkill
Hub --> UC_PublishSvc
Hub --> UC_UpdateSvc
Hub --> UC_ProcessSkill

' --- Operator ---
Operator --> UC_Monitor
Operator --> UC_AutoHeal
Operator --> UC_LlmReview
Operator --> UC_SynthGene
Operator --> UC_Sandbox
Operator --> UC_Report
Operator --> UC_Secret

' --- Web UI User ---
WebUser --> UC_Assets
WebUser --> UC_Pipeline
WebUser --> UC_Memory

' --- Include / Extend ---
UC_Heartbeat ..> UC_Auth : <<include>>
UC_ReAuth ..> UC_Auth : <<extend>>
UC_SynthGene ..> UC_LlmReview : <<include>>
UC_Sandbox ..> UC_Report : <<include>>
UC_SyncIn ..> UC_Ack : <<include>>
UC_ProcessSkill ..> UC_UpdateSkill : <<include>>

@enduml
