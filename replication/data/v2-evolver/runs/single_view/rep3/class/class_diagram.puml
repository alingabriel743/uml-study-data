@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Evolver — Class Diagram

package "proxy" {

    class EvoMapProxy {
        -hubUrl: String
        -dataDir: String
        -port: Number
        -_started: Boolean
        +start(): Object
        +stop(): void
        +mailbox(): MailboxStore
        +_proxyHttp(path, body): Promise
        +_getHubMailboxStatus(): Promise
    }

    package "proxy.mailbox" {
        class MailboxStore {
            +_appendMessage(msg): void
            +_appendUpdate(id, fields): void
            +_evictFromIndex(id): void
            +_loadState(): void
            +_persistState(): void
        }
    }

    package "proxy.lifecycle" {
        class LifecycleManager {
            +_buildHeaders(): Object
            +_dropLocalSecret(reason): void
            +_emitManualResetNeeded(): void
            +_resolveNodeSecret(): void
            +_shouldUpgrade(minVersion): Boolean
        }

        class AuthError {
            +constructor(message, statusCode)
        }
    }

    package "proxy.sync" {
        class SyncEngine {
            -store: MailboxStore
            -hubUrl: String
            -_running: Boolean
            -_lastActivity: Number
            +start(): void
            +stop(): void
            +notifyNewOutbound(): void
            +_isIdle(): Boolean
            +_handleAuthError(source): Promise
            +_scheduleInbound(delayMs): void
            +_scheduleOutbound(delayMs): void
        }

        class InboundSync {
            +constructor()
            +pull(): Promise
            +ackDelivered(): Promise
        }

        class OutboundSync {
            +constructor()
            +flush(): Promise
        }
    }

    package "proxy.task" {
        class TaskMonitor {
            +constructor()
            +getHeartbeatMeta(): Object
            +getMetrics(): Object
            +recordClaim(taskId): void
            +_restoreStats(): void
        }
    }

    package "proxy.extensions" {
        class SessionHandler {
            +constructor()
            +createSession(): Promise
            +joinSession(): Promise
            +leaveSession(): Promise
            +delegateSubtask(): Promise
        }

        class DmHandler {
            +constructor()
            +send(): Promise
            +poll(): Promise
            +list(): Promise
            +ack(messageIds): Promise
        }

        class SkillUpdater {
            +constructor()
            +pollAndApply(): Promise
            +processSkillUpdate(message): void
            +setSkillPath(filePath): void
        }
    }

    package "proxy.server" {
        class ProxyHttpServer {
            +constructor(routes)
            +start(): Promise
            +stop(): Promise
            +_handleRequest(req, res): void
            +_matchRoute(method, pathname): Object
        }
    }

}

package "webui" {
    class WebUiServer {
        +constructor()
        +start(): Promise
        +stop(): Promise
        +_handle(req, res): void
    }
}

class Error <<built-in>> {
}

class CycleTimeoutError {
    +constructor(timeoutMs, phase, cycleNum)
}

' Inheritance
AuthError --|> Error : extends
CycleTimeoutError --|> Error : extends

' EvoMapProxy compositions
EvoMapProxy *-- MailboxStore : store
EvoMapProxy *-- LifecycleManager : lifecycle
EvoMapProxy *-- SyncEngine : sync
EvoMapProxy *-- TaskMonitor : taskMonitor
EvoMapProxy *-- SkillUpdater : skillUpdater
EvoMapProxy *-- DmHandler : dmHandler
EvoMapProxy *-- SessionHandler : sessionHandler
EvoMapProxy *-- ProxyHttpServer : server

' SyncEngine compositions
SyncEngine *-- InboundSync : inbound
SyncEngine *-- OutboundSync : outbound
SyncEngine ..> AuthError : handles

' Shared MailboxStore dependency
SyncEngine ..> MailboxStore : uses
TaskMonitor ..> MailboxStore : uses
SkillUpdater ..> MailboxStore : uses
DmHandler ..> MailboxStore : uses
SessionHandler ..> MailboxStore : uses

@enduml
