@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

left to right direction

title Evolver — Use Case Diagram

actor "Evolver Node" as node
actor "Hub" as hub
actor "Web UI User" as webuser
actor "Operator" as operator
actor "GitHub" as github

rectangle "Evolver System" {

    package "Session & Collaboration" {
        usecase "Create Session" as UC_CreateSession
        usecase "Join Session" as UC_JoinSession
        usecase "Send Message" as UC_SendMessage
        usecase "Delegate Subtask" as UC_DelegateSubtask
        usecase "Submit Result" as UC_SubmitResult
    }

    package "Direct Messaging" {
        usecase "Send Direct Message" as UC_SendDM
        usecase "Acknowledge Message" as UC_AckMessage
        usecase "Poll Messages" as UC_PollMessages
        usecase "List Messages" as UC_ListMessages
    }

    package "Service Management (ATP)" {
        usecase "Publish Service" as UC_PublishService
        usecase "Update Service" as UC_UpdateService
        usecase "Order Service" as UC_OrderService
        usecase "Resolve ATP Services" as UC_ResolveATP
        usecase "Search Services by Signals" as UC_SearchSignals
    }

    package "Skill & Gene Evolution (GEP)" {
        usecase "Publish Skill to Hub" as UC_PublishSkill
        usecase "Update Skill on Hub" as UC_UpdateSkill
        usecase "Synthesize Gene" as UC_SynthesizeGene
        usecase "Run LLM Review" as UC_LLMReview
        usecase "Build Signal Candidates" as UC_BuildCandidates
        usecase "Publish Bundle Channel" as UC_PublishBundle
    }

    package "Node Lifecycle" {
        usecase "Authenticate Node" as UC_Auth
        usecase "Send Heartbeat" as UC_Heartbeat
        usecase "Re-Authenticate" as UC_ReAuth
    }

    package "Synchronization" {
        usecase "Sync Inbound Messages" as UC_SyncInbound
        usecase "Sync Outbound Messages" as UC_SyncOutbound
    }

    package "Task Management" {
        usecase "Select Best Task" as UC_SelectTask
        usecase "Estimate Capability Match" as UC_EstCapability
        usecase "Record Task Metrics" as UC_TaskMetrics
        usecase "Monitor Task Status" as UC_MonitorTask
    }

    package "Web UI Monitoring" {
        usecase "View Asset Overview" as UC_AssetOverview
        usecase "View Memory Graph" as UC_MemoryGraph
        usecase "View Pipeline Status" as UC_PipelineStatus
    }

    package "Operations & Security" {
        usecase "Upload Encrypted Blob" as UC_UploadBlob
        usecase "Auto Heal Skills" as UC_AutoHeal
        usecase "Run Sandbox Execution" as UC_Sandbox
        usecase "Report Issue" as UC_ReportIssue
    }
}

' Evolver Node interactions
node --> UC_CreateSession
node --> UC_JoinSession
node --> UC_SendMessage
node --> UC_DelegateSubtask
node --> UC_SubmitResult
node --> UC_SendDM
node --> UC_AckMessage
node --> UC_PollMessages
node --> UC_ListMessages
node --> UC_PublishService
node --> UC_UpdateService
node --> UC_OrderService
node --> UC_ResolveATP
node --> UC_SearchSignals
node --> UC_PublishSkill
node --> UC_UpdateSkill
node --> UC_SynthesizeGene
node --> UC_LLMReview
node --> UC_BuildCandidates
node --> UC_PublishBundle
node --> UC_Auth
node --> UC_Heartbeat
node --> UC_ReAuth
node --> UC_SyncInbound
node --> UC_SyncOutbound
node --> UC_SelectTask
node --> UC_EstCapability
node --> UC_TaskMetrics
node --> UC_UploadBlob
node --> UC_Sandbox
node --> UC_ReportIssue

' Hub interactions
hub --> UC_PublishService
hub --> UC_UpdateService
hub --> UC_SearchSignals
hub --> UC_Auth
hub --> UC_SyncInbound
hub --> UC_SyncOutbound

' Web UI User interactions
webuser --> UC_AssetOverview
webuser --> UC_MemoryGraph
webuser --> UC_PipelineStatus
webuser --> UC_MonitorTask

' Operator interactions
operator --> UC_AutoHeal
operator --> UC_Sandbox
operator --> UC_MonitorTask

' GitHub external system
github --> UC_ReportIssue

' Include / Extend relationships
UC_ReAuth .> UC_Auth : <<include>>
UC_Heartbeat .> UC_Auth : <<include>>
UC_EstCapability .> UC_SelectTask : <<include>>
UC_TaskMetrics .> UC_MonitorTask : <<include>>
UC_AutoHeal .> UC_Sandbox : <<extend>>

@enduml
