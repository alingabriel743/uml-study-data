@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title EvoMap Proxy — Class Diagram

package "proxy" {
  class EvoMapProxy {
    -hubUrl: string
    -dataDir: string
    -port: number
    -logger: object
    -_skillPath: string
    -store: MailboxStore
    -server: ProxyHttpServer
    -sync: SyncEngine
    -lifecycle: LifecycleManager
    -taskMonitor: TaskMonitor
    -skillUpdater: SkillUpdater
    -dmHandler: DmHandler
    -sessionHandler: SessionHandler
    -_started: boolean
    +start(): Promise<{url, port, nodeId}>
    +stop(): Promise<void>
    +mailbox: MailboxStore <<getter>>
    -_proxyHttp(path, body): Promise<object>
    -_getHubMailboxStatus(): Promise<object>
  }
}

package "proxy.mailbox" {
  class MailboxStore {
    -dataDir: string
    -_messagesFile: string
    -_stateFile: string
    -_messages: Map
    -_outbound: Array
    -_inbound: Array
    -_state: object
    -_loadState(): void
    -_persistState(): void
    -_appendMessage(msg): void
    -_appendUpdate(id, fields): void
    -_evictFromIndex(id): void
    +send(opts): {message_id, status}
    +writeInbound(opts): string
    +writeInboundBatch(messages): string[]
    +getById(id): object
    +poll(opts): object[]
    +pollOutbound(opts): object[]
    +ack(messageIds): number
    +updateStatus(id, status, opts): void
    +updateStatusBatch(updates): void
    +incrementRetry(id, error): void
    +list(opts): object[]
    +countPending(opts): number
    +getCursor(key): string
    +setCursor(key, value): void
    +getState(key): string
    +setState(key, value): void
    +compact(): void
    +close(): void
  }
}

package "proxy.lifecycle" {
  class LifecycleManager {
    -hubUrl: string
    -store: MailboxStore
    -logger: object
    -getTaskMeta: Function
    -_heartbeatTimer: Timer
    -_running: boolean
    -_consecutiveFailures: number
    -_reauthInProgress: boolean
    -_suppressEnvSecret: boolean
    +nodeId: string <<getter>>
    +nodeSecret: string <<getter>>
    -_resolveNodeSecret(): string
    +_buildHeaders(): object
    +hello(opts): Promise<object>
    +reAuthenticate(): Promise<boolean>
    +heartbeat(opts): Promise<object>
    +startHeartbeatLoop(intervalMs): void
    +stopHeartbeatLoop(): void
    -_dropLocalSecret(reason): void
    -_emitManualResetNeeded(): void
    -_shouldUpgrade(minVersion): boolean
  }

  class AuthError {
    +name: string
    +statusCode: number
    +constructor(message, statusCode)
  }
}

package "proxy.sync" {
  class SyncEngine {
    -store: MailboxStore
    -hubUrl: string
    -logger: object
    -getHeaders: Function
    -onInboundReceived: Function
    -onAuthError: Function
    -outbound: OutboundSync
    -inbound: InboundSync
    -_outTimer: Timer
    -_inTimer: Timer
    -_running: boolean
    -_lastActivity: number
    +start(): void
    +stop(): void
    +notifyNewOutbound(): void
    -_isIdle(): boolean
    -_handleAuthError(source): Promise<void>
    -_scheduleOutbound(delayMs): void
    -_scheduleInbound(delayMs): void
  }

  class InboundSync {
    -store: MailboxStore
    -hubUrl: string
    -logger: object
    -getHeaders: Function
    +pull(channel, limit): Promise<object>
    +ackDelivered(channel): Promise<object>
  }

  class OutboundSync {
    -store: MailboxStore
    -hubUrl: string
    -logger: object
    -getHeaders: Function
    +flush(channel): Promise<object>
  }
}

package "proxy.server" {
  class ProxyHttpServer {
    -routes: object
    -basePort: number
    -actualPort: number
    -logger: object
    -server: http.Server
    -token: string
    +start(): Promise<{port, url, token}>
    +stop(): Promise<void>
    -_handleRequest(req, res): Promise<void>
    -_matchRoute(method, pathname): object
  }
}

package "proxy.task" {
  class TaskMonitor {
    -store: MailboxStore
    -logger: object
    -_stats: object
    +subscribed: boolean <<getter>>
    +subscribe(filters): object
    +unsubscribe(): object
    +recordClaim(taskId): void
    +recordComplete(taskId, startedAt): void
    +recordFailed(taskId): void
    +recordTaskReceived(count): void
    +getMetrics(): object
    +getHeartbeatMeta(): object
    -_restoreStats(): void
  }
}

package "proxy.extensions" {
  class SessionHandler {
    -store: MailboxStore
    -logger: object
    +createSession(opts): object
    +joinSession(opts): object
    +leaveSession(opts): object
    +sendMessage(opts): object
    +delegateSubtask(opts): object
    +submitResult(opts): object
    +pollInvites(opts): object[]
    +pollSessionEvents(opts): object[]
    +listActiveSessions(): object[]
  }

  class DmHandler {
    -store: MailboxStore
    -logger: object
    +send(opts): object
    +poll(opts): object[]
    +ack(messageIds): number
    +list(opts): object[]
  }

  class SkillUpdater {
    -store: MailboxStore
    -skillPath: string
    -logger: object
    +setSkillPath(filePath): void
    +processSkillUpdate(message): boolean
    +pollAndApply(): number
  }
}

package "webui.server" {
  class WebUiServer {
    -port: number
    -logger: object
    -routes: object
    -server: http.Server
    -actualPort: number
    +start(): Promise<{port, url}>
    +stop(): Promise<void>
    -_handle(req, res): Promise<void>
  }
}

package "core" {
  class CycleTimeoutError {
    +timeoutMs: number
    +phase: string
    +cycleNum: number
    +constructor(timeoutMs, phase, cycleNum)
  }
}

' === Inheritance ===
AuthError --|> Error
CycleTimeoutError --|> Error

' === Composition: EvoMapProxy creates & owns all subsystems ===
EvoMapProxy *-- MailboxStore : store
EvoMapProxy *-- LifecycleManager : lifecycle
EvoMapProxy *-- SyncEngine : sync
EvoMapProxy *-- ProxyHttpServer : server
EvoMapProxy *-- TaskMonitor : taskMonitor
EvoMapProxy *-- SkillUpdater : skillUpdater
EvoMapProxy *-- DmHandler : dmHandler
EvoMapProxy *-- SessionHandler : sessionHandler

' === Composition: SyncEngine owns In/Outbound ===
SyncEngine *-- InboundSync : inbound
SyncEngine *-- OutboundSync : outbound

' === Dependencies: components use MailboxStore (injected) ===
LifecycleManager ..> MailboxStore : reads/writes state
TaskMonitor ..> MailboxStore : reads/writes stats
SessionHandler ..> MailboxStore : sends messages
DmHandler ..> MailboxStore : sends/polls messages
SkillUpdater ..> MailboxStore : polls/acks updates
InboundSync ..> MailboxStore : writes inbound
OutboundSync ..> MailboxStore : reads outbound

' === Dependencies: sync uses AuthError ===
SyncEngine ..> AuthError : catches
InboundSync ..> AuthError : throws
OutboundSync ..> AuthError : throws
LifecycleManager ..> AuthError : defines

' === Hidden Error base class (for layout) ===
hide Error
class Error <<built-in>>

@enduml
