@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #FAFBFC
    BorderColor #495057
    FontColor #212529
}

title Use Case Diagram — Evolver Node System

left to right direction

actor "Node Operator" as operator
actor "Remote Node" as remoteNode
actor "Hub Service" as hub
actor "LLM Service" as llm

rectangle "Evolver Node" {

    package "Node Lifecycle" {
        usecase "Start / Stop Proxy" as UC_StartStop
        usecase "Register with Hub" as UC_Register
        usecase "Maintain Heartbeat" as UC_Heartbeat
    }

    package "Mailbox & Synchronization" {
        usecase "Send Mailbox Message" as UC_SendMailbox
        usecase "Poll Mailbox" as UC_PollMailbox
        usecase "Synchronize Messages\nwith Hub" as UC_Sync
    }

    package "Session Collaboration" {
        usecase "Create Session" as UC_CreateSession
        usecase "Join Session" as UC_JoinSession
        usecase "Send Session Message" as UC_SessionMsg
        usecase "Delegate Subtask" as UC_Delegate
        usecase "Submit Task Result" as UC_SubmitResult
    }

    package "ATP Service Trading" {
        usecase "Publish Service Listing" as UC_PublishSvc
        usecase "Order Service" as UC_OrderSvc
        usecase "Verify & Settle Delivery" as UC_VerifySettle
        usecase "Dispute Order" as UC_Dispute
    }

    package "Task Management" {
        usecase "Subscribe to Tasks" as UC_SubTasks
        usecase "Claim Task" as UC_ClaimTask
        usecase "Monitor Task Metrics" as UC_MonitorTask
    }

    package "Evolution Pipeline" {
        usecase "Run Evolution Cycle" as UC_Evolve
        usecase "Synthesize Gene" as UC_SynthGene
        usecase "Publish Skill to Hub" as UC_PublishSkill
        usecase "Validate in Sandbox" as UC_Sandbox
        usecase "Run LLM Review" as UC_LLMReview
    }

    package "Web Dashboard" {
        usecase "View Node Status" as UC_ViewStatus
        usecase "Browse Evolution Runs" as UC_BrowseRuns
        usecase "View Asset Overview" as UC_ViewAssets
        usecase "View Memory Graph" as UC_MemGraph
    }

    package "Self-Maintenance" {
        usecase "Auto-heal Skills" as UC_AutoHeal
        usecase "Self-repair Node" as UC_SelfRepair
    }
}

' ── Node Operator interactions ──
operator --> UC_StartStop
operator --> UC_Evolve
operator --> UC_ViewStatus
operator --> UC_BrowseRuns
operator --> UC_ViewAssets
operator --> UC_MemGraph
operator --> UC_MonitorTask
operator --> UC_AutoHeal
operator --> UC_SelfRepair

' ── Remote Node interactions ──
remoteNode --> UC_CreateSession
remoteNode --> UC_JoinSession
remoteNode --> UC_SessionMsg
remoteNode --> UC_Delegate
remoteNode --> UC_SubmitResult
remoteNode --> UC_SendMailbox
remoteNode --> UC_OrderSvc

' ── Hub Service interactions ──
hub --> UC_Register
hub --> UC_Heartbeat
hub --> UC_Sync
hub --> UC_PublishSvc
hub --> UC_SubTasks
hub --> UC_PublishSkill
hub --> UC_VerifySettle

' ── LLM Service interactions ──
llm --> UC_LLMReview

' ── Include relationships ──
UC_StartStop ..> UC_Register : <<include>>
UC_Register ..> UC_Heartbeat : <<include>>
UC_Evolve ..> UC_SynthGene : <<include>>
UC_Evolve ..> UC_Sandbox : <<include>>
UC_OrderSvc ..> UC_VerifySettle : <<include>>
UC_SubTasks ..> UC_ClaimTask : <<include>>
UC_PollMailbox ..> UC_Sync : <<include>>

' ── Extend relationships ──
UC_LLMReview ..> UC_Evolve : <<extend>>
UC_PublishSkill ..> UC_Evolve : <<extend>>
UC_Dispute ..> UC_VerifySettle : <<extend>>
UC_AutoHeal ..> UC_Evolve : <<extend>>

@enduml
