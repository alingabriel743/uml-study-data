@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Evolver Main Workflow - Activity Diagram

|Main Process|
start
:Initialize System;
:Start Auto Distillation;

|Lifecycle Manager|
:Execute hello handshake;
:Authenticate with hub;
if (Authentication successful?) then (yes)
    :Start heartbeat loop;
else (no)
    :Emit manual reset needed;
    stop
endif

|Sync Engine|
fork
    :Schedule inbound sync;
    repeat
        :Pull messages from hub;
        :Write inbound batch to store;
        :Acknowledge delivered messages;
    repeat while (More messages?)
fork again
    :Schedule outbound sync;
    repeat
        :Count pending messages;
        if (Has pending messages?) then (yes)
            :Flush outbound queue;
            :Update status batch;
        endif
    repeat while (Sync running?)
end fork

|Session Handler|
if (New session request?) then (yes)
    :Create session;
    :Send session invite;

    fork
        :Handle incoming messages;
        :Send message to participants;
    fork again
        :Receive subtask delegation;
        :Delegate to appropriate node;
    fork again
        :Submit task results;
        :Record completion;
    end fork
endif

|Signal Detection|
if (New event detected?) then (yes)
    :Extract error context;
    :Detect signals via regex;
    :Detect signals via scoring;
    :Merge signal results;
    :Log pipeline event;

    if (Signals found?) then (yes)
        :Build standard candidates;
        :Generate question;
    endif
endif

|Skill Publishing|
if (Skill ready to publish?) then (yes)
    :Synthesize gene from parsed skill;
    :Assemble capsule with execution data;

    fork
        :Publish skill to hub;
        :Update skill on hub with content;
    fork again
        :Publish bundle to channel;
        :Create HMAC signature;
        :POST bundle to ATP endpoint;
    end fork

    if (Publishing successful?) then (yes)
        :Record skill update;
    else (no)
        :Log error;
    endif
endif

|Task Execution|
if (Order received?) then (yes)
    :Ensure system initialized;
    :Resolve ATP services;
    :Execute default order handler;
    :Estimate capability match;

    if (Match found?) then (yes)
        :Run task in sandbox;
        :Build report payload;
        if (Has issues?) then (yes)
            :Find existing issue;
            if (New issue?) then (yes)
                :Auto heal skill;
            endif
        endif
        :Record task complete;
    else (no)
        :Record task failed;
    endif
endif

|Web UI Server|
if (HTTP request received?) then (yes)
    :Match route;
    :Handle request;
    :Build response;
    :Send JSON response;
endif

|Main Process|
:Complete distillation cycle;
if (Should continue?) then (yes)
    :Clear interval;
    backward :Restart distillation;
else (no)
    stop
endif

@enduml
