@startuml
title v2-evolver Class Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

package "proxy" {
    class EvoMapProxy {
        +constructor()
        +start()
        +mailbox()
        +_proxyHttp(path, body)
        +_getHubMailboxStatus()
    }

    package "mailbox" {
        class MailboxStore {
            +_loadState()
            +_persistState()
            +_appendMessage(msg)
            +_appendUpdate(id, fields)
            +_evictFromIndex(id)
        }
    }

    package "lifecycle" {
        class LifecycleManager {
            +_buildHeaders()
            +_resolveNodeSecret()
            +_shouldUpgrade(minVersion)
            +_dropLocalSecret(reason)
            +_emitManualResetNeeded()
        }

        class AuthError {
            +constructor(message, statusCode)
        }
    }

    package "extensions" {
        class SessionHandler {
            +constructor()
            +createSession()
            +joinSession()
            +leaveSession()
            +delegateSubtask()
        }

        class DmHandler {
            +constructor()
            +send()
            +list()
            +poll()
            +ack(messageIds)
        }

        class SkillUpdater {
            +constructor()
            +setSkillPath(filePath)
            +pollAndApply()
            +processSkillUpdate(message)
        }
    }

    package "task" {
        class TaskMonitor {
            +constructor()
            +recordClaim(taskId)
            +getMetrics()
            +getHeartbeatMeta()
            +_restoreStats()
        }
    }

    package "sync" {
        class SyncEngine {
            +constructor()
            +_scheduleInbound(delayMs)
            +_scheduleOutbound(delayMs)
            +_handleAuthError(source)
            +_isIdle()
        }

        class InboundSync {
            +constructor()
            +pull()
            +ackDelivered()
        }

        class OutboundSync {
            +constructor()
            +flush()
        }
    }

    package "server" {
        class ProxyHttpServer {
            +constructor(routes)
            +start()
            +stop()
            +_handleRequest(req, res)
            +_matchRoute(method, pathname)
        }
    }
}

package "webui.server" {
    class WebUiServer {
        +constructor()
        +start()
        +stop()
        +_handle(req, res)
    }
}

package "root" {
    class CycleTimeoutError {
        +constructor(timeoutMs, phase, cycleNum)
    }
}

' Relationships
EvoMapProxy *-- MailboxStore : contains
EvoMapProxy *-- LifecycleManager : contains
EvoMapProxy *-- SyncEngine : contains
EvoMapProxy o-- ProxyHttpServer : uses

SyncEngine *-- InboundSync : manages
SyncEngine *-- OutboundSync : manages
SyncEngine ..> AuthError : throws

LifecycleManager ..> AuthError : throws

EvoMapProxy o-- SessionHandler : uses
EvoMapProxy o-- DmHandler : uses
EvoMapProxy o-- SkillUpdater : uses
EvoMapProxy o-- TaskMonitor : uses

ProxyHttpServer ..> EvoMapProxy : routes to

@enduml
