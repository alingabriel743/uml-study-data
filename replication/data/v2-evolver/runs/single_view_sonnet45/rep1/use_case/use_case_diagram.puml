@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Evolver System - Use Case Diagram

left to right direction

' Define actors
actor "Developer" as dev
actor "Task Consumer" as consumer
actor "Hub Service" as hub
actor "Skill Publisher" as publisher
actor "External System" as external

rectangle "Evolver System" {

    ' Session Management
    package "Session Management" {
        usecase "Create Session" as UC1
        usecase "Join Session" as UC2
        usecase "Send Message" as UC3
        usecase "Delegate Subtask" as UC4
        usecase "Submit Result" as UC5
    }

    ' Task Management
    package "Task Management" {
        usecase "Order Service" as UC6
        usecase "Select Best Task" as UC7
        usecase "Monitor Tasks" as UC8
        usecase "Record Task Status" as UC9
    }

    ' Skill Management
    package "Skill Management" {
        usecase "Publish Skill" as UC10
        usecase "Update Skill" as UC11
        usecase "Auto Heal Skills" as UC12
        usecase "Distill Knowledge" as UC13
    }

    ' Service Management
    package "Service Management" {
        usecase "Publish Service" as UC14
        usecase "Update Service" as UC15
        usecase "Search Services" as UC16
        usecase "Resolve ATP Services" as UC17
    }

    ' Gene & Learning
    package "Gene Evolution" {
        usecase "Synthesize Gene" as UC18
        usecase "Build Candidates" as UC19
        usecase "Run LLM Review" as UC20
        usecase "Process Signals" as UC21
    }

    ' Data Synchronization
    package "Data Synchronization" {
        usecase "Pull Inbound Messages" as UC22
        usecase "Flush Outbound Messages" as UC23
        usecase "Acknowledge Delivery" as UC24
        usecase "Manage Mailbox" as UC25
    }

    ' System Monitoring
    package "System Monitoring" {
        usecase "View Asset Overview" as UC26
        usecase "Get Memory Graph" as UC27
        usecase "Check System Status" as UC28
        usecase "View Pipeline Events" as UC29
    }

    ' Privacy & Security
    package "Privacy & Security" {
        usecase "Upload Encrypted Data" as UC30
        usecase "Authenticate Node" as UC31
        usecase "Manage Lifecycle" as UC32
    }
}

' Actor relationships

' Developer interactions
dev --> UC1
dev --> UC2
dev --> UC3
dev --> UC26
dev --> UC27
dev --> UC28
dev --> UC29

' Task Consumer interactions
consumer --> UC6
consumer --> UC7
consumer --> UC4

' Skill Publisher interactions
publisher --> UC10
publisher --> UC11
publisher --> UC13

' Hub Service interactions
hub --> UC14
hub --> UC15
hub --> UC16
hub --> UC17
UC22 --> hub
UC23 --> hub

' External System interactions
external --> UC12

' Use case relationships

' Session dependencies
UC4 ..> UC3 : <<include>>
UC5 ..> UC3 : <<include>>

' Task management dependencies
UC9 ..> UC8 : <<include>>
UC7 ..> UC9 : <<include>>

' Skill management dependencies
UC11 ..> UC10 : <<extend>>
UC12 ..> UC11 : <<include>>

' Service management dependencies
UC15 ..> UC14 : <<extend>>
UC17 ..> UC16 : <<include>>

' Gene evolution dependencies
UC18 ..> UC19 : <<include>>
UC18 ..> UC21 : <<include>>
UC20 ..> UC19 : <<extend>>

' Synchronization dependencies
UC24 ..> UC22 : <<include>>
UC23 ..> UC25 : <<include>>
UC22 ..> UC25 : <<include>>

' Monitoring dependencies
UC26 ..> UC29 : <<include>>

' Security dependencies
UC31 ..> UC32 : <<include>>
UC22 ..> UC31 : <<include>>
UC23 ..> UC31 : <<include>>

@enduml
