@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Cosmos Predict1 — Class Diagram

' =============================================
' EXTERNAL BASE CLASSES
' =============================================
package "PyTorch (External)" <<frame>> {
    abstract class "nn.Module" as NNModule {
        +forward(): Tensor
        +parameters(): Iterator
        +state_dict(): dict
        +load_state_dict(state_dict): void
    }
}

' =============================================
' CORE UTILS
' =============================================
package "cosmos_predict1.utils" {
    abstract class Model {
        +training_step(): dict
        +validation_step(): dict
        +forward(): Tensor
        +init_optimizer_scheduler(optimizer_config, scheduler_config): tuple
        +on_model_init_start(set_barrier): void
    }

    class Callback {
        +on_training_start(state, config): void
        +on_before_backward(state, config, loss): void
        +on_after_backward(state, config): void
        +on_before_optimizer_step(state, config): void
        +on_end_of_iteration(state, config): void
    }

    class CallBackGroup {
        -callbacks: list
        +on_training_start(state, config): void
        +on_before_backward(state, config, loss): void
        +on_after_backward(state, config): void
        +on_end_of_iteration(state, config): void
    }

    class EMAModelCallback {
        -ema_decay: float
        +on_end_of_iteration(state, config): void
    }

    class GradClipCallback {
        -max_grad_norm: float
        +on_before_optimizer_step(state, config): void
    }

    class Config {
        +job: JobConfig
        +checkpoint: CheckpointConfig
        +trainer: TrainerConfig
    }

    class CheckpointConfig {
        +load_path: str
        +save_path: str
        +strict_resume: bool
        +load_training_state: bool
    }
}

' =============================================
' CHECKPOINTERS
' =============================================
package "cosmos_predict1.checkpointer" {
    abstract class AbstractCheckpointer {
        #config_checkpoint: CheckpointConfig
        #callbacks: CallBackGroup
        #strict_resume: bool
        #load_path: str
        +{abstract} load(model): void
        +{abstract} save(model, iteration): void
    }

    class DDPCheckpointer {
        +load(model): void
        +save(model, iteration): void
    }

    class TPCheckpointer {
        +load(model): void
        +save(model, iteration): void
    }

    class PEFTCheckpointer {
        +load(model): void
        +save(model, iteration): void
    }
}

' =============================================
' GUARDRAILS
' =============================================
package "cosmos_predict1.auxiliary.guardrail" {
    class ContentSafetyGuardrail {
        +is_safe(**kwargs): Tuple[bool, str]
    }

    class PostprocessingGuardrail {
        +postprocess(frames: ndarray): ndarray
    }

    class GuardrailRunner {
        -safety_models: list
        -postprocessors: list
        -generic_block_msg: str
        +run_safety_check(input: Any): Tuple[bool, str]
        +postprocess(frames: ndarray): ndarray
    }

    class Aegis {
        -model_name: str
        +is_safe(**kwargs): Tuple[bool, str]
    }

    class Blocklist {
        -blocklist_path: str
        +is_safe(**kwargs): Tuple[bool, str]
    }

    class LlamaGuard3 {
        -model_name: str
        +is_safe(**kwargs): Tuple[bool, str]
    }

    class VideoContentSafetyFilter {
        -model: SafetyClassifier
        +is_safe(**kwargs): Tuple[bool, str]
    }

    class RetinaFaceFilter {
        +postprocess(frames: ndarray): ndarray
    }
}

' =============================================
' TOKENIZER
' =============================================
package "cosmos_predict1.autoregressive.tokenizer" {
    class TextTokenizer {
        -model_path: str
        -bos_id: int
        -eos_id: int
        +encode(text: str): list
        +decode(tokens: list): str
    }

    class ImageTextTokenizer {
        -image_tokenizer: BaseDiscreteVideoFSQTokenizer
        +encode_image(image): Tensor
        +encode_image_text(image, text): Tensor
    }

    class DiscreteMultimodalTokenizer {
        -video_tokenizer: BaseDiscreteVideoFSQTokenizer
        -text_tokenizer: TextTokenizer
        -vocab_size: int
        +tokenize_video(video: Tensor): Tensor
        +tokenize_text(text: str): Tensor
        +encode(data): Tensor
        +decode(tokens: Tensor): Tensor
    }

    abstract class BaseDiscreteVideoFSQTokenizer {
        #quantizer: FSQuantizer
        #encoder: EncoderFactorized
        #decoder: DecoderFactorized
        +{abstract} encode(video: Tensor): Tensor
        +{abstract} decode(tokens: Tensor): Tensor
    }

    class DiscreteVideoFSQJITTokenizer {
        +encode(video: Tensor): Tensor
        +decode(tokens: Tensor): Tensor
    }

    class DiscreteVideoFSQStateDictTokenizer {
        +encode(video: Tensor): Tensor
        +decode(tokens: Tensor): Tensor
    }
}

' =============================================
' AUTOREGRESSIVE NETWORKS
' =============================================
package "cosmos_predict1.autoregressive.networks" {
    class "Transformer (inference)" as ARTransformer {
        -layers: list[TransformerBlock]
        -vocab_size: int
        -dim: int
        -n_heads: int
        -n_layers: int
        +forward(tokens: Tensor, start_pos: int): Tensor
    }

    class VisionTransformer {
        -patch_embed: PatchEmbed
        -blocks: list
        -n_layers: int
        -n_heads: int
        +forward(x: Tensor): Tensor
        +get_features(x: Tensor): Tensor
    }

    class VisionTransformerBlocks {
        -blocks: list
        +forward(x: Tensor): Tensor
    }
}

' =============================================
' AUTOREGRESSIVE MODULES
' =============================================
package "cosmos_predict1.autoregressive.modules" {
    class Attention {
        -n_heads: int
        -n_kv_heads: int
        -dim: int
        -wq: ColumnParallelLinear
        -wk: ColumnParallelLinear
        -wv: ColumnParallelLinear
        -wo: RowParallelLinear
        +forward(x: Tensor, freqs_cis: Tensor, mask: Tensor): Tensor
    }

    class MultimodalProjector {
        -blocks: list[DownSampleBlock]
        -output_dim: int
        +forward(x: Tensor): Tensor
    }

    class RMSNorm {
        -dim: int
        -eps: float
        +forward(x: Tensor): Tensor
        +norm(x: Tensor): Tensor
    }
}

' =============================================
' AUTOREGRESSIVE MODELS
' =============================================
package "cosmos_predict1.autoregressive.model" {
    class AutoRegressiveModel {
        -model: ARTransformer
        -tokenizer: DiscreteMultimodalTokenizer
        -config: ModelConfig
        -vision_encoder: VisionTransformer
        -mm_projector: MultimodalProjector
        +forward(tokens: Tensor, start_pos: int): Tensor
        +generate(prompts, max_gen_len, temperature, top_p): list
    }

    class AutoRegressiveTrainingModel {
        -model: Transformer
        -tokenizer: DiscreteMultimodalTokenizer
        -config: ModelConfig
        -vision_encoder: VisionTransformer
        -mm_projector: MultimodalProjector
        +training_step(data_batch): dict
        +validation_step(data_batch): dict
        +forward(tokens: Tensor): Tensor
    }
}

' =============================================
' DIFFUSION MODELS
' =============================================
package "cosmos_predict1.diffusion.model" {
    class DiffusionT2WModel {
        -config: Any
        -sigma_data: float
        -precision: dtype
        +forward(data_batch: dict): dict
        +generate_samples(data_batch: dict): Tensor
        +encode(video: Tensor): Tensor
        +decode(latent: Tensor): Tensor
    }

    class DiffusionV2WModel {
        +forward(data_batch: dict): dict
        +generate_samples(data_batch: dict): Tensor
    }

    class DiffusionMultiviewT2WModel {
        -n_cameras: int
        +forward(data_batch: dict): dict
    }

    class DiffusionMultiviewV2WModel {
        -n_cameras: int
        +forward(data_batch: dict): dict
    }

    class DiffusionWorldInterpolatorWModel {
        +forward(data_batch: dict): dict
        +interpolate(video_start: Tensor, video_end: Tensor): Tensor
    }

    class DiffusionGen3CModel {
        +forward(data_batch: dict): dict
    }

    class LatentDiffusionDecoderModel {
        +forward(data_batch: dict): dict
        +decode(tokens: Tensor): Tensor
    }
}

' =============================================
' INFERENCE PIPELINES
' =============================================
package "cosmos_predict1.utils / inference" {
    abstract class BaseWorldGenerationPipeline {
        #checkpoint_dir: str
        #checkpoint_name: str
        #guardrail_runner: GuardrailRunner
        +{abstract} generate(prompt, **kwargs): ndarray
        +load_model(checkpoint_dir: str): void
        +run_guardrail(prompt): Tuple[bool, str]
    }
}

package "cosmos_predict1.autoregressive.inference" {
    class ARBaseGenerationPipeline {
        -ar_model: AutoRegressiveModel
        -diffusion_decoder: LatentDiffusionDecoderModel
        -inference_config: InferenceConfig
        +generate(prompt, input_video, **kwargs): ndarray
    }

    class ARVideo2WorldGenerationPipeline {
        +generate(prompt, input_video, **kwargs): ndarray
        +batch_generate(prompts, videos): list
    }
}

package "cosmos_predict1.diffusion.inference" {
    class DiffusionText2WorldGenerationPipeline {
        -model: DiffusionT2WModel
        -tokenizer: BasePretrainedVideoTokenizer
        -inference_config: Any
        +generate(prompt: str, **kwargs): ndarray
    }

    class DiffusionVideo2WorldGenerationPipeline {
        +generate(prompt: str, input_video, **kwargs): ndarray
    }

    class DiffusionText2WorldMultiviewGenerationPipeline {
        -n_cameras: int
        +generate(prompt: str, **kwargs): ndarray
    }

    class DiffusionVideo2WorldMultiviewGenerationPipeline {
        +generate(prompt: str, input_video, **kwargs): ndarray
    }

    class DiffusionWorldInterpolatorGenerationPipeline {
        +generate(prompt: str, video_start, video_end, **kwargs): ndarray
    }

    class Gen3cPipeline {
        +generate(prompt: str, input_video, **kwargs): ndarray
    }
}

' =============================================
' DATASET
' =============================================
package "cosmos_predict1.autoregressive.datasets" {
    class VideoDataset {
        -data_paths: list
        -augmentors: list[Augmentor]
        -tokenizer_config: TokenizerConfig
        +__len__(): int
        +__getitem__(idx: int): dict
    }

    abstract class Augmentor {
        +{abstract} __call__(frames: Tensor): Tensor
    }

    class ResizeSmallestSideAspectPreserving {
        -size: int
        +__call__(frames: Tensor): Tensor
    }

    class CenterCrop {
        -size: Tuple[int, int]
        +__call__(frames: Tensor): Tensor
    }

    class Normalize {
        -mean: list
        -std: list
        +__call__(frames: Tensor): Tensor
    }
}

' =============================================
' CALLBACKS (AR-specific)
' =============================================
package "cosmos_predict1.callbacks" {
    class EveryN {
        -every_n: int
        +on_end_of_iteration(state, config): void
    }

    class GradClip {
        -max_norm: float
        +on_before_optimizer_step(state, config): void
    }
}

package "cosmos_predict1.autoregressive.callbacks" {
    class VideoSamplingTeacherForcing {
        -pipeline: ARBaseGenerationPipeline
        +on_end_of_iteration(state, config): void
    }
}

' =============================================
' RELATIONSHIPS
' =============================================

' PyTorch inheritance
NNModule <|-- Model
NNModule <|-- DiffusionT2WModel
NNModule <|-- AutoRegressiveModel
NNModule <|-- ARTransformer
NNModule <|-- VisionTransformer
NNModule <|-- Attention
NNModule <|-- MultimodalProjector
NNModule <|-- RMSNorm
NNModule <|-- BaseDiscreteVideoFSQTokenizer

' Model inheritance
Model <|-- AutoRegressiveTrainingModel

' Checkpointer hierarchy
AbstractCheckpointer <|-- DDPCheckpointer
DDPCheckpointer <|-- TPCheckpointer
DDPCheckpointer <|-- PEFTCheckpointer

' Guardrail hierarchy
ContentSafetyGuardrail <|-- Aegis
ContentSafetyGuardrail <|-- Blocklist
ContentSafetyGuardrail <|-- LlamaGuard3
ContentSafetyGuardrail <|-- VideoContentSafetyFilter
PostprocessingGuardrail <|-- RetinaFaceFilter

' Tokenizer hierarchy
TextTokenizer <|-- ImageTextTokenizer
BaseDiscreteVideoFSQTokenizer <|-- DiscreteVideoFSQJITTokenizer
BaseDiscreteVideoFSQTokenizer <|-- DiscreteVideoFSQStateDictTokenizer

' Diffusion model hierarchy
DiffusionT2WModel <|-- DiffusionV2WModel
DiffusionT2WModel <|-- DiffusionMultiviewT2WModel
DiffusionT2WModel <|-- LatentDiffusionDecoderModel
DiffusionV2WModel <|-- DiffusionMultiviewV2WModel
DiffusionV2WModel <|-- DiffusionWorldInterpolatorWModel
DiffusionV2WModel <|-- DiffusionGen3CModel

' Inference pipeline hierarchy
BaseWorldGenerationPipeline <|-- ARBaseGenerationPipeline
BaseWorldGenerationPipeline <|-- DiffusionText2WorldGenerationPipeline
ARBaseGenerationPipeline <|-- ARVideo2WorldGenerationPipeline
DiffusionText2WorldGenerationPipeline <|-- DiffusionVideo2WorldGenerationPipeline
DiffusionText2WorldGenerationPipeline <|-- DiffusionText2WorldMultiviewGenerationPipeline
DiffusionText2WorldMultiviewGenerationPipeline <|-- DiffusionVideo2WorldMultiviewGenerationPipeline
DiffusionVideo2WorldGenerationPipeline <|-- DiffusionWorldInterpolatorGenerationPipeline
DiffusionVideo2WorldGenerationPipeline <|-- Gen3cPipeline

' Callback hierarchy
Callback <|-- EveryN
Callback <|-- GradClip
Callback <|-- EMAModelCallback
Callback <|-- GradClipCallback
EveryN <|-- VideoSamplingTeacherForcing

' Dataset hierarchy
Augmentor <|-- ResizeSmallestSideAspectPreserving
Augmentor <|-- CenterCrop
Augmentor <|-- Normalize

' Composition / Aggregation
AutoRegressiveModel *-- ARTransformer : model
AutoRegressiveModel *-- DiscreteMultimodalTokenizer : tokenizer
AutoRegressiveModel *-- VisionTransformer : vision_encoder
AutoRegressiveModel *-- MultimodalProjector : mm_projector

AutoRegressiveTrainingModel *-- ARTransformer : model
AutoRegressiveTrainingModel *-- DiscreteMultimodalTokenizer : tokenizer

DiscreteMultimodalTokenizer *-- TextTokenizer : text_tokenizer
DiscreteMultimodalTokenizer *-- BaseDiscreteVideoFSQTokenizer : video_tokenizer

ARBaseGenerationPipeline *-- AutoRegressiveModel : ar_model
ARBaseGenerationPipeline *-- LatentDiffusionDecoderModel : diffusion_decoder
ARBaseGenerationPipeline o-- GuardrailRunner : guardrail_runner

DiffusionText2WorldGenerationPipeline *-- DiffusionT2WModel : model
DiffusionText2WorldGenerationPipeline o-- GuardrailRunner : guardrail_runner

GuardrailRunner o-- ContentSafetyGuardrail : safety_models
GuardrailRunner o-- PostprocessingGuardrail : postprocessors

VideoDataset o-- Augmentor : augmentors

CallBackGroup o-- Callback : callbacks
AbstractCheckpointer *-- CallBackGroup : callbacks

@enduml
