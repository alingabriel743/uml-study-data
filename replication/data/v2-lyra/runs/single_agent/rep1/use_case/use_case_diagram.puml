@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #3A7BD5
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Cosmos Predict1 / Lyra — Use Case Diagram

left to right direction

' ── Actors ──────────────────────────────────────────────────────────────────
actor "Researcher /\nML Engineer" as researcher
actor "Downstream\nDeveloper" as developer
actor "Guardrail\nSystem" as guardrail
actor "Hugging Face\nHub" as hfhub
actor "GPU Cluster" as gpu

' ── System Boundary ──────────────────────────────────────────────────────────
rectangle "Cosmos Predict1 / Lyra — World Generation System" {

    ' ─── Diffusion-Based Inference ───────────────────────────────────────────
    package "Diffusion Inference" {
        usecase "Generate World\nfrom Text Prompt\n(Text2World)" as UC_T2W
        usecase "Generate World\nfrom Video + Prompt\n(Video2World)" as UC_V2W
        usecase "Generate Multiview World\nfrom Text\n(Text2World Multiview)" as UC_T2W_MV
        usecase "Generate Multiview World\nfrom Video\n(Video2World Multiview)" as UC_V2W_MV
        usecase "Interpolate Between\nVideo Frames" as UC_INTERP
    }

    ' ─── Gen3C (3D-Consistent Generation) ───────────────────────────────────
    package "Gen3C 3D-Consistent Generation" {
        usecase "Generate 3D-Consistent\nVideo from Single Image" as UC_G3C_IMG
        usecase "Generate 3D-Consistent\nVideo from Dynamic Scene" as UC_G3C_DYN
        usecase "Generate Multiview\n3D-Consistent Video" as UC_G3C_MV
        usecase "Configure Camera\nTrajectory" as UC_CAM
    }

    ' ─── Autoregressive Inference ────────────────────────────────────────────
    package "Autoregressive Inference" {
        usecase "Generate Video via\nAutoregressive Model\n(AR Video2World)" as UC_AR_V2W
        usecase "Decode AR Tokens\nwith Diffusion Decoder" as UC_AR_DIFF
    }

    ' ─── Tokenizer ───────────────────────────────────────────────────────────
    package "Tokenizer" {
        usecase "Encode Video\nto Latent Tokens" as UC_ENC
        usecase "Decode Latent Tokens\nto Video" as UC_DEC
        usecase "Train Tokenizer\nModel" as UC_TOK_TRAIN
    }

    ' ─── Training & Fine-tuning ──────────────────────────────────────────────
    package "Training & Fine-tuning" {
        usecase "Train Diffusion\nModel" as UC_TRAIN
        usecase "Fine-tune Model\nwith LoRA" as UC_LORA
        usecase "Reconstruct 3D Scene\n(Lyra LatentRecon)" as UC_RECON
        usecase "Sample Novel Views\nfrom Multi-View Data" as UC_SAMPLE
    }

    ' ─── Safety & Prompt Handling ────────────────────────────────────────────
    package "Safety & Prompt Utilities" {
        usecase "Check Text\nContent Safety" as UC_TEXT_GUARD
        usecase "Check Video\nContent Safety" as UC_VID_GUARD
        usecase "Apply Face\nBlur to Output" as UC_FACE_BLUR
        usecase "Upsample\nText Prompt" as UC_UPSAMPLE
    }

    ' ─── Setup & Configuration ───────────────────────────────────────────────
    package "Setup & Configuration" {
        usecase "Download Model\nCheckpoints" as UC_DOWNLOAD
        usecase "Configure Inference\nParameters" as UC_CONFIG
        usecase "Run Distributed\nMulti-GPU Inference" as UC_DIST
    }
}

' ── Actor → Use Case Associations ────────────────────────────────────────────
developer --> UC_T2W
developer --> UC_V2W
developer --> UC_T2W_MV
developer --> UC_V2W_MV
developer --> UC_INTERP
developer --> UC_G3C_IMG
developer --> UC_G3C_DYN
developer --> UC_G3C_MV
developer --> UC_AR_V2W
developer --> UC_ENC
developer --> UC_DEC
developer --> UC_CONFIG
developer --> UC_DOWNLOAD

researcher --> UC_TRAIN
researcher --> UC_LORA
researcher --> UC_TOK_TRAIN
researcher --> UC_RECON
researcher --> UC_SAMPLE
researcher --> UC_T2W
researcher --> UC_V2W
researcher --> UC_DIST

guardrail --> UC_TEXT_GUARD
guardrail --> UC_VID_GUARD
guardrail --> UC_FACE_BLUR

hfhub --> UC_DOWNLOAD

gpu --> UC_DIST
gpu --> UC_TRAIN
gpu --> UC_LORA

' ── Include / Extend Relationships ────────────────────────────────────────────
UC_T2W ..> UC_TEXT_GUARD   : <<include>>
UC_T2W ..> UC_VID_GUARD    : <<include>>
UC_T2W ..> UC_UPSAMPLE     : <<extend>>

UC_V2W ..> UC_TEXT_GUARD   : <<include>>
UC_V2W ..> UC_VID_GUARD    : <<include>>
UC_V2W ..> UC_UPSAMPLE     : <<extend>>

UC_T2W_MV ..> UC_TEXT_GUARD : <<include>>
UC_T2W_MV ..> UC_VID_GUARD  : <<include>>

UC_V2W_MV ..> UC_TEXT_GUARD : <<include>>
UC_V2W_MV ..> UC_VID_GUARD  : <<include>>

UC_G3C_IMG ..> UC_CAM       : <<include>>
UC_G3C_DYN ..> UC_CAM       : <<include>>
UC_G3C_MV  ..> UC_CAM       : <<include>>

UC_AR_V2W  ..> UC_AR_DIFF   : <<include>>
UC_AR_V2W  ..> UC_TEXT_GUARD : <<include>>
UC_AR_V2W  ..> UC_VID_GUARD  : <<include>>

UC_VID_GUARD ..> UC_FACE_BLUR : <<include>>

UC_LORA ..> UC_TRAIN        : <<include>>
UC_RECON ..> UC_ENC         : <<include>>

UC_T2W ..> UC_DIST          : <<extend>>
UC_TRAIN ..> UC_DIST        : <<extend>>

@enduml
