@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Lyra (cosmos_predict1) — Autoregressive World Generation Model

' ─── External / Framework Base Classes ───
abstract class "nn.Module" as nnModule <<PyTorch>>
abstract class "torch.nn.Module" as torchNNModule <<PyTorch>>
abstract class "Dataset" as Dataset <<PyTorch>>
abstract class "TextTokenizer" as TextTokenizer <<external>>
abstract class "BaseWorldGenerationPipeline" as BaseWorldGenPipeline <<external>>
abstract class "DiffusionT2WModel" as DiffusionT2WModel <<external>>
abstract class "GeneralDIT" as GeneralDIT <<external>>
abstract class "GeneralConditioner" as GeneralConditioner <<external>>
abstract class "BaseVideoCondition" as BaseVideoCondition <<external>>
abstract class "EveryN" as EveryN <<external>>
abstract class "McoreColumnParallelLinear" as McoreColLinear <<Megatron>>
abstract class "McoreRowParallelLinear" as McoreRowLinear <<Megatron>>
abstract class "McoreVocabParallelEmbedding" as McoreVocabEmb <<Megatron>>

' ─── Package: Callbacks ───
package "autoregressive.callbacks" {
    class VideoSamplingTeacherForcing {
        +__init__(every_n: int, step_size: int,\n  video_latent_shape: list, ...)
        +on_train_start(model: Model): None
    }
}

' ─── Package: Configs ───
package "autoregressive.configs" {
    class VideoDatasetConfig
    class ModelConfig {
        +__getitem__(item)
    }
    class TrainingModelConfig {
        +__getitem__(item)
    }
    class LambdaLinearWarmupScheduler {
        +__init__(warmup_steps: int, warmup_offset: int,\n  max_iter: int, cooldown_steps: int)
        +__call__(step)
    }
    class TextTokenizerConfig
    class VideoTokenizerConfig
    class TokenizerConfig
    class DataShapeConfig
    class SamplingConfig
    class DiffusionDecoderSamplingConfig
    class InferenceConfig
    class "Config" as ARConfig {
        +validate(): None
    }
    note right of ARConfig : extends config.Config
}

' ─── Package: Datasets ───
package "autoregressive.datasets" {
    class Augmentor {
        +__init__(input_keys: list, output_keys: list,\n  args: dict): None
        +__call__(*args, **kwds): Any
    }
    class ResizeSmallestSideAspectPreserving {
        +__call__(data_dict: dict): dict
    }
    class CenterCrop {
        +__call__(data_dict: dict): dict
    }
    class Normalize {
        +__call__(data_dict: dict): dict
    }
    class VideoDataset {
        +__init__(config: VideoDatasetConfig)
        +__getitem__(index)
        +__len__()
        +__str__()
        -_get_frames(video_path, frame_ids)
    }
}

' ─── Package: Modules ───
package "autoregressive.modules" {
    class Attention {
        +__init__(n_heads: int, n_kv_heads, dim: int,\n  max_batch_size, max_seq_len, ...)
        +forward(x, rope, input_pos, mask, context): Tensor
        +init_kv_cache(dtype)
        +load_hook(state_dict, prefix)
    }
    class RotaryPositionEmbedding {
        +__init__(dim: int, max_position_embeddings,\n  rope_theta, apply_yarn, ...)
        +forward(seq_len): Tensor
        +compute_freqs(): Tuple[Tensor, Tensor]
        +get_inv_freq(device): None
        +get_mscale(scale: float): float
    }
    class RotaryPositionEmbeddingTE {
        +forward(seq_len: int, training_type: str): Tensor
    }
    class RotaryPositionEmbeddingPytorch {
        +forward(q, k, input_pos, seq_len): Tuple
        +rotate_half(x: Tensor): Tensor
    }
    class RotaryPositionEmbeddingPytorchV2 {
        +__init__(seq_len: int, training_type: str)
        +forward(q, k, input_pos, seq_len): Tuple
        +create_rope_freqs(seq_len, training_type): Tensor
    }
    class RotaryPositionEmbeddingPytorchV1 {
        +forward(q, k, input_pos, seq_len): Tuple
        +rotate_half(x: Tensor): Tensor
    }
    class SinCosPosEmbAxisTE {
        +__init__(dim: int, latent_shape, dtype, device)
        +forward(training_type): Tensor
    }
    class MLP {
        +__init__(dim: int, hidden_dim: int,\n  tensor_parallel_size: int)
        +forward(x: Tensor): Tensor
    }
    class TrainingMLP {
        +__init__(dim: int, hidden_dim: int,\n  hidden_dropout, set_parallel_mode, ...)
        +forward(x: Tensor): Tensor
        +init_weights(init_std: float)
    }
    class RMSNorm {
        +__init__(dim: int, eps: float, compile: bool)
        +forward(x: Tensor)
        +reset_parameters()
    }
    class MultimodalProjector {
        +__init__(mm_projector_type: str, in_dim: int,\n  out_dim: int, **kwargs)
        +forward(x: Tensor): Tensor
    }
    class DownSampleBlock {
        +forward(x)
        +flat_square(x: Tensor): Tensor
    }
    class VocabParallelEmbedding {
        +__init__(num_embeddings: int, embedding_dim: int,\n  precision: str)
        +forward(input_)
    }
    class ColumnParallelLinear {
        +forward(input_: Tensor)
    }
    class RowParallelLinear {
        +forward(input_: Tensor)
    }
    class TrainingVocabParallelEmbedding {
        +__init__(num_embeddings, embedding_dim,\n  init_method, config, ...)
        +forward(input_)
    }
}

' ─── Package: Networks ───
package "autoregressive.networks" {
    class TransformerBlock {
        +__init__(layer_id: int, args)
        +forward(x, rope, input_pos, mask,\n  context, context_mask): Tensor
        +init_weights()
    }
    class Transformer {
        +__init__(params, model_parallel,\n  tokenizer_config, init_weights: bool)
        -_create_attention_mask(input_pos): Tensor
        -_create_abs_pos_emb_config()
        -_create_output_projection(vocab_size: int)
        -_broadcast_pos_emb(pos_emb, tp_group)
    }
    class VisionTransformer {
        +__init__(dim: int, num_channels: int,\n  patch_size: int, n_layers: int, ...)
        +forward(x: Tensor): Tensor
        +expand_in_channels(new_in_channels: int)
        +get_num_params(): int
    }
    class VisionTransformerBlocks {
        +__init__(n_layers: int, args: Mapping)
        +forward(x: Tensor, rope: Callable): Tensor
    }
}

' ─── Package: Model ───
package "autoregressive.model" {
    class AutoRegressiveModel {
        +__init__(model: Transformer,\n  tokenizer: DiscreteMultimodalTokenizer,\n  config: ModelConfig,\n  model_parallel: ModelParallelConfig,\n  vision_encoder: VisionTransformer,\n  mm_projector: MultimodalProjector)
        +load_ar_model(shard_checkpoint, tokenizer_config)
        +embed_vision_language_features(\n  input_ids: Tensor, images: Tensor): Tensor
        +get_num_params(): int
        +load_state_dict(state_dict: Dict, strict, assign)
    }
}

' ─── Package: Diffusion Decoder ───
package "autoregressive.diffusion_decoder" {
    class VideoLatentDiffusionDecoderCondition
    class VideoDiffusionDecoderConditioner {
        +forward(batch: Dict,\n  override_dropout_rate): VideoLatentDiffusionDecoderCondition
    }
    class LatentDiffusionDecoderModel {
        +__init__(config)
        +generate_samples_from_batch(data_batch,\n  guidance, seed, state_shape, ...): Tensor
        -_get_conditions(data_batch,\n  is_negative_prompt, ...): dict
        -_add_latent_conditions_to_data_batch(\n  data_batch, apply_corruptor, ...)
    }
    class DiffusionDecoderGeneralDIT {
        +__init__(is_diffusion_decoder: bool,\n  diffusion_decoder_condition_on_sigma, ...)
        +build_patch_embed()
        +initialize_weights()
        +enable_context_parallel(cp_group: ProcessGroup)
        +disable_context_parallel()
    }
    class "Config" as DDConfig {
    }
    note right of DDConfig : extends config.Config
}

' ─── Package: Inference ───
package "autoregressive.inference" {
    class ARBaseGenerationPipeline {
        +__init__(inference_type: str,\n  checkpoint_dir: str, checkpoint_name: str,\n  offload_network: bool, ...)
        -_load_model()
        -_load_diffusion_decoder()
        -_run_model(inp_vid, num_input_frames,\n  seed, sampling_config): Tuple
        -_run_model_with_offload(...): Tuple
    }
    class ARVideo2WorldGenerationPipeline {
        +__init__(checkpoint_dir: str,\n  checkpoint_name: str,\n  has_text_input: bool, ...)
        +generate(inp_prompt: str, inp_vid,\n  num_input_frames: int, seed: int,\n  sampling_config: SamplingConfig): ndarray
        -_run_model(prompt_embedding,\n  prompt_mask, inp_vid, ...): tuple
        -_run_model_with_offload(...): tuple
    }
}

' ─── Package: Tokenizer ───
package "autoregressive.tokenizer" {
    class BaseDiscreteVideoFSQTokenizer {
        +__init__(name: str, latent_ch: int,\n  is_bf16: bool, pixel_chunk_duration,\n  latent_chunk_duration, max_enc_batch_size, ...)
        +reset_dtype()
    }
    class DiscreteVideoFSQJITTokenizer {
        +__init__(enc_fp: str, dec_fp: str, name: str, ...)
        +load_encoder(enc_fp: str): None
        +load_decoder(dec_fp: str): None
    }
    class DiscreteVideoFSQStateDictTokenizer {
        +__init__(enc_fp: str, dec_fp: str,\n  tokenizer_module: nn.Module, name: str, ...)
        +load_encoder_and_decoder(enc_fp, dec_fp,\n  tokenizer_module): None
        +reset_dtype()
    }
    class ImageTextTokenizer {
        +__init__(model_family: str,\n  is_instruct_model: bool,\n  tokenizer_path: str, image_processor_path: str)
        +encode(text, images, image_kwargs): List[int]
        +apply_chat_template(conversation,\n  images, add_generation_prompt, ...)
    }
    class CausalDiscreteVideoTokenizer {
        +__init__(z_channels: int, z_factor: int,\n  embedding_dim: int): None
        +encode(x)
        +decode(quant)
        +forward(input)
        +to(...)
    }
    class CausalConv3d {
        +__init__(chan_in, chan_out, kernel_size,\n  pad_mode: str)
        +forward(x: Tensor): Tensor
    }
    class CausalHybridUpsample3d {
        +__init__(in_channels, spatial_up, temporal_up): None
        +forward(x: Tensor): Tensor
    }
    class CausalHybridDownsample3d {
        +__init__(in_channels, spatial_down, temporal_down): None
        +forward(x: Tensor): Tensor
    }
    class CausalResnetBlockFactorized3d {
        +__init__(in_channels, out_channels,\n  dropout, num_groups): None
        +forward(x: Tensor): Tensor
    }
    class CausalAttnBlock {
        +__init__(in_channels, num_groups): None
        +forward(x: Tensor): Tensor
    }
    class CausalTemporalAttnBlock {
        +__init__(in_channels, num_groups): None
        +forward(x: Tensor): Tensor
    }
    class EncoderFactorized {
        +__init__(in_channels, channels,\n  channels_mult, num_res_blocks, ...): None
        +forward(x: Tensor): Tensor
    }
    class DecoderFactorized {
        +__init__(out_channels, channels,\n  channels_mult, num_res_blocks, ...)
        +forward(z)
    }
}

