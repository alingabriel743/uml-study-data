@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam ArrowColor #495057

title Cosmos Predict1 — Autoregressive World Model\nUse Case Diagram

left to right direction

actor "ML Engineer /\nResearcher" as mleng
actor "Video Source\n(External Input)" as videosrc
actor "Training\nInfrastructure" as traininginfra

rectangle "Cosmos Predict1 — Autoregressive World Model System" {

    package "Inference & Video Generation" {
        usecase "Generate World Video" as UC1
        usecase "Generate Video from\nText Prompt" as UC2
        usecase "Generate Video from\nVideo Context" as UC3
        usecase "Configure Inference\nParameters" as UC4
        usecase "Apply Diffusion\nDecoding" as UC5
        usecase "Offload Model\nComponents" as UC6
    }

    package "Tokenization" {
        usecase "Tokenize Video\nFrames" as UC7
        usecase "Decode Tokens\nto Video" as UC8
        usecase "Process Image-Text\nTokens" as UC9
        usecase "Load Tokenizer\nCheckpoint" as UC10
    }

    package "Training" {
        usecase "Train AR Model" as UC11
        usecase "Load Video Dataset" as UC12
        usecase "Preprocess Video\nFrames" as UC13
        usecase "Monitor Training\nProgress" as UC14
        usecase "Configure Learning\nRate Schedule" as UC15
    }

    package "Model Management" {
        usecase "Load AR Model\nCheckpoint" as UC16
        usecase "Configure Model\nArchitecture" as UC17
        usecase "Embed Vision-Language\nFeatures" as UC18
        usecase "Run Parallel\nDistributed Training" as UC19
    }

}

' ML Engineer interactions
mleng --> UC1
mleng --> UC2
mleng --> UC3
mleng --> UC4
mleng --> UC11
mleng --> UC16
mleng --> UC17

' Video Source interactions
videosrc --> UC3
videosrc --> UC12

' Training Infrastructure interactions
traininginfra --> UC11
traininginfra --> UC19

' Include / Extend relationships
UC1 ..> UC7 : <<include>>
UC1 ..> UC8 : <<include>>
UC1 ..> UC5 : <<include>>
UC2 ..> UC9 : <<include>>
UC2 ..> UC1 : <<extend>>
UC3 ..> UC1 : <<extend>>
UC4 ..> UC1 : <<include>>

UC7 ..> UC10 : <<include>>
UC8 ..> UC10 : <<include>>

UC11 ..> UC12 : <<include>>
UC11 ..> UC13 : <<include>>
UC11 ..> UC14 : <<include>>
UC11 ..> UC15 : <<include>>
UC11 ..> UC19 : <<extend>>
UC16 ..> UC17 : <<include>>
UC18 ..> UC9 : <<include>>
UC6 ..> UC1 : <<extend>>

@enduml
