@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
    StartColor #495057
    EndColor #212529
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra — Autoregressive Video World Generation Pipeline

|Client|
start
:Provide input prompt (text) and\ncondition video frames (inp_vid);

|ARVideo2WorldGenerationPipeline|
:Call generate(inp_prompt, inp_vid,\nnum_input_frames, seed, sampling_config);

if (offload_network enabled?) then (yes)
    :Call _run_model_with_offload()\n[moves modules to GPU on demand];
else (no)
    :Call _run_model()\n[standard in-memory inference];
endif

|Tokenizer|
:Encode input video frames\n(CausalDiscreteVideoTokenizer.encode);
:Quantize latents to discrete tokens\n(FSQ / discrete codebook levels);
:Return prompt_tokens (List[Tensor]);

|ARVideo2WorldGenerationPipeline|
if (has_text_input?) then (yes)
    :Encode text prompt\n(ImageTextTokenizer.encode);
    :Obtain prompt_embedding + prompt_mask;
    note right
      Multimodal: text prompt
      is cross-attended in
      the Transformer
    end note
else (no)
    :Use video-only conditioning;
endif

|AutoRegressiveModel (Transformer)|
:Load / initialize AR model\n(_load_model, load_ar_model);
:Embed input tokens\n(VocabParallelEmbedding / embed_vision_language_features);
:Compute Rotary Position Embeddings\n(RotaryPositionEmbedding.forward);
fork
    :Run TransformerBlock layers\n(Attention + MLP);
    :Apply RMSNorm + residual connections;
fork again
    :Cross-attend text context\n(prompt_embedding) if provided;
end fork
:Project to vocabulary logits\n(ColumnParallelLinear);
:Apply logit clipping / sampling\n(SamplingConfig: top-k / temperature);
:Auto-regressively generate\nvideo tokens (token by token);
:Return generated_tokens + logits;

|ARVideo2WorldGenerationPipeline|
:Call generate_video_from_tokens\n(prompt_tokens, latent_shape,\nvideo_start_boundary, max_gen_len,\nsampling_config);
note right
  Determines which generated
  tokens belong to the new
  video segment via
  video_start_boundary
end note

if (diffusion_decoder enabled?) then (yes)
    |DiffusionDecoder|
    :Build latent condition batch\n(_add_latent_conditions_to_data_batch);
    :Encode conditions\n(VideoDiffusionDecoderConditioner.forward);
    :Run iterative diffusion denoising\n(LatentDiffusionDecoderModel\n.generate_samples_from_batch);
    note right
      Guidance scale, num_steps,
      seed configured via
      DiffusionDecoderSamplingConfig
    end note
    :Return refined video latents (Tensor);
    |Tokenizer|
    :Decode refined latents\n(CausalDiscreteVideoTokenizer.decode\n→ DecoderFactorized.forward);
else (no)
    |Tokenizer|
    :Decode AR-generated tokens directly\n(CausalDiscreteVideoTokenizer.decode\n→ DecoderFactorized.forward);
endif

:Reconstruct pixel frames\n(CausalHybridUpsample3d → CausalConv3d);
:Return decoded video as np.ndarray;

|ARVideo2WorldGenerationPipeline|
:Post-process output frames\n(normalize / clip to valid range);

|Client|
:Receive generated world video\n(np.ndarray — RGB frames);
stop

@enduml
