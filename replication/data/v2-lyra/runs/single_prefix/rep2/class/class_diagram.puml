@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam stereotypeCBackgroundColor #DEE2E6
skinparam stereotypeCBorderColor #6C757D

title Cosmos Predict1 — Autoregressive Video Generation (Class Diagram)

' ════════════════════════════════════════════════════════════════
'  External / Framework Base Classes (stubs)
' ════════════════════════════════════════════════════════════════
class "nn.Module" as NnModule <<external>> {
}
class "EveryN" as EveryN <<external>> {
}
class "Dataset" as Dataset <<external>> {
}
class "BaseVideoCondition" as BaseVideoCondition <<external>> {
}
class "GeneralConditioner" as GeneralConditioner <<external>> {
}
class "DiffusionT2WModel" as DiffusionT2WModel <<external>> {
}
class "GeneralDIT" as GeneralDIT <<external>> {
}
class "BaseWorldGenerationPipeline" as BaseWorldGenerationPipeline <<external>> {
}
class "TextTokenizer" as TextTokenizer <<external>> {
}
class "McoreColumnParallelLinear" as McoreColumnParallelLinear <<external>> {
}
class "McoreRowParallelLinear" as McoreRowParallelLinear <<external>> {
}
class "McoreVocabParallelEmbedding" as McoreVocabParallelEmbedding <<external>> {
}
class "config.Config" as BaseConfig <<external>> {
}

' ════════════════════════════════════════════════════════════════
'  Package: Callbacks
' ════════════════════════════════════════════════════════════════
package "callbacks" {
    class VideoSamplingTeacherForcing {
        +__init__(every_n: int, step_size: int, video_latent_shape: list,\n  num_frames_to_display: int, save_folder: Optional[str], num_file_to_log: int)
        +on_train_start(model: Model, iteration: int): None
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Configs
' ════════════════════════════════════════════════════════════════
package "configs" {
    class VideoDatasetConfig
    class TextTokenizerConfig
    class VideoTokenizerConfig
    class TokenizerConfig
    class DataShapeConfig
    class SamplingConfig
    class DiffusionDecoderSamplingConfig
    class InferenceConfig

    class ModelConfig {
        +__getitem__(item)
    }
    class TrainingModelConfig {
        +__getitem__(item)
    }
    class LambdaLinearWarmupScheduler {
        +__init__(warmup_steps: int, warmup_offset: int,\n  max_iter: int, cooldown_steps: int)
        +__call__(step)
    }
    class AutoregressiveConfig <<Config>> {
        +validate(): None
    }
    class DiffusionDecoderConfig <<Config>> {
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Datasets
' ════════════════════════════════════════════════════════════════
package "datasets" {
    class Augmentor {
        +__init__(input_keys: list, output_keys: Optional[list], args: Optional[dict]): None
        +__call__(*args, **kwds): Any
    }
    class ResizeSmallestSideAspectPreserving {
        +__call__(data_dict: dict): dict
    }
    class CenterCrop {
        +__call__(data_dict: dict): dict
    }
    class Normalize {
        +__call__(data_dict: dict): dict
    }
    class VideoDataset {
        +__init__(config: VideoDatasetConfig)
        +__getitem__(index)
        +__len__()
        +__str__()
        -_get_frames(video_path, frame_ids)
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Diffusion Decoder
' ════════════════════════════════════════════════════════════════
package "diffusion_decoder" {
    class VideoLatentDiffusionDecoderCondition {
    }
    class VideoDiffusionDecoderConditioner {
        +forward(batch: Dict, override_dropout_rate: Optional[Dict]): VideoLatentDiffusionDecoderCondition
    }
    class LatentDiffusionDecoderModel {
        +__init__(config)
        +generate_samples_from_batch(data_batch: Dict, guidance: float,\n  seed: int, state_shape: Tuple, n_sample: int,\n  is_negative_prompt: bool, num_steps: int, apply_corruptor: bool): Tensor
        -_get_conditions(data_batch: dict, is_negative_prompt: bool, ...)
        -_add_latent_conditions_to_data_batch(data_batch: dict, ...)
    }
    class DiffusionDecoderGeneralDIT {
        +__init__(is_diffusion_decoder: bool,\n  diffusion_decoder_condition_on_sigma: bool,\n  diffusion_decoder_condition_on_token: bool,\n  diffusion_decoder_token_condition_voc_size: int,\n  diffusion_decoder_token_condition_dim: int)
        +build_patch_embed()
        +initialize_weights()
        +enable_context_parallel(cp_group: ProcessGroup)
        +disable_context_parallel()
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Inference
' ════════════════════════════════════════════════════════════════
package "inference" {
    class ARBaseGenerationPipeline {
        +__init__(inference_type: str, checkpoint_dir: str, checkpoint_name: str,\n  has_text_input: bool, offload_network: bool,\n  offload_tokenizer: bool, disable_diffusion_decoder: bool,\n  offload_guardrail_models: bool)
        -_load_model()
        -_load_diffusion_decoder()
        -_run_model(inp_vid: Tensor, num_input_frames: int,\n  seed: int, sampling_config: SamplingConfig): Tuple
        -_run_model_with_offload(inp_vid: Tensor, num_input_frames: int,\n  seed: int, sampling_config: SamplingConfig): Tuple
    }
    class ARVideo2WorldGenerationPipeline {
        +__init__(checkpoint_dir: str, checkpoint_name: str,\n  inference_type: str, has_text_input: bool,\n  disable_diffusion_decoder: bool, offload_guardrail_models: bool,\n  offload_diffusion_decoder: bool, offload_network: bool)
        +generate(inp_prompt: str, inp_vid: Tensor,\n  num_input_frames: int, seed: int,\n  sampling_config: SamplingConfig): ndarray
        -_run_model(prompt_embedding, prompt_mask, inp_vid,\n  num_input_frames, seed, sampling_config): Tuple
        -_run_model_with_offload(prompt_embedding, prompt_mask, inp_vid,\n  num_input_frames, seed, sampling_config): Tuple
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Core Model
' ════════════════════════════════════════════════════════════════
package "model" {
    class AutoRegressiveModel {
        +__init__(model: Transformer, tokenizer: DiscreteMultimodalTokenizer,\n  config: ModelConfig, model_parallel: ModelParallelConfig,\n  vision_encoder: VisionTransformer, mm_projector: MultimodalProjector)
        +embed_vision_language_features(input_ids: Tensor, images: Tensor): Tensor
        +get_num_params(): int
        +load_state_dict(state_dict: Dict, strict: bool, assign: bool)
        +load_ar_model(shard_checkpoint, tokenizer_config)
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Networks
' ════════════════════════════════════════════════════════════════
package "networks" {
    class TransformerBlock {
        +__init__(layer_id: int, args)
        +forward(x: Tensor, rope: RotaryPositionEmbeddingPytorchV2,\n  input_pos: Optional[Tensor], mask: Optional[Tensor],\n  context: Optional[Tensor], context_mask: Optional[Tensor]): Tensor
        +init_weights()
    }
    class Transformer {
        +__init__(params, model_parallel, tokenizer_config, init_weights: bool)
        -_create_attention_mask(input_pos: Optional[Tensor]): Optional[Tensor]
        -_create_output_projection(vocab_size: int)
        -_broadcast_pos_emb(pos_emb, tp_group)
        -_create_abs_pos_emb_config()
    }
    class VisionTransformer {
        +__init__(dim: int, num_channels: int, patch_size: int,\n  n_layers: int, n_heads: int, n_kv_heads: int,\n  ffn_hidden_size: int, norm_type: str)
        +forward(x: Tensor): Tensor
        +get_num_params(): int
        +expand_in_channels(new_in_channels: int)
    }
    class VisionTransformerBlocks {
        +__init__(n_layers: int, args: Mapping[str, Any])
        +forward(x: Tensor, rope: Callable): Tensor
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Modules
' ════════════════════════════════════════════════════════════════
package "modules" {

    class Attention {
        +__init__(n_heads: int, n_kv_heads: Union[int,None], dim: int,\n  max_batch_size: int, max_seq_len: int,\n  context_dim: Optional[int], use_qk_normalization: bool, norm_type: str)
        +forward(x: Tensor, rope: RotaryPositionEmbedding,\n  input_pos: Tensor, mask: Optional[Tensor], context: Optional[Tensor])
        +init_kv_cache(dtype)
        +load_hook(state_dict, prefix)
    }

    class RotaryPositionEmbedding {
        +__init__(dim: int, max_position_embeddings: int,\n  rope_theta: float, apply_yarn: bool, scale: int,\n  extrapolation_factor: int, attn_factor: int)
        +forward(seq_len: Optional[int]): Tensor
        +compute_freqs(): Tuple[Tensor, Tensor]
        +get_inv_freq(device: device): None
        +get_mscale(scale: float): float
    }
    class RotaryPositionEmbeddingTE {
        +__init__()
        +forward(seq_len: int, training_type: str): Tensor
    }
    class RotaryPositionEmbeddingPytorch {
        +__init__()
        +forward(q: Tensor, k: Tensor, input_pos: Optional[Tensor], seq_len: Optional[int]): Tuple[Tensor, Tensor]
        +rotate_half(x: Tensor): Tensor
    }
    class RotaryPositionEmbeddingPytorchV1 {
        +__init__()
        +forward(q: Tensor, k: Tensor, input_pos: Optional[Tensor], seq_len: Optional[int]): Tuple[Tensor, Tensor]
        +rotate_half(x: Tensor): Tensor
    }
    class RotaryPositionEmbeddingPytorchV2 {
        +__init__(seq_len: int, training_type: str)
        +forward(q: Tensor, k: Tensor, input_pos: Optional[Tensor], seq_len: Optional[int]): Tuple[Tensor, Tensor]
        +create_rope_freqs(seq_len: int, training_type: str): Tensor
    }
    class SinCosPosEmbAxisTE {
        +__init__(dim: int, latent_shape: Optional[List[int]],\n  pad_to_multiple_of: Optional[int], dtype: torch.dtype, device)
        +forward(training_type: str): Tensor
    }

    class MLP {
        +__init__(dim: int, hidden_dim: int, tensor_parallel_size: int)
        +forward(x: Tensor): Tensor
    }
    class TrainingMLP {
        +__init__(dim: int, hidden_dim: int, hidden_dropout: float,\n  set_parallel_mode: bool, model_parallel: Optional[ModelParallelConfig], inference: bool)
        +forward(x: Tensor): Tensor
        +init_weights(init_std: float)
    }

    class VocabParallelEmbedding {
        +__init__(num_embeddings: int, embedding_dim: int, precision: str)
        +forward(input_)
    }
    class ColumnParallelLinear {
        +__init__()
        +forward(input_: Tensor)
    }
    class RowParallelLinear {
        +__init__()
        +forward(input_: Tensor)
    }
    class TrainingVocabParallelEmbedding {
        +__init__(num_embeddings: int, embedding_dim: int,\n  init_method: Callable, sequence_parallel: bool,\n  batch_first: bool, config: ModelParallelConfig, use_inference_allreduce: bool)
        +forward(input_)
    }

    class DownSampleBlock {
        +__init__()
        +forward(x)
        +flat_square(x: Tensor): Tensor
    }
    class MultimodalProjector {
        +__init__(mm_projector_type: str, in_dim: int,\n  out_dim: Optional[int], **kwargs: Any)
        +forward(x: Tensor): Tensor
    }
    class RMSNorm {
        +__init__(dim: int, eps: float, compile: bool)
        +forward(x)
        +reset_parameters()
    }
}

' ════════════════════════════════════════════════════════════════
'  Package: Tokenizer
' ════════════════════════════════════════════════════════════════
package "tokenizer" {
    class BaseDiscreteVideoFSQTokenizer {
        +__init__(name: str, latent_ch: int, is_bf16: bool,\n  pixel_chunk_duration: int, latent_chunk_duration: int,\n  max_enc_batch_size: int, max_dec_batch_size: int, levels: list[int])
        +reset_dtype()
    }
    class DiscreteVideoFSQJITTokenizer {
        +__init__(enc_fp: str, dec_fp: str, name: str, latent_ch: int, is_bf16: bool, ...)
        +load_encoder(enc_fp: str): None
        +load_decoder(dec_fp: str): None
    }
    class DiscreteVideoFSQStateDictTokenizer {
        +__init__(enc_fp: str, dec_fp: str, tokenizer_module: nn.Module, name: str, ...)
        +load_encoder_and_decoder(enc_fp: str, dec_fp: str, tokenizer_module: nn.Module): None
        +reset_dtype()
    }
    class ImageTextTokenizer {
        +__init__(model_family: str, is_instruct_model: bool,\n  tokenizer_path: str, image_processor_path: str)
        +encode(text: Union[str, List[str]], images: Optional[ImageInput],\n  image_kwargs: Optional[Dict]): List[int]
        +apply_chat_template(conversation: List[Dict], images: Optional[ImageInput],\n  image_kwargs: Optional[Dict], add_generation_prompt: bool,\n  tokenize: bool, padding: bool, truncation: bool, max_length: Optional[int])
    }
    class CausalDiscreteVideoTokenizer {
        +__init__(z_channels: int, z_factor: int, embedding_dim: int): None
        +encode(x)
        +decode(quant)
        +forward(input)
        +to()
    }
    class CausalConv3d {
        +__init__(chan_in: int, chan_out: int,\n  kernel_size: Union[int, Tuple[int,int,int]], pad_mode: str)
        +forward(x: Tensor): Tensor
        -_replication_pad(x: Tensor): Tensor
    }
    class CausalHybridUpsample3d {
        +__init__(in_channels: int, spatial_up: bool, temporal_up: bool): None
        +forward(x: Tensor): Tensor
    }
    class CausalHybridDownsample3d {
        +__init__(in_channels: int, spatial_down: bool, temporal_down: bool): None
        +forward(x: Tensor): Tensor
    }
    class CausalResnetBlockFactorized3d {
        +__init__(in_channels: int, out_channels: int, dropout: float, num_groups: int): None
        +forward(x: Tensor): Tensor
    }
    class CausalAttnBlock {
        +__init__(in_channels: int, num_groups: int): None
        +forward(x: Tensor): Tensor
    }
    class CausalTemporalAttnBlock {
        +__init__(in_channels: int, num_groups: int): None
        +forward(x: Tensor): Tensor
    }
    class EncoderFactorized {
        +__init__(in_channels: int, channels: int, channels_mult: list[int],\n  num_res_blocks: int, attn_resolutions: list[int],\n  dropout: float, resolution: int, z_channels: int): None
        +forward(x: Tensor): Tensor
    }
    class DecoderFactorized {
        +__init__(out_channels: int, channels: int, channels_mult: list[int],\n  num_res_blocks: int, attn_resolutions: list[int],\n  dropout: float, resolution: int, z_channels: int)
        +forward(z)
    }
}

' ════════════════════════════════════════════════════════════════
'  Inheritance Relationships
' ════════════════════════════════════════════════════════════════

' Callbacks
VideoSamplingTeacherForcing --|> EveryN

' Configs
AutoregressiveConfig --|> BaseConfig
DiffusionDecoderConfig --|> BaseConfig

' Datasets
VideoDataset --|> Dataset
ResizeSmallestSideAspectPreserving --|> Augmentor
CenterCrop --|> Augmentor
Normalize --|> Augmentor

' Diffusion Decoder
VideoLatentDiffusionDecoderCondition --|> BaseVideoCondition
VideoDiffusionDecoderConditioner --|> GeneralConditioner
LatentDiffusionDecoderModel --|> DiffusionT2WModel
DiffusionDecoderGeneralDIT --|> GeneralDIT

' Inference
ARVideo2WorldGenerationPipeline --|> ARBaseGenerationPipeline
ARBaseGenerationPipeline --|> BaseWorldGenerationPipeline

' Model + Networks → nn.Module
AutoRegressiveModel --|> NnModule
Transformer --|> NnModule
TransformerBlock --|> NnModule
VisionTransformer --|> NnModule
VisionTransformerBlocks --|> NnModule

' Modules → nn.Module
Attention --|> NnModule
RotaryPositionEmbedding --|> NnModule
SinCosPosEmbAxisTE --|> NnModule
VocabParallelEmbedding --|> NnModule
MLP --|> NnModule
TrainingMLP --|> NnModule
DownSampleBlock --|> NnModule
MultimodalProjector --|> NnModule
RMSNorm --|> NnModule

' Embedding variants
RotaryPositionEmbeddingTE --|> RotaryPositionEmbedding
RotaryPositionEmbeddingPytorch --|> RotaryPositionEmbedding
RotaryPositionEmbeddingPytorchV1 --|> RotaryPositionEmbedding
RotaryPositionEmbeddingPytorchV2 --|> RotaryPositionEmbedding

' Parallel Linear → Megatron-Core
ColumnParallelLinear --|> McoreColumnParallelLinear
RowParallelLinear --|> McoreRowParallelLinear
TrainingVocabParallelEmbedding --|> McoreVocabParallelEmbedding

' Tokenizers
DiscreteVideoFSQJITTokenizer --|> BaseDiscreteVideoFSQTokenizer
DiscreteVideoFSQStateDictTokenizer --|> BaseDiscreteVideoFSQTokenizer
BaseDiscreteVideoFSQTokenizer --|> NnModule
CausalDiscreteVideoTokenizer --|> NnModule
ImageTextTokenizer --|> TextTokenizer

' Tokenizer modules → nn.Module
CausalConv3d --|> NnModule
CausalHybridUpsample3d --|> NnModule
CausalHybridDownsample3d --|> NnModule
CausalResnetBlockFactorized3d --|> NnModule
CausalAttnBlock --|> NnModule
CausalTemporalAttnBlock --|> NnModule
EncoderFactorized --|> NnModule
DecoderFactorized --|> NnModule

' ════════════════════════════════════════════════════════════════
'  Key Associations
' ════════════════════════════════════════════════════════════════
AutoRegressiveModel o-- Transformer : model
AutoRegressiveModel o-- VisionTransformer : vision_encoder
AutoRegressiveModel o-- MultimodalProjector : mm_projector
Transformer *-- TransformerBlock : layers
TransformerBlock o-- Attention : attention
TransformerBlock o-- MLP : mlp
VisionTransformer *-- VisionTransformerBlocks : blocks
ARBaseGenerationPipeline o-- LatentDiffusionDecoderModel : diffusion_decoder
CausalDiscreteVideoTokenizer *-- EncoderFactorized : encoder
CausalDiscreteVideoTokenizer *-- DecoderFactorized : decoder
VideoDataset ..> VideoDatasetConfig : uses
VideoDiffusionDecoderConditioner ..> VideoLatentDiffusionDecoderCondition : produces

@enduml
