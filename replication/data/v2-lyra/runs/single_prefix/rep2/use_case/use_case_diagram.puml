@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #6C757D
    FontColor #212529
}

title Lyra — Cosmos Predict1 Autoregressive Video World Generation\nUse Case Diagram

left to right direction

actor "ML Researcher" as researcher
actor "Training Pipeline" as training
actor "Video Data Source" as datasource

rectangle "Cosmos Predict1 — Autoregressive Video World Generation System" {

    ' ─── Inference / Generation ───────────────────────────────
    package "Video World Generation" {
        usecase "Generate World Video\n(Text + Video Prompt)" as UC_GenVideo
        usecase "Generate Video\nfrom Tokens" as UC_GenFromTokens
        usecase "Run Model with\nGPU Offloading" as UC_Offload
        usecase "Apply Diffusion\nDecoder" as UC_Diffusion
    }

    ' ─── Tokenization ─────────────────────────────────────────
    package "Tokenization" {
        usecase "Encode Video\nto Discrete Tokens" as UC_Encode
        usecase "Decode Tokens\nto Video Frames" as UC_Decode
        usecase "Tokenize Image\nand Text Inputs" as UC_ImageTextTok
        usecase "Embed Vision-Language\nFeatures" as UC_VLEmbed
    }

    ' ─── Data Handling ────────────────────────────────────────
    package "Dataset & Preprocessing" {
        usecase "Load Video Dataset" as UC_LoadDataset
        usecase "Preprocess Video Frames\n(Resize / Crop / Normalize)" as UC_Preprocess
        usecase "Configure Dataset\nParameters" as UC_DataConfig
    }

    ' ─── Configuration & Training ─────────────────────────────
    package "Configuration & Training" {
        usecase "Configure Inference\nParameters" as UC_InferConfig
        usecase "Configure Sampling\nStrategy" as UC_SamplingConfig
        usecase "Configure Diffusion\nDecoder Sampling" as UC_DiffConfig
        usecase "Train Autoregressive\nModel" as UC_Train
        usecase "Monitor Training\nwith Video Sampling" as UC_Monitor
        usecase "Schedule Learning\nRate Warmup" as UC_LRSchedule
    }

}

' ─── Actor → Use Case associations ───────────────────────────
researcher --> UC_GenVideo
researcher --> UC_InferConfig
researcher --> UC_SamplingConfig
researcher --> UC_Encode
researcher --> UC_Decode

datasource --> UC_LoadDataset

training --> UC_Train
training --> UC_Monitor
training --> UC_LRSchedule
training --> UC_DataConfig

' ─── Include / Extend relationships ──────────────────────────
UC_GenVideo ..> UC_GenFromTokens        : <<include>>
UC_GenVideo ..> UC_ImageTextTok         : <<include>>
UC_GenVideo ..> UC_VLEmbed              : <<include>>

UC_GenFromTokens ..> UC_Diffusion       : <<include>>
UC_GenFromTokens ..> UC_Decode          : <<include>>

UC_Offload ..> UC_GenFromTokens         : <<extend>>

UC_Encode ..> UC_ImageTextTok           : <<extend>>

UC_LoadDataset ..> UC_Preprocess        : <<include>>
UC_LoadDataset ..> UC_DataConfig        : <<include>>

UC_Train ..> UC_LoadDataset             : <<include>>
UC_Train ..> UC_InferConfig             : <<include>>
UC_Monitor ..> UC_Train                 : <<extend>>
UC_LRSchedule ..> UC_Train              : <<include>>

UC_Diffusion ..> UC_DiffConfig          : <<include>>
UC_InferConfig ..> UC_SamplingConfig    : <<include>>

@enduml
