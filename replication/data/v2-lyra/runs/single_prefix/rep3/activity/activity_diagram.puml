@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleFontColor #212529
    TitleFontSize 13
}

title Lyra — Autoregressive Video World Generation Pipeline

|Client|
start
:Provide text prompt\nand input video frames;

|ARVideo2WorldGenerationPipeline|
:__init__: load checkpoint,\nconfigure offload & decoder flags;

fork
  |Tokenization|
  :ImageTextTokenizer.encode()\ntext prompt → token embeddings;
fork again
  |Tokenization|
  :DiscreteVideoFSQTokenizer\nencode input video → discrete tokens;
end fork

|ARVideo2WorldGenerationPipeline|
:Call generate(inp_prompt, inp_vid,\nnum_input_frames, seed, sampling_config);

if (offload_network?) then (yes)
  :_run_model_with_offload()\nstream model shards to GPU on demand;
else (no)
  :_run_model()\nrun full model in GPU memory;
endif

|AR Model (Transformer)|
:AutoRegressiveModel.embed_vision_language_features()\nmerge text embeddings + video tokens;
:Transformer.forward()\nautoregressively generate token sequence;
note right
  TransformerBlock per layer:
  • Attention (RoPE, KV-cache)
  • MLP feed-forward
  • RMSNorm
end note

|ARBaseGenerationPipeline|
:generate_video_from_tokens()\nprompt_tokens → latent frames\napply logit clipping, sampling config;

if (disable_diffusion_decoder?) then (yes)
  |Tokenization|
  :CausalDiscreteVideoTokenizer.decode()\nlatent tokens → raw pixel frames;
else (no)
  |Diffusion Decoder|
  :LatentDiffusionDecoderModel\n._add_latent_conditions_to_data_batch();
  :VideoDiffusionDecoderConditioner\n.forward() → condition embedding;
  :DiffusionDecoderGeneralDIT\n.forward() denoising steps (num_steps=35);
  :generate_samples_from_batch()\nguidance scale, seed, state shape;
  |Tokenization|
  :Decode refined latents → pixel frames;
endif

|ARVideo2WorldGenerationPipeline|
if (guardrail check passes?) then (yes)
  :Return np.ndarray video output;
else (no)
  :Return None\n(content blocked by guardrail);
endif

|Client|
:Receive generated video frames;
stop

@enduml
