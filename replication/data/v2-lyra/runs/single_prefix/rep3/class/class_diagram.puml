@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam ArrowColor #495057
skinparam classFontStyle plain

title Lyra — cosmos_predict1 Autoregressive Architecture (Class Diagram)

' ─────────────────── External base classes ───────────────────
abstract class "nn.Module" as NNModule <<external>> {
}
abstract class "torch.nn.Module" as TorchNNModule <<external>> {
}
abstract class "Dataset" as ExtDataset <<external>> {
}
abstract class "TextTokenizer" as ExtTextTokenizer <<external>> {
}
abstract class "BaseWorldGenerationPipeline" as ExtBaseWorldGenPipeline <<external>> {
}
abstract class "GeneralConditioner" as ExtGeneralConditioner <<external>> {
}
abstract class "BaseVideoCondition" as ExtBaseVideoCondition <<external>> {
}
abstract class "DiffusionT2WModel" as ExtDiffusionT2WModel <<external>> {
}
abstract class "GeneralDIT" as ExtGeneralDIT <<external>> {
}
abstract class "McoreColumnParallelLinear" as ExtMcoreColLinear <<external>> {
}
abstract class "McoreRowParallelLinear" as ExtMcoreRowLinear <<external>> {
}
abstract class "McoreVocabParallelEmbedding" as ExtMcoreVocabEmb <<external>> {
}
abstract class "EveryN" as ExtEveryN <<external>> {
}
abstract class "config.Config" as ExtConfigBase <<external>> {
}

' ─────────────────── Callbacks ───────────────────
package "autoregressive.callbacks" {
    class VideoSamplingTeacherForcing {
        +__init__(every_n: int, step_size: int, video_latent_shape: list, ...)
        +on_train_start(model: Model, iteration: int): None
    }
}

' ─────────────────── Configs ───────────────────
package "autoregressive.configs" {
    package "base" {
        class VideoDatasetConfig
        class ModelConfig {
            +__getitem__(item)
        }
        class TrainingModelConfig {
            +__getitem__(item)
        }
        class LambdaLinearWarmupScheduler {
            +__init__(warmup_steps: int, warmup_offset: int, ...)
            +__call__(step)
        }
        class TextTokenizerConfig
        class VideoTokenizerConfig
        class TokenizerConfig
    }
    class Config_AR as "Config" {
        +validate(): None
    }
    package "inference" {
        class DataShapeConfig
        class SamplingConfig
        class DiffusionDecoderSamplingConfig
        class InferenceConfig
    }
}

' ─────────────────── Datasets ───────────────────
package "autoregressive.datasets" {
    class Augmentor {
        +__init__(input_keys: list, output_keys: Optional[list], args: Optional[dict]): None
        +__call__(*args, **kwds): Any
    }
    class ResizeSmallestSideAspectPreserving {
        +__call__(data_dict: dict): dict
    }
    class CenterCrop {
        +__call__(data_dict: dict): dict
    }
    class Normalize {
        +__call__(data_dict: dict): dict
    }
    class VideoDataset {
        +__init__(config: VideoDatasetConfig)
        +__getitem__(index)
        +__len__()
        +__str__()
        +_get_frames(video_path, frame_ids)
    }
}

' ─────────────────── Diffusion Decoder ───────────────────
package "autoregressive.diffusion_decoder" {
    class VideoLatentDiffusionDecoderCondition_Cfg as "VideoLatentDiffusionDecoderCondition\n<conditioner>"
    class VideoDiffusionDecoderConditioner {
        +forward(batch: Dict, override_dropout_rate: Optional[Dict]): VideoLatentDiffusionDecoderCondition
    }
    class Config_DiffDec as "Config\n<diffusion_decoder>" {
    }
    class VideoLatentDiffusionDecoderCondition_Model as "VideoLatentDiffusionDecoderCondition\n<model>"
    class LatentDiffusionDecoderModel {
        +__init__(config)
        +_add_latent_conditions_to_data_batch(data_batch: dict, ...)
        +_get_conditions(data_batch: dict, ...): conditions
        +generate_samples_from_batch(data_batch: Dict, ...): Tensor
    }
    class DiffusionDecoderGeneralDIT {
        +__init__(is_diffusion_decoder: bool, ...)
        +build_patch_embed()
        +initialize_weights()
        +enable_context_parallel(cp_group: ProcessGroup)
        +disable_context_parallel()
    }
}

' ─────────────────── Inference Pipelines ───────────────────
package "autoregressive.inference" {
    class ARBaseGenerationPipeline {
        +__init__(inference_type: str, checkpoint_dir: str, ...)
        +_load_model()
        +_load_diffusion_decoder()
        +_run_model(inp_vid, num_input_frames, seed, sampling_config): Tuple
        +_run_model_with_offload(...): Tuple
    }
    class ARVideo2WorldGenerationPipeline {
        +__init__(checkpoint_dir: str, checkpoint_name: str, ...)
        +generate(inp_prompt: str, inp_vid: Tensor, ...): ndarray
        +_run_model(prompt_embedding, prompt_mask, inp_vid, ...): tuple
        +_run_model_with_offload(...): tuple
    }
}

' ─────────────────── AR Model ───────────────────
package "autoregressive.model" {
    class AutoRegressiveModel {
        +__init__(model: Transformer, tokenizer, config: ModelConfig, ...)
        +embed_vision_language_features(input_ids: Tensor, images: Tensor): Tensor
        +get_num_params(): int
        +load_state_dict(state_dict: Dict, strict: bool, assign: bool)
        +load_ar_model(shard_checkpoint, tokenizer_config)
    }
}

' ─────────────────── Modules ───────────────────
package "autoregressive.modules" {
    class Attention {
        +__init__(n_heads: int, n_kv_heads: int, dim: int, ...)
        +forward(x: Tensor, rope: RotaryPositionEmbedding, input_pos: Tensor, ...): Tensor
        +init_kv_cache(dtype)
        +load_hook(state_dict, prefix)
    }

    class RotaryPositionEmbedding {
        +__init__(dim: int, max_position_embeddings: int, rope_theta: float, ...)
        +compute_freqs(): Tuple[Tensor, Tensor]
        +forward(seq_len: int): Tensor
        +get_inv_freq(device): None
        +get_mscale(scale: float): float
    }
    class RotaryPositionEmbeddingTE {
        +forward(seq_len: int, training_type: str): Tensor
    }
    class RotaryPositionEmbeddingPytorch {
        +forward(q: Tensor, k: Tensor, input_pos: Tensor, seq_len: int): Tuple
        +rotate_half(x: Tensor): Tensor
    }
    class RotaryPositionEmbeddingPytorchV2 {
        +__init__(seq_len: int, training_type: str)
        +create_rope_freqs(seq_len: int, training_type: str): Tensor
        +forward(q: Tensor, k: Tensor, ...): Tuple
    }
    class RotaryPositionEmbeddingPytorchV1 {
        +forward(q: Tensor, k: Tensor, input_pos: Tensor, seq_len: int): Tuple
        +rotate_half(x: Tensor): Tensor
    }
    class SinCosPosEmbAxisTE {
        +__init__(dim: int, latent_shape: List[int], ...)
        +forward(training_type: str): Tensor
    }

    class VocabParallelEmbedding {
        +__init__(num_embeddings: int, embedding_dim: int, precision: str)
        +forward(input_)
    }
    class ColumnParallelLinear {
        +forward(input_: Tensor)
    }
    class RowParallelLinear {
        +forward(input_: Tensor)
    }
    class TrainingVocabParallelEmbedding {
        +__init__(num_embeddings: int, embedding_dim: int, init_method: Callable, ...)
        +forward(input_)
    }

    class MLP {
        +__init__(dim: int, hidden_dim: int, tensor_parallel_size: int)
        +forward(x: Tensor): Tensor
    }
    class TrainingMLP {
        +__init__(dim: int, hidden_dim: int, hidden_dropout: float, ...)
        +forward(x: Tensor): Tensor
        +init_weights(init_std: float)
    }

    class DownSampleBlock {
        +flat_square(x: Tensor): Tensor
        +forward(x)
    }
    class MultimodalProjector {
        +__init__(mm_projector_type: str, in_dim: int, out_dim: int, **kwargs)
        +forward(x: Tensor): Tensor
    }

    class RMSNorm {
        +__init__(dim: int, eps: float, compile: bool)
        +forward(x: Tensor)
        +reset_parameters()
    }
}

' ─────────────────── Networks ───────────────────
package "autoregressive.networks" {
    class TransformerBlock {
        +__init__(layer_id: int, args)
        +forward(x: Tensor, rope: RotaryPositionEmbeddingPytorchV2, ...): Tensor
        +init_weights()
    }
    class Transformer {
        +__init__(params, model_parallel, tokenizer_config, init_weights: bool)
        +_broadcast_pos_emb(pos_emb, tp_group)
        +_create_abs_pos_emb_config()
        +_create_attention_mask(input_pos: Tensor): Optional[Tensor]
        +_create_output_projection(vocab_size: int)
    }

    class VisionTransformer {
        +__init__(dim: int, num_channels: int, patch_size: int, n_layers: int, ...)
        +forward(x: Tensor): Tensor
        +expand_in_channels(new_in_channels: int)
        +get_num_params(): int
    }
    class VisionTransformerBlocks {
        +__init__(n_layers: int, args: Mapping[str, Any])
        +forward(x: Tensor, rope: Callable): Tensor
    }
}

' ─────────────────── Tokenizer ───────────────────
package "autoregressive.tokenizer" {
    class BaseDiscreteVideoFSQTokenizer {
        +__init__(name: str, latent_ch: int, is_bf16: bool, ...)
        +reset_dtype()
    }
    class DiscreteVideoFSQJITTokenizer {
        +__init__(enc_fp: str, dec_fp: str, name: str, ...)
        +load_encoder(enc_fp: str): None
        +load_decoder(dec_fp: str): None
    }
    class DiscreteVideoFSQStateDictTokenizer {
        +__init__(enc_fp: str, dec_fp: str, tokenizer_module: Module, ...)
        +load_encoder_and_decoder(enc_fp, dec_fp, tokenizer_module): None
        +reset_dtype()
    }

    class ImageTextTokenizer {
        +__init__(model_family: str, is_instruct_model: bool, ...)
        +encode(text: Union[str, List], images: ImageInput, ...): List[int]
        +apply_chat_template(conversation, images, ...)
    }

    class CausalConv3d {
        +__init__(chan_in: int, chan_out: int, kernel_size, pad_mode: str)
        +forward(x: Tensor): Tensor
        +_replication_pad(x: Tensor): Tensor
    }
    class CausalHybridUpsample3d {
        +__init__(in_channels: int, spatial_up: bool, temporal_up: bool): None
        +forward(x: Tensor): Tensor
    }
    class CausalHybridDownsample3d {
        +__init__(in_channels: int, spatial_down: bool, temporal_down: bool): None
        +forward(x: Tensor): Tensor
    }
    class CausalResnetBlockFactorized3d {
        +__init__(in_channels: int, out_channels: int, dropout: float, num_groups: int): None
        +forward(x: Tensor): Tensor
    }
    class CausalAttnBlock {
        +__init__(in_channels: int, num_groups: int): None
        +forward(x: Tensor): Tensor
    }
    class CausalTemporalAttnBlock {
        +__init__(in_channels: int, num_groups: int): None
        +forward(x: Tensor): Tensor
    }
    class EncoderFactorized {
        +__init__(in_channels, channels, channels_mult, num_res_blocks, ...): None
        +forward(x: Tensor): Tensor
    }
    class DecoderFactorized {
        +__init__(out_channels, channels, channels_mult, num_res_blocks, ...)
        +forward(z)
    }
    class CausalDiscreteVideoTokenizer {
        +__init__(z_channels: int, z_factor: int, embedding_dim: int): None
        +encode(x)
        +decode(quant)
        +forward(input)
        +to()
    }
}

' ═══════════════════════════════════════════════════════════
'  RELATIONSHIPS
' ═══════════════════════════════════════════════════════════

' Callbacks
VideoSamplingTeacherForcing --|> ExtEveryN

' Configs
Config_AR --|> ExtConfigBase
Config_DiffDec --|> ExtConfigBase

' Datasets
ResizeSmallestSideAspectPreserving --|> Augmentor
CenterCrop --|> Augmentor
Normalize --|> Augmentor
VideoDataset --|> ExtDataset
VideoDataset ..> VideoDatasetConfig : <<uses>>

' Diffusion Decoder
VideoLatentDiffusionDecoderCondition_Cfg --|> ExtBaseVideoCondition
VideoDiffusionDecoderConditioner --|> ExtGeneralConditioner
VideoLatentDiffusionDecoderCondition_Model --|> ExtBaseVideoCondition
LatentDiffusionDecoderModel --|> ExtDiffusionT2WModel
DiffusionDecoderGeneralDIT --|> ExtGeneralDIT

' Inference Pipelines
ARBaseGenerationPipeline --|> ExtBaseWorldGenPipeline
ARVideo2WorldGenerationPipeline --|> ARBaseGenerationPipeline

' AR Model
AutoRegressiveModel --|> TorchNNModule
AutoRegressiveModel o-- Transformer : model
AutoRegressiveModel o-- VisionTransformer : vision_encoder
AutoRegressiveModel o-- MultimodalProjector : mm_projector

' Modules — Attention
Attention --|> NNModule

' Modules — Embeddings
RotaryPositionEmbedding --|> TorchNNModule
RotaryPositionEmbeddingTE --|> RotaryPositionEmbedding
RotaryPositionEmbeddingPytorch --|> RotaryPositionEmbedding
RotaryPositionEmbeddingPytorchV2 --|> RotaryPositionEmbedding
RotaryPositionEmbeddingPytorchV1 --|> RotaryPositionEmbedding
SinCosPosEmbAxisTE --|> TorchNNModule

' Modules — Linear
VocabParallelEmbedding --|> TorchNNModule
ColumnParallelLinear --|> ExtMcoreColLinear
RowParallelLinear --|> ExtMcoreRowLinear
TrainingVocabParallelEmbedding --|> ExtMcoreVocabEmb

' Modules — MLP
MLP --|> NNModule
TrainingMLP --|> NNModule

' Modules — Projector
DownSampleBlock --|> NNModule
MultimodalProjector --|> NNModule

' Modules — Norm
RMSNorm --|> NNModule

' Networks — Transformer
TransformerBlock --|> NNModule
Transformer --|> NNModule
Transformer *-- TransformerBlock : blocks

' Networks — ViT
VisionTransformer --|> NNModule
VisionTransformerBlocks --|> NNModule
VisionTransformer *-- VisionTransformerBlocks : encoder_blocks

' Tokenizer — Discrete Video
BaseDiscreteVideoFSQTokenizer --|> TorchNNModule
DiscreteVideoFSQJITTokenizer --|> BaseDiscreteVideoFSQTokenizer
DiscreteVideoFSQStateDictTokenizer --|> BaseDiscreteVideoFSQTokenizer

' Tokenizer — Image-Text
ImageTextTokenizer --|> ExtTextTokenizer

' Tokenizer — Modules
CausalConv3d --|> NNModule
CausalHybridUpsample3d --|> NNModule
CausalHybridDownsample3d --|> NNModule
CausalResnetBlockFactorized3d --|> NNModule
CausalAttnBlock --|> NNModule
CausalTemporalAttnBlock --|> NNModule
EncoderFactorized --|> NNModule
DecoderFactorized --|> NNModule
EncoderFactorized *-- CausalResnetBlockFactorized3d : res_blocks
EncoderFactorized *-- CausalAttnBlock : attn_blocks
DecoderFactorized *-- CausalResnetBlockFactorized3d : res_blocks

' Tokenizer — Networks
CausalDiscreteVideoTokenizer --|> NNModule
CausalDiscreteVideoTokenizer *-- EncoderFactorized : encoder
CausalDiscreteVideoTokenizer *-- DecoderFactorized : decoder

@enduml
