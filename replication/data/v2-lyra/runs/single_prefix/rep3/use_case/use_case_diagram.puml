@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Cosmos Predict1 — World Video Generation System\nUse Case Diagram

left to right direction

actor "ML Researcher" as researcher
actor "Data Engineer" as data_eng
actor "Checkpoint Storage" as checkpoint <<external>>
actor "Video Storage" as video_store <<external>>

rectangle "Cosmos Predict1 — World Generation System" {

    package "Model Training" {
        usecase "Train Autoregressive\nVideo Model" as UC_Train
        usecase "Configure Training\nScheduler & Optimizer" as UC_Config_Train
        usecase "Monitor Video Samples\n(Teacher Forcing)" as UC_Monitor
    }

    package "Inference & Generation" {
        usecase "Generate Video\nfrom Text Prompt" as UC_T2V
        usecase "Generate Video\nfrom Video Prompt\n(Video-to-World)" as UC_V2V
        usecase "Configure Inference\nParameters" as UC_Cfg_Infer
        usecase "Load Model\nCheckpoint" as UC_Load
    }

    package "Tokenization" {
        usecase "Tokenize Video\nFrames (Discrete FSQ)" as UC_Tokenize
        usecase "Encode Video\nto Latent Tokens" as UC_Encode
        usecase "Decode Latent Tokens\nto Video" as UC_Decode
        usecase "Tokenize Multimodal\nText + Image Input" as UC_MM_Tokenize
    }

    package "Diffusion Decoding" {
        usecase "Refine Video via\nLatent Diffusion Decoder" as UC_Diffusion
        usecase "Condition Diffusion\non Latent State" as UC_Condition
    }

    package "Data Preparation" {
        usecase "Load & Prepare\nVideo Dataset" as UC_Dataset
        usecase "Apply Data\nAugmentation Pipeline" as UC_Augment
        usecase "Resize & Crop\nVideo Frames" as UC_Preprocess
    }

    package "Neural Network Modules" {
        usecase "Run Transformer\nForward Pass" as UC_Transformer
        usecase "Apply Multimodal\nProjection" as UC_Proj
        usecase "Encode Vision\nFeatures (ViT)" as UC_ViT
    }
}

' ML Researcher interactions
researcher --> UC_Train
researcher --> UC_T2V
researcher --> UC_V2V
researcher --> UC_Cfg_Infer
researcher --> UC_Load
researcher --> UC_Monitor

' Data Engineer interactions
data_eng --> UC_Dataset
data_eng --> UC_Augment
data_eng --> UC_Preprocess

' External system interactions
checkpoint --> UC_Load
video_store --> UC_Dataset
UC_T2V --> video_store

' Include relationships
UC_Train ..> UC_Config_Train : <<include>>
UC_Train ..> UC_Monitor : <<include>>
UC_Train ..> UC_Dataset : <<include>>

UC_T2V ..> UC_Load : <<include>>
UC_T2V ..> UC_MM_Tokenize : <<include>>
UC_T2V ..> UC_Transformer : <<include>>
UC_T2V ..> UC_Decode : <<include>>

UC_V2V ..> UC_Load : <<include>>
UC_V2V ..> UC_Tokenize : <<include>>
UC_V2V ..> UC_Transformer : <<include>>
UC_V2V ..> UC_Decode : <<include>>

UC_Tokenize ..> UC_Encode : <<include>>
UC_Tokenize ..> UC_Decode : <<include>>

UC_Transformer ..> UC_Proj : <<include>>
UC_Transformer ..> UC_ViT : <<include>>

' Extend relationships
UC_T2V ..> UC_Diffusion : <<extend>>
UC_V2V ..> UC_Diffusion : <<extend>>
UC_Diffusion ..> UC_Condition : <<include>>

UC_Augment ..> UC_Preprocess : <<include>>

UC_Cfg_Infer ..> UC_T2V : <<extend>>
UC_Cfg_Infer ..> UC_V2V : <<extend>>

@enduml
