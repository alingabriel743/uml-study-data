@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
    StartColor #212529
    EndColor #212529
    BarColor #495057
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Lyra — Video World Generation Inference Pipeline

|User / API|
start

:Provide generation request\n(text prompt + optional video input);

|#E8F4F8 Pipeline Orchestration|

:Instantiate Generation Pipeline\n(checkpoint_dir, checkpoint_name,\nprompt_upsampler_dir);

fork
  :_load_model()\n— load diffusion / AR network;
fork again
  :_load_text_encoder_model()\n— load T5 text encoder;
end fork

if (offload_network enabled?) then (yes)
  :Keep model off GPU;\nnote right: CPU offload mode
else (no)
  :Keep model on GPU;
endif

|User / API|

if (Has video / image input?) then (yes)
  :Submit Video-to-World request\n(image_or_video_path, prompt);
else (no)
  :Submit Text-to-World request\n(prompt, negative_prompt);
endif

|#E8F4F8 Pipeline Orchestration|

if (prompt upsampler enabled?) then (yes)
  :_load_prompt_upsampler_model();
  :Upsample / enhance user prompt\nvia prompt upsampler;
else (no)
  :Use raw user prompt;
endif

|#FFF8E1 Conditioning|

:GeneralConditioner._forward(batch)\n— compute embeddings for all conditioners;

:AbstractEmbModel.random_dropout_input()\n— apply cfg dropout rate;

:get_condition_uncondition(data_batch)\n— produce (condition, uncondition) pair;

if (negative prompt provided?) then (yes)
  :get_condition_with_negative_prompt()\n— override unconditional embedding;
else (no)
  :Use standard null unconditional;
endif

|#E8F4F8 Pipeline Orchestration|

if (Video-to-World mode?) then (yes)

  |#F3E5F5 Diffusion Model (Video2World)|

  :BaseVAE.encode()\n— encode input video frames to latent;

  :DiffusionVideo2WorldGenerationPipeline._run_model()\nor _run_model_with_offload();

  :prepare_latent_condition()\n— condition_state, sigma augmentation;

  :ExtendDiffusionModel.generate_samples_from_batch()\nor DiffusionV2WModel.generate_samples_from_batch();

  :add_condition_video_indicator_and_video_input_mask()\n— mark conditioning frames;

  fork
    :Draw noise epsilon and sigma;
  fork again
    :augment_conditional_latent_frames()\n— sigma augmentation on cond latent;
  end fork

  :Iterative denoising loop (num_steps)\nGeneralDIT.forward(x, timesteps, crossattn_emb);

  :DiffusionModel.denoise()\n— predict clean latent x0;

elseif (Autoregressive mode?) then (yes)

  |#E8F5E9 Autoregressive Model|

  :ARBaseGenerationPipeline._load_model()\n— load AR Transformer;

  :Tokenize input video frames\n→ discrete token sequence;

  :generate_video_from_tokens(\n  prompt_tokens, latent_shape,\n  video_start_boundary, max_gen_len,\n  sampling_config, seed\n);

  :Transformer.forward(\n  tokens, input_pos, inference_params,\n  context, context_mask\n)\n— autoregressive next-token prediction;

  :_run_model() / _run_model_with_offload()\n— full AR sampling loop;

  :Decode generated token sequence\n→ continuous latent tensor;

else (Text-to-World / diffusion)

  |#F3E5F5 Diffusion Model (Text2World)|

  :DiffusionText2WorldGenerationPipeline._run_model()\nor DiffusionT2WModel.generate_samples_from_batch();

  :Iterative denoising loop (num_steps)\nGeneralDIT.forward(x, timesteps, crossattn_emb);

  :DiffusionModel.denoise()\n— predict clean latent x0;

endif

|#FFF8E1 Conditioning|

:_offload_guardrail_models()\n— run safety / guardrail checks on output;

if (Safety check passed?) then (yes)
  :Continue to decode;
else (no)
  :Return safety violation response;
  stop
endif

|#E8F4F8 Pipeline Orchestration|

:BaseVAE.decode()\n— decode latent tensor → pixel frames;

:Convert frames to video\n(ImageioVideoHandler.dump_to_fileobj,\nformat=mp4, fps=17);

if (offload_network was enabled?) then (yes)
  :Offload network back to CPU / disk;
else (no)
  :Retain model on GPU;
endif

|User / API|

:Return generated video\n(np.ndarray frames + metadata);

stop

@enduml
