@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra — Class Diagram (v2-lyra)

' ─────────────────────────────────────────
' External stubs (PyTorch / ABC)
' ─────────────────────────────────────────
abstract class "nn.Module" as NNModule <<external>> {
}
abstract class "ABC" as ABC <<external>> {
}
abstract class "Dataset" as TorchDataset <<external>> {
}
abstract class "BaseStorageBackend" as BaseStorageBackend <<external>> {
}
abstract class "ImaginaireModel" as ImaginaireModel <<external>> {
}
abstract class "WeightTrainingStat" as WeightTrainingStat <<external>> {
}
abstract class "BaseModel" as ExtBaseModel <<external>> {
}

' ─────────────────────────────────────────
package "Core Utilities" {

    class Config {
        +pretty_print(use_color: bool): str
        +to_dict(): dict[str, Any]
        +validate(): None
    }

    class BaseFileHandler {
        +dump_to_path(obj, filepath, mode)
        +load_from_path(filepath, mode)
    }

    abstract class Validator {
        +__init__(default, hidden: bool)
        +__get__(obj, objtype): Any
        +__set__(obj, value)
        +__set_name__(owner, name)
        +json()
    }

    class Callback {
        +__init__(config, trainer)
        +on_after_backward(model_ddp, iteration: int): None
        +on_after_dataloading(iteration: int): None
        +on_after_forward(iteration: int): None
        +on_app_end(): None
    }

    class Model {
        +__init__(): None
        +build_model(): torch.nn.ModuleDict
        +init_optimizer_scheduler(optimizer_config, scheduler_config): tuple
        +on_after_backward(iteration: int): None
        +on_model_init_end(set_barrier): None
        +on_model_init_start(set_barrier): None
    }
}

' ─────────────────────────────────────────
package "Configuration" {

    class "Config (Autoregressive)" as ConfigAR {
        +validate(): None
    }

    class "Config (Diffusion)" as ConfigDiff {
    }

    class "Config (Diffusion Training)" as ConfigDiffTrain {
    }

    class "Config (Multiview)" as ConfigMultiview {
    }

    class "Config (Tokenizer)" as ConfigTokenizer {
    }

    class "Config (Lyra-2)" as ConfigLyra2 {
    }
}

' ─────────────────────────────────────────
package "Checkpointing" {

    abstract class AbstractCheckpointer {
        +__init__(config_checkpoint, config_job, callbacks)
        +_check_checkpoint_exists(checkpoint_path: str): None
        +finalize(): None
        +_read_latest_checkpoint_file(): str | None
        +_write_latest_checkpoint_file(checkpoint_file: str): None
    }
}

' ─────────────────────────────────────────
package "Storage Backends" {

    class Boto3Backend {
        +__init__(s3_credential_path: str, path_mapping: dict)
        +_format_path(filepath: str): str
        +_map_path(filepath): str
        +_replace_prefix(filepath): str
        +copy_if_symlink_fails(src, dst): bool
    }

    class LocalBackend {
        +copy_if_symlink_fails(src, dst): bool
        +copyfile(src, dst): str
        +copyfile_from_local(src, dst): str
        +copyfile_to_local(src, dst, dst_type): str
        +copytree(src, dst): str
    }
}

' ─────────────────────────────────────────
package "Tokenizers / VAE" {

    abstract class BaseVAE {
        +__init__(channel: int, name: str)
    }

    abstract class VideoTokenizerInterface {
    }

    class BasePretrainedImageVAE {
        +__init__(name: str, latent_ch: int, is_image: bool, is_bf16: bool): None
        +register_mean_std(vae_dir: str): None
        +reset_dtype()
    }
}

' ─────────────────────────────────────────
package "Datasets" {

    class "Dataset (Video)" as DatasetVideo {
        +__init__(dataset_dir, sequence_interval, num_frames, video_size)
        +__getitem__(index)
        +__len__()
        +__str__()
        +_get_frames(video_path, frame_ids)
    }

    class "Dataset (Multiview)" as DatasetMultiview {
        +__init__(dataset_dir, sequence_interval, num_frames, view_keys, video_size)
        +__getitem__(index)
        +__len__()
        +__str__()
        +_get_frames(video_path, frame_ids)
    }

    class Provider {
        +__init__(dataset_name, opt, training, num_repeat)
        +__getitem__(idx)
        +__len__()
        +_get_indices_dynamic(idx: int)
        +_get_indices_static(idx: int)
    }

    class Augmentor {
        +__init__(input_keys: list, output_keys: list, args: dict): None
        +__call__(*args, **kwds): Any
    }
}

' ─────────────────────────────────────────
package "Neural Network Modules" {

    class VideoPositionEmb {
        +__init__()
        +disable_context_parallel()
        +enable_context_parallel(cp_group: ProcessGroup)
        +forward(x_B_T_H_W_C: Tensor): Tensor
        +generate_embeddings(B_T_H_W_C: Size, fps): Tensor
    }

    class GeneralDIT {
        +__init__(max_img_h, max_img_w, max_frames, in_channels, out_channels, patch_spatial, patch_temporal): None
        +build_decode_head()
        +build_patch_embed()
        +build_pos_embed()
        +decoder_head(x_B_T_H_W_D, emb_B_D, crossattn_emb, ...): Tensor
    }

    abstract class AbstractEmbModel {
        +__init__()
        +details(): str
        +random_dropout_input(in_tensor: Tensor, dropout_rate, key): Tensor
        +summary(): str
    }

    abstract class GeneralConditioner {
        +__init__(**emb_models)
        +_forward(batch: Dict, override_dropout_rate): Dict
        +get_condition_uncondition(data_batch: Dict): Tuple
        +get_condition_with_negative_prompt(data_batch: Dict): Tuple
    }

    class RotaryPositionEmbedding {
        +__init__(dim: int, max_position_embeddings, rope_theta, apply_yarn, scale, ...)
        +compute_freqs(): Tuple[Tensor, Tensor]
        +forward(seq_len: int): Tensor
        +get_inv_freq(device: torch.device): None
        +get_mscale(scale: float): float
    }

    class Transformer {
        +__init__(params, model_parallel, tokenizer_config, init_weights: bool)
        +_broadcast_pos_emb(pos_emb, tp_group)
        +_create_abs_pos_emb_config()
        +_create_action_projection()
        +_create_attention_mask(input_pos): Optional[Tensor]
    }
}

' ─────────────────────────────────────────
package "Diffusion Models (Lyra-1)" {

    abstract class BaseWorldGenerationPipeline {
        +_load_model(checkpoint_name: str): Any
        +_load_text_encoder_model()
        +_offload_guardrail_models()
        +_offload_text_encoder_model()
        +_run_model(*args, **kwargs): Tensor
    }

    class DiffusionT2WModel {
        +__init__(config)
        +build_model(): torch.nn.ModuleDict
        +_get_conditions(data_batch: dict, is_negative_prompt: bool)
        +generate_samples_from_batch(data_batch, guidance, seed, ...): Tensor
        +set_up_tokenizer(tokenizer_dir: str)
    }

    class DiffusionV2WModel {
        +__init__(config)
        +_augment_noise_with_latent(xt, sigma, condition, ...): tuple
        +_get_conditions(data_batch, ...)
        +_reverse_precondition_input(xt: Tensor, sigma: Tensor): Tensor
        +_reverse_precondition_output(latent, xt, sigma): Tensor
    }

    class DiffusionWorldInterpolatorWModel {
        +__init__(config)
        +_augment_image_dim_inplace(data_batch: Dict): None
        +_normalize_video_databatch_inplace(data_batch: Dict): None
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(...): VideoExtendCondition
    }

    class "DiffusionModel (Image)" as DiffusionModelImage {
        +__init__(config)
        +build_model(): torch.nn.ModuleDict
        +compute_loss_with_epsilon_and_sigma(...): None
        +denoise(xt: Tensor, sigma: Tensor, condition): DenoisePrediction
        +draw_training_sigma_and_epsilon(x0_size: int, condition): Tensor
    }

    class "DiffusionModel (Video)" as DiffusionModelVideo {
        +__init__(config)
        +_augment_image_dim_inplace(data_batch: Dict): None
        +_normalize_video_databatch_inplace(data_batch: Dict): None
        +clip_grad_norm_(max_norm: float)
        +compute_loss_with_epsilon_and_sigma(...): None
    }

    class ExtendDiffusionModel {
        +__init__(config)
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(...): VideoExtendCondition
        +augment_conditional_latent_frames(...): Union[VideoExtendCondition, Tensor]
        +denoise(noise_x, sigma, condition, ...): VideoDenoisePrediction
    }

    class DiffusionText2WorldGenerationPipeline {
        +_load_model()
        +_load_prompt_upsampler_model()
        +_offload_prompt_upsampler_model()
        +_run_model(embedding: Tensor, negative_prompt_embedding): Tensor
        +_run_model_with_offload(...): np.ndarray
    }
}

' ─────────────────────────────────────────
package "Lyra-2 Models" {

    class WANDiffusionModel {
        +__init__(config: T2VModelConfig)
        +add_lora_to_model(adapter_name, lora_rank, lora_alpha, ...)
        +broadcast_split_for_model_parallelsim(...)
        +is_lora_model(model)
        +model_param_stats(): Dict[str, int]
    }

    class Lyra2Model {
        +__init__(config: Lyra2T2VConfig)
        +_apply_camera_controls(cond_latent, ...)
        +_apply_spatial_region_corruption(latents, cond_latent): None
        +_clone_vae_cache(cache_list)
        +_compose_selected_indices(splits, types, ...)
    }

    class Lyra2WanModel {
        +__init__(model_type: str, patch_size, text_len, dim, ...)
        +_patchify_linear(x: Tensor, patch, lin: nn.Linear): Tuple
        +_patchify_lyra2(x, framepack_indices, ...): Tuple
        +_pixelshuffle_tokens(x: Tensor, patch): Tuple
        +copy_weights_to_clean_patch_embeddings(): None
    }

    class "VideoPositionEmb (Lyra-2)" as VideoPositionEmbLyra2 {
        +__init__()
        +_split_for_context_parallel(embeddings)
        +disable_context_parallel()
        +enable_context_parallel(process_group: ProcessGroup)
        +forward(x_B_T_H_W_C: Tensor): Tensor
    }
}

