@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}

title Lyra World Generation System — Use Case Diagram

left to right direction

' ── Actors ──────────────────────────────────────────────
actor "User / Developer" as User
actor "ML Researcher"    as Researcher
actor "Training\nOrchestrator" as TrainOrch
actor "Storage Backend\n(S3 / Local)" as Storage

' ── System boundary ─────────────────────────────────────
rectangle "Lyra World Generation System" {

    ' ── Inference ──────────────────────────────────────
    package "Video Inference" {
        usecase "Generate Video\nfrom Text"               as UC_T2V
        usecase "Generate Video-to-World\n(V2W)"          as UC_V2W
        usecase "Generate Multiview Video"                as UC_MV
        usecase "Extend Video Sequence"                   as UC_EXT
        usecase "Denoise Video Latent"                    as UC_DENOISE
    }

    ' ── Model Configuration ────────────────────────────
    package "Model Management" {
        usecase "Configure Model"                         as UC_CFG
        usecase "Create Video-to-World\nPipeline"         as UC_PIPELINE
        usecase "Apply LoRA\nFine-tuning"                 as UC_LORA
        usecase "Encode / Tokenize Video"                 as UC_TOK
    }

    ' ── Training ───────────────────────────────────────
    package "Model Training" {
        usecase "Train Diffusion Model"                   as UC_TRAIN
        usecase "Load Training Dataset"                   as UC_DATASET
        usecase "Augment Training Data"                   as UC_AUG
        usecase "Monitor Training\nCallbacks"             as UC_CB
        usecase "Manage Optimizer\n& Scheduler"           as UC_OPTIM
    }

    ' ── Data I/O ───────────────────────────────────────
    package "Data I/O" {
        usecase "Load / Save Files\n(Pickle / NumPy / Tar)" as UC_IO
        usecase "Store / Retrieve\nRemote Files (S3)"     as UC_S3
        usecase "Store / Retrieve\nLocal Files"           as UC_LOCAL
    }
}

' ── Actor → Use Case associations ───────────────────────
User       --> UC_T2V
User       --> UC_V2W
User       --> UC_MV
User       --> UC_EXT
User       --> UC_PIPELINE
User       --> UC_TOK

Researcher --> UC_TRAIN
Researcher --> UC_CFG
Researcher --> UC_LORA
Researcher --> UC_PIPELINE

TrainOrch  --> UC_TRAIN
TrainOrch  --> UC_DATASET
TrainOrch  --> UC_CB
TrainOrch  --> UC_OPTIM

Storage    --> UC_S3
Storage    --> UC_LOCAL

' ── Include relationships ────────────────────────────────
UC_T2V      ..> UC_DENOISE   : <<include>>
UC_V2W      ..> UC_DENOISE   : <<include>>
UC_MV       ..> UC_DENOISE   : <<include>>
UC_EXT      ..> UC_DENOISE   : <<include>>

UC_PIPELINE ..> UC_CFG       : <<include>>
UC_PIPELINE ..> UC_TOK       : <<include>>

UC_TRAIN    ..> UC_DATASET   : <<include>>
UC_TRAIN    ..> UC_AUG       : <<include>>
UC_TRAIN    ..> UC_CB        : <<include>>
UC_TRAIN    ..> UC_OPTIM     : <<include>>

UC_IO       ..> UC_LOCAL     : <<include>>

' ── Extend relationships ─────────────────────────────────
UC_LORA     ..> UC_TRAIN     : <<extend>>
UC_MV       ..> UC_V2W       : <<extend>>
UC_EXT      ..> UC_V2W       : <<extend>>
UC_S3       ..> UC_IO        : <<extend>>

@enduml
