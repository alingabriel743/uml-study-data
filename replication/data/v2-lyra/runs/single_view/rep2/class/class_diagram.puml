@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam abstractClass {
    BackgroundColor #EEF2F7
    BorderColor #4A6FA5
}

title Lyra — Class Diagram\n(cosmos_predict1 · lyra_2)

'─────────────────────────────────────────────
' Core Training Infrastructure
'─────────────────────────────────────────────
package "Training Infrastructure" {

    class Model {
        +__init__(): None
        +build_model(): torch.nn.ModuleDict
        +init_optimizer_scheduler(optimizer_config, scheduler_config): tuple
        +on_model_init_start(set_barrier): None
        +on_model_init_end(set_barrier): None
        +on_after_backward(iteration: int): None
    }

    abstract class AbstractCheckpointer {
        +__init__(config_checkpoint, config_job, callbacks)
        +finalize(): None
        #_check_checkpoint_exists(checkpoint_path: str): None
        #_read_latest_checkpoint_file(): str | None
        #_write_latest_checkpoint_file(checkpoint_file: str): None
    }

    class Callback {
        +__init__(config, trainer)
        +on_after_backward(model_ddp, iteration: int): None
        +on_after_dataloading(iteration: int): None
        +on_after_forward(iteration: int): None
        +on_app_end(): None
    }

    class Config {
        +pretty_print(use_color: bool): str
        +to_dict(): dict[str, Any]
        +validate(): None
    }

    abstract class Validator {
        +__init__(default, hidden: bool)
        +__get__(obj, objtype): Any
        +__set__(obj, value): void
        +__set_name__(owner, name): void
        +json()
    }

    class BaseFileHandler {
        +dump_to_path(obj, filepath, mode): void
        +load_from_path(filepath, mode): Any
    }
}

'─────────────────────────────────────────────
' Diffusion Models (Lyra-1 / cosmos_predict1)
'─────────────────────────────────────────────
package "Diffusion Models (Lyra-1)" {

    class DiffusionModel {
        +__init__(config)
        +build_model(): torch.nn.ModuleDict
        +compute_loss_with_epsilon_and_sigma(...): void
        +denoise(xt, sigma, condition): DenoisePrediction
        +draw_training_sigma_and_epsilon(x0_size, condition): torch.Tensor
    }

    class DiffusionT2WModel {
        +__init__(config)
        +build_model(): torch.nn.ModuleDict
        +generate_samples_from_batch(...): Tensor
        +set_up_tokenizer(tokenizer_dir: str): void
        #_get_conditions(data_batch: dict, ...): void
    }

    class DiffusionV2WModel {
        +__init__(config)
        #_augment_noise_with_latent(xt, sigma, condition, ...): tuple
        #_get_conditions(data_batch, ...): void
        #_reverse_precondition_input(xt, sigma): Tensor
        #_reverse_precondition_output(latent, xt, sigma): Tensor
    }

    class DiffusionWorldInterpolatorWModel {
        +__init__(config)
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(...): VideoExtendCondition
        #_augment_image_dim_inplace(data_batch, input_key): None
        #_normalize_video_databatch_inplace(data_batch, input_key): None
    }

    class ExtendDiffusionModel {
        +__init__(config)
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(...): VideoExtendCondition
        +augment_conditional_latent_frames(...): Union[VideoExtendCondition, Tensor]
        +denoise(noise_x, sigma, condition, ...): VideoDenoisePrediction
    }
}

'─────────────────────────────────────────────
' Lyra-2 WAN Models
'─────────────────────────────────────────────
package "WAN Models (Lyra-2)" {

    class WANDiffusionModel {
        +__init__(config: T2VModelConfig)
        +add_lora_to_model(adapter_name, lora_rank, ...): void
