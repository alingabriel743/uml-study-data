        +is_lora_model(model): bool
    }

    class Lyra2Model {
        +__init__(config: Lyra2T2VConfig)
        #_apply_camera_controls(cond_latent, selected_idx, ...): void
        #_apply_spatial_region_corruption(latents, cond_latent): None
        #_clone_vae_cache(cache_list): void
        #_compose_selected_indices(splits, types, ...): void
    }
}

'─────────────────────────────────────────────
' Neural Network Modules
'─────────────────────────────────────────────
package "Neural Network Modules" {

    class GeneralDIT {
        +__init__(max_img_h, max_img_w, max_frames, in_channels, out_channels, ...): None
        +build_patch_embed(): void
        +build_decode_head(): void
        +build_pos_embed(): void
        +decoder_head(x_B_T_H_W_D, emb_B_D, crossattn_emb, ...): torch.Tensor
        #_set_sequence_parallel(status: bool): void
    }

    class VideoPositionEmb {
        +__init__()
        +forward(x_B_T_H_W_C: torch.Tensor): torch.Tensor
        +generate_embeddings(B_T_H_W_C, fps): void
        +enable_context_parallel(process_group): void
        +disable_context_parallel(): void
    }

    class AbstractEmbModel {
        +__init__()
        +details(): str
        +summary(): str
        +random_dropout_input(in_tensor, dropout_rate, key): torch.Tensor
    }

    class GeneralConditioner {
        +__init__(**emb_models)
        #_forward(batch: Dict, override_dropout_rate): Dict
        +get_condition_uncondition(data_batch: Dict): Tuple
        +get_condition_with_negative_prompt(data_batch: Dict): Tuple
    }

    class Transformer {
        +__init__(params, model_parallel, tokenizer_config, init_weights)
        #_create_attention_mask(input_pos): Optional[torch.Tensor]
        #_create_abs_pos_emb_config(): void
        #_create_action_projection(): void
        #_broadcast_pos_emb(pos_emb, tp_group): void
    }

    class RotaryPositionEmbedding {
        +__init__(dim: int, max_position_embeddings, rope_theta, ...)
        +forward(seq_len): torch.Tensor
        +compute_freqs(): Tuple[torch.Tensor, torch.Tensor]
        +get_inv_freq(device): None
        +get_mscale(scale: float): float
    }

    class Lyra2WanModel {
        +__init__(model_type, patch_size, text_len, in_dim, dim, ...)
        #_patchify_linear(x, patch, lin): Tuple[Tensor, Tuple]
        #_patchify_lyra2(x, framepack_indices, framepack_splits, ...): Tuple
        #_pixelshuffle_tokens(x, patch): Tuple[Tensor, Tuple]
        +copy_weights_to_clean_patch_embeddings(): None
    }
}

'─────────────────────────────────────────────
' Tokenizers & VAE
'─────────────────────────────────────────────
package "Tokenizers & VAE" {

    abstract class BaseVAE {
        +__init__(channel: int, name: str)
    }

    class BasePretrainedImageVAE {
        +__init__(name: str, latent_ch: int, is_image: bool, is_bf16: bool, ...)
        +register_mean_std(vae_dir: str): None
        +reset_dtype(): void
    }

    abstract class VideoTokenizerInterface {
        +__init__()
    }
}

'─────────────────────────────────────────────
' Datasets
'─────────────────────────────────────────────
package "Datasets" {

    class Dataset {
        +__init__(dataset_dir, num_frames, video_size, ...)
        +__getitem__(index): dict
        +__len__(): int
        +__str__(): str
        #_get_frames(video_path, frame_ids): void
    }

    class Provider {
        +__init__(dataset_name, opt, training, num_repeat)
        +__getitem__(idx): dict
        +__len__(): int
        #_get_indices_dynamic(idx: int): void
        #_get_indices_static(idx: int): void
    }

    class Augmentor {
        +__init__(input_keys: list, output_keys, args)
        +__call__(*args, **kwds): Any
    }
}

'─────────────────────────────────────────────
' Storage Backends
'─────────────────────────────────────────────
package "Storage Backends" {

    abstract class BaseStorageBackend {
    }

    class LocalBackend {
        +copyfile(src, dst): str
        +copyfile_from_local(src, dst): str
        +copyfile_to_local(src, dst, dst_type): str
        +copytree(src, dst): str
        +copy_if_symlink_fails(src, dst): bool
    }

    class Boto3Backend {
        +__init__(s3_credential_path: str, path_mapping)
        #_format_path(filepath: str): str
        #_map_path(filepath): str
        #_replace_prefix(filepath): str
        +copy_if_symlink_fails(src, dst): bool
    }
}

'─────────────────────────────────────────────
' Inference Pipelines
'─────────────────────────────────────────────
package "Inference Pipelines" {

    abstract class BaseWorldGenerationPipeline {
        #_load_model(checkpoint_name: str): Any
        #_run_model(*args, **kwargs): torch.Tensor
        #_load_text_encoder_model(): void
        #_offload_guardrail_models(): void
        #_offload_text_encoder_model(): void
    }

    class DiffusionText2WorldGenerationPipeline {
        #_load_model(): void
        #_run_model(embedding, negative_prompt_embedding): torch.Tensor
        +_run_model_with_offload(prompt_embedding, negative_prompt_embedding): np.ndarray
        #_load_prompt_upsampler_model(): void
        #_offload_prompt_upsampler_model(): void
    }
}

'═══════════════════════════════════════════════
' Inheritance Relationships
'═══════════════════════════════════════════════

' Training Infrastructure
Config <|-- Config

' Diffusion Model Hierarchy (Lyra-1)
Model <|-- DiffusionModel
DiffusionT2WModel <|-- DiffusionV2WModel
DiffusionV2WModel <|-- DiffusionWorldInterpolatorWModel
DiffusionT2WModel <|-- ExtendDiffusionModel

' WAN Model Hierarchy (Lyra-2)
WANDiffusionModel <|-- Lyra2Model
Lyra2WanModel <|-- Lyra2Model : <<uses>>

' Tokenizers / VAE
BaseVAE <|-- BasePretrainedImageVAE

' Storage
BaseStorageBackend <|-- LocalBackend
BaseStorageBackend <|-- Boto3Backend

' Datasets
Dataset <|-- Provider

' Inference Pipelines
BaseWorldGenerationPipeline <|-- DiffusionText2WorldGenerationPipeline

'═══════════════════════════════════════════════
' Key Associations & Dependencies
'═══════════════════════════════════════════════

' Models depend on network modules
DiffusionModel ..> GeneralDIT           : uses net
DiffusionModel ..> GeneralConditioner   : uses conditioner
DiffusionT2WModel ..> VideoPositionEmb  : uses pos emb
DiffusionT2WModel ..> BasePretrainedImageVAE : uses tokenizer

' Conditioner aggregates embedding models
GeneralConditioner o-- AbstractEmbModel : embeds

' Autoregressive transformer uses rotary emb
Transformer ..> RotaryPositionEmbedding : uses

' WAN model uses Lyra2WanModel backbone
WANDiffusionModel ..> Lyra2WanModel     : wraps
Lyra2Model ..> VideoPositionEmb         : uses pos emb
Lyra2Model ..> BasePretrainedImageVAE   : uses vae

' Pipeline orchestrates model
DiffusionText2WorldGenerationPipeline ..> DiffusionT2WModel : loads & runs

' Dataset processing
Dataset ..> Augmentor   : applies

' Checkpointing uses Config
AbstractCheckpointer ..> Config         : reads config
AbstractCheckpointer ..> Callback       : triggers callbacks

' File I/O
BaseFileHandler ..> BaseStorageBackend  : delegates I/O

' VAE implements tokenizer interface
BasePretrainedImageVAE ..|> VideoTokenizerInterface : implements

@enduml
