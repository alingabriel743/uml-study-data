@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #D0E8FF
    BorderColor #3A7DC9
    FontColor #1A3A5C
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Lyra — World Video Generation System\nUse Case Diagram

left to right direction

' ── Actors ────────────────────────────────────────────────
actor "ML Researcher" as Researcher
actor "Inference User" as InfUser
actor "Training Orchestrator\n(Automated Pipeline)" as TrainOrch
actor "Storage Backend\n(S3 / Local FS)" as Storage
actor "Distributed\nCompute Cluster" as Cluster

' ── System Boundary ────────────────────────────────────────
rectangle "Lyra Video Generation System" {

    ' ── Inference / Generation ──────────────────────────────
    package "Video Generation" {
        usecase "Generate Video\nfrom Text Prompt" as UC_T2V
        usecase "Generate Video\nfrom Image/Condition" as UC_I2V
        usecase "Extend / Continue\nExisting Video" as UC_V2W
        usecase "Generate Multiview\nVideo Sequence" as UC_MV
        usecase "Apply Camera\nControl to Generation" as UC_CAM
        usecase "Run Classifier-Free\nGuidance (CFG)" as UC_CFG
    }

    ' ── Denoising / Diffusion Internals ─────────────────────
    package "Diffusion Pipeline" {
        usecase "Denoise Latent\nwith Sigma Schedule" as UC_DENOISE
        usecase "Embed & Condition\nInput Sequence" as UC_EMBED
        usecase "Compute Diffusion\nLoss" as UC_LOSS
        usecase "Run DIT\nTransformer Blocks" as UC_DIT
        usecase "Sample with\nODE Solver" as UC_SOLVER
    }

    ' ── Tokenization / Latent Space ─────────────────────────
    package "Tokenization & Encoding" {
        usecase "Encode Video to\nLatent Space (VAE)" as UC_ENCODE
        usecase "Decode Latent to\nVideo Frames" as UC_DECODE
        usecase "Apply Video\nPosition Embeddings" as UC_POSEMB
    }

    ' ── Training ────────────────────────────────────────────
    package "Model Training" {
        usecase "Train Diffusion\nModel" as UC_TRAIN
        usecase "Fine-tune with\nLoRA Adapters" as UC_LORA
        usecase "Validate Model\non Held-out Data" as UC_VALID
        usecase "Monitor Training\nCallbacks" as UC_CALLBACK
        usecase "Manage Optimizer\n& LR Scheduler" as UC_OPTIM
    }

    ' ── Data & Configuration ────────────────────────────────
    package "Data & Configuration" {
        usecase "Load Video\nDataset" as UC_DATA
        usecase "Augment Video\nSamples" as UC_AUG
        usecase "Configure Model\nHyperparameters" as UC_CONFIG
        usecase "Create Video2World\nModel Instance" as UC_CREATE
    }

    ' ── Storage / I/O ───────────────────────────────────────
    package "Checkpoint & I/O" {
        usecase "Save / Load\nModel Checkpoint" as UC_CKPT
        usecase "Read / Write\nNumPy Arrays" as UC_NUMPY
        usecase "Read / Write\nPickle Objects" as UC_PICKLE
        usecase "Stream Video\nFiles (Tar/Imageio)" as UC_VIDEO_IO
    }

    ' ── Parallelism ─────────────────────────────────────────
    package "Distributed Execution" {
        usecase "Enable Context\nParallel Processing" as UC_CP
        usecase "Shard Model across\nGPU Devices" as UC_SHARD
        usecase "Broadcast Tensors\nacross Model Parallel" as UC_BCAST
    }
}

' ── Inference User relationships ───────────────────────────
InfUser --> UC_T2V
InfUser --> UC_I2V
InfUser --> UC_V2W
InfUser --> UC_MV
InfUser --> UC_CAM
InfUser --> UC_CONFIG

' ── ML Researcher relationships ────────────────────────────
Researcher --> UC_TRAIN
Researcher --> UC_LORA
Researcher --> UC_CONFIG
Researcher --> UC_CREATE
Researcher --> UC_VALID

' ── Training Orchestrator relationships ────────────────────
TrainOrch --> UC_TRAIN
TrainOrch --> UC_DATA
TrainOrch --> UC_VALID
TrainOrch --> UC_CALLBACK
TrainOrch --> UC_OPTIM
TrainOrch --> UC_CKPT

' ── Storage Backend relationships ──────────────────────────
Storage --> UC_CKPT
Storage --> UC_NUMPY
Storage --> UC_PICKLE
Storage --> UC_VIDEO_IO

' ── Distributed Cluster relationships ──────────────────────
Cluster --> UC_CP
Cluster --> UC_SHARD
Cluster --> UC_BCAST

' ── Include relationships ───────────────────────────────────
UC_T2V       .> UC_CFG        : <<include>>
UC_I2V       .> UC_CFG        : <<include>>
UC_V2W       .> UC_CFG        : <<include>>
UC_MV        .> UC_CFG        : <<include>>

UC_T2V       .> UC_DENOISE    : <<include>>
UC_I2V       .> UC_DENOISE    : <<include>>
UC_V2W       .> UC_DENOISE    : <<include>>
UC_MV        .> UC_DENOISE    : <<include>>

UC_DENOISE   .> UC_DIT        : <<include>>
UC_DENOISE   .> UC_EMBED      : <<include>>
UC_DENOISE   .> UC_SOLVER     : <<include>>

UC_T2V       .> UC_ENCODE     : <<include>>
UC_T2V       .> UC_DECODE     : <<include>>

UC_EMBED     .> UC_POSEMB     : <<include>>

UC_TRAIN     .> UC_LOSS       : <<include>>
UC_TRAIN     .> UC_DATA       : <<include>>
UC_TRAIN     .> UC_CALLBACK   : <<include>>
UC_TRAIN     .> UC_OPTIM      : <<include>>

UC_DATA      .> UC_AUG        : <<extend>>

UC_MV        .> UC_CP         : <<extend>>
UC_TRAIN     .> UC_SHARD      : <<extend>>

UC_CKPT      .> UC_PICKLE     : <<include>>
UC_CKPT      .> UC_NUMPY      : <<extend>>

@enduml
