@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra (cosmos_predict1 + lyra_2) — Class Diagram

' =============================================
' Abstract / External Base Types
' =============================================
abstract class ABC <<abstract>>
abstract class nn_Module <<nn.Module\n(external)>>
abstract class BaseModel <<BaseModel\n(external)>>
abstract class ImaginaireModel <<ImaginaireModel\n(external)>>
abstract class WeightTrainingStat <<WeightTrainingStat\n(external)>>

' =============================================
' Package: cosmos_predict1.utils
' =============================================
package "cosmos_predict1.utils" {

    class Config {
        +pretty_print(use_color: bool): str
        +to_dict(): dict[str, Any]
        +validate(): None
    }

    class SubConfig {
        +validate(): None
    }

    class Model <<nn.Module>> {
        +__init__(): None
        +build_model(): ModuleDict
        +init_optimizer_scheduler(optimizer_config, scheduler_config): tuple
        +on_after_backward(iteration: int): None
        +on_model_init_end(set_barrier: bool): None
        +on_model_init_start(set_barrier: bool): None
    }

    abstract class Validator <<abstract>> {
        +__init__(default, hidden: bool)
        +__get__(obj, objtype): Any
        +__set__(obj, value)
        +__set_name__(owner, name)
        +json()
    }

    class Callback {
        +__init__(config, trainer)
        +on_after_backward(model_ddp: DistributedDataParallel, iteration: int): None
        +on_after_dataloading(iteration: int): None
        +on_after_forward(iteration: int): None
        +on_app_end(): None
    }

    abstract class AbstractCheckpointer <<abstract>> {
        +__init__(config_checkpoint, config_job, callbacks)
        +finalize(): None
        -_check_checkpoint_exists(checkpoint_path: str): None
        -_read_latest_checkpoint_file(): str | None
        -_write_latest_checkpoint_file(checkpoint_file: str): None
    }

    class BaseFileHandler {
        +dump_to_path(obj, filepath, mode): void
        +load_from_path(filepath, mode): void
    }
}

' =============================================
' Package: cosmos_predict1.diffusion.models
' =============================================
package "cosmos_predict1.diffusion.models" {

    class DiffusionT2WModel <<nn.Module>> {
        +__init__(config)
        +build_model(): ModuleDict
        +generate_samples_from_batch(data_batch, guidance, seed, n_sample, num_steps): Tensor
        +set_up_tokenizer(tokenizer_dir: str)
        -_get_conditions(data_batch, is_negative_prompt): Any
    }

    class DiffusionV2WModel {
        +__init__(config)
        -_augment_noise_with_latent(xt, sigma, condition, condition_augment_sigma, seed): tuple
        -_get_conditions(data_batch, is_negative_prompt, condition_latent, num_condition_t): Any
        -_reverse_precondition_input(xt, sigma): Tensor
        -_reverse_precondition_output(latent, xt, sigma): Tensor
    }

    class DiffusionWorldInterpolatorWModel {
        +__init__(config)
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(latent_state, condition): VideoExtendCondition
        -_augment_image_dim_inplace(data_batch): None
        -_normalize_video_databatch_inplace(data_batch): None
    }

    class DiffusionImageModel <<DiffusionModel>> {
        +__init__(config)
        +build_model(): ModuleDict
        +compute_loss_with_epsilon_and_sigma(data_batch, x0, condition, epsilon, sigma)
        +denoise(xt, sigma, condition): DenoisePrediction
        +draw_training_sigma_and_epsilon(x0_size, condition): Tensor
    }

    class DiffusionVideoModel <<DiffusionModel>> {
        +__init__(config)
        +compute_loss_with_epsilon_and_sigma(data_batch, x0, condition, epsilon, sigma)
        +clip_grad_norm_(max_norm: float)
        -_augment_image_dim_inplace(data_batch): None
        -_normalize_video_databatch_inplace(data_batch): None
    }

    class ExtendDiffusionModel {
        +__init__(config)
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(latent_state, condition): VideoExtendCondition
        +augment_conditional_latent_frames(condition, cfg_video_cond_bool, gt_latent): Union
        +denoise(noise_x, sigma, condition): VideoDenoisePrediction
    }
}

' =============================================
' Package: cosmos_predict1.diffusion.networks
' =============================================
package "cosmos_predict1.diffusion.networks" {

    class GeneralDIT <<nn.Module>> {
        +__init__(max_img_h, max_img_w, max_frames, in_channels, out_channels, patch_spatial, patch_temporal): None
        +build_decode_head()
        +build_patch_embed()
        +build_pos_embed()
        +decoder_head(x_B_T_H_W_D, emb_B_D, crossattn_emb, origin_shape, crossattn_mask, adaln_lora): Tensor
    }

    class VideoPositionEmb <<nn.Module>> {
        +__init__()
        +forward(x_B_T_H_W_C: Tensor): Tensor
        +enable_context_parallel(cp_group: ProcessGroup)
        +disable_context_parallel()
        +generate_embeddings(B_T_H_W_C: Size, fps): Any
    }

    class AbstractEmbModel <<nn.Module>> {
        +__init__()
        +details(): str
        +summary(): str
        +random_dropout_input(in_tensor, dropout_rate, key): Tensor
    }

    class GeneralConditioner <<nn.Module>> {
        +__init__(**emb_models)
        +get_condition_uncondition(data_batch: Dict): Tuple
        +get_condition_with_negative_prompt(data_batch: Dict): Tuple
        -_forward(batch, override_dropout_rate): Dict
    }

    class RotaryPositionEmbedding <<nn.Module>> {
        +__init__(dim, max_position_embeddings, rope_theta, apply_yarn, scale)
        +compute_freqs(): Tuple[Tensor, Tensor]
        +forward(seq_len): Tensor
        +get_inv_freq(device: device): None
        +get_mscale(scale: float): float
    }

    class Transformer <<nn.Module>> {
        +__init__(params, model_parallel, tokenizer_config, init_weights: bool)
        -_broadcast_pos_emb(pos_emb, tp_group)
        -_create_abs_pos_emb_config()
        -_create_action_projection()
        -_create_attention_mask(input_pos): Optional[Tensor]
    }
}

' =============================================
' Package: cosmos_predict1.diffusion.vae
' =============================================
package "cosmos_predict1.diffusion.vae" {

    abstract class BaseVAE <<abstract>> {
        +__init__(channel: int, name: str)
    }

    class BasePretrainedImageVAE {
        +__init__(name: str, latent_ch: int, is_image: bool, is_bf16: bool)
        +register_mean_std(vae_dir: str): None
        +reset_dtype()
    }

    abstract class VideoTokenizerInterface <<abstract>>
}

' =============================================
' Package: cosmos_predict1.inference
' =============================================
package "cosmos_predict1.inference" {

    abstract class BaseWorldGenerationPipeline <<abstract>> {
        -_load_model(checkpoint_name: str): Any
        -_load_text_encoder_model()
        -_offload_guardrail_models()
        -_offload_text_encoder_model()
        -_run_model(*args, **kwargs): Tensor
    }

    class DiffusionText2WorldGenerationPipeline {
        -_load_model()
        -_load_prompt_upsampler_model()
        -_offload_prompt_upsampler_model()
        -_run_model(embedding, negative_prompt_embedding): Tensor
        -_run_model_with_offload(prompt_embedding, negative_prompt_embedding): ndarray
    }
}

' =============================================
' Package: cosmos_predict1.datasets
' =============================================
package "cosmos_predict1.datasets" {

    abstract class TorchDataset <<Dataset\n(torch.utils.data)>>

    class VideoDataset <<Dataset>> {
        +__init__(dataset_dir, sequence_interval, num_frames, video_size)
        +__getitem__(index)
        +__len__()
        +__str__()
        -_get_frames(video_path, frame_ids)
    }

    class MultiviewDataset <<Dataset>> {
        +__init__(dataset_dir, sequence_interval, num_frames, view_keys, video_size)
        +__getitem__(index)
        +__len__()
        +__str__()
        -_get_frames(video_path, frame_ids)
    }

    class Provider {
        +__init__(dataset_name, opt, training: bool, num_repeat: int)
        +__getitem__(idx)
        +__len__()
        -_get_indices_dynamic(idx: int)
        -_get_indices_static(idx: int)
    }

    class Augmentor {
        +__init__(input_keys: list, output_keys: list, args: dict)
        +__call__(*args, **kwds): Any
    }
}

' =============================================
' Package: cosmos_predict1.io
' =============================================
package "cosmos_predict1.io" {

    abstract class BaseStorageBackend <<abstract>>

    class LocalBackend {
        +copy_if_symlink_fails(src, dst): bool
        +copyfile(src, dst): str
        +copyfile_from_local(src, dst): str
        +copyfile_to_local(src, dst, dst_type): str
        +copytree(src, dst): str
    }

    class Boto3Backend {
        +__init__(s3_credential_path: str, path_mapping: dict)
        +copy_if_symlink_fails(src, dst): bool
        -_format_path(filepath: str): str
        -_map_path(filepath): str
        -_replace_prefix(filepath): str
    }
}

' =============================================
' Package: lyra_2._src
' =============================================
package "lyra_2._src" {

    class WANDiffusionModel <<ImaginaireModel>> {
        +__init__(config: T2VModelConfig)
        +add_lora_to_model(adapter_name, lora_rank, lora_alpha, lora_target_modules)
        +broadcast_split_for_model_parallelsim(x0, condition, epsilon, sigma)
        +is_lora_model(model): bool
        +model_param_stats(): Dict[str, int]
    }

    class Lyra2Model {
        +__init__(config: Lyra2T2VConfig)
        -_apply_camera_controls(cond_latent, selected_idx, video_indices, camera_w2c, intrinsics)
        -_apply_spatial_region_corruption(latents, cond_latent): None
        -_clone_vae_cache(cache_list)
        -_compose_selected_indices(splits, types, T_hist_total, temporal_selected, spatial_selected)
    }

    class Lyra2WanModel <<WeightTrainingStat>> {
        +__init__(model_type, patch_size, text_len, dim, ffn_dim, freq_dim, text_dim)
        +copy_weights_to_clean_patch_embeddings(): None
        -_patchify_linear(x, patch, lin): Tuple
        -_patchify_lyra2(x, framepack_indices, framepack_splits, framepack_kernel_ids): Tuple
        -_pixelshuffle_tokens(x, patch): Tuple
    }
}

' =============================================
' Inheritance Relationships
' =============================================

' ABC abstract base
ABC <|-- Validator
ABC <|-- AbstractCheckpointer
ABC <|-- BaseWorldGenerationPipeline
ABC <|-- VideoTokenizerInterface
ABC <|-- BaseVAE

' nn.Module base
nn_Module <|-- Model
nn_Module <|-- GeneralDIT
nn_Module <|-- VideoPositionEmb
nn_Module <|-- AbstractEmbModel
nn_Module <|-- GeneralConditioner
nn_Module <|-- RotaryPositionEmbedding
nn_Module <|-- Transformer
nn_Module <|-- DiffusionT2WModel

' Diffusion model hierarchy (Lyra-1)
Model <|-- DiffusionImageModel
Model <|-- DiffusionVideoModel
DiffusionT2WModel <|-- DiffusionV2WModel
DiffusionV2WModel <|-- DiffusionWorldInterpolatorWModel
BaseModel <|-- ExtendDiffusionModel

' VAE hierarchy
BaseVAE <|-- BasePretrainedImageVAE

' Inference hierarchy
BaseWorldGenerationPipeline <|-- DiffusionText2WorldGenerationPipeline

' Storage hierarchy
BaseStorageBackend <|-- LocalBackend
BaseStorageBackend <|-- Boto3Backend

' Dataset hierarchy
TorchDataset <|-- VideoDataset
TorchDataset <|-- MultiviewDataset
TorchDataset <|-- Provider

' Config hierarchy
Config <|-- SubConfig

' Lyra-2 model hierarchy
ImaginaireModel <|-- WANDiffusionModel
WANDiffusionModel <|-- Lyra2Model
WeightTrainingStat <|-- Lyra2WanModel

' =============================================
' Associations & Dependencies
' =============================================

GeneralConditioner *-- AbstractEmbModel : "aggregates embeds"
DiffusionT2WModel o-- GeneralConditioner : "uses conditioner"
DiffusionT2WModel o-- BaseVAE : "tokenizes via"
GeneralDIT ..> VideoPositionEmb : "embeds positions"
Transformer ..> RotaryPositionEmbedding : "uses RoPE"
DiffusionText2WorldGenerationPipeline ..> DiffusionT2WModel : "drives inference"
ExtendDiffusionModel ..> VideoTokenizerInterface : "tokenizes video"
VideoDataset ..> Augmentor : "augments samples"

@enduml
