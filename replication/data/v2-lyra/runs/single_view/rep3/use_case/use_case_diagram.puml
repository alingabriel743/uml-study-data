@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}

title Lyra — World Video Generation System\nUse Case Diagram

left to right direction

actor "ML Researcher" as researcher
actor "Inference User" as inference_user
actor "Training Infrastructure" as training_infra <<external>>
actor "Storage Backend\n(S3 / Local)" as storage <<external>>

rectangle "Lyra Video Generation System" {

    package "Video Generation & Inference" {
        usecase "Generate Video Samples\nfrom Batch" as UC_GEN
        usecase "Generate Multiview\nVideo Samples" as UC_MULTI
        usecase "Extend Video\nSequence" as UC_EXTEND
        usecase "Run World Generation\nPipeline" as UC_PIPELINE
        usecase "Apply Guidance\n& Denoising" as UC_DENOISE
        usecase "Apply Camera Controls\n& Conditioning" as UC_COND
    }

    package "Model Training" {
        usecase "Execute Training Step" as UC_TRAIN
        usecase "Configure Model\n& Hyperparameters" as UC_CONFIG
        usecase "Monitor Training\nCallbacks" as UC_CALLBACK
        usecase "Manage Optimizer\n& Scheduler" as UC_OPTIM
        usecase "Train Autoregressive\nTransformer" as UC_AR_TRAIN
    }

    package "Model & Tokenization" {
        usecase "Create Video-to-World\nModel" as UC_CREATE
        usecase "Apply LoRA\nFine-Tuning" as UC_LORA
        usecase "Encode / Decode\nVideo Tokens (VAE)" as UC_VAE
        usecase "Compute Position\nEmbeddings" as UC_POS
    }

    package "Data Management" {
        usecase "Load Video\nDataset" as UC_DATASET
        usecase "Load / Save Files\n(Pickle, NumPy, Tar)" as UC_IO
        usecase "Access Cloud\nStorage (S3)" as UC_S3
        usecase "Access Local\nFile System" as UC_LOCAL
    }

}

' --- Inference User interactions ---
inference_user --> UC_GEN
inference_user --> UC_MULTI
inference_user --> UC_EXTEND
inference_user --> UC_PIPELINE
inference_user --> UC_COND

' --- ML Researcher interactions ---
researcher --> UC_TRAIN
researcher --> UC_CONFIG
researcher --> UC_CREATE
researcher --> UC_LORA
researcher --> UC_DATASET
researcher --> UC_AR_TRAIN

' --- Training Infrastructure interactions ---
training_infra --> UC_CALLBACK
training_infra --> UC_OPTIM
training_infra --> UC_POS

' --- Storage Backend interactions ---
UC_IO --> storage
UC_S3 --> storage
UC_LOCAL --> storage

' --- Include / Extend relationships ---
UC_GEN ..> UC_DENOISE : <<include>>
UC_MULTI ..> UC_DENOISE : <<include>>
UC_EXTEND ..> UC_DENOISE : <<include>>

UC_PIPELINE ..> UC_GEN : <<include>>
UC_PIPELINE ..> UC_VAE : <<include>>

UC_GEN ..> UC_COND : <<include>>
UC_MULTI ..> UC_COND : <<include>>

UC_TRAIN ..> UC_CALLBACK : <<include>>
UC_TRAIN ..> UC_OPTIM : <<include>>

UC_LORA ..> UC_CREATE : <<extend>>

UC_DATASET ..> UC_IO : <<include>>

UC_S3 ..> UC_IO : <<extend>>
UC_LOCAL ..> UC_IO : <<extend>>

UC_CREATE ..> UC_CONFIG : <<include>>
UC_AR_TRAIN ..> UC_CONFIG : <<include>>

@enduml
