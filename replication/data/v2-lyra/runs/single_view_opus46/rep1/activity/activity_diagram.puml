@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    DiamondBackgroundColor #DEE2E6
    DiamondBorderColor #495057
}
skinparam swimlane {
    BorderColor #6C757D
    TitleFontSize 13
}
skinparam partition {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra World Generation Pipeline -- Activity Diagram

|#E9ECEF|Input Processing|
|#F0F4F8|Safety & Guardrail|
|#EDF7ED|Text Encoding|
|#FFF8E1|Model Inference|
|#F3E5F5|Output Processing|

|Input Processing|
start
:Receive generation request\n(prompt, inference_type, optional input video/image);

if (inference_type?) then (text2world)
    :Set pipeline =\nDiffusionText2WorldGenerationPipeline;
else (video2world)
    :Set pipeline =\nDiffusionVideo2WorldGenerationPipeline\nor ARVideo2WorldGenerationPipeline;
    :Load input video/image\nfrom provided path;
endif

|Input Processing|
:Initialize BaseWorldGenerationPipeline\n(load model, tokenizer, text encoder);

|Safety & Guardrail|
if (guardrail enabled?) then (yes)
    :Run text guardrail\non input prompt;
    if (prompt is safe?) then (yes)
    else (no)
        :Log "Input text prompt is not safe";
        |Output Processing|
        :Return None;
        stop
    endif
else (no)
endif

|Input Processing|
if (prompt upsampler enabled?) then (yes)
    if (inference_type?) then (text2world)
        :Enhance prompt via\nText Prompt Upsampler\n(run_chat_completion);
    else (video2world)
        :Enhance prompt via\nVLM Prompt Upsampler\n(prepare_dialog + run_chat_completion_vlm);
    endif

    |Safety & Guardrail|
    if (guardrail enabled?) then (yes)
        :Run text guardrail\non upsampled prompt;
        if (upsampled prompt is safe?) then (yes)
        else (no)
            :Log "Upsampled text prompt is not safe";
            |Output Processing|
            :Return None;
            stop
        endif
    else (no)
    endif
else (no)
endif

|Text Encoding|
:Encode prompt(s) via T5 Text Encoder\n(CosmosT5TextEncoder.encode_prompts)\n--> prompt_embedding, prompt_mask;

if (negative prompt provided?) then (yes)
    :Encode negative prompt\n--> negative_prompt_embedding;
else (no)
endif

if (offload text encoder?) then (yes)
    :Offload T5 model from GPU\n(free VRAM);
else (no)
endif

|Model Inference|
if (pipeline backend?) then (Diffusion)

    if (inference_type?) then (video2world)
        :Encode conditioning video/image\nvia tokenizer (get_condition_latent)\n--> condition_latent;
    else (text2world)
    endif

    :Prepare video batch\n(get_video_batch: state_shape, data_batch);

    if (inference_type?) then (video2world)
        :generate_world_from_video\n(DiffusionV2WModel.generate_samples_from_batch)\nwith condition_latent + prompt_embedding;
    else (text2world)
        :generate_world_from_text\n(DiffusionT2WModel.generate_samples_from_batch)\nwith prompt_embedding + guidance;
    endif

    :Decode latent sample via tokenizer\n(model.decode --> [B,3,T,H,W])\nNormalize to [0,255] uint8;

else (Autoregressive)

    :Tokenize input video\n(model.tokenizer.tokenize --> data_tokens);
    :Determine context length\nfrom supported context lengths;
    :Generate video tokens autoregressively\n(model.generate with sampling_config);
    :Reshape tokens to [B,T,H,W]\nand decode via video tokenizer;

    if (diffusion decoder enabled?) then (yes)
        :Enhance quality via Diffusion Decoder\n(diffusion_decoder_process_tokens)\nwith T5 embeddings;
    else (no)
    endif

    :prepare_video_batch_for_saving\n(normalize output video);

endif

if (offload network?) then (yes)
    :Offload model from GPU\n(del model, gc.collect, cuda.empty_cache);
else (no)
endif

|Safety & Guardrail|
if (guardrail enabled?) then (yes)
    :Run video guardrail\non generated video;
    if (video is safe?) then (yes)
    else (no)
        :Log "Generated video is not safe";
        |Output Processing|
        :Return None;
        stop
    endif
else (no)
endif

|Output Processing|
:Return generated video\n(np.ndarray [T, H, W, C], uint8)\nand final prompt;
stop

@enduml
