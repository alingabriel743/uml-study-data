@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra Video Generation Framework -- Class Diagram

' ===== External / Framework Base Classes =====
abstract class "nn.Module" as nnModule <<PyTorch>> #E3F2FD {
}
abstract class "torch.utils.data.Dataset" as TorchDataset <<PyTorch>> #E3F2FD {
}

' ===== Configuration =====
package "config" {
    class Config {
        +pretty_print(use_color: bool): str
        +to_dict(): dict[str, Any]
        +validate(): None
    }

    class AutoregressiveConfig <<Config>> {
        +validate(): None
    }

    class DiffusionConfig <<Config>>
    class TokenizerConfig <<Config>>
    class Lyra2Config <<Config>>
}

Config <|-- AutoregressiveConfig
Config <|-- DiffusionConfig
Config <|-- TokenizerConfig
Config <|-- Lyra2Config

' ===== Core Utilities =====
package "utils" {
    class Model {
        +build_model(): ModuleDict
        +init_optimizer_scheduler(optimizer_config, scheduler_config): tuple
        +on_model_init_start(set_barrier): None
        +on_model_init_end(set_barrier): None
        +on_after_backward(iteration): None
    }

    class Callback {
        +__init__(config, trainer)
        +on_after_backward(model_ddp, iteration): None
        +on_after_dataloading(iteration): None
        +on_after_forward(iteration): None
        +on_app_end(): None
    }

    abstract class Validator {
        -default
        -hidden: bool
        +__get__(obj, objtype)
        +__set__(obj, value)
        +__set_name__(owner, name)
        +json()
    }

    abstract class AbstractCheckpointer {
        +__init__(config_checkpoint, config_job, callbacks)
        +finalize(): None
        -_check_checkpoint_exists(path): None
        -_read_latest_checkpoint_file(): str
        -_write_latest_checkpoint_file(file): None
    }

    class BaseFileHandler {
        +dump_to_path(obj, filepath, mode)
        +load_from_path(filepath, mode)
    }
}

nnModule <|-- Model

' ===== Diffusion Training Models =====
package "models.training" {
    class ImageDiffusionModel <<DiffusionModel>> {
        +build_model(): ModuleDict
        +compute_loss_with_epsilon_and_sigma(data_batch, x0, condition, epsilon, sigma)
        +denoise(xt, sigma, condition): DenoisePrediction
        +draw_training_sigma_and_epsilon(x0_size, condition): Tensor
    }

    class VideoDiffusionModel <<DiffusionModel>> {
        -_augment_image_dim_inplace(data_batch): None
        -_normalize_video_databatch_inplace(data_batch): None
        +clip_grad_norm_(max_norm: float)
        +compute_loss_with_epsilon_and_sigma(data_batch, x0, condition, epsilon, sigma)
    }

    class ExtendDiffusionModel {
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(latent_state, condition, num_condition_t): VideoExtendCondition
        +augment_conditional_latent_frames(condition, cfg, gt_latent, ...): Union
        +denoise(noise_x, sigma, condition): VideoDenoisePrediction
    }
}

Model <|-- ImageDiffusionModel
ImageDiffusionModel <|-- VideoDiffusionModel
VideoDiffusionModel <|-- ExtendDiffusionModel

' ===== Diffusion Inference Models =====
package "models.inference" {
    class DiffusionT2WModel {
        +build_model(): ModuleDict
        +generate_samples_from_batch(data_batch, guidance, seed, ...): Tensor
        +set_up_tokenizer(tokenizer_dir: str)
        -_get_conditions(data_batch, is_negative_prompt)
    }

    class DiffusionV2WModel {
        -_augment_noise_with_latent(xt, sigma, condition, ...): tuple
        -_get_conditions(data_batch, condition_latent, ...)
        -_reverse_precondition_input(xt, sigma): Tensor
        -_reverse_precondition_output(latent, xt, sigma): Tensor
    }

    class DiffusionWorldInterpolatorWModel {
        -_augment_image_dim_inplace(data_batch): None
        -_normalize_video_databatch_inplace(data_batch): None
        +add_condition_pose(data_batch, condition): VideoExtendCondition
        +add_condition_video_indicator_and_video_input_mask(latent_state, condition, num_condition_t): VideoExtendCondition
    }
}

nnModule <|-- DiffusionT2WModel
DiffusionT2WModel <|-- DiffusionV2WModel
DiffusionV2WModel <|-- DiffusionWorldInterpolatorWModel

' ===== Lyra-2 Models =====
package "models.lyra2" {
    class ImaginaireModel {
    }

    class WANDiffusionModel {
        +__init__(config: T2VModelConfig)
        +add_lora_to_model(adapter_name, lora_rank, lora_alpha, ...)
        +broadcast_split_for_model_parallelsim(x0, condition, epsilon, sigma)
        +is_lora_model(model)
        +model_param_stats(): Dict[str, int]
    }

    class Lyra2Model {
        +__init__(config: Lyra2T2VConfig)
        -_apply_camera_controls(cond_latent, selected_idx, video_indices, ...)
        -_apply_spatial_region_corruption(latents, cond_latent): None
        -_clone_vae_cache(cache_list)
        -_compose_selected_indices(splits, types, T_hist_total, ...)
    }

    abstract class WeightTrainingStat <<nn.Module, ABC>> {
    }

    class Lyra2WanModel {
        -_patchify_linear(x, patch, lin): tuple
        -_patchify_lyra2(x, framepack_indices, splits, ...): tuple
        -_pixelshuffle_tokens(x, patch): tuple
        +copy_weights_to_clean_patch_embeddings(): None
    }
}

nnModule <|-- ImaginaireModel
ImaginaireModel <|-- WANDiffusionModel
WANDiffusionModel <|-- Lyra2Model
nnModule <|-- WeightTrainingStat
WeightTrainingStat <|-- Lyra2WanModel

' ===== Networks =====
package "networks" {
    class GeneralDIT {
        +__init__(max_img_h, max_img_w, max_frames, in_channels, out_channels, ...)
        +build_decode_head()
        +build_patch_embed()
        +build_pos_embed()
        +decoder_head(x, emb, crossattn_emb, origin_shape, ...): Tensor
    }

    class Transformer {
        +__init__(params, model_parallel, tokenizer_config, init_weights)
        -_broadcast_pos_emb(pos_emb, tp_group)
        -_create_abs_pos_emb_config()
        -_create_action_projection()
        -_create_attention_mask(input_pos): Optional[Tensor]
    }
}

nnModule <|-- GeneralDIT
nnModule <|-- Transformer

' ===== Modules =====
package "modules" {
    abstract class AbstractEmbModel {
        +details(): str
        +random_dropout_input(in_tensor, dropout_rate, key): Tensor
        +summary(): str
    }

    abstract class GeneralConditioner {
        +__init__(**emb_models)
        -_forward(batch, override_dropout_rate): Dict
        +get_condition_uncondition(data_batch): Tuple
        +get_condition_with_negative_prompt(data_batch): Tuple
    }

    class VideoPositionEmb {
        +enable_context_parallel(cp_group: ProcessGroup)
        +disable_context_parallel()
        +forward(x_B_T_H_W_C: Tensor): Tensor
        +generate_embeddings(shape, fps)
    }

    class RotaryPositionEmbedding {
        +__init__(dim, max_position_embeddings, rope_theta, ...)
        +compute_freqs(): Tuple[Tensor, Tensor]
        +forward(seq_len): Tensor
        +get_mscale(scale: float): float
    }

    abstract class BaseVAE {
        +__init__(channel: int, name: str)
    }

    class BasePretrainedImageVAE {
        +__init__(name, latent_ch, is_image, is_bf16)
        +register_mean_std(vae_dir: str): None
        +reset_dtype()
    }

    abstract class VideoTokenizerInterface
}

nnModule <|-- AbstractEmbModel
nnModule <|-- GeneralConditioner
nnModule <|-- VideoPositionEmb
nnModule <|-- RotaryPositionEmbedding
nnModule <|-- BaseVAE
BaseVAE <|-- BasePretrainedImageVAE
BaseVAE ..|> VideoTokenizerInterface

' ===== Data =====
package "data" {
    class MultiviewDataset <<Dataset>> {
        +__getitem__(index)
        +__init__(dataset_dir, sequence_interval, num_frames, view_keys, video_size, ...)
        +__len__()
        -_get_frames(video_path, frame_ids)
    }

    class VideoDataset <<Dataset>> {
        +__getitem__(index)
        +__init__(dataset_dir, sequence_interval, num_frames, video_size, ...)
        +__len__()
        -_get_frames(video_path, frame_ids)
    }

    class Provider {
        +__getitem__(idx)
        +__init__(dataset_name, opt, training, num_repeat)
        +__len__()
        -_get_indices_dynamic(idx: int)
        -_get_indices_static(idx: int)
    }

    class Augmentor {
        +__call__(*args, **kwds): Any
        +__init__(input_keys, output_keys, args): None
    }
}

TorchDataset <|-- MultiviewDataset
TorchDataset <|-- VideoDataset
TorchDataset <|-- Provider

' ===== Storage =====
package "storage" {
    abstract class BaseStorageBackend <<ABCMeta>>

    class LocalBackend {
        +copy_if_symlink_fails(src, dst): bool
        +copyfile(src, dst): str
        +copyfile_from_local(src, dst): str
        +copyfile_to_local(src, dst): str
        +copytree(src, dst): str
    }

    class Boto3Backend {
        +__init__(s3_credential_path, path_mapping)
        -_format_path(filepath): str
        -_map_path(filepath): str
        -_replace_prefix(filepath): str
        +copy_if_symlink_fails(src, dst): bool
    }
}

BaseStorageBackend <|-- LocalBackend
BaseStorageBackend <|-- Boto3Backend

' ===== Pipeline =====
package "pipeline" {
    abstract class BaseWorldGenerationPipeline {
        -_load_model(checkpoint_name): Any
        -_load_text_encoder_model()
        -_offload_guardrail_models()
        -_offload_text_encoder_model()
        -_run_model(*args, **kwargs): Tensor
    }

    class DiffusionText2WorldPipeline {
        -_load_model()
        -_load_prompt_upsampler_model()
        -_offload_prompt_upsampler_model()
        -_run_model(embedding, negative_embedding): Tensor
        -_run_model_with_offload(prompt_embedding, negative_embedding): ndarray
    }
}

BaseWorldGenerationPipeline <|-- DiffusionText2WorldPipeline

' ===== Cross-Package Relationships =====
ImageDiffusionModel ..> GeneralDIT : network
ImageDiffusionModel ..> GeneralConditioner : conditioner
DiffusionT2WModel ..> BaseVAE : tokenizer
DiffusionT2WModel ..> GeneralConditioner : conditioner
GeneralConditioner o-- AbstractEmbModel : emb_models
GeneralDIT *-- VideoPositionEmb : pos_embedding
DiffusionText2WorldPipeline ..> DiffusionT2WModel : runs model
Model ..> Callback : lifecycle hooks
Lyra2Model ..> BasePretrainedImageVAE : vae_cache

@enduml
