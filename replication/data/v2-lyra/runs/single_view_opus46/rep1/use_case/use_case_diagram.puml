@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra: Generative 3D World Models -- Use Case Diagram

left to right direction

actor "ML Researcher" as researcher
actor "HuggingFace\nModel Hub" as hf <<external>>
actor "Cloud Storage\n(S3)" as s3 <<external>>
actor "GPU Cluster\n(Distributed)" as gpu <<external>>

rectangle "Lyra System" {

    rectangle "World Generation (Inference)" as infpkg {
        usecase "Generate World\nfrom Text" as UC_T2W
        usecase "Generate World\nfrom Video" as UC_V2W
        usecase "Generate Multiview\nWorld from Text" as UC_T2W_MV
        usecase "Generate Multiview\nWorld from Video" as UC_V2W_MV
        usecase "Generate 3D Scene\n(Gen3C)" as UC_GEN3C
        usecase "Interpolate\nWorld Frames" as UC_INTERP
        usecase "Generate Video along\nCamera Trajectory" as UC_TRAJ
        usecase "Generate Zoom-In\n/ Zoom-Out Video" as UC_ZOOM
        usecase "Reconstruct 3D\n(Gaussian Splatting)" as UC_RECON
    }

    rectangle "Model Training" as trainpkg {
        usecase "Train Diffusion\nModel" as UC_TRAIN_DIFF
        usecase "Train Autoregressive\nModel" as UC_TRAIN_AR
        usecase "Train Video\nTokenizer" as UC_TRAIN_TOK
        usecase "Fine-tune\nwith LoRA" as UC_LORA
    }

    rectangle "Tokenization" as tokpkg {
        usecase "Encode / Decode\nImages" as UC_TOK_IMG
        usecase "Encode / Decode\nVideos" as UC_TOK_VID
    }

    rectangle "Support Services" as suppkg {
        usecase "Upsample Prompts\n(T5 / VLM)" as UC_PROMPT
        usecase "Apply Content\nGuardrails" as UC_GUARD
        usecase "Compute Quality\nMetrics" as UC_METRICS
        usecase "Download Model\nCheckpoints" as UC_CKPT
        usecase "Manage Training\nCallbacks" as UC_CALLBACK
    }
}

' === Actor connections ===
researcher --> UC_T2W
researcher --> UC_V2W
researcher --> UC_TRAJ
researcher --> UC_ZOOM
researcher --> UC_RECON
researcher --> UC_TRAIN_DIFF
researcher --> UC_TRAIN_AR
researcher --> UC_TRAIN_TOK
researcher --> UC_METRICS
researcher --> UC_CKPT
researcher --> UC_TOK_IMG
researcher --> UC_TOK_VID

hf --> UC_CKPT
s3 ..> UC_TRAIN_DIFF : "data I/O"
s3 ..> UC_TRAIN_AR : "data I/O"
gpu ..> UC_TRAIN_DIFF : "distributed\ntraining"
gpu ..> UC_TRAIN_AR : "distributed\ntraining"
gpu ..> UC_T2W : "model parallel\ninference"

' === Include relationships ===
UC_T2W ..> UC_PROMPT : <<include>>
UC_T2W ..> UC_GUARD : <<include>>
UC_T2W ..> UC_TOK_VID : <<include>>
UC_V2W ..> UC_PROMPT : <<include>>
UC_V2W ..> UC_GUARD : <<include>>
UC_V2W ..> UC_TOK_VID : <<include>>
UC_TRAJ ..> UC_TOK_VID : <<include>>
UC_ZOOM ..> UC_TOK_VID : <<include>>
UC_TRAIN_DIFF ..> UC_CALLBACK : <<include>>
UC_TRAIN_AR ..> UC_CALLBACK : <<include>>
UC_TRAIN_TOK ..> UC_CALLBACK : <<include>>

' === Extend relationships ===
UC_V2W .left.> UC_T2W : <<extend>>
UC_T2W_MV ..> UC_T2W : <<extend>>
UC_V2W_MV ..> UC_V2W : <<extend>>
UC_GEN3C ..> UC_V2W : <<extend>>
UC_INTERP ..> UC_V2W : <<extend>>
UC_LORA ..> UC_TRAIN_DIFF : <<extend>>
UC_RECON ..> UC_ZOOM : <<extend>>

@enduml
