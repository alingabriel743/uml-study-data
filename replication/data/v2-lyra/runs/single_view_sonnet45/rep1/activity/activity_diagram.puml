@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam partition {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra World Generation Activity Flow

|User Request|
start
:Receive Generation Request;

if (Input Type?) then (text)
    :Process Text Input;
    |Text-to-World Pipeline|
    :Load Text Encoder Model;
    :Generate Text Embeddings;
    :Apply Prompt Upsampler;
else (video)
    :Process Video Input;
    |Video-to-World Pipeline|
    :Load Video Input File;
    :Extract Video Frames;
    :Generate Condition Latent;
endif

|Model Loading|
:Check Offload Network Flag;
if (Offload Enabled?) then (yes)
    :Load Model with Offload;
    :_load_model();
    :Setup Offload Configuration;
else (no)
    :Load Model Directly;
    :_load_model();
endif

|Generation Pipeline|
:Initialize Generation Parameters;
note right
    - guidance: float
    - seed: int
    - num_steps: int
    - state_shape: tuple
end note

fork
    :Prepare Positive Condition;
    :Generate Embeddings;
fork again
    :Prepare Negative Prompt;
    :Generate Negative Embeddings;
end fork

:Combine Conditions for CFG;

|Diffusion Process|
:Generate Initial Noise;
:Set Sigma Schedule;

repeat
    :Denoise Step;
    if (Offload Mode?) then (yes)
        :_run_model_with_offload();
        :Move Model to GPU;
        :Execute Forward Pass;
        :Move Model to CPU;
    else (no)
        :_run_model();
        :Execute Forward Pass;
    endif
    :Update Latent State;
    :Compute Next Sigma;
repeat while (More Steps?) is (yes)
->no;

|Post-Processing|
if (Has Diffusion Decoder?) then (yes)
    :Decode Latent to Video;
    :Apply VAE Decoder;
else (no)
    :Return Latent;
endif

|File I/O|
fork
    :Save Output Video;
    :ImageioVideoHandler.dump_to_fileobj();
fork again
    :Save Metadata;
    :PickleHandler.dump_to_path();
fork again
    :Save Numpy Arrays;
    :NumpyHandler.dump_to_path();
end fork

|Result|
:Return Generated Output;
stop

@enduml
