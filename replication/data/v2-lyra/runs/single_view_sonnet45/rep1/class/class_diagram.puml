@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra Video Generation System - Class Diagram

package "Core Models" {
    abstract class Model {
        +on_model_init_end(set_barrier: bool): None
        +on_model_init_start(set_barrier: bool): None
        +init_optimizer_scheduler(): tuple
        +on_after_backward(iteration: int): None
    }

    class DiffusionModel {
        +build_model(): torch.nn.ModuleDict
        +compute_loss_with_epsilon_and_sigma()
        +denoise(xt: Tensor, sigma: Tensor, condition): DenoisePrediction
        +draw_training_sigma_and_epsilon()
    }

    class ExtendDiffusionModel {
        +add_condition_pose()
        +add_condition_video_indicator_and_video_input_mask()
        +augment_conditional_latent_frames()
        +denoise(): VideoDenoisePrediction
    }

    class DiffusionT2WModel {
        +build_model(): torch.nn.ModuleDict
        +generate_samples_from_batch(): Tensor
        +set_up_tokenizer(tokenizer_dir: str)
    }

    class DiffusionV2WModel {
        +_augment_noise_with_latent(): tuple
        +_get_conditions()
        +_reverse_precondition_input(): Tensor
        +_reverse_precondition_output(): Tensor
    }

    class DiffusionWorldInterpolatorWModel {
        +_augment_image_dim_inplace(): None
        +_normalize_video_databatch_inplace(): None
        +add_condition_pose()
        +add_condition_video_indicator_and_video_input_mask()
    }

    class WANDiffusionModel {
        +add_lora_to_model()
        +broadcast_split_for_model_parallelsim()
        +is_lora_model()
        +model_param_stats(): Dict[str, int]
    }

    class Lyra2Model {
        +_apply_camera_controls()
        +_apply_spatial_region_corruption(): None
        +_clone_vae_cache()
        +_compose_selected_indices()
    }

    class Lyra2WanModel {
        +_patchify_linear(): Tuple
        +_patchify_lyra2(): Tuple
        +_pixelshuffle_tokens(): Tuple
        +copy_weights_to_clean_patch_embeddings(): None
    }

    class Transformer {
        +_broadcast_pos_emb()
        +_create_abs_pos_emb_config()
        +_create_action_projection()
        +_create_attention_mask(): Optional[torch.Tensor]
    }
}

package "Neural Network Components" {
    class GeneralDIT {
        -max_img_h: int
        -max_img_w: int
        -max_frames: int
        -in_channels: int
        -out_channels: int
        +build_decode_head()
        +build_patch_embed()
        +build_pos_embed()
        +decoder_head(): torch.Tensor
    }

    class VideoPositionEmb {
        +disable_context_parallel()
        +enable_context_parallel(cp_group: ProcessGroup)
        +forward(x_B_T_H_W_C: Tensor): Tensor
        +generate_embeddings()
    }

    class RotaryPositionEmbedding {
        -dim: int
        -max_position_embeddings: int
        -rope_theta: float
        +compute_freqs(): Tuple[Tensor, Tensor]
        +forward(seq_len: int): Tensor
        +get_inv_freq(device: torch.device): None
        +get_mscale(scale: float): float
    }

    abstract class AbstractEmbModel {
        +details(): str
        +random_dropout_input(): torch.Tensor
        +summary(): str
    }

    abstract class GeneralConditioner {
        +_forward(batch: Dict): Dict
        +get_condition_uncondition(): Tuple
        +get_condition_with_negative_prompt(): Tuple
    }
}

package "VAE & Tokenizers" {
    abstract class BaseVAE {
        -channel: int
        -name: str
    }

    class BasePretrainedImageVAE {
        -latent_ch: int
        -is_image: bool
        -is_bf16: bool
        +register_mean_std(mean_std_fp: str): None
        +reset_dtype()
    }

    abstract class VideoTokenizerInterface
}

package "Data Processing" {
    class Dataset {
        +__getitem__(index)
        +__len__()
        +__str__()
        +_get_frames(video_path, frame_ids)
    }

    class Provider {
        +__getitem__(idx)
        +__len__()
        +_get_indices_dynamic(idx: int)
        +_get_indices_static(idx: int)
    }

    class Augmentor {
        -input_keys: list
        -output_keys: list
        -args: dict
        +__call__(*args, **kwds): Any
    }
}

package "Configuration" {
    class Config {
        +pretty_print(use_color: bool): str
        +to_dict(): dict[str, Any]
        +validate(): None
    }
}

package "Storage & I/O" {
    class BaseFileHandler {
        +dump_to_path(obj, filepath, mode)
        +load_from_path(filepath, mode)
    }

    class LocalBackend {
        +copy_if_symlink_fails(): bool
        +copyfile(src, dst): str
        +copyfile_from_local(src, dst): str
        +copyfile_to_local(src, dst): str
        +copytree(src, dst): str
    }

    class Boto3Backend {
        -s3_credential_path: str
        -path_mapping: dict
        +_format_path(filepath: str): str
        +_map_path(filepath): str
        +_replace_prefix(filepath): str
        +copy_if_symlink_fails(): bool
    }
}

package "Utilities" {
    abstract class Validator {
        -default
        -hidden: bool
        +__get__(obj, objtype)
        +__set__(obj, value)
        +__set_name__(owner, name)
        +json()
    }

    class Callback {
        -config: Config
        -trainer
        +on_after_backward(model_ddp, iteration: int): None
        +on_after_dataloading(iteration: int): None
        +on_after_forward(iteration: int): None
        +on_app_end(): None
    }

    abstract class AbstractCheckpointer {
        -config_checkpoint: CheckpointConfig
        -config_job: JobConfig
        -callbacks
        +_check_checkpoint_exists(checkpoint_path: str): None
        +finalize(): None
        +_read_latest_checkpoint_file(): str
        +_write_latest_checkpoint_file(checkpoint_file: str): None
    }
}

package "Inference Pipeline" {
    abstract class BaseWorldGenerationPipeline {
        +_load_model(checkpoint_name: str): Any
        +_load_text_encoder_model()
        +_offload_guardrail_models()
        +_offload_text_encoder_model()
        +_run_model(*args, **kwargs): torch.Tensor
    }

    class DiffusionText2WorldGenerationPipeline {
        +_load_model()
        +_load_prompt_upsampler_model()
        +_offload_prompt_upsampler_model()
        +_run_model(embedding: Tensor): Tensor
        +_run_model_with_offload(): np.ndarray
    }
}

' Inheritance relationships
DiffusionModel --|> Model
ExtendDiffusionModel --|> Model
DiffusionT2WModel --|> Model
DiffusionV2WModel --|> DiffusionT2WModel
DiffusionWorldInterpolatorWModel --|> DiffusionV2WModel
WANDiffusionModel --|> Model
Lyra2Model --|> WANDiffusionModel
Lyra2WanModel --|> Model

GeneralDIT --|> Model
VideoPositionEmb --|> Model
RotaryPositionEmbedding --|> Model
AbstractEmbModel --|> Model
GeneralConditioner --|> Model

BasePretrainedImageVAE --|> BaseVAE

Transformer --|> Model

DiffusionText2WorldGenerationPipeline --|> BaseWorldGenerationPipeline

Provider --|> Dataset

Validator ..|> ABC
AbstractCheckpointer ..|> ABC
GeneralConditioner ..|> ABC
VideoTokenizerInterface ..|> ABC
BaseVAE ..|> ABC
BaseWorldGenerationPipeline ..|> ABC

' Composition relationships
WANDiffusionModel o-- Config
Callback o-- Config
AbstractCheckpointer o-- Config
DiffusionT2WModel o-- VideoTokenizerInterface
GeneralDIT o-- VideoPositionEmb
Transformer o-- RotaryPositionEmbedding
DiffusionModel o-- GeneralConditioner

' Usage relationships
DiffusionModel ..> Dataset : uses
Augmentor ..> Dataset : transforms
BaseFileHandler ..> LocalBackend : uses
BaseFileHandler ..> Boto3Backend : uses

@enduml
