@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Lyra Video Generation Inference Flow

actor User
participant "DiffusionText2World\nGenerationPipeline" as Pipeline
participant "GeneralConditioner" as Conditioner
participant "AbstractEmbModel" as EmbModel
participant "DiffusionModel" as Model
participant "GeneralDIT" as DIT
participant "VideoPositionEmb" as PosEmb
participant "BasePretrainedImageVAE" as VAE

User -> Pipeline: __init__(checkpoint_dir, checkpoint_name)
activate Pipeline
Pipeline -> Pipeline: _load_model()
activate Pipeline
Pipeline -> Model: load_state_dict(state_dict)
activate Model
Model --> Pipeline: model_loaded
deactivate Model
Pipeline -> Pipeline: _load_text_encoder_model()
activate Pipeline
deactivate Pipeline
deactivate Pipeline
deactivate Pipeline

User -> Pipeline: _run_model(embedding, negative_prompt_embedding)
activate Pipeline

Pipeline -> Conditioner: get_condition_uncondition(data_batch)
activate Conditioner
Conditioner -> Conditioner: _forward(batch)
activate Conditioner
loop for each emb_model
    Conditioner -> EmbModel: random_dropout_input(in_tensor, dropout_rate)
    activate EmbModel
    EmbModel --> Conditioner: processed_tensor
    deactivate EmbModel
end
Conditioner --> Conditioner: conditions_dict
deactivate Conditioner
Conditioner --> Pipeline: (condition, uncondition)
deactivate Conditioner

Pipeline -> Model: generate_samples_from_batch(data_batch, guidance, seed, num_steps)
activate Model

Model -> Model: get_x0_fn_from_batch(data_batch, guidance)
activate Model
deactivate Model

loop num_steps times (denoising)
    Model -> Model: denoise(xt, sigma, condition)
    activate Model

    Model -> DIT: forward(x, timesteps, crossattn_emb, fps, padding_mask)
    activate DIT

    DIT -> DIT: forward_before_blocks(x, timesteps, crossattn_emb)
    activate DIT

    DIT -> PosEmb: forward(x_B_T_H_W_C)
    activate PosEmb
    PosEmb -> PosEmb: generate_embeddings(B_T_H_W_C)
    activate PosEmb
    deactivate PosEmb
    PosEmb --> DIT: position_embeddings
    deactivate PosEmb

    DIT --> DIT: embedded_sequence
    deactivate DIT

    DIT -> DIT: forward_blocks_regular(x, affline_emb, crossattn_emb, rope_emb)
    activate DIT
    loop for each transformer block
        DIT -> DIT: block(x, emb, crossattn_emb, rope_emb)
        activate DIT
        deactivate DIT
    end
    DIT --> DIT: transformed_features
    deactivate DIT

    DIT -> DIT: decoder_head(x_B_T_H_W_D, emb_B_D, crossattn_emb)
    activate DIT
    DIT --> DIT: decoded_output
    deactivate DIT

    DIT --> Model: denoised_prediction
    deactivate DIT

    Model -> Model: compute_loss_with_epsilon_and_sigma(x0, epsilon, sigma)
    activate Model
    deactivate Model

    Model --> Model: updated_xt
    deactivate Model
end

Model --> Pipeline: final_latent_tensor
deactivate Model

Pipeline -> VAE: decode(final_latent_tensor)
activate VAE
VAE -> VAE: reset_dtype()
activate VAE
deactivate VAE
VAE --> Pipeline: video_frames
deactivate VAE

Pipeline --> User: generated_video
deactivate Pipeline

@enduml
