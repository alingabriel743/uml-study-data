@startuml
title Lyra Video Generation System - Use Case Diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}

left to right direction

actor "ML Researcher" as researcher
actor "Video Generation User" as user
actor "Data Scientist" as data_scientist

rectangle "Lyra Video Generation System" {

    ' Training use cases
    usecase "Train Diffusion Model" as UC1
    usecase "Configure Training Pipeline" as UC2
    usecase "Validate Model Performance" as UC3
    usecase "Monitor Training Metrics" as UC4

    ' Generation use cases
    usecase "Generate Video from Text" as UC5
    usecase "Generate Video from Image" as UC6
    usecase "Generate Multiview Video" as UC7
    usecase "Extend Video Sequence" as UC8

    ' Data management use cases
    usecase "Load Video Dataset" as UC9
    usecase "Preprocess Video Data" as UC10
    usecase "Encode Video with VAE" as UC11
    usecase "Decode Latent to Video" as UC12

    ' Model management use cases
    usecase "Save Model Checkpoint" as UC13
    usecase "Load Model Checkpoint" as UC14
    usecase "Apply LoRA Adaptation" as UC15

    ' Conditioning use cases
    usecase "Apply Text Conditioning" as UC16
    usecase "Apply Visual Conditioning" as UC17
    usecase "Configure Position Embeddings" as UC18

    ' File I/O use cases
    usecase "Save Training Data" as UC19
    usecase "Load Model Weights" as UC20
}

' ML Researcher relationships
researcher --> UC1
researcher --> UC2
researcher --> UC3
researcher --> UC4
researcher --> UC13
researcher --> UC15

' Video Generation User relationships
user --> UC5
user --> UC6
user --> UC7
user --> UC8

' Data Scientist relationships
data_scientist --> UC9
data_scientist --> UC10
data_scientist --> UC11
data_scientist --> UC12

' Include relationships - Training pipeline includes
UC1 ..> UC2 : <<include>>
UC1 ..> UC13 : <<include>>
UC1 ..> UC19 : <<include>>
UC3 ..> UC4 : <<include>>

' Include relationships - Generation includes
UC5 ..> UC16 : <<include>>
UC5 ..> UC12 : <<include>>
UC6 ..> UC17 : <<include>>
UC6 ..> UC12 : <<include>>
UC7 ..> UC18 : <<include>>
UC7 ..> UC12 : <<include>>
UC8 ..> UC17 : <<include>>
UC8 ..> UC12 : <<include>>

' Include relationships - Data processing
UC9 ..> UC10 : <<include>>
UC10 ..> UC11 : <<include>>

' Include relationships - Model management
UC1 ..> UC14 : <<extend>>
UC1 ..> UC15 : <<extend>>

' Include relationships - File operations
UC13 ..> UC19 : <<include>>
UC14 ..> UC20 : <<include>>

@enduml
