@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Order Placement and Checkout Flow

|User (Browser)|
start
:Submit order with paid amount\n(POST /OrderServlet?amount=...);

|OrderServlet|
:doGet(): read HttpSession\nattributes: username, password;
if (username == null\nOR password == null?) then (yes)
    :sendRedirect(\n"login.jsp?message=Session Expired");
    stop
else (no)
endif
:parse paidAmount =\nDouble.parseDouble(request.getParameter("amount"));
:instantiate OrderServiceImpl\ncall paymentSuccess(userName, paidAmount);

|OrderServiceImpl|
:status = "Order Placement Failed!";

|CartServiceImpl|
:getAllCartItems(userName)\n[SELECT * FROM cart WHERE username=?];

|OrderServiceImpl|
if (cartItems.size() == 0?) then (yes)
    :return "Order Placement Failed!";
    |OrderServlet|
    :render orderDetails.jsp\nwith failure status message;
    stop
else (no)
endif
:new TransactionBean(userName, paidAmount)\n→ IDUtil.generateTransId()\n→ transId = "T" + yyyyMMddhhmmss\n→ Timestamp = System.currentTimeMillis();
:transactionId = transaction.getTransactionId();

|OrderServiceImpl|
:ordered = true;
fork
    :BEGIN LOOP\nfor each CartBean item in cartItems;
endfork

repeat
    |ProductServiceImpl|
    :getProductPrice(item.getProdId())\n[SELECT price FROM product WHERE prodid=?];
    |OrderServiceImpl|
    :amount = price × item.getQuantity();
    :new OrderBean(transactionId, prodId,\nquantity, amount);
    :addOrder(order)\n[INSERT INTO orders\n(transid, prodid, quantity, amount, shipped=0)];
    if (addOrder failed?) then (yes)
        :ordered = false;
        :break loop;
    else (no)
    endif
    |CartServiceImpl|
    :removeAProduct(userId, prodId)\n[DELETE FROM cart\nWHERE userId=? AND prodId=?];
    |OrderServiceImpl|
    if (removeAProduct failed?) then (yes)
        :ordered = false;
        :break loop;
    else (no)
    endif
    |ProductServiceImpl|
    :sellNProduct(prodId, quantity)\n[UPDATE product SET quantity=quantity-N\nWHERE prodid=?];
    |OrderServiceImpl|
    if (sellNProduct failed?) then (yes)
        :ordered = false;
        :break loop;
    else (no)
    endif
repeat while (more items in cart?) is (yes)
->no;

if (ordered == false?) then (yes)
    :return "Order Placement Failed!"\n(no DB rollback — partial\norder rows may remain);
    |OrderServlet|
    :render orderDetails.jsp\nwith failure status message;
    stop
else (no)
endif

:new OrderServiceImpl().addTransaction(transaction)\n[INSERT INTO transactions\n(transid, username, time, amount)];
if (addTransaction failed?) then (yes)
    :return "Order Placement Failed!";
    |OrderServlet|
    :render orderDetails.jsp\nwith failure status message;
    stop
else (no)
endif

|UserServiceImpl|
:getFName(userName)\n[SELECT fname FROM users WHERE username=?];

|OrderServiceImpl|
:MailMessage.transactionSuccess(\nuserName, firstName, transId, transAmount);

|MailMessage|
:build HTML email body\nwith transId and transAmount;
:JavaMailUtil.sendMail(\nrecipient, subject, htmlBody)\n[Jakarta Mail SMTP];

|OrderServiceImpl|
:status = "Order Placed Successfully!";
:return status;

|OrderServlet|
:setContentType("text/html");
:RequestDispatcher.include(request, response)\n→ forward to orderDetails.jsp;
:pw.println: inject status into\n#message DOM element;

|User (Browser)|
:View order confirmation page\nwith success status;
stop

@enduml
