@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 12
}

title Product Administration Flow

|Admin|
start
:Choose admin action\n(Add / Update / Remove Product);

|Servlet Layer|
:Receive HTTP request\n(doPost → doGet);

if (Session: userType == 'admin'?) then (no)
  :Redirect to login.jsp\n[Access Denied];
  stop
else (yes)
endif

if (Session: userName != null\nAND password != null?) then (no)
  :Redirect to login.jsp\n[Session Expired];
  stop
else (yes)
endif

if (Admin Action?) then (Add Product)

  |Admin|
  :Submit addProduct.jsp form\n(name, type, info, price,\nquantity, image file);

  |Servlet Layer|
  :Parse request params\n(prodName, prodType, prodInfo,\nprodPrice, prodQuantity);
  :Read multipart image Part → InputStream\n[@MultipartConfig maxFileSize=16MB];
  :Instantiate ProductServiceImpl;

  |ProductServiceImpl|
  :IDUtil.generateId() → prodId;
  :Create ProductBean\n(prodId, name, type, info,\nprice, quantity, image);

  |Database|
  :DBUtil.provideConnection();
  :PreparedStatement:\nINSERT INTO product\nVALUES(pid, pname, ptype, pinfo,\npprice, pquantity, image);
  :ps.executeUpdate() → k;

  if (k > 0?) then (yes)
    :status = "Product Added Successfully\nwith Product Id: {id}";
  else (no)
    :status = "Product Updation Failed!";
  endif
  :DBUtil.closeConnection(con, ps);

  |Servlet Layer|
  :RequestDispatcher.forward →\naddProduct.jsp?message={status};

elseif (Admin Action?) then (Update Product)

  |Admin|
  :Submit updateProduct form\n(pid, name, type, info,\nprice, quantity);

  |Servlet Layer|
  :Parse request params\n(prodId, prodName, prodType,\nprodInfo, prodPrice, prodQuantity);
  :Populate ProductBean\n(setProdId, setProdName,\nsetProdType, setProdInfo,\nsetProdPrice, setProdQuantity);
  :Instantiate ProductServiceImpl dao;

  |ProductServiceImpl|
  :Call dao.updateProductWithoutImage\n(prevProductId, updatedProduct);

  if (prodId matches\nupdatedProduct.getProdId()?) then (no)
    :return "Both Products are Different";
    |Servlet Layer|
    :Forward → updateProduct.jsp\n?message={status};
    stop
  else (yes)
  endif

  |Database|
  :getProductQuantity(prevProductId)\n→ prevQuantity\n[SELECT * FROM product WHERE pid=?];
  :DBUtil.provideConnection();
  :PreparedStatement:\nUPDATE product SET pname, ptype,\npinfo, pprice, pquantity\nWHERE pid=?;
  :ps.executeUpdate() → k;

  if (k > 0?) then (yes)
    if (prevQuantity < newQuantity?) then (yes)

      |Notification|
      :DemandServiceImpl.haveDemanded(prodId)\n→ List<DemandBean>;
      repeat
        :UserServiceImpl.getFName(email)\n→ firstName;
        :MailMessage.productAvailableNow\n(email, firstName, prodName, prodId);
        :DemandServiceImpl.removeProduct\n(userName, prodId);
      repeat while (More waiting customers?) is (yes)
      -> no;

      |ProductServiceImpl|
      :status = "Product Updated Successfully!\nAnd Mail sent to waiting customers";

    else (no)
      |ProductServiceImpl|
      :status = "Product Updated Successfully!";
    endif
  else (no)
    |ProductServiceImpl|
    :status = "Product Not available in the store!";
  endif

  |Database|
  :DBUtil.closeConnection(con, ps);

  |Servlet Layer|
  :Forward → updateProduct.jsp\n?prodid={prodId}&message={status};

else (Remove Product)

  |Admin|
  :Trigger remove action\nwith prodid param;

  |Servlet Layer|
  :Extract prodId from request\n(getParameter('prodid'));
  :Instantiate ProductServiceImpl;

  |ProductServiceImpl|
  :Call product.removeProduct(prodId);

  |Database|
  :DBUtil.provideConnection();
  :PreparedStatement ps:\nDELETE FROM product\nWHERE pid=?;
  :ps.executeUpdate() → k;

  if (k > 0?) then (yes)
    :status = "Product Removed Successfully!";
    :PreparedStatement ps2:\nDELETE FROM usercart\nWHERE prodid=?\n[cascade: remove from all user carts];
    :ps2.executeUpdate();
  else (no)
    :status = "Error: " + message;
  endif
  :DBUtil.closeConnection(con, ps, ps2);

  |Servlet Layer|
  :Forward → removeProduct.jsp\n?message={status};

endif

|Admin|
:View result message\nin admin panel;
stop

@enduml
