@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #E6AC00
    DiamondFontColor #212529
    StartColor #28A745
    EndColor #DC3545
    BarColor #495057
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleBorderColor #6C757D
    TitleFontColor #343A40
    TitleFontSize 13
}
skinparam note {
    BackgroundColor #EAF4FF
    BorderColor #4A90D9
    FontColor #1A4D80
}
skinparam ArrowColor #495057
skinparam ArrowFontColor #343A40

title Shipment Processing and Demand Notification Flow

' ─────────────────────────────────────────────
' FLOW 1 — Shipment Processing
' ─────────────────────────────────────────────

|Admin / Browser|
start
note right
  **FLOW 1: Shipment Processing**
  Admin marks an order as shipped
end note
:Trigger GET/POST /ShipmentServlet\n(orderid, prodid, userid, amount);

|ShipmentServlet|
:Get HttpSession → read **userType** attribute;
if (userType == null?) then (yes)
  :sendRedirect('login.jsp\n?message=Access Denied');
  detach
else (no)
endif
:Extract request params:\norderId, prodId, userName, amount;

|OrderServiceImpl|
:shipNow(orderId, prodId);
:DBUtil.provideConnection();
:UPDATE orders SET shipped=1\nWHERE orderid=? AND prodid=?\nAND shipped=0;
if (DB rows updated > 0?) then (yes)
  :status = 'Order Has been\nshipped successfully!!';
else (no)
  :status = **'FAILURE'**;
endif
:Return status string;

|ShipmentServlet|
if (status == 'FAILURE'?) then (yes)
  :Set pagename = 'unshippedItems.jsp';
else (no)
  :Set pagename = 'shippedItems.jsp';
  :Fetch firstName via\nUserServiceImpl.getFName(userName);

  |Email Services\n(MailMessage & JavaMailUtil)|
  :MailMessage.orderShipped(\nuserName, firstName,\norderId, amount);
  :Build HTML shipment\nconfirmation email body;
  :JavaMailUtil.sendMail(\nrecipient, subject, htmlBody);

  |ShipmentServlet|
endif
:RequestDispatcher.include(pagename);
:Write JS script to set\nstatus message in DOM;
stop

' ─────────────────────────────────────────────
' FLOW 2 — Demand Notification (Product Restocked)
' ─────────────────────────────────────────────

|Admin / Browser|
start
note right
  **FLOW 2: Demand Notification**
  Admin increases product stock —
  waiting customers are auto-notified
end note
:Submit product update form\n(new quantity > previous quantity);

|ProductServiceImpl|
:DBUtil.provideConnection();
:UPDATE product SET prodQuantity=...\nWHERE pid=?;
if (rows > 0 AND\nprevQuantity < newQuantity?) then (yes — stock increased)

  |DemandServiceImpl|
  :haveDemanded(prevProductId);
  :SELECT * FROM user_demand\nWHERE prodid=?;
  :Return List<DemandBean>\n(userName, prodId, demandQty);

  |ProductServiceImpl|
  if (demandList is empty?) then (yes)
    :No waiting customers —\nskip notification;
  else (no)
    :Iterate over each DemandBean;
    repeat

      |ProductServiceImpl|
      :Fetch firstName via\nUserServiceImpl.getFName\n(demand.getUserName());

      |Email Services\n(MailMessage & JavaMailUtil)|
      :MailMessage.productAvailableNow(\nuserName, firstName,\nprodName, prodId);
      :Build HTML 'product\navailable' email body;
      :JavaMailUtil.sendMail()\n[MessagingException caught —\nlog to stdout, not propagated];

      |DemandServiceImpl|
      :removeProduct(\ndemand.getUserName(), prevProductId);
      :SELECT check → DELETE FROM user_demand\nWHERE username=? AND prodid=?;
      if (delete succeeds?) then (yes)
        :Append '...Mail sent to\ncustomers who were waiting!'\nto status;
      else (no)
      endif

      |ProductServiceImpl|
    repeat while (more DemandBeans in list?) is (yes)
    -> no more;
  endif
else (no — quantity not increased)
  :Skip demand notification;
endif
:Return product update status;
stop

' ─────────────────────────────────────────────
' FLOW 3 — Contact / Fans Message
' ─────────────────────────────────────────────

|User / Browser|
start
note right
  **FLOW 3: Contact / Fans Message**
  User sends a message or feedback
  to the site admin
end note
:Submit contact form\nGET/POST /fansMessage\n(name, email, comments);

|FansMessage Servlet|
:Extract name, email,\ncomments from request params;
:Build HTML fan-message body\nwith sender details;

|Email Services\n(MailMessage & JavaMailUtil)|
:MailMessage.sendMessage(\n'admin@gmail.com',\n'Fans Message | name | email',\nhtmlBody);
:JavaMailUtil.sendMail()\n[MessagingException → return 'FAILURE'];

|FansMessage Servlet|
if (sendMessage() == 'SUCCESS'?) then (yes)
  :message = 'Comments Sent\nSuccessfully';
else (no)
  :message = 'Failed: Please Configure\nmailer.email and password...';
endif
:RequestDispatcher.include('index.jsp');
:response.getWriter().print\nJS alert(message);
stop

@enduml
