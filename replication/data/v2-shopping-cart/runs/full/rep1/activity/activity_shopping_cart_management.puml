@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}
skinparam note {
    BackgroundColor #E8F4FD
    BorderColor #3498DB
}

title Shopping Cart Management Flow

|Customer (Browser)|
|Servlet Layer|
|CartServiceImpl|
|ProductServiceImpl|
|DemandServiceImpl|

|Customer (Browser)|
start
:Initiate cart action;

if (Action?) then (Add to Cart\nGET /AddtoCart?pid&pqty)

  |Servlet Layer|
  note right: AddtoCart.doGet
  :Validate session\n(username, password, usertype='customer');
  if (Session valid?) then (no)
    :Redirect to login.jsp\n[Session Expired];
    stop
  endif

  :Extract prodId from param 'pid'\nExtract pQty from param 'pqty';

  |CartServiceImpl|
  :getProductCount(userId, prodId)\n→ cartQty (existing cart quantity);

  |ProductServiceImpl|
  :getProductDetails(prodId)\n→ product (name, availableQty);

  |Servlet Layer|
  :pQty = pQty + cartQty\n(total = newly requested + already in cart);

  if (pQty == cartQty?) then (yes\nrequested qty = 0)

    |CartServiceImpl|
    :removeProductFromCart(userId, prodId)\nDecrement by 1; keep if qty > 0,\ndelete row if qty reaches 0;

    |Servlet Layer|
    :Forward → userHome.jsp;
    stop

  else (no\nproceeed with stock check)
  endif

  if (availableQty < pQty?) then (yes\ninsufficient stock)

    if (availableQty == 0?) then (yes\ncompletely out of stock)
      |Servlet Layer|
      :status = "Out of Stock"\n(skip cart update);
    else (no\npartial stock available)
      |CartServiceImpl|
      :updateProductToCart(userId, prodId, availableQty)\n(cap quantity at available stock);
    endif

    |DemandServiceImpl|
    :addProduct(DemandBean(userId, prodId, deficit))\nRecord demand for unfulfilled quantity;

    |Servlet Layer|
    :Forward → cartDetails.jsp\nwith stock-limit status message;
    stop

  else (no\nstock sufficient)

    |CartServiceImpl|
    :updateProductToCart(userId, prodId, pQty)\nUpsert cart row:\n  INSERT if new item\n  UPDATE if item exists\n  DELETE if qty = 0;

    |Servlet Layer|
    :Forward → userHome.jsp;
    stop

  endif

else (Update Quantity\nGET /UpdateToCart?pid&pqty)

  |Servlet Layer|
  note right: UpdateToCart.doGet
  :Validate session\n(username, password);
  if (Session valid?) then (no)
    :Redirect to login.jsp\n[Session Expired];
    stop
  endif

  :Extract prodId from param 'pid'\nExtract pQty from param 'pqty';

  |ProductServiceImpl|
  :getProductDetails(prodId)\n→ product (name, availableQty);

  |Servlet Layer|
  if (availableQty < pQty?) then (yes\ninsufficient stock)

    |CartServiceImpl|
    :updateProductToCart(userId, prodId, availableQty)\n(cap quantity at available stock);

    |DemandServiceImpl|
    :addProduct(DemandBean(userId, prodId, deficit))\nRecord demand for unfulfilled quantity;

    |Servlet Layer|
    :Forward → cartDetails.jsp\nwith stock-limit message;
    stop

  else (no\nstock sufficient)

    |CartServiceImpl|
    :updateProductToCart(userId, prodId, pQty)\nUpsert cart row (INSERT / UPDATE / DELETE);

    |Servlet Layer|
    :Forward → cartDetails.jsp;
    stop

  endif

endif

@enduml
