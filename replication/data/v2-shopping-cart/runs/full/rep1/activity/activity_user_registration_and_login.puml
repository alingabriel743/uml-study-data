@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
    StartColor #212529
    EndColor #212529
}

skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title User Registration and Login Flow

|User (Browser)|
start

:Navigate to Registration or Login page;

fork

' ============================================================
' REGISTRATION FLOW
' ============================================================

|User (Browser)|
:Submit registration form\n(username, mobile, email, address,\npincode, password, confirmPassword);

|RegisterSrv|
:doGet(): extract form parameters;

if (password == confirmPassword?) then (no)
    :Set status = "Password not matching!";
    |User (Browser)|
    :Forward to register.jsp\n[message=status];
    stop
else (yes)
    :Create UserBean\n(userName, mobileNo, emailId,\naddress, pinCode, password);
endif

|UserServiceImpl|
:isRegistered(emailId)\nSELECT * FROM user WHERE email=?;

|DBUtil|
:provideConnection() → DB query;

|UserServiceImpl|
if (Email already registered?) then (yes)
    :Return "Email Id Already Registered!";
    |RegisterSrv|
    :Forward to register.jsp\n[message=status];
    |User (Browser)|
    :Display error message;
    stop
else (no)
endif

|DBUtil|
:provideConnection() → INSERT INTO user\n(email, name, mobile, address, pincode, password);

if (Insert successful? (k > 0)) then (yes)
    |MailMessage|
    :registrationSuccess(email, firstName)\nSend welcome email notification;
    |UserServiceImpl|
    :Return "User Registered Successfully!";
else (no)
    |UserServiceImpl|
    :Return "User Registration Failed!" / Error message;
endif

|RegisterSrv|
:Forward to register.jsp\n[message=status];

|User (Browser)|
:Display registration result;
stop

fork again

' ============================================================
' LOGIN FLOW
' ============================================================

|User (Browser)|
:Submit login form\n(username, password, usertype);

|LoginSrv|
:doGet(): extract parameters\n(username, password, usertype);

if (usertype == "admin"?) then (yes)

    if (username == "admin@gmail.com"\nAND password == "admin"?) then (yes)
        |HttpSession|
        :setAttribute(username, password, usertype);
        |User (Browser)|
        :Forward to adminViewProduct.jsp\n(Admin Dashboard);
        stop
    else (no)
        |LoginSrv|
        :RequestDispatcher.include()\nlogin.jsp [message=status];
        |User (Browser)|
        :Display login error;
        stop
    endif

else (no — customer)

    |UserServiceImpl|
    :isValidCredential(userName, password)\nSELECT from user WHERE email=? AND password=?;

    |DBUtil|
    :provideConnection() → DB query;

    |UserServiceImpl|
    if (Credentials valid? (status == "valid")) then (yes)
        :getUserDetails(userName, password)\nFetch full UserBean from DB;
        |HttpSession|
        :setAttribute(userdata, username,\npassword, usertype);
        |User (Browser)|
        :Forward to userHome.jsp\n(Customer Home);
        stop
    else (no)
        |LoginSrv|
        :Forward to login.jsp\n[message=status];
        |User (Browser)|
        :Display login error;
        stop
    endif

endif

fork again

' ============================================================
' LOGOUT FLOW
' ============================================================

|User (Browser)|
:Trigger logout action;

|LogoutSrv|
:doGet(): get current HttpSession;

|HttpSession|
:setAttribute("username", null);
:setAttribute("password", null);
:setAttribute("usertype", null);
:setAttribute("userdata", null);

|LogoutSrv|
:Forward to login.jsp\n[message=Successfully Logged Out!];

|User (Browser)|
:Display login page with success message;
stop

end fork

@enduml
