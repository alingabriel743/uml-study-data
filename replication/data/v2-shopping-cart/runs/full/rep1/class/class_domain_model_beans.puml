@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Domain Model — Data Beans

interface Serializable <<java.io.Serializable>> {
}

package "com.shashi.beans" {

    class UserBean {
        -name: String
        -mobile: Long
        -email: String
        -address: String
        -pinCode: int
        -password: String
        --
        +UserBean()
        +UserBean(userName: String, mobileNo: Long, emailId: String,\n  address: String, pinCode: int, password: String)
        +getName(): String
        +setName(name: String): void
        +getEmail(): String
        +setEmail(email: String): void
        +getMobile(): Long
        +setMobile(mobile: Long): void
        +getAddress(): String
        +setAddress(address: String): void
        +getPinCode(): int
        +setPinCode(pinCode: int): void
        +getPassword(): String
        +setPassword(password: String): void
    }

    class ProductBean {
        -prodId: String
        -prodName: String
        -prodType: String
        -prodInfo: String
        -prodPrice: double
        -prodQuantity: int
        -prodImage: InputStream
        --
        +ProductBean()
        +ProductBean(prodId: String, prodName: String, prodType: String,\n  prodInfo: String, prodPrice: double, prodQuantity: int, prodImage: InputStream)
        +getProdId(): String
        +setProdId(prodId: String): void
        +getProdName(): String
        +setProdName(prodName: String): void
        +getProdType(): String
        +setProdType(prodType: String): void
        +getProdInfo(): String
        +setProdInfo(prodInfo: String): void
        +getProdPrice(): double
        +setProdPrice(prodPrice: double): void
        +getProdQuantity(): int
        +setProdQuantity(prodQuantity: int): void
        +getProdImage(): InputStream
        +setProdImage(prodImage: InputStream): void
    }

    class CartBean {
        +userId: String
        +prodId: String
        +quantity: int
        --
        +CartBean()
        +CartBean(userId: String, prodId: String, quantity: int)
        +getUserId(): String
        +setUserId(userId: String): void
        +getProdId(): String
        +setProdId(prodId: String): void
        +getQuantity(): int
        +setQuantity(quantity: int): void
    }

    note right of CartBean
        Fields are public (not private).
        Acts as join entity between
        UserBean and ProductBean.
    end note

    class OrderBean {
        -transactionId: String
        -productId: String
        -quantity: int
        -amount: Double
        -shipped: int
        --
        +OrderBean()
        +OrderBean(transactionId: String, productId: String,\n  quantity: int, amount: Double)
        +OrderBean(transactionId: String, productId: String,\n  quantity: int, amount: Double, shipped: int)
        +getTransactionId(): String
        +setTransactionId(transactionId: String): void
        +getProductId(): String
        +setProductId(productId: String): void
        +getQuantity(): int
        +setQuantity(quantity: int): void
        +getAmount(): Double
        +setAmount(amount: Double): void
        +getShipped(): int
        +setShipped(shipped: int): void
    }

    note right of OrderBean
        shipped: 0 = pending,
        non-zero = shipped.
        One row per product
        per transaction.
    end note

    class OrderDetails <<read-model DTO>> {
        -orderId: String
        -productId: String
        -prodName: String
        -qty: String
        -amount: String
        -shipped: int
        -time: Timestamp
        -prodImage: InputStream
        --
        +OrderDetails()
        +getOrderId(): String
        +setOrderId(orderId: String): void
        +getProductId(): String
        +setProductId(productId: String): void
        +getProdName(): String
        +setProdName(prodName: String): void
        +getQty(): String
        +setQty(qty: String): void
        +getAmount(): String
        +setAmount(amount: String): void
        +getShipped(): int
        +setShipped(shipped: int): void
        +getTime(): Timestamp
        +setTime(time: Timestamp): void
        +getProdImage(): InputStream
        +setProdImage(prodImage: InputStream): void
    }

    note right of OrderDetails
        Aggregates OrderBean +
        ProductBean + TransactionBean
        data for UI display.
        qty and amount stored as String.
    end note

    class TransactionBean {
        -transactionId: String
        -userName: String
        -transDateTime: Timestamp
        -transAmount: double
        --
        +TransactionBean()
        +TransactionBean(userName: String, transAmount: double)
        +TransactionBean(transactionId: String, userName: String,\n  transAmount: double)
        +TransactionBean(userName: String, transDateTime: Timestamp,\n  transAmount: double)
        +TransactionBean(transactionId: String, userName: String,\n  transDateTime: Timestamp, transAmount: double)
        +getTransactionId(): String
        +setTransactionId(transactionId: String): void
        +getUserName(): String
        +setUserName(userName: String): void
        +getTransDateTime(): Timestamp
        +setTransDateTime(transDateTime: Timestamp): void
        +getTransAmount(): double
        +setTransAmount(transAmount: double): void
    }

    class DemandBean {
        -userName: String
        -prodId: String
        -demandQty: int
        --
        +DemandBean()
        +DemandBean(userName: String, prodId: String, demandQty: int)
        +getUserName(): String
        +setUserName(userName: String): void
        +getProdId(): String
        +setProdId(prodId: String): void
        +getDemandQty(): int
        +setDemandQty(demandQty: int): void
    }

    note right of DemandBean
        Records user demand
        for out-of-stock products.
    end note
}

package "com.shashi.utility" {
    class IDUtil {
        +generateId(): String
        +generateTransId(): String
    }
}

' All beans implement Serializable
UserBean ..|> Serializable
ProductBean ..|> Serializable
CartBean ..|> Serializable
OrderBean ..|> Serializable
OrderDetails ..|> Serializable
TransactionBean ..|> Serializable
DemandBean ..|> Serializable

' TransactionBean uses IDUtil to auto-generate IDs and timestamps
TransactionBean ..> IDUtil : uses (auto-generates transactionId)

' Logical FK relationships (all string-based cross-references)
CartBean ..> UserBean : userId → email
CartBean ..> ProductBean : prodId → prodId
OrderBean ..> TransactionBean : transactionId → transactionId
OrderBean ..> ProductBean : productId → prodId
OrderDetails ..> TransactionBean : orderId → transactionId
OrderDetails ..> ProductBean : productId → prodId
TransactionBean ..> UserBean : userName → email
DemandBean ..> UserBean : userName → email
DemandBean ..> ProductBean : prodId → prodId

@enduml
