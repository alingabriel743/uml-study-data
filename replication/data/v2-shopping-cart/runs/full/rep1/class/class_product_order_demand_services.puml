@startuml class_product_order_demand_services

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #D8E8F8
    BorderColor #3A7BD5
    FontColor #212529
}

title Product, Order, Demand and Transaction Service Layer

' ─────────────────────────────────────────────────
' Service Interfaces
' ─────────────────────────────────────────────────
package "com.shashi.service" {

    interface ProductService {
        +addProduct(prodName: String, prodType: String, prodInfo: String,\n  prodPrice: double, prodQuantity: int, prodImage: InputStream): String
        +addProduct(product: ProductBean): String
        +removeProduct(prodId: String): String
        +updateProduct(prevProduct: ProductBean, updatedProduct: ProductBean): String
        +updateProductPrice(prodId: String, updatedPrice: double): String
        +getAllProducts(): List<ProductBean>
        +getAllProductsByType(type: String): List<ProductBean>
        +searchAllProducts(search: String): List<ProductBean>
        +getImage(prodId: String): byte[]
        +getProductDetails(prodId: String): ProductBean
        +updateProductWithoutImage(prevProductId: String, updatedProduct: ProductBean): String
        +getProductPrice(prodId: String): double
        +sellNProduct(prodId: String, n: int): boolean
        +getProductQuantity(prodId: String): int
    }

    interface OrderService {
        +paymentSuccess(userName: String, paidAmount: double): String
        +addOrder(order: OrderBean): boolean
        +addTransaction(transaction: TransactionBean): boolean
        +countSoldItem(prodId: String): int
        +getAllOrders(): List<OrderBean>
        +getOrdersByUserId(emailId: String): List<OrderBean>
        +getAllOrderDetails(userEmailId: String): List<OrderDetails>
        +shipNow(orderId: String, prodId: String): String
    }

    interface DemandService {
        +addProduct(userId: String, prodId: String, demandQty: int): boolean
        +addProduct(userDemandBean: DemandBean): boolean
        +removeProduct(userId: String, prodId: String): boolean
        +haveDemanded(prodId: String): List<DemandBean>
    }

    interface TransService {
        +getUserId(transId: String): String
    }
}

' ─────────────────────────────────────────────────
' Service Implementations
' ─────────────────────────────────────────────────
package "com.shashi.service.impl" {

    class ProductServiceImpl {
        +addProduct(prodName: String, prodType: String, prodInfo: String,\n  prodPrice: double, prodQuantity: int, prodImage: InputStream): String
        +addProduct(product: ProductBean): String
        +removeProduct(prodId: String): String
        +updateProduct(prevProduct: ProductBean, updatedProduct: ProductBean): String
        +updateProductPrice(prodId: String, updatedPrice: double): String
        +getAllProducts(): List<ProductBean>
        +getAllProductsByType(type: String): List<ProductBean>
        +searchAllProducts(search: String): List<ProductBean>
        +getImage(prodId: String): byte[]
        +getProductDetails(prodId: String): ProductBean
        +updateProductWithoutImage(prevProductId: String, updatedProduct: ProductBean): String
        +getProductPrice(prodId: String): double
        +sellNProduct(prodId: String, n: int): boolean
        +getProductQuantity(prodId: String): int
    }

    class OrderServiceImpl {
        +paymentSuccess(userName: String, paidAmount: double): String
        +addOrder(order: OrderBean): boolean
        +addTransaction(transaction: TransactionBean): boolean
        +countSoldItem(prodId: String): int
        +getAllOrders(): List<OrderBean>
        +getOrdersByUserId(emailId: String): List<OrderBean>
        +getAllOrderDetails(userEmailId: String): List<OrderDetails>
        +shipNow(orderId: String, prodId: String): String
    }

    class DemandServiceImpl {
        +addProduct(userId: String, prodId: String, demandQty: int): boolean
        +addProduct(userDemandBean: DemandBean): boolean
        +removeProduct(userId: String, prodId: String): boolean
        +haveDemanded(prodId: String): List<DemandBean>
    }

    class TransServiceImpl {
        +getUserId(transId: String): String
    }
}

' ─────────────────────────────────────────────────
' Domain Beans
' ─────────────────────────────────────────────────
package "com.shashi.beans" {

    class ProductBean {
        -prodId: String
        -prodName: String
        -prodType: String
        -prodInfo: String
        -prodPrice: double
        -prodQuantity: int
        -prodImage: InputStream
    }

    class OrderBean {
        -transactionId: String
        -productId: String
        -quantity: int
        -amount: Double
        -shipped: int
    }

    class TransactionBean {
        -transactionId: String
        -userName: String
        -transDateTime: Timestamp
        -transAmount: double
    }

    class OrderDetails {
        -orderId: String
        -productId: String
        -prodName: String
        -qty: String
        -amount: String
        -time: Timestamp
        -shipped: int
    }

    class DemandBean {
        -userName: String
        -prodId: String
        -demandQty: int
    }
}

' ─────────────────────────────────────────────────
' Utility Classes
' ─────────────────────────────────────────────────
package "com.shashi.utility" {

    class DBUtil {
        -conn: Connection
        +provideConnection(): Connection
        +closeConnection(con: Connection): void
        +closeConnection(rs: ResultSet): void
        +closeConnection(ps: PreparedStatement): void
    }

    class MailMessage {
        +transactionSuccess(recipientEmail: String, name: String,\n  transId: String, transAmount: double): void
        +productAvailableNow(recipientEmail: String, name: String,\n  prodName: String, prodId: String): void
        +orderShipped(recipientEmail: String, name: String,\n  transId: String, transAmount: double): void
    }

    class IDUtil {
        +generateId(): String
        +generateTransId(): String
    }
}

' ─────────────────────────────────────────────────
' Cross-service dependencies (referenced externally)
' ─────────────────────────────────────────────────
package "com.shashi.service.impl (referenced)" <<Rectangle>> {
    class CartServiceImpl {
        +getAllCartItems(userId: String): List<CartBean>
        +removeAProduct(userId: String, prodId: String): void
    }
    class UserServiceImpl {
        +getFName(emailId: String): String
    }
}

' ─────────────────────────────────────────────────
' Implements Relationships
' ─────────────────────────────────────────────────
ProductServiceImpl  ..|> ProductService
OrderServiceImpl    ..|> OrderService
DemandServiceImpl   ..|> DemandService
TransServiceImpl    ..|> TransService

' ─────────────────────────────────────────────────
' Cross-service Dependencies (impl → impl, no DI)
' ─────────────────────────────────────────────────
ProductServiceImpl ..> DemandServiceImpl  : uses (haveDemanded,\nremoveProduct)
ProductServiceImpl ..> UserServiceImpl    : uses (getFName)
OrderServiceImpl   ..> ProductServiceImpl : uses (getProductPrice,\nsellNProduct)
OrderServiceImpl   ..> CartServiceImpl    : uses (getAllCartItems,\nremoveAProduct)
OrderServiceImpl   ..> UserServiceImpl    : uses (getFName)

' ─────────────────────────────────────────────────
' Utility Dependencies
' ─────────────────────────────────────────────────
ProductServiceImpl ..> DBUtil      : uses
ProductServiceImpl ..> IDUtil      : uses (generateId)
ProductServiceImpl ..> MailMessage : uses (productAvailableNow)
OrderServiceImpl   ..> DBUtil      : uses
OrderServiceImpl   ..> MailMessage : uses (transactionSuccess)
DemandServiceImpl  ..> DBUtil      : uses
TransServiceImpl   ..> DBUtil      : uses

' ─────────────────────────────────────────────────
' Bean Usage
' ─────────────────────────────────────────────────
ProductServiceImpl ..> ProductBean     : uses
OrderServiceImpl   ..> OrderBean       : uses
OrderServiceImpl   ..> TransactionBean : uses
OrderServiceImpl   ..> OrderDetails    : uses
DemandServiceImpl  ..> DemandBean      : uses

@enduml
