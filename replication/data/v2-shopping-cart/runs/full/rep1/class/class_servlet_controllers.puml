@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title HTTP Servlet Controllers

' ─────────────────────────────────────────────
' External parent (javax.servlet.http)
' ─────────────────────────────────────────────
class HttpServlet <<javax.servlet.http>> {
    #doGet(request: HttpServletRequest, response: HttpServletResponse): void
    #doPost(request: HttpServletRequest, response: HttpServletResponse): void
}

' ─────────────────────────────────────────────
' com.shashi.srv  — Servlet Controllers
' ─────────────────────────────────────────────
package "com.shashi.srv" {

    ' ── Authentication ──────────────────────
    class LoginSrv <<@WebServlet("/LoginSrv")>> {
        -serialVersionUID: long
        +LoginSrv()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    class RegisterSrv <<@WebServlet("/RegisterSrv")>> {
        -serialVersionUID: long
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    class LogoutSrv <<@WebServlet("/LogoutSrv")>> {
        -serialVersionUID: long
        +LogoutSrv()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    ' ── Cart Operations ──────────────────────
    class AddtoCart <<@WebServlet("/AddtoCart")>> {
        -serialVersionUID: long
        +AddtoCart()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    class UpdateToCart <<@WebServlet("/UpdateToCart")>> {
        -serialVersionUID: long
        +UpdateToCart()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    ' ── Product Management (Admin) ───────────
    class AddProductSrv <<@WebServlet @MultipartConfig(16MB)>> {
        -serialVersionUID: long
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    class RemoveProductSrv <<@WebServlet("/RemoveProductSrv")>> {
        -serialVersionUID: long
        +RemoveProductSrv()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    class UpdateProductSrv <<@WebServlet("/UpdateProductSrv")>> {
        -serialVersionUID: long
        +UpdateProductSrv()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    class ShowImage <<@WebServlet("/ShowImage")>> {
        -serialVersionUID: long
        +ShowImage()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    ' ── Order and Shipment ───────────────────
    class OrderServlet <<@WebServlet("/OrderServlet")>> {
        -serialVersionUID: long
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    class ShipmentServlet <<@WebServlet("/ShipmentServlet")>> {
        -serialVersionUID: long
        +ShipmentServlet()
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }

    ' ── Contact / Messaging ──────────────────
    class FansMessage <<@WebServlet("/fansMessage")>> {
        -serialVersionUID: long
        #doGet(request: HttpServletRequest, response: HttpServletResponse): void
        #doPost(request: HttpServletRequest, response: HttpServletResponse): void
    }
}

' ─────────────────────────────────────────────
' Service Implementations (stubs)
' ─────────────────────────────────────────────
package "com.shashi.service.impl" {
    class UserServiceImpl {
        +isValidCredential(emailId: String, password: String): String
        +getUserDetails(emailId: String, password: String): UserBean
        +registerUser(user: UserBean): String
        +getFName(emailId: String): String
    }
    class CartServiceImpl {
        +getProductCount(userId: String, prodId: String): int
        +updateProductToCart(userId: String, prodId: String, qty: int): String
        +removeProductFromCart(userId: String, prodId: String): String
    }
    class ProductServiceImpl {
        +getProductDetails(prodId: String): ProductBean
        +addProduct(name: String, type: String, info: String, price: double, qty: int, image: InputStream): String
        +removeProduct(prodId: String): String
        +updateProductWithoutImage(prodId: String, product: ProductBean): String
        +getImage(prodId: String): byte[]
    }
    class OrderServiceImpl {
        +paymentSuccess(userName: String, paidAmount: double): String
        +shipNow(orderId: String, prodId: String): String
    }
    class DemandServiceImpl {
        +addProduct(demandBean: DemandBean): boolean
    }
}

' ─────────────────────────────────────────────
' Utility
' ─────────────────────────────────────────────
package "com.shashi.utility" {
    class MailMessage {
        +sendMessage(to: String, subject: String, htmlBody: String): String
        +orderShipped(userName: String, firstName: String, orderId: String, amount: double): void
    }
}

' ─────────────────────────────────────────────
' Beans (stubs)
' ─────────────────────────────────────────────
package "com.shashi.beans" {
    class UserBean
    class ProductBean
    class DemandBean
}

' ─────────────────────────────────────────────
' Inheritance — all servlets extend HttpServlet
' ─────────────────────────────────────────────
LoginSrv       --|> HttpServlet
RegisterSrv    --|> HttpServlet
LogoutSrv      --|> HttpServlet
AddtoCart      --|> HttpServlet
UpdateToCart   --|> HttpServlet
AddProductSrv  --|> HttpServlet
RemoveProductSrv --|> HttpServlet
UpdateProductSrv --|> HttpServlet
ShowImage      --|> HttpServlet
OrderServlet   --|> HttpServlet
ShipmentServlet --|> HttpServlet
FansMessage    --|> HttpServlet

' ─────────────────────────────────────────────
' Service dependencies
' ─────────────────────────────────────────────
LoginSrv        ..> UserServiceImpl    : uses
RegisterSrv     ..> UserServiceImpl    : uses
ShipmentServlet ..> UserServiceImpl    : uses

AddtoCart       ..> CartServiceImpl    : uses
UpdateToCart    ..> CartServiceImpl    : uses

AddtoCart       ..> ProductServiceImpl : uses
UpdateToCart    ..> ProductServiceImpl : uses
AddProductSrv   ..> ProductServiceImpl : uses
RemoveProductSrv ..> ProductServiceImpl : uses
UpdateProductSrv ..> ProductServiceImpl : uses
ShowImage       ..> ProductServiceImpl : uses

OrderServlet    ..> OrderServiceImpl   : uses
ShipmentServlet ..> OrderServiceImpl   : uses

AddtoCart       ..> DemandServiceImpl  : uses
UpdateToCart    ..> DemandServiceImpl  : uses

ShipmentServlet ..> MailMessage        : uses
FansMessage     ..> MailMessage        : uses

' ─────────────────────────────────────────────
' Bean dependencies
' ─────────────────────────────────────────────
LoginSrv         ..> UserBean    : uses
RegisterSrv      ..> UserBean    : uses
AddtoCart        ..> ProductBean : uses
AddtoCart        ..> DemandBean  : uses
UpdateToCart     ..> ProductBean : uses
UpdateToCart     ..> DemandBean  : uses
UpdateProductSrv ..> ProductBean : uses

@enduml
