@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EAF4FB
    BorderColor #2980B9
}

title User and Cart Service Layer

package "com.shashi.service" {
    interface UserService {
        +registerUser(userName: String, mobileNo: Long, emailId: String, address: String, pinCode: int, password: String): String
        +registerUser(user: UserBean): String
        +isRegistered(emailId: String): boolean
        +isValidCredential(emailId: String, password: String): String
        +getUserDetails(emailId: String, password: String): UserBean
        +getFName(emailId: String): String
        +getUserAddr(userId: String): String
    }

    interface CartService {
        +addProductToCart(userId: String, prodId: String, prodQty: int): String
        +updateProductToCart(userId: String, prodId: String, prodQty: int): String
        +getAllCartItems(userId: String): List<CartBean>
        +getCartCount(userId: String): int
        +getCartItemCount(userId: String, itemId: String): int
        +removeProductFromCart(userId: String, prodId: String): String
        +removeAProduct(userId: String, prodId: String): boolean
    }
}

package "com.shashi.service.impl" {
    class UserServiceImpl {
        +registerUser(userName: String, mobileNo: Long, emailId: String, address: String, pinCode: int, password: String): String
        +registerUser(user: UserBean): String
        +isRegistered(emailId: String): boolean
        +isValidCredential(emailId: String, password: String): String
        +getUserDetails(emailId: String, password: String): UserBean
        +getFName(emailId: String): String
        +getUserAddr(userId: String): String
    }

    class CartServiceImpl {
        +addProductToCart(userId: String, prodId: String, prodQty: int): String
        +updateProductToCart(userId: String, prodId: String, prodQty: int): String
        +getAllCartItems(userId: String): List<CartBean>
        +getCartCount(userId: String): int
        +getCartItemCount(userId: String, itemId: String): int
        +removeProductFromCart(userId: String, prodId: String): String
        +removeAProduct(userId: String, prodId: String): boolean
        +getProductCount(userId: String, prodId: String): int
    }

    class ProductServiceImpl {
        +getProductDetails(prodId: String): ProductBean
        +getProductQuantity(prodId: String): int
    }

    class DemandServiceImpl {
        +addProduct(userId: String, prodId: String, demandQty: int): String
        +addProduct(userDemandBean: DemandBean): String
    }
}

package "com.shashi.beans" {
    class UserBean {
        -name: String
        -mobile: Long
        -email: String
        -address: String
        -pinCode: int
        -password: String
        +UserBean()
        +UserBean(userName: String, mobileNo: Long, emailId: String, address: String, pinCode: int, password: String)
        +getName(): String
        +getEmail(): String
        +getMobile(): Long
        +getAddress(): String
        +getPinCode(): int
        +getPassword(): String
    }

    class CartBean {
        +userId: String
        +prodId: String
        +quantity: int
        +CartBean()
        +CartBean(userId: String, prodId: String, quantity: int)
        +getUserId(): String
        +getProdId(): String
        +getQuantity(): int
    }

    class ProductBean {
        -prodId: String
        -prodName: String
        -prodQuantity: int
        -prodPrice: double
    }

    class DemandBean {
        -userName: String
        -prodId: String
        -demandQty: int
    }
}

package "com.shashi.utility" {
    class DBUtil {
        -conn: Connection
        +provideConnection(): Connection
        +closeConnection(con: Connection): void
        +closeConnection(rs: ResultSet): void
        +closeConnection(ps: PreparedStatement): void
    }

    class MailMessage {
        +registrationSuccess(emailId: String, name: String): void
        +transactionSuccess(recipientEmail: String, name: String, transId: String, transAmount: double): void
        +orderShipped(recipientEmail: String, name: String, transId: String, transAmount: double): void
        +productAvailableNow(recipientEmail: String, name: String, prodName: String, prodId: String): void
    }
}

package "com.shashi.constants" {
    interface IUserConstants {
        +TABLE_USER: String
    }
}

' Implementation relationships
UserServiceImpl ..|> UserService : implements
CartServiceImpl ..|> CartService : implements

' UserServiceImpl dependencies
UserServiceImpl ..> UserBean : uses
UserServiceImpl ..> DBUtil : uses
UserServiceImpl ..> MailMessage : uses
UserServiceImpl ..> IUserConstants : uses

' CartServiceImpl dependencies
CartServiceImpl ..> CartBean : uses
CartServiceImpl ..> DBUtil : uses
CartServiceImpl ..> ProductServiceImpl : instantiates
CartServiceImpl ..> DemandServiceImpl : instantiates
CartServiceImpl ..> ProductBean : uses
CartServiceImpl ..> DemandBean : uses

@enduml
