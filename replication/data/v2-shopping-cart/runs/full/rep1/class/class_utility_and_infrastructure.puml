@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Utility and Infrastructure Classes

package "com.shashi.utility" {

    class DBUtil {
        {static} - conn: Connection
        --
        + DBUtil()
        {static} + provideConnection(): Connection
        {static} + closeConnection(con: Connection): void
        {static} + closeConnection(rs: ResultSet): void
        {static} + closeConnection(ps: PreparedStatement): void
    }

    class IDUtil {
        {static} + generateId(): String
        {static} + generateTransId(): String
    }

    class MailMessage {
        {static} + registrationSuccess(emailId: String, name: String): void
        {static} + transactionSuccess(recipientEmail: String, name: String, transId: String, transAmount: double): void
        {static} + orderShipped(recipientEmail: String, name: String, transId: String, transAmount: double): void
        {static} + productAvailableNow(recipientEmail: String, name: String, prodName: String, prodId: String): void
        {static} + sendMessage(toEmailId: String, subject: String, htmlTextMessage: String): String
    }

    class JavaMailUtil {
        {static} + sendMail(recipientMailId: String): void
        {static} ~ sendMail(recipient: String, subject: String, htmlTextMessage: String): void
        {static} - prepareMessage(session: Session, myAccountEmail: String, recipientEmail: String): Message
        {static} - prepareMessage(session: Session, myAccountEmail: String, recipientEmail: String, subject: String, htmlTextMessage: String): Message
    }
}

package "com.shashi.constants" {

    interface IUserConstants {
        + TABLE_USER: String = "user"
        + COLUMN_NAME: String = "name"
        + COLUMN_MOBILE: String = "mobile"
        + COLUMN_EMAIL: String = "email"
        + COLUMN_ADDRESS: String = "address"
        + COLUMN_PINCODE: String = "pincode"
        + COLUMN_PASSWORD: String = "password"
    }
}

package "java.sql" <<external>> {
    interface Connection
    class DriverManager
    interface PreparedStatement
    interface ResultSet
}

package "jakarta.mail" <<external>> {
    class Session
    class Transport
    class Message
}

package "java.util / java.text" <<external>> {
    class ResourceBundle
    class SimpleDateFormat
    class Date
}

' Internal relationships
MailMessage ..> JavaMailUtil : <<facade>>\ncalls sendMail()

' DBUtil external dependencies
DBUtil *-- Connection : conn {static}
DBUtil ..> DriverManager : uses
DBUtil ..> PreparedStatement : closes
DBUtil ..> ResultSet : closes
DBUtil ..> ResourceBundle : reads application.properties

' JavaMailUtil external dependencies
JavaMailUtil ..> Session : uses
JavaMailUtil ..> Transport : uses
JavaMailUtil ..> Message : creates
JavaMailUtil ..> ResourceBundle : reads mailer credentials

' IDUtil external dependencies
IDUtil ..> SimpleDateFormat : uses
IDUtil ..> Date : uses

note bottom of DBUtil
  Lazy singleton pattern.
  closeConnection(Connection)
  body is commented out (no-op).
end note

note right of JavaMailUtil
  SMTP: smtp.gmail.com:587
  with STARTTLS.
  3-arg sendMail() is
  package-protected (~).
end note

note bottom of IUserConstants
  Constant interface pattern —
  all fields are implicitly
  public static final.
  Implemented by DAO/service
  classes for column name access.
end note

@enduml
