{
  "scope": "domain_model_beans",
  "title": "Domain Model — Data Beans",
  "diagram_type": "class",
  "package": "com.shashi.beans",
  "common_interface": "java.io.Serializable (all 7 classes implement it)",

  "classes": [
    {
      "name": "UserBean",
      "implements": ["Serializable"],
      "fields": [
        "- name: String",
        "- mobile: Long",
        "- email: String",
        "- address: String",
        "- pinCode: int",
        "- password: String"
      ],
      "constructors": [
        "UserBean()",
        "UserBean(userName:String, mobileNo:Long, emailId:String, address:String, pinCode:int, password:String)"
      ],
      "methods": ["getName/setName", "getMobile/setMobile", "getEmail/setEmail", "getAddress/setAddress", "getPinCode/setPinCode", "getPassword/setPassword"],
      "notes": "email is used as the logical user identifier across other beans (userId in CartBean, userName in TransactionBean/DemandBean)"
    },
    {
      "name": "ProductBean",
      "implements": ["Serializable"],
      "fields": [
        "- prodId: String",
        "- prodName: String",
        "- prodType: String",
        "- prodInfo: String",
        "- prodPrice: double",
        "- prodQuantity: int",
        "- prodImage: InputStream"
      ],
      "constructors": [
        "ProductBean()",
        "ProductBean(prodId, prodName, prodType, prodInfo, prodPrice, prodQuantity, prodImage)"
      ],
      "methods": ["getProdId/setProdId", "getProdName/setProdName", "getProdType/setProdType", "getProdInfo/setProdInfo", "getProdPrice/setProdPrice", "getProdQuantity/setProdQuantity", "getProdImage/setProdImage"]
    },
    {
      "name": "CartBean",
      "implements": ["Serializable"],
      "fields": [
        "+ userId: String  [public field]",
        "+ prodId: String  [public field]",
        "+ quantity: int   [public field]"
      ],
      "constructors": [
        "CartBean()",
        "CartBean(userId:String, prodId:String, quantity:int)"
      ],
      "methods": ["getUserId/setUserId", "getProdId/setProdId", "getQuantity/setQuantity"],
      "notes": "Unique: fields are public (not private). userId is a FK to UserBean.email; prodId is FK to ProductBean.prodId"
    },
    {
      "name": "OrderBean",
      "implements": ["Serializable"],
      "fields": [
        "- transactionId: String",
        "- productId: String",
        "- quantity: int",
        "- amount: Double",
        "- shipped: int  [0=pending, non-zero=shipped]"
      ],
      "constructors": [
        "OrderBean()",
        "OrderBean(transactionId, productId, quantity, amount)  [shipped defaults to 0]",
        "OrderBean(transactionId, productId, quantity, amount, shipped)"
      ],
      "methods": ["getTransactionId/setTransactionId", "getProductId/setProductId", "getQuantity/setQuantity", "getAmount/setAmount", "getShipped/setShipped"],
      "notes": "transactionId is FK to TransactionBean.transactionId; productId is FK to ProductBean.prodId. One row per product per transaction."
    },
    {
      "name": "OrderDetails",
      "implements": ["Serializable"],
      "fields": [
        "- orderId: String",
        "- productId: String",
        "- prodName: String",
        "- qty: String",
        "- amount: String",
        "- shipped: int",
        "- time: Timestamp",
        "- prodImage: InputStream"
      ],
      "constructors": ["OrderDetails()  [default only]"],
      "methods": ["getOrderId/setOrderId", "getProductId/setProductId", "getProdName/setProdName", "getQty/setQty", "getAmount/setAmount", "getShipped/setShipped", "getTime/setTime", "getProdImage/setProdImage"],
      "notes": "Read-model / display DTO combining OrderBean + ProductBean + TransactionBean data. orderId maps to TransactionBean.transactionId. qty and amount stored as String (unlike OrderBean which uses int/Double)."
    },
    {
      "name": "TransactionBean",
      "implements": ["Serializable"],
      "dependencies": ["com.shashi.utility.IDUtil (uses IDUtil.generateTransId() in constructors)"],
      "fields": [
        "- transactionId: String  [auto-generated by IDUtil]",
        "- userName: String",
        "- transDateTime: Timestamp  [auto-set to current time in most constructors]",
        "- transAmount: double"
      ],
      "constructors": [
        "TransactionBean()  [auto-generates ID + timestamp]",
        "TransactionBean(userName, transAmount)  [auto-generates ID + timestamp]",
        "TransactionBean(transactionId, userName, transAmount)  [auto-sets timestamp]",
        "TransactionBean(userName, transDateTime, transAmount)  [auto-generates ID]",
        "TransactionBean(transactionId, userName, transDateTime, transAmount)"
      ],
      "methods": ["getTransactionId/setTransactionId", "getUserName/setUserName", "getTransDateTime/setTransDateTime", "getTransAmount/setTransAmount"],
      "notes": "userName is FK to UserBean. transactionId is the primary key referenced by OrderBean and OrderDetails."
    },
    {
      "name": "DemandBean",
      "implements": ["Serializable"],
      "fields": [
        "- userName: String",
        "- prodId: String",
        "- demandQty: int"
      ],
      "constructors": [
        "DemandBean()",
        "DemandBean(userName:String, prodId:String, demandQty:int)"
      ],
      "methods": ["getUserName/setUserName", "getProdId/setProdId", "getDemandQty/setDemandQty"],
      "notes": "Records user demand for out-of-stock products. userName is FK to UserBean; prodId is FK to ProductBean."
    }
  ],

  "key_relationships": [
    "CartBean.userId  --> UserBean.email  (logical FK, String)",
    "CartBean.prodId  --> ProductBean.prodId  (logical FK, String)",
    "OrderBean.transactionId  --> TransactionBean.transactionId  (logical FK, String)",
    "OrderBean.productId  --> ProductBean.prodId  (logical FK, String)",
    "OrderDetails.orderId  --> TransactionBean.transactionId  (logical FK, String)",
    "OrderDetails.productId  --> ProductBean.prodId  (logical FK, String)",
    "TransactionBean.userName  --> UserBean.email  (logical FK, String)",
    "DemandBean.userName  --> UserBean.email  (logical FK, String)",
    "DemandBean.prodId  --> ProductBean.prodId  (logical FK, String)",
    "TransactionBean depends_on  IDUtil (com.shashi.utility)"
  ],

  "design_observations": [
    "No direct Java composition between beans — all cross-references are string FKs (denormalized)",
    "No inheritance among beans — all are flat POJOs implementing Serializable",
    "CartBean is the join entity between UserBean and ProductBean (many-to-many cart)",
    "OrderBean is the join entity between TransactionBean and ProductBean (one transaction, many order lines)",
    "OrderDetails is a read-model DTO — aggregates data from OrderBean + ProductBean + TransactionBean for UI display",
    "TransactionBean has 5 constructor overloads; most auto-generate transactionId via IDUtil and set timestamp",
    "CartBean fields are public (not private) — inconsistent with other beans which use private + getters/setters"
  ],

  "external_dependencies": [
    "java.io.Serializable — all beans",
    "java.io.InputStream — ProductBean.prodImage, OrderDetails.prodImage",
    "java.sql.Timestamp — OrderDetails.time, TransactionBean.transDateTime",
    "java.text.SimpleDateFormat — TransactionBean (formatting only)",
    "com.shashi.utility.IDUtil — TransactionBean (generateTransId())"
  ],

  "source_files_analyzed": [
    "src/src/com/shashi/beans/UserBean.java",
    "src/src/com/shashi/beans/ProductBean.java",
    "src/src/com/shashi/beans/CartBean.java",
    "src/src/com/shashi/beans/OrderBean.java",
    "src/src/com/shashi/beans/OrderDetails.java",
    "src/src/com/shashi/beans/TransactionBean.java",
    "src/src/com/shashi/beans/DemandBean.java"
  ]
}
