{
  "scope": "servlet_controllers",
  "title": "HTTP Servlet Controllers",
  "diagram_type": "class",
  "package": "com.shashi.srv",
  "superclass": "javax.servlet.http.HttpServlet",

  "classes": [
    {
      "name": "LoginSrv",
      "url_pattern": "/LoginSrv",
      "annotations": ["@WebServlet(\"/LoginSrv\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+LoginSrv()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["UserServiceImpl", "UserBean", "HttpSession"],
      "service_calls": [
        "UserServiceImpl.isValidCredential(userName, password): String",
        "UserServiceImpl.getUserDetails(userName, password): UserBean"
      ],
      "session_writes": ["username", "password", "usertype", "userdata"],
      "forward_targets": ["adminViewProduct.jsp", "userHome.jsp", "login.jsp"],
      "notes": "Admin login hardcoded (admin@gmail.com/admin); customer via UserServiceImpl"
    },
    {
      "name": "RegisterSrv",
      "url_pattern": "/RegisterSrv",
      "annotations": ["@WebServlet(\"/RegisterSrv\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["UserServiceImpl", "UserBean"],
      "service_calls": ["UserServiceImpl.registerUser(user: UserBean): String"],
      "forward_targets": ["register.jsp"],
      "notes": "Validates password == confirmPassword before registering"
    },
    {
      "name": "AddtoCart",
      "url_pattern": "/AddtoCart",
      "annotations": ["@WebServlet(\"/AddtoCart\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+AddtoCart()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["CartServiceImpl", "ProductServiceImpl", "DemandServiceImpl", "ProductBean", "DemandBean", "HttpSession"],
      "service_calls": [
        "ProductServiceImpl.getProductDetails(prodId): ProductBean",
        "CartServiceImpl.getProductCount(userId, prodId): int",
        "CartServiceImpl.removeProductFromCart(userId, prodId): String",
        "CartServiceImpl.updateProductToCart(userId, prodId, qty): String",
        "DemandServiceImpl.addProduct(demandBean: DemandBean): boolean"
      ],
      "session_reads": ["username", "password", "usertype"],
      "access_control": "customer only",
      "forward_targets": ["userHome.jsp", "cartDetails.jsp"],
      "notes": "Complex stock logic: removes if qty==cartQty, caps at available stock + creates DemandBean if out-of-stock"
    },
    {
      "name": "UpdateToCart",
      "url_pattern": "/UpdateToCart",
      "annotations": ["@WebServlet(\"/UpdateToCart\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+UpdateToCart()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["CartServiceImpl", "ProductServiceImpl", "DemandServiceImpl", "ProductBean", "DemandBean", "HttpSession"],
      "service_calls": [
        "ProductServiceImpl.getProductDetails(prodId): ProductBean",
        "CartServiceImpl.updateProductToCart(userId, prodId, qty): String",
        "DemandServiceImpl.addProduct(demandBean: DemandBean): boolean"
      ],
      "session_reads": ["username", "password"],
      "forward_targets": ["cartDetails.jsp"],
      "notes": "Similar to AddtoCart but no remove case; caps qty at available stock"
    },
    {
      "name": "OrderServlet",
      "url_pattern": "/OrderServlet",
      "annotations": ["@WebServlet(\"/OrderServlet\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["OrderServiceImpl", "HttpSession"],
      "service_calls": ["OrderServiceImpl.paymentSuccess(userName: String, paidAmount: double): String"],
      "session_reads": ["username", "password"],
      "forward_targets": ["orderDetails.jsp"],
      "notes": "Processes payment; redirects to login if session expired"
    },
    {
      "name": "AddProductSrv",
      "url_pattern": "/AddProductSrv",
      "annotations": ["@WebServlet(\"/AddProductSrv\")", "@MultipartConfig(maxFileSize=16177215)"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["ProductServiceImpl", "HttpSession", "Part"],
      "service_calls": ["ProductServiceImpl.addProduct(name, type, info, price, qty, image: InputStream): String"],
      "session_reads": ["usertype", "username", "password"],
      "access_control": "admin only",
      "forward_targets": ["addProduct.jsp"],
      "notes": "Multipart/form-data for image upload (max 16MB); admin-only"
    },
    {
      "name": "RemoveProductSrv",
      "url_pattern": "/RemoveProductSrv",
      "annotations": ["@WebServlet(\"/RemoveProductSrv\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+RemoveProductSrv()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["ProductServiceImpl", "HttpSession"],
      "service_calls": ["ProductServiceImpl.removeProduct(prodId: String): String"],
      "session_reads": ["usertype", "username", "password"],
      "access_control": "admin only",
      "forward_targets": ["removeProduct.jsp"]
    },
    {
      "name": "UpdateProductSrv",
      "url_pattern": "/UpdateProductSrv",
      "annotations": ["@WebServlet(\"/UpdateProductSrv\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+UpdateProductSrv()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["ProductServiceImpl", "ProductBean", "HttpSession"],
      "service_calls": ["ProductServiceImpl.updateProductWithoutImage(prodId: String, product: ProductBean): String"],
      "session_reads": ["usertype", "username", "password"],
      "access_control": "admin only",
      "forward_targets": ["updateProduct.jsp"],
      "notes": "Creates ProductBean from params then delegates to service"
    },
    {
      "name": "ShipmentServlet",
      "url_pattern": "/ShipmentServlet",
      "annotations": ["@WebServlet(\"/ShipmentServlet\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+ShipmentServlet()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["OrderServiceImpl", "UserServiceImpl", "MailMessage", "HttpSession"],
      "service_calls": [
        "OrderServiceImpl.shipNow(orderId: String, prodId: String): String",
        "UserServiceImpl.getFName(userName: String): String",
        "MailMessage.orderShipped(userName, firstName, orderId, amount): void"
      ],
      "session_reads": ["usertype"],
      "forward_targets": ["shippedItems.jsp", "unshippedItems.jsp"],
      "notes": "Admin shipment trigger; sends email notification on success via MailMessage"
    },
    {
      "name": "LogoutSrv",
      "url_pattern": "/LogoutSrv",
      "annotations": ["@WebServlet(\"/LogoutSrv\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+LogoutSrv()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["HttpSession"],
      "service_calls": [],
      "session_writes": ["username=null", "password=null", "usertype=null", "userdata=null"],
      "forward_targets": ["login.jsp"],
      "notes": "No service dependency; simply nulls out all session attributes"
    },
    {
      "name": "ShowImage",
      "url_pattern": "/ShowImage",
      "annotations": ["@WebServlet(\"/ShowImage\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "+ShowImage()",
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["ProductServiceImpl"],
      "service_calls": ["ProductServiceImpl.getImage(prodId: String): byte[]"],
      "forward_targets": [],
      "notes": "Returns raw image bytes via ServletOutputStream; fallback to noimage.jpg if null"
    },
    {
      "name": "FansMessage",
      "url_pattern": "/fansMessage",
      "annotations": ["@WebServlet(\"/fansMessage\")"],
      "extends": "HttpServlet",
      "fields": ["-serialVersionUID: long"],
      "methods": [
        "#doGet(request: HttpServletRequest, response: HttpServletResponse): void",
        "#doPost(request: HttpServletRequest, response: HttpServletResponse): void"
      ],
      "dependencies": ["MailMessage"],
      "service_calls": ["MailMessage.sendMessage(to: String, subject: String, htmlBody: String): String"],
      "forward_targets": ["index.jsp"],
      "notes": "Sends fan/contact message via MailMessage utility; no session required"
    }
  ],

  "key_relationships": [
    "LoginSrv extends HttpServlet",
    "RegisterSrv extends HttpServlet",
    "AddtoCart extends HttpServlet",
    "UpdateToCart extends HttpServlet",
    "OrderServlet extends HttpServlet",
    "AddProductSrv extends HttpServlet",
    "RemoveProductSrv extends HttpServlet",
    "UpdateProductSrv extends HttpServlet",
    "ShipmentServlet extends HttpServlet",
    "LogoutSrv extends HttpServlet",
    "ShowImage extends HttpServlet",
    "FansMessage extends HttpServlet",
    "LoginSrv depends_on UserServiceImpl",
    "RegisterSrv depends_on UserServiceImpl",
    "ShipmentServlet depends_on UserServiceImpl",
    "AddtoCart depends_on CartServiceImpl",
    "UpdateToCart depends_on CartServiceImpl",
    "AddtoCart depends_on ProductServiceImpl",
    "UpdateToCart depends_on ProductServiceImpl",
    "AddProductSrv depends_on ProductServiceImpl",
    "RemoveProductSrv depends_on ProductServiceImpl",
    "UpdateProductSrv depends_on ProductServiceImpl",
    "ShowImage depends_on ProductServiceImpl",
    "OrderServlet depends_on OrderServiceImpl",
    "ShipmentServlet depends_on OrderServiceImpl",
    "AddtoCart depends_on DemandServiceImpl",
    "UpdateToCart depends_on DemandServiceImpl",
    "ShipmentServlet depends_on MailMessage",
    "FansMessage depends_on MailMessage",
    "LoginSrv uses UserBean",
    "RegisterSrv uses UserBean",
    "AddtoCart uses ProductBean",
    "AddtoCart uses DemandBean",
    "UpdateToCart uses ProductBean",
    "UpdateToCart uses DemandBean",
    "UpdateProductSrv uses ProductBean"
  ],

  "service_dependency_groups": {
    "UserServiceImpl": ["LoginSrv", "RegisterSrv", "ShipmentServlet"],
    "ProductServiceImpl": ["AddtoCart", "UpdateToCart", "AddProductSrv", "RemoveProductSrv", "UpdateProductSrv", "ShowImage"],
    "CartServiceImpl": ["AddtoCart", "UpdateToCart"],
    "OrderServiceImpl": ["OrderServlet", "ShipmentServlet"],
    "DemandServiceImpl": ["AddtoCart", "UpdateToCart"],
    "MailMessage": ["ShipmentServlet", "FansMessage"]
  },

  "access_control": {
    "admin_only": ["AddProductSrv", "RemoveProductSrv", "UpdateProductSrv", "ShipmentServlet"],
    "customer_only": ["AddtoCart"],
    "authenticated": ["UpdateToCart", "OrderServlet", "LogoutSrv"],
    "public": ["LoginSrv", "RegisterSrv", "ShowImage", "FansMessage"]
  },

  "important_notes": "All servlets extend HttpServlet with doGet+doPost (doPost delegates to doGet). All in com.shashi.srv. Instantiate service impls locally (no DI). Session attributes: username, password, usertype, userdata. AddProductSrv uses @MultipartConfig for image upload.",
  "source_files_analyzed": [
    "src/src/com/shashi/srv/LoginSrv.java",
    "src/src/com/shashi/srv/RegisterSrv.java",
    "src/src/com/shashi/srv/AddtoCart.java",
    "src/src/com/shashi/srv/UpdateToCart.java",
    "src/src/com/shashi/srv/OrderServlet.java",
    "src/src/com/shashi/srv/AddProductSrv.java",
    "src/src/com/shashi/srv/RemoveProductSrv.java",
    "src/src/com/shashi/srv/UpdateProductSrv.java",
    "src/src/com/shashi/srv/ShipmentServlet.java",
    "src/src/com/shashi/srv/LogoutSrv.java",
    "src/src/com/shashi/srv/ShowImage.java",
    "src/src/com/shashi/srv/FansMessage.java"
  ]
}
