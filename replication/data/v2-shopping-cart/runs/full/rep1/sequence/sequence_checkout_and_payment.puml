@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #495057
skinparam sequenceParticipantBackgroundColor #F8F9FA
skinparam sequenceParticipantFontSize 12
skinparam sequenceGroupBorderColor #6C757D
skinparam sequenceGroupBackgroundColor #E9ECEF
skinparam sequenceGroupFontColor #212529
skinparam sequenceLifeLineBorderColor #ADB5BD
skinparam sequenceActivationBorderColor #495057
skinparam sequenceActivationBackgroundColor #DEE2E6

title Checkout and Payment Processing Flow

actor "Customer\n(Browser)" as Customer
participant "OrderServlet" as OrderServlet
participant "HttpSession" as Session
participant "OrderServiceImpl" as OrderService
participant "CartServiceImpl" as CartService
participant "ProductServiceImpl" as ProductService
participant "UserServiceImpl" as UserService
participant "TransactionBean" as TxBean
participant "IDUtil" as IDUtil
participant "OrderBean" as OrderBean
participant "DBUtil" as DBUtil
database "Database" as DB
participant "MailMessage" as MailMessage
participant "JavaMailUtil" as JavaMailUtil
participant "SMTP Server\n(gmail:587)" as SMTP

== Initiate Checkout ==

Customer -> OrderServlet : GET/POST /OrderServlet?amount=<paidAmount>
activate OrderServlet

OrderServlet -> Session : getAttribute("username")
OrderServlet -> Session : getAttribute("password")

alt Session expired (username or password is null)
    OrderServlet --> Customer : redirect login.jsp?message=Session Expired
else Session valid
end

== Fetch Cart Items ==

OrderServlet -> OrderService : new OrderServiceImpl()\n.paymentSuccess(userName, paidAmount)
activate OrderService

OrderService -> CartService : new CartServiceImpl()\n.getAllCartItems(userName)
activate CartService
CartService -> DBUtil : provideConnection()
activate DBUtil
DBUtil --> CartService : Connection
deactivate DBUtil
CartService -> DB : SELECT * FROM cart WHERE username=?
activate DB
DB --> CartService : ResultSet
deactivate DB
CartService --> OrderService : List<CartBean>
deactivate CartService

alt cartItems is empty
    OrderService --> OrderServlet : return "Order Placement Failed!"
    OrderServlet --> Customer : render orderDetails.jsp (failure)
end

== Create Transaction Record ==

OrderService -> TxBean : new TransactionBean(userName, paidAmount)
activate TxBean
TxBean -> IDUtil : generateTransId()
activate IDUtil
IDUtil --> TxBean : transactionId (UUID/timestamp-based)
deactivate IDUtil
TxBean --> OrderService : transaction (transactionId, transDateTime, transAmount)
deactivate TxBean

== Process Each Cart Item ==

loop for each CartBean item in cartItems

    OrderService -> ProductService : new ProductServiceImpl()\n.getProductPrice(item.getProdId())
    activate ProductService
    ProductService -> DB : SELECT price FROM product WHERE pid=?
    activate DB
    DB --> ProductService : price (double)
    deactivate DB
    ProductService --> OrderService : price
    deactivate ProductService

    OrderService -> OrderBean : new OrderBean(transactionId, prodId, quantity, amount)
    activate OrderBean
    OrderBean --> OrderService : order
    deactivate OrderBean

    OrderService -> OrderService : addOrder(order)
    note right : self-call on same instance
    OrderService -> DBUtil : provideConnection()
    activate DBUtil
    DBUtil --> OrderService : Connection
    deactivate DBUtil
    OrderService -> DB : INSERT INTO orders\nVALUES(transId, prodId, qty, amount, shipped=0)
    activate DB
    DB --> OrderService : rows affected
    deactivate DB

    alt addOrder failed (ordered == false)
        OrderService --> OrderServlet : return "Order Placement Failed!"
        note right : break loop
    end

    OrderService -> CartService : new CartServiceImpl()\n.removeAProduct(userId, prodId)
    activate CartService
    CartService -> DB : DELETE FROM cart\nWHERE userid=? AND prodid=?
    activate DB
    DB --> CartService : rows affected
    deactivate DB
    CartService --> OrderService : boolean
    deactivate CartService

    alt removeAProduct failed (ordered == false)
        OrderService --> OrderServlet : return "Order Placement Failed!"
        note right : break loop
    end

    OrderService -> ProductService : new ProductServiceImpl()\n.sellNProduct(prodId, quantity)
    activate ProductService
    ProductService -> DB : UPDATE product SET quantity=quantity-N\nWHERE pid=?
    activate DB
    DB --> ProductService : rows affected
    deactivate DB
    ProductService --> OrderService : boolean
    deactivate ProductService

    alt sellNProduct failed (ordered == false)
        OrderService --> OrderServlet : return "Order Placement Failed!"
        note right : break loop
    end

end

== Record Transaction & Send Confirmation Email ==

alt All items ordered successfully (ordered == true)

    OrderService -> OrderService : new OrderServiceImpl()\n.addTransaction(transaction)
    note right : fresh instance call
    OrderService -> DBUtil : provideConnection()
    activate DBUtil
    DBUtil --> OrderService : Connection
    deactivate DBUtil
    OrderService -> DB : INSERT INTO transactions\nVALUES(transId, userName, transDateTime, transAmount)
    activate DB
    DB --> OrderService : rows affected
    deactivate DB

    OrderService -> UserService : new UserServiceImpl()\n.getFName(userName)
    activate UserService
    UserService -> DB : SELECT fname FROM user\nWHERE username=?
    activate DB
    DB --> UserService : firstName (String)
    deactivate DB
    UserService --> OrderService : firstName
    deactivate UserService

    OrderService -> MailMessage : transactionSuccess(userName, firstName,\ntransactionId, transAmount) [static]
    activate MailMessage
    MailMessage -> JavaMailUtil : sendMail(recipient, subject, htmlTextMessage) [static]
    activate JavaMailUtil
    JavaMailUtil -> SMTP : Transport.send(message)\nvia smtp.gmail.com:587 (STARTTLS)
    activate SMTP
    SMTP --> JavaMailUtil : email delivered
    deactivate SMTP
    JavaMailUtil --> MailMessage : (void)
    deactivate JavaMailUtil
    MailMessage --> OrderService : (void)
    deactivate MailMessage

    OrderService --> OrderServlet : return "Order Placed Successfully!"

else ordered == false

    OrderService --> OrderServlet : return "Order Placement Failed!"

end

deactivate OrderService

== Render Response ==

OrderServlet -> OrderServlet : RequestDispatcher.include(orderDetails.jsp)
note right : injects status message via\ninline JS: document.getElementById\n('message').innerHTML = status
OrderServlet --> Customer : render orderDetails.jsp + status message
deactivate OrderServlet

@enduml
