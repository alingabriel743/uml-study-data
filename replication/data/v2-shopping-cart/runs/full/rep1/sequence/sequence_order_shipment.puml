@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    BoxBackgroundColor #F1F3F5
    BoxBorderColor #ADB5BD
}

title Order Shipment Flow

actor "Admin (Browser)" as Admin
participant "ShipmentServlet\n@WebServlet('/ShipmentServlet')" as ShipmentServlet
participant "HttpSession" as Session
participant "OrderServiceImpl" as OrderService
participant "DBUtil" as DBUtil
database "Database\n(orders table)" as DB
participant "UserServiceImpl" as UserService
participant "MailMessage" as MailMessage
participant "JavaMailUtil" as JavaMailUtil
participant "SMTP Server\n(smtp.gmail.com:587)" as SMTP

Admin -> ShipmentServlet : GET /ShipmentServlet\n?orderid=&prodid=&userid=&amount=
activate ShipmentServlet

ShipmentServlet -> Session : getAttribute("usertype")
activate Session
Session --> ShipmentServlet : userType
deactivate Session

alt userType == null (unauthenticated)
    ShipmentServlet --> Admin : redirect login.jsp\n[Access Denied]
else userType valid (admin authenticated)

    ShipmentServlet -> OrderService : shipNow(orderId, prodId)
    activate OrderService

    OrderService -> DBUtil : provideConnection()
    activate DBUtil
    DBUtil --> OrderService : Connection
    deactivate DBUtil

    OrderService -> DB : UPDATE orders\nSET shipped=1\nWHERE orderid=? AND prodid=?\nAND shipped=0
    activate DB
    DB --> OrderService : rowsUpdated (int k)
    deactivate DB

    alt k > 0 (update successful)
        OrderService --> ShipmentServlet : "Order Has been shipped successfully!!"
    else k == 0 (already shipped or not found)
        OrderService --> ShipmentServlet : "FAILURE"
    end
    deactivate OrderService

    alt status == "FAILURE"
        ShipmentServlet --> Admin : forward to unshippedItems.jsp
    else status == success
        ShipmentServlet -> UserService : getFName(userName)
        activate UserService

        UserService -> DB : SELECT fname FROM users\nWHERE username=?
        activate DB
        DB --> UserService : firstName
        deactivate DB

        UserService --> ShipmentServlet : firstName (String)
        deactivate UserService

        ShipmentServlet -> MailMessage : orderShipped(userName, firstName,\norderId, amount)
        activate MailMessage

        MailMessage -> JavaMailUtil : sendMail(recipient, subject,\nhtmlTextMessage)
        activate JavaMailUtil

        note right of JavaMailUtil
          Subject: "Hurray!!, Your Order has been
          Shipped from Ellison Electronics"
          Credentials from ResourceBundle
          'application' (mailer.email, mailer.password)
        end note

        JavaMailUtil -> SMTP : Transport.send(MimeMessage)\n[STARTTLS, port 587]
        activate SMTP
        SMTP --> JavaMailUtil : sent confirmation
        deactivate SMTP

        deactivate JavaMailUtil
        deactivate MailMessage

        ShipmentServlet --> Admin : forward to shippedItems.jsp\n+ JS status message
    end

end

deactivate ShipmentServlet

@enduml
