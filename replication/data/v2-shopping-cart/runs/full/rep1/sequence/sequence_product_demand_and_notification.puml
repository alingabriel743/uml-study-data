@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    GroupBorderColor #6C757D
    GroupBackgroundColor #DEE2E6
    GroupFontColor #212529
    DividerBackgroundColor #E9ECEF
    DividerBorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Product Demand and Availability Notification Flow

actor Customer as customer
actor Admin as admin
participant "AddtoCart\n<<Servlet>>" as addToCart
participant "FansMessage\n<<Servlet>>" as fansMessage
participant "ProductServiceImpl" as productSvc
participant "DemandServiceImpl" as demandSvc
participant "UserServiceImpl" as userSvc
participant "DemandBean" as demandBean
participant "MailMessage\n<<static>>" as mailMsg
participant "JavaMailUtil\n<<static>>" as javaMailUtil
database "Database\n(user_demand)" as db
boundary "SMTP\n(smtp.gmail.com:587)" as smtp

== Flow 1: Demand Registration (Out-of-Stock Product) ==

customer -> addToCart : GET/POST /addToCart\n(prodId, userId, pQty)
activate addToCart

addToCart -> productSvc : getProductQuantity(prodId)
activate productSvc
productSvc --> addToCart : availableQty
deactivate productSvc

alt availableQty == 0 : Product fully out of stock
    note over addToCart : status = "Product is Out of Stock!"
    addToCart -> demandBean ** : new DemandBean(userName, prodId, pQty)
    activate demandBean
    demandBean --> addToCart : demandBean
    deactivate demandBean

else availableQty < pQty : Partial stock
    note over addToCart : Add availableQty to cart (partial fill)
    addToCart -> demandBean ** : new DemandBean(userName, prodId, pQty - availableQty)
    activate demandBean
    demandBean --> addToCart : demandBean
    deactivate demandBean
end

addToCart -> demandSvc : addProduct(demandBean)
activate demandSvc

demandSvc -> db : SELECT * FROM user_demand\nWHERE username=? AND prodid=?
activate db
db --> demandSvc : existing record (or empty)
deactivate db

alt demand already exists
    demandSvc --> addToCart : true (skip insert)
else no existing demand
    demandSvc -> db : INSERT INTO user_demand\n(username, prodid, quantity)
    activate db
    db --> demandSvc : rows inserted
    deactivate db
    demandSvc --> addToCart : true
end

deactivate demandSvc

addToCart --> customer : "We Will Mail You\nwhen product is available"
deactivate addToCart

== Flow 2: Availability Notification (Admin Increases Stock) ==

admin -> productSvc : updateProductWithoutImage\n(prevProductId, updatedProduct)
activate productSvc

productSvc -> db : UPDATE product SET pquantity=?\nWHERE pid=?
activate db
db --> productSvc : k (rows updated)
deactivate db

alt k > 0 AND prevQuantity < updatedProduct.getProdQuantity() : quantity increased

    productSvc -> demandSvc ** : new DemandServiceImpl()
    productSvc -> demandSvc : haveDemanded(prevProductId)
    activate demandSvc

    demandSvc -> db : SELECT * FROM user_demand\nWHERE prodid=?
    activate db
    db --> demandSvc : List<DemandBean>
    deactivate db

    demandSvc --> productSvc : demandList
    deactivate demandSvc

    loop for each DemandBean demand in demandList

        productSvc -> userSvc : getFName(demand.getUserName())
        activate userSvc
        userSvc --> productSvc : userFName
        deactivate userSvc

        productSvc -> mailMsg : productAvailableNow(\n  demand.getUserName(),\n  userFName, prodName, prevProductId)
        activate mailMsg

        mailMsg -> javaMailUtil : sendMail(recipient, subject, htmlTextMessage)
        activate javaMailUtil

        javaMailUtil -> smtp : Transport.send(message)
        activate smtp
        smtp --> javaMailUtil : (sent)
        deactivate smtp

        javaMailUtil --> mailMsg : (void)
        deactivate javaMailUtil

        mailMsg --> productSvc : (void)
        deactivate mailMsg

        productSvc -> demandSvc : removeProduct(\n  demand.getUserName(), prevProductId)
        activate demandSvc

        demandSvc -> db : DELETE FROM user_demand\nWHERE username=? AND prodid=?
        activate db
        db --> demandSvc : rows deleted
        deactivate db

        demandSvc --> productSvc : true
        deactivate demandSvc

    end

end

productSvc --> admin : update result
deactivate productSvc

== Flow 3: Fan Feedback Email ==

customer -> fansMessage : GET /fansMessage\n(name, email, comments)
activate fansMessage

fansMessage -> mailMsg : sendMessage(\n  'ellison.alumni@gmail.com',\n  subject, htmlTextMessage)
activate mailMsg

mailMsg -> javaMailUtil : sendMail(toEmailId, subject, htmlTextMessage)
activate javaMailUtil

javaMailUtil -> smtp : Transport.send(message)
activate smtp
smtp --> javaMailUtil : (sent)
deactivate smtp

javaMailUtil --> mailMsg : (void)
deactivate javaMailUtil

mailMsg --> fansMessage : "SUCCESS" or "FAILURE"
deactivate mailMsg

fansMessage --> customer : forward to index.jsp\n+ JS alert with status
deactivate fansMessage

@enduml
