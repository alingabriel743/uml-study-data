@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    ActorBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
    BoxBackgroundColor #F1F3F5
    NoteBackgroundColor #FFF9C4
    NoteBorderColor #F9A825
    DividerBackgroundColor #DEE2E6
    GroupBackgroundColor #E3F2FD
    GroupBorderColor #1565C0
}

title Admin Product Management Flow

actor "Admin (Browser)" as Admin

participant "AddProductSrv\n<<HttpServlet>>" as AddProductSrv
participant "UpdateProductSrv\n<<HttpServlet>>" as UpdateProductSrv
participant "ShowImage\n<<HttpServlet>>" as ShowImage
participant "HttpSession" as Session
participant "ProductServiceImpl\n<<Service>>" as ProductSvc
participant "ProductBean\n<<DTO>>" as ProductBean
participant "IDUtil\n<<Utility>>" as IDUtil
participant "DBUtil\n<<Utility>>" as DBUtil
participant "Database\n<<MySQL>>" as DB
participant "DemandServiceImpl\n<<Service>>" as DemandSvc
participant "UserServiceImpl\n<<Service>>" as UserSvc
participant "MailMessage\n<<Utility>>" as Mail

== ADD PRODUCT FLOW ==

Admin -> AddProductSrv : POST /AddProductSrv\n(name, type, info, price, quantity, image:multipart)
activate AddProductSrv

AddProductSrv -> Session : getSession()
activate Session
Session --> AddProductSrv : session
deactivate Session

AddProductSrv -> Session : getAttribute("usertype"), getAttribute("username"), getAttribute("password")
activate Session
Session --> AddProductSrv : usertype, username, password
deactivate Session

alt not admin or session expired
    AddProductSrv --> Admin : redirect login.jsp?message=Access Denied!
else admin authenticated
    AddProductSrv -> AddProductSrv : getPart("image").getInputStream()\n→ prodImage:InputStream

    AddProductSrv -> ProductSvc : new ProductServiceImpl()
    activate ProductSvc

    AddProductSrv -> ProductSvc : addProduct(prodName, prodType, prodInfo,\nprodPrice, prodQuantity, prodImage)

    ProductSvc -> IDUtil : generateId()
    activate IDUtil
    IDUtil --> ProductSvc : prodId:String
    deactivate IDUtil

    ProductSvc -> ProductBean : new ProductBean(prodId, prodName, prodType,\nprodInfo, prodPrice, prodQuantity, prodImage)
    activate ProductBean
    ProductBean --> ProductSvc : product:ProductBean
    deactivate ProductBean

    ProductSvc -> ProductSvc : addProduct(product:ProductBean) [overload]

    ProductSvc -> DBUtil : provideConnection()
    activate DBUtil
    DBUtil --> ProductSvc : con:Connection
    deactivate DBUtil

    ProductSvc -> DB : PreparedStatement INSERT INTO product\nVALUES(pid, pname, ptype, pinfo, pprice, pquantity, image)
    activate DB
    DB --> ProductSvc : k = executeUpdate()
    deactivate DB

    ProductSvc -> DBUtil : closeConnection(ps)
    activate DBUtil
    DBUtil --> ProductSvc : void
    deactivate DBUtil

    ProductSvc --> AddProductSrv : status:String ("Product Added Successfully..." or error)
    deactivate ProductSvc

    AddProductSrv --> Admin : forward addProduct.jsp?message={status}
end

deactivate AddProductSrv

== UPDATE PRODUCT (WITHOUT IMAGE) FLOW ==

Admin -> UpdateProductSrv : GET /UpdateProductSrv\n(pid, name, type, info, price, quantity)
activate UpdateProductSrv

UpdateProductSrv -> Session : getSession()
activate Session
Session --> UpdateProductSrv : session
deactivate Session

UpdateProductSrv -> Session : getAttribute("usertype"), getAttribute("username"), getAttribute("password")
activate Session
Session --> UpdateProductSrv : usertype, username, password
deactivate Session

alt not admin or session expired
    UpdateProductSrv --> Admin : redirect login.jsp?message=Access Denied!
else admin authenticated
    UpdateProductSrv -> ProductBean : new ProductBean()
    activate ProductBean
    UpdateProductSrv -> ProductBean : setProdId(pid), setProdName(name),\nsetProdType(type), setProdInfo(info),\nsetProdPrice(price), setProdQuantity(qty)
    ProductBean --> UpdateProductSrv : updatedProduct:ProductBean
    deactivate ProductBean

    UpdateProductSrv -> ProductSvc : new ProductServiceImpl()
    activate ProductSvc

    UpdateProductSrv -> ProductSvc : updateProductWithoutImage(prevProductId, updatedProduct)

    ProductSvc -> ProductSvc : new ProductServiceImpl().getProductQuantity(prevProductId)

    ProductSvc -> DBUtil : provideConnection()
    activate DBUtil
    DBUtil --> ProductSvc : con:Connection
    deactivate DBUtil

    ProductSvc -> DB : PreparedStatement UPDATE product SET\npname, ptype, pinfo, pprice, pquantity\nWHERE pid = ?
    activate DB
    DB --> ProductSvc : k = executeUpdate()
    deactivate DB

    alt k > 0 AND prevQuantity < updatedQuantity (restock detected)
        ProductSvc -> DemandSvc : haveDemanded(prevProductId)
        activate DemandSvc
        DemandSvc --> ProductSvc : demandList:List<DemandBean>
        deactivate DemandSvc

        loop for each DemandBean in demandList
            ProductSvc -> UserSvc : getFName(demand.getUserName())
            activate UserSvc
            UserSvc --> ProductSvc : userFName:String
            deactivate UserSvc

            ProductSvc -> Mail : productAvailableNow(userName, userFName,\nprodName, prodId)
            activate Mail
            Mail --> ProductSvc : void
            deactivate Mail

            ProductSvc -> DemandSvc : removeProduct(userName, prodId)
            activate DemandSvc
            DemandSvc --> ProductSvc : flag:boolean
            deactivate DemandSvc
        end
    end

    ProductSvc -> DBUtil : closeConnection(ps)
    activate DBUtil
    DBUtil --> ProductSvc : void
    deactivate DBUtil

    ProductSvc --> UpdateProductSrv : status:String
    deactivate ProductSvc

    UpdateProductSrv --> Admin : forward updateProduct.jsp?prodid={pid}&message={status}
end

deactivate UpdateProductSrv

== SHOW IMAGE FLOW ==

Admin -> ShowImage : GET /ShowImage?pid={prodId}
activate ShowImage

ShowImage -> ProductSvc : new ProductServiceImpl()
activate ProductSvc

ShowImage -> ProductSvc : getImage(prodId)

ProductSvc -> DBUtil : provideConnection()
activate DBUtil
DBUtil --> ProductSvc : con:Connection
deactivate DBUtil

ProductSvc -> DB : PreparedStatement SELECT image\nFROM product WHERE pid = ?
activate DB
DB --> ProductSvc : rs.getBytes("image") → image:byte[]
deactivate DB

ProductSvc -> DBUtil : closeConnection(con, ps, rs)
activate DBUtil
DBUtil --> ProductSvc : void
deactivate DBUtil

ProductSvc --> ShowImage : image:byte[]
deactivate ProductSvc

alt image == null
    ShowImage -> ShowImage : ImageIO.read(noimage.jpg)\n→ fallback byte[]
end

ShowImage --> Admin : response.getOutputStream().write(image)
deactivate ShowImage

@enduml
