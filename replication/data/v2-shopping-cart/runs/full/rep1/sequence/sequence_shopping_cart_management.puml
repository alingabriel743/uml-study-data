@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    ActorBackgroundColor #E9ECEF
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
}

title Shopping Cart Management Flow

actor "Customer" as customer
actor "Admin" as admin
participant "AddtoCart\n(HttpServlet)" as addToCart
participant "UpdateToCart\n(HttpServlet)" as updateToCart
participant "RemoveProductSrv\n(HttpServlet)" as removeProductSrv
participant "ProductServiceImpl" as productSvc
participant "CartServiceImpl" as cartSvc
participant "DemandServiceImpl" as demandSvc
participant "DBUtil" as dbUtil
database "Database\n(usercart)" as db

== ADD TO CART (AddtoCart.doGet) ==

customer -> addToCart : GET /AddtoCart?pid=&pqty=\n[session: username, usertype=customer]
activate addToCart

addToCart -> productSvc : getProductDetails(prodId)
activate productSvc
productSvc -> dbUtil : provideConnection()
activate dbUtil
dbUtil --> productSvc : Connection
deactivate dbUtil
productSvc -> db : SELECT * FROM products WHERE prodid=?
db --> productSvc : ProductBean (availableQty)
productSvc --> addToCart : ProductBean
deactivate productSvc

addToCart -> cartSvc : getProductCount(userId, prodId)
activate cartSvc
cartSvc -> dbUtil : provideConnection()
activate dbUtil
dbUtil --> cartSvc : Connection
deactivate dbUtil
cartSvc -> db : SELECT sum(quantity) FROM usercart\nWHERE username=? AND prodid=?
db --> cartSvc : cartQty
cartSvc --> addToCart : cartQty (current quantity in cart)
deactivate cartSvc

alt pQty == cartQty (toggle-off: remove one unit)

    addToCart -> cartSvc : removeProductFromCart(userId, prodId)
    activate cartSvc
    cartSvc -> dbUtil : provideConnection()
    activate dbUtil
    dbUtil --> cartSvc : Connection
    deactivate dbUtil
    cartSvc -> db : SELECT * FROM usercart\nWHERE username=? AND prodid=?
    db --> cartSvc : CartBean (qty)
    alt qty - 1 > 0
        cartSvc -> db : UPDATE usercart SET quantity=qty-1\nWHERE username=? AND prodid=?
    else qty - 1 <= 0
        cartSvc -> db : DELETE FROM usercart\nWHERE username=? AND prodid=?
    end
    db --> cartSvc : update result
    cartSvc --> addToCart : status message
    deactivate cartSvc
    addToCart --> customer : forward userHome.jsp\n[status: item removed/decremented]

else availableQty < pQty (stock insufficient)

    alt availableQty == 0
        addToCart --> customer : forward userHome.jsp\n["Product is Out of Stock!"]
    else availableQty > 0
        addToCart -> cartSvc : updateProductToCart(userId, prodId, availableQty)
        activate cartSvc
        cartSvc -> dbUtil : provideConnection()
        activate dbUtil
        dbUtil --> cartSvc : Connection
        deactivate dbUtil
        cartSvc -> db : SELECT * FROM usercart\nWHERE username=? AND prodid=?
        alt row exists
            cartSvc -> db : UPDATE usercart SET quantity=availableQty
        else row not found
            cartSvc -> db : INSERT INTO usercart\n(username, prodid, quantity)
        end
        db --> cartSvc : update result
        cartSvc --> addToCart : status
        deactivate cartSvc
    end

    addToCart -> demandSvc : addProduct(DemandBean(userName, prodId, shortfall))
    activate demandSvc
    demandSvc -> db : INSERT INTO demand\n(username, prodid, demandqty)
    db --> demandSvc : inserted
    demandSvc --> addToCart : demand registered
    deactivate demandSvc
    addToCart --> customer : forward cartDetails.jsp\n[availability warning, capped qty]

else Normal add (availableQty >= pQty)

    addToCart -> cartSvc : updateProductToCart(userId, prodId, pQty + cartQty)
    activate cartSvc
    cartSvc -> dbUtil : provideConnection()
    activate dbUtil
    dbUtil --> cartSvc : Connection
    deactivate dbUtil
    cartSvc -> db : SELECT * FROM usercart\nWHERE username=? AND prodid=?
    alt row exists and qty > 0
        cartSvc -> db : UPDATE usercart SET quantity=pQty+cartQty
    else row not found
        cartSvc -> db : INSERT INTO usercart\n(username, prodid, quantity)
    end
    db --> cartSvc : update result
    cartSvc --> addToCart : status
    deactivate cartSvc
    addToCart --> customer : forward userHome.jsp\n[success status]

end
deactivate addToCart

== UPDATE CART QUANTITY (UpdateToCart.doGet) ==

customer -> updateToCart : GET /UpdateToCart?pid=&pqty=\n[session: username, usertype=customer]
activate updateToCart

updateToCart -> productSvc : getProductDetails(prodId)
activate productSvc
productSvc -> db : SELECT * FROM products WHERE prodid=?
db --> productSvc : ProductBean (availableQty)
productSvc --> updateToCart : ProductBean
deactivate productSvc

alt availableQty < pQty (stock insufficient)

    updateToCart -> cartSvc : updateProductToCart(userId, prodId, availableQty)
    activate cartSvc
    cartSvc -> dbUtil : provideConnection()
    activate dbUtil
    dbUtil --> cartSvc : Connection
    deactivate dbUtil
    cartSvc -> db : SELECT / UPDATE or INSERT usercart\n(capped to availableQty)
    db --> cartSvc : update result
    cartSvc --> updateToCart : status
    deactivate cartSvc

    updateToCart -> demandSvc : addProduct(DemandBean(userName, prodId, shortfall))
    activate demandSvc
    demandSvc -> db : INSERT INTO demand\n(username, prodid, demandqty)
    db --> demandSvc : inserted
    demandSvc --> updateToCart : demand registered
    deactivate demandSvc
    updateToCart --> customer : forward cartDetails.jsp\n[capped-qty warning]

else Sufficient stock (availableQty >= pQty)

    updateToCart -> cartSvc : updateProductToCart(userId, prodId, pQty)
    activate cartSvc
    cartSvc -> dbUtil : provideConnection()
    activate dbUtil
    dbUtil --> cartSvc : Connection
    deactivate dbUtil
    cartSvc -> db : SELECT / UPDATE or INSERT usercart\n(requested qty)
    db --> cartSvc : update result
    cartSvc --> updateToCart : status
    deactivate cartSvc
    updateToCart --> customer : forward cartDetails.jsp\n[success]

end
deactivate updateToCart

== REMOVE PRODUCT FROM STORE (RemoveProductSrv.doGet) [Admin Only] ==

admin -> removeProductSrv : GET /RemoveProductSrv?prodid=\n[session: usertype=admin]
activate removeProductSrv

removeProductSrv -> productSvc : removeProduct(prodId)
activate productSvc
productSvc -> dbUtil : provideConnection()
activate dbUtil
dbUtil --> productSvc : Connection
deactivate dbUtil
productSvc -> db : DELETE FROM products WHERE prodid=?
db --> productSvc : deletion result
productSvc --> removeProductSrv : status message
deactivate productSvc

removeProductSrv --> admin : forward removeProduct.jsp?message=status
deactivate removeProductSrv

@enduml
