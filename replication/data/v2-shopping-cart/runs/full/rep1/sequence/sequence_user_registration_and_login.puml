@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    GroupBackgroundColor #E9ECEF
    GroupBorderColor #6C757D
    DividerBackgroundColor #DEE2E6
    DividerBorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF3CD
    BorderColor #856404
    FontColor #212529
}

title User Registration and Login Flow

actor "User (Browser)" as User
participant "RegisterSrv\n@WebServlet(/RegisterSrv)" as RegisterSrv
participant "LoginSrv\n@WebServlet(/LoginSrv)" as LoginSrv
participant "LogoutSrv\n@WebServlet(/LogoutSrv)" as LogoutSrv
participant "UserServiceImpl" as UserSvc
participant "DBUtil" as DBUtil
database "Database" as DB
participant "HttpSession" as Session
participant "MailMessage" as Mail
participant "JavaMailUtil" as JavaMail
boundary "Email Server\n(SMTP)" as EmailServer

== Registration ==

User -> RegisterSrv : POST /RegisterSrv\n(username, mobile, email, address,\npincode, password, confirmPassword)
activate RegisterSrv

alt password != confirmPassword
    RegisterSrv --> User : forward register.jsp\n?message=Password not matching!
else passwords match
    RegisterSrv -> UserSvc : new UserServiceImpl()
    activate UserSvc
    RegisterSrv -> UserSvc : registerUser(UserBean)

    UserSvc -> DBUtil : provideConnection()
    activate DBUtil
    DBUtil --> UserSvc : Connection
    deactivate DBUtil

    note right of UserSvc : isRegistered(emailId) check
    UserSvc -> DBUtil : provideConnection()
    activate DBUtil
    DBUtil --> UserSvc : Connection
    deactivate DBUtil

    UserSvc -> DB : SELECT * FROM user\nWHERE email=?
    activate DB
    DB --> UserSvc : ResultSet
    deactivate DB

    alt email already registered
        UserSvc --> RegisterSrv : return "Email Id Already Registered!"
        RegisterSrv --> User : forward register.jsp\n?message=Email Id Already Registered!
    else email not registered
        UserSvc -> DB : INSERT INTO user VALUES\n(email, name, mobile, address, pincode, password)
        activate DB
        DB --> UserSvc : rows affected (k > 0)
        deactivate DB

        UserSvc -> Mail : registrationSuccess(email, firstName)
        activate Mail
        Mail -> JavaMail : sendMail(recipient, subject, htmlBody)
        activate JavaMail
        JavaMail -> EmailServer : SMTP send
        activate EmailServer
        EmailServer --> JavaMail : sent
        deactivate EmailServer
        deactivate JavaMail
        deactivate Mail

        UserSvc -> DBUtil : closeConnection(ps)
        activate DBUtil
        DBUtil --> UserSvc : closed
        deactivate DBUtil

        UserSvc --> RegisterSrv : return "User Registered Successfully!"
        deactivate UserSvc
        RegisterSrv --> User : forward register.jsp\n?message=User Registered Successfully!
    end
end

deactivate RegisterSrv

== Customer Login ==

User -> LoginSrv : POST /LoginSrv\n(username, password, usertype="customer")
activate LoginSrv

LoginSrv -> UserSvc : new UserServiceImpl()
activate UserSvc
LoginSrv -> UserSvc : isValidCredential(userName, password)

UserSvc -> DBUtil : provideConnection()
activate DBUtil
DBUtil --> UserSvc : Connection
deactivate DBUtil

UserSvc -> DB : SELECT * FROM user\nWHERE email=? AND password=?
activate DB
DB --> UserSvc : ResultSet
deactivate DB

alt credentials valid
    UserSvc --> LoginSrv : return "valid"

    LoginSrv -> UserSvc : getUserDetails(userName, password)
    UserSvc -> DB : SELECT * FROM user\nWHERE email=? AND password=?
    activate DB
    DB --> UserSvc : ResultSet → UserBean\n(name, mobile, email, address, pincode, password)
    deactivate DB
    UserSvc --> LoginSrv : return UserBean
    deactivate UserSvc

    LoginSrv -> Session : setAttribute("userdata", userBean)
    activate Session
    LoginSrv -> Session : setAttribute("username", userName)
    LoginSrv -> Session : setAttribute("password", password)
    LoginSrv -> Session : setAttribute("usertype", "customer")
    deactivate Session

    LoginSrv --> User : forward userHome.jsp
else credentials invalid
    deactivate UserSvc
    LoginSrv --> User : forward login.jsp\n?message=Login Denied
end

deactivate LoginSrv

== Admin Login ==

User -> LoginSrv : POST /LoginSrv\n(username="admin@gmail.com",\npassword="admin", usertype="admin")
activate LoginSrv

note over LoginSrv : Hardcoded check:\npassword=="admin" &&\nusername=="admin@gmail.com"

alt valid admin credentials
    LoginSrv -> Session : setAttribute("username", "admin@gmail.com")
    activate Session
    LoginSrv -> Session : setAttribute("usertype", "admin")
    deactivate Session
    LoginSrv --> User : forward adminViewProduct.jsp
else invalid admin credentials
    LoginSrv --> User : include login.jsp\n?message=Login Denied
end

deactivate LoginSrv

== Logout ==

User -> LogoutSrv : GET/POST /LogoutSrv
activate LogoutSrv

LogoutSrv -> Session : setAttribute("username", null)
activate Session
LogoutSrv -> Session : setAttribute("password", null)
LogoutSrv -> Session : setAttribute("usertype", null)
LogoutSrv -> Session : setAttribute("userdata", null)
deactivate Session

LogoutSrv --> User : forward login.jsp\n?message=Successfully Logged Out!
deactivate LogoutSrv

@enduml
