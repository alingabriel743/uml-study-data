@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Customer Account Management

left to right direction

actor "Customer" as Customer
actor "Admin" as Admin
actor "Email Service" as EmailService

rectangle "Customer Account Management" {
    usecase "Register Account" as UC_Register
    usecase "Login as Customer" as UC_LoginCustomer
    usecase "Login as Admin" as UC_LoginAdmin
    usecase "Logout" as UC_Logout
    usecase "Validate Credentials" as UC_ValidateCredentials
    usecase "Check Email Already Registered" as UC_CheckEmail
    usecase "Get User Details" as UC_GetUserDetails
    usecase "Receive Registration\nConfirmation Email" as UC_ConfirmEmail
}

' Actor associations
Customer --> UC_Register
Customer --> UC_LoginCustomer
Customer --> UC_Logout

Admin --> UC_LoginAdmin
Admin --> UC_Logout

EmailService --> UC_ConfirmEmail

' Include relationships
UC_LoginCustomer ..> UC_ValidateCredentials : <<include>>
UC_LoginCustomer ..> UC_GetUserDetails : <<include>>
UC_Register ..> UC_CheckEmail : <<include>>

' Extend relationships
UC_Register ..> UC_ConfirmEmail : <<extend>>

@enduml
