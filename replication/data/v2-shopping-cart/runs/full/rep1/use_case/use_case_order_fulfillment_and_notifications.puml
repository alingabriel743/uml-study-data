@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Order Fulfillment and Notifications

left to right direction

actor "Customer" as Customer
actor "Admin" as Admin
actor "System\n(Email Notifier)" as System

rectangle "Ellison Electronics Shopping Cart" {
    usecase "Place Order /\nProcess Payment" as UC1
    usecase "View Order Details" as UC2
    usecase "Register Demand for\nOut-of-Stock Product" as UC3
    usecase "Ship Order" as UC4
    usecase "Restock Product /\nTrigger Demand Alerts" as UC5
    usecase "Send Transaction\nConfirmation Email" as UC6
    usecase "Send Order\nShipped Email" as UC7
    usecase "Send Product\nAvailability Notification" as UC8
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Admin --> UC4
Admin --> UC5

UC1 ..> UC2 : <<include>>
UC4 ..> UC7 : <<include>>
UC6 ..> UC1 : <<extend>>
UC8 ..> UC5 : <<extend>>

System --> UC6
System --> UC7
System --> UC8

@enduml
