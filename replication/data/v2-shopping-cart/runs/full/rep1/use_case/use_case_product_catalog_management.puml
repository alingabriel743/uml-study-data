@startuml use_case_product_catalog_management

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Product Catalog Management

left to right direction

actor "Admin" as admin
actor "Customer" as customer
actor "Email Service" as email #LightYellow

rectangle "Product Catalog Management" {

    usecase "Add Product" as UC1
    usecase "Update Product" as UC2
    usecase "Remove Product" as UC3
    usecase "Browse Product Catalog" as UC4
    usecase "View Product Details" as UC5
    usecase "View Product Image" as UC6

    usecase "Validate Admin Session" as UC_AUTH
    usecase "Notify Waiting Customers" as UC_NOTIFY

}

' Admin interactions
admin --> UC1
admin --> UC2
admin --> UC3

' Customer interactions
customer --> UC4
customer --> UC5
customer --> UC6

' Email service involvement in notifications
email --> UC_NOTIFY

' Extend: admin actions guarded by session validation
UC1 .> UC_AUTH : <<extend>>
UC2 .> UC_AUTH : <<extend>>
UC3 .> UC_AUTH : <<extend>>

' Include: updating product with increased quantity triggers notification
UC2 .> UC_NOTIFY : <<include>>

' Browse catalog leads to viewing details or image
UC4 .> UC5 : <<include>>
UC5 .> UC6 : <<include>>

@enduml
