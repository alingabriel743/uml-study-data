@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Shopping Cart Management

left to right direction

actor "Customer" as customer
actor "Email Service" as emailSvc #E3F2FD

rectangle "Shopping Cart Management" {

    usecase "Authenticate Session" as UC_AUTH
    usecase "Add Product to Cart" as UC_ADD
    usecase "Update Cart Quantity" as UC_UPDATE
    usecase "Remove Product from Cart" as UC_REMOVE
    usecase "View Cart Items" as UC_VIEW
    usecase "Get Cart Item Count" as UC_COUNT
    usecase "Register Demand\n(Out of Stock)" as UC_DEMAND
    usecase "Send Demand\nNotification" as UC_NOTIFY

}

' --- Customer associations ---
customer --> UC_ADD
customer --> UC_UPDATE
customer --> UC_REMOVE
customer --> UC_VIEW
customer --> UC_COUNT

' --- Email Service association ---
emailSvc <-- UC_NOTIFY

' --- Include relationships ---
UC_ADD       ..> UC_AUTH    : <<include>>
UC_UPDATE    ..> UC_AUTH    : <<include>>
UC_ADD       ..> UC_COUNT   : <<include>>
UC_DEMAND    ..> UC_NOTIFY  : <<include>>

' --- Extend relationships ---
UC_DEMAND  ..> UC_ADD    : <<extend>>\n{insufficientStock}
UC_DEMAND  ..> UC_UPDATE : <<extend>>\n{insufficientStock}
UC_REMOVE  ..> UC_ADD    : <<extend>>\n{qtyMatchesCartQty}

note right of UC_ADD
  Session guard: checks username,
  password, and usertype == 'customer'
  via HttpSession before processing
end note

note right of UC_DEMAND
  Triggered when requested qty
  exceeds available stock.
  Excess qty recorded via
  DemandServiceImpl; customer
  notified by email.
end note

@enduml
