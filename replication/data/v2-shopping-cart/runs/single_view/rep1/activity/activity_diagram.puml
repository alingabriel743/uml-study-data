@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
    StartColor #212529
    EndColor #212529
}

skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 13
}

title Shopping Cart — Main Business Flow

|User / Browser|
start
:Visit Shopping Site;

if (Already Registered?) then (no)
    :Submit Registration Form\n(name, email, address, mobile, password);
    |Servlet Layer|
    :RegisterSrv.doPost();
    |Service Layer|
    :UserService.registerUser();
    :Validate and persist UserBean to DB;
    |Utility / Notifications|
    :MailMessage.registrationSuccess()\nSend welcome email via JavaMailUtil;
    |User / Browser|
    :Receive Registration Confirmation;
else (yes)
endif

:Submit Login Credentials\n(emailId, password);

|Servlet Layer|
:LoginSrv.doPost();

|Service Layer|
:UserService.isValidCredential(emailId, password);

if (Valid Credentials?) then (no)
    |User / Browser|
    :Display Login Error;
    stop
else (yes)
    |User / Browser|
    :View Product Catalogue;
endif

|Service Layer|
:ProductService.getAllProductsByType(type);
:Retrieve ProductBean list from DB;

|User / Browser|
:Browse Products;

if (Product in Stock?) then (no)
    :Submit Demand Request;
    |Servlet Layer|
    :FansMessage.doPost();
    |Service Layer|
    :DemandService.addProduct(userId, prodId, demandQty);
    :Persist DemandBean to DB;
    note right
      When stock is replenished:
      MailMessage.productAvailableNow()
      notifies demanding users
    end note
    |User / Browser|
    :Receive "Out of Stock — Demand Registered" Notice;
else (yes)
    :Select Product and Quantity;
    |Servlet Layer|
    :AddtoCart.doPost();
    |Service Layer|
    :CartService.addProductToCart(userId, prodId, qty);
    :Persist CartBean to DB;
    |User / Browser|
    :View Shopping Cart;

    if (Modify Cart?) then (update qty)
        :Submit Updated Quantity;
        |Servlet Layer|
        :UpdateToCart.doPost();
        |Service Layer|
        :CartService.updateProductToCart(userId, prodId, newQty);
    else if (Modify Cart?) then (remove item)
        :Request Item Removal;
        |Servlet Layer|
        :RemoveProductSrv.doPost();
        |Service Layer|
        :CartService.removeProductFromCart(userId, prodId);
    else (proceed)
    endif

    |User / Browser|
    :Confirm Order and Proceed to Payment;
    |Servlet Layer|
    :OrderServlet.doPost();
    |Service Layer|
    :OrderService.paymentSuccess(userName, paidAmount);
    fork
        :OrderService.addTransaction(TransactionBean)\nPersist transaction record;
    fork again
        :OrderService.addOrder(OrderBean)\nPersist order line items;
    end fork
    :IDUtil.generateTransId() — assign transaction ID;
    |Utility / Notifications|
    :MailMessage.transactionSuccess()\nSend order confirmation email;
    |User / Browser|
    :Receive Order Confirmation;

    |Admin|
    :Review Pending Orders;
    :OrderService.getAllOrders();

    if (Ready to Ship?) then (yes)
        :Initiate Shipment;
        |Servlet Layer|
        :ShipmentServlet.doPost();
        |Service Layer|
        :OrderService.shipNow(orderId, prodId);
        :ProductService.sellNProduct(prodId, n)\nDecrement inventory;
        :OrderService.countSoldItem(prodId);
        |Utility / Notifications|
        :MailMessage.orderShipped()\nSend shipment notification email;
        |User / Browser|
        :Receive Shipment Notification;
    else (no)
        |Admin|
        :Hold Order — Await Stock;
    endif
endif

|User / Browser|
:Log Out;
|Servlet Layer|
:LogoutSrv.doPost();
:Invalidate HTTP Session;

|User / Browser|
stop

@enduml
