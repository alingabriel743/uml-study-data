' ── com.shashi.utility ───────────────────────────────────────────
package "com.shashi.utility" {

    class DBUtil {
        -conn: Connection
        +DBUtil()
        +provideConnection(): Connection
        +closeConnection(con: Connection): void
        +closeConnection(rs: ResultSet): void
        +closeConnection(ps: PreparedStatement): void
    }

    class IDUtil {
        +generateId(): String
        +generateTransId(): String
    }

    class JavaMailUtil {
        +prepareMessage(session: Session, myAccountEmail: String, recipientEmail: String): Message
        +prepareMessage(session: Session, myAccountEmail: String, recipientEmail: String, subject: String, htmlTextMessage: String): Message
        +sendMail(recipientMailId: String): void
        +sendMail(recipient: String, subject: String, htmlTextMessage: String): void
    }

    class MailMessage {
        +registrationSuccess(emailId: String, name: String): void
        +transactionSuccess(recipientEmail: String, name: String, transId: String, transAmount: double): void
        +orderShipped(recipientEmail: String, name: String, transId: String, transAmount: double): void
        +productAvailableNow(recipientEmail: String, name: String, prodName: String, prodId: String): void
        +sendMessage(toEmailId: String, subject: String, htmlTextMessage: String): void
    }

    class TestMail {
        +main(args: String[]): void
    }
}

' ── Relationships ────────────────────────────────────────────────

' Beans implement Serializable
CartBean ..|> Serializable
DemandBean ..|> Serializable
OrderBean ..|> Serializable
OrderDetails ..|> Serializable
ProductBean ..|> Serializable
TransactionBean ..|> Serializable
UserBean ..|> Serializable

' Service implementations implement their interfaces
CartServiceImpl ..|> CartService
DemandServiceImpl ..|> DemandService
OrderServiceImpl ..|> OrderService
ProductServiceImpl ..|> ProductService
TransServiceImpl ..|> TransService
UserServiceImpl ..|> UserService

' Servlets extend HttpServlet
AddtoCart --|> HttpServlet
LoginSrv --|> HttpServlet
LogoutSrv --|> HttpServlet
RegisterSrv --|> HttpServlet
OrderServlet --|> HttpServlet
AddProductSrv --|> HttpServlet
RemoveProductSrv --|> HttpServlet
UpdateProductSrv --|> HttpServlet
UpdateToCart --|> HttpServlet
ShipmentServlet --|> HttpServlet
ShowImage --|> HttpServlet
FansMessage --|> HttpServlet

' Utility dependencies
MailMessage ..> JavaMailUtil : uses

' Service impl uses beans (key dependencies)
OrderServiceImpl ..> OrderBean : uses
OrderServiceImpl ..> TransactionBean : uses
ProductServiceImpl ..> ProductBean : uses
UserServiceImpl ..> UserBean : uses
DemandServiceImpl ..> DemandBean : uses

@enduml
