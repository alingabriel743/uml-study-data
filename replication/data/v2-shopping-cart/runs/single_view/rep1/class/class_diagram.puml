@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
}

title Shopping Cart Application — Class Diagram

' ── External references ───────────────────────────────────────────
class HttpServlet <<external>> {
    +doGet(request: HttpServletRequest, response: HttpServletResponse): void
    +doPost(request: HttpServletRequest, response: HttpServletResponse): void
}

interface Serializable <<external>> {
}

' ── com.shashi.constants ──────────────────────────────────────────
package "com.shashi.constants" {
    interface IUserConstants {
    }
}

' ── com.shashi.beans ─────────────────────────────────────────────
package "com.shashi.beans" {

    class CartBean {
        +userId: String
        +prodId: String
        +quantity: int
        +CartBean()
        +CartBean(userId: String, prodId: String, quantity: int)
        +getUserId(): String
        +getProdId(): String
        +getQuantity(): int
        +setUserId(userId: String): void
        +setProdId(prodId: String): void
        +setQuantity(quantity: int): void
    }

    class DemandBean {
        -userName: String
        -prodId: String
        -demandQty: int
        +DemandBean()
        +DemandBean(userName: String, prodId: String, demandQty: int)
        +getUserName(): String
        +getProdId(): String
        +getDemandQty(): int
        +setUserName(userName: String): void
        +setProdId(prodId: String): void
        +setDemandQty(demandQty: int): void
    }

    class OrderBean {
        -transactionId: String
        -productId: String
        -quantity: int
        -amount: Double
        -shipped: int
        +OrderBean()
        +OrderBean(transactionId: String, productId: String, quantity: int, amount: Double)
        +OrderBean(transactionId: String, productId: String, quantity: int, amount: Double, shipped: int)
        +getTransactionId(): String
        +getProductId(): String
        +getQuantity(): int
        +getAmount(): Double
        +getShipped(): int
        +setProductId(productId: String): void
        +setAmount(amount: Double): void
    }

    class OrderDetails {
        -orderId: String
        -productId: String
        -prodName: String
        -prodImage: InputStream
        -qty: String
        -amount: String
        -time: Timestamp
        -shipped: int
        +getOrderId(): String
        +getProductId(): String
        +getProdName(): String
        +getProdImage(): InputStream
        +getQty(): String
        +getAmount(): String
        +getTime(): Timestamp
        +getShipped(): int
        +setOrderId(orderId: String): void
        +setAmount(amount: String): void
    }

    class ProductBean {
        -prodId: String
        -prodName: String
        -prodType: String
        -prodInfo: String
        -prodPrice: double
        -prodQuantity: int
        -prodImage: InputStream
        +ProductBean()
        +ProductBean(prodId: String, prodName: String, prodType: String, prodInfo: String, prodPrice: double, prodQuantity: int, prodImage: InputStream)
        +getProdId(): String
        +getProdName(): String
        +getProdType(): String
        +getProdInfo(): String
        +getProdPrice(): double
        +getProdQuantity(): int
        +getProdImage(): InputStream
        +setProdId(prodId: String): void
    }

    class TransactionBean {
        -transactionId: String
        -userName: String
        -transDateTime: Timestamp
        -transAmount: double
        +TransactionBean()
        +TransactionBean(userName: String, transAmount: double)
        +TransactionBean(transactionId: String, userName: String, transAmount: double)
        +TransactionBean(userName: String, transDateTime: Timestamp, transAmount: double)
        +TransactionBean(transactionId: String, userName: String, transDateTime: Timestamp, transAmount: double)
        +getTransactionId(): String
        +getUserName(): String
        +getTransDateTime(): Timestamp
        +getTransAmount(): double
        +setTransAmount(transAmount: double): void
    }

    class UserBean {
        -name: String
        -mobile: Long
        -email: String
        -address: String
        -pinCode: int
        -password: String
        +UserBean()
        +UserBean(userName: String, mobileNo: Long, emailId: String, address: String, pinCode: int, password: String)
        +getName(): String
        +getMobile(): Long
        +getEmail(): String
        +getAddress(): String
        +getPinCode(): int
        +getPassword(): String
        +setEmail(email: String): void
        +setAddress(address: String): void
    }
}

' ── com.shashi.service (interfaces) ──────────────────────────────
package "com.shashi.service" {

    interface CartService {
        +addProductToCart(userId: String, prodId: String, prodQty: int): boolean
        +getAllCartItems(userId: String): List
        +getCartCount(userId: String): int
        +getCartItemCount(userId: String, itemId: String): int
        +removeProductFromCart(userId: String, prodId: String): boolean
        +removeAProduct(userId: String, prodId: String): boolean
        +updateProductToCart(userId: String, prodId: String, prodQty: int): boolean
    }

    interface DemandService {
        +addProduct(userId: String, prodId: String, demandQty: int): boolean
        +addProduct(userDemandBean: DemandBean): boolean
        +haveDemanded(prodId: String): List
        +removeProduct(userId: String, prodId: String): boolean
    }

    interface OrderService {
        +addOrder(order: OrderBean): boolean
        +addTransaction(transaction: TransactionBean): boolean
        +countSoldItem(prodId: String): int
        +getAllOrderDetails(userEmailId: String): List
        +getAllOrders(): List
        +getOrdersByUserId(emailId: String): List
        +paymentSuccess(userName: String, paidAmount: double): String
        +shipNow(orderId: String, prodId: String): boolean
    }

    interface ProductService {
        +addProduct(prodName: String, prodType: String, prodInfo: String, prodPrice: double, prodQuantity: int, prodImage: InputStream): boolean
        +addProduct(product: ProductBean): boolean
        +getAllProducts(): List
        +getAllProductsByType(type: String): List
        +getImage(prodId: String): InputStream
        +getProductDetails(prodId: String): ProductBean
        +getProductPrice(prodId: String): double
        +getProductQuantity(prodId: String): int
        +removeProduct(prodId: String): boolean
        +searchAllProducts(search: String): List
    }

    interface TransService {
        +getUserId(transId: String): String
    }

    interface UserService {
        +getFName(emailId: String): String
        +getUserAddr(userId: String): String
        +getUserDetails(emailId: String, password: String): UserBean
        +isRegistered(emailId: String): boolean
        +isValidCredential(emailId: String, password: String): boolean
        +registerUser(userName: String, mobileNo: Long, emailId: String, address: String, pinCode: int, password: String): boolean
        +registerUser(user: UserBean): boolean
    }
}

