@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #495057
skinparam sequenceParticipantBackgroundColor #F8F9FA
skinparam sequenceParticipantFontColor #212529
skinparam sequenceActorBorderColor #495057
skinparam sequenceActorBackgroundColor #E9ECEF
skinparam sequenceLifeLineBorderColor #6C757D
skinparam sequenceBoxBackgroundColor #E9ECEF
skinparam sequenceBoxBorderColor #6C757D
skinparam noteBorderColor #6C757D
skinparam noteBackgroundColor #FFF3CD

title Shopping Cart — Checkout Flow (Login → Add to Cart → Place Order)

actor Customer

box "Servlet Layer" #E9ECEF
    participant "LoginSrv" as login
    participant "AddtoCart" as addCart
    participant "OrderServlet" as orderSrv
    participant "ShipmentServlet" as shipSrv
end box

box "Service Layer" #D4EDDA
    participant "UserServiceImpl" as userSvc
    participant "CartServiceImpl" as cartSvc
    participant "ProductServiceImpl" as prodSvc
    participant "OrderServiceImpl" as orderSvc
end box

box "Utility Layer" #D1ECF1
    participant "DBUtil" as db
    participant "IDUtil" as idUtil
    participant "MailMessage" as mail
    participant "JavaMailUtil" as javaMail
end box

== User Authentication ==

Customer -> login : POST doPost(request, response)
activate login

login -> userSvc : isValidCredential(emailId, password)
activate userSvc

userSvc -> db : provideConnection()
activate db
db --> userSvc : Connection
deactivate db

userSvc --> login : boolean (valid/invalid)
deactivate userSvc

alt valid credentials
    login --> Customer : redirect → product listing page
else invalid credentials
    login --> Customer : redirect → login page (error)
end

deactivate login

== Add Product to Cart ==

Customer -> addCart : POST doPost(request, response)\n[prodId, prodQty in session/params]
activate addCart

addCart -> cartSvc : addProductToCart(userId, prodId, prodQty)
activate cartSvc

cartSvc -> db : provideConnection()
activate db
db --> cartSvc : Connection
deactivate db

cartSvc -> cartSvc : create CartBean(userId, prodId, quantity)

opt item already in cart
    cartSvc -> cartSvc : updateProductToCart(userId, prodId, newQty)
end

cartSvc --> addCart : success / updated
deactivate cartSvc

addCart -> cartSvc : getCartCount(userId)
activate cartSvc
cartSvc --> addCart : int cartCount
deactivate cartSvc

addCart --> Customer : redirect → cart page (cartCount updated)
deactivate addCart

== Checkout and Place Order ==

Customer -> orderSrv : POST doPost(request, response)\n[confirm payment]
activate orderSrv

orderSrv -> cartSvc : getAllCartItems(userId)
activate cartSvc
cartSvc -> db : provideConnection()
activate db
db --> cartSvc : Connection
deactivate db
cartSvc --> orderSrv : List<CartBean>
deactivate cartSvc

orderSrv -> orderSvc : paymentSuccess(userName, paidAmount)
activate orderSvc

orderSvc -> idUtil : generateTransId()
activate idUtil
idUtil --> orderSvc : transactionId (UUID)
deactivate idUtil

orderSvc -> db : provideConnection()
activate db
db --> orderSvc : Connection
deactivate db

orderSvc -> orderSvc : addTransaction(TransactionBean\n  [transactionId, userName,\n   transDateTime, transAmount])

loop for each CartBean item
    orderSvc -> idUtil : generateId()
    activate idUtil
    idUtil --> orderSvc : orderId (UUID)
    deactivate idUtil

    orderSvc -> orderSvc : addOrder(OrderBean\n  [transactionId, productId,\n   quantity, amount])

    orderSvc -> prodSvc : sellNProduct(prodId, quantity)
    activate prodSvc
    prodSvc -> db : provideConnection()
    activate db
    db --> prodSvc : Connection
    deactivate db
    prodSvc --> orderSvc : updated stock
    deactivate prodSvc
end

orderSvc --> orderSrv : transactionId
deactivate orderSvc

orderSrv -> cartSvc : removeProductFromCart(userId, prodId)
activate cartSvc
cartSvc --> orderSrv : cart cleared
deactivate cartSvc

orderSrv -> mail : transactionSuccess(recipientEmail,\n  name, transId, transAmount)
activate mail

mail -> javaMail : sendMail(recipientEmail, subject,\n  htmlTextMessage)
activate javaMail
javaMail --> mail : email sent
deactivate javaMail

mail --> orderSrv : confirmation sent
deactivate mail

orderSrv --> Customer : redirect → order confirmation page
deactivate orderSrv

== Order Shipment (Admin) ==

Customer -> shipSrv : POST doPost(request, response)\n[orderId, prodId — admin action]
activate shipSrv

shipSrv -> orderSvc : shipNow(orderId, prodId)
activate orderSvc
orderSvc -> db : provideConnection()
activate db
db --> orderSvc : Connection
deactivate db
orderSvc --> shipSrv : shipped = 1
deactivate orderSvc

shipSrv -> mail : orderShipped(recipientEmail, name,\n  transId, transAmount)
activate mail
mail -> javaMail : sendMail(recipientEmail, subject,\n  htmlTextMessage)
activate javaMail
javaMail --> mail : email sent
deactivate javaMail
mail --> shipSrv : notification sent
deactivate mail

shipSrv --> Customer : redirect → shipment confirmation
deactivate shipSrv

@enduml
