@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}

title Shopping Cart — Use Case Diagram

left to right direction

actor "Customer" as customer
actor "Admin" as admin
actor "Email Service" as emailService <<external>>

rectangle "Shopping Cart System" {

    ' --- Authentication ---
    usecase "Register Account" as UC_Register
    usecase "Login" as UC_Login
    usecase "Logout" as UC_Logout

    ' --- Product Browsing ---
    usecase "Browse Products" as UC_Browse
    usecase "View Product Details" as UC_ViewProduct
    usecase "View Product Image" as UC_ViewImage

    ' --- Cart Management ---
    usecase "Add Product to Cart" as UC_AddToCart
    usecase "Update Cart Quantity" as UC_UpdateCart
    usecase "Remove Product from Cart" as UC_RemoveFromCart
    usecase "View Cart" as UC_ViewCart

    ' --- Order & Payment ---
    usecase "Place Order" as UC_PlaceOrder
    usecase "Process Payment" as UC_Payment
    usecase "View Order History" as UC_ViewOrders

    ' --- Demand ---
    usecase "Demand Out-of-Stock Product" as UC_Demand

    ' --- Admin: Product Management ---
    usecase "Add Product" as UC_AddProduct
    usecase "Update Product" as UC_UpdateProduct
    usecase "Remove Product" as UC_RemoveProduct

    ' --- Admin: Order Management ---
    usecase "View All Orders" as UC_AllOrders
    usecase "Manage Shipment" as UC_Shipment

    ' --- Notifications ---
    usecase "Send Registration Email" as UC_RegEmail
    usecase "Send Transaction Confirmation" as UC_TransEmail
    usecase "Send Shipment Notification" as UC_ShipEmail
    usecase "Send Product Available Alert" as UC_AvailEmail
}

' --- Customer associations ---
customer --> UC_Register
customer --> UC_Login
customer --> UC_Logout
customer --> UC_Browse
customer --> UC_ViewProduct
customer --> UC_AddToCart
customer --> UC_UpdateCart
customer --> UC_RemoveFromCart
customer --> UC_ViewCart
customer --> UC_PlaceOrder
customer --> UC_ViewOrders
customer --> UC_Demand

' --- Admin associations ---
admin --> UC_Login
admin --> UC_Logout
admin --> UC_AddProduct
admin --> UC_UpdateProduct
admin --> UC_RemoveProduct
admin --> UC_AllOrders
admin --> UC_Shipment

' --- Email Service associations ---
emailService --> UC_RegEmail
emailService --> UC_TransEmail
emailService --> UC_ShipEmail
emailService --> UC_AvailEmail

' --- Include relationships ---
UC_PlaceOrder ..> UC_Payment : <<include>>
UC_ViewProduct ..> UC_ViewImage : <<include>>
UC_Register ..> UC_RegEmail : <<include>>
UC_PlaceOrder ..> UC_TransEmail : <<include>>
UC_Shipment ..> UC_ShipEmail : <<include>>
UC_Demand ..> UC_AvailEmail : <<extend>>

@enduml
