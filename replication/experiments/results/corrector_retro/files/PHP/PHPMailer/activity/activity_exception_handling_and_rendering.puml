@startuml
title Exception Handling and Rendering

start

:Invoke PHPMailer operation;

if (Operation throws exception?) then (yes)
  :Catch phpmailerException;
  if (Exception has output?) then (yes)
    :Render exception message;
  else (no)
    :Log silent exception;
  endif
else (no)
  :Continue normal execution;
endif

stop

@enduml
