@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activityBackgroundColor #F8F9FA
skinparam activityBorderColor #495057
skinparam activityArrowColor #495057
skinparam activityFontColor #212529
skinparam activityDiamondBackgroundColor #E9ECEF
skinparam activityDiamondBorderColor #6C757D
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 13
}
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F9A825

title Campaign and Sector Progression

|Player|
start
:Select planet on planet map;

|Planet / Sector|
:Determine target Sector\n(Planet.getStartSector /\nPlanet.getLastSector);

if (Sector.unlocked()?) then (locked)
    :Show Planet.getLockedText(sector)\n— access denied message;
    kill
else (unlocked)
endif

if (Planet.allowLanding(sector)?) then (denied)
    kill
else (allowed)
endif

|Player|
if (allowCampaignRules == true?) then (yes)
    :Open CampaignRulesDialog;
    :Select Difficulty\n(casual / easy / normal / hard / eradication);
endif

|Planet / Sector|
:Planet.applyRules(rules)\nCampaignRules.apply(planet, rules);
note right
  Difficulty multipliers applied to Rules object:
  • casual:      waveDmg×0.5,  waveHP×0.5,  buildCost×2.0
  • easy:        waveDmg×1.0,  waveHP×0.75, buildCost×1.5
  • normal:      waveDmg×1.0,  waveHP×1.0,  buildCost×1.0
  • hard:        waveDmg×1.25, waveHP×1.5,  buildCost×0.8
  • eradication: waveDmg×1.5,  waveHP×2.0,  buildCost×0.6
  Also sets: fog, sectorInvasion, randomWaveAI, rtsAI,
  clearSectorOnLose, pauseDisabled, legacyLaunchPads
end note
:Planet.setLastSector(sector)\nRecord navigation state;
:Planet.saveRules()\nPersist campaign rules between sessions;

|Logic|
:Logic.play()\nBegin sector session;
:Logic.checkCampaignStats()\nUpdate CampaignStats on session start;
note right
  CampaignStats fields updated each session:
  enemyUnitsDestroyed, enemyBuildingsDestroyed,
  unitsProduced, buildingsBuilt, wavesLasted,
  sectorsCaptured, sectorsLost, playtime
end note

fork
    |AcceleratorBuild|
    :updateTile() — called each game tick;
    if (isCoreBuilt()?\n[launchBlock / coreNucleus on tile]) then (no)
        :Skip — await core\nnucleus placement;
        detach
    else (yes)
    endif
    if (canLaunch()?\n[isCoreBuilt AND powerBuffer met]) then (no)
        :Accumulate power\ntoward buffer requirement;
        detach
    else (yes)
    endif
    :progress() increments per tick\n(toward 1.0 over buildDuration = 120f ticks);
    |Player|
    :Open buildConfiguration dialog\nView selectable destination sectors;
    |AcceleratorBuild|
    if (Planet.allowAcceleratorLanding\n(destinationSector)?) then (no)
        :Filter — invalid\ndestination rejected;
        detach
    else (yes)
    endif
    if (launchCandidates\nsequence populated?) then (no)
        :No valid\ntarget planets available;
        detach
    else (yes)
    endif
    |Player|
    :Confirm launch target;
    |AcceleratorBuild|
    :beginLaunch(launching = true)\nSet AcceleratorBuild.launching = true\nStart chargeSound (chargeDuration = 220f ticks)\nActivate charge ring animations\n(chargeRings=4, ringRadBase=60f, spacing=25f);
    repeat
        :updateLaunch() — per tick:\n  Increment launchTime\n  Heat lerp: launchHeat visuals\n  Lightning bolts (lightningLaunchChance=0.8, ×20 bolts)\n  Play lightningSound (volume=0.85)\n  zoomLaunch(): camera pow4In interpolation\n    (zoom 0.02f → 4f; charge phase → 5f)\n  drawLaunch() / drawLaunchGlobalZ()\n  Render visual effects;
    repeat while (launchTime < launchDuration?\n[120f ticks]) is (continuing)
    ->complete;
    :endLaunch():\n  Play launchSound\n  Set launching=false, launchTime=0\n  SectorInfo.destination = target (on source sector)\n  SectorInfo.origin = source (on target sector);

fork again
    |Logic|
    repeat
        :checkGameState() — called per tick;
        if (Wave win condition met?) then (yes)
            :gameOver(winner)\nupdateGameOver(winner);
            if (Player wins sector?) then (yes)
                :sectorCapture():\n  CampaignStats.sectorsCaptured++\n  Sector.info.wasCaptured = true;
                :Planet.saveStats()\nPersist updated CampaignStats;
                |GameService|
                :registerEvents() → SectorCaptureEvent received\nssetStat(SStat.sectorsControlled, n);
                :Check achievement thresholds:\n  Achievement.captureAllSectors\n  Achievement.control10Sectors;
                :trigger(trigger, achievement):\n  checkAllBlocks(ach, blocks)\n  If threshold met → completeAchievement(name)\n  storeStats() — persist all SStat values;
                |Planet / Sector|
                :Sector.near()\nUnlock adjacent sectors;
            else (player loses)
                if (clearSectorOnLose == true?) then (yes)
                    :Clear Sector save data;
                else (no)
                endif
                :Record sectorsLost\nin CampaignStats;
            endif
        else (no — session continues)
        endif
    repeat while (sector session active?) is (yes)

end fork

|Player|
:Return to planet map\nSector.info updated\n(destination, origin, wasCaptured, wave, attempts);
stop

@enduml
