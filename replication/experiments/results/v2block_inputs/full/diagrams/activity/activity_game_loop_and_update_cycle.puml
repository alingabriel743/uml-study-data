@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 13
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Main Game Loop and Update Cycle\n(Per-frame: ClientLauncher → AsyncCore → Logic → AsyncThreads)

|ClientLauncher|
start
:Frame begins;

if (Loading finished?) then (no)
    :loader.draw()\nassets.update();
    :Skip game update;
    note right: Splash / loading screen,\nnot yet in game
    stop
else (yes)
endif

:asyncCore.begin();

|AsyncCore|
if (state.isPlaying()?) then (no)
    :Skip async setup;
    note right: Guard – menu / not active
else (yes)
    fork
        :PhysicsProcess.begin() [sync];
        note right
            Remove stale entity refs
            Add new Units to PhysicsWorld
            Sync entity pos → body (x, y, mass, radius)
        end note
    fork again
        :AvoidanceProcess.begin() [sync];
        note right
            Clear requests
            Swap read buffer (double-buffer)
            Pack ground-layer AI units into requests
        end note
    end fork

    if (executor == null?) then (yes)
        :Init ExecutorService\n(fixed pool, size = processes.size);
    else (no)
    endif

    fork
        if (PhysicsProcess.shouldProcess()?) then (yes)
            :executor.submit(PhysicsProcess::process)\n→ Future added to list;
        else (no)
        endif
    fork again
        if (AvoidanceProcess.shouldProcess()?) then (yes)
            :executor.submit(AvoidanceProcess::process)\n→ Future added to list;
        else (no / lazy inactive)
        endif
    end fork
endif

|ClientLauncher|
:super.update()\n[ApplicationListener chain\n→ Logic.update()];

|Logic|
:PerfCounter.frame cycle tick;
:Events.fire(Trigger.update);
:universe.updateGlobal();

if (settings modified\nand not playing?) then (yes)
    :netServer.admins.forceSave()\nsettings.forceSave();
else (no)
endif

if (state.isGame()?) then (no)
    note right: Menu state — skip game loop
else (yes)
    if (net.client()?) then (no)
        :Count enemy units\n→ state.enemies;
    else (client)
    endif

    if (state.isPaused()?) then (yes)
        note right: Paused — entity/tick updates frozen
    else (no)
        :Events.fire(Trigger.beforeGameUpdate);
        :state.tick += delta * 60f\nstate.updateId++;
        :state.teams.updateTeamStats();
        :MapPreviewLoader.checkPreviews();

        if (fog enabled?) then (yes)
            :fogControl.update();
        else (no)
        endif

        if (campaign mode?) then (yes)
            :sector.info.update()\nuniverse.update();
        else (no)
        endif

        :Time.update()\nlogicVars.update();

        if (server and not editor?) then (yes)
            :updateWeather();
            :For each TeamData:\n  fill core items (fillItems)\n  data.buildAi.update() (buildAi)\n  data.rtsAi.update() (rtsAi)\n  spawn prebuild units (prebuildAi);
        else (client or editor)
        endif

        if (not editor?) then (yes)
            :state.rules.objectives.update();
        else (editor)
        endif

        if (waves enabled and\nwaveTimer on and\nnot gameOver?) then (yes)
            :Decrement state.wavetime;
            if (server and\nwavetime <= 0?) then (yes)
                :runWave();
            else (no)
            endif
        else (no)
        endif

        :Compute state.envAttrs\n(rules + active weather);

        :PerfCounter.entityUpdate.begin();
        :Groups.update()\n[Tick all active entities];
        note right
            All units, buildings, bullets,
            effects update their state
        end note
        :PerfCounter.entityUpdate.end();

        :Events.fire(Trigger.afterGameUpdate);
    endif

    if (runStateCheck?) then (yes)
        :checkGameState()\n[win / loss conditions];
    else (no)
    endif
endif

|AsyncCore|
:asyncCore.end();

if (state.isPlaying()?) then (no)
    :Skip async teardown;
else (yes)
    :complete():\nFor each Future → future.get()\n[BARRIER: wait for all async threads];
    note right
        Blocks main thread until
        PhysicsProcess and AvoidanceProcess
        finish their concurrent work
    end note
    :futures.clear();

    fork
        :PhysicsProcess.end() [sync];
        note right
            For each PhysicRef:
            entity.move(body.x - ref.x, body.y - ref.y)
            Apply physics delta back to entities
        end note
    fork again
        :AvoidanceProcess.end() [sync];
        note right
            Results already in read buffer;
            no flush needed — buffer swap handled in begin()
        end note
    end fork
endif

|ClientLauncher|
if (limitFps enabled and\nahead of target frame time?) then (yes)
    :sleep(remainingFrameTime)\n[FPS cap];
else (no)
endif

:Frame ends;
stop

@enduml
