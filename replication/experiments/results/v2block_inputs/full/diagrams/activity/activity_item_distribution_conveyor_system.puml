@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    TitleBackgroundColor #DEE2E6
    TitleFontColor #212529
}
skinparam note {
    BackgroundColor #FFF3CD
    BorderColor #FFC107
}

title Item Distribution and Conveyor System

|ConveyorBuild|
start

:Item arrives at conveyor tile;

|ConveyorBuild|
:acceptItem(source, item) called;

if (len < capacity?) then (yes)
    if (source is valid neighbor?) then (yes)
        |ArmoredConveyorBuild|
        note right
          ArmoredConveyor override:
          additional blending checks
        end note
        if (source is Conveyor\nOR facing edge matches rotation?) then (yes)
            |ConveyorBuild|
            :handleItem(item, source)\n— insert into ids[] array\n— update xs[]/ys[] position\n— len++;
        else (no — armored rejection)
            :Reject item (side-blending blocked);
            stop
        endif
    else (no — invalid neighbor)
        :Reject item;
        stop
    endif
else (no — full)
    :Reject item (capacity exceeded);
    stop
endif

|ConveyorBuild|
repeat
    :updateTile() — game tick fires;
    :Advance item positions by speed;
    if (front item reached end?\n(minitem <= 0)) then (yes)
        if (next building exists?\n(next != null)) then (yes)
            if (next.acceptItem(this, ids[0])?) then (accepted)
                :next.handleItem(ids[0], this)\n— pass item downstream;
                :pass(item) — remove from front\n— shift ids/xs/ys arrays\n— len--;
            else (rejected)
                :Item stays — conveyor clogged;
                :Increment clogHeat;
            endif
        else (no next)
            :Item blocked at end — increment clogHeat;
        endif
    else (no — still in transit)
        :Item continues advancing next tick;
    endif
repeat while (more items to advance?) is (yes)
-> no more items;

|BufferedItemBridgeBuild|
:updateTransport(other: Building)\n[on timerAccept gate];

if (other building present\nAND ItemBuffer.accepts()?) then (yes)
    :other.acceptItem() →\nItemBuffer.accept(item, data)\n— store as TimeItem(data, item.id, Time.time)\n— index++;
    note right
      FIFO queue: up to 50 items
      speed=40f tick delay
    end note
    repeat
        :ItemBuffer.poll(speed) each tick\n— check Time.time >= storedTime + speed;
        if (Time ready?) then (yes)
            :Return item reference for dispatch;
            :doDump() — offload item\nto adjacent building;
            :ItemBuffer.remove()\n— shift buffer array\n— index--;
        else (no — wraparound guard)
            :Item waits in buffer;
        endif
    repeat while (buffer not empty?) is (yes)
    -> buffer empty;
else (no — buffer full or no target)
    :Skip transfer this tick;
endif

|DirectionalItemBuffer|
:accepts(bufferIndex)\n— check indexes[buffer] < capacity;

if (directional slot has space?) then (yes)
    :accept(buffer, item)\n— store as BufferItem(item.id, Time.time)\n— in buffers[buffer][indexes[buffer]++];
    note right
      4 independent FIFO queues
      (one per cardinal direction)
      for junctions/sorters
    end note
    repeat
        :poll(buffer, speed)\n— check Time.time >= storedTime + speed;
        if (Time ready?) then (yes)
            :Return item for directional dispatch;
            :remove(buffer)\n— arraycopy shift\n— indexes[buffer]--;
        else (no)
            :Item waits in directional slot;
        endif
    repeat while (directional buffer not empty?) is (yes)
    -> directional buffer empty;
else (no — slot full)
    :Reject item — directional buffer full;
endif

|ItemModule|
:each(ItemConsumer cons)\n— iterate all item types\n— cons.accept(item, amount);

:take() — round-robin via takeRotation\n— return first available item\n— advance takeRotation;

note right
  Round-robin prevents
  starvation across item types
end note

:updateFlow()\n— update WindowedMean flow stats\n— per item type (pollScl=20f interval);

:Item delivered to destination\nor stored in module;

stop

@enduml
