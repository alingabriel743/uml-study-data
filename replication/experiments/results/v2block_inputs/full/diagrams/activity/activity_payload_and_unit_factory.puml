@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #495057
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 13
}

title Payload Assembly and Unit Factory

|BlockProducerBuild|
start

fork
  ' ===== LEFT BRANCH: Payload Assembly =====
  |BlockProducerBuild|
  :Call super.updateTile()
  (PayloadBlockBuild syncs held payload position);

  :Evaluate produce condition;
  if (recipe != null\nAND efficiency > 0\nAND payload == null?) then (produce = true)

    :acceptItem guard:
    allow item if items.get(item)
    < getMaximumAccepted(item);

    note right
      getMaximumAccepted returns 0
      if no recipe; else 2× recipe
      requirement for matching item
    end note

    :Accumulate progress:
    progress += buildSpeed * edelta();

    if (progress >= recipe.buildTime?) then (yes)

      ' Resource consumption sub-flow
      |ConsumeItemDynamic|
      :Call recipe() to get current Block;
      :Look up / clone ItemStack[] from cache;
      :Scale amounts by\nbuildCostMultiplier (ceiling);
      :Deduct scaled ItemStack[]\nfrom items inventory;

      |BlockProducerBuild|
      :Create BuildPayload(recipe, team);
      :Trigger placeEffect.at(x, y);
      :Reset payVector to zero;
      :progress %= 1f;

    else (no)
      :Continue accumulating progress;
    endif

  else (produce = false)
    :Idle — no production;
  endif

  :Update heat = lerpDelta(heat,\nMathf.num(produce), 0.15f);
  :time += heat * delta();

  ' ===== Payload Output sub-flow =====
  |PayloadBlockBuild|
  :moveOutPayload();

  if (payload == null?) then (yes)
    :Return — nothing to move;
  else (no)
    :updatePayload() — sync payload\nposition to payVector offset;
    :Calculate dest = front-edge position\n(rotdeg, size * tilesize / 2);
    :Rotate payRotation toward rotdeg()\nat payloadRotateSpeed;
    :Approach payVector toward dest\nat payloadSpeed;
    :Check front building;

    if (canDump\n(no solid front)?) then (yes)
      if (canMove\n(front accepts payload)?) then (yes)
        :tryMoveTo(front):
        handlePayload on front building;
        :Clear local payload;
      else (no)
        :pushOutput(payload, progress fraction)
        — eject payload to world;
      endif
    else (canDump = false)
      :Hold payload — front blocked;
    endif
  endif

fork again
  ' ===== RIGHT BRANCH: DroneCenter Unit Spawn =====
  |DroneCenterBuild|
  :Resolve persisted unit IDs
  from readUnits list → rebuild
  live units Seq;

  :Prune dead/removed units:
  units.removeAll(u -> !u.isAdded() || u.dead);

  :droneWarmup = lerp toward
  (units.size < unitsSpawned ? efficiency : 0f);
  :totalDroneProgress += droneWarmup * Time.delta;

  :Resolve readTarget → live Unit reference;

  if (units.size < unitsSpawned?) then (yes)
    :droneProgress += edelta() / droneConstructTime;

    if (droneProgress >= 1f?) then (yes)
      :droneType.create(team) — spawn new Unit;

      if (Unit instanceof BuildingTetherc?) then (yes)
        :bt.building(this)
        — tether unit to DroneCenter;
      else (no)
      endif

      :Set unit position (x, y), rotation = 90°;
      :unit.add() — register unit in world;
      :Trigger Fx.spawn.at(unit);
      :Add unit to units list;
      :Reset droneProgress = 0f;

    else (no)
      :Continue accumulating droneProgress;
    endif

  else (units.size >= unitsSpawned)
    :Max drones active — skip spawn;
  endif

  :Validate target:
  if target != null && !target.isValid()
  → set target = null;

  if (target == null?) then (yes)
    :Auto-find: Units.closest(team, x, y,
    non-core non-drone filter);
    :Assign closest unit as target;
  else (no)
    :Keep existing target;
  endif

  ' ===== Drone AI Behavior =====
  |EffectDroneAI|
  :updateUnit() called for each drone;

  if (unit is BuildingTetherc\nAND tether.building()\nis DroneCenterBuild?) then (yes)
    if (build.target != null?) then (yes)
      :Set AI target = build.target;
      :moveTo(target,\nhitSize/1.8f + droneRange - 10f)
      — approach target;
      :unit.lookAt(target);

      if (unit.within(target,\ndroneRange + target.hitSize)?) then (yes)
        :build.target.apply(status, statusDuration)
        — apply overdrive StatusEffect;
      else (no)
        :Continue moving toward target;
      endif

    else (target == null)
      :Drone idle — waiting for target;
    endif

  else (guard fails)
    :Skip — invalid tether or center;
  endif

end fork

stop

@enduml
