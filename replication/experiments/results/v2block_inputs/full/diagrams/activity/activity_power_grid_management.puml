@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam ActivityBackgroundColor #F8F9FA
skinparam ActivityBorderColor #495057
skinparam ActivityArrowColor #495057
skinparam ActivityFontColor #212529
skinparam PartitionBackgroundColor #E9ECEF
skinparam PartitionBorderColor #6C757D
skinparam ArrowColor #495057

title Power Grid Management\n<size:11>Power network: generation, distribution through beam nodes,\nbattery charge/discharge, and consumer satisfaction</size>

' ─────────────────────────────────────────────
' FLOW 1: Per-tick power update
' ─────────────────────────────────────────────

|#DBEAFE|PowerGraph|
start
:World tick fires\n**PowerGraph.update()**;

if (Consumer cheating mode?) then (yes)
  :Set all power.status = 1\nSkip all calculations;
  end
else (no)
endif

:getPowerNeeded()\n<i>Σ consPower.requestedPower(consumer) × delta</i>\nfor all enabled consumers;

:getPowerProduced()\n<i>Σ producer.getPowerProduction() × delta</i>\nfor all producers;

:Record lastPowerNeeded, lastPowerProduced\nUpdate powerBalance (windowed mean);

if (powerNeeded > powerProduced?) then (deficit)
  |#FEF3C7|Battery|
  :useBatteries(deficit)\ngetBatteryStored()\nCalc consumedPowerPercentage;

  :Proportionally reduce\neach battery.power.status;

  |#DBEAFE|PowerGraph|
else (no)
  if (powerProduced > powerNeeded?) then (surplus)
    |#FEF3C7|Battery|
    :chargeBatteries(surplus)\ngetBatteryCapacity()\nCalc chargedPercent;

    :Proportionally increase\neach battery.power.status;

    |#DBEAFE|PowerGraph|
  else (balanced)
  endif
endif

:distributePower(needed, produced, charged)\ncoverage = min(1.0, produced / needed);

fork
  |#FEF3C7|Battery|
  :Buffered consumers (batteries):\npower.status +=\nrequestedPower × coverage × delta\n/ capacity;
fork again
  |#D1FAE5|Consumer Buildings|
  :Unbuffered consumers:\nif shouldConsumePower:\n  power.status = coverage\nelse:\n  power.status = estimated value;
end fork

|#DBEAFE|PowerGraph|
:getSatisfaction()\n= clamp(produced / needed)\nDrives BeamNode laser color & opacity;

:All consumer power.status values\nupdated for this tick;
end


' ─────────────────────────────────────────────
' FLOW 2: BeamNode wireless topology update
' ─────────────────────────────────────────────

|#E0E7FF|BeamNode|
start
:World tile change detected\n**(world.tileChanges increments)**;

:BeamNodeBuild.updateTile()\nCompare lastChange vs world.tileChanges;

if (Tiles changed?) then (yes)
  :updateDirections()\nIterate 4 cardinal directions;

  repeat
    :Scan tiles j = 1..range+offset\nin current direction;

    if (Insulated wall?) then (skip)
      :Advance to next tile;
    elseif (PowerNode block present?) then (skip — incompatible)
      :Advance to next tile;
    elseif (Building with hasPower\n+ connectedPower + sameTeam?) then (found)
      :links[i] = building;

      if (Link changed from previous?) then (yes)
        :Unlink old connection:\nRemove pos() from prev.power.links\nRemove prev.pos() from power.links;

        :new PowerGraph().reflow(this)\nBFS reconnects this island;

        if (prev.power.graph != newGraph?) then (yes)
          :new PowerGraph().reflow(prev)\nReconnects old side independently;
        endif

        :Link new connection:\npower.links.addUnique(next.pos())\nnext.power.links.addUnique(pos());

        :power.graph.addGraph(next.power.graph)\nMerge smaller graph into larger;
      else (unchanged)
      endif
    else (no building found)
      :links[i] = null;
    endif

  repeat while (More directions to scan?) is (yes)
  ->done;

else (no tile change)
  :Skip topology update;
endif

:Graph topology updated\nPower flow recalculated on next tick;
end


' ─────────────────────────────────────────────
' FLOW 3: PowerGraph BFS reflow
' ─────────────────────────────────────────────

|#DBEAFE|PowerGraph|
start
:PowerGraph.reflow(tile)\nTriggered by link add/remove;

:Initialise BFS queue\nwith starting tile;

repeat
  :Dequeue next building\nAssign: build.power.graph = this;

  if (outputsPower && consumesPower\n&& !buffered?) then (generator with load)
    :Add to producers list\nAdd to consumers list;
  elseif (outputsPower && consumesPower\n&& buffered?) then (battery)
    :Add to batteries list;
  elseif (outputsPower only?) then (pure producer)
    :Add to producers list;
  else (consumesPower only)
    :Add to consumers list;
  endif

  :Enqueue all power-linked neighbours\nnot yet visited;

repeat while (BFS queue not empty?) is (yes)
->done;

:PowerGraph fully populated\nAll nodes classified;
end

@enduml
