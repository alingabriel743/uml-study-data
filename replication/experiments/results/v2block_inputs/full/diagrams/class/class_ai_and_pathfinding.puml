@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title AI and Pathfinding

' ─────────────────────────────────────────────────────────────
' Package: mindustry.entities.units — Controller interface & base
' ─────────────────────────────────────────────────────────────
package "mindustry.entities.units" {

    interface UnitController {
        +unit(unit: Unit): void
        +unit(): Unit
        +hit(bullet: Bullet): void
        +isValidController(): boolean
        +isLogicControllable(): boolean
        +updateUnit(): void
        +removed(unit: Unit): void
        +afterRead(unit: Unit): void
    }

    class AIController {
        #unit: Unit
        #timer: Interval
        #fallback: AIController
        #target: Teamc
        #bomberTarget: Teamc
        #noTargetTime: float
        #turningAway: boolean
        --
        +updateUnit(): void
        +updateVisuals(): void
        +updateMovement(): void
        +updateTargeting(): void
        +updateWeapons(): void
        +pathfind(pathTarget: int): void
        +pathfind(pathTarget: int, stopAtTarget: boolean, avoidance: boolean): void
        +circleAttack(circleLength: float): void
        +moveTo(target: Position, circleLength: float): void
        +findTarget(x: float, y: float, range: float, air: boolean, ground: boolean): Teamc
        +findMainTarget(x: float, y: float, range: float, air: boolean, ground: boolean): Teamc
        +targetFlag(x: float, y: float, flag: BlockFlag, enemy: boolean): Teamc
        +retarget(): boolean
        +shouldFire(): boolean
        +shouldShoot(): boolean
        +useFallback(): boolean
        +fallback(): AIController
        +hasStance(stance: UnitStance): boolean
        +commandTarget(moveTo: Teamc): void
        +commandPosition(pos: Vec2): void
        +prefSpeed(): float
        +stopShooting(): void
        +unloadPayloads(): void
    }

    AIController ..|> UnitController
}

' ─────────────────────────────────────────────────────────────
' Package: mindustry.ai.types — Concrete AI controllers
' ─────────────────────────────────────────────────────────────
package "mindustry.ai.types" {

    class FlyingAI {
        +updateMovement(): void
        +findTarget(x: float, y: float, range: float, air: boolean, ground: boolean): Teamc
        +findMainTarget(x: float, y: float, range: float, air: boolean, ground: boolean): Teamc
    }
    note bottom of FlyingAI
        Moves toward target at 80% range;
        falls back to closest spawner if no target.
        Targets core → random flags → closest unit.
    end note

    class GroundAI {
        -stuckTime: float
        -stuckX: float
        -stuckY: float
        --
        +updateMovement(): void
    }
    note bottom of GroundAI
        Uses pathfind(fieldCore); detects stuck
        state and applies avoidance; supports
        canBoost descent.
    end note

    class CommandAI {
        -commandQueue: Seq<Position>
        -targetPos: Vec2
        -attackTarget: Teamc
        -group: UnitGroup
        -groupIndex: int
        -command: UnitCommand
        -stances: Bits
        -commandController: AIController
        -stopAtTarget: boolean
        -stopWhenInRange: boolean
        -unreachableBuildings: IntSeq
        --
        +updateUnit(): void
        +command(cmd: UnitCommand): void
        +setStance(stance: UnitStance): void
        +disableStance(stance: UnitStance): void
        +hasStance(stance: UnitStance): boolean
        +stanceChanged(): void
        +defaultBehavior(): void
        +finishPath(): void
        +clearCommands(): void
        +commandQueue(location: Position): void
        +commandTarget(moveTo: Teamc, stopAtTarget: boolean): void
        +commandPosition(pos: Vec2, stopWhenInRange: boolean): void
        +hasCommand(): boolean
        +isAttacking(): boolean
        +nearAttackTarget(x: float, y: float, range: float): boolean
    }
    note bottom of CommandAI
        Player-directed; delegates movement to
        commandController per UnitCommand.
        Manages formation groups via UnitGroup,
        command queue, and stance bitmask.
    end note

    class BuilderAI {
        -assistFollowing: Unit
        -following: Unit
        -enemy: Teamc
        -fleeRange: float
        -rebuildPeriod: float
        -alwaysFlee: boolean
        -onlyAssist: boolean
        --
        +updateMovement(): void
        +fallback(): AIController
        +useFallback(): boolean
        +shouldFire(): boolean
        +shouldShoot(): boolean
    }
    note bottom of BuilderAI
        Follows/assists building units.
        Retreats when enemies nearby.
        Fallback chain: PrebuildAI → FlyingAI/GroundAI.
    end note

    class DefenderAI {
        +updateMovement(): void
        +updateTargeting(): void
        +findTarget(x: float, y: float, range: float, air: boolean, ground: boolean): Teamc
    }
    note bottom of DefenderAI
        Escorts/defends ally units.
        Prioritises high-health units
        closest to position.
    end note

    class MissileAI {
        -shooter: Unit
        --
        +updateMovement(): void
        +target(x: float, y: float, range: float, air: boolean, ground: boolean): Teamc
        +retarget(): boolean
    }
    note bottom of MissileAI
        Homing missile; tracks shooter
        aimX/aimY after homingDelay.
        Kills on enemy building contact.
    end note

    class LogicAI {
        -control: LUnitControl
        -moveX: float
        -moveY: float
        -moveRad: float
        -controlTimer: float
        -targetTimer: float
        -controller: Building
        -execCache: ObjectMap<Object, Object>
        --
        +updateUnit(): void
        +isLogicControllable(): boolean
    }
    note bottom of LogicAI
        Controlled by logic processors.
        Times out after 10 min (logicControlTimeout)
        and reverts to prior controller.
    end note

    FlyingAI  --|> AIController
    GroundAI  --|> AIController
    CommandAI --|> AIController
    BuilderAI --|> AIController
    DefenderAI --|> AIController
    MissileAI --|> AIController
    LogicAI   --|> AIController
}

' ─────────────────────────────────────────────────────────────
' Package: mindustry.ai — Pathfinding infrastructure
' ─────────────────────────────────────────────────────────────
package "mindustry.ai" {

    interface PathCost <<Pathfinder.PathCost>> {
        +getCost(team: int, tile: int): int
    }

    abstract class Flowfield <<Pathfinder.Flowfield>> {
        +refreshRate: int
        +team: Team
        +cost: PathCost
        #weights: int[]
        #completeWeights: int[]
        #searches: short[]
        #frontier: IntQueue
        #targets: IntSeq
        #resolution: int
        #width: int
        #height: int
        #initialized: boolean
        #dirty: boolean
        #hasComplete: boolean
        --
        +{abstract} getPositions(out: IntSeq): void
        +getNextTile(from: Tile): Tile
        +getNextTile(from: Tile, diagonals: boolean): Tile
        +getNextTile(from: Tile, unitAvoidanceId: int): Tile
        +getCost(tiles: int[], pos: int): int
        +passable(pos: int): boolean
        +updateTargetPositions(): void
        +needsRefresh(): boolean
    }

    class EnemyCoreField <<Pathfinder.EnemyCoreField>> {
        +getPositions(out: IntSeq): void
    }
    note right of EnemyCoreField
        Targets enemy core buildings
        and spawn points; supports
        randomWaveAI mode.
    end note

    class PositionTarget <<Pathfinder.PositionTarget>> {
        -position: Position
        --
        +getPositions(out: IntSeq): void
    }
    note right of PositionTarget
        Flowfield aimed at an arbitrary
        position; refreshRate = 900 ms.
    end note

    EnemyCoreField --|> Flowfield
    PositionTarget --|> Flowfield
    Flowfield      o-- PathCost : cost

    class Pathfinder {
        -{static} fieldCore: int = 0
        -{static} costGround: int = 0
        -{static} costLegs: int = 1
        -{static} costNaval: int = 2
        -{static} costNeoplasm: int = 3
        -{static} costNone: int = 4
        -{static} costHover: int = 5
        -{static} maxFields: int = 10
        -{static} maxCosts: int = 8
        -tiles: int[]
        -cache: Flowfield[][][]
        -threadList: Seq<Flowfield>
        -mainList: Seq<Flowfield>
        -queue: TaskQueue
        -thread: Thread
        -needsRefresh: boolean
        --
        +getField(team: Team, costType: int, fieldType: int): Flowfield
        +getTargetTile(tile: Tile, path: Flowfield): Tile
        +getTargetTile(tile: Tile, path: Flowfield, diagonals: boolean, avoidanceId: int): Tile
        +updateTile(tile: Tile): void
        +packTile(tile: Tile): int
        +run(): void
        -updateFrontier(path: Flowfield, nsToRun: long): void
        -updateTargets(path: Flowfield): void
        -registerPath(path: Flowfield): void
        -preloadPath(path: Flowfield): void
    }
    note right of Pathfinder
        Dedicated daemon thread (MIN_PRIORITY).
        BFS / Dijkstra-like flowfield per
        (team, cost, fieldType).
        Handles TileChangeEvent, WorldLoadEvent,
        ResetEvent. Avoidance IDs per unit.
    end note

    Pathfinder ..|> Runnable
    Pathfinder "1" *-- "0..*" Flowfield : cache[ ][ ][ ]
    Pathfinder ..> PathCost : costTypes

    class ControlPathfinder {
        -{static} costGround: PathCost
        -{static} costHover: PathCost
        -{static} costLegs: PathCost
        -{static} costNaval: PathCost
        -{static} costIdGround: int = 0
        -{static} costIdHover: int = 1
        -{static} costIdLegs: int = 2
        -{static} costIdNaval: int = 3
        --
        +getPathPosition(unit: Unit, destination: Vec2, destination2: Vec2, out: Vec2, noFound: boolean[]): boolean
        +{static} raycastFastAvoid(team: int, cost: PathCost, x0: int, y0: int, x1: int, y1: int): int
        +{static} isNearObstacle(unit: Unit, ux: int, uy: int, tx: int, ty: int): boolean
        +updateTile(tile: Tile): void
    }
    note right of ControlPathfinder
        HPA* / crowd pathfinding.
        Used by CommandAI for ground unit
        navigation to exact positions.
        Avoidance-aware.
    end note

    ControlPathfinder ..|> Runnable
    ControlPathfinder ..> PathCost : uses

    class Astar {
        +{static} pathfind(from: Tile, to: Tile, th: TileHeuristic, passable: Boolf<Tile>): Seq<Tile>
        +{static} pathfind(startX: int, startY: int, endX: int, endY: int, th: TileHeuristic, dh: DistanceHeuristic, passable: Boolf<Tile>): Seq<Tile>
    }
    note right of Astar
        A* over world tiles.
        Returns tile path. Used for one-off
        pathfinding (e.g. builder reach checks).
        Manhattan distance heuristic by default.
    end note

    class UnitGroup {
        -units: Seq<Unit>
        -collisionLayer: int
        -positions: float[]
        -originalPositions: float[]
        -valid: boolean
        --
        +calculateFormation(dest: Vec2, collisionLayer: int): void
        +updateRaycast(index: int, dest: Vec2): void
    }
    note right of UnitGroup
        Formation management for CommandAI.
        Async physics simulation (compress +
        push-apart) to assign unit offsets.
        Raycasts via ControlPathfinder to find
        passable placement positions.
    end note

    UnitGroup ..> ControlPathfinder : raycastFastAvoid()
}

' ─────────────────────────────────────────────────────────────
' Cross-package relationships
' ─────────────────────────────────────────────────────────────
AIController ..> Pathfinder      : pathfind() →\ngetField()
AIController ..> Flowfield       : getNextTile()
CommandAI    ..> ControlPathfinder : getPathPosition()
CommandAI    o-- UnitGroup       : group
BuilderAI    ..> FlyingAI        : fallback (flying)
BuilderAI    ..> GroundAI        : fallback (ground)

@enduml
