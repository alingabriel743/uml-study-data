@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Android Platform Layer

' ─── External: Android/libGDX ──────────────────────────────────────────────
package "arc.backend.android" {
    class AndroidApplication {
    }
}

' ─── External: Java ─────────────────────────────────────────────────────────
package "java.lang" {
    class ClassLoader <<abstract>> {
    }
}

' ─── External: Rhino JS Engine ──────────────────────────────────────────────
package "org.mozilla.javascript (rhino)" {
    class ContextFactory {
        +enterContext(): Context
        +initApplicationClassLoader(loader: ClassLoader): void
        +getGlobalSetter(): GlobalSetter
    }

    interface GeneratedClassLoader {
        +defineClass(name: String, data: byte[]): Class<?>
        +linkClass(aClass: Class<?>): void
    }
}

' ─── External: Dalvik/Android DEX loaders ───────────────────────────────────
package "dalvik.system" {
    class DexClassLoader {
        +DexClassLoader(dexPath: String, optimizedDir: String, libraryPath: String, parent: ClassLoader)
    }
    class InMemoryDexClassLoader {
        +InMemoryDexClassLoader(buffer: ByteBuffer, parent: ClassLoader)
    }
}

' ─── External: Mindustry Core ───────────────────────────────────────────────
package "mindustry (core)" {
    class ClientLauncher {
        +getScriptContext(): Context
        +loadJar(fi: Fi, loader: ClassLoader): void
    }
}

' ─── Primary package ─────────────────────────────────────────────────────────
package "mindustry.android" {

    class AndroidLauncher {
        +{static} PERMISSION_REQUEST_CODE: int = 1
        ~doubleScaleTablets: boolean = true
        -chooser: FileChooser
        -permCallback: Runnable
        --
        +onCreate(savedInstanceState: Bundle): void
        +onRequestPermissionsResult(requestCode: int, permissions: String[], grantResults: int[]): void
        +checkFiles(intent: Intent): void
        +isTablet(context: Context): boolean
    }

    class AndroidRhinoContext {
        ' Utility class — no instance fields
        --
        +{static} enter(cacheDirectory: File): Context
    }

    class AndroidContextFactory {
        -cacheDirectory: File
        --
        +AndroidContextFactory(cacheDirectory: File)
        +createClassLoader(parent: ClassLoader): BaseAndroidClassLoader
        +onContextReleased(cx: Context): void
    }

    abstract class BaseAndroidClassLoader {
        --
        +BaseAndroidClassLoader(parent: ClassLoader)
        +defineClass(name: String, data: byte[]): Class<?>
        +{abstract} loadClass(dex: Dex, name: String): Class<?>
        +{abstract} getLastDex(): Dex
        +{abstract} reset(): void
        +linkClass(aClass: Class<?>): void
        #loadClass(name: String, resolve: boolean): Class<?>
    }

    class FileAndroidClassLoader {
        -{static} instanceCounter: int = 0
        -dexFile: File
        --
        +FileAndroidClassLoader(parent: ClassLoader, cacheDir: File)
        +loadClass(dex: Dex, name: String): Class<?>
        +getLastDex(): Dex
        +reset(): void
        ' API < O (API 26): file-based DEX caching
    }

    class InMemoryAndroidClassLoader {
        -last: Dex
        --
        +InMemoryAndroidClassLoader(parent: ClassLoader)
        +loadClass(dex: Dex, name: String): Class<?>
        +getLastDex(): Dex
        +reset(): void
        ' API >= O (API 26): in-memory DEX, no temp files
    }
}

' ─── Inheritance ─────────────────────────────────────────────────────────────
AndroidLauncher          --|> AndroidApplication           : extends
AndroidContextFactory    --|> ContextFactory               : extends
BaseAndroidClassLoader   --|> ClassLoader                  : extends
FileAndroidClassLoader   --|> BaseAndroidClassLoader        : extends
InMemoryAndroidClassLoader --|> BaseAndroidClassLoader      : extends

' ─── Interface implementation ────────────────────────────────────────────────
BaseAndroidClassLoader   ..|> GeneratedClassLoader          : implements

' ─── Containment (inner classes) ─────────────────────────────────────────────
AndroidRhinoContext      *-- AndroidContextFactory          : inner class
AndroidRhinoContext      *-- BaseAndroidClassLoader         : inner class
AndroidRhinoContext      *-- FileAndroidClassLoader         : inner class
AndroidRhinoContext      *-- InMemoryAndroidClassLoader     : inner class

' ─── Dependencies ────────────────────────────────────────────────────────────
AndroidLauncher          ..> AndroidRhinoContext            : calls enter()
AndroidLauncher          ..> ClientLauncher                 : creates anonymous subclass\n(overrides getScriptContext,\nloadJar)
AndroidContextFactory    ..> BaseAndroidClassLoader         : createClassLoader()
FileAndroidClassLoader   ..> DexClassLoader                 : uses (API < 26)
InMemoryAndroidClassLoader ..> InMemoryDexClassLoader        : uses (API >= 26)

note top of AndroidLauncher
  Android entry point.
  onCreate() instantiates an anonymous
  ClientLauncher overriding:
  • getScriptContext() → AndroidRhinoContext.enter()
  • loadJar()         → anonymous DexClassLoader
end note

note right of AndroidRhinoContext
  enter() ensures a single global
  AndroidContextFactory is set via
  ContextFactory.getGlobalSetter().
  setContextFactoryGlobal(), then
  calls factory.enterContext().
end note

note bottom of AndroidContextFactory
  Chooses loader based on API level:
  API >= 26  → InMemoryAndroidClassLoader
  API < 26   → FileAndroidClassLoader
end note

note bottom of BaseAndroidClassLoader
  defineClass() pipeline:
  Java bytecode → DexFile (CfTranslator)
  → Dex → DexMerger(KEEP_FIRST)
  → loadClass(dex, name)
end note

@enduml
