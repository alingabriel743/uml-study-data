@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Annotation Processing Framework

' ── External base class ──────────────────────────────────────────────────────
package "javax.annotation.processing" #EEF2FF {
    abstract class AbstractProcessor {
    }
}

' ── Core annotation processor ────────────────────────────────────────────────
package "mindustry.annotations" {

    abstract class BaseProcessor {
        ' Static singletons (shared with util wrappers)
        +{static} String packageName
        +{static} Types typeu
        +{static} Elements elementu
        +{static} Filer filer
        +{static} Messager messager
        +{static} Trees trees
        ' Instance state
        #int round
        #int rounds
        #RoundEnvironment env
        #Fi rootDirectory
        ' Static utility methods
        +{static} String getMethodName(Element element)
        +{static} boolean isPrimitive(String type)
        +{static} boolean instanceOf(String type, String other)
        +{static} String getDefault(String value)
        +{static} int typeSize(String kind)
        +{static} String simpleName(String str)
        +{static} TypeName tname(String pack, String simple)
        +{static} TypeName tname(String name)
        +{static} TypeName tname(Class<?> c)
        +{static} TypeVariableName getTVN(TypeParameterElement element)
        +{static} void write(TypeSpec.Builder builder)
        +{static} void write(TypeSpec.Builder builder, Seq<String> imports)
        +{static} void err(String message)
        +{static} void err(String message, Element elem)
        ' Instance lifecycle and query methods
        +Seq<Selement> elements(Class<? extends Annotation> type)
        +Seq<Stype> types(Class<? extends Annotation> type)
        +Seq<Svar> fields(Class<? extends Annotation> type)
        +Seq<Smethod> methods(Class<? extends Annotation> type)
        +void init(ProcessingEnvironment env)
        +boolean process(Set<? extends TypeElement> annotations, RoundEnvironment roundEnv)
        +SourceVersion getSupportedSourceVersion()
        #{abstract} void process(RoundEnvironment env)
    }
}

' ── Compiler element wrappers & serializer ───────────────────────────────────
package "mindustry.annotations.util" {

    class "Selement<T extends Element>" as Selement {
        +{final} T e
        ..
        +String doc()
        +Seq<Selement<?>> enclosed()
        +String fullName()
        +Stype asType()
        +Svar asVar()
        +Smethod asMethod()
        +boolean isVar()
        +boolean isType()
        +boolean isMethod()
        +Seq<? extends AnnotationMirror> annotations()
        +<A extends Annotation> A annotation(Class<A> annotation)
        +<A extends Annotation> boolean has(Class<A> annotation)
        +Element up()
        +TypeMirror mirror()
        +TypeName tname()
        +ClassName cname()
        +String name()
    }

    class Stype {
        +{static} Stype of(TypeMirror mirror)
        +String fullName()
        +Seq<Stype> interfaces()
        +Seq<Stype> allInterfaces()
        +boolean isInterface()
        +Seq<Stype> superclasses()
        +Seq<Stype> allSuperclasses()
        +Stype superclass()
        +Seq<Svar> fields()
        +Seq<Smethod> methods()
        +Seq<Smethod> constructors()
        +TypeMirror mirror()
    }

    class Smethod {
        +boolean isAny(Modifier... mod)
        +String descString()
        +boolean is(Modifier mod)
        +Stype type()
        +Seq<TypeMirror> thrown()
        +Seq<TypeName> thrownt()
        +Seq<TypeParameterElement> typeVariables()
        +Seq<Svar> params()
        +boolean isVoid()
        +TypeMirror ret()
        +TypeName retn()
        +MethodTree tree()
        +String simpleString()
    }

    class Svar {
        +String descString()
        +Stype enclosingType()
        +boolean isAny(Modifier... mods)
        +boolean is(Modifier mod)
        +VariableTree tree()
    }

    class TypeIOResolver {
        +{static} ClassSerializer resolve(BaseProcessor processor)
        -{static} String fix(String str)
    }

    class ClassSerializer {
        +{final} ObjectMap<String, String> writers
        +{final} ObjectMap<String, String> readers
        +{final} ObjectMap<String, String> mutatorReaders
        +{final} ObjectMap<String, String> netWriters
        +{final} ObjectMap<String, String> netReaders
        ..
        +ClassSerializer(ObjectMap writers, ObjectMap readers,\n  ObjectMap mutatorReaders, ObjectMap netWriters, ObjectMap netReaders)
        +String getNetWriter(String type, String fallback)
        +String getNetReader(String type, String fallback)
    }
}

' ── Inheritance ───────────────────────────────────────────────────────────────
BaseProcessor --|> AbstractProcessor : extends

Stype    --|> Selement : extends\n&lt;Selement&lt;TypeElement&gt;&gt;
Smethod  --|> Selement : extends\n&lt;Selement&lt;ExecutableElement&gt;&gt;
Svar     --|> Selement : extends\n&lt;Selement&lt;VariableElement&gt;&gt;

' ── Factory / creation relationships ─────────────────────────────────────────
BaseProcessor ..> Selement  : creates >
BaseProcessor ..> Stype     : creates >
BaseProcessor ..> Svar      : creates >
BaseProcessor ..> Smethod   : creates >

' ── TypeIOResolver dependencies ──────────────────────────────────────────────
TypeIOResolver ..> BaseProcessor   : depends on\n(resolve parameter)
TypeIOResolver ..> Stype           : inspects
TypeIOResolver ..> Smethod         : inspects
TypeIOResolver ..> Svar            : inspects
TypeIOResolver ..> ClassSerializer : creates >

' ── Inner-class containment ───────────────────────────────────────────────────
TypeIOResolver +-- ClassSerializer : inner class

' ── Stype navigation ─────────────────────────────────────────────────────────
Stype   o--> Svar    : fields() >
Stype   o--> Smethod : methods() / constructors() >
Smethod o--> Svar    : params() >
Smethod o--> Stype   : type() >
Svar    o--> Stype   : enclosingType() >

@enduml
