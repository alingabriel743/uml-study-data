@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam enum {
    BackgroundColor #FFF3CD
    BorderColor #856404
    FontColor #212529
}
skinparam interface {
    BackgroundColor #D1ECF1
    BorderColor #0C5460
    FontColor #212529
}

title Content Type System

'--------------------------------------------------
' External interfaces
'--------------------------------------------------
interface Comparable<Content> {
    +compareTo(o: Content): int
}

interface Senseable {
    +sense(sensor: LAccess): double
}

'--------------------------------------------------
' mindustry.ctype — core type hierarchy
'--------------------------------------------------
package "mindustry.ctype" {

    abstract class Content <<NoPatch>> {
        +id: short
        +minfo: ModContentInfo
        --
        +Content()
        +{abstract} getContentType(): ContentType
        +init(): void
        +postInit(): void
        +afterPatch(): void
        +load(): void
        +loadIcon(): void
        +hasErrored(): boolean
        +isVanilla(): boolean
        +isModded(): boolean
        +compareTo(c: Content): int
    }

    class ModContentInfo {
        +mod: LoadedMod
        +sourceFile: Fi
        +error: String
        +baseError: Throwable
    }

    abstract class MappableContent <<NoPatch>> {
        +name: String
        --
        +MappableContent(name: String)
    }

    abstract class UnlockableContent {
        +stats: Stats
        +localizedName: String
        +description: String
        +details: String
        +credit: String
        +alwaysUnlocked: boolean
        +hideDetails: boolean
        +hideDatabase: boolean
        +generateIcons: boolean
        +uiIcon: TextureRegion
        +fullIcon: TextureRegion
        +shownPlanets: ObjectSet<Planet>
        +databaseTabs: ObjectSet<UnlockableContent>
        +databaseCategory: String
        +databaseTag: String
        +techNode: TechNode
        +techNodes: Seq<TechNode>
        #unlocked: boolean
        --
        +UnlockableContent(name: String)
        +loadIcon(): void
        +checkStats(): void
        +setStats(): void
        +unlocked(): boolean
        +unlock(): void
        +quietUnlock(): void
        +clearUnlock(): void
        +unlockedNow(): boolean
        +researchRequirements(): ItemStack[]
        +getDependencies(cons: Cons<UnlockableContent>): void
        +onUnlock(): void
        +isHidden(): boolean
        +isBanned(): boolean
        +showUnlock(): boolean
        +logicVisible(): boolean
        +createIcons(packer: MultiPacker): void
        +displayExtra(table: Table): void
        +getLogicId(): int
    }

    enum ContentType {
        item(Item.class)
        block(Block.class)
        bullet(BulletType.class)
        liquid(Liquid.class)
        status(StatusEffect.class)
        unit(UnitType.class)
        weather(Weather.class)
        sector(SectorPreset.class)
        planet(Planet.class)
        team(TeamEntry.class)
        unitCommand(UnitCommand.class)
        unitStance(UnitStance.class)
        error(null)
        --
        +{static} all: ContentType[]
        +contentClass: Class<? extends Content>
    }
}

'--------------------------------------------------
' mindustry.core — central registry
'--------------------------------------------------
package "mindustry.core" {

    class ContentLoader {
        -contentNameMap: ObjectMap<String,MappableContent>[]
        -contentMap: Seq<Content>[]
        -nameMap: ObjectMap<String,MappableContent>
        -temporaryMapper: MappableContent[][]
        -currentMod: LoadedMod
        -initialization: ObjectSet<Cons<Content>>
        --
        +createBaseContent(): void
        +createModContent(): void
        +init(): void
        +load(): void
        +handleContent(c: Content): void
        +handleMappableContent(c: MappableContent): void
        +transformName(name: String): String
        +getByID(type: ContentType, id: int): T
        +getByName(type: ContentType, name: String): T
        +byName(name: String): MappableContent
        +getBy(type: ContentType): Seq<T>
        +each(cons: Cons<Content>): void
        +loadColors(): void
        +blocks(): Seq<Block>
        +items(): Seq<Item>
        +liquids(): Seq<Liquid>
        +units(): Seq<UnitType>
        +bullets(): Seq<BulletType>
        +statusEffects(): Seq<StatusEffect>
        +planets(): Seq<Planet>
        +weathers(): Seq<Weather>
    }
}

'--------------------------------------------------
' mindustry.type — concrete content types
'--------------------------------------------------
package "mindustry.type" {

    class Item {
        +color: Color
        +explosiveness: float
        +flammability: float
        +radioactivity: float
        +charge: float
        +hardness: int
        +cost: float
        +healthScaling: float
        +lowPriority: boolean
        +buildable: boolean
        +hidden: boolean
        +frames: int
        +transitionFrames: int
        +frameTime: float
        --
        +Item(name: String, color: Color)
        +getContentType(): ContentType
        +loadIcon(): void
        +setStats(): void
        +createIcons(packer: MultiPacker): void
        +sense(sensor: LAccess): double
        +{static} getAllOres(): Seq<Item>
    }

    class Liquid {
        +gas: boolean
        +color: Color
        +gasColor: Color
        +lightColor: Color
        +barColor: Color
        +flammability: float
        +temperature: float
        +heatCapacity: float
        +viscosity: float
        +explosiveness: float
        +blockReactive: boolean
        +coolant: boolean
        +moveThroughBlocks: boolean
        +incinerable: boolean
        +effect: StatusEffect
        +particleEffect: Effect
        +vaporEffect: Effect
        +boilPoint: float
        +hidden: boolean
        +capPuddles: boolean
        +canStayOn: ObjectSet<Liquid>
        --
        +Liquid(name: String, color: Color)
        +getContentType(): ContentType
        +init(): void
        +willBoil(): boolean
        +canExtinguish(): boolean
        +barColor(): Color
        +getAnimationFrame(): int
        +drawPuddle(puddle: Puddle): void
        +react(other: Liquid, amount: float, tile: Tile, x: float, y: float): float
        +setStats(): void
    }

    class StatusEffect {
        --
        +getContentType(): ContentType
    }

    class UnitType {
        --
        +getContentType(): ContentType
        +sense(sensor: LAccess): double
    }
}

'--------------------------------------------------
' mindustry.world — Block content type
'--------------------------------------------------
package "mindustry.world" {

    class Block {
        +hasItems: boolean
        +hasLiquids: boolean
        +hasPower: boolean
        +itemCapacity: int
        +liquidCapacity: float
        +outputsPower: boolean
        +consumesPower: boolean
        +outputsLiquid: boolean
        +mapColor: Color
        +hasColor: boolean
        +squareSprite: boolean
        --
        +getContentType(): ContentType
    }
}

'--------------------------------------------------
' mindustry.content — static registries
'--------------------------------------------------
package "mindustry.content" {

    class Items <<static registry>> {
        +{static} copper: Item
        +{static} lead: Item
        +{static} graphite: Item
        +{static} coal: Item
        +{static} titanium: Item
        +{static} thorium: Item
        +{static} silicon: Item
        +{static} serpuloItems: Seq<Item>
        +{static} erekirItems: Seq<Item>
        +{static} erekirOnlyItems: Seq<Item>
        --
        +{static} load(): void
    }

    class Liquids <<static registry>> {
        +{static} water: Liquid
        +{static} slag: Liquid
        +{static} oil: Liquid
        +{static} cryofluid: Liquid
        +{static} arkycite: Liquid
        +{static} gallium: Liquid
        +{static} neoplasm: Liquid
        +{static} ozone: Liquid
        +{static} hydrogen: Liquid
        +{static} nitrogen: Liquid
        +{static} cyanogen: Liquid
        --
        +{static} load(): void
    }
}

'--------------------------------------------------
' Relationships
'--------------------------------------------------

' Content base hierarchy
Content ..|> Comparable : implements
MappableContent --|> Content : extends
UnlockableContent --|> MappableContent : extends

' Concrete content types inherit from UnlockableContent
Item --|> UnlockableContent : extends
Liquid --|> UnlockableContent : extends
Block --|> UnlockableContent : extends
StatusEffect --|> UnlockableContent : extends
UnitType --|> UnlockableContent : extends

' Senseable implementations
Item ..|> Senseable : implements
Liquid ..|> Senseable : implements
Block ..|> Senseable : implements
UnitType ..|> Senseable : implements

' Composition: Content owns ModContentInfo
Content *-- ModContentInfo : minfo >

' ContentLoader manages all Content via contentMap
ContentLoader "1" *-- "0..*" Content : registers via\nhandleContent()

' ContentLoader uses ContentType for indexing
ContentLoader --> ContentType : indexes by

' ContentType references content classes
ContentType ..> Item : item class
ContentType ..> Block : block class
ContentType ..> Liquid : liquid class
ContentType ..> UnitType : unit class
ContentType ..> StatusEffect : status class

' Static registries self-register via constructors
Items ..> Item : instantiates
Liquids ..> Liquid : instantiates

' ContentLoader.createBaseContent() orchestrates loading
ContentLoader ..> Items : calls load()
ContentLoader ..> Liquids : calls load()

@enduml
