@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Core Application Lifecycle

package "arc (external framework)" {
    class ApplicationCore {
        +add(module: ApplicationListener): void
        +update(): void
        +resize(width: int, height: int): void
        +resume(): void
        +pause(): void
    }

    interface ApplicationListener {
        +init(): void
        +update(): void
        +resize(width: int, height: int): void
        +pause(): void
        +resume(): void
        +dispose(): void
    }

    interface Loadable {
        +loadAsync(): void
        +loadSync(): void
    }

    interface Disposable {
        +dispose(): void
    }
}

package "mindustry" {
    interface Platform {
        +getNet(): NetProvider
        +loadJar(jar: Fi, parent: ClassLoader): void
        +updateLobby(): void
        +inviteFriends(): void
        +publish(pub: Publishable): void
        +viewListing(pub: Publishable): void
        +viewListingID(mapid: String): void
        +getWorkshopContent(type: Class<? extends Publishable>): void
        +openWorkshop(): void
        +createScripts(): void
        +getScriptContext(): Object
        +updateRPC(): void
        +getUUID(): String
        +shareFile(file: Fi): void
        +export(name: String, extension: String, writer: FileWriter): void
        +showFileChooser(open: boolean, title: String, extension: String, cons: Cons<Fi>): void
        +showMultiFileChooser(cons: Cons<Fi>, extensions: String...): void
        +hide(): void
        +beginForceLandscape(): void
    }

    abstract class ClientLauncher {
        -{static} loadingFPS: int = 20
        -nextFrame: long
        -beginTime: long
        -lastTargetFps: long = -1
        -finished: boolean = false
        -loader: LoadRenderer
        +init(): void
        +setup(): void
        +update(): void
        +add(module: ApplicationListener): void
        +resize(width: int, height: int): void
        +exit(): void
        +pause(): void
        +resume(): void
        +fileDropped(file: Fi): void
    }

    class Vars {
        +{static} clientLoaded: boolean
        +{static} mobile: boolean
        +{static} headless: boolean
        +{static} steam: boolean
        +{static} failedToLaunch: boolean
        +{static} loadedLogger: boolean
        +{static} loadedFileLogger: boolean
        +{static} maxDeltaClient: float = 6f
        +{static} tilesize: int = 8
        +{static} port: int = 6567
        +{static} appName: String = "Mindustry"
        .. Subsystem Singletons ..
        +{static} content: ContentLoader
        +{static} state: GameState
        +{static} platform: Platform
        +{static} mods: Mods
        +{static} schematics: Schematics
        +{static} asyncCore: AsyncCore
        .. Module Singletons ..
        +{static} control: Control
        +{static} logic: Logic
        +{static} renderer: Renderer
        +{static} ui: UI
        +{static} netServer: NetServer
        +{static} netClient: NetClient
        .. World Singletons ..
        +{static} world: World
        +{static} maps: Maps
        +{static} universe: Universe
        +{static} pathfinder: Pathfinder
        .. Infrastructure ..
        +{static} net: Net
        +{static} tree: FileTree
        +{static} player: Player
        +{static} dataDirectory: Fi
        +{static} saveDirectory: Fi
        +{static} modDirectory: Fi
        .. Methods ..
        +loadAsync(): void
        +{static} init(): void
        +{static} checkLaunch(): void
        +{static} finishLaunch(): void
        +{static} loadLogger(): void
        +{static} loadFileLogger(): void
        +{static} loadSettings(): void
    }
}

package "mindustry.graphics" {
    class LoadRenderer {
        -mesh: Mesh
        -cam: Camera3D
        -fx: FxProcessor
        -bloom: BloomFilter
        -bars: Bar[10]
        -renderTimes: WindowedMean
        -assetText: StringBuilder
        +draw(): void
        +dispose(): void
    }

    class Bar <<inner class>> {
        +value: Floatp
        +red: Boolp
        +valid: Boolp
        +text: String
        +Bar(text: String, value: Floatp)
        +Bar(text: String, value: float)
    }
}

' ── Inheritance & Realization ──────────────────────────────
ClientLauncher --|> ApplicationCore : extends
ClientLauncher ..|> Platform : implements
Vars ..|> Loadable : implements
LoadRenderer ..|> Disposable : implements

' ── Composition ───────────────────────────────────────────
ClientLauncher *-- LoadRenderer : -loader\n(created in setup,\ndisposed after load)
LoadRenderer *-- Bar : -bars[10]\n(diagnostic bars)

' ── Dependencies ──────────────────────────────────────────
ClientLauncher ..> Vars : assets.load(new Vars())\n(queues as Loadable)
LoadRenderer ..> Vars : reads Vars.control\nVars.mods for bars
Vars ..> Platform : +{static} platform

' ── Notes ─────────────────────────────────────────────────
note right of ClientLauncher
  Abstract — concrete subclasses are
  platform-specific (DesktopLauncher,
  AndroidLauncher, IOSLauncher).

  Initialization flow:
  1. init() → setup()
  2. setup(): checkLaunch(), loadLogger(),
     new LoadRenderer(), fire ClientCreateEvent
  3. setup(): create AssetManager, FileTree,
     Net, Mods, Schematics
  4. setup(): assets.load(new Vars())
  5. setup(): add(Logic, Control, Renderer,
     UI, NetServer, NetClient)
  6. update(): loader.draw() each frame
  7. On load complete: dispose loader,
     init modules, fire ClientLoadEvent,
     clientLoaded = true, finishLaunch()
end note

note right of Vars
  Global state container.
  All fields are public static singletons.
  loadAsync() → loadSettings() then init().
  init() instantiates all subsystems and
  detects platform (mobile/ios/android).
end note

note bottom of LoadRenderer
  Renders the loading screen while
  assets are being loaded asynchronously.
  Shows 10 diagnostic bars (CPU cores,
  asset progress, GPU, memory, version,
  OS, saves, mods, settings, GL version).
end note

@enduml
