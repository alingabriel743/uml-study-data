@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #D1ECF1
    BorderColor #17A2B8
}
skinparam abstract {
    BackgroundColor #FFF3CD
    BorderColor #FFC107
}

title Defense and Turret Blocks

' ── External base types ──────────────────────────────────────────────────
class Block <<external>> {
}

class Building <<external>> {
}

' ── Interfaces ───────────────────────────────────────────────────────────
interface Ranged {
    +range() : float
}

interface RotBlock {
    +buildRotation() : int
}

interface ControlBlock {
    +unit() : BlockUnitc
    +canControl() : boolean
}

' ── Support / composition types ──────────────────────────────────────────
abstract class AmmoEntry {
    +int amount
    +{abstract} type() : BulletType
}

class ItemEntry {
    +Item item
    +type() : BulletType
}

class BulletEntry {
    +Bullet bullet
    +float x
    +float y
    +float rotation
    +float life
}

class ShootPattern <<external>> {
    +shoot(index, x, y, rotation, type, owner, shooter)
}

class DrawBlock <<external>> {
}

class ConsumeLiquidBase <<external>> {
}

' ══════════════════════════════════════════════════════════════════════════
' BLOCK DEFINITION HIERARCHY
' ══════════════════════════════════════════════════════════════════════════
package "mindustry.world.blocks.defense.turrets" {

    class BaseTurret {
        +float range = 80f
        +float rotateSpeed = 5
        +float activationTime = 0f
        +float coolantMultiplier = 5f
        +float fogRadiusMultiplier = 1f
        +Effect coolEffect
        +ConsumeLiquidBase coolant
        +boolean disableOverlapCheck
        --
        +init()
        +reinitializeConsumers()
        +checkInitCoolant()
        +drawPlace(x, y, rotation, valid)
        +setStats()
        +setBars()
    }

    class ReloadTurret {
        +float reload = 10f
    }

    class Turret {
        +float targetInterval = 20
        +int maxAmmo = 30
        +int ammoPerShot = 1
        +float shootCone = 8f
        +float shootX, shootY
        +float inaccuracy = 0f
        +float minRange = 0f
        +float minWarmup = 0f
        +boolean targetAir = true
        +boolean targetGround = true
        +boolean targetBlocks = true
        +boolean targetHealing = false
        +boolean playerControllable = true
        +boolean predictTarget = true
        +Sortf unitSort
        +ShootPattern shoot
        +DrawBlock drawer
        +Color heatColor
        +Sound shootSound, chargeSound, loopSound
        +float recoil, recoilTime, cooldownTime
        +float shootWarmupSpeed
    }

    class ItemTurret {
        +ObjectMap<Item, BulletType> ammoTypes
        --
        +ammo(Object... objects)
        +limitRange()
        +limitRange(float margin)
    }

    class LiquidTurret {
        +ObjectMap<Liquid, BulletType> ammoTypes
        +boolean extinguish = true
        --
        +ammo(Object... objects)
    }

    class PowerTurret {
        +BulletType shootType
        ' hasPower = true
    }

    class LaserTurret {
        +float firingMoveFract = 0.25f
        +float shootDuration = 100f
        ' Continuous beam; coolant drains reloadCounter
    }

    class ContinuousTurret {
        +BulletType shootType
        +float aimChangeSpeed
        +boolean scaleDamageEfficiency
        ' Persistent bullet; no reload cycle
    }

    class ContinuousLiquidTurret {
        +ObjectMap<Liquid, BulletType> ammoTypes
        +float liquidConsumed = 1f/60f
    }

    class PointDefenseTurret {
        +float bulletDamage
        +float shootCone
        +float shootLength
        +Color color
        +Sound shootSound
        ' Targets enemy Bullet entities, not units
    }

    class TractorBeamTurret {
        +float force, scaledForce, damage
        +float shootCone, shootLength, laserWidth
        +boolean targetAir = true
        +boolean targetGround = false
        +Color laserColor
        +StatusEffect status
        +Sound shootSound
        ' No ammo/reload; extends BaseTurret directly
    }

}

' ══════════════════════════════════════════════════════════════════════════
' INNER BUILD HIERARCHY
' ══════════════════════════════════════════════════════════════════════════
package "Inner Build Classes" {

    class BaseTurretBuild {
        +float rotation = 90
        +float activationTimer
        --
        +placed()
        +range() : float
        +buildRotation() : int
        +drawSelect()
        +estimateDps() : float
        +status() : BlockStatus
    }

    class ReloadTurretBuild {
        +float reloadCounter
        --
        +updateCooling()
        +ammoReloadMultiplier() : float
        +baseReloadSpeed() : float
        +canReload() : boolean
    }

    class TurretBuild {
        +Seq<AmmoEntry> ammo
        +int totalAmmo
        +float curRecoil, heat, logicControlTime
        +float shootWarmup, charge
        +boolean logicShooting
        +Posc target
        +Vec2 targetPos
        +BlockUnitc unit
        +int totalShots, barrelCounter, queuedBullets
        +float heatReq
        +float[] sideHeat
        --
        +updateTile()
        +findTarget()
        +findEnemy(float range) : Posc
        +validateTarget() : boolean
        +targetPosition(Posc pos)
        +turnToTarget(float targetRot)
        +updateShooting()
        +shoot(BulletType type)
        +bullet(type, xOff, yOff, angle, mover)
        +handleBullet(Bullet, float, float, float)
        +useAmmo() : BulletType
        +peekAmmo() : BulletType
        +hasAmmo() : boolean
        +isShooting() : boolean
        +charging() : boolean
        +canHeal() : boolean
        +control(LAccess, p1..p4)
        +sense(LAccess) : double
    }

    class ItemTurretBuild {
        --
        +handleItem(Building, Item)
        +acceptItem(source, item) : boolean
        +acceptStack(item, amount, source) : int
        +handleStack(item, amount, source)
        +getAmmoContent() : Item
        +getAmmoFraction() : float
        +read/write()
    }

    class LiquidTurretBuild {
        --
        +findTarget()
        +useAmmo() : BulletType
        +peekAmmo() : BulletType
        +hasAmmo() : boolean
        +acceptLiquid(source, liquid) : boolean
        +getAmmoContent() : Liquid
    }

    class PowerTurretBuild {
        --
        +useAmmo() : BulletType
        +hasAmmo() : boolean
        +peekAmmo() : BulletType
        +getAmmoFraction() : float
        +sense(ammo) : double
    }

    class LaserTurretBuild {
        +Seq<BulletEntry> bullets
        --
        +updateTile()
        +updateShooting()
        +handleBullet(Bullet, float, float, float)
        +turnToTarget(float targetRot)
        +updateCooling()
    }

    class ContinuousTurretBuild {
        +Seq<BulletEntry> bullets
        +float lastLength
        --
        +updateTile()
        +updateBullet(BulletEntry)
        +updateShooting()
        +handleBullet(Bullet, float, float, float)
        +updateReload()
        +hasAmmo() : boolean
        +useAmmo() : BulletType
    }

    class ContinuousLiquidTurretBuild {
        +boolean activated
        --
        +updateTile()
        +hasCorrectAmmo() : boolean
        +peekAmmo() : BulletType
        +hasAmmo() : boolean
        +acceptLiquid(source, liquid) : boolean
    }

    class PointDefenseBuild {
        +Bullet target
        --
        +updateTile()
        +updateCooling()
    }

    class TractorBeamBuild {
        +Unit target
        +float lastX, lastY, strength
        +boolean any
        +float coolantMultiplier
        --
        +updateTile()
        +draw()
        +shouldConsume() : boolean
    }

}

' ══════════════════════════════════════════════════════════════════════════
' BLOCK INHERITANCE RELATIONSHIPS
' ══════════════════════════════════════════════════════════════════════════
Block <|-- BaseTurret
BaseTurret <|-- ReloadTurret
ReloadTurret <|-- Turret
Turret <|-- ItemTurret
Turret <|-- LiquidTurret
Turret <|-- PowerTurret
PowerTurret <|-- LaserTurret
Turret <|-- ContinuousTurret
ContinuousTurret <|-- ContinuousLiquidTurret
ReloadTurret <|-- PointDefenseTurret
BaseTurret <|-- TractorBeamTurret

' ══════════════════════════════════════════════════════════════════════════
' BUILD INHERITANCE RELATIONSHIPS
' ══════════════════════════════════════════════════════════════════════════
Building <|-- BaseTurretBuild
BaseTurretBuild <|-- ReloadTurretBuild
ReloadTurretBuild <|-- TurretBuild
TurretBuild <|-- ItemTurretBuild
TurretBuild <|-- LiquidTurretBuild
TurretBuild <|-- PowerTurretBuild
PowerTurretBuild <|-- LaserTurretBuild
TurretBuild <|-- ContinuousTurretBuild
ContinuousTurretBuild <|-- ContinuousLiquidTurretBuild
ReloadTurretBuild <|-- PointDefenseBuild
BaseTurretBuild <|-- TractorBeamBuild

' ══════════════════════════════════════════════════════════════════════════
' INTERFACE IMPLEMENTATIONS
' ══════════════════════════════════════════════════════════════════════════
BaseTurretBuild ..|> Ranged
BaseTurretBuild ..|> RotBlock
TurretBuild ..|> ControlBlock

' ══════════════════════════════════════════════════════════════════════════
' BLOCK -> BUILD NESTING (outer class contains inner build)
' ══════════════════════════════════════════════════════════════════════════
BaseTurret *-- BaseTurretBuild : inner class >
ReloadTurret *-- ReloadTurretBuild : inner class >
Turret *-- TurretBuild : inner class >
ItemTurret *-- ItemTurretBuild : inner class >
LiquidTurret *-- LiquidTurretBuild : inner class >
PowerTurret *-- PowerTurretBuild : inner class >
LaserTurret *-- LaserTurretBuild : inner class >
ContinuousTurret *-- ContinuousTurretBuild : inner class >
ContinuousLiquidTurret *-- ContinuousLiquidTurretBuild : inner class >
PointDefenseTurret *-- PointDefenseBuild : inner class >
TractorBeamTurret *-- TractorBeamBuild : inner class >

' ══════════════════════════════════════════════════════════════════════════
' COMPOSITION RELATIONSHIPS
' ══════════════════════════════════════════════════════════════════════════
BaseTurret o-- ConsumeLiquidBase : coolant (optional)
Turret *-- ShootPattern : shoot
Turret *-- DrawBlock : drawer (DrawTurret)

TurretBuild *-- AmmoEntry : ammo list
LaserTurretBuild *-- BulletEntry : bullets list
ContinuousTurretBuild *-- BulletEntry : bullets list

AmmoEntry <|-- ItemEntry

' ══════════════════════════════════════════════════════════════════════════
' DEPENDENCY RELATIONSHIPS
' ══════════════════════════════════════════════════════════════════════════
TurretBuild ..> ShootPattern : dispatches shoot()
TurretBuild ..> BulletEntry : creates via BulletType.create()

@enduml
