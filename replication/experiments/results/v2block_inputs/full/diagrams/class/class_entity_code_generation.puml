@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Entity Code Generation

package "javax.annotation.processing" {
    abstract class AbstractProcessor {
        +process(annotations: Set, env: RoundEnvironment): boolean
    }
}

package "mindustry.annotations" {
    abstract class BaseProcessor {
        +{static} packageName: String = "mindustry.gen"
        +{static} typeu: Types
        +{static} elementu: Elements
        +{static} filer: Filer
        +{static} messager: Messager
        #round: int
        #rounds: int
        #env: RoundEnvironment
        #rootDirectory: Fi
        --
        +{abstract} process(env: RoundEnvironment): void
        +{static} isPrimitive(type: String): boolean
        +{static} instanceOf(type: String, other: String): boolean
        +{static} getDefault(value: String): String
        +write(builder: TypeSpec.Builder): void
        +elements(type: Class<Annotation>): Seq<Selement>
        +types(type: Class<Annotation>): Seq<Stype>
    }
}

package "mindustry.annotations.util" {
    class Selement<T extends Element> {
        +e: T
        --
        +doc(): String
        +enclosed(): Seq<Selement>
        +fullName(): String
        +asType(): Stype
        +asVar(): Svar
        +asMethod(): Smethod
        +annotation(annotation: Class<A>): A
        +has(annotation: Class<A>): boolean
        +up(): Selement
    }

    class Stype {
        --
        +{static} of(mirror: TypeMirror): Stype
        +fullName(): String
        +interfaces(): Seq<Stype>
        +allInterfaces(): Seq<Stype>
        +isInterface(): boolean
        +superclass(): Stype
        +fields(): Seq<Svar>
        +methods(): Seq<Smethod>
    }

    class Smethod {
        --
        +is(mod: Modifier): boolean
        +params(): Seq<Svar>
        +ret(): Stype
        +isVoid(): boolean
        +simpleString(): String
    }

    class Svar {
        --
        +enclosingType(): Stype
        +is(mod: Modifier): boolean
        +descString(): String
    }

    class TypeIOResolver {
        +{static} resolve(processor: BaseProcessor): ClassSerializer
    }

    class ClassSerializer {
        +writers: ObjectMap<String, String>
        +readers: ObjectMap<String, String>
        +mutatorReaders: ObjectMap<String, String>
        +netWriters: ObjectMap<String, String>
        --
        +getNetWriter(type: String, fallback: String): String
        +getNetReader(type: String, fallback: String): String
    }
}

package "mindustry.annotations.entity" {
    class EntityProcess <<@SupportedAnnotationTypes>> {
        -definitions: Seq<EntityDefinition>
        -groupDefs: Seq<GroupDefinition>
        -baseComponents: Seq<Stype>
        -componentNames: ObjectMap<String, Stype>
        -componentDependencies: ObjectMap<Stype, Seq<Stype>>
        -defComponents: ObjectMap<Selement, Seq<Stype>>
        -varInitializers: ObjectMap<String, String>
        -methodBlocks: ObjectMap<String, String>
        -baseClassDeps: ObjectMap<Stype, ObjectSet<Stype>>
        -imports: ObjectSet<String>
        -allGroups: Seq<Selement>
        -allDefs: Seq<Selement>
        -allInterfaces: Seq<Stype>
        -baseClasses: Seq<TypeSpec.Builder>
        -serializer: ClassSerializer
        --
        +process(env: RoundEnvironment): void
        +interfaceName(comp: Stype): String
        +baseName(comp: Stype): String
        +interfaceToComp(type: Stype): Stype
        +allComponents(type: Selement): Seq<Stype>
        +getDependencies(component: Stype): Seq<Stype>
        +isCompInterface(type: Stype): boolean
        +createName(elem: Selement): String
        +getImports(elem: Element): Seq<String>
        +skipDeprecated(builder: TypeSpec.Builder): void
    }

    note right of EntityProcess
        <b>3-Round Processing:</b>
        Round 1: Generate component interfaces
                 & optional base classes;
                 cache varInitializers/methodBlocks
        Round 2: Parse @GroupDef → GroupDefinition;
                 parse @EntityDef → EntityDefinition;
                 generate Groups & EntityMapping classes
        Round 3: Implement component interfaces
                 on entity classes; add getters/setters;
                 write base classes
    end note

    class EntityDefinition {
        +name: String
        +builder: TypeSpec.Builder
        +naming: Selement
        +extend: TypeName
        +components: Seq<Stype>
        +groups: Seq<GroupDefinition>
        +fieldSpecs: Seq<FieldSpec>
        +legacy: boolean
        +classID: int
        --
        +EntityDefinition(name, builder, naming,\n  extend, components, groups, fieldSpec, legacy)
        +toString(): String
    }

    class GroupDefinition {
        +name: String
        +baseType: ClassName
        +components: Seq<Stype>
        +spatial: boolean
        +mapping: boolean
        +collides: boolean
        +manualInclusions: ObjectSet<Selement>
        --
        +GroupDefinition(name, bestType, components,\n  spatial, mapping, collides)
        +toString(): String
    }

    class EntityIO {
        -{static} json: Json
        -{static} targetSuf: String = "_TARGET_"
        -{static} lastSuf: String = "_LAST_"
        -serializer: ClassSerializer
        -name: String
        -type: TypeSpec.Builder
        -directory: Fi
        -revisions: Seq<Revision>
        -write: boolean
        -method: MethodSpec.Builder
        -presentFields: ObjectSet<String>
        --
        +EntityIO(name, type, typeFields, serializer, directory)
        +write(method: MethodSpec.Builder, write: boolean,\n  allFields: Seq<Svar>): void
        +writeSync(method: MethodSpec.Builder, write: boolean,\n  allFields: Seq<Svar>): void
        +writeSyncManual(method: MethodSpec.Builder, write: boolean,\n  syncFields: Seq<Svar>): void
        +writeInterpolate(method: MethodSpec.Builder,\n  fields: Seq<Svar>): void
        +io(type: String, field: String, network: boolean): void
        +fieldHasAnno(field: RevisionField, allFields: Seq<Svar>,\n  type: Class<Annotation>): boolean
    }

    note right of EntityIO
        <b>IO Dispatch Order:</b>
        1. primitive types
        2. Content subtype
        3. ClassSerializer.writers
        4. ClassSerializer.mutatorReaders
        5. ClassSerializer.readers
        6. array
        7. Seq / Queue
    end note

    class Revision {
        +version: int
        +fields: Seq<RevisionField>
        --
        +Revision(version: int, fields: Seq<RevisionField>)
        +equal(specs: Seq<FieldSpec>): boolean
    }

    class RevisionField {
        +name: String
        +type: String
        --
        +RevisionField(name: String, type: String)
    }
}

note bottom of RevisionField
    Stored as JSON in:
    revisions/<EntityName>/<version>.json
    Enables forward-compatible deserialization
end note

' Inheritance
AbstractProcessor <|-- BaseProcessor
BaseProcessor <|-- EntityProcess
Selement <|-- Stype
Selement <|-- Smethod
Selement <|-- Svar

' Composition within EntityProcess
EntityProcess *-- "many" EntityDefinition : definitions
EntityProcess *-- "many" GroupDefinition : groupDefs
EntityProcess --> ClassSerializer : serializer

' EntityDefinition associations
EntityDefinition o-- "many" GroupDefinition : groups
EntityDefinition o-- "many" Stype : components

' EntityIO composition
EntityIO *-- "many" Revision : revisions
EntityIO --> ClassSerializer : uses for\ntype dispatch
Revision *-- "many" RevisionField : fields

' EntityProcess creates EntityIO per round 2
EntityProcess ..> EntityIO : <<creates>> per @EntityDef

' TypeIOResolver resolves ClassSerializer
TypeIOResolver ..> ClassSerializer : <<creates>>

@enduml
