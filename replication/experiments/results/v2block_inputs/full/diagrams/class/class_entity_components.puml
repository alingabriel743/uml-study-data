@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #E6AC00
    FontColor #212529
}

title Entity Component System

note as legend
  <b>Annotation Processing Convention</b>
  Each abstract @Component class is processed at compile time by EntityProcess:
  • <b>XComp</b> (abstract class)  →  <b>Xc</b> (generated public interface)
  • <i>base=true</i>  →  also generates a concrete entity class (Unit, Building)
  • <i>@Import</i>: reuse field from another component without re-declaring it
  • <i>@SyncField / @SyncLocal</i>: network synchronisation control
  • <i>@MethodPriority</i>: controls method merge order in generated entities
  Dashed arrows (..>) indicate interface-level component dependencies
end note

' ─────────────────────────────────────
' FOUNDATION
' ─────────────────────────────────────
package "Foundation" {
    abstract class EntityComp <<@BaseComponent>> {
        == generates: Entityc ==
        ~int id
        ~boolean added
        --
        +void update()
        +void remove()
        +void add()
        +boolean isAdded()
        +boolean isLocal()
        +boolean isRemote()
        +void read(Reads r)
        +void write(Writes w)
    }

    abstract class PosComp <<@Component>> {
        == generates: Posc ==
        +float x
        +float y
        --
        +void set(float x, float y)
        +void set(Position pos)
        +int tileX()
        +int tileY()
        +Tile tileOn()
        +Block blockOn()
        +boolean onSolid()
    }
}

' ─────────────────────────────────────
' COMBAT & STATUS
' ─────────────────────────────────────
package "Combat & Status" {
    abstract class HealthComp <<@Component>> {
        == generates: Healthc ==
        +float health
        ~float maxHealth
        ~boolean dead
        +{static} float hitDuration = 9f
        --
        +boolean isValid()
        +float healthf()
        +void damage(float amount)
        +void damagePierce(float amount)
        +void damageArmorMult(float amount, float armorMult)
        +void heal(float amount)
        +void healFract(float amount)
        +void kill()
        +void killed()
    }

    abstract class ShieldComp <<@Component>> {
        == generates: Shieldc ==
        +float shield
        ~float shieldAlpha
    }

    abstract class StatusComp <<@Component>> {
        == generates: Statusc ==
        ' speed / armor / damage / drag multipliers
        --
        +float speedMultiplier()
        +float armorOverride()
        +float dragMultiplier()
        +boolean disarmed()
    }
}

' ─────────────────────────────────────
' MOVEMENT & PHYSICS
' ─────────────────────────────────────
package "Movement & Physics" {
    abstract class VelComp <<@Component>> {
        == generates: Velc ==
        +float x
        +float y
        +Vec2 vel
        ~float drag
        --
        +void update()
        +boolean moving()
        +void move(float cx, float cy)
        +void move(Vec2 v)
        +void velAddNet(float vx, float vy)
        +SolidPred solidity()
        +boolean canPassOn()
    }

    abstract class HitboxComp <<@Component>> {
        == generates: Hitboxc ==
        +float x
        +float y
        ~float lastX, lastY
        ~float deltaX, deltaY
        ~float hitSize
        --
        +void collision(Hitboxc other, float x, float y)
        +boolean collides(Hitboxc other)
        +void hitbox(Rect rect)
        +void hitboxTile(Rect rect)
        +float deltaLen()
        +float deltaAngle()
        +void updateLastPosition()
    }

    abstract class RotComp <<@Component>> {
        == generates: Rotc ==
        +float rotation
    }

    abstract class PhysicsComp <<@Component>> {
        == generates: Physicsc ==
        ' Physics layer assignment
        ' Unit-to-unit collision resolution
    }

    abstract class ElevationMoveComp <<@Component>> {
        == generates: ElevationMovec ==
        ' Elevation-based movement
        ' Used by flying and hover units
    }
}

' ─────────────────────────────────────
' TEAM & NETWORK
' ─────────────────────────────────────
package "Team & Network" {
    abstract class TeamComp <<@Component>> {
        == generates: Teamc ==
        +float x
        +float y
        +Team team
        --
        +boolean cheating()
        +CoreBuild core()
        +CoreBuild closestCore()
        +CoreBuild closestEnemyCore()
        +boolean inFogTo(Team viewer)
    }

    abstract class SyncComp <<@Component>> {
        == generates: Syncc ==
        ' Network sync interpolation
        ' for position and rotation
        --
        +boolean isSyncHidden()
        +void handleSyncHidden()
        +void snapInterpolation()
    }
}

' ─────────────────────────────────────
' GAMEPLAY TRAITS
' ─────────────────────────────────────
package "Gameplay Traits" {
    abstract class DrawComp <<@Component>> {
        == generates: Drawc ==
        --
        +void draw()
        +float clipSize()
    }

    abstract class ItemsComp <<@Component>> {
        == generates: Itemsc ==
        +ItemStack stack
        --
        +Item item()
        +int itemCapacity()
        +boolean hasItem()
        +void clearItem()
    }

    abstract class WeaponsComp <<@Component>> {
        == generates: Weaponsc ==
        +WeaponMount[] mounts
        --
        +void updateWeapons()
        +boolean isShooting()
        +boolean canShoot()
        +void aim(float x, float y)
        +float aimX()
        +float aimY()
    }

    abstract class MinerComp <<@Component>> {
        == generates: Minerc ==
        +Tile mineTile
        --
        +void updateMining()
        +boolean mining()
        +boolean canMine(Tile t)
    }

    abstract class BuilderComp <<@Component>> {
        == generates: Builderc ==
        --
        +void updateBuilding()
        +boolean isBuilding()
        +boolean activelyBuilding()
        +BuildPlan buildPlan()
    }
}

' ─────────────────────────────────────
' COMPOSITE ENTITIES
' ─────────────────────────────────────
package "Composite Entities" {
    abstract class UnitComp <<@Component (base=true)>> {
        == generates: Unitc  /  concrete class: Unit ==
        +UnitController controller
        +UnitType type
        +Ability[] abilities
        +float elevation
        ~Trail trail
        --
        +void update()
        +boolean isFlying()
        +boolean isGrounded()
        +boolean canDrown()
        +float speed()
        +float floorSpeedMultiplier()
        +boolean isPlayer()
        +boolean isAI()
        +boolean isCommandable()
        +void moveAt(Vec2 v, float acceleration)
        +void controller(UnitController ctrl)
        +int collisionLayer()
        +double sense(LAccess sensor)
        +void setProp(LAccess prop, double value)
    }

    abstract class BuildingComp <<@Component (base=true)>> {
        == generates: Buildingc  /  concrete class: Building ==
        ~Tile tile
        ~Block block
        ~Seq<Building> proximity
        +PowerModule power
        +ItemModule items
        +LiquidModule liquids
        ~float efficiency
        ~boolean enabled
        --
        +Building init(Tile, Team, boolean, int)
        +void update()
        +void updateTile()
        +boolean acceptItem(Building src, Item item)
        +void handleItem(Building src, Item item)
        +void configure(Object value)
        +void offload(Item item)
        +void changeTeam(Team next)
        +boolean isValid()
        +double sense(LAccess sensor)
    }
}

' ─────────────────────────────────────
' MOVEMENT SPECIALIZATIONS
' ─────────────────────────────────────
package "Movement Specializations\n(each implements Unitc)" {
    abstract class LegsComp <<leg locomotion>>
    abstract class TankComp <<tank tread>>
    abstract class MechComp <<biped>>
    abstract class WaterMoveComp <<aquatic>>
    abstract class CrawlComp <<crawling>>
    abstract class BlockUnitComp <<block-controlled>>
}

' ═══════════════════════════════════════
' COMPONENT DEPENDENCIES
' (A ..> B means A declares "implements Bc",
'  i.e. A depends on the interface generated by B)
' ═══════════════════════════════════════

' --- Foundation chain ---
HealthComp ..> EntityComp : implements Entityc
HealthComp ..> PosComp    : implements Posc

' --- Shield extends health ---
ShieldComp ..> HealthComp : implements Healthc

' --- Positional components ---
VelComp    ..> PosComp    : implements Posc
HitboxComp ..> PosComp    : implements Posc
TeamComp   ..> PosComp    : implements Posc
StatusComp ..> PosComp    : implements Posc
DrawComp   ..> PosComp    : implements Posc
ItemsComp  ..> PosComp    : implements Posc
RotComp    ..> EntityComp : implements Entityc
SyncComp   ..> EntityComp : implements Entityc

' --- Physics = Vel + Hitbox ---
PhysicsComp ..> VelComp    : implements Velc
PhysicsComp ..> HitboxComp : implements Hitboxc

' --- ElevationMove = Vel + Hitbox ---
ElevationMoveComp ..> VelComp    : implements Velc
ElevationMoveComp ..> HitboxComp : implements Hitboxc

' --- Weapons needs team, rotation, velocity, status ---
WeaponsComp ..> TeamComp   : implements Teamc
WeaponsComp ..> RotComp    : implements Rotc
WeaponsComp ..> VelComp    : implements Velc
WeaponsComp ..> StatusComp : implements Statusc

' --- Miner needs items, team, rotation, draw ---
MinerComp ..> ItemsComp : implements Itemsc
MinerComp ..> TeamComp  : implements Teamc
MinerComp ..> RotComp   : implements Rotc
MinerComp ..> DrawComp  : implements Drawc

' --- Builder needs team, rotation, status ---
BuilderComp ..> TeamComp   : implements Teamc
BuilderComp ..> RotComp    : implements Rotc
BuilderComp ..> StatusComp : implements Statusc

' --- UnitComp aggregates key component interfaces ---
UnitComp ..> HealthComp   : implements Healthc
UnitComp ..> PhysicsComp  : implements Physicsc
UnitComp ..> TeamComp     : implements Teamc
UnitComp ..> WeaponsComp  : implements Weaponsc
UnitComp ..> SyncComp     : implements Syncc
UnitComp ..> ShieldComp   : implements Shieldc
UnitComp ..> StatusComp   : implements Statusc
UnitComp ..> DrawComp     : implements Drawc
UnitComp ..> MinerComp    : implements Minerc
UnitComp ..> BuilderComp  : implements Builderc

' --- BuildingComp aggregates key component interfaces ---
BuildingComp ..> PosComp    : implements Posc
BuildingComp ..> TeamComp   : implements Teamc
BuildingComp ..> HealthComp : implements Healthc

' --- Movement specializations implement Unitc ---
LegsComp          ..> UnitComp : implements Unitc
TankComp          ..> UnitComp : implements Unitc
MechComp          ..> UnitComp : implements Unitc
WaterMoveComp     ..> UnitComp : implements Unitc
CrawlComp         ..> UnitComp : implements Unitc
ElevationMoveComp ..> UnitComp : implements Unitc
BlockUnitComp     ..> UnitComp : implements Unitc

@enduml
