@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Graphics and Rendering

interface ApplicationListener <<arc>> {
    +void update()
    +void resize(int w, int h)
}

package "mindustry.core" {
    class Renderer {
        +BlockRenderer blocks
        +FogRenderer fog
        +MinimapRenderer minimap
        +OverlayRenderer overlays
        +LightRenderer lights
        +Pixelator pixelator
        +PlanetRenderer planets
        -Bloom bloom
        -FrameBuffer effectBuffer
        -float targetscale, camerascale, landTime
        -boolean animateShields, animateWater
        -Seq<EnvRenderer> envRenderers
        +void update()
        +void draw()
        +void drawBackground()
        +void shake(float intensity, float duration)
        +void setupBloom()
        +void toggleBloom(boolean enabled)
        +void addEnvRenderer(int mask, Runnable render)
        +boolean isCutscene()
        +float landScale()
    }
}

package "mindustry.graphics" {

    class BlockRenderer {
        -FloorRenderer floor
        -FrameBuffer shadows
        -FrameBuffer dark
        -BlockQuadtree blockTree
        -BlockLightQuadtree blockLightTree
        -OverlayQuadtree overlayTree
        -FloorQuadtree floorTree
        -Seq<Tile> tileview, lightview
        -IntSet darkEvents
        +void reload()
        +void drawBlocks()
        +void drawShadows()
        +void drawDarkness()
        +void processBlocks()
        +void updateShadows(boolean, boolean)
        +void updateDarkness()
        +void recacheWall(Tile tile)
        +FrameBuffer getShadowBuffer()
    }

    class FloorRenderer {
        -ChunkMesh[][][] cache
        -Shader shader
        -IndexData indexData
        -IntSeq drawnLayers
        -ObjectSet<CacheLayer> used
        -{static} int chunksize
        +void drawFloor()
        +void drawLayer(CacheLayer layer)
        +void beginDraw()
        +void recacheTile(Tile tile)
        +void drawUnderwater(Runnable run)
    }

    class Layer <<constants>> {
        +{static} float background
        +{static} float floor
        +{static} float block
        +{static} float blockBuilding
        +{static} float turret
        +{static} float bullet
        +{static} float effect
        +{static} float light
        +{static} float darkness
        +{static} float plans
        +{static} float shields
        +{static} float fogOfWar
        +{static} float space
        +{static} float end
        +{static} float max
    }

    class CacheLayer {
        +{static} CacheLayer water
        +{static} CacheLayer mud
        +{static} CacheLayer tar
        +{static} CacheLayer slag
        +{static} CacheLayer normal
        +{static} CacheLayer walls
        +{static} CacheLayer[] all
        +int id
        +boolean liquid
        +{static} void init()
        +{static} void add(CacheLayer... layers)
        +void begin()
        +void end()
    }

    class "CacheLayer.ShaderLayer" as ShaderLayer {
        -Shader shader
        +void begin()
        +void end()
    }

    class Shaders <<static holder>> {
        +{static} BlockBuildShader blockbuild
        +{static} ShieldShader shield
        +{static} BuildBeamShader buildBeam
        +{static} UnitBuildShader build
        +{static} UnitArmorShader armor
        +{static} DarknessShader darkness
        +{static} FogShader fog
        +{static} SurfaceShader water, mud, tar, slag
        +{static} PlanetShader planet
        +{static} LightShader light
        +{static} SpaceShader space
        +{static} AtmosphereShader atmosphere
        +{static} MeshShader mesh
        +{static} void init()
        +{static} Fi getShaderFi(String file)
    }

    class "Shaders.LoadShader" as LoadShader {
        ' Loads .vert/.frag files
    }

    class "Shaders.SurfaceShader" as SurfaceShader {
        +void apply()
        ' Sets u_campos, u_resolution, u_time
        ' Binds noise texture
    }

    class "Shaders.SpaceShader" as SpaceShader {
        +void apply()
        ' Binds stars texture at slot 1
    }

    class "Shaders.BlockBuildShader" as BlockBuildShader {
        +float progress, alpha, time
        +TextureRegion region
        +void apply()
    }

    class "Shaders.ShieldShader" as ShieldShader {
        +void apply()
    }

    class Drawf <<static utility>> {
        +{static} void text(String text, float x, float y, Color color)
        +{static} void additive(TextureRegion r, Color color, float x, float y)
        +{static} void light(float x, float y, float radius, Color color, float opacity)
        +{static} void laser(TextureRegion line, TextureRegion start, TextureRegion end, ...)
        +{static} void construct(Building t, TextureRegion r, Color color, float progress, ...)
        +{static} void shadow(float x, float y, float rad)
        +{static} void liquid(TextureRegion r, float x, float y, float alpha, Color color)
        +{static} void dashCircle(float x, float y, float rad, Color color)
        +{static} void arrow(float x, float y, float x2, float y2, float length, float radius)
        +{static} void buildBeam(float x, float y, float tx, float ty, float radius)
        +{static} void tri(float x, float y, float width, float length, float rotation)
        +{static} void flame(float x, float y, int divisions, float rotation, float length, float width, float pan)
    }

    class LightRenderer {
        +void add(Runnable run)
        +void add(float x, float y, float radius, Color color, float opacity)
        +void add(float x, float y, TextureRegion region, Color color, float opacity)
        +void line(float x, float y, float x2, float y2, float stroke, Color tint, float alpha)
        +boolean enabled()
        +void draw()
    }

    class Trail {
        -int length
        -FloatSeq points
        -float lastX, lastY, lastAngle
        -float counter, lastW
        +Trail copy()
        +void clear()
        +int size()
        +float width()
        +void draw(Color color, float width)
        +void drawCap(Color color, float width)
        +void update(float x, float y, float angle)
    }

    class Pal <<constants>> {
        +{static} Color accent
        +{static} Color health
        +{static} Color heal
        +{static} Color shadow
        +{static} Color engine
        +{static} Color turretHeat
        +{static} Color lightFlame
        +{static} Color darkFlame
        +{static} Color bulletYellow
        +{static} Color reactorPurple
        +{static} Color shield
    }
}

package "mindustry.world.draw" {
    abstract class DrawBlock {
        #String[] iconOverride
        +{abstract} void draw(Building build)
        +void drawLight(Building build)
        +void drawPlan(Block block, BuildPlan plan, ...)
        +void load(Block block)
        +TextureRegion[] icons(Block block)
        +TextureRegion[] finalIcons(Block block)
    }

    class DrawDefault {
        +void draw(Building build)
    }

    class DrawMulti {
        -DrawBlock[] drawers
        +void draw(Building build)
    }

    class DrawRegion {
        +void draw(Building build)
    }

    class DrawTurret {
        +void draw(Building build)
    }

    class DrawFlame {
        +void draw(Building build)
    }

    class DrawPlasma {
        +void draw(Building build)
    }

    class DrawParticles {
        +void draw(Building build)
    }

    class DrawHeatRegion {
        +void draw(Building build)
    }

    class DrawGlowRegion {
        +void draw(Building build)
    }

    class DrawWeave {
        +void draw(Building build)
    }

    class DrawPower {
        +void draw(Building build)
    }

    class DrawFrames {
        +void draw(Building build)
    }

    class DrawLiquidRegion {
        +void draw(Building build)
    }
}

' ─── External interface implementation ───
Renderer ..|> ApplicationListener

' ─── Renderer compositions ───
Renderer *-- BlockRenderer : blocks
Renderer *-- LightRenderer : lights

' ─── BlockRenderer compositions ───
BlockRenderer *-- FloorRenderer : floor

' ─── CacheLayer inner class ───
ShaderLayer --|> CacheLayer

' ─── Shaders inner class hierarchy ───
LoadShader --|> "arc.Shader" : extends
SurfaceShader --|> LoadShader
SpaceShader --|> SurfaceShader
BlockBuildShader --|> LoadShader
ShieldShader --|> LoadShader

' ─── FloorRenderer ↔ CacheLayer ───
FloorRenderer ..> CacheLayer : renders layers

' ─── ShaderLayer depends on Shaders ───
ShaderLayer ..> SurfaceShader : wraps shader

' ─── Drawf dependencies ───
Drawf ..> Shaders : uses (Shaders.build for construct)
Drawf ..> LightRenderer : delegates to renderer.lights
Drawf ..> Layer : uses Draw.z() constants

' ─── Renderer uses Shaders ───
Renderer ..> Shaders : blockbuild, shield, buildBeam

' ─── BlockRenderer uses Shaders ───
BlockRenderer ..> Shaders : darkness shader

' ─── DrawBlock subclasses ───
DrawDefault --|> DrawBlock
DrawMulti --|> DrawBlock
DrawRegion --|> DrawBlock
DrawTurret --|> DrawBlock
DrawFlame --|> DrawBlock
DrawPlasma --|> DrawFlame
DrawParticles --|> DrawBlock
DrawHeatRegion --|> DrawBlock
DrawGlowRegion --|> DrawBlock
DrawWeave --|> DrawBlock
DrawPower --|> DrawBlock
DrawFrames --|> DrawBlock
DrawLiquidRegion --|> DrawBlock

' ─── DrawMulti aggregates DrawBlock[] ───
DrawMulti *-- DrawBlock : drawers[]

@enduml
