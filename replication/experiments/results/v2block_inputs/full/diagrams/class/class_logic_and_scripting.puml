@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #D4EDDA
    BorderColor #28A745
}
skinparam abstract {
    BackgroundColor #FFF3CD
    BorderColor #856404
}

title Logic and Scripting System

' ─────────────────────────────────────────────
' CORE LOGIC ENGINE
' ─────────────────────────────────────────────
package "mindustry.logic (Core)" {

    interface LInstruction {
        +run(exec: LExecutor): void
    }

    interface LReadable {
        +readable(exec: LExecutor): boolean
        +read(position: LVar, output: LVar): void
    }

    interface LWritable {
        +writable(exec: LExecutor): boolean
        +write(position: LVar, value: LVar): void
    }

    class LVar {
        +name: String
        +id: int
        +isobj: boolean
        +constant: boolean
        +objval: Object
        +numval: double
        +syncTime: long
        --
        +num(): double
        +numf(): float
        +numi(): int
        +obj(): Object
        +bool(): boolean
        +team(): Team
        +building(): Building
        +setnum(value: double): void
        +setobj(value: Object): void
        +setbool(value: boolean): void
    }

    class LAssembler {
        +{static} customParsers: ObjectMap<String, Func<String[], LStatement>>
        +privileged: boolean
        +vars: OrderedMap<String, LVar>
        +instructions: LInstruction[]
        --
        +{static} assemble(data: String, privileged: boolean): LAssembler
        +write(statements: Seq<LStatement>): void
        +read(text: String, privileged: boolean): void
        +var(symbol: String): LVar
        +putConst(name: String, value: Object): void
        +putVar(name: String): LVar
        +getVar(name: String): LVar
        +parseDouble(symbol: String): double
        +parseColor(symbol: String): Object
    }

    class LExecutor {
        +{static} maxInstructions: int = 1000
        +instructions: LInstruction[]
        +vars: LVar[]
        +counter: LVar
        +unit: LVar
        +thisv: LVar
        +ipt: LVar
        +queryResult: LVar
        +binds: int[]
        +yield: boolean
        +graphicsBuffer: LongSeq
        +textBuffer: StringBuilder
        +links: Building[]
        +build: LogicBuild
        +linkIds: IntSet
        +team: Team
        +privileged: boolean
        --
        +load(builder: LAssembler): void
        +runOnce(): void
        +runLogicScript(code: String): void
        +runLogicScript(code: String, maxInstructions: int, loop: boolean): void
        +initialized(): boolean
        +optionalVar(name: String): LVar
        +optionalVar(index: int): LVar
        +syncVariable(building: Building, variable: int, value: Object): void
        +logicExplosion(team: Team, x: float, y: float, ...): void
        +createMarker(id: int, marker: ObjectiveMarker): void
        +updateMarker(id: int, control: LMarkerControl, p1: double, p2: double, p3: double): void
        +setFlag(flag: String, add: boolean): void
    }

    abstract class LStatement {
        +elem: StatementElem
        +{static} nameToAlign: ObjectMap<String, Integer>
        +{static} alignToName: IntMap<String>
        --
        +{abstract} build(table: Table): void
        +{abstract} build(builder: LAssembler): void
        +write(builder: StringBuilder): void
        +afterRead(): void
        +category(): LCategory
        +copy(): LStatement
        +hidden(): boolean
        +privileged(): boolean
        +typeName(): String
        +name(): String
    }

    class LStatements {
        note "Container for all concrete\nLStatement inner subclasses"
    }

    class LCategory {
        +{static} all: Seq<LCategory>
        +{static} unknown: LCategory
        +{static} io: LCategory
        +{static} block: LCategory
        +{static} operation: LCategory
        +{static} control: LCategory
        +{static} unit: LCategory
        +{static} world: LCategory
        +name: String
        +id: int
        +color: Color
        +icon: Drawable
        --
        +localized(): String
        +description(): String
        +compareTo(o: LCategory): int
    }
}

' ─────────────────────────────────────────────
' WORLD BLOCK INTEGRATION
' ─────────────────────────────────────────────
package "mindustry.world.blocks.logic" {

    class LogicBlock {
        +maxInstructionScale: int = 5
        +instructionsPerTick: int = 1
        +maxInstructionsPerTick: int = 40
        +range: float = 80f
        -{static} maxLinks: int = 6000
        --
        +{static} compress(code: String, links: Seq<LogicLink>): byte[]
        +getLinkName(block: Block): String
        +setStats(): void
        +drawPlace(x: int, y: int, rotation: int, valid: boolean): void
        +accessible(): boolean
        +canBreak(tile: Tile): boolean
    }

    class LogicBuild {
        +code: String
        +executor: LExecutor
        +accumulator: float
        +links: Seq<LogicLink>
        +ipt: int
        +tag: String
        +linksVar: LVar
        +loadBlock: Runnable
        --
        +updateCode(str: String): void
        +updateCode(str: String, keep: boolean, assemble: Cons<LAssembler>): void
        +updateTile(): void
        +updateLinks(): void
        +readable(exec: LExecutor): boolean
        +read(position: LVar, output: LVar): void
        +writable(exec: LExecutor): boolean
        +write(position: LVar, value: LVar): void
        +readCompressed(data: byte[], relative: boolean): void
        +config(): Object
        +showEditDialog(): void
        +buildConfiguration(table: Table): void
        +onConfigureBuildTapped(other: Building): void
        +validLink(other: Building): boolean
    }

    class LogicLink {
        +valid: boolean
        +x: int
        +y: int
        +name: String
        +lastBuild: Building
        +logicVar: LVar
        --
        +LogicLink(x: int, y: int, name: String, valid: boolean)
        +trySet(exec: LExecutor, value: Object): void
        +copy(): LogicLink
    }
}

' ─────────────────────────────────────────────
' LINSTRUCTION IMPLEMENTATIONS (key examples)
' ─────────────────────────────────────────────
package "mindustry.logic (Instructions)" {

    note "IO Instructions" as NIO
    class ReadI {
        -target: LVar
        -position: LVar
        -output: LVar
        +run(exec: LExecutor): void
    }
    class WriteI {
        -target: LVar
        -position: LVar
        -value: LVar
        +run(exec: LExecutor): void
    }
    class PrintI {
        -value: LVar
        +run(exec: LExecutor): void
    }
    class DrawI {
        -type: byte
        -x, y, p1, p2, p3, p4: LVar
        +run(exec: LExecutor): void
    }

    note "Operation Instructions" as NOp
    class SetI {
        -from: LVar
        -to: LVar
        +run(exec: LExecutor): void
    }
    class OpI {
        -op: LogicOp
        -a, b, dest: LVar
        +run(exec: LExecutor): void
    }

    note "Control Instructions" as NCtrl
    class JumpI {
        -op: ConditionOp
        -value: LVar
        -compare: LVar
        -address: int
        +run(exec: LExecutor): void
    }
    class EndI {
        +run(exec: LExecutor): void
    }
    class WaitI {
        -value: LVar
        +run(exec: LExecutor): void
    }

    note "Block Instructions" as NBlk
    class ControlI {
        -type: LAccess
        -target, p1, p2, p3, p4: LVar
        +run(exec: LExecutor): void
    }
    class SenseI {
        -from, to, type: LVar
        +run(exec: LExecutor): void
    }
    class RadarI {
        -targets: RadarTarget[3]
        -sort: RadarSort
        -radar, sortOrder, output: LVar
        +run(exec: LExecutor): void
    }

    note "Unit Instructions" as NUnit
    class UnitBindI {
        -type: LVar
        +run(exec: LExecutor): void
    }
    class UnitControlI {
        -type: LUnitControl
        -p1, p2, p3, p4, p5: LVar
        +run(exec: LExecutor): void
    }
    class SpawnUnitI {
        -type, x, y, rotation, team, result: LVar
        +run(exec: LExecutor): void
    }

    note "World Instructions" as NWorld
    class SetBlockI {
        -x, y, block, team, rotation: LVar
        -layer: TileLayer
        +run(exec: LExecutor): void
    }
    class SetRuleI {
        -rule: LogicRule
        -value, p1, p2, p3, p4: LVar
        +run(exec: LExecutor): void
    }
    class EffectI {
        -type: EffectEntry
        -x, y, rotation, color, data: LVar
        +run(exec: LExecutor): void
    }
}

' ─────────────────────────────────────────────
' LSTATEMENT SUBCLASSES (key examples)
' ─────────────────────────────────────────────
package "mindustry.logic (Statements)" {

    class CommentStatement {
        +comment: String
        +build(table: Table): void
        +build(builder: LAssembler): void
        +write(builder: StringBuilder): void
    }
    class ReadStatement {
        +output: String
        +target: String
        +address: String
        +build(table: Table): void
        +build(builder: LAssembler): void
    }
    class WriteStatement {
        +input: String
        +target: String
        +address: String
        +build(table: Table): void
        +build(builder: LAssembler): void
    }
    class JumpStatement {
        +destIndex: int
        +condition: String
        +build(table: Table): void
        +build(builder: LAssembler): void
    }
    class OperationStatement {
        +op: String
        +result: String
        +operandA: String
        +operandB: String
        +build(table: Table): void
        +build(builder: LAssembler): void
    }
    class InvalidStatement {
        +build(table: Table): void
        +build(builder: LAssembler): void
    }
}

' ─────────────────────────────────────────────
' UI — LCanvas and inner classes
' ─────────────────────────────────────────────
package "mindustry.logic (UI)" {

    class LCanvas {
        +statements: DragLayout
        +pane: ScrollPane
        -privileged: boolean
        -dragging: StatementElem
        -hovered: StatementElem
        --
        +add(statement: LStatement): void
        +addAt(at: int, statement: LStatement): void
        +save(): String
        +load(asm: String): void
        +rebuild(): void
        +clearStatements(): void
    }

    class DragLayout {
        note "extends WidgetGroup\nOrders StatementElem children\nwith drag-to-reorder support"
    }

    class StatementElem {
        +st: LStatement
        +index: int
        note "extends Table\nUI wrapper around one LStatement"
    }

    class JumpButton {
        +curve: JumpCurve
        +elem: StatementElem
        note "extends ImageButton\nVisualizes jump targets"
    }

    class JumpCurve {
        +button: JumpButton
        note "extends Element\nRenders arc between source\nand destination statements"
    }
}

' ─────────────────────────────────────────────
' EXTERNAL BASE CLASSES (abbreviated)
' ─────────────────────────────────────────────
package "mindustry.world (External)" {
    class Block {
        note "World block type"
    }
    class Building {
        note "World block instance"
    }
    interface Ranged {
        +range(): float
    }
}

' ─────────────────────────────────────────────
' RELATIONSHIPS
' ─────────────────────────────────────────────

' Inheritance — block hierarchy
LogicBlock --|> Block
LogicBuild --|> Building

' Interface implementations
LogicBuild ..|> LReadable
LogicBuild ..|> LWritable
LogicBuild ..|> Ranged
LCategory ..|> "Comparable<LCategory>"

' LExecutor composition
LExecutor *-- "0..*" LInstruction : executes >
LExecutor *-- "0..*" LVar : stores >
LExecutor o-- LogicBuild : build ref (nullable) >

' LAssembler produces for LExecutor
LAssembler ..> LInstruction : produces
LAssembler ..> LVar : produces
LExecutor ..> LAssembler : load()

' LStatement → LAssembler
LStatement ..> LAssembler : build() emits to >
LAssembler ..> LStatement : write() iterates >

' LStatements contains statement subclasses
LStatements +-- CommentStatement
LStatements +-- ReadStatement
LStatements +-- WriteStatement
LStatements +-- JumpStatement
LStatements +-- OperationStatement
LStatements +-- InvalidStatement

' Statement inheritance
CommentStatement --|> LStatement
ReadStatement --|> LStatement
WriteStatement --|> LStatement
JumpStatement --|> LStatement
OperationStatement --|> LStatement
InvalidStatement --|> LStatement

' LStatement → LCategory
LStatement ..> LCategory : category() >

' LInstruction implementations
ReadI ..|> LInstruction
WriteI ..|> LInstruction
PrintI ..|> LInstruction
DrawI ..|> LInstruction
SetI ..|> LInstruction
OpI ..|> LInstruction
JumpI ..|> LInstruction
EndI ..|> LInstruction
WaitI ..|> LInstruction
ControlI ..|> LInstruction
SenseI ..|> LInstruction
RadarI ..|> LInstruction
UnitBindI ..|> LInstruction
UnitControlI ..|> LInstruction
SpawnUnitI ..|> LInstruction
SetBlockI ..|> LInstruction
SetRuleI ..|> LInstruction
EffectI ..|> LInstruction

' LogicBuild composition
LogicBuild *-- LExecutor : runs >
LogicBuild *-- "0..*" LogicLink : links >
LogicBuild ..> LAssembler : updateCode() assembles >

' LogicLink references LVar
LogicLink o-- LVar : logicVar >

' LCanvas manages statements
LCanvas *-- DragLayout : statements >
LCanvas o-- "0..*" LStatement : manages >
DragLayout *-- "0..*" StatementElem : children >
StatementElem o-- LStatement : wraps >
LStatement o-- StatementElem : elem (transient) >
JumpButton o-- StatementElem : target elem >
JumpButton *-- JumpCurve : curve >
LCanvas +-- DragLayout
LCanvas +-- StatementElem
LCanvas +-- JumpButton
LCanvas +-- JumpCurve

@enduml
