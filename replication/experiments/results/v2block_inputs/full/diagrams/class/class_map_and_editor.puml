@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EAF4FB
    BorderColor #2980B9
}
skinparam enum {
    BackgroundColor #FFF3CD
    BorderColor #856404
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
}

title Map System and Editor

' ─────────────────────────────────────────────────────────
' External base types (shown for context, no detail)
' ─────────────────────────────────────────────────────────
class Dialog <<external>>
class Tile <<external>>
class UnlockableContent <<external>>

' ─────────────────────────────────────────────────────────
' Package: mindustry.maps
' ─────────────────────────────────────────────────────────
package "mindustry.maps" {

    class Map {
        +final boolean custom
        +final StringMap tags
        +final Fi file
        +int width, height
        +boolean workshop
        +@Nullable Texture texture
        +IntSet teams
        +int spawns
        +@Nullable LoadedMod mod
        --
        +Rules applyRules(Gamemode mode)
        +Rules rules(Rules base)
        +Seq<GenerateFilter> filters()
        +String name()
        +String author()
        +String description()
        +Fi previewFile()
        +Fi cacheFile()
        +int getHighScore()
        +void setHighScore(int)
    }

    class Maps {
        +Seq<Map> maps
        +ShuffleMode shuffleMode
        +@Nullable MapProvider shuffler
        +@Nullable Map nextMapOverride
        +{static} Prov<GenerateFilter>[] allFilterTypes
        --
        +void load()
        +void reload()
        +Map saveMap(ObjectMap<String,String> baseTags)
        +void importMap(Fi file)
        +void removeMap(Map map)
        +Map getNextMap(Gamemode mode, Map previous)
        +Seq<Map> all()
        +Seq<Map> customMaps()
        +Seq<Map> defaultMaps()
        +Map byName(String name)
        +Seq<GenerateFilter> readFilters(String str)
        +void addDefaultOres(Seq<GenerateFilter>)
        +void loadPreviews()
        -Map loadMap(Fi, boolean)
    }

    interface MapProvider <<inner>> {
        +Map next(Gamemode, Map)
    }

    enum ShuffleMode <<inner>> {
        none
        all
        custom
        builtin
    }
}

' ─────────────────────────────────────────────────────────
' Package: mindustry.io
' ─────────────────────────────────────────────────────────
package "mindustry.io" {

    class MapIO <<utility>> {
        +{static} Map createMap(Fi file, boolean custom)
        +{static} void writeMap(Fi file, Map map)
        +{static} void loadMap(Map map)
        +{static} void loadMap(Map map, WorldContext cons)
        +{static} Pixmap generatePreview(Map map)
        +{static} Pixmap generatePreview(Tiles tiles)
        +{static} Pixmap writeImage(Tiles tiles)
        +{static} void readImage(Pixmap pixmap, Tiles tiles)
        +{static} boolean isImage(Fi file)
    }
}

' ─────────────────────────────────────────────────────────
' Package: mindustry.editor
' ─────────────────────────────────────────────────────────
package "mindustry.editor" {

    class MapEditor {
        +{static} float[] brushSizes
        +StringMap tags
        +EditorRenderer renderer
        +float brushSize
        +int rotation
        +Block drawBlock
        +Team drawTeam
        +boolean showTerrain
        +boolean showFloor
        +boolean showBuildings
        -Context context
        -OperationStack stack
        -DrawOperation currentOp
        -boolean loading
        --
        +void beginEdit(int width, int height)
        +void beginEdit(Map map)
        +void beginEdit(Pixmap pixmap)
        +Map createMap(Fi file)
        +void drawBlocks(int x, int y)
        +void drawBlocks(int x, int y, boolean square, boolean forceOverlay, Boolf<Tile>)
        +void drawBlocksReplace(int x, int y)
        +void drawCircle(int x, int y, Cons<Tile> drawer)
        +void drawSquare(int x, int y, Cons<Tile> drawer)
        +void resize(int width, int height, int shiftX, int shiftY)
        +void addCliffs()
        +void undo()
        +void redo()
        +boolean canUndo()
        +boolean canRedo()
        +void flushOp()
        +void addTileOp(long data)
        +Tiles tiles()
        +Tile tile(int x, int y)
        +int width()
        +int height()
    }

    note right of MapEditor
      Inner class Context implements WorldContext.
      beginEdit(Map) -> MapIO.loadMap(map, Context)
      Context.create() allocates EditorTiles.
    end note

    class MapEditorDialog {
        +MapView view
        +MapInfoDialog infoDialog
        +MapLoadDialog loadDialog
        +MapResizeDialog resizeDialog
        +MapGenerateDialog generateDialog
        +SectorGenerateDialog sectorGenDialog
        -Rules lastSavedRules
        -boolean saved
        -boolean shownWithMap
        --
        +@Nullable Map save()
        +void resumeEditing()
        +void resumeAfterPlaytest(Map map)
        -void editInGame()
        -void playtest()
        -void doInput()
        -void tryExit()
        -void addBlockSelection(Table cont)
    }

    class EditorTile {
        --
        +void setFloor(Floor type)
        +void setBlock(Block type, Team, int rotation, Prov<Building>)
        +void setTeam(Team team)
        +void setOverlay(Block overlay)
        +boolean isEditorTile()
        -void op(int type, short value)
        -boolean skip()
    }

    note bottom of EditorTile
      skip() suppresses op recording
      during loading, world gen, or in-game.
    end note

    class DrawOperation {
        +{static} byte opFloor  = 0
        +{static} byte opBlock  = 1
        +{static} byte opRotation = 2
        +{static} byte opTeam   = 3
        +{static} byte opOverlay = 4
        +{static} byte opData   = 5
        +LongSeq array
        --
        +void addOperation(long op)
        +void undo()
        +void redo()
        +int getTile(Tile, int type)
        +void setTile(Tile, int type, int to)
        +boolean isEmpty()
        +int size()
        +void remove(int amount)
    }

    note right of DrawOperation
      Each op packed as long:
      14b x | 14b y | 3b type | value
    end note

    class OperationStack {
        -{static} final int maxSize = 10
        -Seq<DrawOperation> stack
        -int index
        --
        +void add(DrawOperation action)
        +void undo()
        +void redo()
        +boolean canUndo()
        +boolean canRedo()
        +void clear()
    }

    enum EditorTool {
        zoom
        pick
        line
        pencil
        eraser
        fill
        spray
        --
        +String[] altModes
        +KeyCode key
        +int mode
        +boolean edit
        +boolean draggable
        --
        +void touched(int x, int y)
        +void touchedLine(int x1, int y1, int x2, int y2)
    }

    class EditorRenderer {
        -EditorSpriteCache[][] chunks
        -IntSet recacheChunks
        +int width
        +int height
        -Shader shader
        --
        +void resize(int width, int height)
        +void draw(float tx, float ty, float tw, float th)
        +void updateStatic(int x, int y)
        +void updateBlock(Tile tile)
        +void recache()
    }

    note right of EditorRenderer
      Map split into 60×60 chunks
      using EditorSpriteCache for GPU batching.
    end note
}

' ─────────────────────────────────────────────────────────
' Package: mindustry.maps.filters
' ─────────────────────────────────────────────────────────
package "mindustry.maps.filters" {

    abstract class GenerateFilter {
        +int seed
        --
        +{abstract} FilterOption[] options()
        +void apply(Tiles tiles, GenerateInput in)
        +void apply(GenerateInput in)
        +boolean isBuffered()
        +boolean isPost()
        +void randomize()
        +String name()
        +String simpleName()
        +GenerateFilter copy()
    }

    note right of GenerateFilter
      isBuffered() = read-before-write (distort, median).
      isPost() = runs after initial map load.
      GenerateInput inner class: x,y,width,height,
        floor,block,overlay,packedData.
    end note

    class NoiseFilter extends GenerateFilter
    class TerrainFilter extends GenerateFilter
    class OreFilter extends GenerateFilter
    class ScatterFilter extends GenerateFilter
    class BlendFilter extends GenerateFilter
    class MirrorFilter extends GenerateFilter
    class ClearFilter extends GenerateFilter
    class MedianFilter extends GenerateFilter
    class CoreSpawnFilter extends GenerateFilter
    class SpawnPathFilter extends GenerateFilter

    note as FilterNote
      Additional filter subclasses:
      OreMedianFilter, DistortFilter,
      RiverNoiseFilter, EnemySpawnFilter,
      LogicFilter, RandomItemFilter
    end note
}

' ─────────────────────────────────────────────────────────
' Package: mindustry.maps.generators
' ─────────────────────────────────────────────────────────
package "mindustry.maps.generators" {

    interface WorldGenerator {
        +void generate(Tiles tiles, WorldParams params)
        +void postGenerate(Tiles tiles)
    }

    abstract class BasicGenerator {
        #Rand rand
        #int width, height
        #@Nullable Tiles tiles
        #@Nullable Block floor
        #@Nullable Block block
        #@Nullable Block ore
        #Schematic defaultLoadout
        --
        +void generate(Tiles tiles, WorldParams params)
        +void pass(Intc2 r)
        +void median(int radius, double percentile, Block targetFloor)
        +void ores(Seq<Block>)
        +void terrain(Block dst, float scl, float mag, float cmag)
        +void cells(int iterations, int birthLimit, int deathLimit, int cradius)
        +void distort(float scl, float mag)
        +void cliffs()
        +void blend(Block floor, Block around, float radius)
        +void erase(int cx, int cy, int rad)
        +void trimDark()
        +void inverseFloodFill(Tile start)
        #void generate()
        #{abstract} float noise(float x, float y, double octaves, double falloff, double scl, double mag)
    }

    class PlanetGenerator {
        +int baseSeed
        +int seed
        +@Nullable Sector sector
        --
        +void generate(Tiles tiles, Sector sec, WorldParams params)
        +void generateSector(Sector sector)
        +void onSectorCaptured(Sector)
        +void onSectorLost(Sector)
        +void beforeSaveWrite(Sector)
        +boolean allowLanding(Sector)
        +boolean allowAcceleratorLanding(Sector)
        +void addWeather(Sector sector, Rules rules)
        +int getSectorSize(Sector sector)
        +float getSizeScl()
        #void genTile(Vec3 position, TileGen tile)
        #float noise(float x, float y, double octaves, double falloff, double scl, double mag)
    }

    note right of PlanetGenerator
      noise() projects 2D tile coords onto 3D sphere
      surface (Simplex.noise3d) for seamless tiling.
    end note

    class BaseGenerator {
        -Tiles tiles
        -Seq<Tile> cores
        --
        +void generate(Tiles tiles, Seq<Tile> cores, Tile spawn, Team team, Sector sector, float difficulty)
        +void postGenerate()
        +{static} Block getDifficultyWall(int size, float difficulty)
        +{static} boolean tryPlace(BasePart part, int x, int y, Team team, Rand rand)
    }

    class FileMapGenerator {
        +final Map map
        +final SectorPreset preset
        --
        +FileMapGenerator(String mapName, SectorPreset preset)
        +FileMapGenerator(Map map, SectorPreset preset)
        +void generate(Tiles tiles, WorldParams params)
    }
}

' ─────────────────────────────────────────────────────────
' Package: mindustry.type
' ─────────────────────────────────────────────────────────
package "mindustry.type" {

    class Sector {
        +final SectorRect rect
        +final Planet planet
        +final int id
        +@Nullable SaveSlot save
        +@Nullable SectorPreset preset
        +SectorInfo info
        +float threat
        +boolean generateEnemyBase
        --
        +Seq<Sector> near()
        +boolean unlocked()
        +boolean hasBase()
        +boolean isAttacked()
        +boolean isFrozen()
        +boolean hasEnemyBase()
        +boolean isBeingPlayed()
        +void saveInfo()
        +void loadInfo()
        +void clearInfo()
        +String name()
        +String displayThreat()
    }

    class SectorPreset {
        +FileMapGenerator generator
        +Planet planet
        +Sector sector
        +int captureWave
        +float difficulty
        +boolean requireUnlock
        +boolean isLastSector
        +boolean attackAfterWaves
        +boolean allowLaunchSchematics
        +boolean allowLaunchLoadout
        +Seq<Sector> shieldSectors
        --
        +SectorPreset(String name, Planet planet, int sector)
        +void initialize(Planet planet, int sector, boolean override)
        +ContentType getContentType()
        +boolean isHidden()
    }

    class Planet {
        +@Nullable PlanetGrid grid
        +@Nullable PlanetGenerator generator
        +Seq<Sector> sectors
        +Vec3 position
        +float radius
        +float orbitRadius
        +float orbitTime
        +float rotateTime
        +Block defaultCore
        +@Nullable Planet parent
        +Seq<Planet> children
        --
        +void load()
        +Sector getSector(Ptile tile)
        +void preset(int id, SectorPreset preset)
        +@Nullable Sector find(Vec3 ray)
    }
}

' ═══════════════════════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════════════════════

' ── External base classes ──
MapEditorDialog --|> Dialog
EditorTile --|> Tile
Planet --|> UnlockableContent
SectorPreset --|> UnlockableContent

' ── Maps package internals ──
Maps +-- MapProvider
Maps +-- ShuffleMode
ShuffleMode ..|> MapProvider : implements
Maps "1" o-- "0..*" Map : maps
Maps --> MapProvider : shuffler

' ── Map interfaces ──
Map ..|> Comparable : implements
Map ..|> Publishable : implements

' ── Maps ↔ MapIO ──
Maps ..> MapIO : uses (createMap, writeMap,\ngeneratePreview)

' ── MapIO ↔ Map ──
MapIO ..> Map : creates / writes

' ── MapEditorDialog ──
MapEditorDialog ..|> Disposable : implements
MapEditorDialog ..> MapEditor : uses (Vars.editor)
MapEditorDialog ..> Maps : uses (Vars.maps)
MapEditorDialog ..> MapIO : uses (writeMap, writeImage,\nreadImage)

' ── MapEditor internals ──
MapEditor *-- OperationStack : stack
MapEditor *-- DrawOperation : currentOp
MapEditor *-- EditorRenderer : renderer

' ── EditorTile ──
EditorTile ..> MapEditor : calls addTileOp()

' ── DrawOperation ↔ OperationStack ──
OperationStack "1" *-- "0..10" DrawOperation : manages
DrawOperation ..> EditorRenderer : calls updateStatic /\nupdateBlock on undo/redo

' ── EditorTool ──
EditorTool ..> MapEditor : calls drawBlocks /\ndrawCircle / drawBlocksReplace

' ── EditorRenderer ──
EditorRenderer ..|> Disposable : implements

' ── Generator hierarchy ──
BasicGenerator ..|> WorldGenerator : implements
PlanetGenerator --|> BasicGenerator
PlanetGenerator ..|> HexMesher : implements
FileMapGenerator ..|> WorldGenerator : implements

' ── BaseGenerator ──
BaseGenerator ..> Sector : uses

' ── FileMapGenerator ──
FileMapGenerator --> Map : loads from file
FileMapGenerator --> SectorPreset : references

' ── Planet / Sector / SectorPreset ──
Planet "1" o-- "0..*" Sector : sectors
Planet --> PlanetGenerator : generator
Sector --> Planet : planet
Sector --> SectorPreset : preset (optional)
SectorPreset --> FileMapGenerator : generator
SectorPreset --> Planet : planet
SectorPreset --> Sector : sector
SectorPreset ..> Sector : shieldSectors (Seq)

' ── Filter hierarchy (representative) ──
GenerateFilter ..|> Cloneable : implements
GenerateFilter ..|> Serializable : implements

@enduml
