@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam enum {
    BackgroundColor #FFF3CD
    BorderColor #856404
}
skinparam annotation {
    BackgroundColor #D1ECF1
    BorderColor #0C5460
}

title Mod Support System

package "mindustry.mod" {

    abstract class Mod {
        +getConfigFolder(): Fi
        +getConfig(): Fi
        +init(): void
        +loadContent(): void
        +packSprites(MultiPacker): void
        +registerServerCommands(CommandHandler): void
        +registerClientCommands(CommandHandler): void
    }

    abstract class Plugin {
        ' Marker: sets meta.hidden=true on load
        ' Used for server/client-only mods
    }

    class Mods {
        -mods: Seq<LoadedMod>
        -scripts: Scripts
        -parser: ContentParser
        -mainLoader: ModClassLoader
        -metas: ObjectMap<Class<?>, ModMeta>
        -newImports: Seq<LoadedMod>
        -bundles: ObjectMap<String, Seq<Fi>>
        -requiresReload: boolean
        -lastOrderedMods: Seq<LoadedMod>
        +load(): void
        +loadContent(): void
        +loadScripts(): void
        +loadAsync(): void
        +loadSync(): void
        +importMod(Fi): LoadedMod
        +removeMod(LoadedMod): void
        +getMod(String): LoadedMod
        +getMod(Class): LoadedMod
        +locateMod(String): LoadedMod
        +orderedMods(): Seq<LoadedMod>
        +setEnabled(LoadedMod, boolean): void
        +getScripts(): Scripts
        +hasScripts(): boolean
        +eachClass(Cons<Mod>): void
        +eachEnabled(Cons<LoadedMod>): void
        +getModStrings(): Seq<String>
        +getIncompatibility(Seq<String>): Seq<String>
        +addParseListener(ParseListener): void
        +findMeta(Fi): ModMeta
        +resolveDependencies(Seq<ModMeta>): OrderedMap<String, ModState>
        +handleContentError(Content, Throwable): void
        +list(): Seq<LoadedMod>
        +mainLoader(): ClassLoader
    }

    class LoadedMod {
        +file: Fi
        +root: Fi
        +main: Mod
        +name: String
        +meta: ModMeta
        +loader: ClassLoader
        +state: ModState
        +dependencies: Seq<LoadedMod>
        +softDependencies: Seq<LoadedMod>
        +missingDependencies: Seq<String>
        +missingSoftDependencies: Seq<String>
        +erroredContent: ObjectSet<Content>
        +iconTexture: Texture
        +isJava(): boolean
        +enabled(): boolean
        +shouldBeEnabled(): boolean
        +hasUnmetDependencies(): boolean
        +hasContentErrors(): boolean
        +isSupported(): boolean
        +isBlacklisted(): boolean
        +isOutdated(): boolean
        +getMinMajor(): int
        +getRepo(): String
        +dispose(): void
        +getSteamID(): String
        +addSteamID(String): void
    }

    class ModMeta {
        +name: String
        +internalName: String
        +minGameVersion: String
        +displayName: String
        +author: String
        +description: String
        +version: String
        +main: String
        +repo: String
        +dependencies: Seq<String>
        +softDependencies: Seq<String>
        +hidden: boolean
        +java: boolean
        +iosCompatible: boolean
        +texturescale: float
        +pregenerated: boolean
        +contentOrder: String[]
        +legacyCompatible: boolean
        +isBlacklisted(): boolean
        +shortDescription(): String
        +cleanup(): void
        +getMinMajor(): int
    }

    enum ModState {
        enabled
        contentErrors
        missingDependencies
        incompleteDependencies
        circularDependencies
        unsupported
        disabled
    }

    class ModClassLoader {
        -children: Seq<ClassLoader>
        -inChild: ThreadLocal<Boolean>
        +ModClassLoader(ClassLoader parent)
        +addChild(ClassLoader): void
        #findClass(String): Class<?>
    }

    class Scripts {
        ~currentMod: LoadedMod
        -context: Context
        -scope: Scriptable
        -errored: boolean
        +Scripts()
        +run(LoadedMod, Fi): void
        +runConsole(String): String
        +log(String, String): void
        +log(LogLevel, String, String): void
        +newFloats(int): float[]
        +hasErrored(): boolean
        +dispose(): void
    }

    class ScriptModuleProvider {
        ' Resolves require() paths from mod root scripts/ folder
        ' Supports cross-mod imports via 'mod-name/script' syntax
    }

    class ContentParser {
        -contentTypes: ObjectMap<Class<?>, ContentType>
        -listeners: Seq<ParseListener>
        -allowClassResolution: boolean
        -allowAssetLoading: boolean
        -classParsers: ObjectMap<Class<?>, FieldParser>
        +parse(LoadedMod, String, String, Fi, ContentType): Content
        +finishParsing(): void
        +checkInit(): void
        +markError(Content, LoadedMod, Fi, Throwable): void
        +markError(Content, Throwable): void
        +readFields(Object, JsonValue): void
        +readBlockConsumers(Block, JsonValue): void
    }

    interface ParseListener {
        +parsed(Class<?> type, JsonValue jsonData, Object result): void
    }

    class ClassMap {
        +{static} classes: ObjectMap<String, Class<?>>
        ' ~200+ entries: simple name → concrete game class
        ' e.g. "GenericCrafter" → GenericCrafter.class
    }

    class DataPatcher {
        -patches: Seq<PatchSet>
        -applied: boolean
        -contentLoader: ContentLoader
        -usedpatches: ObjectSet<Object>
        -resetters: Seq<Runnable>
        -afterCallbacks: Seq<Runnable>
        -{static} parser: ContentParser
        +apply(Seq<String>): void
        +unapply(): void
        +isPatched(Object): boolean
        +assign(Object, String, Object, ...): void
        +visit(Object): void
        +created(Object): void
        +reset(Runnable): void
    }

    class PatchSet {
        +patch: String
        +json: JsonValue
        +name: String
        +error: boolean
        +warnings: Seq<String>
    }

    annotation NoPatch {
        ' Targets: FIELD, TYPE
        ' Retention: RUNTIME
        ' Prevents DataPatcher modification
    }

    class ClassLoaderCloser {
        +{static} close(ClassLoader): void
        ' Android workaround: only calls close() on non-Android
    }

    class ModListing {
        +repo: String
        +name: String
        +internalName: String
        +author: String
        +lastUpdated: String
        +description: String
        +minGameVersion: String
        +hasScripts: boolean
        +hasJava: boolean
        +iosCompatible: boolean
        +legacyCompatible: boolean
        +contentTypes: String[]
        +stars: int
    }

    class ModResolutionContext {
        -dependencies: ObjectMap<String, Seq<ModDependency>>
        -visited: ObjectSet<String>
        -ordered: OrderedSet<String>
        -invalid: ObjectMap<String, ModState>
        ' State for topological DFS dependency resolution
    }

    class ModDependency {
        +name: String
        +required: boolean
    }

}

' ─── Inheritance ───────────────────────────────────────────────
Plugin --|> Mod
ModClassLoader --|> ClassLoader

' ─── Interface Implementations ────────────────────────────────
Mods ..|> Loadable
LoadedMod ..|> Publishable
LoadedMod ..|> Disposable
Scripts ..|> Disposable

' ─── Compositions (Mods owns these) ───────────────────────────
Mods *-- "many" LoadedMod : mods
Mods *-- ContentParser : parser
Mods *-- ModClassLoader : mainLoader
Mods o-- Scripts : scripts (lazy)

' ─── Compositions (LoadedMod owns these) ──────────────────────
LoadedMod *-- ModMeta : meta
LoadedMod o-- Mod : main (nullable)
LoadedMod --> ModState : state

' ─── Dependency / association ────────────────────────────────
Scripts --> LoadedMod : currentMod
Scripts *-- ScriptModuleProvider : module resolver

ContentParser --> ParseListener : notifies
ContentParser ..> ClassMap : resolves class names

DataPatcher ..> ContentParser : uses (static, classParsers off)
DataPatcher *-- PatchSet : patches
DataPatcher ..> NoPatch : checks via reflection

Mods ..> ModResolutionContext : uses for topological sort
Mods ..> ClassLoaderCloser : calls on mod unload
ModResolutionContext *-- ModDependency

LoadedMod "1" o-- "many" LoadedMod : dependencies

@enduml
