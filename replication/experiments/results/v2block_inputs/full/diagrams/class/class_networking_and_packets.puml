@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Networking and Packet System

' ─────────────────────────────────────────
'  Core networking infrastructure
' ─────────────────────────────────────────
package "mindustry.net" {

    class Net {
        -{static} packetProvs: Seq<Prov<Packet>>
        -{static} packetClasses: Seq<Class<Packet>>
        -{static} packetToId: ObjectIntMap<Class<?>>
        -server: boolean
        -active: boolean
        -clientLoaded: boolean
        -packetQueue: Seq<Packet>
        -clientListeners: ObjectMap<Class<?>, Cons>
        -serverListeners: ObjectMap<Class<?>, Cons2<NetConnection, Object>>
        -streams: IntMap<StreamBuilder>
        -provider: NetProvider
        --
        +{static} registerPacket(cons: Prov<T>): void
        +{static} getPacketId(packet: Packet): byte
        +{static} newPacket(id: byte): T
        +connect(ip: String, port: int, success: Runnable): void
        +host(port: int): void
        +closeServer(): void
        +disconnect(): void
        +send(object: Object, reliable: boolean): void
        +sendExcept(except: NetConnection, object: Object, reliable: boolean): void
        +handleClient(type: Class<T>, listener: Cons<T>): void
        +handleServer(type: Class<T>, listener: Cons2<NetConnection, T>): void
        +handleClientReceived(object: Packet): void
        +handleServerReceived(connection: NetConnection, object: Packet): void
        +discoverServers(cons: Cons<Host>, done: Runnable): void
        +pingHost(address: String, port: int, valid: Cons<Host>, failed: Cons<Exception>): void
        +active(): boolean
        +server(): boolean
        +client(): boolean
    }

    interface NetProvider {
        +connectClient(ip: String, port: int, success: Runnable): void
        +sendClient(object: Object, reliable: boolean): void
        +disconnectClient(): void
        +discoverServers(callback: Cons<Host>, done: Runnable): void
        +pingHost(address: String, port: int, valid: Cons<Host>, failed: Cons<Exception>): void
        +hostServer(port: int): void
        +getConnections(): Iterable<NetConnection>
        +closeServer(): void
        +dispose(): void
        +setConnectFilter(filter: ServerConnectFilter): void
        +getConnectFilter(): ServerConnectFilter
    }

    abstract class NetConnection {
        +address: String
        +uuid: String
        +usid: String
        +mobile: boolean
        +modclient: boolean
        +player: Player
        +kicked: boolean
        +syncTime: long
        +connectTime: long
        +lastReceivedClientSnapshot: int
        +snapshotsSent: int
        +chatRate: Ratekeeper
        +packetRate: Ratekeeper
        +hasConnected: boolean
        +hasBegunConnecting: boolean
        +hasDisconnected: boolean
        --
        +kick(): void
        +kick(reason: KickReason): void
        +kick(reason: String): void
        +sendStream(stream: Streamable): void
        +{abstract} send(object: Object, reliable: boolean): void
        +{abstract} close(): void
        +isConnected(): boolean
    }

    abstract class Packet {
        #{static} NODATA: byte[]
        #{static} BAIS: ReusableByteInStream
        #{static} READ: Reads
        +{static} priorityLow: int = 0
        +{static} priorityNormal: int = 1
        +{static} priorityHigh: int = 2
        --
        +read(read: Reads): void
        +write(write: Writes): void
        +allow(server: boolean): boolean
        +handled(): void
        +getPriority(): int
        +handleClient(): void
        +handleServer(con: NetConnection): void
    }

    class Streamable {
        +stream: ByteArrayInputStream
        --
        +getPriority(): int
        +allow(server: boolean): boolean
    }

    class StreamBuilder {
        +id: int
        +type: int
        +total: int
        +stream: ByteArrayOutputStream
        --
        +progress(): float
        +add(data: byte[]): void
        +build(): Streamable
        +isDone(): boolean
    }

    class ArcNetProvider {
        -client: Client
        -server: Server
        -connections: CopyOnWriteArrayList<ArcConnection>
        -serverThread: Thread
        -{static} decompressor: LZ4SafeDecompressor
        -{static} compressor: LZ4Compressor
        -playerLimitCache: int
        -packetSpamLimit: int
        -clientUdpErrorRate: Ratekeeper
        --
        +connectClient(ip: String, port: int, success: Runnable): void
        +disconnectClient(): void
        +sendClient(object: Object, reliable: boolean): void
        +hostServer(port: int): void
        +closeServer(): void
        +getConnections(): Iterable<ArcConnection>
        +discoverServers(callback: Cons<Host>, done: Runnable): void
        +pingHost(address: String, port: int, valid: Cons<Host>, invalid: Cons<Exception>): void
    }

    class ArcConnection {
        +connection: Connection
        -lastErrorTime: long
        --
        +isConnected(): boolean
        +sendStream(stream: Streamable): void
        +send(object: Object, reliable: boolean): void
        +close(): void
    }

    class PacketSerializer {
        -decompressBuffer: ThreadLocal<ByteBuffer>
        -reads: ThreadLocal<Reads>
        -writes: ThreadLocal<Writes>
        +{static} upload: WindowedMean
        +{static} download: WindowedMean
        --
        +read(byteBuffer: ByteBuffer): Object
        +write(byteBuffer: ByteBuffer, o: Object): void
        +writeFramework(buffer: ByteBuffer, msg: FrameworkMessage): void
        +readFramework(buffer: ByteBuffer): FrameworkMessage
    }

    class NetworkIO <<utility>> {
        +{static} writeWorld(player: Player, os: OutputStream): void
        +{static} loadWorld(is: InputStream): void
        +{static} writeServerData(): ByteBuffer
        +{static} readServerData(ping: int, hostAddress: String, buffer: ByteBuffer): Host
    }

    class Host {
        +name: String
        +address: String
        +mapname: String
        +description: String
        +wave: int
        +players: int
        +playerLimit: int
        +version: int
        +versionType: String
        +mode: Gamemode
        +ping: int
        +port: int
    }

    class ValidateException {
        +player: Player
    }

    class RuntimeException <<java.lang>> {
    }
}

' ─────────────────────────────────────────
'  Packet types (inner classes of Packets)
' ─────────────────────────────────────────
package "mindustry.net (Packets container)" {

    enum KickReason {
        kick
        clientOutdated
        serverOutdated
        banned
        gameover
        recentKick
        nameInUse
        idInUse
        nameEmpty
        customClient
        serverClose
        vote
        typeMismatch
        whitelist
        playerLimit
        serverRestarting
    }

    enum AdminAction {
        kick
        ban
        trace
        wave
        switchTeam
    }

    class Connect {
        +addressTCP: String
        --
        +getPriority(): int
    }

    class Disconnect {
        +reason: String
        --
        +getPriority(): int
    }

    class ConnectPacket {
        +version: int
        +versionType: String
        +name: String
        +locale: String
        +uuid: String
        +usid: String
        +mods: Seq<String>
        +mobile: boolean
        +color: int
        --
        +read(read: Reads): void
        +write(write: Writes): void
        +getPriority(): int
    }

    class StreamBegin {
        +id: int
        +total: int
        +type: byte
        --
        +allow(server: boolean): boolean
        +read(read: Reads): void
        +write(write: Writes): void
    }

    class StreamChunk {
        +id: int
        +data: byte[]
        --
        +allow(server: boolean): boolean
        +read(read: Reads): void
        +write(write: Writes): void
    }

    class WorldStream {
    }
}

' ─────────────────────────────────────────
'  Generated Call class
' ─────────────────────────────────────────
package "mindustry.gen" {
    class Call <<generated>> {
        --
        +{static} registerPackets(): void
        +{static} sendMessage(msg: String, sender: String, player: Player): void
        +{static} ping(player: Player, time: long): void
        +{static} kick(reason: KickReason): void
        +{static} setRules(rules: Rules): void
        +{static} connect(ip: String, port: int): void
        +{static} sendChatMessage(player: Player, msg: String): void
    }
}

' ─────────────────────────────────────────
'  Application-level handlers
' ─────────────────────────────────────────
package "mindustry.core" {
    class NetClient <<ApplicationListener>> {
        --
        +sendMessage(msg: String, sender: String, player: Player): void
        +ping(player: Player, time: long): void
        +kick(reason: KickReason): void
        +setRules(rules: Rules): void
        +connect(ip: String, port: int): void
    }

    class NetServer <<ApplicationListener>> {
        --
        +wave(): void
        +setPlayerTeam(player: Player, team: Team): void
        +administerPunishment(action: AdminAction, player: Player): void
    }
}

' ─────────────────────────────────────────
'  Inheritance — Packet hierarchy
' ─────────────────────────────────────────
Streamable --|> Packet
WorldStream --|> Streamable
Connect --|> Packet
Disconnect --|> Packet
ConnectPacket --|> Packet
StreamBegin --|> Packet
StreamChunk --|> Packet

' ─────────────────────────────────────────
'  Inheritance — Connection hierarchy
' ─────────────────────────────────────────
ArcConnection --|> NetConnection

' ─────────────────────────────────────────
'  Inheritance — Exception hierarchy
' ─────────────────────────────────────────
ValidateException --|> RuntimeException

' ─────────────────────────────────────────
'  Interface implementations
' ─────────────────────────────────────────
ArcNetProvider ..|> NetProvider

' ─────────────────────────────────────────
'  Compositions (has-a / inner classes)
' ─────────────────────────────────────────
Net *-right- NetProvider : -provider
Streamable *-- StreamBuilder : <<inner class>>
ArcNetProvider *-- ArcConnection : <<inner class>>
ArcNetProvider *-- PacketSerializer : <<inner class>>

' ─────────────────────────────────────────
'  Usage / dependencies
' ─────────────────────────────────────────
Net ..> NetConnection : dispatches packets to
NetClient ..> Net : registers client listeners
NetServer ..> Net : registers server listeners
Call ..> Net : net.send() / con.send()
Net ..> Call : registers generated packets
ArcNetProvider ..> NetworkIO : server discovery I/O
NetConnection ..> KickReason : uses for kick()
NetServer ..> AdminAction : uses for admin ops

' ─────────────────────────────────────────
'  Explanatory notes
' ─────────────────────────────────────────
note right of Net
  Central orchestrator.
  Static registry maps Class<Packet> → byte ID
  for serialization. Delegates all I/O to NetProvider.
  Reassembles streams: StreamBegin + StreamChunk
  → StreamBuilder → Streamable.handleClient().
end note

note right of Call
  **Auto-generated** at compile time by
  RemoteProcess + CallGenerator annotation processors.
  One static method per @Remote-annotated method.
  Each Call.X() fills an XCallPacket and
  calls net.send() or con.send().
end note

note bottom of PacketSerializer
  Implements NetSerializer for arc.net.
  LZ4 compression applied for packets > 36 bytes
  (except StreamChunk).
  Write format: [id: byte][uncompressed_len: short]
  [compressed_flag: byte][data].
  Thread-local ByteBuffers for thread safety.
end note

note bottom of Streamable
  Base for large payloads sent as chunks.
  NetConnection.sendStream() splits into
  StreamBegin + multiple StreamChunk packets.
  StreamBuilder reassembles on receiver side.
end note

@enduml
