@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Power and Distribution Blocks

' ─────────────────────────────────────────────
'  Interfaces
' ─────────────────────────────────────────────
interface Autotiler {
    ' tile-blending helpers
}

interface ChainedBuilding {
    +next(): Building
}

interface ControlBlock {
    ' unit-controllable
}

' ─────────────────────────────────────────────
'  External base classes
' ─────────────────────────────────────────────
abstract class Block {
}

abstract class Building {
    +power: PowerModule
}

' ─────────────────────────────────────────────
'  PowerGraph — standalone simulation object
' ─────────────────────────────────────────────
class PowerGraph {
    +producers : Seq<Building>
    +consumers : Seq<Building>
    +batteries : Seq<Building>
    +all : Seq<Building>
    +powerBalance : WindowedMean
    +lastPowerProduced : float
    +lastPowerNeeded : float
    +lastPowerStored : float
    +energyDelta : float
    +graphID : int
    --
    +update()
    +add(b : Building)
    +reflow(b : Building)
    +addGraph(g : PowerGraph)
    +remove(b : Building)
    +distributePower(needed : float, produced : float, charged : boolean)
    +getPowerProduced() : float
    +getPowerNeeded() : float
    +getBatteryStored() : float
    +useBatteries(amount : float)
    +chargeBatteries(amount : float)
    +getSatisfaction() : float
}

' ─────────────────────────────────────────────
'  Power blocks
' ─────────────────────────────────────────────
package "mindustry.world.blocks.power" {

    class PowerBlock {
        ' update=true, solid=true
        ' hasPower=true, group=BlockGroup.power
    }

    class PowerNode {
        +laserRange : float = 6
        +maxNodes : int = 3
        +autolink : boolean = true
        +laserColor1 : Color
        +laserColor2 : Color
        --
        +getPotentialLinks(t : Tile, team : Team, out : Cons<Building>)
        +{static} getNodeLinks(t : Tile, b : Block, team : Team, out : Cons<Building>)
        +linkValid(a : Building, b : Building) : boolean
        +insulated(x1 : int, y1 : int, x2 : int, y2 : int) : boolean
    }

    class "PowerNode.PowerNodeBuild" as PowerNodeBuild {
        ' power.links = IntSeq of packed positions
        --
        +placed()
        +onConfigureBuildTapped(other : Building)
        +draw()
        +config(link : Integer)
    }

    class PowerDistributor {
        ' consumesPower=false, outputsPower=true
    }

    class Battery {
        ' outputsPower=true, consumesPower=true
        ' BlockFlag.battery; update=false (driven by PowerGraph)
    }

    class "Battery.BatteryBuild" as BatteryBuild {
    }

    class PowerGenerator {
        +powerProduction : float
    }

    class "PowerGenerator.GeneratorBuild" as GeneratorBuild {
        +productionEfficiency : float
        --
        +getPowerProduction() : float
        +createExplosion()
    }

    class PowerDiode {
        ' insulated=true, rotate=true
        ' bridges two separate PowerGraphs one-way
    }

    class "PowerDiode.PowerDiodeBuild" as PowerDiodeBuild {
        +updateTile()
    }

}

' ─────────────────────────────────────────────
'  Distribution blocks
' ─────────────────────────────────────────────
package "mindustry.world.blocks.distribution" {

    class Conveyor {
        +speed : float
        +junctionReplacement : Block
        +bridgeReplacement : Block
    }

    class "Conveyor.ConveyorBuild" as ConveyorBuild {
        +ids : Item[3]
        +xs : float[3]
        +ys : float[3]
        +len : int
        +next : Building
        +aligned : boolean
        +minitem : float
        +clogHeat : float
        --
        +updateTile()
        +acceptItem(source : Building, item : Item) : boolean
        +handleItem(source : Building, item : Item)
    }

    class StackConveyor {
        +speed : float
        +recharge : float = 2
        +itemCapacity : int = 10
        +outputRouter : boolean = true
        ' states: stateMove=0, stateLoad=1, stateUnload=2
    }

    class "StackConveyor.StackConveyorBuild" as StackConveyorBuild {
    }

    class Duct {
        +speed : float = 5
        +armored : boolean = false
        ' variants: DuctRouter, DuctBridge, DuctJunction, OverflowDuct
    }

    class "Duct.DuctBuild" as DuctBuild {
        +next() : Building
    }

    class Router {
        +speed : float = 8
    }

    class "Router.RouterBuild" as RouterBuild {
        +lastItem : Item
        +lastInput : Tile
        +time : float
        +unit : BlockUnitc
        --
        +updateTile()
        +getTileTarget(item : Item, from : Tile, set : boolean) : Building
        +acceptItem(source : Building, item : Item) : boolean
        +handleItem(source : Building, item : Item)
    }

    class Junction {
        +speed : float = 26
        +capacity : int = 6
    }

    class "Junction.JunctionBuild" as JunctionBuild {
        +buffer : DirectionalItemBuffer
        --
        +updateTile()
        +handleItem(source : Building, item : Item)
        +acceptItem(source : Building, item : Item) : boolean
    }

    class Sorter {
        +invert : boolean
        ' instantTransfer=true, update=false
    }

    class "Sorter.SorterBuild" as SorterBuild {
        +sortItem : Item
        --
        +acceptItem(source : Building, item : Item) : boolean
        +handleItem(source : Building, item : Item)
        +getTileTarget(item : Item, from : Building, set : boolean) : Building
    }

    class OverflowGate {
        +speed : float = 1
        +invert : boolean = false
        ' instantTransfer=true, update=false
    }

    class "OverflowGate.OverflowGateBuild" as OverflowGateBuild {
        +getTileTarget(item : Item, from : Building, set : boolean) : Building
    }

    class ItemBridge {
        +range : int
        +transportTime : float
    }

    class "ItemBridge.ItemBridgeBuild" as ItemBridgeBuild {
        +link : int = -1
        +incoming : IntSeq
        +transportCounter : float
        +warmup : float
        --
        +updateTile()
        +updateTransport(other : Building)
        +linkValid(src : Tile, dst : Tile) : boolean
        +config(pos : Point2)
    }

    class BufferedItemBridge {
        +speed : float = 40
        +bufferCapacity : int = 50
        ' hasPower=false, canOverdrive=true
    }

    class "BufferedItemBridge.BufferedItemBridgeBuild" as BufferedItemBridgeBuild {
        +updateTransport(other : Building)
    }

    class MassDriver {
        +range : float
        +reload : float = 100
        +bulletSpeed : float = 5.5
        ' hasPower=true, configurable
    }

    class "MassDriver.MassDriverBuild" as MassDriverBuild {
        ' fires MassDriverBolt to linked MassDriver
    }

}

' ─────────────────────────────────────────────
'  Block inheritance hierarchy
' ─────────────────────────────────────────────
Block <|-- PowerBlock
Block <|-- PowerDiode
Block <|-- Conveyor
Block <|-- StackConveyor
Block <|-- Duct
Block <|-- Router
Block <|-- Junction
Block <|-- Sorter
Block <|-- OverflowGate
Block <|-- ItemBridge
Block <|-- MassDriver

PowerBlock <|-- PowerNode
PowerBlock <|-- PowerDistributor
PowerDistributor <|-- Battery
PowerDistributor <|-- PowerGenerator

ItemBridge <|-- BufferedItemBridge

' ─────────────────────────────────────────────
'  Building (inner Build class) inheritance
' ─────────────────────────────────────────────
Building <|-- PowerNodeBuild
Building <|-- BatteryBuild
Building <|-- GeneratorBuild
Building <|-- PowerDiodeBuild
Building <|-- ConveyorBuild
Building <|-- StackConveyorBuild
Building <|-- DuctBuild
Building <|-- RouterBuild
Building <|-- JunctionBuild
Building <|-- SorterBuild
Building <|-- OverflowGateBuild
Building <|-- ItemBridgeBuild
Building <|-- MassDriverBuild
ItemBridgeBuild <|-- BufferedItemBridgeBuild

' ─────────────────────────────────────────────
'  Inner class nesting (Block +-- BuildClass)
' ─────────────────────────────────────────────
PowerNode +-- PowerNodeBuild
Battery +-- BatteryBuild
PowerGenerator +-- GeneratorBuild
PowerDiode +-- PowerDiodeBuild
Conveyor +-- ConveyorBuild
StackConveyor +-- StackConveyorBuild
Duct +-- DuctBuild
Router +-- RouterBuild
Junction +-- JunctionBuild
Sorter +-- SorterBuild
OverflowGate +-- OverflowGateBuild
ItemBridge +-- ItemBridgeBuild
BufferedItemBridge +-- BufferedItemBridgeBuild
MassDriver +-- MassDriverBuild

' ─────────────────────────────────────────────
'  Interface implementations
' ─────────────────────────────────────────────
Conveyor ..|> Autotiler
StackConveyor ..|> Autotiler
Duct ..|> Autotiler

ConveyorBuild ..|> ChainedBuilding
DuctBuild ..|> ChainedBuilding

RouterBuild ..|> ControlBlock

' ─────────────────────────────────────────────
'  PowerGraph aggregates Buildings
' ─────────────────────────────────────────────
PowerGraph "1" o-- "*" Building : producers / consumers / batteries

' ─────────────────────────────────────────────
'  Cross-references
' ─────────────────────────────────────────────
Conveyor ..> Junction : junctionReplacement
Conveyor ..> ItemBridge : bridgeReplacement

@enduml
