@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #FFF3CD
    BorderColor #856404
}

title Production and Crafting Blocks

' ─── External base types ─────────────────────────────────────────────────────

package "mindustry.world.blocks (external)" <<Rectangle>> {
    abstract class Block {
        +String name
        +boolean update
        +boolean solid
        +boolean hasPower
        +boolean hasItems
        +boolean hasLiquids
        +void init()
        +void load()
        +void setStats()
        +void setBars()
    }

    class LiquidBlock extends Block {
    }

    abstract class BlockProducer extends Block {
    }
}

package "mindustry.gen (external)" <<Rectangle>> {
    abstract class Building {
        +void updateTile()
        +void draw()
        +boolean shouldConsume()
        +void write(Writes)
        +void read(Reads, byte)
    }

    abstract class LiquidBuild extends Building {
    }

    abstract class BlockProducerBuild extends Building {
        +Block recipe()
    }
}

interface HeatConsumer {
    +float[] sideHeat()
    +float heatRequirement()
}

' ─── Production Package ───────────────────────────────────────────────────────

package "mindustry.world.blocks.production" {

    ' ── Crafter branch ──────────────────────────────────────────────────────

    class GenericCrafter {
        +ItemStack outputItem
        +ItemStack[] outputItems
        +LiquidStack outputLiquid
        +LiquidStack[] outputLiquids
        +int[] liquidOutputDirections
        +float craftTime
        +float warmupSpeed
        +DrawBlock drawer
        +Effect craftEffect
        +Effect updateEffect
        --
        +boolean outputsItems()
        +boolean rotatedOutput(int, int, Tile)
        +TextureRegion[] icons()
        +void drawOverlay(float, float, int)
    }

    class GenericCrafterBuild {
        +float progress
        +float totalProgress
        +float warmup
        --
        +void updateTile()
        +void craft()
        +void dumpOutputs()
        +float warmup()
        +float progress()
        +float getProgressIncrease(float)
        +double sense(LAccess)
        +void write(Writes)
        +void read(Reads, byte)
    }

    class AttributeCrafter {
        +Attribute attribute
        +float baseEfficiency
        +float boostScale
        +float maxBoost
        +float minEfficiency
        +boolean displayEfficiency
        +boolean scaleLiquidConsumption
        --
        +boolean canPlaceOn(Tile, Team, int)
        +void drawPlace(int, int, int, boolean)
    }

    class AttributeCrafterBuild {
        +float attrsum
        --
        +float getProgressIncrease(float)
        +float efficiencyMultiplier()
        +float efficiencyScale()
        +void onProximityUpdate()
        +void pickedUp()
    }

    class HeatCrafter {
        +float heatRequirement
        +float overheatScale
        +float maxEfficiency
    }

    class HeatCrafterBuild {
        +float[] sideHeat
        +float heat
        --
        +void updateTile()
        +boolean shouldConsume()
        +float warmupTarget()
        +float efficiencyScale()
        +float heatRequirement()
        +float[] sideHeat()
    }

    ' ── Drill branch ────────────────────────────────────────────────────────

    class Drill {
        +int tier
        +float drillTime
        +float hardnessDrillMultiplier
        +float liquidBoostIntensity
        +float warmupSpeed
        +ObjectFloatMap<Item> drillMultipliers
        +Item blockedItem
        +boolean drawMineItem
        +Effect drillEffect
        --
        +float getDrillTime(Item)
        +boolean canPlaceOn(Tile, Team, int)
        +boolean canMine(Tile)
        +Item getDrop(Tile)
        +void countOre(Tile)
    }

    class DrillBuild {
        +float progress
        +float warmup
        +float timeDrilled
        +float lastDrillSpeed
        +Item dominantItem
        +int dominantItems
        --
        +void updateTile()
        +void draw()
        +void onProximityUpdate()
        +float progress()
        +void write(Writes)
        +void read(Reads, byte)
    }

    class BurstDrill {
        +float shake
        +float invertedTime
        +int arrows
        +Color arrowColor
        +Color glowColor
        +Sound drillSound
        --
        +float getDrillTime(Item)
        +TextureRegion[] icons()
    }

    class BurstDrillBuild {
        +float smoothProgress
        +float invertTime
        --
        +void updateTile()
        +void draw()
        +boolean shouldConsume()
    }

    class BeamDrill {
        +float drillTime
        +int range
        +int tier
        +float laserWidth
        +float optionalBoostIntensity
        +ObjectFloatMap<Item> drillMultipliers
        +Item blockedItem
        --
        +float getDrillTime(Item)
        +boolean rotatedOutput(int, int)
        +boolean canPlaceOn(Tile, Team, int)
        +void drawPlace(int, int, int, boolean)
    }

    class BeamDrillBuild {
        +Tile[] facing
        +Point2[] lasers
        +Item lastItem
        +float warmup
        +float boostWarmup
        +float lastDrillSpeed
        --
        +void updateTile()
        +void draw()
        +void updateLasers()
        +void onProximityUpdate()
        +void write(Writes)
        +void read(Reads, byte)
    }

    class WallCrafter {
        +float drillTime
        +float liquidBoostIntensity
        +Attribute attribute
        +Item output
        +boolean hasLiquidBooster
        +float boostItemUseTime
        --
        +boolean outputsItems()
        +boolean rotatedOutput(int, int)
        +boolean canPlaceOn(Tile, Team, int)
        +float getEfficiency(int, int, int, Cons, Intc2)
    }

    class WallCrafterBuild {
        +float time
        +float warmup
        +float totalTime
        +float lastEfficiency
        --
        +void updateTile()
        +boolean shouldConsume()
        +void draw()
    }

    ' ── Pump branch ─────────────────────────────────────────────────────────

    class Pump {
        +float pumpAmount
        +float consumeTime
        +float warmupSpeed
        +DrawBlock drawer
        --
        +boolean canPlaceOn(Tile, Team, int)
        +boolean canPump(Tile)
        +TextureRegion[] icons()
    }

    class PumpBuild {
        +float warmup
        +float totalProgress
        +float consTimer
        +Liquid liquidDrop
        --
        +void updateTile()
        +boolean shouldConsume()
        +void onProximityUpdate()
        +double sense(LAccess)
        +float warmup()
        +float totalProgress()
    }

    class SolidPump {
        +Liquid result
        +Attribute attribute
        +float baseEfficiency
        +float rotateSpeed
        +Effect updateEffect
        --
        +boolean canPump(Tile)
        +boolean canPlaceOn(Tile, Team, int)
        +void drawPlace(int, int, int, boolean)
    }

    class SolidPumpBuild {
        +float warmup
        +float pumpTime
        +float boost
        +float validTiles
        +float lastPump
        --
        +void updateTile()
        +boolean shouldConsume()
        +void onProximityUpdate()
        +float typeLiquid()
        +double sense(LAccess)
    }

    class Fracker {
        +float itemUseTime
        --
        +void setStats()
    }

    class FrackerBuild {
        +float accumulator
        --
        +void updateTile()
    }

    ' ── Processing / Misc ───────────────────────────────────────────────────

    class Separator {
        +ItemStack[] results
        +float craftTime
        +DrawBlock drawer
        +ConsumeItems consItems
        --
        +void setStats()
        +TextureRegion[] icons()
    }

    class SeparatorBuild {
        +float progress
        +float totalProgress
        +float warmup
        +int seed
        --
        +void updateTile()
        +boolean shouldConsume()
        +boolean canDump(Building, Item)
        +double sense(LAccess)
        +void write(Writes)
        +void read(Reads, byte)
    }

    class Incinerator {
        +Effect effect
        +Color flameColor
    }

    class IncineratorBuild {
        +float heat
        --
        +void updateTile()
        +void draw()
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +boolean acceptLiquid(Building, Liquid)
        +void handleLiquid(Building, Liquid, float)
        +BlockStatus status()
    }

    class ItemIncinerator {
        +Effect effect
        +float effectChance
        +TextureRegion liquidRegion
        +TextureRegion topRegion
    }

    class ItemIncineratorBuild {
        --
        +void updateTile()
        +void draw()
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +BlockStatus status()
    }

    class SingleBlockProducer {
        +Block result
        --
        +Block recipe()
    }

    class SingleBlockProducerBuild {
        --
        +Block recipe()
    }

}

' ─── Inheritance: Block → Build ──────────────────────────────────────────────

' Block hierarchy
GenericCrafter --|> Block
AttributeCrafter --|> GenericCrafter
HeatCrafter --|> GenericCrafter

Drill --|> Block
BurstDrill --|> Drill
BeamDrill --|> Block
WallCrafter --|> Block

Pump --|> LiquidBlock
SolidPump --|> Pump
Fracker --|> SolidPump

Separator --|> Block
Incinerator --|> Block
ItemIncinerator --|> Block

SingleBlockProducer --|> BlockProducer

' Build hierarchy
GenericCrafterBuild --|> Building
AttributeCrafterBuild --|> GenericCrafterBuild
HeatCrafterBuild --|> GenericCrafterBuild
HeatCrafterBuild ..|> HeatConsumer

DrillBuild --|> Building
BurstDrillBuild --|> DrillBuild
BeamDrillBuild --|> Building
WallCrafterBuild --|> Building

PumpBuild --|> LiquidBuild
SolidPumpBuild --|> PumpBuild
FrackerBuild --|> SolidPumpBuild

SeparatorBuild --|> Building
IncineratorBuild --|> Building
ItemIncineratorBuild --|> Building

SingleBlockProducerBuild --|> BlockProducerBuild

' ─── Block ↔ Build containment (inner class) ─────────────────────────────────

GenericCrafter +.. GenericCrafterBuild : <<inner>>
AttributeCrafter +.. AttributeCrafterBuild : <<inner>>
HeatCrafter +.. HeatCrafterBuild : <<inner>>

Drill +.. DrillBuild : <<inner>>
BurstDrill +.. BurstDrillBuild : <<inner>>
BeamDrill +.. BeamDrillBuild : <<inner>>
WallCrafter +.. WallCrafterBuild : <<inner>>

Pump +.. PumpBuild : <<inner>>
SolidPump +.. SolidPumpBuild : <<inner>>
Fracker +.. FrackerBuild : <<inner>>

Separator +.. SeparatorBuild : <<inner>>
Incinerator +.. IncineratorBuild : <<inner>>
ItemIncinerator +.. ItemIncineratorBuild : <<inner>>

SingleBlockProducer +.. SingleBlockProducerBuild : <<inner>>

' ─── Composition ─────────────────────────────────────────────────────────────

class DrawBlock <<utility>>

GenericCrafter *-- DrawBlock : drawer
Pump *-- DrawBlock : drawer
Separator *-- DrawBlock : drawer

@enduml
