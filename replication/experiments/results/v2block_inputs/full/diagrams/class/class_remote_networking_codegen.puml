@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam enum {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #212529
}

title Remote Networking Code Generation

package "javax.annotation.processing" {
    abstract class AbstractProcessor {
        +process(annotations: Set, roundEnv: RoundEnvironment): boolean
        +getSupportedAnnotationTypes(): Set<String>
    }
}

package "mindustry.annotations" {
    class BaseProcessor {
        +{static} packageName: String = "mindustry.gen"
        +{static} typeu: Types
        +{static} elementu: Elements
        +{static} filer: Filer
        +{static} messager: Messager
        +{static} trees: Trees
        #round: int
        #rounds: int
        #env: RoundEnvironment
        #rootDirectory: Fi
        --
        +write(builder: TypeSpec.Builder): void
        +write(builder: TypeSpec.Builder, imports: Seq<String>): void
        +elements(type: Class<Annotation>): Seq<Element>
        +types(type: Class<Annotation>): Seq<TypeElement>
        +fields(type: Class<Annotation>): Seq<VariableElement>
        +isPrimitive(type: String): boolean
        +instanceOf(type: String, other: String): boolean
        +getDefault(value: String): String
        +tname(name: String): ClassName
    }
}

package "mindustry.annotations.remote" {
    class RemoteProcess {
        +{static} callLocation: String = "Call"
        --
        +process(roundEnv: RoundEnvironment): boolean
    }

    class CallGenerator {
        +generate(serializer: ClassSerializer, methods: Seq<MethodEntry>): void
        +makeWriter(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer): void
        +makeReader(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer): void
        +writeCallMethod(classBuilder: TypeSpec.Builder, ent: MethodEntry, toAll: boolean, forwarded: boolean): void
        +getCheckString(loc: Loc): String
        +writeHandleMethod(ent: MethodEntry, isClient: boolean): void
    }

    class MethodEntry {
        +className: String
        +targetMethod: String
        +packetClassName: String
        +where: Loc
        +target: Variant
        +local: Loc
        +unreliable: boolean
        +forward: boolean
        +id: int
        +element: Smethod
        +priority: PacketPriority
        --
        +MethodEntry(className: String, targetMethod: String, packetClassName: String,\n  where: Loc, target: Variant, local: Loc, unreliable: boolean, forward: boolean)
        +hashCode(): int
    }

    class SerializerResolver {
        +locate(elem: ExecutableElement, mirror: TypeMirror, write: boolean): String
        +isEntity(mirror: TypeMirror): boolean
    }
}

package "mindustry.annotations.util" {
    class ClassSerializer {
        +writers: ObjectMap<String, String>
        +readers: ObjectMap<String, String>
        +mutatorReaders: ObjectMap<String, String>
        +netWriters: ObjectMap<String, String>
        --
        +ClassSerializer(writers: ObjectMap, readers: ObjectMap,\n  mutatorReaders: ObjectMap, netWriters: ObjectMap)
        +getNetWriter(type: String, fallback: String): String
        +getNetReader(type: String, fallback: String): String
    }

    class TypeIOResolver {
        +{static} resolve(processor: BaseProcessor): ClassSerializer
        +{static} fix(str: String): String
    }
}

package "mindustry.annotations.impl" {
    class AssetsProcess {
        +process(env: RoundEnvironment): boolean
        +processUI(elements: Set<Element>): void
        +processSounds(classname: String, path: String, rtype: String, genid: boolean): void
        +capitalize(s: String): String
    }

    class StructProcess {
        +process(env: RoundEnvironment): boolean
        +bitString(offset: int, size: int, totalSize: int): String
        +varSize(var: Svar): int
        +typeForSize(size: int): String
        +typeSize(kind: TypeKind): int
    }
}

enum Loc {
    server
    client
    both
    none
}

enum Variant {
    one
    all
    both
}

enum PacketPriority {
    low
    normal
    high
}

' Inheritance hierarchy
BaseProcessor     --|> AbstractProcessor
RemoteProcess     --|> BaseProcessor
AssetsProcess     --|> BaseProcessor
StructProcess     --|> BaseProcessor

' RemoteProcess orchestration
RemoteProcess "1" *-- "many" MethodEntry      : creates >
RemoteProcess ..>  TypeIOResolver             : uses (build ClassSerializer)
RemoteProcess ..>  SerializerResolver         : uses (verify params)
RemoteProcess ..>  CallGenerator              : delegates (generate())

' CallGenerator code-gen dependencies
CallGenerator ..>  ClassSerializer            : reads (netWriters/netReaders)
CallGenerator ..>  MethodEntry                : iterates
CallGenerator ..>  SerializerResolver         : resolves serializers

' Utility wiring
TypeIOResolver     ..>  ClassSerializer       : produces >
SerializerResolver ..>  ClassSerializer       : uses (type lookups)

' MethodEntry enum fields
MethodEntry ..> Loc           : where / local
MethodEntry ..> Variant       : target
MethodEntry ..> PacketPriority : priority

@enduml
