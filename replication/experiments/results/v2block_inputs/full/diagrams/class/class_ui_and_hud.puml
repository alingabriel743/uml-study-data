@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title UI and HUD System

' ── External arc framework types ────────────────────────────────────────────
package "arc.scene.ui [external]" {
    class Dialog <<arc>>
    class Table <<arc>>
    class Image <<arc>>
    class Element <<arc>>
}

' ── Core UI manager ─────────────────────────────────────────────────────────
package "mindustry.core" {
    class UI <<ApplicationListener, Loadable>> {
        +MenuFragment menufrag
        +HudFragment hudfrag
        +ChatFragment chatfrag
        +ConsoleFragment consolefrag
        +MinimapFragment minimapfrag
        +PlayerListFragment listfrag
        +LoadingFragment loadfrag
        +HintsFragment hints
        +WidgetGroup menuGroup
        +WidgetGroup hudGroup
        +GameOverDialog restart
        +PausedDialog paused
        +SettingsMenuDialog settings
        +SchematicsDialog schematics
        +ContentInfoDialog content
        --
        +void init()
        +void update()
        +void resize(int w, int h)
        +void loadAnd(Runnable call)
        +void showInfo(String text)
        +void showErrorMessage(String text)
        +void announce(String text, float duration)
    }
}

' ── UI Fragments ────────────────────────────────────────────────────────────
package "mindustry.ui.fragments" {

    class HudFragment {
        +PlacementFragment blockfrag
        +CoreItemsDisplay coreItems
        +boolean shown
        -{static} ObjectSet<String> favoriteBlocks
        -Table hudLabel
        -long lastToast
        --
        +void build(Group parent)
        +void setHudText(String text)
        +void showToast(String text)
        +void showUnlock(UnlockableContent content)
        +void showPauseDisabled()
        +boolean hasToast()
        -{static} void setPlayerTeamEditor(Player player, Team team)
        -void toggleMenus()
        -Table makeStatusTable()
    }

    class PlacementFragment {
        -Category currentCategory
        -ObjectMap<Category,Block> selectedBlocks
        -Displayable hover
        -Table blockTable
        -Table commandTable
        -ScrollPane blockPane
        --
        +void build(Group parent)
        +void rebuild()
        +Displayable hover()
        +Displayable hovered()
        +boolean hasInfoBox()
        +boolean gridUpdate(InputHandler input)
        +Block getSelectedBlock(Category cat)
        +Seq<Category> getCategories()
    }

    class MenuFragment {
        -Table container
        -Table submenu
        -Button currentMenu
        -MenuRenderer renderer
        -Seq<MenuButton> customButtons
        -Seq<MenuButton> desktopButtons
        --
        +void build(Group parent)
        +void buildMobile()
        +void buildDesktop()
        +void addButton(String text, Drawable icon, Runnable cb)
        -void fadeInMenu()
        -void fadeOutMenu()
    }

    class MenuButton <<inner>> {
        +Drawable icon
        +String text
        +Runnable runnable
        +Seq<MenuButton> submenu
    }

    class BlockInventoryFragment {
        -Building build
        -float holdTime
        -boolean holding
        -Item lastItem
        --
        +void build(Group parent)
        +void showFor(Building t)
        +void hide()
        -void takeItem(int requested)
        -void rebuild(boolean actions)
    }

    class BlockConfigFragment {
        --
        +void build(Group parent)
        +void showConfig(Building tile)
        +boolean isShown()
        +void forceHide()
        +void hideConfig()
    }

    class PlanConfigFragment {
        --
        +void build(Group parent)
        +void showConfig(BuildPlan plan)
        +void forceHide()
        +void hide()
    }

    class ChatFragment {
        --
        +void build(Group parent)
        +boolean shown()
        +void toggle()
        +void hide()
    }

    class ConsoleFragment {
        --
        +void build(Group parent)
        +void toggleMobile()
        +boolean shown()
    }

    class MinimapFragment {
        --
        +void build(Group parent)
        +void panTo(float relX, float relY)
        +boolean shown()
        +void toggle()
        +void hide()
    }

    class PlayerListFragment {
        -Table content
        --
        +void build(Group parent)
        +void rebuild()
        +void toggle()
    }

    class HintsFragment {
        --
        +void build(Group parent)
    }

    class LoadingFragment {
        --
        +void build(Group parent)
        +void show()
        +void show(String text)
        +void hide()
    }

    class FadeInFragment {
        --
        +void build(Group parent)
    }
}

' ── UI Dialogs ──────────────────────────────────────────────────────────────
package "mindustry.ui.dialogs" {

    class BaseDialog {
        #boolean wasPaused
        +boolean shouldPause
        --
        +BaseDialog(String title)
        +void addCloseButton()
        +void onResize(Runnable run)
        +void makeButtonOverlay()
        +void addCloseListener()
    }

    class PausedDialog {
        --
        +boolean checkPlaytest()
        +void runExitSave()
    }

    class GameOverDialog {
        --
        +void show(Team winner)
    }

    class SettingsMenuDialog {
    }

    class ContentInfoDialog {
    }

    class SchematicsDialog {
    }

    abstract class Setting <<inner abstract>> {
        +{abstract} void add(SettingsTable table)
    }

    class CheckSetting <<inner>> {
    }

    class SliderSetting <<inner>> {
    }

    class SettingsTable <<inner>> {
    }

    class StatLabel <<inner>> {
    }

    class SchematicImage <<inner>> {
    }
}

' ── UI Widgets ──────────────────────────────────────────────────────────────
package "mindustry.ui" {

    interface Displayable {
        +{default} boolean displayable()
        +void display(Table table)
    }

    class CoreItemsDisplay {
    }

    class Minimap {
    }
}

' ── Inheritance: arc framework → dialogs ────────────────────────────────────
Dialog <|-- BaseDialog
BaseDialog <|-- PausedDialog
BaseDialog <|-- GameOverDialog
BaseDialog <|-- SettingsMenuDialog
BaseDialog <|-- ContentInfoDialog
BaseDialog <|-- SchematicsDialog

' ── Inheritance: arc framework → fragments / widgets ────────────────────────
Table <|-- ChatFragment
Table <|-- ConsoleFragment
Table <|-- CoreItemsDisplay
Table <|-- SettingsTable
Table <|-- StatLabel
Element <|-- Minimap
Image <|-- SchematicImage

' ── Inheritance: Setting hierarchy ──────────────────────────────────────────
Setting <|-- CheckSetting
Setting <|-- SliderSetting

' ── Composition: UI → fragments ─────────────────────────────────────────────
UI *-- HudFragment        : hudfrag
UI *-- MenuFragment       : menufrag
UI *-- ChatFragment       : chatfrag
UI *-- ConsoleFragment    : consolefrag
UI *-- MinimapFragment    : minimapfrag
UI *-- PlayerListFragment : listfrag
UI *-- LoadingFragment    : loadfrag
UI *-- HintsFragment      : hints

' ── Composition: UI → dialogs ───────────────────────────────────────────────
UI *-- PausedDialog       : paused
UI *-- GameOverDialog     : restart
UI *-- SettingsMenuDialog : settings
UI *-- ContentInfoDialog  : content
UI *-- SchematicsDialog   : schematics

' ── Composition: HudFragment → sub-components ───────────────────────────────
HudFragment *-- PlacementFragment : blockfrag
HudFragment *-- CoreItemsDisplay  : coreItems

' ── Nesting: MenuFragment inner class ───────────────────────────────────────
MenuFragment +-- MenuButton
MenuButton   o-- MenuButton : submenu

' ── Nesting: SettingsMenuDialog inner classes ────────────────────────────────
SettingsMenuDialog +-- Setting
SettingsMenuDialog +-- SettingsTable

' ── Nesting: GameOverDialog & SchematicsDialog inner classes ─────────────────
GameOverDialog +-- StatLabel
SchematicsDialog +-- SchematicImage

' ── Dependencies ─────────────────────────────────────────────────────────────
PlacementFragment    ..> Displayable          : hover result
BlockInventoryFragment ..> Building           : showFor()
BlockConfigFragment  ..> Building             : showConfig()

note bottom of UI
  <b>menuGroup</b> (visible in menu state):
    MenuFragment
  <b>hudGroup</b> (visible in game state):
    HudFragment, ChatFragment,
    MinimapFragment, PlayerListFragment,
    ConsoleFragment
  <b>Core.scene root</b>: LoadingFragment, FadeInFragment
end note

@enduml
