@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Unit Types and Weapons

package "mindustry.ctype" {
    abstract class UnlockableContent {
        +Stats stats
        +String localizedName
        +String description
        +boolean alwaysUnlocked
        +TextureRegion uiIcon
        +TextureRegion fullIcon
        +void init()
        +void setStats()
        +boolean isHidden()
        +void getDependencies(Cons<UnlockableContent>)
    }
}

package "mindustry.type" {
    class UnitType {
        +float speed
        +float health
        +float armor
        +float range
        +float hitSize
        +boolean flying
        +boolean canBoost
        +boolean targetAir
        +boolean targetGround
        +boolean omniMovement
        +boolean logicControllable
        +boolean playerControllable
        +int envRequired
        +int envEnabled
        +int envDisabled
        +float payloadCapacity
        +float buildSpeed
        +Prov<UnitController> aiController
        +Func<Unit,UnitController> controller
        +Prov<Unit> constructor
        +Seq<Ability> abilities
        +Seq<Weapon> weapons
        +ObjectSet<StatusEffect> immunities
        +Seq<DrawPart> parts
        +Seq<UnitEngine> engines
        +Seq<UnitCommand> commands
        +UnitType segmentUnit
        +UnitType segmentEndUnit
        +int itemCapacity
        +int mineTier
        +UnitController createController(Unit unit)
        +Unit create(Team team)
        +Unit spawn(Team team, float x, float y, float rotation)
        +boolean hasWeapons()
        +boolean targetable(Unit unit, Team targeter)
        +boolean killable(Unit unit)
        +boolean hittable(Unit unit)
        +boolean supportsEnv(int env)
        +void update(Unit unit)
        +void setStats()
        +void getDependencies(Cons<UnlockableContent>)
    }

    class Weapon {
        +String name
        +BulletType bullet
        +boolean mirror
        +boolean alternate
        +boolean rotate
        +boolean continuous
        +boolean controllable
        +boolean aiControllable
        +boolean autoTarget
        +boolean alwaysShooting
        +boolean noAttack
        +float reload
        +float inaccuracy
        +float recoil
        +float x
        +float y
        +float rotateSpeed
        +float shootCone
        +float baseRotation
        +ShootPattern shoot
        +StatusEffect shootStatus
        +Func<Weapon,WeaponMount> mountType
        +Sound shootSound
        +void update(Unit unit, WeaponMount mount)
        +void draw(Unit unit, WeaponMount mount)
        +float dps()
        +float shotsPerSec()
        +float range()
        +void flip()
        +Weapon copy()
        +void init()
        +void load()
        #void shoot(Unit unit, WeaponMount mount, float x, float y, float rotation)
        #void bullet(Unit unit, WeaponMount mount, float xOff, float yOff, float angle, Mover mover)
        #Teamc findTarget(Unit unit, float x, float y, float range, boolean air, boolean ground)
        #boolean checkTarget(Unit unit, Teamc target, float x, float y, float range)
    }

    class StatusEffect {
        +float damageMultiplier
        +float healthMultiplier
        +float speedMultiplier
        +float reloadMultiplier
        +float buildSpeedMultiplier
        +float dragMultiplier
        +boolean disarm
        +boolean permanent
        +boolean reactive
        +float damage
        +float intervalDamage
        +Color color
        +Effect effect
        +Effect applyEffect
        +ObjectSet<StatusEffect> affinities
        +ObjectSet<StatusEffect> opposites
        +ObjectMap<StatusEffect,TransitionHandler> transitions
    }
}

package "mindustry.type.unit" {
    class ErekirUnitType {
        ' outlineColor = Pal.darkOutline
        ' envDisabled = Env.space
        ' researchCostMultiplier = 10
    }

    class TankUnitType {
        ' squareShape = true
        ' omniMovement = false
        ' rotateMoveFirst = true
        ' envDisabled = Env.none
    }

    class MissileUnitType {
        ' flying = true
        ' playerControllable = false
        ' logicControllable = false
        ' controller = MissileAI
        ' hidden = true
    }

    class NeoplasmUnitType {
        ' drawCell = false
        ' immune to burning/melting
        ' pre-adds: RegenAbility,
        '   LiquidExplodeAbility,
        '   LiquidRegenAbility
    }
}

package "mindustry.type.weapons" {
    class BuildWeapon {
        ' Visual-only weapon
        ' rotate = true
        ' noAttack = true
        ' predictTarget = false
        +void update(Unit unit, WeaponMount mount)
        +void draw(Unit unit, WeaponMount mount)
    }

    class RepairBeamWeapon {
        +boolean targetBuildings
        +boolean targetUnits
        +float repairSpeed
        +float fractionRepairSpeed
        +float beamWidth
        +float pulseRadius
        ' autoTarget = true
        ' controllable = false
        ' noAttack = true
        +void update(Unit unit, WeaponMount mount)
        +void draw(Unit unit, WeaponMount mount)
        +float dps()
        +void init()
        #Teamc findTarget(Unit unit, float x, float y, float range, boolean air, boolean ground)
        #boolean checkTarget(Unit unit, Teamc target, float x, float y, float range)
    }
}

package "mindustry.entities.units" {
    class WeaponMount {
        +Weapon weapon
        +float reload
        +float rotation
        +float recoil
        +float heat
        +float warmup
        +float charge
        +float smoothReload
        +float aimX
        +float aimY
        +float targetRotation
        +boolean shoot
        +boolean rotate
        +boolean charging
        +boolean side
        +int totalShots
        +int barrelCounter
        +Bullet bullet
        +Teamc target
        +SoundLoop sound
        +float[] recoils
        +WeaponMount(Weapon weapon)
    }

    class HealBeamMount {
        +Vec2 offset
        +Vec2 lastEnd
        +float strength
        +float effectTimer
    }

    interface UnitController {
        +void unit(Unit unit)
        +Unit unit()
        +void hit(Bullet bullet)
        +boolean isValidController()
        +boolean isLogicControllable()
        +void updateUnit()
        +void removed(Unit unit)
        +void afterRead(Unit unit)
    }
}

package "mindustry.entities.abilities" {
    abstract class Ability {
        +boolean display
        +float data
        +void update(Unit unit)
        +void draw(Unit unit)
        +void death(Unit unit)
        +void created(Unit unit)
        +void init(UnitType type)
        +void displayBars(Unit unit, Table bars)
        +void addStats(Table t)
        +Ability copy()
        +String localized()
    }

    class RegenAbility {
        +float percentAmount
        +float amount
        ' heals: maxHealth * percentAmount/100 + amount per tick
    }

    class LiquidExplodeAbility {
    }

    class LiquidRegenAbility {
    }

    class EnergyFieldAbility {
    }

    class ArmorPlateAbility {
    }

    class UnitSpawnAbility {
    }

    class StatusFieldAbility {
    }

    class SuppressionFieldAbility {
    }

    class MoveEffectAbility {
    }

    class ShieldRegenFieldAbility {
    }
}

' ── Inheritance ──────────────────────────────────────────────
UnlockableContent <|-- UnitType
UnlockableContent <|-- StatusEffect

UnitType <|-- ErekirUnitType
ErekirUnitType <|-- TankUnitType
UnitType <|-- MissileUnitType
UnitType <|-- NeoplasmUnitType

Weapon <|-- BuildWeapon
Weapon <|-- RepairBeamWeapon

WeaponMount <|-- HealBeamMount

Ability <|-- RegenAbility
Ability <|-- LiquidExplodeAbility
Ability <|-- LiquidRegenAbility
Ability <|-- EnergyFieldAbility
Ability <|-- ArmorPlateAbility
Ability <|-- UnitSpawnAbility
Ability <|-- StatusFieldAbility
Ability <|-- SuppressionFieldAbility
Ability <|-- MoveEffectAbility
Ability <|-- ShieldRegenFieldAbility

' ── Interfaces ───────────────────────────────────────────────
UnitType ..|> "Senseable"

' ── Composition / Aggregation ────────────────────────────────
UnitType "1" *-- "many" Weapon : weapons
UnitType "1" *-- "many" Ability : abilities
UnitType "1" o-- "many" StatusEffect : immunities

' ── Dependencies / Associations ──────────────────────────────
UnitType ..> UnitController : creates via aiController / controller
Weapon "1" o-- "1" WeaponMount : creates via mountType factory
WeaponMount "many" --> "1" Weapon : weapon (final ref)
Weapon ..> StatusEffect : shootStatus applied on fire
RepairBeamWeapon ..> HealBeamMount : mountType = HealBeamMount::new

@enduml
