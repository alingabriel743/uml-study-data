@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title World and Block System

package "mindustry.core" {

    class World {
        -Tiles tiles
        -int tileChanges
        -int floorChanges
        -boolean generating
        -boolean invalidMap
        --
        +tile(int x, int y): Tile
        +tile(int pos): Tile
        +rawTile(int x, int y): Tile
        +tileWorld(float x, float y): Tile
        +build(int x, int y): Building
        +build(int pos): Building
        +buildWorld(float x, float y): Building
        +floor(int x, int y): Floor
        +solid(int x, int y): boolean
        +passable(int x, int y): boolean
        +width(): int
        +height(): int
        +resize(int width, int height): Tiles
        +beginMapLoad(): void
        +endMapLoad(): void
        +loadMap(Map): void
        +loadSector(Sector): void
        +isGenerating(): boolean
        +clearBuildings(): void
        +addDarkness(Tiles): void
        +getDarkness(int x, int y): float
        +{static} raycastEach(int, int, int, int, Raycaster): void
        +filterContext(Map): Context
    }

    class "World.Context" as WorldContext_Impl {
        <<inner class>>
    }

    class "World.FilterContext" as WorldFilterContext {
        <<inner class>>
    }

    interface WorldContext {
        <<interface>>
    }
}

package "mindustry.world" {

    class Tiles {
        +int width
        +int height
        -Tile[] array
        -Puddle[] puddles
        -Fire[] fires
        --
        +get(int x, int y): Tile
        +getn(int x, int y): Tile
        +geti(int index): Tile
        +set(int x, int y, Tile): void
        +in(int x, int y): boolean
        +getPuddle(int pos): Puddle
        +getFire(int pos): Fire
    }

    class Tile {
        +@Nullable Building build
        +short x
        +short y
        #Block block
        #Floor floor
        #Floor overlay
        +byte data
        +byte floorData
        +byte overlayData
        +int extraData
        --
        +Tile(int x, int y)
        +Tile(int x, int y, Block floor, Block overlay, Block wall)
        +block(): Block
        +floor(): Floor
        +overlay(): Floor
        +team(): Team
        +isCenter(): boolean
        +setBlock(Block type, Team team, int rotation): void
        +setBlock(Block type, Team team): void
        +setBlock(Block type): void
        +setFloor(Floor type): void
        +setOverlay(Block block): void
        +setAir(): void
        +remove(): void
        +setNet(Block, Team, int): void
        +setFloorNet(Block, Block): void
        +nearby(int rotation): Tile
        +nearbyBuild(int rotation): Building
        +getLinkedTiles(Cons<Tile>): void
        +solid(): boolean
        +passable(): boolean
        +breakable(): boolean
        +dangerous(): boolean
        +pos(): int
        +worldx(): float
        +worldy(): float
        #changeBuild(Team, Prov<Building>, int): void
        #changed(): void
        #preChanged(): void
    }

    class CachedTile {
        <<no-event tile>>
        ..
        Suppresses change events.
        Used for map previews/loading.
        --
        #preChanged(): void
        #changeBuild(Team, Prov<Building>, int): void
    }

    class Block {
        +boolean hasItems
        +boolean hasLiquids
        +boolean hasPower
        +boolean update
        +boolean solid
        +boolean destructible
        +boolean breakable
        +boolean rotate
        +boolean configurable
        +boolean sync
        +int size
        +int sizeOffset
        +float offset
        +int health
        +float scaledHealth
        +float armor
        +int itemCapacity
        +float liquidCapacity
        +boolean outputsLiquid
        +boolean outputsPower
        +boolean consumesPower
        +boolean saveData
        +CacheLayer cacheLayer
        +boolean fillsTile
        +BlockGroup group
        +EnumSet<BlockFlag> flags
        +@Nullable Item itemDrop
        +int fogRadius
        --
        +hasBuilding(): boolean
        +newBuilding(): Building
        +isMultiblock(): boolean
        +isStatic(): boolean
        +synthetic(): boolean
        +asFloor(): Floor
        +blockChanged(Tile): void
        +isDarkened(Tile): boolean
        +canReplace(Block): boolean
    }
}

package "mindustry.world.blocks.environment" {

    class Floor {
        +float speedMultiplier
        +float dragMultiplier
        +float damageTaken
        +float drownTime
        +Effect walkEffect
        +Sound walkSound
        +StatusEffect status
        +@Nullable Liquid liquidDrop
        +float liquidMultiplier
        +boolean isLiquid
        +boolean supportsOverlay
        +Block blendGroup
        +boolean oreDefault
        +Block wall
        +Block decoration
        +boolean wallOre
        +@Nullable Item itemDrop
        --
        +Floor(String name, int variants)
        +isDeep(): boolean
        +damages(): boolean
        +getColor(Tile): Color
        +floorChanged(Tile): void
    }

    class OverlayFloor {
    }
}

package "mindustry.gen" {

    class Building {
        <<generated from BuildingComp>>
        +transient Tile tile
        +transient Block block
        +Team team
        +float health
        +float maxHealth
        +transient Seq<Building> proximity
        +transient int rotation
        +transient boolean enabled
        +@Nullable PowerModule power
        +@Nullable ItemModule items
        +@Nullable LiquidModule liquids
        +transient float efficiency
        +transient float potentialEfficiency
        +transient boolean sleeping
        --
        +init(Tile, Team, boolean, int): Building
        +{static} create(Block block, Team team): Building
        +add(): void
        +remove(): void
        +updateProximity(): void
        +onProximityUpdate(): void
        +onRemoved(): void
        +removeFromProximity(): void
        +changeTeam(Team): void
        +killed(): void
        +tileX(): int
        +tileY(): int
        +pos(): int
    }
}

package "mindustry.content (external)" {
    abstract class UnlockableContent {
        <<abstract>>
    }
}

' ─── Inheritance ───────────────────────────────────────────────────────────────
Block --|> UnlockableContent
Floor --|> Block
OverlayFloor --|> Floor
CachedTile --|> Tile

' ─── Interface implementations ─────────────────────────────────────────────────
Tiles ..|> "Iterable<Tile>"
Tile ..|> Position
Tile ..|> QuadTreeObject
Tile ..|> Displayable

' ─── World inner classes ───────────────────────────────────────────────────────
WorldContext_Impl ..|> WorldContext
WorldFilterContext --|> WorldContext_Impl
World +-- WorldContext_Impl
World +-- WorldFilterContext

' ─── Composition / Association ─────────────────────────────────────────────────
World *-- Tiles : tiles
Tiles *-- Tile : array[]
Tile o-- Block : wall block
Tile o-- Floor : floor
Tile o-- Floor : overlay
Tile o--> Building : build (nullable)
Building --> Tile : tile
Building --> Block : block
Block ..> Building : <<creates>>\nnewBuilding()

@enduml
