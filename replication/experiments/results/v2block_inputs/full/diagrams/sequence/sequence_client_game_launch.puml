@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    GroupBackgroundColor #DEE2E6
    GroupBorderColor #6C757D
    GroupFontColor #212529
    DividerBackgroundColor #CED4DA
    DividerBorderColor #6C757D
    NoteBackgroundColor #FFF3CD
    NoteBorderColor #FFC107
}

title Client Game Launch and Initialization

actor Application as app
participant "ClientLauncher" as launcher
participant "LoadRenderer" as loadRenderer
participant "AssetManager" as assets
participant "Events" as events
participant "Logic" as logic
participant "Control" as control
participant "Renderer" as renderer
participant "UI" as ui
participant "NetServer" as netServer
participant "NetClient" as netClient
participant "AsyncCore" as asyncCore

== Startup ==

app -> launcher : init()
activate launcher

launcher -> launcher : setup()
note right : checkLaunch(); loadLogger();\nloadFileLogger()

launcher -> loadRenderer ** : new LoadRenderer()
note right : Renders loading screen\nat fixed 20 FPS

launcher -> events : fire(ClientCreateEvent)

launcher -> ui : loadColors()  [static]
note right : Sets accent/stat\npalette colors

launcher -> assets ** : new AssetManager()
launcher -> assets : setLoader(Texture, MapPreviewLoader)
launcher -> assets : setLoader(Sound, async SoundLoader)
launcher -> assets : setLoader(Music, async MusicLoader)

note over launcher : Create core globals:\nNet, Mods, Schematics

launcher -> assets : assets.load(new Vars())

== Asset Registration Phase ==

group Asset Loading Queue (registered in order)
    launcher -> assets : load sprites atlas\n(or fallback)
    launcher -> assets : loadRun('maps') → maps.loadPreviews()
    launcher -> assets : Musics.load(); Sounds.load()
    launcher -> assets : loadRun('contentcreate')\n→ content.createBaseContent(),\nloadColors(), mods.loadScripts(),\ncontent.createModContent()
    launcher -> assets : load(mods)
    launcher -> assets : loadRun('mergeUI')\n→ Fonts.mergeFontAtlas(atlas)
end

== Module Creation ==

launcher -> logic ** : new Logic()
launcher -> assets : assets.load(logic as Loadable)
activate logic

launcher -> control ** : new Control()
activate control
note right of control : Constructor registers\n~12 event handlers:\nClientLoadEvent,\nPlayEvent,\nWorldLoadEvent, etc.
control -> control : new Saves()
control -> control : new SoundControl()
control -> control : new AttackIndicators()
launcher -> assets : assets.load(control as Loadable)

launcher -> renderer ** : new Renderer()
launcher -> assets : assets.load(renderer as Loadable)
activate renderer

launcher -> ui ** : new UI()
note right of ui : Constructor calls\nFonts.loadFonts()
launcher -> assets : assets.load(ui as Loadable)
activate ui

launcher -> netServer ** : new NetServer()
launcher -> netClient ** : new NetClient()

launcher -> assets : load(schematics)
launcher -> assets : loadRun('contentinit')\n→ content.init(), content.load()
launcher -> assets : loadRun('baseparts')\n→ bases.load()

== Loading Loop ==

loop !finished (each frame)
    app -> launcher : update()

    launcher -> loadRenderer : loader.draw()
    note right : Renders loading screen

    launcher -> assets : assets.update(1000/20)
    note right : Incremental asset\nloading per frame

    group Control Asset Loading
        assets -> control : loadAsync()\n→ Draw.scl = 1/scale;\ninput.setCatch(back, true);\nsettings.defaults(...);\nsaves.load()
        assets -> control : loadSync()\n→ createPlayer()
        control -> control : player = Player.create()\nset name/locale/color
        control -> control : input = new MobileInput()\n  OR DesktopInput()
    end

    group UI Asset Loading (waits for Control + Fonts)
        assets -> ui : getDependencies()\n→ [Control.class, 'outline' Font,\n'default' Font, Mods.class]
        assets -> ui : loadAsync()  [no-op]
        assets -> ui : loadSync()\n→ Core.scene = new Scene();\nTex.load(); Icon.load();\nStyles.load(); Fonts.loadContentIcons();\ncreate all cursors
    end

end

== Post-Load Initialization ==

note over launcher : assets.update() returns true:\nall assets loaded

launcher -> loadRenderer : loader.dispose(); loader = null
destroy loadRenderer

launcher -> launcher : SoundPriority.init()

group Module init() — in registration order
    launcher -> logic   : listener.init()
    launcher -> control : listener.init()\n→ platform.updateRPC();\nshows uiscale-reset dialog if needed
    launcher -> renderer : listener.init()
    launcher -> ui      : listener.init()\n→ set bundle strings;\ncreate menuGroup + hudGroup;\ninstantiate all Fragments\n(MenuFragment, HudFragment,\nChatFragment, MinimapFragment, …);\ninstantiate all Dialogs\n(SettingsMenuDialog, HostDialog,\nPausedDialog, PlanetDialog, …);\nadd groups to Core.scene;\nbuild all fragments
end

launcher -> launcher : mods.eachClass(Mod::init)

launcher -> launcher : finished = true;\nclientLoaded = true

launcher -> events : fire(ClientLoadEvent)
activate events
events -> control : (ClientLoadEvent handler)\n→ checkAutoUnlocks();\ninput.add()
deactivate events

note over launcher : Log "Total time to load: @ms"

launcher -> launcher : app.post() ×4 → finishLaunch()
note right : 4-frame delay before\nfinishLaunch() is called

deactivate launcher

== Game Loop Active ==

loop Each frame (finished = true)
    app -> launcher : update()
    activate launcher

    launcher -> asyncCore : asyncCore.begin()
    launcher -> launcher : super.update()\n→ all modules update()
    note right of launcher : Control: saves.update(),\nassets.update(),\ninput.updateState(),\nsound.update()\nUI: scene.act(),\nscene.draw()
    launcher -> asyncCore : asyncCore.end()

    deactivate launcher
end

@enduml
