@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequenceArrowThickness 1.5
skinparam sequenceGroupBorderColor #6C757D
skinparam sequenceGroupBackgroundColor #E9ECEF
skinparam sequenceLifeLineBorderColor #495057
skinparam sequenceActiveBorderColor #495057
skinparam noteBackgroundColor #FFF9E6
skinparam noteBorderColor #CCA300

title Combat: Bullet Lifecycle and Damage

participant "Weapon/Turret" as weapon
participant "BulletType" as btype
participant "Bullet\n(BulletComp)" as bullet
participant "GameLoop" as gameloop
participant "EntityCollisions" as ecoll
participant "Damage" as damage
participant "Healthc\n(Unit/Building)" as health
participant "Effect" as effect
participant "Events" as events

== Spawn Phase ==

weapon -> btype : create(shooter, x, y, angle, velocityScl, lifeScl)
activate btype

btype -> bullet : obtain from pool
activate bullet
note right of bullet : set team, owner, type,\nvel, lifetime, justSpawned=true

bullet -> btype : init(self)  [via BulletComp.add()]

alt spawnBullets configured
    btype -> btype : create spawnBullets(...)
end

alt killShooter = true
    btype -> weapon : remove shooter
end

deactivate btype

== Per-Frame Update Phase ==

gameloop -> bullet : update()
activate bullet

note right of bullet : skip movement on first frame\n(justSpawned flag)

bullet -> bullet : x += vel.x * delta\ny += vel.y * delta

alt mover != null
    bullet -> bullet : mover.move(self)
end

bullet -> btype : update(self)
activate btype
btype -> btype : updateTrail()
btype -> btype : updateHoming()
btype -> btype : updateWeaving()
btype -> btype : updateBulletInterval()
deactivate btype

== Tile Collision (Bresenham Raycast) ==

alt collidesTiles = true
    bullet -> bullet : tileRaycast(lastX, lastY, tileX, tileY)
    activate bullet

    bullet -> health : build.collision(bullet)
    health --> bullet : boolean (hit?)

    alt tile hit
        bullet -> btype : hitTile(bullet, build, x, y, initialHealth, direct=true)
        activate btype

        alt enemy direct hit
            btype -> btype : hit(b)
        else ally tile
            btype -> health : heal(amount)
        end

        btype -> btype : handlePierce(b, initialHealth, x, y)
        deactivate btype

        alt !pierceBuilding
            bullet -> bullet : hit=true; remove()
        end
    end
    deactivate bullet
end

deactivate bullet

== Entity Collision (QuadTree AABB) ==

gameloop -> ecoll : updatePhysics(EntityGroup)\n[rebuild QuadTree]
gameloop -> ecoll : collide(EntityGroup)
activate ecoll

ecoll -> ecoll : updateCollision(solid)
ecoll -> bullet : solid.getCollisions(treeCons)\n[enemy quad trees]
bullet --> ecoll : enemy EntityGroup trees

ecoll -> ecoll : checkCollide(bullet, entity)
activate ecoll

ecoll -> bullet : a.collides(b) && b.collides(a)
bullet --> ecoll : boolean

alt collision confirmed
    ecoll -> bullet : bullet.collision(entity, hitX, hitY)
    activate bullet

    == Hit Processing ==

    bullet -> btype : hit(self, x, y)
    activate btype
    note right of btype : Visual & audio effects,\nfrags, splash, incendiary

    btype -> effect : hitEffect.at(x, y, rotation, hitColor)
    activate effect
    effect -> effect : create(x, y, rotation, color, data)
    effect -> effect : check camera bounds & shouldCreate()
    effect -> effect : add EffectState to entity group
    deactivate effect

    btype -> btype : Sound.hitSound.at(x, y, pitch, volume)
    btype -> effect : Effect.shake(hitShake, hitShake, bullet)

    alt fragOnHit
        btype -> btype : createFrags(b, x, y)
    end

    alt splashDamageRadius > 0
        btype -> damage : createSplashDamage(b, x, y)
        activate damage
        damage -> health : unit.damage(splashAmount)\n[for each unit in radius]
        damage -> events : fire(UnitDamageEvent(unit, source))
        damage -> health : unit.controller().hit(source)
        deactivate damage
    end

    alt incendiary
        btype -> damage : createIncend(b, x, y)
    end

    deactivate btype

    == Direct Entity Damage ==

    bullet -> btype : hitEntity(self, entity, entity.health)
    activate btype

    alt pierceDamageFactor set
        btype -> health : h.damagePierce(dmg)
    else armorMultiplier set
        btype -> health : h.damageArmorMult(dmg, armorMult)
    else
        btype -> health : h.damage(dmg)
    end

    health --> btype : health after damage

    alt unit target
        btype -> health : unit.impulse(knockback vec)
        btype -> health : unit.apply(status, statusDuration)
    end

    btype -> events : fire(UnitDamageEvent(unit, bullet))

    alt unit.dead after hit
        btype -> events : fire(UnitBulletDestroyEvent)
    end

    alt pierce configured
        btype -> btype : handlePierce(b, prevHealth, x, y)
        activate btype
        btype -> bullet : b.damage -= sub
        alt damage <= 0 && removeAfterPierce
            btype -> bullet : b.remove()
        end
        deactivate btype
    end

    deactivate btype

    alt !pierce
        bullet -> bullet : hit=true; remove()
    else
        bullet -> bullet : collided.add(entity.id)
    end

    deactivate bullet
end

deactivate ecoll
deactivate ecoll

== Despawn Phase ==

bullet -> btype : despawned(self)  [if !hit — timeout/external kill]
activate btype

alt despawnHit = true
    btype -> btype : hit(b)
end

btype -> effect : despawnEffect.at(x, y, rotation, hitColor)

deactivate btype

bullet -> btype : removed(self)  [always called]
activate btype

alt fragOnDespawn && frags == 0
    btype -> btype : createFrags(b)
end

deactivate btype

bullet -> bullet : collided.clear()
note right of bullet : Bullet returned to object pool

deactivate bullet

@enduml
