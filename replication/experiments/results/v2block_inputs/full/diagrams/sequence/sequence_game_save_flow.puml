@startuml

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #6C757D
    ActivationBorderColor #495057
    ActivationBackgroundColor #E9ECEF
    GroupBackgroundColor #DEE2E6
    GroupBorderColor #6C757D
    GroupHeaderFontColor #212529
    DividerBackgroundColor #E9ECEF
    DividerBorderColor #6C757D
    NoteBackgroundColor #FFF3CD
    NoteBorderColor #FFC107
}

title Game Save Flow

actor "Player / UI" as Player
participant "Saves" as Saves
participant "SaveSlot" as SaveSlot
participant "SaveIO" as SaveIO
participant "SaveVersion\n(Save11)" as SaveVersion
participant "JsonIO" as JsonIO
participant "World" as World
participant "Building" as Building
participant "Events" as Events

== Save Trigger ==

alt Manual Save
    Player -> Saves : saveSector(sector) / addSave(name)
    activate Saves
    Saves -> SaveSlot ** : new SaveSlot(file)
    note right of Saves : creates new slot if\nsector.save == null
else Autosave
    note over Saves : update() called each tick\ntime > saveInterval * 60
    Saves -> SaveSlot : current.save()
    activate SaveSlot
end

Saves -> SaveSlot : save()
activate SaveSlot

== Backup & Stream Setup ==

SaveSlot -> SaveIO : save(file)  [static]
activate SaveIO

SaveIO -> SaveIO : file.moveTo(backupFileFor(file))
note right of SaveIO : backup existing save\nbefore overwriting

SaveIO -> Events : fire(SaveWriteEvent)
activate Events
Events --> SaveIO : (listeners notified)
deactivate Events

SaveIO -> SaveIO : new FastDeflaterOutputStream\n(file.write(false, bufferSize))
SaveIO -> SaveIO : new DataOutputStream(deflaterStream)

== File Header ==

SaveIO -> SaveVersion : versionArray.peek()
activate SaveVersion
SaveVersion --> SaveIO : ver = Save11 (version=11)
deactivate SaveVersion

SaveIO -> SaveIO : stream.write("MSAV")  [4-byte magic header]
SaveIO -> SaveIO : stream.writeInt(11)   [version number]

== Serialization ==

SaveIO -> SaveVersion : ver.write(stream, tags)
activate SaveVersion

group Region: "meta"
    SaveVersion -> SaveVersion : writeRegion("meta", stream, writeMeta)
    SaveVersion -> JsonIO : write(state.rules)
    activate JsonIO
    JsonIO --> SaveVersion : rulesJson (String)
    deactivate JsonIO
    SaveVersion -> JsonIO : write(state.stats)
    activate JsonIO
    JsonIO --> SaveVersion : statsJson (String)
    deactivate JsonIO
    SaveVersion -> SaveVersion : writeStringMap(stream, metaTags)\n[timestamp, wave, build, mapname,\n rules, stats, mods, viewpos, ...]
end

group Region: "content"
    SaveVersion -> SaveVersion : writeRegion("content", stream, writeContentHeader)\n[content type ID remapping table]
end

group Region: "patches"
    SaveVersion -> SaveVersion : writeRegion("patches", stream, writeContentPatches)\n[content patches — v11+]
end

group Region: "map"
    SaveVersion -> SaveVersion : writeRegion("map", stream, writeMap)
    SaveVersion -> World : width(), height()
    activate World
    World --> SaveVersion : (map dimensions)
    deactivate World
    loop for each tile in world
        SaveVersion -> World : tile.floorID, overlayID, blockID
        activate World
        World --> SaveVersion : (RLE-compressed shorts)
        deactivate World
        opt tile has a Building entity
            SaveVersion -> Building : tile.build.writeAll(stream)
            activate Building
            Building --> SaveVersion : (building entity data written)
            deactivate Building
        end
    end
end

group Region: "entities"
    SaveVersion -> SaveVersion : writeRegion("entities", stream, writeEntities)\n[unit + game entities]
end

group Region: "markers"
    SaveVersion -> SaveVersion : writeRegion("markers", stream, writeMarkers)\n[map markers — v8+]
end

group Region: "custom"
    SaveVersion -> SaveVersion : writeRegion("custom", stream, writeCustomChunks)\n[mod-registered custom data]
end

SaveVersion --> SaveIO : (serialization complete)
deactivate SaveVersion

== Finalise ==

SaveIO -> SaveIO : stream.close()  [flush & close DEFLATE stream]
SaveIO --> SaveSlot : (save written successfully)
deactivate SaveIO

SaveSlot -> SaveIO : getMeta(file)  [read metadata back]
activate SaveIO
SaveIO --> SaveSlot : metaTags (name, timestamp, wave, …)
deactivate SaveIO

SaveSlot -> SaveSlot : savePreview()
note right of SaveSlot : async: renderer.minimap\n.getPixmap() → PNG file

deactivate SaveSlot
Saves --> Player : save complete
deactivate Saves

@enduml
