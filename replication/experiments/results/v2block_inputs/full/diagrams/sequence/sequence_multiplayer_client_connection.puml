@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequenceArrowColor #495057
skinparam sequenceLifeLineBorderColor #6C757D
skinparam sequenceGroupBorderColor #868E96
skinparam sequenceGroupBackgroundColor #E9ECEF
skinparam sequenceGroupFontColor #212529
skinparam sequenceMessageAlign left
skinparam noteBorderColor #868E96
skinparam noteBackgroundColor #FFF3CD
skinparam noteFontColor #212529

title Multiplayer Client Connection and World Sync

actor "Player/UI" as player
participant "NetClient" as client
participant "Net\n(network layer)" as net
participant "NetServer" as server
participant "Administration\n(admins)" as admins
participant "NetworkIO" as netio
participant "SaveIO" as saveio

' ─── Phase 1: TCP Connection Establishment ───────────────────────────────────
== Phase 1: TCP Connection Establishment ==

player -> net : connect(ip, port)\n[TCP handshake]
activate net

net -> client : handleClient(Connect.class, packet)\n[TCP connected event]
activate client

client -> client : reset()\n[Groups.clear(), connecting = true]
client -> player : ui.loadfrag.show('@connecting.data')
client -> client : getUsid(packet.addressTCP)\n[retrieve / generate unique session ID]

' ─── Phase 2: Client Authentication ─────────────────────────────────────────
== Phase 2: Client Authentication ==

client -> net : send(ConnectPacket{\n  name, locale, mods, mobile,\n  versionType, color, usid, uuid\n}, reliable = true)
deactivate client

net -> server : handleServer(ConnectPacket, con)\n[server receives auth info]
activate server

server -> admins : isIPBanned(ip) / isIDBanned(uuid)\n/ isNameBanned(name)
activate admins
admins --> server : validation result
deactivate admins

alt banned / invalid / limit reached
    server -> net : con.kick(KickReason)\n[e.g. banned, playerLimit, whitelist, typeMismatch]
    note right of net : Connection terminated.\nClient displays kick reason.
else validation passed
    server -> admins : updatePlayerJoined(uuid, ip, name)
    server -> server : Player.create()\n[instantiate player from packet data]
    server -> server : assignTeam(player)\n[PvP team assignment]
end

' ─── Phase 3: World Data Transfer ────────────────────────────────────────────
== Phase 3: World Data Transfer (TCP / reliable) ==

server -> net : Call.worldDataBegin(player.con)
net -> client : handleClient worldDataBegin()\n[Groups.clear(), connecting = true,\nnet.setClientLoaded(false)]
activate client

server -> netio : NetworkIO.writeWorld(player,\nDeflaterOutputStream)\n[serialize game state]
activate netio

netio -> saveio : writeContentHeader()\nwriteMap()\nwriteTeamBlocks()\nwriteMarkers()\nwriteCustomChunks()
activate saveio
saveio --> netio : serialized world bytes
deactivate saveio

netio --> server : compressed world bytes (zlib)
deactivate netio

server -> net : con.sendStream(WorldStream{\n  compressedBytes\n})  [TCP reliable stream]
deactivate server

net -> client : handleClient(WorldStream.class, data)\n[client receives compressed world bytes]

' ─── Phase 4: World Deserialization ─────────────────────────────────────────
== Phase 4: World Deserialization ==

client -> netio : NetworkIO.loadWorld(\n  InflaterInputStream(data.stream)\n)\n[decompress + deserialize]
activate netio

netio -> saveio : readContentHeader()\nreadMap()\nreadTeamBlocks()\nreadMarkers()\nreadCustomChunks()
activate saveio
saveio --> netio : reconstructed world state
deactivate saveio

netio -> client : player.reset()\nplayer.read(read)\nplayer.add()\n[local player initialized]
deactivate netio

client -> client : finishConnecting()\n[state.set(State.playing),\nconnecting = false,\nnet.setClientLoaded(true)]

' ─── Phase 5: Connection Confirmation ────────────────────────────────────────
== Phase 5: Connection Confirmation ==

client -> net : Call.connectConfirm()
deactivate client

net -> server : connectConfirm(Player player)
activate server

server -> server : player.add()\n[add player to Groups]
server -> server : Events.fire(PlayerConnectionConfirmed)\nEvents.fire(PlayerJoin)
server -> net : Call.sendMessage(\n  '[accent]<name> has connected.'\n)  [broadcast to all clients]
deactivate server

net -> player : join message displayed
note over player : GameState: menu → playing\nPlayer visible to all clients

' ─── Phase 6: Ongoing Synchronisation (UDP) ──────────────────────────────────
== Phase 6: Ongoing Synchronisation (UDP / unreliable) ==

loop Every ~66 ms
    client -> server : Call.clientSnapshot(\n  lastSent++, unitId, x, y,\n  aimX, aimY, ...\n)  [player state]
end

loop Periodic entity / state sync
    server -> client : entitySnapshot(amount, data)\nstateSnapshot(...)\nblockSnapshot(...)
end

loop Every ~1 s
    client -> server : Call.ping(Time.millis())
    server -> client : Call.pingResponse(con, time)\n[RTT measurement]
end

@enduml
