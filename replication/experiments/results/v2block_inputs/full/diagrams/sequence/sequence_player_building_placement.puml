@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequence {
    ArrowColor #495057
    LifeLineBorderColor #495057
    LifeLineBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
    BoxBackgroundColor #E9ECEF
    GroupBorderColor #6C757D
    GroupBackgroundColor #DEE2E6
    DividerBackgroundColor #E9ECEF
    DividerBorderColor #6C757D
}

title Player Building Placement

actor "Player / User" as Player

box "Input Layer" #E9ECEF
    participant "DesktopInput" as Desktop
    participant "MobileInput" as Mobile
    participant "InputHandler" as Handler
end box

box "Game Logic" #F8F9FA
    participant "Build" as Build
    participant "Block" as Block
    participant "Unit\n(player.unit())" as Unit
end box

== Desktop Path: Drag-to-Place ==

Player -> Desktop : press LMB (Binding.select)\n[block != null && isPlacing()]
activate Desktop

Desktop -> Desktop : selectX = cursorX\nselectY = cursorY\nmode = placing

Desktop -> Handler : updateLine(selectX, selectY)
activate Handler

Handler -> Handler : linePlans.clear()
Handler -> Block : nextConfig()
activate Block
Block --> Handler : defaultConfig
deactivate Block

Handler -> Handler : iterateLine(x1,y1,x2,y2)\n  → linePlans.add(new BuildPlan(l.x, l.y,\n    l.rotation, block, config))

opt blockreplace setting enabled
    Handler -> Block : getReplacement(plan, linePlans)
    activate Block
    Block --> Handler : replacementBlock
    deactivate Block
end

Handler -> Block : handlePlacementLine(linePlans)
activate Block
Block --> Handler : (line plans adjusted,\ne.g. conveyor directions)
deactivate Block

Handler --> Desktop : linePlans updated
deactivate Handler

loop while dragging (cursorX/Y change each frame)
    Desktop -> Handler : updateLine(selectX, selectY)
    activate Handler
    Handler -> Handler : linePlans.clear()\nrecompute plans
    Handler --> Desktop : linePlans updated
    deactivate Handler
end

Player -> Desktop : release LMB (Binding.select keyRelease)\n[mode == placing && block != null]
activate Desktop

alt boost key held
    Desktop -> Handler : flushPlansReverse(linePlans)
else normal release
    Desktop -> Handler : flushPlans(linePlans)
end
activate Handler

loop for each BuildPlan in linePlans
    Handler -> Handler : validPlace(plan.x, plan.y,\n  plan.block, plan.rotation, null, true)
    activate Handler

    Handler -> Build : validPlaceIgnoreUnits(type, player.team(),\n  x, y, rotation) or validPlace(...)
    activate Build
    Build --> Handler : isValid (boolean)
    deactivate Build

    Handler -> Handler : check playerPlanTree\n(vpPredicate — no conflicting queued plan)

    opt placement is valid
        Handler -> Handler : copy = plan.copy()
        Handler -> Block : onNewPlan(copy)
        activate Block
        Block --> Handler : (plan initialized)
        deactivate Block
        Handler -> Unit : addBuild(copy)
        activate Unit
        Unit --> Handler : (plan queued)
        deactivate Unit
        Handler -> Handler : playerPlanTree.insert(copy)
    end
    deactivate Handler
end

Handler --> Desktop : plans flushed
deactivate Handler
Desktop -> Desktop : linePlans.clear()
Desktop -> Desktop : Events.fire(LineConfirmEvent)
deactivate Desktop
deactivate Desktop

== Mobile Path: Tap-to-Queue + Confirm ==

Player -> Mobile : tap(screenX, screenY, count, button)
activate Mobile

Mobile -> Mobile : cursor = tileAt(x, y)\n[world tile under tap]
Mobile -> Mobile : Call.tileTap(player, cursor)\n[network notification]

alt mode == placing && isPlacing()
    Mobile -> Handler : validPlace(cursor.x, cursor.y,\n  block, rotation)
    activate Handler
    Handler -> Build : validPlace(type, player.team(),\n  x, y, rotation)
    activate Build
    Build --> Handler : isValid
    deactivate Build
    Handler --> Mobile : isValid
    deactivate Handler

    opt valid && !checkOverlapPlacement(...)
        Mobile -> Block : nextConfig()
        activate Block
        Block --> Mobile : defaultConfig
        deactivate Block
        Mobile -> Mobile : selectPlans.add(\n  new BuildPlan(cursor.x, cursor.y,\n    rotation, block, config))\nlastPlaced = plan
    end
end
deactivate Mobile

Player -> Mobile : tap Confirm button (UI)
activate Mobile

loop for each BuildPlan in selectPlans
    Mobile -> Handler : validPlace(plan.x, plan.y,\n  plan.block, plan.rotation, null, true)
    activate Handler
    Handler -> Build : validPlace(...)
    activate Build
    Build --> Handler : isValid
    deactivate Build
    Handler --> Mobile : isValid
    deactivate Handler

    opt valid
        Mobile -> Block : onNewPlan(plan.copy())
        activate Block
        Block --> Mobile : (plan initialized)
        deactivate Block
        Mobile -> Unit : addBuild(plan.copy())
        activate Unit
        Unit --> Mobile : (plan queued)
        deactivate Unit
    end
end
deactivate Mobile

== Unit Processes Build Queue (Async) ==

Unit -> Unit : AI loop: move to plan tile\nexecute ConstructBlock placement
note right of Unit
  The unit asynchronously processes
  its build queue, physically placing
  blocks in the world.
end note

@enduml
