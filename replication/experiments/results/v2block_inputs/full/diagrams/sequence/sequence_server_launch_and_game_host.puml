@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantFontColor #212529
    BoxBackgroundColor #F1F3F5
    BoxBorderColor #ADB5BD
    DividerBackgroundColor #DEE2E6
    GroupBorderColor #6C757D
    GroupBackgroundColor #F8F9FA
    GroupHeaderFontColor #212529
}

title Server Launch and Game Hosting

actor "Operator / CLI" as Operator

participant "main()" as Main
participant "HeadlessApplication" as App
participant "ServerLauncher" as Launcher
participant "Vars & Content" as VarsContent
participant "Core.app" as CoreApp
participant "Events" as Events
participant "Logic" as Logic
participant "NetServer" as NetServer
participant "Net" as Net
participant "ServerControl" as ServerControl
participant "Maps" as Maps
participant "World" as World
participant "GameState" as GameState
participant "SaveIO" as SaveIO
participant "WorldReloader" as WorldReloader

== Server Startup ==

Main -> Net: new Net()
Main -> App: new HeadlessApplication(new ServerLauncher())
activate App

App -> Launcher: init()
activate Launcher

Launcher -> VarsContent: loadSettings()
Launcher -> VarsContent: init()
Launcher -> VarsContent: createBaseContent()
Launcher -> VarsContent: loadScripts()
Launcher -> VarsContent: createModContent()
Launcher -> VarsContent: init() [content init]

Launcher -> CoreApp: addListener(logic = new Logic())
activate Logic

Launcher -> CoreApp: addListener(netServer = new NetServer())
activate NetServer
note right of NetServer
  NetServer registers all
  network packet handlers
  in its constructor
end note

Launcher -> CoreApp: addListener(new ServerControl(args))
activate ServerControl

Launcher -> Events: fire(ServerLoadEvent)
deactivate Launcher

== ServerControl Initialization ==

ServerControl -> ServerControl: setup(args)
activate ServerControl

ServerControl -> ServerControl: registerCommands()

alt Auto-update path: autosave file exists && Config.autoUpdate
    ServerControl -> SaveIO: load(autosavebe.msav)
    activate SaveIO
    SaveIO --> ServerControl: world + state restored
    deactivate SaveIO
    ServerControl -> GameState: state.set(State.playing)
    ServerControl -> NetServer: openServer()
    activate NetServer
    NetServer -> Net: net.host(Config.port.num())
    activate Net
    Net --> NetServer: port bound (TCP/UDP)
    deactivate Net
    deactivate NetServer
end

deactivate ServerControl

== Manual Host Command ==

Operator -> ServerControl: 'host <map> <mode>'
activate ServerControl

ServerControl -> Maps: maps.all() — find map by name
activate Maps
Maps --> ServerControl: map
deactivate Maps

ServerControl -> World: world.loadMap(map, map.applyRules(lastMode))
activate World
World --> ServerControl: map loaded
deactivate World

ServerControl -> GameState: state.rules = map.applyRules(preset)

ServerControl -> Logic: logic.play()
activate Logic
Logic --> ServerControl: playing state active
deactivate Logic

ServerControl -> NetServer: netServer.openServer()
activate NetServer
NetServer -> Net: net.host(Config.port.num())
activate Net
Net --> NetServer: port bound
deactivate Net
NetServer --> ServerControl: server open
deactivate NetServer

deactivate ServerControl

== Game-Over / Next-Round Cycle ==

Events -> ServerControl: GameOver event → gameOverListener.handle()
activate ServerControl

ServerControl -> ServerControl: play(run: () -> world.loadMap(nextMap, rules))
activate ServerControl

create WorldReloader
ServerControl -> WorldReloader: reloader = new WorldReloader()
ServerControl -> WorldReloader: reloader.begin()
activate WorldReloader
note right of WorldReloader
  Snapshots current world
  state for clean transition
end note

ServerControl -> World: world.loadMap(nextMap, rules)  [via run.run()]
activate World
World --> ServerControl: next map loaded
deactivate World

ServerControl -> GameState: state.rules = state.map.applyRules(lastMode)

ServerControl -> Logic: logic.play()
activate Logic
Logic --> ServerControl: playing state active
deactivate Logic

ServerControl -> WorldReloader: reloader.end()
WorldReloader --> ServerControl: transition complete
deactivate WorldReloader

deactivate ServerControl
deactivate ServerControl

== Stop Server ==

Operator -> ServerControl: 'stop' command
activate ServerControl

ServerControl -> Net: net.closeServer()
activate Net
Net --> ServerControl: server closed
deactivate Net

ServerControl -> GameState: state.set(State.menu)

deactivate ServerControl

@enduml
