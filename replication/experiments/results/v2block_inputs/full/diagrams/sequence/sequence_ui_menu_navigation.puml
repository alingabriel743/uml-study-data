@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam sequence {
    ArrowColor #495057
    ActorBorderColor #495057
    ActorBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    LifeLineBorderColor #ADB5BD
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
    NoteBackgroundColor #FFF9C4
    NoteBorderColor #F9A825
    DividerBackgroundColor #DEE2E6
}

title UI Menu Navigation and HUD Interaction

actor Player

participant "UI" as UI
participant "MenuFragment\n(menufrag)" as MenuFragment
participant "HudFragment\n(hudfrag)" as HudFragment
participant "PlacementFragment\n(blockfrag)" as PlacementFragment
participant "GameState\n(state)" as GameState
participant "Dialog\n(JoinDialog / PlanetDialog)" as Dialog

== UI Initialization ==

UI -> UI : loadSync()\nnote right: Core.scene = new Scene()\nTex.load(); Icon.load(); Styles.load()
activate UI

UI -> MenuFragment : new MenuFragment()
UI -> HudFragment : new HudFragment()

UI -> GameState : menuGroup.visible(() -> state.isMenu())
UI -> GameState : hudGroup.visible(() -> state.isGame())

UI -> HudFragment : hudfrag.build(hudGroup)
activate HudFragment
HudFragment -> HudFragment : loadFavorites()\nnote right: load from Core.settings
HudFragment -> HudFragment : register Events\n(WaveEvent, SectorCaptureEvent,\nSectorLoseEvent, ResetEvent)
HudFragment -> HudFragment : fill paused table\n(visible when state.isPaused() && shown)
HudFragment -> HudFragment : fill minimap+position table\n(visible when settings.minimap && shown)
HudFragment -> HudFragment : fill overlay marker +\nmobile buttons row
HudFragment -> HudFragment : build wavesMain / editorMain stack\n(shown && !state.isEditor())
HudFragment -> PlacementFragment : blockfrag.build(parent)
activate PlacementFragment
PlacementFragment --> HudFragment : built
deactivate PlacementFragment
deactivate HudFragment

UI -> MenuFragment : menufrag.build(menuGroup)
activate MenuFragment

alt Desktop
    MenuFragment -> MenuFragment : buildDesktop()\ncreate 'Play' MenuButton\n[Campaign, JoinGame, CustomGame, LoadGame]\ncreate 'Database' MenuButton\ncreate Editor, Mods, Settings, Quit buttons
    MenuFragment -> MenuFragment : register ResizeEvent → buildDesktop()
else Mobile
    MenuFragment -> MenuFragment : buildMobile()\ncreate MobileButtons:\nplay, custom, maps, join, editor, tools, mods, exit
    MenuFragment -> MenuFragment : register ResizeEvent → buildMobile()
end

deactivate MenuFragment
deactivate UI

== Menu Navigation: Player Clicks Play ==

Player -> MenuFragment : click 'Play' button
activate MenuFragment
MenuFragment -> MenuFragment : buttons() — submenu exists:\nset currentMenu, fadeInMenu()\nbuild [Campaign, JoinGame, CustomGame, LoadGame]
MenuFragment --> Player : submenu visible
deactivate MenuFragment

alt Player selects 'Join Game'
    Player -> MenuFragment : click 'Join Game'
    activate MenuFragment
    MenuFragment -> MenuFragment : checkPlay(ui.join::show)
    MenuFragment -> MenuFragment : mods.hasContentErrors()?
    note right: if errors → ui.showInfo('@mod.noerrorplay')
    MenuFragment -> Dialog : ui.join.show() → JoinDialog.show()
    activate Dialog
    Dialog --> Player : JoinDialog displayed
    deactivate Dialog
    deactivate MenuFragment

else Player selects 'Campaign'
    Player -> MenuFragment : click 'Campaign'
    activate MenuFragment
    MenuFragment -> MenuFragment : checkPlay(ui.planet::show)
    MenuFragment -> Dialog : ui.planet.show() → PlanetDialog.show()
    activate Dialog
    Dialog --> Player : PlanetDialog displayed
    deactivate Dialog
    deactivate MenuFragment

else Player selects 'Settings'
    Player -> MenuFragment : click 'Settings'
    activate MenuFragment
    MenuFragment -> Dialog : ui.settings.show() → SettingsMenuDialog.show()
    activate Dialog
    Dialog --> Player : SettingsMenuDialog displayed
    deactivate Dialog
    deactivate MenuFragment
end

== Game Starts — State Transition ==

GameState -> GameState : state transitions: isMenu() → false\nisGame() → true
GameState --> UI : menuGroup becomes invisible\nhudGroup becomes visible

== HUD Interaction During Game ==

Player -> HudFragment : click 'flip' button
activate HudFragment
HudFragment -> HudFragment : toggleMenus()\n(shown = !shown)
note right: toggles visibility of paused,\nminimap, overlay, coreItems
deactivate HudFragment

Player -> HudFragment : keyTap(Binding.toggleMenus)
activate HudFragment
HudFragment -> HudFragment : toggleMenus()
deactivate HudFragment

alt Online game
    Player -> HudFragment : click pause button
    activate HudFragment
    HudFragment -> UI : ui.listfrag.toggle()\n(show player list)
    deactivate HudFragment

    Player -> HudFragment : click chat button
    activate HudFragment
    HudFragment -> UI : ui.chatfrag.toggle()
    deactivate HudFragment

else Offline / single-player
    Player -> HudFragment : click pause button
    activate HudFragment
    HudFragment -> GameState : state.set(State.paused / State.playing)
    deactivate HudFragment

    Player -> HudFragment : click chat button (campaign)
    activate HudFragment
    HudFragment -> Dialog : ui.research.show()
    activate Dialog
    Dialog --> Player : Research dialog displayed
    deactivate Dialog
    deactivate HudFragment
end

Player -> HudFragment : keyTap(Binding.skipWave)
activate HudFragment
alt admin + net
    HudFragment -> HudFragment : Call.adminRequest(wave)
else
    HudFragment -> HudFragment : logic.skipWave()
end
deactivate HudFragment

== Block Selection (Editor Mode) ==

note over HudFragment, PlacementFragment: editorMain visible when state.isEditor()

HudFragment -> HudFragment : addBlockSelection(cont)
activate HudFragment
HudFragment -> HudFragment : create blockSelection Table\ninside ScrollPane
HudFragment -> HudFragment : add search field:\nonChange → rebuildBlockSelection(blockSelection, text)
HudFragment -> HudFragment : rebuildBlockSelection(blockSelection, '')
HudFragment -> HudFragment : collect favorites first,\nthen non-favorites;\nsort by fav / synthetic / ore / id
deactivate HudFragment

Player -> HudFragment : click block ImageButton
activate HudFragment
HudFragment -> PlacementFragment : control.input.block = selectedBlock
deactivate HudFragment

Player -> HudFragment : right-click / double-tap block (mobile)
activate HudFragment
HudFragment -> HudFragment : toggleFavorite(block)\nsaveFavorites()\nrebuildBlockSelection(blockSelection, currentText)
deactivate HudFragment

@enduml
