@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #495057
skinparam sequenceParticipantBackgroundColor #F8F9FA
skinparam sequenceParticipantFontColor #212529
skinparam sequenceLifeLineBorderColor #868E96
skinparam sequenceGroupBackgroundColor #E9ECEF
skinparam sequenceGroupBorderColor #6C757D
skinparam sequenceGroupFontColor #343A40
skinparam noteBorderColor #6C757D
skinparam noteBackgroundColor #FFF9C4

title Wave Enemy Spawning

participant "Logic\n(update loop)" as Logic
participant "GameState\n(Vars.state)" as GameState
participant "WaveSpawner\n(Vars.spawner)" as WaveSpawner
participant "SpawnGroup" as SpawnGroup
participant "UnitType" as UnitType
participant "Unit" as Unit
participant "Events" as Events
participant "Control\n(WaveEvent listener)" as Control

== Wave Timer Countdown ==

loop each game tick
    Logic -> GameState : read: rules.waves, waveTimer, gameOver
    activate Logic

    alt waves enabled && !gameOver && !isWaitingWave()
        Logic -> GameState : state.wavetime -= Time.delta
        note right of GameState
          Timer paused if
          rules.waitEnemies && enemies > 0
        end note
    end
end

== Wave Trigger ==

Logic -> GameState : wavetime <= 0 && !net.client()?
activate Logic

Logic -> Logic : runWave()
activate Logic

Logic -> WaveSpawner : spawnEnemies()
activate WaveSpawner

Logic -> GameState : state.wave++ (increment wave counter)
Logic -> GameState : state.wavetime = waveSpacing * difficultyMultiplier
Logic -> Events : fire(new WaveEvent())
deactivate Logic

== Spawn Enemy Units ==

WaveSpawner -> WaveSpawner : spawning = true
WaveSpawner -> WaveSpawner : eachGroundSpawn(-1, doShockwave)\n[visual shockwave at spawn tiles]

loop for each SpawnGroup in rules.spawns
    WaveSpawner -> SpawnGroup : getSpawned(wave - 1)
    activate SpawnGroup
    SpawnGroup --> WaveSpawner : unitCount\n(0 if outside begin/end/spacing window)
    deactivate SpawnGroup

    opt campaign mode
        WaveSpawner -> WaveSpawner : scale count by\ndifficulty.enemySpawnMultiplier
    end

    alt flying unit group
        WaveSpawner -> WaveSpawner : eachFlyerSpawn(group.spawn, ...)\n→ map edge opposite spawn tile
    else ground unit group
        WaveSpawner -> WaveSpawner : eachGroundSpawn(group.spawn, ...)\n→ spawn tile with x/y spread
    end

    loop for each spawn point × unit count
        WaveSpawner -> SpawnGroup : createUnit(waveTeam, x, y, angle, wave-1, spawnEffect)
        activate SpawnGroup

        SpawnGroup -> UnitType : spawn(team, x, y, rotation, cons)
        activate UnitType
        UnitType --> SpawnGroup : unit (new Unit)
        deactivate UnitType

        SpawnGroup -> Unit : apply(effect, 999999f)\n[e.g. StatusEffects.boss]
        activate Unit
        SpawnGroup -> Unit : addItem(item, amount)\n[if items configured]
        SpawnGroup -> Unit : shield = getShield(wave)\n[base + shieldScaling*(wave-begin)]

        opt payload unit (Payloadc)
            SpawnGroup -> UnitType : create(unit.team) [per payload type]
            SpawnGroup -> Unit : payload.pickup(payloadUnit)
        end

        deactivate Unit
        SpawnGroup --> WaveSpawner : unit
        deactivate SpawnGroup

        WaveSpawner -> Unit : apply(StatusEffects.unmoving, 30f)
        activate Unit
        WaveSpawner -> Unit : apply(StatusEffects.invincible, 60f)
        WaveSpawner -> Unit : unloaded() [mark as just spawned]
        deactivate Unit
        WaveSpawner -> Events : fire(new UnitSpawnEvent(unit))
        WaveSpawner -> WaveSpawner : Call.spawnEffect(x, y, rotation, type)\n[RPC broadcast to clients]
    end
end

WaveSpawner -> WaveSpawner : Time.run(121f, () -> spawning = false)\n[~2 sec delay, then mark done]
deactivate WaveSpawner
deactivate Logic

== WaveEvent Side Effects ==

Events -> Control : WaveEvent received
activate Control
Control -> Control : Sounds.waveSpawn.play()
opt new high score (state.wave > map.highScore)
    Control -> GameState : state.map.setHighScore(state.wave)
end
deactivate Control

@enduml
