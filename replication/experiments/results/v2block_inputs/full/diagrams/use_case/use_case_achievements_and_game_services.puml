@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam ArrowColor #495057

title Achievements and Game Services

left to right direction

actor "Player" as Player
actor "GameService" as GameService
actor "Platform" as Platform
actor "Steam API" as SteamAPI

rectangle "Achievements and Game Services" {
    usecase "Earn Achievement" as UC_EarnAchievement
    usecase "Track Statistic" as UC_TrackStat
    usecase "Check Achievement Status" as UC_CheckStatus
    usecase "Complete Achievement\non Platform" as UC_CompleteAchievement
    usecase "Store Stats to Platform" as UC_StoreStats
    usecase "Register Game\nEvent Listeners" as UC_RegisterEvents
    usecase "Update Campaign Stats" as UC_UpdateCampaignStats
    usecase "Check All Blocks Built" as UC_CheckAllBlocks
    usecase "Trigger Achievement\nby Game Event" as UC_TriggerByEvent
}

' Player associations
Player --> UC_EarnAchievement
Player --> UC_CheckStatus

' GameService associations
GameService --> UC_TrackStat
GameService --> UC_StoreStats
GameService --> UC_CompleteAchievement
GameService --> UC_RegisterEvents
GameService --> UC_UpdateCampaignStats
GameService --> UC_CheckAllBlocks
GameService --> UC_TriggerByEvent

' Platform associations
Platform --> UC_CompleteAchievement
Platform --> UC_StoreStats

' SteamAPI association
SteamAPI --> UC_StoreStats

' Include / Extend relationships
UC_EarnAchievement ..> UC_TrackStat : <<include>>
UC_EarnAchievement ..> UC_CompleteAchievement : <<include>>
UC_TriggerByEvent ..> UC_EarnAchievement : <<extend>>
UC_StoreStats ..> UC_CompleteAchievement : <<include>>

@enduml
