@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam ArrowColor #495057

title Android and Mobile Platform Features

left to right direction

' ── Actors ────────────────────────────────────────────────────────────────
actor "Android User" as AndroidUser
actor "Android OS" as AndroidOS
actor "File System" as FileSystem
actor "Rhino JS Engine" as RhinoJSEngine

' ── System boundary ───────────────────────────────────────────────────────
rectangle "Android & Mobile Platform (Mindustry)" {

    ' ── Lifecycle & Startup ─────────────────────────────────────────────
    package "App Lifecycle" {
        usecase "Launch Game" as UC01
        usecase "Handle Uncaught Exception" as UC02
        usecase "Detect Tablet and Scale UI" as UC03
        usecase "Move Files to External Storage" as UC12
        usecase "Hide Game to Background" as UC04
    }

    ' ── File & Permission Management ────────────────────────────────────
    package "File & Permission Management" {
        usecase "Show File Chooser" as UC07
        usecase "Show Multi-File Chooser" as UC08
        usecase "Handle Permission Result" as UC09
        usecase "Open File via Deep Link" as UC11
        usecase "Load Mod Jar File" as UC06
    }

    ' ── Display & Input ─────────────────────────────────────────────────
    package "Display & Input" {
        usecase "Force Landscape Orientation" as UC10
    }

    ' ── Rhino JS / Class Loading ─────────────────────────────────────────
    package "Rhino JS & Class Loading" {
        usecase "Get JS Script Context" as UC05
        usecase "Initialize Rhino JS Context for Android" as UC13
        usecase "Create Android Class Loader" as UC14
        usecase "Compile and Load Java Bytecode as DEX" as UC15
        usecase "Reset Class Loader State" as UC16
    }
}

' ── Actor → Use-Case associations ─────────────────────────────────────────

' AndroidOS triggers
AndroidOS --> UC01
AndroidOS --> UC02
AndroidOS --> UC03
AndroidOS --> UC09
AndroidOS --> UC11
AndroidOS --> UC12

' AndroidUser triggers
AndroidUser --> UC04
AndroidUser --> UC06
AndroidUser --> UC07
AndroidUser --> UC08
AndroidUser --> UC10

' FileSystem interactions
FileSystem --> UC06 : provides JAR
FileSystem --> UC11 : provides file/URI
FileSystem --> UC12 : target storage

' Rhino JS Engine triggers
RhinoJSEngine --> UC05
RhinoJSEngine --> UC13
RhinoJSEngine --> UC14
RhinoJSEngine --> UC15
RhinoJSEngine --> UC16

' ── Include / Extend relationships ────────────────────────────────────────

' Launch Game orchestrates tablet detection and file migration at startup
UC01 ..> UC03 : <<include>>
UC01 ..> UC12 : <<include>>

' Multi-file chooser delegates to the single-file chooser
UC08 ..> UC07 : <<include>>

' File chooser may need to request storage permissions
UC07 <.. UC09 : <<extend>>\n(API 23+, pre-29)

' Loading a mod JAR may trigger a permission/security fallback
UC06 <.. UC09 : <<extend>>\n(SecurityException)

' Getting the JS context requires initialising the Rhino context
UC05 ..> UC13 : <<include>>

' Initialising the Rhino context creates the appropriate class loader
UC13 ..> UC14 : <<include>>

' Compiling bytecode to DEX uses the class loader created above
UC15 ..> UC14 : <<include>>

@enduml
