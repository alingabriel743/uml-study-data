@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Base Building and Construction

left to right direction

actor "Player" as player
actor "Builder Unit" as unit
actor "Game Engine\n(System)" as system

rectangle "Base Building and Construction" {

    package "Planning & Queuing" {
        usecase "Select Block to Place" as UC1
        usecase "Queue Block Placement" as UC2
        usecase "Queue Block Demolition" as UC3
        usecase "Rotate Block" as UC4
        usecase "Delete Build Plans" as UC10
    }

    package "Schematics" {
        usecase "Use Schematic (Blueprint)" as UC8
        usecase "Save Schematic" as UC9
    }

    package "Block Interaction" {
        usecase "Tap Tile" as UC7
        usecase "Configure Block" as UC5
        usecase "Show Block Config Panel" as UC6
    }

    package "Construction Execution" {
        usecase "Initialize Construction State" as UC16
        usecase "Execute Construction" as UC12
        usecase "Complete Construction" as UC13
        usecase "Execute Deconstruction" as UC14
        usecase "Complete Deconstruction" as UC15
    }

    package "Feedback" {
        usecase "Draw Build Plan Overlay" as UC11
    }
}

' --- Player interactions ---
player --> UC1
player --> UC2
player --> UC3
player --> UC4
player --> UC5
player --> UC7
player --> UC8
player --> UC9
player --> UC10

' --- Builder Unit interactions ---
unit --> UC12
unit --> UC14

' --- Game Engine (System) interactions ---
system --> UC11
system --> UC13
system --> UC15
system --> UC16

' --- <<include>> relationships ---
' Queue Block Placement requires a block to be selected first
UC2 ..> UC1 : <<include>>
' Configure Block always opens the Block Config Panel
UC5 ..> UC6 : <<include>>
' Using a Schematic produces a batch of queued Block Placements
UC8 ..> UC2 : <<include>>
' Both execution paths require the construction state to be initialised
UC12 ..> UC16 : <<include>>
UC14 ..> UC16 : <<include>>

' --- <<extend>> relationships ---
' Tapping a tile may optionally reveal the Block Config Panel
UC6 ..> UC7 : <<extend>>
' Saving a schematic is an optional step after working with a Schematic
UC9 ..> UC8 : <<extend>>
' Construction completes when ConstructBuild.progress >= 1
UC13 ..> UC12 : <<extend>>
' Deconstruction completes when progress decrements to 0
UC15 ..> UC14 : <<extend>>

@enduml
