@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}

title Campaign and Game Modes

left to right direction

actor "Player" as Player
actor "Enemy AI" as EnemyAI
actor "System\n(Control/Logic)" as System

rectangle "Campaign and Game Modes" {

    package "Navigation & Planet Map" {
        usecase "View Planet Map" as UC01
        usecase "Select Sector" as UC02
    }

    package "Sector Launch" {
        usecase "Launch to Sector (New)" as UC03
        usecase "Continue Existing Sector" as UC04
        usecase "Launch Between Sectors\n(Interplanetary)" as UC05
    }

    package "Game Modes" {
        usecase "Play in Survival Mode" as UC08
        usecase "Play in Attack Mode" as UC09
        usecase "Play in Sandbox Mode" as UC10
    }

    package "Campaign Progression" {
        usecase "Configure Campaign Rules" as UC12
        usecase "Capture Sector\n(Wave / Attack Win)" as UC06
        usecase "Lose Sector" as UC07
        usecase "Manage Sector Resources\n& Exports" as UC11
    }

    package "System Operations" {
        usecase "Simulate Sector Invasion" as UC13
        usecase "Save / Load Sector State" as UC14
    }
}

' ── Player associations ──────────────────────────────────────
Player --> UC01
Player --> UC02
Player --> UC03
Player --> UC04
Player --> UC05
Player --> UC06
Player --> UC08
Player --> UC09
Player --> UC10
Player --> UC11
Player --> UC12

' ── Enemy AI associations ────────────────────────────────────
EnemyAI --> UC13

' ── System associations ──────────────────────────────────────
System --> UC07
System --> UC14

' ── Include relationships (mandatory steps) ──────────────────
UC03 .> UC14 : <<include>>
UC04 .> UC14 : <<include>>
UC06 .> UC14 : <<include>>

' ── Extend relationships (conditional / optional) ────────────
UC02 .> UC01 : <<extend>>
UC03 .> UC02 : <<extend>>
UC04 .> UC02 : <<extend>>
UC05 .> UC03 : <<extend>>
UC08 .> UC03 : <<extend>>
UC09 .> UC03 : <<extend>>
UC10 .> UC03 : <<extend>>
UC13 .> UC07 : <<extend>>

note right of UC08
  waves=true, waveTimer=true
  Player defends core until winWave
end note

note right of UC09
  attackMode=true
  Player destroys enemy core;
  attackAfterWaves switches mode
end note

note right of UC10
  infiniteResources=true
  allowEditRules=true
  waveTimer=false
end note

note bottom of UC06
  wasCaptured=true; adjacent sectors may unlock;
  isLastSector flag triggers campaign end
end note

note bottom of UC13
  allowSectorInvasion=true;
  frozen sector = isAttacked && !isBeingPlayed
end note

@enduml
