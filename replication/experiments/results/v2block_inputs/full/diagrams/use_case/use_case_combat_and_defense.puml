@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9E6
    BorderColor #CCA300
}

title Combat and Defense

left to right direction

actor "Player" as Player
actor "Logic Controller\n(Processor)" as LogicController
actor "AI Unit\n(GroundAI / FlyingAI)" as AIUnit
actor "Turret Building\n(Autonomous Defense)" as TurretBuilding

rectangle "Combat and Defense" {

    package "Unit Combat" {
        usecase "Issue Unit Command\n(Move / Attack / Patrol)" as UC_IssueCommand
        usecase "Target Enemy\n(Acquire & Validate Target)" as UC_TargetEnemy
        usecase "Shoot Unit Weapon\n(Fire from WeaponMount)" as UC_ShootWeapon
        usecase "Update Weapon Mount\n(Per-tick Reload & Aim)" as UC_UpdateWeaponMount
        usecase "Deploy Shoot Pattern\n(Multi-shot Volley Sequence)" as UC_DeployShootPattern
        usecase "Spawn Bullet\n(Create Projectile Entity)" as UC_SpawnBullet
    }

    package "Turret Defense" {
        usecase "Operate Turret\n(Auto-aim, Reload & Fire)" as UC_OperateTurret
        usecase "Find & Validate Target\n(Scan Quadtree, Check LoS)" as UC_FindTarget
        usecase "Apply Turret Shoot Pattern\n(Barrel / Helix / Alternate)" as UC_TurretShootPattern
        usecase "Use Ammo\n(Dequeue Ammo Entry)" as UC_UseAmmo
        usecase "Logic-Control Turret\n(Processor Target Override)" as UC_LogicControlTurret
    }
}

' --- Player interactions ---
Player --> UC_IssueCommand : commands units
Player --> UC_OperateTurret : player-controllable\nturrets

' --- Logic Controller interactions ---
LogicController --> UC_LogicControlTurret : inject target\n& shoot signal

' --- AI Unit interactions ---
AIUnit --> UC_TargetEnemy : autonomous targeting
AIUnit --> UC_ShootWeapon : autonomous firing

' --- Turret Building interactions ---
TurretBuilding --> UC_OperateTurret : per-tick update

' --- Include: Unit Combat flow ---
UC_IssueCommand ..> UC_TargetEnemy    : <<include>>
UC_ShootWeapon  ..> UC_UpdateWeaponMount : <<include>>
UC_ShootWeapon  ..> UC_DeployShootPattern : <<include>>
UC_DeployShootPattern ..> UC_SpawnBullet : <<include>>

' --- Include: Turret Defense flow ---
UC_OperateTurret ..> UC_FindTarget           : <<include>>
UC_OperateTurret ..> UC_TurretShootPattern   : <<include>>
UC_OperateTurret ..> UC_UseAmmo              : <<include>>
UC_TurretShootPattern ..> UC_SpawnBullet     : <<include>>

' --- Extend: Logic override on turret ---
UC_LogicControlTurret ..> UC_OperateTurret : <<extend>>\n(override target\n& force fire)

' --- Shared: both unit AI and player trigger weapon update ---
UC_IssueCommand ..> UC_ShootWeapon : <<include>>

note bottom of UC_DeployShootPattern
  ShootPattern subclasses:
  ShootAlternate, ShootBarrel,
  ShootHelix, ShootMulti, ShootSine
  — each computes per-shot
  (x, y, angle, delay) offsets
  and calls BulletHandler.shoot()
end note

note bottom of UC_LogicControlTurret
  LAccess.shoot command sets
  logicShooting=true, targetPos,
  logicControlTime on TurretBuild;
  overrides normal findTarget()
end note

@enduml
