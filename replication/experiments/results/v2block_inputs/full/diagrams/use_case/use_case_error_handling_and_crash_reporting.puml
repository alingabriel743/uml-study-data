@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}

title Error Handling and Crash Reporting

left to right direction

actor "Game System\n(Runtime)" as GameSystem
actor "Player / End User" as Player
actor "Mod Developer" as ModDev
actor "Desktop Launcher" as Desktop
actor "Android Launcher\n(Platform)" as Android

rectangle "Error Handling & Crash Reporting System" {
    usecase "Trigger Crash Handler\non Unhandled Exception" as UC1
    usecase "Create Crash Report" as UC2
    usecase "Write Exception to Log File" as UC3
    usecase "Log Exception" as UC4
    usecase "Identify Mod Causing Crash" as UC5
    usecase "Match Stack Trace\nto Mod Files" as UC6
    usecase "Handle Crash\n(Desktop Platform)" as UC7
    usecase "Log Steam Error" as UC8
    usecase "Suppress Non-Fatal\nScript Errors" as UC9
    usecase "Display Crash\nDialog to User" as UC10
    usecase "Submit Diagnostic Log" as UC11
    usecase "Resume After\nRecoverable Error" as UC12
}

' Actor → Use Case associations
GameSystem --> UC1
GameSystem --> UC9

Desktop --> UC7
Desktop --> UC8

Android --> UC1

Player --> UC10
Player --> UC11

ModDev --> UC5

' Desktop crash handler delegates to the core crash handler
UC7 ..> UC1 : <<include>>

' Core crash handler includes sub-tasks
UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC1 ..> UC4 : <<include>>
UC1 ..> UC5 : <<include>>

' Mod cause identification uses stack trace matching
UC5 ..> UC6 : <<include>>

' Creating the report triggers the crash dialog
UC2 ..> UC10 : <<include>>

' Extend relationships
UC11 ..> UC2 : <<extend>>
UC9  ..> UC12 : <<extend>>

@enduml
