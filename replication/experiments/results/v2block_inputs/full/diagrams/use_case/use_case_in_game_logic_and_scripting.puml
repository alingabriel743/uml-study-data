@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title In-Game Logic and Scripting

left to right direction

' ── Left-side actors (initiators / engines) ──────────────────────────────────
actor "Player/\nProgrammer" as Player
actor "LogicBuild\n(Processor Block)" as LogicBuild
actor "LAssembler\n(Compiler)" as LAssembler
actor "LExecutor\n(Runtime Engine)" as LExecutor
actor "External/Mod" as Mod
actor "LogicStatement\nProcessor\n(Build-Time)" as LSP

' ── Right-side actors (external targets affected by scripts) ─────────────────
actor "LinkedBuilding\n(Memory Cell /\nDisplay / Turret)" as LinkedBuilding
actor "Unit\n(Game Unit)" as Unit

' ── System boundary ──────────────────────────────────────────────────────────
rectangle "In-Game Logic Scripting System" {

    ' Authoring & setup
    usecase "Write / Edit\nLogic Script" as UC1
    usecase "Link / Unlink\nBuildings to Processor" as UC12

    ' Compilation pipeline
    usecase "Compile Script\nto Instructions" as UC2
    usecase "Load Assembled\nProgram into Executor" as UC3

    ' Execution
    usecase "Execute Logic\nPer Tick" as UC4

    ' Runtime instruction types (performed during execution)
    usecase "Read from\nMemory Cell" as UC5
    usecase "Write to\nMemory Cell" as UC6
    usecase "Control\nLinked Building" as UC7
    usecase "Get Linked\nBuilding Reference" as UC8
    usecase "Bind and\nCommand Units" as UC9
    usecase "Locate Unit\nor Building" as UC10
    usecase "Draw Graphics\nto Display" as UC11

    ' Language extension & tooling
    usecase "Register Custom\nStatement Parser" as UC13
    usecase "Generate Statement\nBoilerplate\n(Annotation Processing)" as UC14

    ' Persistence
    usecase "Serialize / Compress\nLogic Program" as UC15
}

' ── Actor → use-case connections ─────────────────────────────────────────────

' Player/Programmer: authors scripts and manages building connections
Player --> UC1
Player --> UC12

' LogicBuild: orchestrates the full compilation + execution lifecycle
LogicBuild --> UC2
LogicBuild --> UC3
LogicBuild --> UC4
LogicBuild --> UC15

' LAssembler: drives the compilation step
LAssembler --> UC2

' LExecutor: performs every runtime instruction category
LExecutor --> UC4
LExecutor --> UC5
LExecutor --> UC6
LExecutor --> UC7
LExecutor --> UC8
LExecutor --> UC9
LExecutor --> UC10
LExecutor --> UC11

' Mods extend the language at runtime
Mod --> UC13

' Annotation processor generates boilerplate at Java compile time
LSP --> UC14

' ── Use-case → external system interactions ───────────────────────────────────
UC5 --> LinkedBuilding
UC6 --> LinkedBuilding
UC7 --> LinkedBuilding
UC11 --> LinkedBuilding
UC9 --> Unit
UC10 --> Unit

' ── Include / extend relationships ───────────────────────────────────────────

' Editing a script always triggers recompilation and reloading
UC1 ..> UC2 : <<include>>
UC2 ..> UC3 : <<include>>

' Each tick execution may extend into any runtime instruction
UC4 <.. UC5 : <<extend>>
UC4 <.. UC6 : <<extend>>
UC4 <.. UC7 : <<extend>>
UC4 <.. UC8 : <<extend>>
UC4 <.. UC9 : <<extend>>
UC4 <.. UC10 : <<extend>>
UC4 <.. UC11 : <<extend>>

' Custom parsers extend the compilation pipeline
UC2 <.. UC13 : <<extend>>

@enduml
