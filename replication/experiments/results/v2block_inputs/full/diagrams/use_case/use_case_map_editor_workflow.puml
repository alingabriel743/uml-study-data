@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #343A40
}

title Map Editor Workflow

left to right direction

actor "Map Author" as author
actor "Game System" as game
actor "File System" as fs
actor "Steam Platform" as steam

rectangle "Map Editor" {

    package "Map Lifecycle" {
        usecase "Create New Map" as UC01
        usecase "Import Map from File" as UC02
        usecase "Import Map from Image" as UC03
        usecase "Load Existing Map" as UC04
        usecase "Resize Map" as UC20
        usecase "Save Map" as UC22
        usecase "Set Map Metadata" as UC19
    }

    package "Drawing & Editing" {
        usecase "Select Drawing Tool" as UC10
        usecase "Select Block to Place" as UC11
        usecase "Draw Tiles" as UC05
        usecase "Draw Line" as UC06
        usecase "Fill Region" as UC07
        usecase "Erase Tiles" as UC08
        usecase "Pick Tile" as UC09
        usecase "Rotate Block" as UC12
        usecase "Change Brush Size" as UC13
        usecase "Change Drawing Team" as UC14
        usecase "Undo / Redo Edit" as UC18
    }

    package "View Control" {
        usecase "Zoom / Pan View" as UC16
        usecase "Center View" as UC17
        usecase "Toggle Grid Overlay" as UC15
        usecase "Toggle Layer Visibility" as UC29
    }

    package "Generation & Terrain" {
        usecase "Generate Map Terrain" as UC21
        usecase "Generate Map Preview" as UC25
    }

    package "Export & Publish" {
        usecase "Export Map to File" as UC23
        usecase "Export Map as Image" as UC24
        usecase "Publish Map to Workshop" as UC28
    }

    package "Testing" {
        usecase "Playtest Map" as UC26
        usecase "Edit Map In-Game" as UC27
    }

}

' ── Map Author (primary) ───────────────────────────────────────────────────────
author --> UC01
author --> UC02
author --> UC03
author --> UC04
author --> UC20
author --> UC22
author --> UC19
author --> UC05
author --> UC06
author --> UC07
author --> UC08
author --> UC09
author --> UC10
author --> UC11
author --> UC12
author --> UC13
author --> UC14
author --> UC18
author --> UC15
author --> UC16
author --> UC17
author --> UC29
author --> UC21
author --> UC23
author --> UC24
author --> UC26
author --> UC27
author --> UC28

' ── Game System (secondary) ───────────────────────────────────────────────────
game --> UC25
UC27 --> game

' ── File System (secondary) ───────────────────────────────────────────────────
UC02 --> fs
UC03 --> fs
UC23 --> fs
UC24 --> fs

' ── Steam Platform (secondary) ────────────────────────────────────────────────
UC28 --> steam

' ── Include / Extend relationships ────────────────────────────────────────────
UC22 ..> UC19 : <<extend>>
note on link
  Shown when map
  name is empty
end note

UC28 ..> UC22 : <<include>>
UC26 ..> UC22 : <<include>>
UC27 ..> UC22 : <<include>>

@enduml
