@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BorderColor #495057
    FontColor #212529
}

title Multiplayer and Networking

left to right direction

actor "Player" as player
actor "Admin Player" as admin
actor "Server Host" as host
actor "System" as system

' AdminPlayer inherits all Player capabilities
admin -|> player

rectangle "Multiplayer & Networking System" {

    package "Session Management" {
        usecase "Host Server" as UC01
        usecase "Connect to Server" as UC02
        usecase "Authenticate / Join" as UC03
        usecase "Confirm Connection" as UC04
        usecase "Disconnect" as UC05
        usecase "Re-sync World" as UC11
        usecase "Kick All Players" as UC25
    }

    package "Player Communication" {
        usecase "Send Chat Message" as UC06
        usecase "Send Team Message" as UC07
        usecase "Send Admin Chat" as UC08
        usecase "List Commands" as UC12
    }

    package "Votekick" {
        usecase "Initiate Votekick" as UC09
        usecase "Vote on Kick" as UC10
    }

    package "Administration" {
        usecase "Kick Player" as UC14
        usecase "Ban Player" as UC15
        usecase "Trace Player" as UC16
        usecase "Switch Team" as UC17
        usecase "Skip Wave" as UC18
        usecase "Manage IP / Subnet Bans" as UC26
    }

    package "Packet Handling" {
        usecase "Send / Receive Custom Packet" as UC19
        usecase "Send / Receive Binary Packet" as UC20
        usecase "Receive World Data" as UC21
        usecase "Send Client Snapshot" as UC22
        usecase "Request Block Snapshot" as UC23
    }

    package "System Functions" {
        usecase "Handle Invalid Command" as UC13
        usecase "Filter Chat / Anti-spam" as UC27
        usecase "Log Crash / Generate Report" as UC24
    }
}

' ── Server Host ──────────────────────────────────────────
host --> UC01
host --> UC25

' ── Player (and inherited by Admin Player) ───────────────
player --> UC02
player --> UC05
player --> UC06
player --> UC07
player --> UC09
player --> UC10
player --> UC11
player --> UC12
player --> UC19
player --> UC20
player --> UC21
player --> UC22
player --> UC23

' ── Admin Player (admin-exclusive actions) ───────────────
admin --> UC08
admin --> UC14
admin --> UC15
admin --> UC16
admin --> UC17
admin --> UC18
admin --> UC26

' ── System ───────────────────────────────────────────────
system --> UC13
system --> UC24
system --> UC27

' ── Include / Extend relationships ───────────────────────
' Connecting triggers the authentication / join flow
UC02 ..> UC03 : <<include>>
' A successful auth is followed by connection confirmation
UC03 ..> UC04 : <<include>>
' All chat messages are passed through the anti-spam filter
UC06 ..> UC27 : <<include>>
UC07 ..> UC27 : <<include>>
' Voting on kick extends an active votekick session
UC10 ..> UC09 : <<extend>>
' World data is received as part of the join sequence
UC04 ..> UC21 : <<include>>

@enduml
