@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #343A40
    FontColor #212529
}

title Player Core Actions

left to right direction

actor "Player" as player
actor "GameSystem\n(Server / Engine)" as game

rectangle "Mindustry — Player Core Actions" {

    package "Movement & Combat" {
        usecase "Move Unit\n(WASD / joystick)" as UC1
        usecase "Shoot / Attack\n(left-click)" as UC2
        usecase "Pickup / Drop\nPayload" as UC11
    }

    package "Construction" {
        usecase "Place Block" as UC4
        usecase "Break /\nDemolish Block" as UC5
        usecase "Configure /\nRotate Block" as UC9
    }

    package "Resources & Inventory" {
        usecase "Mine Resource" as UC6
        usecase "Deposit /\nWithdraw Items" as UC7
    }

    package "Unit Management" {
        usecase "Select /\nPossess Unit" as UC3
        usecase "Command Units\n(RTS Mode)" as UC8
        usecase "Respawn at Core" as UC10
    }
}

' ── Player initiates all use cases ────────────────────────────────────────────
player --> UC1
player --> UC2
player --> UC3
player --> UC4
player --> UC5
player --> UC6
player --> UC7
player --> UC8
player --> UC9
player --> UC10
player --> UC11

' ── GameSystem validates / executes @Remote server calls ──────────────────────
UC3  --> game : unitControl @Remote
UC4  --> game : flushPlans / addBuild
UC5  --> game : deletePlans @Remote
UC7  --> game : transferInventory @Remote
UC8  --> game : commandUnits @Remote
UC9  --> game : tileConfig / rotateBlock @Remote
UC10 --> game : playerSpawn @Remote
UC11 --> game : requestPayload @Remote

' ── Include / Extend relationships ───────────────────────────────────────────
' Shooting always drives aim + weapon control alongside movement
UC2 ..> UC1  : <<include>>\naim & controlWeapons

' Block placement always allows rotation before confirming
UC4 ..> UC9  : <<include>>\nrotate placed block

' Demolish mode shares the placement pipeline (break plan = no-block BuildPlan)
UC4 <.. UC5  : <<extend>>\nbreak-mode plan

' Selecting a CoreBlock's control surface triggers an immediate respawn
UC3 <.. UC10 : <<extend>>\nrespawn via\nControlBlock select

@enduml
