@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Research and Technology Progression

left to right direction

actor "Player" as Player
actor "Remote\nClient" as RemoteClient
actor "Game\nService" as GameService

rectangle "Research & Technology Progression" {

    usecase "Open Research Dialog" as UC1
    usecase "View Technology Tree" as UC2
    usecase "Navigate Tech Tree\n(Pan / Zoom)" as UC3
    usecase "Switch Tech Tree\n(Planet)" as UC4
    usecase "View Node\nRequirements / Info" as UC5
    usecase "Research / Spend\nItems on Technology" as UC6
    usecase "Unlock Technology" as UC7
    usecase "Track Research\nProgress" as UC8
    usecase "Open Content\nInfo (Database)" as UC9
    usecase "Open Full Database" as UC10
    usecase "Trigger Achievement\non Research" as UC11
    usecase "Sync Research\nin Multiplayer" as UC12

}

' ── Actor associations ──────────────────────────────────────────────────────
Player --> UC1  : opens
Player --> UC3  : pan / zoom
Player --> UC6  : spend items
Player --> UC10 : browse

note right of RemoteClient
  View only — spend/unlock
  disabled (net.client() mode)
end note

RemoteClient --> UC2
RemoteClient --> UC12

GameService --> UC11

' ── Extend relationships (optional / conditional behaviour) ─────────────────
UC2 ..> UC1  : <<extend>>
UC4 ..> UC1  : <<extend>>\n{showTechSelect}
UC5 ..> UC2  : <<extend>>
UC8 ..> UC5  : <<extend>>
UC9 ..> UC5  : <<extend>>\n{selectable}

' ── Include relationships (always triggered) ────────────────────────────────
UC6 ..> UC7  : <<include>>\nall requirements met
UC7 ..> UC11 : <<include>>\nResearchEvent / UnlockEvent
UC7 ..> UC12 : <<include>>\nUnlockEvent → needsRebuild

@enduml
