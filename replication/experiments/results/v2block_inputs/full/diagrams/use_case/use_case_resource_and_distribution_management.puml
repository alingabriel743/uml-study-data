@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #495057
    BorderThickness 2
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #ADB5BD
}

title Resource and Distribution Management

left to right direction

actor "Player" as player
actor "Router\n(Building)" as router
actor "DuctRouter\n(Building)" as ductRouter
actor "StackRouter\n(Building)" as stackRouter
actor "LiquidRouter\n(Building)" as liquidRouter
actor "Distribution\nNetwork" as distNetwork

rectangle "Resource and Distribution Management" {

    package "Item Routing" {
        usecase "Route Items to\nAdjacent Buildings" as UC1
        usecase "Route Items via\nDuct Network" as UC3
        usecase "Route Item Stacks\n(Bulk)" as UC4
        usecase "Transport Items\nvia Conveyor" as UC8
    }

    package "Liquid Routing" {
        usecase "Distribute\nLiquids Evenly" as UC5
        usecase "Transport Liquids\nvia Conduit" as UC10
    }

    package "Smart / Conditional Routing" {
        usecase "Sort Items\nby Type" as UC6
        usecase "Handle Overflow /\nFallback Routing" as UC7
        usecase "Bridge Items/Liquids\nAcross Gaps" as UC9
    }

    package "Player Interaction" {
        usecase "Configure Output\nDirection" as UC2
        usecase "Control Router\nas Unit" as UC11
        usecase "Visualize\nDistribution State" as UC12
    }

}

' --- Actor → Use Case associations ---
router      --> UC1
router      --> UC11

ductRouter  --> UC3
ductRouter  --> UC12

stackRouter --> UC4

liquidRouter --> UC5

distNetwork --> UC6
distNetwork --> UC7
distNetwork --> UC8
distNetwork --> UC9
distNetwork --> UC10

player --> UC2
player --> UC11
player --> UC12

' --- Include / Extend relationships ---
' Configuring direction is included in directional duct routing
UC3 ..> UC2 : <<include>>

' StackRouter bulk routing extends DuctRouter routing behaviour
UC4 ..> UC3 : <<extend>>

' Visual feedback is part of duct and stack router operation
UC12 ..> UC3 : <<include>>
UC12 ..> UC4 : <<extend>>

' Overflow routing extends normal conveyor transport as a fallback
UC7 ..> UC8 : <<extend>>

@enduml
