@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #D9EAF7
    BorderColor #2471A3
    FontColor #212529
}

title Save and Load Management

left to right direction

actor "Player" as Player
actor "AutoSave System" as AutoSave
actor "Map Editor" as MapEditor
actor "Asset Manager" as AssetMgr
actor "File System" as FileSystem

rectangle "Save and Load Management" {

    rectangle "Game Save Management" {
        usecase "Save Game State" as UC01
        usecase "Auto-Save Game" as UC02
        usecase "Load Game State" as UC03
        usecase "Validate Save File" as UC04
        usecase "Import Save File" as UC05
        usecase "Export Save File" as UC06
        usecase "Delete Save Slot" as UC07
        usecase "Add Named Save Slot" as UC08
        usecase "Save Sector State" as UC09
        usecase "Generate Save Preview" as UC10
        usecase "Load Save Preview Texture" as UC11
    }

    rectangle "Map Management" {
        usecase "Save Map" as UC12
        usecase "Load Maps" as UC13
        usecase "Import Map" as UC14
        usecase "Remove Map" as UC15
        usecase "Generate Map Preview" as UC16
        usecase "Load Map Previews" as UC17
        usecase "Queue Map Preview Generation" as UC18
        usecase "Write Map Preview Image" as UC19
    }

}

' Player interactions
Player --> UC01
Player --> UC03
Player --> UC05
Player --> UC06
Player --> UC07
Player --> UC08

' AutoSave System interactions
AutoSave --> UC02
AutoSave --> UC09

' Map Editor interactions
MapEditor --> UC12
MapEditor --> UC14
MapEditor --> UC15
MapEditor --> UC19

' Asset Manager interactions
AssetMgr --> UC11
AssetMgr --> UC13
AssetMgr --> UC17

' File System interactions (persistence layer)
UC01 --> FileSystem
UC03 --> FileSystem
UC10 --> FileSystem
UC12 --> FileSystem
UC13 --> FileSystem
UC16 --> FileSystem

' Include relationships (base functionality always invoked)
UC02 ..> UC01 : <<include>>
UC08 ..> UC01 : <<include>>
UC09 ..> UC01 : <<include>>
UC03 ..> UC04 : <<include>>
UC05 ..> UC04 : <<include>>
UC01 ..> UC10 : <<include>>
UC12 ..> UC16 : <<include>>
UC14 ..> UC16 : <<include>>
UC18 ..> UC16 : <<include>>

' Extend relationships (optional / conditional behavior)
UC17 <.. UC18 : <<extend>>

@enduml
