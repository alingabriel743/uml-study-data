@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Status Effects and Combat Modifiers

left to right direction

actor "Weapon / Bullet" as Weapon
actor "Game Engine\n(Tick)" as Engine
actor "UnitType\n(Immunity Holder)" as UnitType
actor "StatusEffects\nRegistry" as Registry

rectangle "Status Effects System" {

    ' --- Application Use Cases ---
    usecase "Apply Status Effect\nto Unit (with duration)" as UC_Apply
    usecase "Apply Permanent\nStatus Effect" as UC_Permanent
    usecase "Extend Existing\nStatus Duration" as UC_Extend
    usecase "Check Unit Immunity" as UC_Immunity
    usecase "Remove / Unapply\nStatus Effect" as UC_Remove
    usecase "Clear All Status\nEffects from Unit" as UC_Clear

    ' --- Transition / Interaction Use Cases ---
    usecase "Detect Status\nInteraction (reactsWith)" as UC_React
    usecase "Transition Between\nStatus Effects\n(e.g. wet + burning → steam)" as UC_Transition
    usecase "Cancel Opposite\nStatus Effects" as UC_Opposite
    usecase "Trigger Affinity\nReaction" as UC_Affinity

    ' --- Query Use Cases ---
    usecase "Check If Unit Has\nSpecific Status Effect" as UC_Has
    usecase "Query Current\nStatus Duration" as UC_Duration

    ' --- Per-Tick Update Use Cases ---
    usecase "Update Status\nEffect Per Tick" as UC_Update
    usecase "Apply Interval\nDamage from Status" as UC_IntDamage
    usecase "Apply Dynamic\nStatus Logic" as UC_Dynamic
    usecase "Compute Combined\nStat Multipliers\n(speed, damage, reload,\nhealth, drag, armor)" as UC_Stats
    usecase "Draw Status\nVisual Effects" as UC_Draw
    usecase "Remove Expired\nStatus & Notify" as UC_Expire

}

' --- Actor associations ---
Weapon --> UC_Apply
Weapon --> UC_Remove
Weapon --> UC_Clear

Engine --> UC_Update

UnitType --> UC_Immunity

Registry --> UC_Apply : defines effects\nand transitions

' --- Include relationships ---
UC_Apply ..> UC_Immunity : <<include>>
UC_Apply ..> UC_React : <<include>>

UC_React ..> UC_Transition : <<include>>
UC_Transition ..> UC_Opposite : <<include>>
UC_Transition ..> UC_Affinity : <<include>>

UC_Update ..> UC_IntDamage : <<include>>
UC_Update ..> UC_Stats : <<include>>
UC_Update ..> UC_Draw : <<include>>
UC_Update ..> UC_Expire : <<include>>

' --- Extend relationships ---
UC_Permanent ..> UC_Apply : <<extend>>
UC_Extend ..> UC_Apply : <<extend>>
UC_Dynamic ..> UC_Update : <<extend>>

' --- Query associations ---
Weapon --> UC_Has
Weapon --> UC_Duration

@enduml
