@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9E6
    BorderColor #CCA000
    FontColor #212529
}

left to right direction

title Unit AI and Control

actor "Player" as Player
actor "Server\n(Net Authority)" as Server
actor "AI System" as AISystem
actor "Logic Processor" as LogicProcessor

rectangle "Unit AI and Control System" {

    ' ── Player: direct possession ──────────────────────────────
    usecase "Possess Unit\n(Direct Control)" as UC1
    usecase "Select Units\n(RTS Mode)" as UC2

    ' ── Player: RTS commands (validated by Server) ─────────────
    usecase "Issue Move Command" as UC3
    usecase "Issue Attack Command" as UC4
    usecase "Set Behavior Command\n(Repair / Mine / Build / Assist)" as UC5
    usecase "Set Unit Stance\n(HoldFire / Patrol / Ram / Boost / ...)" as UC6

    ' ── Player: advanced command options ───────────────────────
    usecase "Queue Movement\nCommands (Waypoints)" as UC7
    usecase "Command Units\nin Formation" as UC14

    ' ── AI System: autonomous per-tick behaviors ───────────────
    usecase "Autonomous AI Update\n(Move + Target + Shoot)" as UC8
    usecase "Pathfind to Target\n(Flow-field Navigation)" as UC9
    usecase "Counter-Attack on Hit" as UC10
    usecase "Auto-Mine Ore\n(MinerAI)" as UC13

    ' ── Logic Processor: external override ─────────────────────
    usecase "Logic-Control Unit\n(LUnitControl Override, 10 s)" as UC11

}

' ── Actor → Use Case associations ──────────────────────────────

' Player interactions
Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC4
Player --> UC5
Player --> UC6
Player --> UC7
Player --> UC14

' Server validates and dispatches RTS command packets
Server --> UC3
Server --> UC4
Server --> UC5
Server --> UC6

' AI System drives autonomous behavior
AISystem --> UC8
AISystem --> UC9
AISystem --> UC10
AISystem --> UC13

' Logic Processor sends LUnitControl instructions
LogicProcessor --> UC11

' ── Use Case relationships ──────────────────────────────────────

' Queueing and formation are optional extensions of move command
UC7  ..> UC3  : «extend»
UC14 ..> UC3  : «extend»

' Autonomous AI Update always drives pathfinding
UC8  ..> UC9  : «include»

' Setting the mine command always activates MinerAI sub-controller
UC5  ..> UC13 : «include»

' Logic-processor override hijacks the normal AI update cycle
UC11 ..> UC8  : «extend»

' ── Notes ──────────────────────────────────────────────────────

note right of UC11
  Expires after 600 ticks (10 s)
  of inactivity; unit auto-reverts
  to default AI controller.
end note

note right of UC6
  Stances stored as Bits bitset.
  Mutual exclusion via
  incompatibleStanceBits.
end note

note bottom of UC5
  Available commands: move, repair,
  rebuild, assist, mine, enterPayload,
  load/unload payload variants.
end note

@enduml
