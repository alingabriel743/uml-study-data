@startuml
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
    StartColor #495057
    EndColor #212529
}
skinparam swimlane {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    TitleBackgroundColor #DEE2E6
    TitleFontColor #212529
}

title Mindustry — Core Processing, Build Visibility & Platform I/O Workflow

' ─────────────────────────────────────────────────
' LANE 1: AsyncCore — manages async game-frame loop
' ─────────────────────────────────────────────────
|AsyncCore|
start
:Initialize ExecutorService;
:Register AsyncProcesses:\nPhysicsProcess, AvoidanceProcess;

:begin() — Submit All Processes as Futures\nto Thread Pool;

' ─────────────────────────────────────────────────
' FORK: parallel async processes
' ─────────────────────────────────────────────────
fork
  |PhysicsProcess|
  :Execute Physics Simulation Step;
  :Update Entity Positions & Collision Results;
fork again
  |AvoidanceProcess|
  :Compute Unit Avoidance Paths;
  :Refresh Navigation / Steering Vectors;
end fork

' ─────────────────────────────────────────────────
' Back in AsyncCore: synchronize parallel results
' ─────────────────────────────────────────────────
|AsyncCore|
:end() — Block Until All Futures Complete;
:complete() — Synchronize Results & Finalize Frame;

' ─────────────────────────────────────────────────
' LANE 2: BuildVisibility — filter the build menu
' ─────────────────────────────────────────────────
|Build System (BuildVisibility)|
:Query visible() Predicate for Every Registered Block;

if (Editor Mode Active?\n(rules.editor == true)) then (yes)
  :Show editorOnly & worldProcessorOnly Blocks;
else (no)
  if (Campaign Mode?\n(state.isCampaign())) then (yes)
    :Show campaignOnly Blocks;
    if (Legacy Launch Pads Enabled?) then (yes)
      :Show legacyLaunchPadOnly Block;
    else (no)
      :Show notLegacyLaunchPadOnly Block;
    endif
  else (no)
    if (Sandbox / Infinite Resources?\n(rules.infiniteResources)) then (yes)
      :Show sandboxOnly Blocks;
    else (no)
      if (Fog-of-War Enabled?\n(rules.fog)) then (yes)
        :Show fogOnly Blocks;
      else (no)
        :Show only globally Shown Blocks;
      endif
    endif
  endif
endif

:Refresh Build Menu — Hide Invisible Blocks;

' ─────────────────────────────────────────────────
' LANE 3: iOS ChooserDelegate — document browser
' ─────────────────────────────────────────────────
|iOS File I/O (ChooserDelegate)|
if (File Operation Triggered\nby User?) then (yes)
  :Present UIDocumentBrowserViewController;

  if (User Picks Existing Document?) then (yes)
    :didPickDocumentURLs()\n/ didPickDocumentsAtURLs();
    :Extract Document URL from NSArray<NSURL>;
    :Forward URL to Application Layer;
  else (no)
    :User Dismissed Picker — No Selection;
  endif

  if (New Document Creation\nRequested?) then (yes)
    :didRequestDocumentCreationWithHandler();
    if (Document Import Succeeded?) then (yes)
      :didImportDocument()\n— Apply Imported File;
    else (no)
      :failedToImportDocument()\n— Log NSError & Notify User;
    endif
  endif

  :willPresentActivityViewController()\n— Configure Share Sheet Activities;
  :applicationActivities()\n— Provide Custom Activities;

else (no)
  :Skip File I/O — Continue Game Loop;
endif

' ─────────────────────────────────────────────────
' LANE 4: AssetsProcess — build-time code generation
' (runs at compile time via annotation processor)
' ─────────────────────────────────────────────────
|Annotation Processor (AssetsProcess)|
:process(RoundEnvironment env)\n— Entry Point at Compile Time;

fork
  :processUI(elements)\n— Generate UI Asset Constants;
  :Write generated Java source\nfor UI region IDs;
fork again
  :processSounds("Sounds", path, "Sound", genid)\n— Generate Sound Asset Constants;
  :capitalize(name)\n— Format Constant Identifier;
  :Write generated Java source\nfor Sound IDs;
end fork

:Annotation Processing Complete\n— Assets Java Classes Generated;

' ─────────────────────────────────────────────────
' Return to AsyncCore as the loop anchor
' ─────────────────────────────────────────────────
|AsyncCore|
stop
@enduml
