}

' ─────────────────────────────────────────────
' mindustry.editor
' ─────────────────────────────────────────────
package "mindustry.editor" {
    class MapObjectivesDialog {
        +canvas: MapObjectivesCanvas
        -out: Cons<Seq<MapObjective>>
        -{static} providers: ObjectMap<Class<?>, FieldProvider<?>>
        -{static} interpreters: ObjectMap<Class<?>, ObjectMap<Class<?>, FieldInterpreter<?>>>
        +show(objectives: Seq<MapObjective>, out: Cons<Seq<MapObjective>>): void
        +rebuildObjectives(objectives: Seq<MapObjective>): void
        +showContentSelect(type: ContentType, cons: Cons<T>, check: Boolf<T>): void
        +showTeamSelect(cons: Cons<Team>): void
        +showTeamSelect(allowNull: boolean, cons: Cons<Team>): void
        +setInterpreter(type: Class<T>, interpreter: FieldInterpreter<? super T>): void
        +setProvider(type: Class<T>, provider: FieldProvider<T>): void
        +hasInterpreter(type: Class<?>): boolean
        +getInterpreter(type: Class<T>): FieldInterpreter<?>
        +hasProvider(type: Class<?>): boolean
        +getProvider(type: Class<T>): FieldProvider<T>
        +name(cont: Table, name: CharSequence, remover: Runnable, indexer: Boolc): void
    }
}

' ─────────────────────────────────────────────
' mindustry.entities
' ─────────────────────────────────────────────
package "mindustry.entities" {
    class GroupDefs {
        +all: G
        +player: G
        +bullet: G
        +unit: G
        +build: G
        +sync: G
        +draw: G
        +fire: G
        +puddle: G
        +weather: G
        +label: G
        +powerGraph: G
    }
}

' ─────────────────────────────────────────────
' mindustry.io
' ─────────────────────────────────────────────
package "mindustry.io" {
    class JsonIO {
        -{static} jsonBase: CustomJson
        +{static} json: Json
        +writeBytes(value: Object, elementType: Class<?>, output: DataOutputStream): void
        +readBytes(type: Class<T>, elementType: Class<?>, input: DataInputStream): T
        +write(object: Object): String
        +copy(object: T, dest: T): T
        +copy(object: T): T
        +read(type: Class<T>, string: String): T
        +read(type: Class<T>, base: T, string: String): T
        +print(in: String): String
        +classTag(tag: String, type: Class<?>): void
        +apply(json: Json): void
    }
}

' ─────────────────────────────────────────────
' mindustry.mod
' ─────────────────────────────────────────────
package "mindustry.mod" {
    class ModClassLoader {
        -children: Seq<ClassLoader>
        -inChild: ThreadLocal<Boolean>
        +addChild(child: ClassLoader): void
        +findClass(name: String): Class<?>
    }

    class ClassMap {
        +{static} classes: ObjectMap<String, Class<?>>
    }
}

' ─────────────────────────────────────────────
' mindustry.net
' ─────────────────────────────────────────────
package "mindustry.net" {
    class Net {
        -{static} packetProvs: Seq<Prov<? extends Packet>>
        -{static} packetClasses: Seq<Class<? extends Packet>>
        -{static} packetToId: ObjectIntMap<Class<?>>
        -server: boolean
        -active: boolean
        -clientLoaded: boolean
        -currentStream: StreamBuilder
        -packetQueue: Seq<Packet>
        -clientListeners: ObjectMap<Class<?>, Cons>
        -serverListeners: ObjectMap<Class<?>, Cons2<NetConnection, Object>>
        -streams: IntMap<StreamBuilder>
        -provider: NetProvider
        +registerPacket(cons: Prov<T>): void
        +connect(ip: String, port: int, success: Runnable): void
        +host(port: int): void
        +closeServer(): void
        +reset(): void
        +disconnect(): void
        +discoverServers(cons: Cons<Host>, done: Runnable): void
        +send(object: Object, reliable: boolean): void
        +sendExcept(except: NetConnection, object: Object, reliable: boolean): void
        +handleClient(type: Class<T>, listener: Cons<T>): void
        +handleServer(type: Class<T>, listener: Cons2<NetConnection, T>): void
        +active(): boolean
        +server(): boolean
        +client(): boolean
        +dispose(): void
    }
}

' ─────────────────────────────────────────────
' mindustry.world.blocks
' ─────────────────────────────────────────────
package "mindustry.world.blocks" {
    class Attributes {
        -arr: float[]
        +clear(): void
        +get(attr: Attribute): float
        +set(attr: Attribute, value: float): void
        +add(other: Attributes): void
        +add(other: Attributes, scl: float): void
        +write(json: Json): void
        +read(json: Json, data: JsonValue): void
        +check(): void
        +toString(): String
    }
}

' ─────────────────────────────────────────────
' Inheritance relationships
' ─────────────────────────────────────────────
EntityProcess     --|> BaseProcessor
BaseProcessor     --|> AbstractProcessor
BaseAndroidClassLoader --|> ClassLoader
ModClassLoader    --|> ClassLoader
MapObjectivesDialog --|> BaseDialog

' ─────────────────────────────────────────────
' Interface implementations
' ─────────────────────────────────────────────
BaseAndroidClassLoader ..|> GeneratedClassLoader
Attributes         ..|> JsonSerializable
ValueVisitor       ..|> Visitor

' ─────────────────────────────────────────────
' Associations / dependencies
' ─────────────────────────────────────────────
MapObjectivesDialog o-- MapObjectivesCanvas : canvas
EntityProcess       o-- ClassSerializer     : serializer
EntityIO            o-- ClassSerializer     : serializer
CallGenerator       ..> MethodEntry         : uses

@enduml
