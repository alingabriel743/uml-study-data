@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Class Diagram

' ─────────────────────────────────────────────
' External base types (shown for context only)
' ─────────────────────────────────────────────
class AbstractProcessor <<external>> {
}
class ClassLoader <<external>> {
}
class BaseDialog <<external>> {
}
class MapObjectivesCanvas <<external>> {
}
class ClassSerializer <<external>> {
}
interface JsonSerializable <<external>> {
    +write(json: Json): void
    +read(json: Json, data: JsonValue): void
}
interface GeneratedClassLoader <<external>> {
}
interface Visitor <<external>> {
}

' ─────────────────────────────────────────────
' mindustry.annotations
' ─────────────────────────────────────────────
package "mindustry.annotations" {
    class BaseProcessor {
        +{static} packageName: String
        +{static} typeu: Types
        +{static} elementu: Elements
        +{static} filer: Filer
        +{static} messager: Messager
        +{static} trees: Trees
        #round: int
        #rounds: int
        #env: RoundEnvironment
        #rootDirectory: Fi
        +getMethodName(element: Element): String
        +isPrimitive(type: String): boolean
        +instanceOf(type: String, other: String): boolean
        +write(builder: TypeSpec.Builder): void
        +elements(type: Class): Set
        +types(type: Class): Set
        +fields(type: Class): Set
        +methods(type: Class): Set
        +err(message: String): void
        +init(env: ProcessingEnvironment): void
        +process(annotations: Set, roundEnv: RoundEnvironment): boolean
    }
}

' ─────────────────────────────────────────────
' mindustry.annotations.entity
' ─────────────────────────────────────────────
package "mindustry.annotations.entity" {
    class EntityProcess {
        -definitions: Seq<EntityDefinition>
        -groupDefs: Seq<GroupDefinition>
        -baseComponents: Seq<Stype>
        -componentNames: ObjectMap<String, Stype>
        -componentDependencies: ObjectMap<Stype, Seq<Stype>>
        -defComponents: ObjectMap<Selement, Seq<Stype>>
        -varInitializers: ObjectMap<String, String>
        -methodBlocks: ObjectMap<String, String>
        -imports: ObjectSet<String>
        -serializer: ClassSerializer
        +process(env: RoundEnvironment): void
        +getImports(elem: Element): Seq<String>
        +allComponents(type: Selement<?>): Seq<Stype>
        +getDependencies(component: Stype): Seq<Stype>
        +isCompInterface(type: Stype): boolean
        +createName(elem: Selement<?>): String
        +interfaceName(comp: Stype): String
        +baseName(comp: Stype): String
    }

    class EntityIO {
        -{static} json: Json
        -{static} targetSuf: String
        -{static} lastSuf: String
        -{static} replacements: StringMap
        -serializer: ClassSerializer
        -name: String
        -type: TypeSpec.Builder
        -directory: Fi
        -revisions: Seq<Revision>
        -write: boolean
        -method: MethodSpec.Builder
        -presentFields: ObjectSet<String>
        +write(method: MethodSpec.Builder, write: boolean, allFields: Seq<Svar>): void
        +writeSync(method: MethodSpec.Builder, write: boolean, allFields: Seq<Svar>): void
        +writeSyncManual(method: MethodSpec.Builder, write: boolean, syncFields: Seq<Svar>): void
        +writeInterpolate(method: MethodSpec.Builder, fields: Seq<Svar>): void
        +fieldHasAnno(field: RevisionField, allFields: Seq<Svar>, type: Class): boolean
        +io(type: String, field: String, network: boolean): void
    }
}

' ─────────────────────────────────────────────
' mindustry.annotations.remote
' ─────────────────────────────────────────────
package "mindustry.annotations.remote" {
    class CallGenerator {
        +generate(serializer: ClassSerializer, methods: Seq<MethodEntry>): void
        +makeWriter(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer): void
        +makeReader(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer): void
        +writeCallMethod(classBuilder: TypeSpec.Builder, ent: MethodEntry, toAll: boolean, forwarded: boolean): void
        +getCheckString(loc: Loc): String
        +writeHandleMethod(ent: MethodEntry, isClient: boolean): void
    }

    class MethodEntry {
        +className: String
        +targetMethod: String
        +packetClassName: String
        +where: Loc
        +target: Variant
        +local: Loc
        +unreliable: boolean
        +forward: boolean
        +id: int
        +element: Smethod
        +priority: PacketPriority
        +hashCode(): int
    }
}

' ─────────────────────────────────────────────
' mindustry.annotations.util
' ─────────────────────────────────────────────
package "mindustry.annotations.util" {
    class ValueVisitor {
        -meth: MethodSymbol
        -returnClass: Class<?>
        -value: Object
        +getValue(var1: Attribute): Object
        +visitConstant(var1: Constant): void
        +visitClass(var1: Class): void
        +visitArray(var1: Array): void
        +visitEnum(var1: Enum): void
        +visitCompound(var1: Compound): void
        +visitError(var1: Error): void
        +typeMismatch(var1: Method, var2: Attribute): void
    }
}

' ─────────────────────────────────────────────
' mindustry.android
' ─────────────────────────────────────────────
package "mindustry.android" {
    class BaseAndroidClassLoader {
        +defineClass(name: String, data: byte[]): Class<?>
        +loadClass(dex: Dex, name: String): Class<?>
        +getLastDex(): Dex
        +reset(): void
        +linkClass(aClass: Class<?>): void
        +loadClass(name: String, resolve: boolean): Class<?>
    }
}

' ─────────────────────────────────────────────
' mindustry.content
' ─────────────────────────────────────────────
package "mindustry.content" {
    class UnitTypes {
        +{static} mace: UnitType
        +{static} dagger: UnitType
        +{static} crawler: UnitType
        +{static} fortress: UnitType
        +{static} corvus: UnitType
        +{static} flare: UnitType
        +{static} risso: UnitType
        +{static} stell: UnitType
        +{static} missile: UnitType
        +{static} latum: UnitType
        +{static} manifold: UnitType
        +{static} block: UnitType
        +load(): void
    }
}

' ─────────────────────────────────────────────
' mindustry.ctype
' ─────────────────────────────────────────────
package "mindustry.ctype" {
    enum ContentType {
        item
        block
        bullet
        liquid
        status
