@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam ArrowColor #495057
skinparam ArrowFontColor #495057

title Mindustry – Use Case Diagram

left to right direction

' ─── Actors ───────────────────────────────────────────────
actor "Player" as Player
actor "Admin / Host" as Admin
actor "Map Editor User" as MapEditorUser
actor "AI System" as AI
actor "Steam Platform" as Steam
actor "Mobile Platform\n(Android / iOS)" as Mobile

' ─── System boundary ──────────────────────────────────────
rectangle "Mindustry Game" {

    ' ── Campaign & Core Gameplay ──────────────────────────
    package "Campaign & Core Gameplay" {
        usecase "Launch Campaign" as UC_Campaign
        usecase "Select & Enter Sector" as UC_Sector
        usecase "Research Technology\n(Tech Tree)" as UC_TechTree
        usecase "Survive Enemy Waves" as UC_Waves
        usecase "Capture / Lose Sector" as UC_Capture
    }

    ' ── Building & Resource Management ───────────────────
    package "Building & Resource Management" {
        usecase "Place / Remove Blocks" as UC_Build
        usecase "Mine Resources" as UC_Mine
        usecase "Manage Item Transport\n(Conveyors / Routers)" as UC_Transport
        usecase "Generate & Distribute Power" as UC_Power
        usecase "Produce Liquids &\nProcess Materials" as UC_Production
        usecase "Fabricate Units" as UC_Fabricate
    }

    ' ── Unit Control ──────────────────────────────────────
    package "Unit Control" {
        usecase "Command Units" as UC_Command
        usecase "Control Player Unit\n(Move / Shoot / Mine)" as UC_PlayerUnit
        usecase "Issue Build Orders" as UC_BuildOrder
    }

    ' ── Multiplayer ───────────────────────────────────────
    package "Multiplayer" {
        usecase "Host Multiplayer Server" as UC_Host
        usecase "Join Multiplayer Server" as UC_Join
        usecase "Chat with Other Players" as UC_Chat
        usecase "Save & Load Game\n(Multiplayer)" as UC_SaveLoad
    }

    ' ── Admin / Server Management ─────────────────────────
    package "Server Administration" {
        usecase "Manage Players\n(Kick / Ban)" as UC_ManagePlayers
        usecase "Configure Game Rules" as UC_Rules
        usecase "Load / Switch Map" as UC_LoadMap
        usecase "Run Dedicated Server\n(Headless)" as UC_Headless
    }

    ' ── Map Editor ────────────────────────────────────────
    package "Map Editor" {
        usecase "Create / Edit Map" as UC_EditMap
        usecase "Generate Map\nProcedurally" as UC_GenMap
        usecase "Configure Wave\n& Objectives" as UC_WaveConfig
        usecase "Resize / Export Map" as UC_ExportMap
        usecase "Preview Map in-game" as UC_PreviewMap
    }

    ' ── Mods & Schematics ─────────────────────────────────
    package "Mods & Schematics" {
        usecase "Import / Export Schematic" as UC_Schematic
        usecase "Install & Manage Mods" as UC_Mods
        usecase "Browse Steam Workshop" as UC_Workshop
    }

    ' ── Platform & Save ───────────────────────────────────
    package "Platform Services" {
        usecase "Save / Load Progress\n(Local)" as UC_LocalSave
        usecase "Pick File\n(Document Browser)" as UC_FilePick
        usecase "Earn Achievements" as UC_Achievements
        usecase "Configure Settings\n& Key Bindings" as UC_Settings
    }
}

' ─── Player associations ──────────────────────────────────
Player --> UC_Campaign
Player --> UC_Sector
Player --> UC_TechTree
Player --> UC_Build
Player --> UC_Mine
Player --> UC_Transport
Player --> UC_Power
Player --> UC_Production
Player --> UC_Fabricate
Player --> UC_Command
Player --> UC_PlayerUnit
Player --> UC_Join
Player --> UC_Chat
Player --> UC_Schematic
Player --> UC_LocalSave
Player --> UC_Settings

' ─── Admin / Host associations ────────────────────────────
Admin --> UC_Host
Admin --> UC_ManagePlayers
Admin --> UC_Rules
Admin --> UC_LoadMap
Admin --> UC_Headless
Admin --> UC_SaveLoad

' ─── Map Editor User associations ────────────────────────
MapEditorUser --> UC_EditMap
MapEditorUser --> UC_GenMap
MapEditorUser --> UC_WaveConfig
MapEditorUser --> UC_ExportMap
MapEditorUser --> UC_PreviewMap
MapEditorUser --> UC_Mods

' ─── AI System associations ───────────────────────────────
AI --> UC_Waves
AI --> UC_BuildOrder
AI --> UC_Capture

' ─── Steam Platform associations ─────────────────────────
Steam --> UC_Workshop
Steam --> UC_Achievements

' ─── Mobile Platform associations ────────────────────────
Mobile --> UC_FilePick

' ─── Include/Extend relationships ────────────────────────
UC_Campaign .> UC_Sector    : <<include>>
UC_Sector   .> UC_Waves     : <<include>>
UC_Waves    .> UC_Capture   : <<include>>
UC_Build    .> UC_Transport : <<extend>>
UC_Build    .> UC_Power     : <<extend>>
UC_Host     .> UC_Rules     : <<include>>
UC_Host     .> UC_LoadMap   : <<include>>
UC_Workshop .> UC_Mods      : <<extend>>
UC_LocalSave .> UC_SaveLoad : <<extend>>

@enduml
