@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #FFF3CD
    DiamondBorderColor #856404
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
    TitleFontSize 13
}

title Combat and Damage System

|Turret / Bullet Spawner|
start
:Turret fires — BulletHandler.shoot();
:BulletComp.add() — bullet entity created\nBulletType.init(bullet)\nSet vel, origin, team, owner, justSpawned=true;

|BulletComp — Per-Tick Update|
repeat
  :BulletComp.update();
  if (justSpawned?) then (yes)
    :Clear justSpawned flag\n(skip movement this frame);
  else (no)
    :pos += vel × delta\nApply velocity drag\nRun assigned Mover;
    :BulletType.update(bullet);
    if (stickyTarget != null?) then (yes)
      :Track target position\nRotate velocity toward stickyTarget;
    else (no)
      if (collidesTiles?) then (yes)
        :Tile Raycast — Bresenham walk\nlastPos → currentPos;
        if (floor / terrain hit?) then (yes)
          :hit = true → remove();
        else if (building in path?) then (yes)
          :build.collision(bullet)\nBulletType.hitTile(bullet, build);
          if (!pierceBuilding?) then (yes)
            :hit = true → remove();
          else (no)
            :collided.add(build.id)\nContinue flight;
          endif
        endif
      endif
    endif
  endif
  if (pierceCap exceeded?\ncollided.size >= pierceCap) then (yes)
    :hit = true → remove();
  else (no)
  endif

|EntityCollisions|
  :updatePhysics(group)\nRebuild QuadTree per team;
  :collide(group) — for each bullet:\nupdateCollision(bullet)\nbullet.getCollisions → intersect enemy trees;
  if (overlap candidate found?) then (yes)
    :checkCollide(a, b)\na.collides(b) && b.collides(a)\nSweep AABB → collision point (x, y)\na.collision(b,x,y)   b.collision(a,x,y);

|BulletComp — Per-Tick Update|
    if (sticky bullet?) then (yes)
      :stickTo(target)\nstickyTarget = target\nvel = zero;
    else (no)
      :BulletType.hit(bullet, x, y);
      if (pierce?) then (yes)
        :collided.add(target.id)\nContinue flight;
      else (no)
        :hit = true → remove();
      endif
      :BulletType.hitEntity(bullet, target, prevHealth);
    endif
  else (no)
  endif

repeat while (alive && lifetime > 0?) is (yes)
-> expired or removed;

:Bullet.remove()\nif !hit → BulletType.despawned(bullet)\nBulletType.removed(bullet)\nClear collided list;

|Damage System|
:Damage.damage(team, x, y, radius, amount, air, ground)\nUnits.nearbyEnemies(team, rect)\nFilter: checkTarget(air,ground) && hittable() && within(x,y,radius);
:calculateDamage per unit:\nfalloff = 0.4\nscaled = lerp(1 - dist/radius, 1, falloff);
if (armorMult provided?) then (yes)
  :unit.damageArmorMult(scaled, armorMult)\n(bypasses armor);
else (no)
  :unit.damage(scaled);
endif
:Events.fire(UnitDamageEvent)\nunit.controller().hit(source);
if (unit.dead after damage?) then (yes)
  :Events.fire(UnitBulletDestroyEvent);
endif
:Apply knockback vector\nproportional to distance from center;
if (ground damage requested?) then (yes)
  if (completeDamage mode?) then (yes)
    :Damage.completeDamage\nIterate bounding square tiles\nDamage every enemy building uniformly;
  else (no)
    :Damage.tileDamage — radial raycast\nAccumulate per building with falloff\nbuild.damage(source, team, value);
  endif
endif

if (dynamicExplosion triggered?) then (yes)
  :Damage.dynamicExplosion(x, y,\nflammability, explosiveness, power, radius, damage);
  if (damage && power > 0?) then (yes)
    :Spawn Lightning strikes\ncount = clamp(power / 700, 0, 8);
  else (no)
  endif
  if (damage && fire && flammability > 0?) then (yes)
    :Call.createBullet(Bullets.fireball)\nper fire instance;
  else (no)
  endif
  if (explosiveness > 2?) then (yes)
    :waves = clamp(explosiveness / 11, 1, 25)\ndamagePerWave = explosiveness / 2;
    repeat

|BaseShield|
      :Check for shields in blast zone\n(ignoreTeam.getEnemy BlockFlag.shield);
      if (shield absorbs this wave?) then (yes)
        :ExplosionShield.absorbExplosion(x, y, damage)\nWave fully blocked;
      else (no)

|Damage System|
        :Damage.damage(ignoreTeam, x, y,\nradius + explosiveness, damagePerWave, false);
      endif
    repeat while (more explosion waves?) is (yes)
    -> waves done;
  else (no)
  endif
  if (explosiveness > 15?) then (yes)
    :Fx.shockwave effect;
    if (explosiveness > 30?) then (yes)
      :Fx.bigShockwave effect;
    else (no)
    endif
  else (no)
  endif
  :Effect.shake(min(explosiveness/4 + base, 9))\nexplosionFx.at(x, y);
else (no)
endif

if (suppression to apply?) then (yes)
  :Damage.applySuppression(team, x, y, range, reload, ...)\nindexer.eachBlock → enemy buildings in range\nbuild.applyHealSuppression(reload+1, color);
  :Collect suppressable / recently-healed builds\nscaledChance = particleChance / builds.size;
  :Per build: if Mathf.chance(scaledChance)\n→ Time.run(random delay)\n→ Fx.regenSuppressSeek.at(build, ...);
else (no)
endif

|BaseShield|
:BaseShieldBuild.updateTile() — each tick\nSmooth radius lerp;
if (shield radius > 1?) then (yes)
  :Groups.bullet.intersect(x-r, y-r, r*2, r*2)\nbulletConsumer checks each nearby bullet;
  if (bullet.team != shieldTeam\n&& bullet.type.absorbable\n&& bullet.within(shield, radius)?) then (yes)
    :bullet.absorb()\nabsorbed = true, remove();
  else (no)
  endif
  :Units.nearbyEnemies(team, x, y, r+10)\nCompute overlapDst per unit;
  if (overlapDst > unit.hitSize × 1.5?) then (yes)
    :unit.kill()\n(instakill — deeply inside shield);
  else if (overlapDst > 0?) then (yes)
    :unit.vel.setZero()\nunit.move(repel vector outward);
  else (no)
  endif
else (no)
endif

stop
@enduml
