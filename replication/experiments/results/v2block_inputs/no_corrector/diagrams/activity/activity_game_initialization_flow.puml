@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Game Initialization Flow

|ClientLauncher|
start
:init()\nnextFrame = Time.nanos();
:setup() — environment setup\nRead MINDUSTRY_DATA_DIR\ncheckLaunch(), loadLogger(), loadFileLogger()\nCreate LoadRenderer\nFire ClientCreateEvent\nSet platform, maxTextureSize\nLog GL/RAM/Java info;

:setup() — core asset infrastructure\nUI.loadColors()\nnew SpriteBatch()\nnew AssetManager()\nRegister Texture/Sound/Music loaders\nCreate FileTree, Net, Mods, Schematics\nFonts.loadSystemCursors()\nLoad default font;

if (maxTextureSize >= 4096?) then (yes)
    :Load sprites/sprites.aatls\n(full resolution);
else (no)
    :Load sprites/fallback/sprites.aatls\n(reduced resolution);
endif

|AssetManager (async)|
fork
    :loadRun('contentcreate') — background thread\ncontent.createBaseContent()\n[UnitCommand, Items, StatusEffects, Liquids,\nBullets, UnitTypes, Blocks, Planets, SectorPresets,\nSerpuloTechTree, ErekirTechTree]\ncontent.loadColors();
    :After completion (main thread):\nmods.loadScripts()\ncontent.createModContent();
fork again
    |ClientLauncher|
    :setup() — add core modules\nInstantiate and add:\nlogic = new Logic()\ncontrol = new Control()\nrenderer = new Renderer()\nui = new UI()\nnetServer = new NetServer()\nnetClient = new NetClient();
end fork

|Control (constructor)|
:Register event listeners\nCreate Saves, SoundControl, AttackIndicators\nRegister: BuildDamageEvent, ClientLoadEvent\nStateChangeEvent, PlayEvent, WorldLoadEvent\nSaveLoadEvent, ResetEvent, WaveEvent\nGameOverEvent, UnlockEvent, SectorCaptureEvent;

|AssetManager (async)|
:loadRun('contentinit')\ncontent.init()\n[Content::init, Content::postInit,\nlogicVars.init(), fire ContentInitEvent]\nAfter: content.load()\n[Content::loadIcon, Content::load];

|ClientLauncher|
:Loading loop begins\n(capped at 20fps);

repeat
    :loader.draw()\n(show loading screen);
    :assets.update(1000/20ms)\n(process asset queue with time budget);
repeat while (assets.update() returns true?) is (no — still loading)
-> yes — all assets done;

:module initialization\nloader.dispose()\nSoundPriority.init()\nFor each ApplicationListener: listener.init()\n→ triggers Control.init(), mods.eachClass(Mod::init);

|Control|
:loadAsync()\nDraw.scl set from atlas\nCore.input.setCatch(back, true)\nsettings.defaults(ip, color, name, lastBuild)\nsaves.load();

:loadSync() → createPlayer()\nPlayer.create()\nSet player.name from settings\nSet locale, player.color;

if (mobile platform?) then (yes)
    :input = new MobileInput();
else (no)
    :input = new DesktopInput();
endif

:Register ClientLoadEvent listener\n→ input.add();

:init()\nplatform.updateRPC();

if (uiscalechanged setting?) then (yes)
    :Show countdown reset dialog\n(60s timeout);
else (no)
    :Continue normally;
endif

|ClientLauncher|
:Finalize — fire events\nfinished = true\nEvents.fire(ClientLoadEvent)\nclientLoaded = true\nsuper.resize()\napp.post x4: super.resize() + finishLaunch();

|GameState|
:Initial state = State.menu\n(GameState initialized with state=menu);

|ClientLauncher|
:Application ready\n(Game at main menu);

stop

@enduml
