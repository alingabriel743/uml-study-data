@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #E9ECEF
    TitleFontColor #212529
}

title Power Network Flow

|ConsumeGenerator\n(Generation)|
start
:Game Tick;

:updateTile();
if (efficiency > 0?) then (yes — fuel available)
    :warmup lerps toward 1;
    :productionEfficiency = efficiency × efficiencyMultiplier;
    if (hasItems AND generateTime <= 0?) then (yes)
        :consume() items;
        :consumeEffect.at();
        :reset generateTime = 1f;
    else (no)
    endif
    if (outputLiquid != null?) then (yes)
        :add produced liquid;
        :dumpLiquid();
        if (explodeOnFull AND liquid >= capacity?) then (yes)
            :kill();
            :fire GeneratorPressureExplodeEvent;
            stop
        else (no)
        endif
    else (no)
    endif
else (no — no fuel)
    :warmup lerps toward 0;
    :productionEfficiency stays low;
endif
:generateTime -= delta / (itemDuration × itemDurationMultiplier);
:getPowerProduction() = powerProduction × productionEfficiency;

|BeamNode\n(Routing)|
:updateTile();
if (lastChange != world.tileChanges?) then (yes — world changed)
    :updateDirections();
    repeat
        :Scan next cardinal direction (4 total);
        if (insulated wall in path?) then (yes)
            :break — no link in this direction;
        else (no)
            if (hasPower + connectedPower + sameTeam\n+ NOT PowerNode?) then (yes — valid target)
                :set links[i], dests[i]; break;
                if (prev link existed?) then (yes)
                    :remove pos from prev.power.links;
                    :new PowerGraph();
                    :reflow(this);
                    if (different graph?) then (yes)
                        :reflow(prev);
                    else (no)
                    endif
                else (no)
                endif
                if (next link exists?) then (yes)
                    :add bidirectional pos links;
                    :power.graph.addGraph(next.power.graph);
                else (no)
                endif
            else (no — skip tile)
            endif
        endif
    repeat while (more directions to scan?) is (yes)
    ->no (all 4 done);
else (no — no change)
    :skip updateDirections;
endif

|PowerGraph\n(Distribution — via PowerGraphUpdater)|
:PowerGraph.update();
:getPowerNeeded()\n= Σ consumer.requestedPower(consumer) × delta;
:getPowerProduced()\n= Σ producer.getPowerProduction() × delta;
:lastPowerStored = getBatteryStored()\n= Σ battery.power.status × consPower.capacity;

if (powerNeeded > powerProduced?) then (yes — deficit)
    :useBatteries(deficit):\nreduce battery.power.status proportionally;
elseif (powerProduced > powerNeeded?) then (yes — surplus)
    :chargeBatteries(surplus):\nincrease battery.power.status proportionally\n(capped at 1);
else (balanced)
    :no battery change;
endif

:distributePower(needed, produced, charged)\ncoverage = min(1, produced/needed);
repeat
    :next consumer;
    if (buffered consumer / battery?) then (yes)
        :power.status += requestedPower × coverage × delta / capacity\n(clamped 0–1);
    else (no — non-buffered)
        if (shouldConsumePower?) then (yes — active)
            :power.status = coverage;
        else (no — inactive)
            :power.status = estimate\n(produced / (needed + usage × delta));
        endif
    endif
repeat while (more consumers?) is (yes)
->no (all done);

:powerBalance.add((produced − needed + energyDelta) / delta)\n[60-tick windowed mean];

|Battery\n(Passive Status)|
if (power.status ≈ 0?) then (yes)
    :BlockStatus.noInput\n(battery empty);
elseif (power.status ≈ 1?) then (yes)
    :BlockStatus.active\n(battery full);
else (no)
    :BlockStatus.noOutput\n(charging / partial);
endif

|BeamNode\n(Routing)|
:getSatisfaction() = clamp(produced / needed, 0, 1);
if (produced == 0?) then (yes)
    :satisfaction = 0;
elseif (needed == 0?) then (yes)
    :satisfaction = 1;
else (partial)
    :satisfaction = produced / needed;
endif

:beam draw color = lerp(laserColor1, laserColor2)\nbased on (1 – satisfaction);

if (getPowerBalance() > 0?) then (yes)
    :BeamNode status = active;
elseif (getPowerBalance() < 0 AND lastPowerStored > 0?) then (yes)
    :BeamNode status = noOutput\n(draining batteries);
else (no)
    :BeamNode status = noInput\n(no power);
endif

|ConsumeGenerator\n(Generation)|
:All consumers updated\nwith coverage power.status;
stop

@enduml
