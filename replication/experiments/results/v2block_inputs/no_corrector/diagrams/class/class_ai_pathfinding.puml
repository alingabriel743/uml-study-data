@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title AI & Pathfinding Systems

interface UnitController {
    +updateUnit()
    +unit(): Unit
}

interface Runnable {
    +run()
}

package "mindustry.ai (Pathfinding & Support)" {

    class Pathfinder {
        {static} +int fieldCore = 0
        {static} +int costGround = 0
        {static} +int costLegs = 1
        {static} +int costNaval = 2
        {static} +int costHover = 5
        {static} +int impassable = -1
        -int[] tiles
        -Flowfield[][][] cache
        -Thread thread
        -boolean needsRefresh
        +int packTile(Tile tile)
        +void updateTile(Tile tile)
        +Flowfield getField(Team team, int cost, int type)
        +void preloadPath(Flowfield path)
        +void start()
        +void stop()
        +void run()
    }

    abstract class Flowfield {
    }

    class EnemyCoreField {
    }

    class ControlPathfinder {
        {static} +int wallImpassableCap = 1_000_000
        {static} +int solidCap = 7000
        {static} +int clusterSize = 12
        -Cluster[][][] clusters
        -ObjectMap<Unit, PathRequest> unitRequests
        -LongMap<FieldCache> fields
        -PathfindQueue innerFrontier
        -IntFloatMap innerCosts
        -Thread thread
        -volatile boolean invalidated
        +boolean getPathPosition(Unit unit, Vec2 destination, Vec2 out, boolean[] noResultFound)
        +void updateTile(Tile tile)
        +Cluster updateCluster(int team, int pathCost, int cx, int cy)
        {static} +boolean isNearObstacle(Unit unit, int x1, int y1, int x2, int y2)
        {static} +int raycastFast(int team, PathCost type, int x1, int y1, int x2, int y2)
        -void recalculatePath(PathRequest request)
        +void run()
    }

    class PathRequest {
        +Unit unit
        +int destination
        +int team
        +int costId
        +IntSeq resultPath
        +PathfindQueue frontier
        +IntFloatMap costs
        +IntIntMap cameFrom
        +volatile boolean notFound
        +volatile boolean invalidated
    }

    class FieldCache {
        +PathCost cost
        +int costId
        +int team
        +int goalPos
        +IntMap<int[]> fields
        +long mapKey
    }

    class Cluster {
        +IntSeq[] portals
        +LongSeq[][] portalConnections
    }

    class PathfindQueue {
        -int[] queue
        -float[] weights
        -int size
        +boolean add(int e, float weight)
        +int poll()
        +int peek()
        +void clear()
        +boolean empty()
        -void siftUp(int k, int x, float weight)
        -void siftDown(int k, int x, float weight)
    }

    class Astar <<utility>> {
        {static} -DistanceHeuristic manhattan
        {static} -Seq<Tile> out
        {static} -float[] costs
        {static} +Seq<Tile> pathfind(Tile from, Tile to, TileHeuristic th, Boolf<Tile> passable)
        {static} +Seq<Tile> pathfind(int startX, int startY, int endX, int endY, TileHeuristic th, Boolf<Tile> passable)
        {static} +Seq<Tile> pathfind(int startX, int startY, int endX, int endY, TileHeuristic th, DistanceHeuristic dh, Boolf<Tile> passable)
    }

    interface DistanceHeuristic {
        +float cost(int x1, int y1, int x2, int y2)
    }

    interface TileHeuristic {
        +float cost(Tile tile)
        +float cost(Tile from, Tile tile)
    }

    class BlockIndexer {
        -IntSeq[][][] ores
        -IntSeq[][][] wallOres
        -Seq<Building>[] damagedTiles
        -Seq<Building>[][] flagMap
        -Seq<Team> activeTeams
        +Seq<Building> getFlagged(Team team, BlockFlag type)
        +Seq<Building> getEnemy(Team team, BlockFlag type)
        +Building findTile(Team team, float x, float y, float range, Boolf<Building> pred)
        +Building findEnemyTile(Team team, float x, float y, float range, Boolf<Building> pred)
        +Building findClosestFlag(float x, float y, Team team, BlockFlag flag)
        +Tile findClosestOre(float xp, float yp, Item item)
        +void notifyHealthChanged(Building build)
        +void removeIndex(Tile tile)
        +void addIndex(Tile tile)
    }

    class WaveSpawner {
        -Seq<Tile> spawns
        -boolean spawning
        -boolean any
        -Tile firstSpawn
        +void spawnEnemies()
        +void spawnUnit(SpawnGroup group, float x, float y)
        +void doShockwave(float x, float y)
        +int countSpawns()
        +int countGroundSpawns()
        +int countFlyerSpawns()
        +Seq<Tile> getSpawns()
        +boolean isSpawning()
        +void reset()
    }

    class BaseBuilderAI {
        -TeamData data
        -Interval timer
        -IntSet path
        -IntSet calcPath
        -Tile calcTile
        -boolean calculating
        -boolean foundPath
        -int calcCount
        -int totalCalcs
        +void update()
        -Position randomPosition()
        -boolean tryPlace(BasePart part, int x, int y)
    }
}

package "mindustry.entities.units (Base Controller)" {
    abstract class AIController {
        #Unit unit
        #Interval timer
        #AIController fallback
        #Teamc target
        #Teamc bomberTarget
        #float noTargetTime
        #boolean turningAway
        +void updateUnit()
        {abstract} +void updateMovement()
        +void updateTargeting()
        +void pathfind(int field, boolean findTarget, boolean stuck)
        +void moveTo(Position target, float offsetDst, float breakDst, boolean keepDist, Vec2 hitboxTarget, boolean arrive)
        +void circleAttack(float circleLength)
        +Teamc findTarget(float x, float y, float range, boolean air, boolean ground)
        +Teamc findMainTarget(float x, float y, float range, boolean air, boolean ground)
        +Teamc targetFlag(float x, float y, BlockFlag flag, boolean enemy)
        +boolean retarget()
        +boolean invalid(Teamc target)
        +boolean shouldFire()
        +boolean shouldShoot()
        +AIController fallback()
        +boolean useFallback()
        +void faceTarget()
        +boolean hasStance(UnitStance stance)
    }
}

package "mindustry.ai.types (AI Subtypes)" {
    class FlyingAI {
        {static} -Rand rand
        {static} -BlockFlag[] randomTargets
        +void updateMovement()
        +Teamc findTarget(float x, float y, float range, boolean air, boolean ground)
        +Teamc findMainTarget(float x, float y, float range, boolean air, boolean ground)
    }

    class GroundAI {
        -float stuckTime
        -float stuckX
        -float stuckY
        {static} -float stuckRange
        +void updateMovement()
    }

    class MissileAI {
        -Unit shooter
        +void updateMovement()
        +Teamc target(float x, float y, float range, boolean air, boolean ground)
        +boolean retarget()
        #void resetTimers()
    }

    class LogicAI {
        -LUnitControl control
        -float moveX
        -float moveY
        -float moveRad
        -float controlTimer
        -Building controller
        -BuildPlan plan
        -boolean boost
        -boolean shoot
        -Teamc mainTarget
        +void updateMovement()
        +boolean keepState()
        +Teamc target(float x, float y, float range, boolean air, boolean ground)
        +boolean checkTarget()
    }

    class BuilderAI {
        {static} -float buildRadius = 1500
        {static} -float retreatDst = 110
        -Unit assistFollowing
        -Unit following
        -Teamc enemy
        -float fleeRange
        -boolean alwaysFlee
        -boolean onlyAssist
        +void init()
        +void updateMovement()
        +AIController fallback()
        +boolean useFallback()
        +boolean shouldFire()
        +boolean shouldShoot()
        #boolean nearEnemy(int x, int y)
    }

    class CommandAI {
        -Seq<Position> commandQueue
        -Vec2 targetPos
        -Teamc attackTarget
        -UnitGroup group
        -UnitCommand command
        -Bits stances
        -AIController commandController
        -boolean stopAtTarget
        -boolean blockingUnit
        -float timeSpentBlocked
        +void updateUnit()
        +void defaultBehavior()
        +void command(UnitCommand command)
        +void commandPosition(Vec2 pos, boolean stopWhenInRange)
        +void commandTarget(Teamc moveTo, boolean stopAtTarget)
        +void commandQueue(Position location)
        +void finishPath()
        +boolean hasStance(UnitStance stance)
        +Teamc findMainTarget(float x, float y, float range, boolean air, boolean ground)
    }
}

' ─── Interface implementations ───
AIController ..|> UnitController
Pathfinder ..|> Runnable
ControlPathfinder ..|> Runnable

' ─── Inheritance (AI types) ───
FlyingAI --|> AIController
GroundAI --|> AIController
MissileAI --|> AIController
LogicAI --|> AIController
BuilderAI --|> AIController
CommandAI --|> AIController

' ─── Inheritance (Pathfinder inner) ───
EnemyCoreField --|> Flowfield

' ─── Composition: inner classes ───
Pathfinder *-- Flowfield : <<contains>>
ControlPathfinder *-- PathRequest : <<contains>>
ControlPathfinder *-- FieldCache : <<contains>>
ControlPathfinder *-- Cluster : <<contains>>

' ─── Astar inner interfaces ───
Astar +-- DistanceHeuristic : <<inner interface>>
Astar +-- TileHeuristic : <<inner interface>>
Astar ..> DistanceHeuristic : uses
Astar ..> TileHeuristic : uses

' ─── PathfindQueue usage ───
ControlPathfinder o-- PathfindQueue : innerFrontier
PathRequest o-- PathfindQueue : frontier

' ─── Pathfinding usage by AI types ───
GroundAI ..> Pathfinder : pathfind(fieldCore)
BaseBuilderAI ..> Pathfinder : getField(→ completeWeights)
LogicAI ..> ControlPathfinder : getPathPosition
CommandAI ..> ControlPathfinder : getPathPosition / isNearObstacle

' ─── Support system dependencies ───
BaseBuilderAI ..> WaveSpawner : eachGroundSpawn
AIController ..> BlockIndexer : targetFlag (getFlagged / getEnemy)

' ─── BuilderAI fallback ───
BuilderAI ..> FlyingAI : <<fallback>>
BuilderAI ..> GroundAI : <<fallback>>

@enduml
