@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
    FontSize 10
}

title Android, Desktop, iOS & Server Platform Launchers

' ─── External / Framework types (referenced only) ────────────────
package "libGDX / Platform Framework" <<Frame>> {
    abstract class ApplicationCore {
    }
    interface Platform {
    }
    interface ApplicationListener {
        +init()
        +update()
        +pause()
        +resume()
        +dispose()
    }
    class AndroidApplication {
    }
    abstract class "IOSApplication.Delegate" as IOSApplicationDelegate {
    }
    class ContextFactory {
    }
    abstract class ClassLoader {
    }
    interface GeneratedClassLoader {
    }
}

' ─── Core: shared client launcher ────────────────────────────────
package "mindustry" {
    abstract class ClientLauncher {
        -long nextFrame
        -long beginTime
        -long lastTargetFps
        -boolean finished
        -LoadRenderer loader
        --
        +void setup()
        +void add(ApplicationListener module)
        +void resize(int width, int height)
        +void update()
        +void exit()
        +void init()
        +void resume()
        +void pause()
        +void fileDropped(Fi file)
    }
}

' ─── Android platform ─────────────────────────────────────────────
package "mindustry.android" {
    class AndroidLauncher {
        +{static} int PERMISSION_REQUEST_CODE = 1
        ~boolean doubleScaleTablets = true
        ~FileChooser chooser
        ~Runnable permCallback
        --
        #void onCreate(Bundle savedInstanceState)
        +void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults)
        -void checkFiles(Intent intent)
        -boolean isTablet(Context context)
    }

    class AndroidRhinoContext <<utility>> {
        +{static} Context enter(File cacheDirectory)
    }

    class AndroidContextFactory {
        -File cacheDirectory
        --
        +AndroidContextFactory(File cacheDirectory)
        +BaseAndroidClassLoader createClassLoader(ClassLoader parent)
        #void onContextReleased(Context cx)
    }

    abstract class BaseAndroidClassLoader {
        --
        +BaseAndroidClassLoader(ClassLoader parent)
        +Class<?> defineClass(String name, byte[] data)
        +{abstract} Class<?> loadClass(Dex dex, String name)
        +{abstract} Dex getLastDex()
        +{abstract} void reset()
        +void linkClass(Class<?> aClass)
        +Class<?> loadClass(String name, boolean resolve)
    }

    class FileAndroidClassLoader {
        -{static} int instanceCounter
        -File dexFile
        --
        +FileAndroidClassLoader(ClassLoader parent, File cacheDir)
        #Class<?> loadClass(Dex dex, String name)
        #Dex getLastDex()
        #void reset()
    }

    class InMemoryAndroidClassLoader {
        -Dex last
        --
        +InMemoryAndroidClassLoader(ClassLoader parent)
        #Class<?> loadClass(Dex dex, String name)
        #Dex getLastDex()
        #void reset()
    }
}

' ─── Desktop platform ────────────────────────────────────────────
package "mindustry.desktop" {
    class DesktopLauncher {
        +{static} long discordID
        +String[] args
        ~boolean useDiscord
        ~boolean loadError
        ~Throwable steamError
        --
        +{static} void main(String[] arg)
        +DesktopLauncher(String[] args)
        +NetProvider getNet()
        +void showFileChooser(boolean open, String title, String extension, Cons<Fi> cons)
        +void showMultiFileChooser(Cons<Fi> cons, String... extensions)
        +String getUUID()
        +void updateLobby()
        +void updateRPC()
        ~void initSteam(String[] args)
        +{static} void handleCrash(Throwable e)
    }
}

' ─── iOS platform ────────────────────────────────────────────────
package "mindustry.ios" {
    class IOSLauncher {
        -boolean forced
        --
        #IOSApplication createApplication()
        +UIInterfaceOrientationMask getSupportedInterfaceOrientations(UIApplication, UIWindow)
        +boolean openURL(UIApplication, NSURL, UIApplicationOpenURLOptions)
        +boolean didFinishLaunching(UIApplication, UIApplicationLaunchOptions)
        ~void openURL(NSURL url)
        +{static} void main(String[] argv)
    }
}

' ─── Server platform ─────────────────────────────────────────────
package "mindustry.server" {
    class ServerLauncher {
        ~{static} String[] args
        --
        +{static} void main(String[] args)
        +void init()
    }

    class ServerControl {
        +{static} ServerControl instance
        +CommandHandler handler
        +Fi logFolder
        -Interval autosaveCount
        +Runnable serverInput
        +Fi currentLogFile
        +boolean inGameOverWait
        +Gamemode lastMode
        -Task lastTask
        -Thread socketThread
        -ServerSocket serverSocket
        -PrintWriter socketOutput
        +Cons<GameOverEvent> gameOverListener
        --
        +ServerControl(String[] args)
        #void setup(String[] args)
        ~void loadPatchFiles()
        #void registerCommands()
        +void handleCommandString(String line)
        +void cancelPlayTask()
        +void play(Runnable run)
        +void play(boolean wait, Runnable run)
        +void logToFile(String text)
        +void toggleSocket(boolean on)
    }
}

' ─── Notes ────────────────────────────────────────────────────────
note right of ClientLauncher
  Abstract base for all client launchers.
  Orchestrates asset loading and module
  initialization (Logic, Control, Renderer,
  UI, NetServer, NetClient).
  Fires ClientCreateEvent and ClientLoadEvent.
end note

note bottom of AndroidLauncher
  Android entry point (Activity).
  Instantiates an anonymous ClientLauncher
  subclass passed to initialize().
  Handles tablet scaling, DexClassLoader for
  mod JARs, file chooser and permissions.
end note

note bottom of AndroidRhinoContext
  No instances — bootstraps Rhino JS engine.
  Sets AndroidContextFactory as global
  ContextFactory if not already registered.
end note

note right of AndroidContextFactory
  Selects ClassLoader variant:
  InMemoryAndroidClassLoader (API >= 26)
  FileAndroidClassLoader (API < 26)
end note

note bottom of FileAndroidClassLoader
  Android API < 26.
  Translates bytecode to Dex, writes to file,
  loads via DexClassLoader.
end note

note bottom of InMemoryAndroidClassLoader
  Android API >= 26 (O+).
  Translates bytecode to Dex, loads in-memory
  via InMemoryDexClassLoader — no file I/O.
end note

note right of DesktopLauncher
  SDL desktop entry point.
  Integrates: Steam (SNet, SStats, SWorkshop,
  SUser), Discord RPC, native file dialogs
  (zenity on Linux / FileDialogs otherwise),
  and crash handling.
end note

note right of IOSLauncher
  RoboVM iOS entry point.
  Creates IOSApplication with an anonymous
  ClientLauncher subclass.
  Handles landscape forcing, file sharing via
  UIActivityViewController, and URL-based
  save/map import.
end note

note right of ServerLauncher
  Headless entry point.
  Runs HeadlessApplication, registers Logic,
  NetServer, and ServerControl listeners.
  Fires ServerLoadEvent.
end note

note right of ServerControl
  Manages server lifecycle: command handling
  (help/host/status/ban/admin/…), autosave,
  auto-pause, socket remote input, and
  game-over → next-map transitions.
end note

' ─── Relationships ────────────────────────────────────────────────

' ClientLauncher inherits from framework
ClientLauncher --|> ApplicationCore : extends
ClientLauncher ..|> Platform : implements

' Desktop directly extends ClientLauncher
DesktopLauncher --|> ClientLauncher : extends

' Android extends framework; uses ClientLauncher anonymously
AndroidLauncher --|> AndroidApplication : extends
AndroidLauncher ..> ClientLauncher : <<creates anonymous subclass>>

' iOS extends framework; uses ClientLauncher anonymously
IOSLauncher --|> IOSApplicationDelegate : extends
IOSLauncher ..> ClientLauncher : <<creates anonymous subclass>>

' Server path (independent of ClientLauncher)
ServerLauncher ..|> ApplicationListener : implements
ServerControl ..|> ApplicationListener : implements
ServerLauncher ..> ServerControl : <<creates & registers>>

' Android Rhino class-loading infrastructure
AndroidContextFactory --|> ContextFactory : extends
AndroidRhinoContext *-- AndroidContextFactory : <<inner class>>

BaseAndroidClassLoader --|> ClassLoader : extends
BaseAndroidClassLoader ..|> GeneratedClassLoader : implements

FileAndroidClassLoader --|> BaseAndroidClassLoader : extends
InMemoryAndroidClassLoader --|> BaseAndroidClassLoader : extends

AndroidContextFactory ..> BaseAndroidClassLoader : <<creates>>
AndroidLauncher ..> AndroidRhinoContext : <<uses for getScriptContext()>>

@enduml
