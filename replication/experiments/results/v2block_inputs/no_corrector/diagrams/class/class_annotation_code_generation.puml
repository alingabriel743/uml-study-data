@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam enum {
    BackgroundColor #EEF2FF
    BorderColor #6C757D
}

title Annotation Code-Generation Processors & Utilities

' ─── External base (javax) ───────────────────────────────────────────────────
abstract class AbstractProcessor <<javax.annotation.processing>> {
}

' ─── mindustry.annotations ───────────────────────────────────────────────────
package "mindustry.annotations" {

    class BaseProcessor {
        +{static} String packageName = "mindustry.gen"
        +{static} Types typeu
        +{static} Elements elementu
        +{static} Filer filer
        +{static} Messager messager
        +{static} Trees trees
        #int round
        #int rounds
        #RoundEnvironment env
        #Fi rootDirectory
        --
        +process(annotations: Set<TypeElement>, roundEnv: RoundEnvironment)
        +{abstract} process(env: RoundEnvironment)
        +init(env: ProcessingEnvironment)
        +write(builder: TypeSpec.Builder)
        +write(builder: TypeSpec.Builder, imports: Seq<String>)
        +elements(type: Class<Annotation>): List
        +types(type: Class<Annotation>): List
        +fields(type: Class<Annotation>): List
        +methods(type: Class<Annotation>): List
        +err(message: String)
        +err(message: String, elem: Element)
        +err(message: String, elem: Selement)
        +getMethodName(element: Element): String
        +isPrimitive(type: String): boolean
        +instanceOf(type: String, other: String): boolean
        +getDefault(value: String): String
        +typeSize(kind: String): int
        +simpleName(str: String): String
        +tname(pack: String, simple: String): String
        +tname(name: String): String
        +tname(c: Class<?>): String
        +getTVN(element: TypeParameterElement): String
        +getSupportedSourceVersion(): SourceVersion
    }

    enum PacketPriority {
        low
        normal
        high
    }

    enum Loc {
        server
        client
        both
        none
    }

    enum Variant {
        one
        all
        both
    }
}

' ─── mindustry.annotations.impl ──────────────────────────────────────────────
package "mindustry.annotations.impl" {

    class AssetsProcess {
        +process(env: RoundEnvironment)
        +processUI(elements: Set<? extends Element>)
        +processSounds(classname: String, path: String, rtype: String, genid: boolean)
        -capitalize(s: String): String
    }

    class StructProcess {
        +process(env: RoundEnvironment)
        +bitString(offset: int, size: int, totalSize: int): String
        +bitString(size: int, totalSize: int): String
        +varSize(var: Svar): int
        +typeForSize(size: int): String
        +typeSize(kind: TypeKind): int
    }
}

' ─── mindustry.annotations.misc ──────────────────────────────────────────────
package "mindustry.annotations.misc" {

    class LoadRegionProcessor {
        +process(env: RoundEnvironment)
        -count(str: String, substring: String): int
        -parse(value: String): String
    }

    class LogicStatementProcessor {
        +process(env: RoundEnvironment)
    }
}

' ─── mindustry.annotations.remote ────────────────────────────────────────────
package "mindustry.annotations.remote" {

    class RemoteProcess {
        +{static} String callLocation = "Call"
        --
        +process(roundEnv: RoundEnvironment)
    }

    class CallGenerator {
        +generate(serializer: ClassSerializer, methods: Seq<MethodEntry>)
        +makeWriter(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer)
        +makeReader(typespec: TypeSpec.Builder, ent: MethodEntry, serializer: ClassSerializer)
        +writeCallMethod(classBuilder: TypeSpec.Builder, ent: MethodEntry, toAll: boolean, forwarded: boolean)
        +getCheckString(loc: Loc): String
        +writeHandleMethod(ent: MethodEntry, isClient: boolean)
    }

    class MethodEntry {
        +className: String
        +targetMethod: String
        +packetClassName: String
        +where: Loc
        +target: Variant
        +local: Loc
        +unreliable: boolean
        +forward: boolean
        +id: int
        +element: Smethod
        +priority: PacketPriority
        --
        +MethodEntry(className, targetMethod, packetClassName,\n  where, target, local, unreliable, forward, id, element, priority)
        +hashCode(): int
    }

    class SerializerResolver {
        +locate(elem: ExecutableElement, mirror: TypeMirror, write: boolean): String
        +isEntity(mirror: TypeMirror): boolean
    }
}

' ─── mindustry.annotations.util ──────────────────────────────────────────────
package "mindustry.annotations.util" {

    class TypeIOResolver {
        +{static} resolve(processor: BaseProcessor): ClassSerializer
        +{static} fix(str: String): String
    }

    class ClassSerializer {
        ' companion / inner class of TypeIOResolver
        +writers: ObjectMap<String, String>
        +readers: ObjectMap<String, String>
        +mutatorReaders: ObjectMap<String, String>
        +netWriters: ObjectMap<String, String>
        +netReaders: ObjectMap<String, String>
        --
        +ClassSerializer(writers, readers, mutatorReaders, netWriters, netReaders)
        +getNetWriter(type: String, fallback: String): String
        +getNetReader(type: String, fallback: String): String
    }

    class AnnotationProxyMaker {
        -anno: Compound
        -annoType: Class<? extends Annotation>
        --
        +AnnotationProxyMaker(anno: Compound, annoType: Class<? extends Annotation>)
        +{static} generateAnnotation(anno: Compound, type: Class<A>): A
        +generateAnnotation(): Annotation
        -getAllReflectedValues(): Map
        -getAllValues(): Map
        -generateValue(method: MethodSymbol, attr: Attribute): Object
        -mirrorProxy(t: Type): AnnotationMirror
        -mirrorProxy(t: List<Type>): List
        -proxify(prov: Prov<T>): T
    }

    class "Selement<T>" as Selement {
        +e: T
        --
        +Selement(e: T)
        +doc(): String
        +enclosed(): List
        +fullName(): String
        +asType(): Stype
        +asVar(): Svar
        +asMethod(): Smethod
        +isVar(): boolean
        +isType(): boolean
        +isMethod(): boolean
        +annotations(): List
        +annotation(type: Class<A>): A
        +has(type: Class<A>): boolean
        +up(): Selement
        +mirror(): TypeMirror
        +tname(): String
        +cname(): String
        +name(): String
        +toString(): String
        +hashCode(): int
        +equals(o: Object): boolean
    }

    class Smethod {
        --
        +Smethod(e: ExecutableElement)
        +isAny(mod: Modifier...): boolean
        +is(mod: Modifier): boolean
        +descString(): String
        +type(): TypeMirror
        +thrown(): List<Stype>
        +thrownt(): List
        +typeVariables(): List
        +params(): Seq<Svar>
        +isVoid(): boolean
        +ret(): TypeMirror
        +retn(): String
        +tree(): MethodTree
        +simpleString(): String
    }

    class Stype {
        --
        +Stype(e: TypeElement)
        +{static} of(mirror: TypeMirror): Stype
        +fullName(): String
        +interfaces(): List<Stype>
        +allInterfaces(): List<Stype>
        +isInterface(): boolean
        +superclasses(): List<Stype>
        +allSuperclasses(): List<Stype>
        +superclass(): Stype
        +fields(): Seq<Svar>
        +methods(): Seq<Smethod>
        +constructors(): Seq<Smethod>
        +mirror(): TypeMirror
    }

    class Svar {
        --
        +Svar(e: VariableElement)
        +descString(): String
        +enclosingType(): Stype
        +isAny(mods: Modifier...): boolean
        +is(mod: Modifier): boolean
        +tree(): VariableTree
    }
}

' ─── Inheritance ─────────────────────────────────────────────────────────────
BaseProcessor     --|> AbstractProcessor

AssetsProcess         --|> BaseProcessor
StructProcess         --|> BaseProcessor
LoadRegionProcessor   --|> BaseProcessor
LogicStatementProcessor --|> BaseProcessor
RemoteProcess         --|> BaseProcessor

Smethod --|> Selement
Stype   --|> Selement
Svar    --|> Selement

' ─── Factory ─────────────────────────────────────────────────────────────────
TypeIOResolver ..> ClassSerializer : <<creates>>

' ─── Composition / Field ownership ───────────────────────────────────────────
MethodEntry o-- Smethod  : element

' ─── Usage / Dependency ──────────────────────────────────────────────────────
RemoteProcess    ..> CallGenerator      : delegates to
RemoteProcess    ..> TypeIOResolver     : uses
RemoteProcess    ..> SerializerResolver : uses
CallGenerator    ..> ClassSerializer   : uses
CallGenerator    ..> MethodEntry       : processes

StructProcess    ..> Svar              : varSize(Svar)
BaseProcessor    ..> Selement          : err(Selement)

' ─── Enum associations ───────────────────────────────────────────────────────
MethodEntry --> Loc            : where / local
MethodEntry --> Variant        : target
MethodEntry --> PacketPriority : priority
CallGenerator ..> Loc          : getCheckString(Loc)

@enduml
