@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Annotation Processing Framework

package "javax.annotation.processing" <<external>> {
    abstract class AbstractProcessor {
        +process(Set<TypeElement>, RoundEnvironment): boolean
        +init(ProcessingEnvironment): void
    }
}

package "mindustry.annotations" {
    abstract class BaseProcessor {
        +{static} typeu: Types
        +{static} elementu: Elements
        +{static} filer: Filer
        +{static} messager: Messager
        +{static} trees: Trees
        +{static} packageName: String
        #round: int
        #rounds: int
        #env: RoundEnvironment
        #rootDirectory: Fi
        --
        +init(ProcessingEnvironment): void
        +process(Set<TypeElement>, RoundEnvironment): boolean
        #{abstract} process(RoundEnvironment): void
        +elements(Class<Annotation>): Seq<Selement>
        +types(Class<Annotation>): Seq<Stype>
        +fields(Class<Annotation>): Seq<Svar>
        +methods(Class<Annotation>): Seq<Smethod>
        +{static} write(TypeSpec.Builder, Seq<String>): void
        +{static} err(String): void
        +{static} isPrimitive(String): boolean
        +{static} instanceOf(String, String): boolean
        +{static} tname(String): TypeName
        +{static} getDefault(String): String
    }
}

package "mindustry.annotations.entity" {
    class EntityProcess {
        -definitions: Seq<EntityDefinition>
        -groupDefs: Seq<GroupDefinition>
        -baseComponents: Seq<Stype>
        -componentNames: ObjectMap<String, Stype>
        -componentDependencies: ObjectMap<Stype, Seq<Stype>>
        -defComponents: ObjectMap<Selement, Seq<Stype>>
        -varInitializers: ObjectMap<String, String>
        -methodBlocks: ObjectMap<String, String>
        -imports: ObjectSet<String>
        -serializer: ClassSerializer
        -rounds: int = 3
        --
        #process(RoundEnvironment): void
        +getDependencies(Stype): Seq<Stype>
        +interfaceName(Stype): String
        +baseName(Stype): String
        +getImports(TypeElement): Seq<String>
        +isCompInterface(Stype): boolean
        +skipDeprecated(TypeSpec.Builder): void
    }

    class EntityDefinition {
        +name: String
        +classID: int
        +legacy: boolean
        +extend: TypeName
        +builder: TypeSpec.Builder
        +naming: Selement
        +fieldSpecs: Seq<FieldSpec>
        --
        +EntityDefinition(name, builder, naming, extend,\n  components, groups, fieldSpec, legacy)
    }

    class GroupDefinition {
        +name: String
        +baseType: ClassName
        +spatial: boolean
        +mapping: boolean
        +collides: boolean
        +manualInclusions: ObjectSet<Selement>
        --
        +GroupDefinition(name, bestType, components,\n  spatial, mapping, collides)
    }

    class EntityIO {
        -{static} json: Json
        -{static} targetSuf: String
        -{static} lastSuf: String
        -serializer: ClassSerializer
        -name: String
        -type: TypeSpec.Builder
        -directory: Fi
        -revisions: Seq<Revision>
        -presentFields: ObjectSet<String>
        --
        +EntityIO(name, type, typeFields, serializer, directory)
        +write(MethodSpec.Builder, boolean, Seq<Svar>): void
        +writeSync(MethodSpec.Builder, boolean, Seq<Svar>): void
        +fieldHasAnno(RevisionField, Seq<Svar>, Class<Annotation>): boolean
        -io(String, String, boolean): void
        -st(String, Object...): void
        -cont(String, Object...): void
        -econt(): void
    }

    class Revision {
        +version: int
        +fields: Seq<RevisionField>
        --
        +equal(Seq<FieldSpec>): boolean
    }

    class RevisionField {
        +name: String
        +type: String
    }
}

package "mindustry.annotations.util" {
    class "Selement<T extends Element>" as Selement {
        +e: T
        --
        +doc(): String
        +enclosed(): Seq<Selement<?>>
        +fullName(): String
        +asType(): Stype
        +asVar(): Svar
        +asMethod(): Smethod
        +isVar(): boolean
        +isType(): boolean
        +isMethod(): boolean
        +annotations(): Seq<AnnotationMirror>
        +annotation(Class<A>): A
        +has(Class<A>): boolean
        +name(): String
        +tname(): TypeName
        +cname(): ClassName
    }

    class Stype {
        --
        +{static} of(TypeMirror): Stype
        +fullName(): String
        +interfaces(): Seq<Stype>
        +allInterfaces(): Seq<Stype>
        +isInterface(): boolean
        +superclasses(): Seq<Stype>
        +superclass(): Stype
        +fields(): Seq<Svar>
        +methods(): Seq<Smethod>
        +constructors(): Seq<Smethod>
    }

    class Smethod {
        --
        +is(Modifier): boolean
        +isAny(Modifier...): boolean
        +descString(): String
        +type(): Stype
        +params(): Seq<Svar>
        +isVoid(): boolean
        +ret(): TypeMirror
        +retn(): TypeName
        +tree(): MethodTree
        +simpleString(): String
    }

    class Svar {
        --
        +descString(): String
        +enclosingType(): Stype
        +is(Modifier): boolean
        +isAny(Modifier...): boolean
        +tree(): VariableTree
    }

    class TypeIOResolver {
        +{static} resolve(BaseProcessor): ClassSerializer
    }

    class ClassSerializer {
        +writers: ObjectMap<String, String>
        +readers: ObjectMap<String, String>
        +mutatorReaders: ObjectMap<String, String>
        +netWriters: ObjectMap<String, String>
        --
        +getNetWriter(String, String): String
        +getNetReader(String, String): String
    }
}

' ── Inheritance ──────────────────────────────────────────────
BaseProcessor --|> AbstractProcessor
EntityProcess --|> BaseProcessor
Stype --|> Selement
Smethod --|> Selement
Svar --|> Selement

' ── Composition (inner classes) ──────────────────────────────
EntityProcess *-- EntityDefinition : contains
EntityProcess *-- GroupDefinition  : contains
EntityIO      *-- Revision         : contains
EntityIO      *-- RevisionField    : contains

' ── Aggregation ──────────────────────────────────────────────
EntityDefinition o-- Stype          : components
EntityDefinition o-- GroupDefinition : groups
GroupDefinition  o-- Stype          : components
Revision         o-- RevisionField  : fields

' ── Dependencies / Usage ─────────────────────────────────────
EntityProcess ..> EntityIO         : uses
EntityProcess ..> ClassSerializer  : uses
EntityIO      ..> ClassSerializer  : depends on
TypeIOResolver ..> ClassSerializer : produces
BaseProcessor  ..> Selement        : returns
BaseProcessor  ..> Stype           : returns
BaseProcessor  ..> Svar            : returns
BaseProcessor  ..> Smethod         : returns
EntityProcess  ..> TypeIOResolver  : resolves via

@enduml
