@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Campaign, Map Objectives & Schematics

package "Campaign" {
    class Universe {
        -int seconds
        -int netSeconds
        -float secondCounter
        -int turn
        -float turnCounter
        -Schematic lastLoadout
        -ItemSeq lastLaunchResources
        +updateGlobal(): void
        +update(): void
        +turn(): int
        +runTurn(): void
        +clearLoadoutInfo(): void
        +getLaunchResources(): ItemSeq
        +updateLaunchResources(ItemSeq): void
        +updateLoadout(CoreBlock): void
        +getLastLoadout(): Schematic
        +getLoadout(CoreBlock): Schematic
        +seconds(): int
        +secondsf(): float
        +secondsMod(float, float): float
        +updateNetSeconds(int): void
        -save(): void
        -load(): void
    }

    class CampaignRules {
        +Difficulty difficulty
        +boolean fog
        +boolean showSpawns
        +boolean sectorInvasion
        +boolean randomWaveAI
        +boolean legacyLaunchPads
        +boolean rtsAI
        +boolean clearSectorOnLose
        +boolean pauseDisabled
        +apply(Planet, Rules): void
    }
}

package "Map Objectives" {
    class MapObjectives {
        +Seq<MapObjective> all
        +{static} Seq<Prov<MapObjective>> allObjectiveTypes
        +{static} Seq<Prov<ObjectiveMarker>> allMarkerTypes
        +{static} ObjectMap<String,Prov<ObjectiveMarker>> markerNameToType
        +add(MapObjective...): void
        +update(): void
        +get(int index): MapObjective
        +any(): boolean
        +clear(): void
        +eachRunning(Cons<MapObjective>): void
        +{static} registerObjective(Prov...): void
        +{static} registerMarker(Prov...): void
        +{static} registerLegacyMarker(String, Prov): void
    }

    abstract class MapObjective {
        +boolean hidden
        +String details
        +String completionLogicCode
        +String[] flagsAdded
        +String[] flagsRemoved
        +ObjectiveMarker[] markers
        #Seq<MapObjective> parents
        -boolean completed
        -boolean depFinished
        +{abstract} update(): boolean
        +reset(): void
        +done(): void
        +dependencyFinished(): boolean
        +isCompleted(): boolean
        +qualified(): boolean
        +child(MapObjective): MapObjective
        +parent(MapObjective): MapObjective
        +details(String): MapObjective
        +flagsAdded(String...): MapObjective
        +flagsRemoved(String...): MapObjective
        +markers(ObjectiveMarker...): MapObjective
        +text(): String
        +typeName(): String
        +validate(): void
    }

    class ResearchObjective {
        +UnlockableContent content
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class ProduceObjective {
        +UnlockableContent content
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class ItemObjective {
        +Item item
        +int amount
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class CoreItemObjective {
        +Item item
        +int amount
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class BuildCountObjective {
        +Block block
        +int count
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class UnitCountObjective {
        +UnitType unit
        +int count
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class DestroyUnitsObjective {
        +int count
        +update(): boolean
        +text(): String
    }
    class TimerObjective {
        +String text
        +float duration
        +float countup
        +update(): boolean
        +reset(): void
        +text(): String
    }
    class DestroyBlockObjective {
        +Point2 pos
        +Team team
        +Block block
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class DestroyBlocksObjective {
        +Point2[] positions
        +Team team
        +Block block
        +progress(): int
        +update(): boolean
        +text(): String
        +validate(): void
    }
    class CommandModeObjective {
        +update(): boolean
        +text(): String
    }
    class FlagObjective {
        +String flag
        +String text
        +update(): boolean
        +text(): String
    }
    class DestroyCoreObjective {
        +update(): boolean
        +text(): String
    }
}

package "Markers" {
    abstract class ObjectiveMarker {
        +boolean world
        +boolean minimap
        +boolean autoscale
        +float drawLayer
        ~int arrayIndex
        +{abstract} draw(float scaleFactor): void
        +control(LMarkerControl, double, double, double): void
        +setText(String, boolean): void
        +setTexture(Object): void
        +typeName(): String
        +write(Json): void
        +read(Json, JsonValue): void
    }

    abstract class PosMarker {
        +Vec2 pos
        +control(LMarkerControl, double, double, double): void
    }

    class ShapeTextMarker {
        +String text
        +float fontSize
        +float textHeight
        +byte flags
        +int textAlign
        +int lineAlign
        +float radius
        +float rotation
        +int sides
        +Color color
    }
    class PointMarker {
        +float radius
        +float stroke
        +Color color
    }
    class ShapeMarker {
        +float radius
        +float rotation
        +float stroke
        +float startAngle
        +float endAngle
        +boolean fill
        +boolean outline
        +int sides
        +Color color
    }
    class TextMarker {
        +String text
        +float fontSize
        +byte flags
        +int textAlign
        +int lineAlign
    }
    class LineMarker {
        +Vec2 endPos
        +float stroke
        +boolean outline
        +Color color1
        +Color color2
    }
    class TextureMarker {
        +float rotation
        +float width
        +float height
        +TextureHolder texture
        +Color color
    }
    class QuadMarker {
        +TextureHolder texture
        +float[] vertices
    }

    class TextureHolder {
        +Object value
        +write(Json): void
        +read(Json, JsonValue): void
    }

    class MapMarkers {
        +IntMap<ObjectiveMarker> map
        +Seq<ObjectiveMarker> all
        +add(int id, ObjectiveMarker): void
        +remove(int id): void
        +get(int id): ObjectiveMarker
        +has(int id): boolean
        +size(): int
        +write(DataOutput): void
        +read(DataInput): void
    }
}

package "Schematics" {
    class Schematics {
        +Seq<Schematic> all
        +ObjectMap<CoreBlock,Seq<Schematic>> loadouts
        +ObjectMap<CoreBlock,Schematic> defaultLoadouts
        +load(): void
        +loadSync(): void
        +overwrite(Schematic, Schematic): void
        +saveChanges(Schematic): void
        +savePreview(Schematic, Fi): void
        +getPreview(Schematic): Texture
        +toPlans(Schematic, int, int): Seq<BuildPlan>
        +getLoadouts(CoreBlock): Seq<Schematic>
        +getDefaultLoadout(CoreBlock): Schematic
        +isDefaultLoadout(Schematic): boolean
        +add(Schematic): void
        +remove(Schematic): void
        +create(int, int, int, int): Schematic
        +writeBase64(Schematic): String
        +{static} readBase64(String): Schematic
        +{static} read(Fi): Schematic
        +{static} write(Schematic, Fi): void
        +{static} rotate(Schematic, int): Schematic
        +{static} place(Schematic, int, int, Team): void
        +{static} placeLoadout(Schematic, int, int, Team): void
    }

    class Schematic {
        +Seq<Stile> tiles
        +Seq<String> labels
        +StringMap tags
        +int width
        +int height
        +Fi file
        +LoadedMod mod
        +powerProduction(): float
        +powerConsumption(): float
        +requirements(): ItemSeq
        +hasCore(): boolean
        +findCore(): CoreBlock
        +name(): String
        +description(): String
        +save(): void
        +compareTo(Schematic): int
    }

    class Stile {
        +Block block
        +short x
        +short y
        +Object config
        +byte rotation
        +set(Stile): Stile
        +copy(): Stile
    }
}

package "Sector" {
    class SectorInfo {
        +ObjectMap<Item,ExportStat> production
        +ObjectMap<Item,ExportStat> rawProduction
        +ObjectMap<Item,ExportStat> export
        +ObjectMap<Item,ExportStat> imports
        +ItemSeq items
        +Block bestCoreType
        +int storageCapacity
        +boolean hasCore
        +Sector origin
        +Sector destination
        +Seq<UnlockableContent> resources
        +boolean waves
        +boolean attack
        +boolean hasSpawns
        +int attempts
        +int wave
        +int winWave
        +float waveSpacing
        +int spawnPosition
        +float minutesCaptured
        +float lightCoverage
        +String name
        +String icon
        +UnlockableContent contentIcon
        +int waveVersion
        +boolean shown
        +sectorDataMatches(Sector): boolean
        +handleCoreItem(Item, int): void
        +handleProduction(Item, int): void
        +handleItemExport(ItemStack): void
        +handleItemImport(Item, int): void
        +getExport(Item): float
        +hasExport(Item): boolean
        +refreshImportRates(Planet): void
        +getImportRate(Planet, Item): float
        +write(): void
        +prepare(Sector): void
        +update(): void
        +exportRates(): ObjectFloatMap<Item>
        +anyExports(): boolean
        +eachImport(Planet, Cons<Sector>): void
    }

    class ExportStat {
        +float mean
        ~float counter
        ~WindowedMean means
        ~boolean loaded
    }
}

' ── Objective hierarchy ──────────────────────────────────────────────────────
MapObjective <|-- ResearchObjective
MapObjective <|-- ProduceObjective
MapObjective <|-- ItemObjective
MapObjective <|-- CoreItemObjective
MapObjective <|-- BuildCountObjective
MapObjective <|-- UnitCountObjective
MapObjective <|-- DestroyUnitsObjective
MapObjective <|-- TimerObjective
MapObjective <|-- DestroyBlockObjective
MapObjective <|-- DestroyBlocksObjective
MapObjective <|-- CommandModeObjective
MapObjective <|-- FlagObjective
MapObjective <|-- DestroyCoreObjective

' ── Marker hierarchy ─────────────────────────────────────────────────────────
ObjectiveMarker <|-- PosMarker
PosMarker <|-- ShapeTextMarker
PosMarker <|-- PointMarker
PosMarker <|-- ShapeMarker
PosMarker <|-- TextMarker
PosMarker <|-- LineMarker
PosMarker <|-- TextureMarker
ObjectiveMarker <|-- QuadMarker

TextureMarker --> TextureHolder : texture
QuadMarker --> TextureHolder : texture

' ── MapObjectives containment ────────────────────────────────────────────────
MapObjectives *-- MapObjective : contains

' ── MapObjective → markers (embedded array) ──────────────────────────────────
MapObjective o-- ObjectiveMarker : markers[ ]

' ── MapMarkers runtime manager ───────────────────────────────────────────────
MapMarkers *-- ObjectiveMarker : manages (id → marker)

' ── Schematic data hierarchy ─────────────────────────────────────────────────
Schematics *-- Schematic : all
Schematic *-- Stile : tiles

' ── SectorInfo inner / dependencies ─────────────────────────────────────────
SectorInfo *-- ExportStat : production / export / imports
SectorInfo --> Sector : origin, destination

' ── Universe cross-dependencies ──────────────────────────────────────────────
Universe --> Schematic : lastLoadout
Universe ..> Schematics : uses (via Vars.schematics)
Universe ..> SectorInfo : reads/writes per-sector
Universe ..> CampaignRules : reads campaign settings

@enduml
