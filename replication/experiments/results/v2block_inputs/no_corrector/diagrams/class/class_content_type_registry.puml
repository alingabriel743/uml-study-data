' ─────────────────────────────────────────────
' ContentLoader — central registry
' ─────────────────────────────────────────────
package "mindustry.core" {

    class ContentLoader {
        -Seq<Content>[] contentMap
        -ObjectMap<String, MappableContent>[] contentNameMap
        -ObjectMap<String, MappableContent> nameMap
        -MappableContent[][] temporaryMapper
        -LoadedMod currentMod
        -Content lastAdded
        -ObjectSet<Cons<Content>> initialization
        --
        +void createBaseContent()
        +void createModContent()
        +void init()
        +void load()
        +void loadColors()
        +void handleContent(Content content)
        +void handleMappableContent(MappableContent content)
        +<T extends Content> T getByID(ContentType type, int id)
        +<T extends MappableContent> T getByName(ContentType type, String name)
    }
}

' ─────────────────────────────────────────────
' Relationships
' ─────────────────────────────────────────────

' Liquid references StatusEffect
Liquid o--> StatusEffect : effect

' ContentType references Content subclasses
ContentType ..> Content : contentClass

' ContentLoader holds all content indexed by ContentType
ContentLoader o--> "Seq<Content>[]" Content : contentMap
ContentLoader ..> ContentType : indexed by ordinal()

' Content self-registers via constructor
Content ..> ContentLoader : registers self\n(via Vars.content)

' Registry singletons create instances of their type
Items ..> Item : creates & holds
Liquids ..> Liquid : creates & holds
StatusEffects ..> StatusEffect : creates & holds
Blocks ..> Block : creates & holds
UnitTypes ..> UnitType : creates & holds
Bullets ..> BulletType : creates & holds
Weathers ..> Weather : creates & holds

' ContentLoader calls registry load() methods
ContentLoader ..> Items : Items.load()
ContentLoader ..> Liquids : Liquids.load()
ContentLoader ..> StatusEffects : StatusEffects.load()
ContentLoader ..> Blocks : Blocks.load()
ContentLoader ..> UnitTypes : UnitTypes.load()
ContentLoader ..> Bullets : Bullets.load()
ContentLoader ..> Weathers : Weathers.load()

@enduml
