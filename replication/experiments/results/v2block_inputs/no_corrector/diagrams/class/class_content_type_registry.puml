@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Content Type Hierarchy & Registry

' ─────────────────────────────────────────────
' Core content hierarchy
' ─────────────────────────────────────────────
package "mindustry.ctype" {

    abstract class Content {
        +short id
        +ModContentInfo minfo
        --
        +{abstract} ContentType getContentType()
        +void init()
        +void postInit()
        +void load()
        +void loadIcon()
        +boolean isVanilla()
        +boolean isModded()
        +boolean hasErrored()
        .. constructor side-effect ..
        ~registers self in ContentLoader
    }

    abstract class MappableContent {
        +{final} String name
        --
        .. constructor side-effect ..
        ~registers in ContentLoader.nameMap
    }

    abstract class UnlockableContent {
        +Stats stats
        +String localizedName
        +String description
        +String details
        #boolean unlocked
        +boolean alwaysUnlocked
        +boolean hideDetails
        +boolean hideDatabase
        +boolean generateIcons
        +TextureRegion uiIcon
        +TextureRegion fullIcon
        +TechNode techNode
        +Seq<TechNode> techNodes
        +ObjectSet<Planet> shownPlanets
        --
        +void unlock()
        +void quietUnlock()
        +void clearUnlock()
        +boolean unlocked()
        +boolean locked()
        +boolean isBanned()
        +boolean isHidden()
        +boolean unlockedNow()
        +boolean unlockedHost()
        +boolean showUnlock()
        +boolean isOnPlanet(Planet planet)
        +ItemStack[] researchRequirements()
        +void getDependencies(Cons<UnlockableContent> cons)
        +String emoji()
        +void setStats()
        +void createIcons(MultiPacker packer)
    }

    enum ContentType {
        item(Item.class)
        block(Block.class)
        bullet(BulletType.class)
        liquid(Liquid.class)
        status(StatusEffect.class)
        unit(UnitType.class)
        weather(Weather.class)
        sector(SectorPreset.class)
        planet(Planet.class)
        team(TeamEntry.class)
        unitCommand(UnitCommand.class)
        unitStance(UnitStance.class)
        mech_UNUSED(null)
        error(null)
        --
        +Class<? extends Content> contentClass
        +{static} ContentType[] all
    }

    Content ..|> "Comparable<Content>"
    MappableContent --|> Content
    UnlockableContent --|> MappableContent
}

' ─────────────────────────────────────────────
' Concrete content types
' ─────────────────────────────────────────────
package "mindustry.type" {

    class Item {
        +Color color
        +float explosiveness
        +float flammability
        +float radioactivity
        +float charge
        +int hardness
        +float cost
        +boolean lowPriority
        +boolean buildable
        +boolean hidden
        --
        +ContentType getContentType()
    }

    class Liquid {
        +boolean gas
        +Color color
        +Color gasColor
        +float flammability
        +float temperature
        +float heatCapacity
        +float viscosity
        +float explosiveness
        +float boilPoint
        +boolean coolant
        +boolean blockReactive
        +StatusEffect effect
        --
        +ContentType getContentType()
    }

    class StatusEffect {
        +float damage
        +float damageMultiplier
        +float speedMultiplier
        +float healthMultiplier
        +Color color
        +float transitionDamage
        +float statusDuration
        --
        +ContentType getContentType()
    }

    class UnitType {
        .. (many unit config fields) ..
        --
        +ContentType getContentType()
    }

    class Weather {
        .. (particle / visual fields) ..
        --
        +ContentType getContentType()
    }

    Item --|> UnlockableContent
    Item ..|> "Senseable"
    Liquid --|> UnlockableContent
    Liquid ..|> "Senseable"
    StatusEffect --|> UnlockableContent
    UnitType --|> UnlockableContent
    UnitType ..|> "Senseable"
    Weather --|> UnlockableContent
}

package "mindustry.world" {

    class Block {
        .. (size, health, build config, etc.) ..
        --
        +ContentType getContentType()
    }

    Block --|> UnlockableContent
    Block ..|> "Senseable"
}

package "mindustry.entities.bullet" {

    class BulletType {
        +float damage
        +float speed
        +float lifetime
        +boolean hitUnits
        +boolean hitBuildings
        .. (many ballistics fields) ..
        --
        +ContentType getContentType()
    }

    BulletType --|> Content
    BulletType ..|> "Cloneable"
}

