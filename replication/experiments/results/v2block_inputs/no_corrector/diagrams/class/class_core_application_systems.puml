@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EEF2FF
    BorderColor #6366F1
}
skinparam enum {
    BackgroundColor #FFF3E0
    BorderColor #F57C00
}

title Core Application Systems

' =====================
' External base types
' =====================
class ApplicationCore <<external>> {
}

interface ApplicationListener <<external>> {
}

interface Loadable <<external>> {
}

interface FileHandleResolver <<external>> {
}

' =====================
' mindustry package
' =====================
package "mindustry" {

    abstract class ClientLauncher {
        - loader: LoadRenderer
        - finished: boolean
        - nextFrame: long
        - lastTargetFps: long
        --
        + setup(): void
        + init(): void
        + update(): void
        + resize(width: int, height: int): void
        + exit(): void
        + pause(): void
        + resume(): void
        + add(module: ApplicationListener): void
        + fileDropped(file: Fi): void
    }

    class Vars {
        + {static} net: Net
        + {static} content: ContentLoader
        + {static} state: GameState
        + {static} platform: Platform
        + {static} tree: FileTree
        + {static} world: World
        + {static} control: Control
        + {static} logic: Logic
        + {static} renderer: Renderer
        + {static} ui: UI
        + {static} netServer: NetServer
        + {static} netClient: NetClient
        + {static} player: Player
        + {static} headless: boolean
        --
        + loadAsync(): void
        + {static} init(): void
        + {static} checkLaunch(): void
        + {static} finishLaunch(): void
        + {static} loadSettings(): void
    }
}

' =====================
' mindustry.core package
' =====================
package "mindustry.core" {

    interface Platform {
        + getNet(): NetProvider
        + createScripts(): Scripts
        + updateRPC(): void
        + getUUID(): String
        + shareFile(file: Fi): void
        + hide(): void
        + updateLobby(): void
        + inviteFriends(): void
        + publish(pub: Publishable): void
    }

    class GameState {
        + wave: int
        + wavetime: float
        + tick: double
        + gameOver: boolean
        + won: boolean
        + serverTps: int
        + map: Map
        + rules: Rules
        + stats: GameStats
        + teams: Teams
        - state: State
        --
        + set(astate: State): void
        + getState(): State
        + isPaused(): boolean
        + isPlaying(): boolean
        + isMenu(): boolean
        + isCampaign(): boolean
        + isEditor(): boolean
        + boss(): Unit
    }

    enum "GameState.State" as GameStateEnum {
        menu
        playing
        paused
    }

    class Control {
        + saves: Saves
        + sound: SoundControl
        + input: InputHandler
        + indicators: AttackIndicators
        --
        + loadAsync(): void
        + loadSync(): void
        + init(): void
        + update(): void
        + playMap(map: Map, rules: Rules): void
        + playSector(sector: Sector): void
        + setInput(newInput: InputHandler): void
        + checkAutoUnlocks(): void
    }

    class Logic {
        + play(): void
        + reset(): void
        + runWave(): void
        + skipWave(): void
        + update(): void
        + {static} gameOver(winner: Team): void
        + {static} sectorCapture(): void
        + {static} researched(content: Content): void
    }

    class Renderer {
        + blocks: BlockRenderer
        + fog: FogRenderer
        + minimap: MinimapRenderer
        + overlays: OverlayRenderer
        + lights: LightRenderer
        + pixelator: Pixelator
        + {static} laserOpacity: float
        + camerascale: float
        + animateShields: boolean
        + drawLight: boolean
        --
        + showLanding(core: CoreBuild): void
        + isCutscene(): boolean
        + takeMapScreenshot(): void
    }

    class NetServer {
        + admins: Administration
        + clientCommands: CommandHandler
        + assigner: TeamAssigner
        --
        + assignTeam(player: Player): Team
        + isWaitingForPlayers(): boolean
    }

    class NetClient {
        - ping: long
        - connecting: boolean
        - quiet: boolean
        - quietReset: boolean
        - timeoutTime: float
        - lastSnapshotTimestamp: long
        --
        + setQuiet(): void
    }

    class ContentLoader {
        - contentMap: Seq<Content>[]
        - contentNameMap: ObjectMap<String, MappableContent>[]
        - nameMap: ObjectMap<String, MappableContent>
        - currentMod: LoadedMod
        --
        + createBaseContent(): void
        + createModContent(): void
        + init(): void
        + load(): void
        + loadColors(): void
        + handleContent(content: Content): void
        + each(cons: Cons<Content>): void
        + copy(): ContentLoader
    }

    class FileTree {
        - files: ObjectMap<String, Fi>
        - loadedSounds: ObjectMap<String, Sound>
        - loadedMusic: ObjectMap<String, Music>
        --
        + addFile(path: String, f: Fi): void
        + get(path: String): Fi
        + clear(): void
        + resolve(fileName: String): Fi
        + loadSound(soundName: String): Sound
        + loadMusic(musicName: String): Music
    }

    class Version {
        + {static} type: String
        + {static} modifier: String
        + {static} commitHash: String
        + {static} number: int
        + {static} build: int
        + {static} revision: int
        + {static} isSteam: boolean
        + {static} enabled: boolean
        --
        + {static} init(): void
        + {static} buildString(): String
        + {static} combined(): String
        + {static} isAtLeast(str: String): boolean
    }
}

' =====================
' Inheritance & implementation
' =====================
ClientLauncher --|> ApplicationCore
ClientLauncher ..|> Platform

Vars ..|> Loadable
Control ..|> ApplicationListener
Control ..|> Loadable
Logic ..|> ApplicationListener
Renderer ..|> ApplicationListener
NetServer ..|> ApplicationListener
NetClient ..|> ApplicationListener
FileTree ..|> FileHandleResolver

' =====================
' Inner enum containment
' =====================
GameState +-- GameStateEnum

' =====================
' Vars global registry ownership
' =====================
Vars --> GameState : owns (state)
Vars --> ContentLoader : owns (content)
Vars --> FileTree : owns (tree)

' =====================
' ClientLauncher bootstrap wiring
' =====================
ClientLauncher --> Logic : creates & registers
ClientLauncher --> Control : creates & registers
ClientLauncher --> Renderer : creates & registers
ClientLauncher --> NetServer : creates & registers
ClientLauncher --> NetClient : creates & registers
ClientLauncher --> ContentLoader : loads via AssetManager

' =====================
' Module composition
' =====================
Control *-- Saves
Control *-- SoundControl
Control *-- InputHandler

Renderer *-- BlockRenderer
Renderer *-- MinimapRenderer
Renderer *-- FogRenderer
Renderer *-- OverlayRenderer
Renderer *-- LightRenderer
Renderer *-- Pixelator

NetServer *-- Administration
NetServer *-- CommandHandler

GameState *-- Rules
GameState *-- Teams
GameState *-- GameStats

' =====================
' Cross-module interactions (via Vars)
' =====================
Logic ..> GameState : reads/writes state
Control ..> Logic : calls play() / reset()
Control ..> GameState : reads/writes state
Control ..> Renderer : calls showLanding()
Control ..> NetServer : calls assignTeam()

@enduml
