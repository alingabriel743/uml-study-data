@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Bullets, Effects & Unit Abilities

' ===== SHARED INTERFACES =====
interface Cloneable {
}
interface Scaled {
}

' ===== EFFECTS =====
package "mindustry.entities" {

    class Effect {
        +id: int
        +lifetime: float
        +clip: float
        +startDelay: float
        +baseRotation: float
        +layer: float
        +followParent: boolean
        +renderer: Cons<EffectContainer>
        --
        +at(x: float, y: float): void
        +at(x: float, y: float, rotation: float, color: Color): void
        +create(x: float, y: float, rotation: float, color: Color, data: Object): void
        +wrap(color: Color): Effect
        +render(e: EffectContainer): void
        +shake(intensity: float, duration: float): void
    }

    class EffectContainer {
        +x: float
        +y: float
        +time: float
        +lifetime: float
        +rotation: float
        +color: Color
        +id: int
        +data: Object
        --
        +set(...): void
        +fin(): float
        +scaled(lifetime: float, cons: Cons<EffectContainer>): void
        +inner(): EffectContainer
    }

    EffectContainer ..|> Scaled
    Effect o-- EffectContainer : static container
}

' ===== BULLET TYPE HIERARCHY =====
package "mindustry.entities.bullet" {

    class BulletType {
        +lifetime: float
        +speed: float
        +damage: float
        +hitSize: float
        +drawSize: float
        +drag: float
        +pierce: boolean
        +pierceCap: int
        +splashDamage: float
        +splashDamageRadius: float
        +knockback: float
        +homingPower: float
        +homingRange: float
        +lightning: int
        +lightningLength: int
        +healPercent: float
        +healAmount: float
        +statusDuration: float
        +buildingDamageMultiplier: float
        +fragBullets: int
        +trailWidth: float
        +shootPattern: ShootPattern
        --
        +BulletType(speed: float, damage: float)
        +copy(): BulletType
        +estimateDPS(): float
        +calculateRange(): float
        +heals(): boolean
        +hit(b: Bullet, x: float, y: float): void
        +hitTile(b: Bullet, build: Building, x: float, y: float, ...): void
        +hitEntity(b: Bullet, entity: Hitboxc, health: float): void
        +damageMultiplier(b: Bullet): float
        +continuousDamage(): float
    }

    class BasicBulletType {
        +backColor: Color
        +frontColor: Color
        +width: float
        +height: float
        +shrinkX: float
        +shrinkY: float
        +spin: float
        +rotationOffset: float
        +sprite: String
        --
        +BasicBulletType(speed: float, damage: float)
        +load(): void
        +draw(b: Bullet): void
    }

    class ArtilleryBulletType {
        +trailMult: float
        +trailSize: float
        --
        +ArtilleryBulletType(speed: float, damage: float)
        +update(b: Bullet): void
    }

    class EmpBulletType {
        +radius: float
        +timeIncrease: float
        +timeDuration: float
        +powerDamageScl: float
        +powerSclDecrease: float
        +hitUnits: boolean
        +unitDamageScl: float
        --
        +hit(b: Bullet, x: float, y: float, createFrags: boolean): void
    }

    class BombBulletType {
        --
        +BombBulletType(damage: float, radius: float, sprite: String)
    }

    class ContinuousBulletType {
        +length: float
        +shake: float
        +damageInterval: float
        +largeHit: boolean
        +continuous: boolean
        +timescaleDamage: boolean
        --
        +continuousDamage(): float
        +estimateDPS(): float
        +calculateRange(): float
        +update(b: Bullet): void
        +applyDamage(b: Bullet): void
        +currentLength(b: Bullet): float
    }

    class ContinuousLaserBulletType {
        +fadeTime: float
        +lightStroke: float
        +divisions: int
        +colors: Color[]
        +strokeFrom: float
        +strokeTo: float
        +width: float
        +oscScl: float
        +oscMag: float
        --
        +ContinuousLaserBulletType(damage: float)
        +draw(b: Bullet): void
        +currentLength(b: Bullet): float
    }

    class EmptyBulletType {
    }

    class ExplosionBulletType {
    }

    ' Bullet type inheritance hierarchy
    BasicBulletType --|> BulletType
    ArtilleryBulletType --|> BasicBulletType
    EmpBulletType --|> BasicBulletType
    BombBulletType --|> BasicBulletType
    ContinuousBulletType --|> BulletType
    ContinuousLaserBulletType --|> ContinuousBulletType
    EmptyBulletType --|> BulletType
    ExplosionBulletType --|> BulletType

    ' Self-referential bullet composition (fragBullet, intervalBullet, spawnBullets)
    BulletType *-- "0..*" BulletType : fragBullet /\nspawnBullets
}

' ===== UNIT ABILITIES =====
package "mindustry.entities.abilities" {

    abstract class Ability {
        +display: boolean
        +data: float
        --
        +update(unit: Unit): void
        +draw(unit: Unit): void
        +death(unit: Unit): void
        +created(unit: Unit): void
        +init(type: UnitType): void
        +copy(): Ability
        +addStats(t: Table): void
        +localized(): String
    }

    class ForceFieldAbility {
        +radius: float
        +regen: float
        +max: float
        +cooldown: float
        +sides: int
        +rotation: float
        +radiusScale: float
        +alpha: float
        +wasBroken: boolean
        --
        +update(unit: Unit): void
        +draw(unit: Unit): void
        +death(unit: Unit): void
        +created(unit: Unit): void
        +checkRadius(unit: Unit): void
    }

    class MoveLightningAbility {
        +damage: float
        +chance: float
        +length: int
        +minSpeed: float
        +maxSpeed: float
        +color: Color
        +x: float
        +y: float
        +alternate: boolean
        +bulletAngle: float
        +bulletSpread: float
        --
        +update(unit: Unit): void
        +draw(unit: Unit): void
        +addStats(t: Table): void
    }

    class ArmorPlateAbility {
    }

    class EnergyFieldAbility {
    }

    class LiquidExplodeAbility {
    }

    class LiquidRegenAbility {
    }

    class RegenAbility {
    }

    Ability ..|> Cloneable

    ForceFieldAbility --|> Ability
    MoveLightningAbility --|> Ability
    ArmorPlateAbility --|> Ability
    EnergyFieldAbility --|> Ability
    LiquidExplodeAbility --|> Ability
    LiquidRegenAbility --|> Ability
    RegenAbility --|> Ability
}

' ===== SHOOT PATTERNS =====
package "mindustry.entities.pattern" {

    interface BulletHandler {
        +shoot(x: float, y: float, rotation: float, delay: float): void
        +shoot(x: float, y: float, rotation: float, delay: float, move: Mover): void
    }

    abstract class ShootPattern {
        +shots: int
        +firstShotDelay: float
        +shotDelay: float
        --
        +shoot(totalShots: int, handler: BulletHandler, barrelInc: Runnable): void
        +flip(): void
        +copy(): ShootPattern
    }

    class ShootSine {
        +scl: float
        +mag: float
        --
        +ShootSine(scl: float, mag: float)
    }

    class ShootSpread {
        +spread: float
        --
        +ShootSpread(shots: int, spread: float)
        +circle(points: int): ShootSpread
    }

    class ShootSummon {
        +x: float
        +y: float
        +radius: float
        +spread: float
        --
        +ShootSummon(x: float, y: float, radius: float, spread: float)
    }

    class ShootAlternate {
    }

    class ShootBarrel {
        +barrels: float[]
        +barrelOffset: int
        --
        +flip(): void
    }

    class ShootHelix {
        +scl: float
        +mag: float
        +offset: float
        --
        +ShootHelix(scl: float, mag: float, offset: float)
    }

    class ShootMulti {
        +source: ShootPattern
        +dest: ShootPattern[]
        --
        +ShootMulti(source: ShootPattern, dest: ShootPattern...)
        +flip(): void
    }

    ShootPattern ..|> Cloneable
    ShootPattern ..> BulletHandler : dispatches via

    ShootSine --|> ShootPattern
    ShootSpread --|> ShootPattern
    ShootSummon --|> ShootPattern
    ShootAlternate --|> ShootPattern
    ShootBarrel --|> ShootPattern
    ShootHelix --|> ShootPattern
    ShootMulti --|> ShootPattern

    ShootMulti *-- ShootPattern : source / dest[]
}

' ===== CROSS-PACKAGE RELATIONSHIPS =====
BulletType *-- "0..1" ShootPattern : shootPattern
BulletType ..> Effect : hitEffect / shootEffect\n/ trailEffect / healEffect

MoveLightningAbility *-- "0..1" BulletType : bullet
MoveLightningAbility ..> Effect : shootEffect

EnergyFieldAbility ..> Effect : applyEffect
LiquidRegenAbility ..> Effect : slurpEffect

@enduml
