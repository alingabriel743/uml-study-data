@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #D8EAF8
    BorderColor #2980B9
}
skinparam note {
    BackgroundColor #FFF9E3
    BorderColor #C0A000
}

title Entity Component System

' ─── External interfaces referenced across packages ───────────────────────
interface Entityc
interface Posc
interface Hitboxc
interface QuadTreeObject
interface Position

' ─── mindustry.entities ───────────────────────────────────────────────────
package "mindustry.entities" {

    interface EntityIndexer {
        +change(t: Entityc, index: int): void
    }

    class "EntityGroup<T extends Entityc>" as EntityGroup {
        -{static} int lastId
        -Seq<T> array
        -IntMap<T> map
        -QuadTree tree
        -EntityIndexer indexer
        -boolean clearing
        --
        +{static} nextId(): int
        +{static} checkNextId(id: int): void
        +add(entity: T): void
        +remove(entity: T): void
        +removeByID(id: int): void
        +update(): void
        +collide(): void
        +updatePhysics(): void
        +intersect(x,y,w,h: float): Seq<T>
        +getByID(id: int): T
        +size(): int
        +isEmpty(): boolean
        +useTree(): boolean
        +mappingEnabled(): boolean
        +draw(cons: Cons<T>): void
        +each(cons: Cons<T>): void
        +find(pred: Boolf<T>): T
        +resize(x,y,w,h: float): void
    }

    class EntityCollisions {
        -{static} float seg, maxDelta
        -Vec2 vector, l1
        -Rect r1, r2, tmp
        -Seq<Hitboxc> arrOut
        --
        +move(entity: Hitboxc, dx: float, dy: float, solidCheck: SolidPred): void
        +updatePhysics(group: EntityGroup<T>): void
        +collide(group: EntityGroup<T>): void
        +checkCollide(a: Hitboxc, b: Hitboxc): void
        +{static} collide(..., out: Vec2): boolean
        +{static} solid(x: int, y: int): boolean
        +{static} legsSolid(x: int, y: int): boolean
        +overlapsTile(rect: Rect, pred: SolidPred): boolean
    }

    interface SolidPred <<inner>> {
        +solid(x: int, y: int): boolean
    }

    EntityGroup o-- "0..1" EntityIndexer : optional indexer
    EntityGroup --> EntityCollisions : delegates collide()\n& updatePhysics()
    EntityCollisions +.. SolidPred : inner interface
}

' ─── mindustry.async ──────────────────────────────────────────────────────
package "mindustry.async" {

    interface AsyncProcess {
        +{abstract} init(): void
        +{abstract} reset(): void
        +{abstract} begin(): void
        +{abstract} process(): void
        +{abstract} end(): void
        +{abstract} shouldProcess(): boolean
    }

    class AsyncCore {
        -Seq<AsyncProcess> processes
        -Seq<Future<?>> futures
        -ExecutorService executor
        --
        +begin(): void
        +end(): void
        +complete(): void
    }

    class PhysicsProcess {
        -{static} int layers = 4
        -{static} int layerGround, layerLegs, layerFlying, layerUnderwater
        -PhysicsWorld physics
        -Seq<PhysicRef> refs
        -EntityGroup<Unit> group
        --
        +begin(): void
        +process(): void
        +end(): void
        +init(): void
        +reset(): void
    }

    class PhysicsWorld <<inner>> {
        -QuadTree[] trees
        -Seq<PhysicsBody> bodies
        --
        +update(): void
    }

    class PhysicRef <<inner>> {
        +Physicsc entity
        +PhysicsBody body
        +float x, y
    }

    class AvoidanceProcess {
        -{static} int wwidth, wheight
        -int[] buffer1, buffer2
        -volatile boolean swap
        -IntSeq requests
        -int[] avoidance
        -boolean modified, active
        --
        +getAvoidance(): int[]
        +begin(): void
        +process(): void
        +reset(): void
    }

    AsyncCore "1" *-- "2..*" AsyncProcess : manages\n(Seq<AsyncProcess>)
    AsyncCore --> ExecutorService : submits async tasks

    PhysicsProcess ..|> AsyncProcess
    AvoidanceProcess ..|> AsyncProcess

    PhysicsProcess *-- PhysicsWorld : owns
    PhysicsProcess *-- "0..*" PhysicRef : tracks
    PhysicsProcess --> EntityGroup : processes\nGroups.unit
}

' ─── mindustry.entities.comp ──────────────────────────────────────────────
package "mindustry.entities.comp" {

    abstract class EntityComp <<@BaseComponent>> {
        +transient boolean added
        +transient int id
        --
        +isAdded(): boolean
        +update(): void
        +add(): void
        +remove(): void
        +isLocal(): boolean
        +isRemote(): boolean
        +{abstract} classId(): int
        +{abstract} serialize(): boolean
        +read(read: Reads): void
        +write(write: Writes): void
        +beforeWrite(): void
        +afterRead(): void
        +afterReadAll(): void
    }

    abstract class PosComp <<@Component>> {
        +@SyncField float x, y
        --
        +set(x: float, y: float): void
        +set(pos: Position): void
        +trns(x: float, y: float): void
        +tileX(): int
        +tileY(): int
        +floorOn(): Floor
        +blockOn(): Block
        +tileOn(): Tile
        +onSolid(): boolean
        +getX(): float
        +getY(): float
    }

    abstract class VelComp <<@Component>> {
        +@Import float x, y
        +@SyncLocal Vec2 vel
        +transient float drag
        --
        +update(): void
        +move(cx: float, cy: float): void
        +move(v: Vec2): void
        +velAddNet(vx: float, vy: float): void
        +solidity(): SolidPred
        +ignoreSolids(): boolean
        +canPass(tileX: int, tileY: int): boolean
        +moving(): boolean
    }

    abstract class HealthComp <<@Component>> {
        +float health
        +transient float hitTime
        +transient float maxHealth
        +transient boolean dead
        --
        +isValid(): boolean
        +healthf(): float
        +update(): void
        +killed(): void
        +kill(): void
        +damage(amount: float): void
        +damage(amount: float, withEffect: boolean): void
        +damagePierce(amount: float): void
        +damageContinuous(amount: float): void
        +heal(amount: float): void
        +healFract(amount: float): void
        +clampHealth(): void
        +damaged(): boolean
    }

    abstract class TeamComp <<@Component>> {
        +@Import float x, y
        +Team team
        --
        +cheating(): boolean
        +inFogTo(viewer: Team): boolean
        +core(): CoreBuild
        +closestCore(): CoreBuild
        +closestEnemyCore(): CoreBuild
    }

    abstract class HitboxComp <<@Component>> {
        +@Import float x, y
        +transient float lastX, lastY
        +transient float deltaX, deltaY, hitSize
        --
        +update(): void
        +add(): void
        +afterRead(): void
        +hitSize(): float
        +hitbox(rect: Rect): void
        +hitboxTile(rect: Rect): void
        +updateLastPosition(): void
        +collision(other: Hitboxc, x: float, y: float): void
        +collides(other: Hitboxc): boolean
        +getCollisions(consumer: Cons<QuadTree>): void
        +deltaLen(): float
        +deltaAngle(): float
    }

    abstract class DamageComp <<@Component>> {
        +float damage
    }

    abstract class BuilderComp <<@Component>> {
        +@Import float x, y, rotation
        +@Import Team team
        +@SyncLocal Queue<BuildPlan> plans
        +@SyncLocal boolean updateBuilding
        +transient float buildCounter, buildAlpha
        +transient BuildPlan lastActive
        +transient int lastSize
        --
        +canBuild(): boolean
        +update(): void
        +validatePlans(): void
        +updateBuildLogic(): void
        +addBuild(plan: BuildPlan, tail: boolean): void
        +removeBuild(x: int, y: int, breaking: boolean): void
        +clearBuilding(): void
        +isBuilding(): boolean
        +activelyBuilding(): boolean
        +buildPlan(): BuildPlan
        +drawBuilding(): void
    }

    abstract class BuildingComp <<@Component base=true>> {
        +@Import float x, y, health, maxHealth
        +@Import Team team
        +@Import boolean dead
        +transient Tile tile
        +transient Block block
        +transient Seq<Building> proximity
        +transient int cdump, rotation
        +transient boolean enabled
        +PowerModule power
        +LiquidModule liquids
        +ItemModule items
    }

    abstract class BulletComp <<@Component base=true, pooled>> {
        +@Import Team team
        +@Import Entityc owner
        +@Import float x, y, damage, lastX, lastY
        +IntSeq collided
        +BulletType type
        +Vec2 vel
        +transient Entityc shooter
        +transient boolean absorbed, hit, keepAlive
        +transient Mover mover
        +transient Trail trail
        +transient Posc stickyTarget
        --
        +add(): void
        +remove(): void
        +update(): void
        +collision(other: Hitboxc, x: float, y: float): void
        +collides(other: Hitboxc): boolean
        +tileRaycast(x1,y1,x2,y2: int): void
        +draw(): void
        +getCollisions(consumer: Cons<QuadTree>): void
        +stickTo(other: Posc): void
        +initVel(angle: float, amount: float): void
        +rotation(): float
        +hasCollided(id: int): boolean
        +damageMultiplier(): float
    }

    abstract class UnitComp <<@Component base=true>> {
        +@Import boolean dead, disarmed
        +@Import float x, y, rotation, health, maxHealth
        +@Import float drag, armor, hitSize, shield, elevation
        +@Import Team team
        +@Import int id
        +@Import Vec2 vel
        +@Import WeaponMount[] mounts
        +UnitController controller
        +Ability[] abilities
        +UnitType type
        +boolean spawnedByCore
        +double flag
        +transient Trail trail
        +transient UnitType dockedType
        +@SyncLocal float elevation
    }

    ' Component relationships via interface implementation
    PosComp ..|> Position : implements
    VelComp ..|> Posc : implements
    HitboxComp ..|> Posc : implements
    HitboxComp ..|> QuadTreeObject : implements
    HealthComp ..|> Entityc : implements
    HealthComp ..|> Posc : implements
    TeamComp ..|> Posc : implements

    ' Component field-level delegation
    VelComp --> EntityCollisions : delegates move()

    ' Aggregation showing comps feed into generated entities
    UnitComp ..> HealthComp : @Import health/maxHealth/dead
    UnitComp ..> HitboxComp : @Import hitSize/lastX/lastY
    UnitComp ..> TeamComp : @Import team
    UnitComp ..> VelComp : @Import vel/drag
    UnitComp ..> BuilderComp : @Import (Builderc)

    BulletComp ..> DamageComp : @Import damage
    BulletComp ..> HitboxComp : @Import lastX/lastY (Hitboxc)
    BulletComp ..> TeamComp : @Import team
    BulletComp ..> PosComp : @Import x, y

    BuildingComp ..> HealthComp : @Import health/maxHealth/dead
    BuildingComp ..> TeamComp : @Import team
    BuildingComp ..> PosComp : @Import x, y
}

' ─── Cross-package notes ──────────────────────────────────────────────────
note top of EntityComp
  **Annotation-Processor ECS Pattern**
  @Component classes are abstract mixins.
  Code generator merges them into concrete
  entity classes via @Import (field sharing)
  and @MethodPriority (call ordering).
  @EntityDef(BulletComp) → generates Bulletc;
  @EntityDef(BuildingComp) → generates Buildingc.
end note

note right of AsyncCore
  begin(): sync p.begin() for all processes,
  then submits p.process() to executor pool.
  end(): awaits futures, then sync p.end().
end note

note bottom of PhysicsProcess
  Runs PhysicsWorld.update() in worker thread.
  Applies position deltas back to entities
  via entity.move(dx, dy) in end() (main thread).
end note

@enduml
