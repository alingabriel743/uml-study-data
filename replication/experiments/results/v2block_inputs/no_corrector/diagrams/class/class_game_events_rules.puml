@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFFFF0
    BorderColor #AAAAAA
}
skinparam enum {
    BackgroundColor #FFF8E7
    BorderColor #B8860B
}
skinparam interface {
    BackgroundColor #E8F5E9
    BorderColor #388E3C
}

title Game Events, Rules & Teams\n<size:11>mindustry.game</size>

' ════════════════════════════════════════
' Shared interfaces
' ════════════════════════════════════════

interface JsonSerializable {
    +write(json: Json): void
    +read(json: Json, data: JsonValue): void
}

interface CustomChunk {
    +write(stream: DataOutput): void
    +read(stream: DataInput): void
    +shouldWrite(): boolean
}

interface Senseable {
    +sense(sensor: LAccess): double
}

interface Cloneable

' ════════════════════════════════════════
' Event Bus  (mindustry.game.EventType)
' ════════════════════════════════════════

package "Event Bus" {

    class EventType <<container>> {
        .. Game Lifecycle ..
        WinEvent, LoseEvent
        GameOverEvent, PlayEvent, ResetEvent
        WorldLoadEvent, WorldLoadBeginEvent
        WorldLoadEndEvent, StateChangeEvent
        .. Wave / Unit ..
        WaveEvent, TurnEvent
        UnitCreateEvent, UnitDestroyEvent
        UnitSpawnEvent, UnitDamageEvent
        .. Player ..
        PlayerJoin, PlayerLeave
        PlayerChatEvent, UnitControlEvent
        .. Building ..
        BlockBuildBeginEvent, BlockBuildEndEvent
        TileChangeEvent, TilePreChangeEvent
        CoreChangeEvent, BuildDamageEvent
        BuildTeamChangeEvent, ConfigEvent
        .. Sector / Content ..
        SectorCaptureEvent, SectorLoseEvent
        UnlockEvent, ContentInitEvent
    }

    enum "EventType.Trigger" as Trigger {
        shock
        update
        beforeGameUpdate
        afterGameUpdate
        draw
        drawOver
        preDraw / postDraw
        newGame
        tutorialComplete
        teamCoreDamage
        unitCommandChange
        universeDrawBegin
        universeDraw
        universeDrawEnd
        ' ~20 additional values
    }

    EventType +-- Trigger
}

note right of Trigger
  Lightweight enum events fired via
  Events.run(Trigger.xxx)
  — no object allocation
end note

note right of EventType
  ~50 static inner event classes.
  Reusable events expose set() method
  (BuildDamageEvent, TileChangeEvent, etc.)
end note

' ════════════════════════════════════════
' Rules & Configuration
' ════════════════════════════════════════

package "Rules & Configuration" {

    enum Gamemode {
        survival
        sandbox
        attack
        pvp
        editor
        --
        +rules: Cons<Rules>
        +validator: Boolf<Map>
        +hidden: boolean
        --
        +apply(in: Rules): Rules
        +valid(map: Map): boolean
        +description(): String
    }

    class Rules <<config-only>> {
        +infiniteResources: boolean
        +waves: boolean
        +waveTimer: boolean
        +pvp: boolean
        +attackMode: boolean
        +editor: boolean
        +fog: boolean
        +staticFog: boolean
        +coreCapture: boolean
        +canGameOver: boolean
        +waveSpacing: float
        +initialWaveSpacing: float
        +winWave: int
        +unitCap: int
        +unitBuildSpeedMultiplier: float
        +unitDamageMultiplier: float
        +unitHealthMultiplier: float
        +blockHealthMultiplier: float
        +blockDamageMultiplier: float
        +buildSpeedMultiplier: float
        +buildCostMultiplier: float
        +enemyCoreBuildRadius: float
        +defaultTeam: Team
        +waveTeam: Team
        +teams: TeamRules
        +spawns: Seq<SpawnGroup>
        +bannedBlocks: ObjectSet<Block>
        +bannedUnits: ObjectSet<UnitType>
        +objectives: MapObjectives
        +ambientLight: Color
        +tags: StringMap
        --
        +copy(): Rules
        +mode(): Gamemode
        +buildRadius(team: Team): float
        +unitBuildSpeed(team: Team): float
        +unitDamage(team: Team): float
        +unitHealth(team: Team): float
        +blockHealth(team: Team): float
        +buildSpeed(team: Team): float
        +isBanned(block: Block): boolean
        +isBanned(unit: UnitType): boolean
    }

    class "Rules.TeamRules" as TeamRules {
        -values: TeamRule[]
        --
        +get(team: Team): TeamRule
        +write(json: Json): void
        +read(json: Json, jsonData: JsonValue): void
    }

    class "Rules.TeamRule" as TeamRule {
        +aiCoreSpawn: boolean
        +protectCores: boolean
        +cheat: boolean
        +fillItems: boolean
        +infiniteResources: boolean
        +buildAi: boolean
        +buildAiTier: float
        +rtsAi: boolean
        +rtsMinSquad: int
        +rtsMaxSquad: int
        +rtsMinWeight: float
        +unitBuildSpeedMultiplier: float
        +unitDamageMultiplier: float
        +unitHealthMultiplier: float
        +blockHealthMultiplier: float
        +blockDamageMultiplier: float
        +buildSpeedMultiplier: float
        +extraCoreBuildRadius: float
        +unitFactoryActivationDelay: float
    }

    TeamRules ..|> JsonSerializable
    Rules +-- TeamRules
    Rules +-- TeamRule
    Rules *--> TeamRules : teams
    TeamRules *--> TeamRule : values[team.id]
    Rules ..> Gamemode : mode()
    Gamemode ..> Rules : apply()
}

note bottom of Rules
  Config-only; actual game state
  lives in GameState (out of scope).
  Per-team multipliers = global * TeamRule.
end note

note bottom of TeamRules
  Lazy-creates TeamRule per team.
  Array-indexed by team.id (256 slots).
  Derelict gets protectCores=false.
end note

' ════════════════════════════════════════
' Teams Registry
' ════════════════════════════════════════

package "Teams Registry" {

    class Team {
        +id: int
        +color: Color
        +palette: Color[3]
        +name: String
        +ignoreUnitCap: boolean
        +{static} all: Team[256]
        +{static} baseTeams: Team[6]
        --
        ' derelict(0), sharded(1), crux(2)
        ' malis(3), green(4), blue(5)
        ' neoplastic(6, ignoreUnitCap=true)
        ' ids 7-255: auto-generated HSV colors
        --
        +{static} get(id: int): Team
    }

    class Teams {
        -map: TeamData[256]
        +active: Seq<TeamData>
        +present: Seq<TeamData>
        +bosses: Seq<Unit>
        --
        +get(team: Team): TeamData
        +getOrNull(team: Team): TeamData
        +cores(team: Team): Seq<CoreBuild>
        +playerCores(): Seq<CoreBuild>
        +isActive(team: Team): boolean
        +canInteract(team: Team, other: Team): boolean
        +registerCore(core: CoreBuild): void
        +unregisterCore(entity: CoreBuild): void
        +updateTeamStats(): void
        +closestCore(x: float, y: float, t: Team): CoreBuild
        +closestEnemyCore(x: float, y: float, t: Team): CoreBuild
        +anyEnemyCoresWithinBuildRadius(t: Team, x: float, y: float): boolean
        +eachEnemyCore(team: Team, ret: Cons<Building>): void
    }

    class "Teams.TeamData" as TeamData {
        +team: Team
        +coreEnemies: Team[]
        +cores: Seq<CoreBuild>
        +lastCore: CoreBuild
        +buildingTree: QuadTree<Building>
        +turretTree: QuadTree<Building>
        +unitTree: QuadTree<Unit>
        +unitCap: int
        +unitCount: int
        +units: Seq<Unit>
        +players: Seq<Player>
        +buildings: Seq<Building>
        +plans: Queue<BlockPlan>
        +buildAi: BaseBuilderAI
        +rtsAi: RtsAI
        --
        +active(): boolean
        +hasCore(): boolean
        +isAlive(): boolean
        +core(): CoreBuild
        +getBuildings(block: Block): Seq<Building>
        +getUnits(type: UnitType): Seq<Unit>
        +tree(): QuadTree<Unit>
        +hasAI(): boolean
        +destroyToDerelict(): void
        +timeDestroy(x: float, y: float, range: float): void
    }

    class "Teams.BlockPlan" as BlockPlan {
        +x: short
        +y: short
        +rotation: short
        +block: Block
        +config: Object
        +removed: boolean
    }

    Team ..|> Senseable
    Teams +-- TeamData
    Teams +-- BlockPlan
    Teams *--> TeamData : map[256]
    TeamData --> Team : team
    TeamData *--> BlockPlan : plans
}

note right of Teams
  Initialized with crux team active.
  updateTeamStats() rebuilds unit/
  building caches each frame.
end note

note right of TeamData
  active() = waveTeam with waves,
  OR has cores/buildings,
  OR neoplastic with units.
end note

' ════════════════════════════════════════
' Waves & Spawning
' ════════════════════════════════════════

package "Waves & Spawning" {

    class Waves {
        -spawns: Seq<SpawnGroup>
        +{static} waveVersion: int = 7
        --
        +get(): Seq<SpawnGroup>
        +{static} generate(difficulty: float): Seq<SpawnGroup>
        +{static} generate(difficulty: float, rand: Rand,\n  attack: boolean): Seq<SpawnGroup>
        +{static} generate(difficulty: float, rand: Rand,\n  attack: boolean, airOnly: boolean,\n  naval: boolean): Seq<SpawnGroup>
    }

    class SpawnGroup {
        +type: UnitType
        +begin: int
        +end: int
        +spacing: int
        +max: int
        +unitScaling: float
        +shields: float
        +shieldScaling: float
        +unitAmount: int
        +spawn: int
        +payloads: Seq<UnitType>
        +effect: StatusEffect
        +items: ItemStack
        +team: Team
        --
        +getSpawned(wave: int): int
        +getShield(wave: int): float
        +canSpawn(position: int): boolean
        +createUnit(team: Team, wave: int): Unit
        +copy(): SpawnGroup
        +write(json: Json): void
        +read(json: Json, data: JsonValue): void
    }

    SpawnGroup ..|> JsonSerializable
    SpawnGroup ..|> Cloneable
    Waves *--> SpawnGroup : spawns
}

note bottom of Waves
  generate() builds procedural waves with
  6 unit species tiers; boss waves at ~50-70;
  final bosses at ~120-150.
end note

note bottom of SpawnGroup
  getSpawned(wave): min(unitAmount +
  (wave-begin)/spacing / unitScaling, max).
  Returns 0 if outside [begin,end] range.
end note

' ════════════════════════════════════════
' Stats, Fog & Saves
' ════════════════════════════════════════

package "Stats, Fog & Saves" {

    class GameStats <<POJO>> {
        +enemyUnitsDestroyed: int
        +wavesLasted: int
        +buildingsBuilt: int
        +buildingsDeconstructed: int
        +buildingsDestroyed: int
        +unitsCreated: int
        +placedBlockCount: ObjectIntMap<Block>
        +destroyedBlockCount: ObjectIntMap<Block>
        +coreItemCount: ObjectIntMap<Item>
        --
        +getPlaced(block: Block): int
        +getDestroyed(block: Block): int
    }

    class FogControl <<final>> {
        -fog: FogData[256]
        -staticEvents: LongSeq
        -dynamicEvents: LongSeq
        -staticFogThread: Thread
        -dynamicFogThread: Thread
        --
        +isDiscovered(team: Team, x: int, y: int): boolean
        +isVisible(team: Team, x: float, y: float): boolean
        +isVisibleTile(team: Team, x: int, y: int): boolean
        +update(): void
        +resetFog(): void
        +forceUpdate(team: Team, build: Building): void
        +getDiscovered(team: Team): Bits
        +write(stream: DataOutput): void
        +read(stream: DataInput): void
        +shouldWrite(): boolean
    }

    class "FogControl.FogData" as FogData {
        +staticFog: Bits
        +dynamicFog: Bits
    }

    class Saves {
        +saves: Seq<SaveSlot>
        +current: SaveSlot
        +lastSectorSave: SaveSlot
        +saving: boolean
        +totalPlaytime: long
        --
        +load(): void
        +addSave(name: String): void
        +getCurrent(): SaveSlot
    }

    FogControl ..|> CustomChunk
    FogControl +-- FogData
    FogControl *--> FogData : fog[256]
}

note right of FogControl
  Two background threads + double-buffered
  Bits per team: StaticFogThread (explored)
  and DynamicFogThread (currently visible).
end note

' ════════════════════════════════════════
' Cross-package relationships
' ════════════════════════════════════════

Rules --> Team : defaultTeam / waveTeam
Rules *--> SpawnGroup : spawns
SpawnGroup --> Team : team (nullable)
FogControl ..> EventType : subscribes to\n(WorldLoad, TileChange,\nUnitDestroy, Reset)
Saves ..> EventType : subscribes to\nStateChangeEvent

@enduml
