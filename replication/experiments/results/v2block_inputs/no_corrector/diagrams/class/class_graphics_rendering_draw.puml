@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Graphics Rendering & Block Draw Strategies

' ─── External / library types ───────────────────────────────────────────
interface ApplicationListener {
}

interface Disposable {
    +dispose()
}

class "QuadTree<Tile>" as QuadTree {
}

' ─── mindustry.core ─────────────────────────────────────────────────────
package "mindustry.core" {

    class Renderer {
        +BlockRenderer blocks
        +PlanetRenderer planets
        +FogRenderer fog
        +MinimapRenderer minimap
        +OverlayRenderer overlays
        +LightRenderer lights
        +Pixelator pixelator
        +Bloom bloom
        +FrameBuffer effectBuffer
        +FrameBuffer backgroundBuffer
        +boolean animateShields
        +boolean animateWater
        +boolean drawWeather
        +boolean drawStatus
        +boolean enableEffects
        +float targetscale
        +float camerascale
        +float minZoom
        +float maxZoom
        +{static} float laserOpacity
        +{static} float unitLaserOpacity
        +{static} float bridgeOpacity
        --
        +void init()
        +void update()
        +void shake(float intensity, float duration)
        +void addEnvRenderer(int mask, Runnable render)
        +void loadFluidFrames()
        +TextureRegion[][] getFluidFrames()
    }
}

' ─── mindustry.graphics ─────────────────────────────────────────────────
package "mindustry.graphics" {

    class BlockRenderer {
        +{static} int crackRegions
        +{static} int maxCrackSize
        +{static} boolean drawQuadtreeDebug
        +{static} Color shadowColor
        +{static} Color blendShadowColor
        -FloorRenderer floor
        -TextureRegion[][] cracks
        -FrameBuffer shadows
        -FrameBuffer dark
        -BlockQuadtree blockTree
        -BlockLightQuadtree blockLightTree
        -OverlayQuadtree overlayTree
        -FloorQuadtree floorTree
        -Seq<Tile> tileview
        -Seq<Tile> lightview
        -Seq<Building> outArray2
        --
        +void reload()
        +void processBlocks()
        +void drawBlocks()
        +void drawDarkness()
        +void drawShadows()
        +void drawDestroyed()
        +void updateShadows(boolean ignoreBuildings, boolean ignoreTerrain)
        +void updateDarkness()
        +void processShadows(boolean ignoreBuildings, boolean ignoreTerrain)
        +void updateShadow(Building build)
        +void updateShadowTile(Tile tile)
        +void recacheWall(Tile tile)
        +void checkChanges()
        +FrameBuffer getShadowBuffer()
        +void addFloorIndex(Tile)
        +void removeFloorIndex(Tile)
        +void addOverlayIndex(Tile)
        +void removeOverlayIndex(Tile)
    }

    class BlockQuadtree {
        ' hitbox uses block.clipSize
    }

    class BlockLightQuadtree {
        ' hitbox uses block.lightClipSize
    }

    class OverlayQuadtree {
        ' hitbox uses overlay.lightClipSize
    }

    class FloorQuadtree {
        ' hitbox uses floor.lightClipSize
    }

    class CacheLayer {
        +{static} CacheLayer water
        +{static} CacheLayer mud
        +{static} CacheLayer cryofluid
        +{static} CacheLayer tar
        +{static} CacheLayer slag
        +{static} CacheLayer arkycite
        +{static} CacheLayer space
        +{static} CacheLayer normal
        +{static} CacheLayer walls
        +{static} CacheLayer[] all
        +int id
        +boolean liquid
        --
        +{static} void init()
        +{static} void add(CacheLayer... layers)
        +{static} void addLast(CacheLayer... layers)
        +{static} void add(int index, CacheLayer layer)
        +void begin()
        +void end()
    }

    class ShaderLayer {
        +Shader shader
        --
        +void begin()
        +void end()
    }

    class CubemapMesh {
        -Mesh mesh
        -Shader shader
        -Cubemap map
        -{static} float[] vertices
        --
        +void render(Mat3D projection)
        +void setCubemap(Cubemap map)
        +void dispose()
    }
}

' ─── mindustry.graphics.g3d ─────────────────────────────────────────────
package "mindustry.graphics.g3d" {

    class PlanetRenderer {
        +{static} float outlineRad
        +{static} float camLength
        +{static} Color outlineColor
        +{static} Color hoverColor
        +{static} Color borderColor
        +{static} Color shadowColor
        -Camera3D cam
        -VertexBatch3D batch
        -PlaneBatch3D projector
        -Mat3D mat
        -Bloom bloom
        -Mesh atmosphere
        -CubemapMesh skybox
        --
        +void render(PlanetParams params)
        +void renderPlanet(Planet planet, PlanetParams params)
        +void renderTransparent(Planet planet, PlanetParams params)
        +void renderSectors(Planet planet, PlanetParams params)
        +void renderOrbit(Planet planet, PlanetParams params)
        +void drawArc(Planet planet, Vec3 a, Vec3 b)
        +void drawBorders(Sector sector, Color color, float alpha)
        +void drawPlane(Sector sector, Runnable run)
        +void drawSelection(Sector sector, Color color, float stroke, float length)
        +void fill(Sector sector, Color color, float offset)
        +void dispose()
    }

    interface PlanetInterfaceRenderer {
        +void renderSectors(Planet planet)
        +void renderProjections(Planet planet)
        +void renderOverProjections(Planet planet)
    }
}

' ─── mindustry.world.draw ────────────────────────────────────────────────
package "mindustry.world.draw" {

    abstract class DrawBlock {
        +{static} Rand rand
        +String[] iconOverride
        --
        +{abstract} void draw(Building build)
        +void drawLight(Building build)
        +void drawPlan(Block block, BuildPlan plan, Eachable<BuildPlan> list)
        +void load(Block block)
        +TextureRegion[] icons(Block block)
        +{final} TextureRegion[] finalIcons(Block block)
        +void getRegionsToOutline(Block block, Seq<TextureRegion> out)
        +GenericCrafter expectCrafter(Block block)
    }

    class DrawDefault {
        --
        +void draw(Building build)
        +void drawPlan(Block block, BuildPlan plan, Eachable<BuildPlan> list)
        +TextureRegion[] icons(Block block)
    }

    class DrawRegion {
        +TextureRegion region
        +String suffix
        +String name
        +Color color
        +boolean spinSprite
        +boolean drawPlan
        +boolean buildingRotate
        +float rotateSpeed
        +float x
        +float y
        +float rotation
        +float layer
        --
        +void draw(Building build)
        +void load(Block block)
        +TextureRegion[] icons(Block block)
    }

    class DrawMulti {
        +DrawBlock[] drawers
        --
        +void draw(Building build)
        +void drawPlan(Block block, BuildPlan plan, Eachable<BuildPlan> list)
        +void drawLight(Building build)
        +void load(Block block)
        +TextureRegion[] icons(Block block)
    }

    class DrawBlockParts {
        +Seq<DrawPart> parts
        +TextureRegion preview
        --
        +void draw(Building build)
        +void load(Block block)
        +void drawPlan(Block block, BuildPlan plan, Eachable<BuildPlan> list)
        +void getRegionsToOutline(Block block, Seq<TextureRegion> out)
        +TextureRegion[] icons(Block block)
    }

    class DrawArcSmelt {
        +Color flameColor
        +Color midColor
        +float flameRad
        +float circleSpace
        +float flameRadiusScl
        +float flameRadiusMag
        +float circleStroke
        +float x
        +float y
        +float alpha
        +int particles
        +float particleLife
        +float particleRad
        +float particleStroke
        +float particleLen
        +boolean drawCenter
        +Blending blending
        --
        +void draw(Building build)
    }

    class DrawCircles {
        +Color color
        +int amount
        +int sides
        +float strokeMin
        +float strokeMax
        +float timeScl
        +float radius
        +float radiusOffset
        +float x
        +float y
        +Interp strokeInterp
        --
        +void draw(Building build)
    }
}

' ─── Inheritance ────────────────────────────────────────────────────────
Renderer ..|> ApplicationListener

CubemapMesh ..|> Disposable
PlanetRenderer ..|> Disposable

ShaderLayer --|> CacheLayer

BlockQuadtree --|> QuadTree
BlockLightQuadtree --|> QuadTree
OverlayQuadtree --|> QuadTree
FloorQuadtree --|> QuadTree

DrawDefault --|> DrawBlock
DrawRegion --|> DrawBlock
DrawMulti --|> DrawBlock
DrawBlockParts --|> DrawBlock
DrawArcSmelt --|> DrawBlock
DrawCircles --|> DrawBlock

' ─── Composition / Aggregation ──────────────────────────────────────────
Renderer *-- BlockRenderer : blocks
Renderer *-- PlanetRenderer : planets

BlockRenderer *-- BlockQuadtree : blockTree
BlockRenderer *-- BlockLightQuadtree : blockLightTree
BlockRenderer *-- OverlayQuadtree : overlayTree
BlockRenderer *-- FloorQuadtree : floorTree

PlanetRenderer *-- CubemapMesh : skybox

DrawMulti o-- DrawBlock : drawers\n(composite)

' ─── Dependencies ───────────────────────────────────────────────────────
BlockRenderer ..> CacheLayer : uses cacheLayer\nfor quadtree indexing
ShaderLayer ..> Renderer : uses effectBuffer\n& floor

@enduml
