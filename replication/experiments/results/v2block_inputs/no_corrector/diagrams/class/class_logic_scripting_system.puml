@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F0C040
}

title In-Game Logic Scripting System

' ─────────────────────────────────────────
' VM
' ─────────────────────────────────────────
package "mindustry.logic — VM" {

    class LExecutor {
        +{static} maxInstructions: int = 1000
        +{static} maxGraphicsBuffer: int = 256
        +{static} unitTimeouts: IntFloatMap
        --
        +instructions: LInstruction[]
        +vars: LVar[]
        +counter: LVar
        +unit: LVar
        +thisv: LVar
        +ipt: LVar
        +links: Building[]
        +build: LogicBuild
        +team: Team
        +privileged: boolean
        #nameMap: ObjectIntMap<String>
        --
        +{static} runLogicScript(code: String): void
        +runOnce(): void
        +load(builder: LAssembler): void
        +initialized(): boolean
        +optionalVar(name: String): LVar
        +timeoutDone(unit: Unit, delay: float): boolean
        +updateTimeout(unit: Unit): void
    }

    interface LInstruction <<inner interface>> {
        +run(exec: LExecutor): void
    }

    class SetI {
        +from: LVar
        +to: LVar
        --
        +run(exec: LExecutor): void
    }

    class OpI {
        +op: LogicOp
        +a: LVar
        +b: LVar
        +dest: LVar
        --
        +run(exec: LExecutor): void
    }

    class JumpI {
        +addr: int
        +op: ConditionOp
        +a: LVar
        +b: LVar
        --
        +run(exec: LExecutor): void
    }

    class SenseI {
        +from: LVar
        +to: LVar
        +type: LVar
        --
        +run(exec: LExecutor): void
    }

    class DrawI {
        +run(exec: LExecutor): void
    }

    class PrintI {
        +run(exec: LExecutor): void
    }

    class UnitControlI {
        +run(exec: LExecutor): void
    }

    note bottom of LInstruction
        50+ inner static implementors in LExecutor:\nSetI, OpI, JumpI, SenseI, DrawI, PrintI,
        UnitControlI, GetLinkI, ReadI, WriteI,
        RadarI, WaitI, EndI, NoopI, LookupI,
        PackColorI, SpawnUnitI, SetRuleI,
        EffectI, ExplosionI, SetPropI, ...
    end note
}

' ─────────────────────────────────────────
' AST / Compiler
' ─────────────────────────────────────────
package "mindustry.logic — AST & Compiler" {

    abstract class LStatement {
        #elem: StatementElem
        --
        +{abstract} build(table: Table): void
        +{abstract} build(builder: LAssembler): LInstruction
        --
        +category(): LCategory
        +copy(): LStatement
        +hidden(): boolean
        +privileged(): boolean
        +write(builder: StringBuilder): void
        +typeName(): String
        #sanitize(value: String): String
        #field(...): Cell<TextField>
        +{static} showAlignSelect(...): void
    }

    class SetStatement {
        +run(exec: LExecutor): void
    }
    class OperationStatement
    class JumpStatement
    class SensorStatement
    class DrawStatement
    class PrintStatement
    class UnitBindStatement
    class UnitControlStatement
    class RadarStatement
    class UnitRadarStatement
    class SpawnUnitStatement
    class SetRuleStatement

    note right of SetRuleStatement
        50+ concrete statement subclasses\nhosted in LStatements container:\nReadStatement, WriteStatement,\nDrawStatement, PrintStatement,\nGetLinkStatement, ControlStatement,\nSensorStatement, SetStatement,\nOperationStatement, JumpStatement,\nWaitStatement, UnitBindStatement,\nUnitControlStatement, UnitLocateStatement,\nQueryStatement, GetBlockStatement,\nSetBlockStatement, SpawnBulletStatement,\nApplyStatusStatement, WeatherSenseStatement,\nSpawnWaveStatement, EffectStatement,\nCutsceneStatement, SyncStatement, ...
    end note

    class LAssembler {
        +{static} customParsers: ObjectMap<String, Func<String[], LStatement>>
        --
        +privileged: boolean
        +vars: OrderedMap<String, LVar>
        +instructions: LInstruction[]
        --
        +{static} assemble(data: String, privileged: boolean): LAssembler
        +{static} write(statements: Seq<LStatement>): String
        +{static} read(text: String, privileged: boolean): Seq<LStatement>
        +var(symbol: String): LVar
        +putConst(name: String, value: Object): LVar
        +putVar(name: String): LVar
        +getVar(name: String): LVar
        +parseDouble(symbol: String): double
    }

    class LParser {
        +{static} maxJumps: int = 500
        +{static} opNameChanges: StringMap
        --
        +statements: Seq<LStatement>
        -chars: char[]
        -pos: int
        -line: int
        -privileged: boolean
        --
        +LParser(text: String, privileged: boolean)
        +parse(): Seq<LStatement>
        +statement(): void
        +token(): String
        +error(message: String): void
    }
}

' ─────────────────────────────────────────
' Variables
' ─────────────────────────────────────────
package "mindustry.logic — Variables" {

    class LVar {
        +name: String
        +id: int
        +isobj: boolean
        +constant: boolean
        +objval: Object
        +numval: double
        +syncTime: long
        --
        +building(): Building
        +obj(): Object
        +team(): Team
        +bool(): boolean
        +num(): double
        +numf(): float
        +numi(): int
        +setbool(value: boolean): void
        +setnum(value: double): void
        +setobj(value: Object): void
        +set(other: LVar): void
        +{static} invalid(d: double): boolean
    }

    class GlobalVars {
        +{static} ctrlProcessor: int = 1
        +{static} ctrlPlayer: int = 2
        +{static} ctrlCommand: int = 3
        +{static} rand: Rand
        -vars: ObjectMap<String, LVar>
        -privilegedNames: ObjectSet<String>
        -logicIdToContent: UnlockableContent[][]
        --
        +init(): void
        +put(name: String, value: Object, privileged: boolean, constant: boolean): LVar
        +putEntry(name: String, value: double): void
        +get(symbol: String, privileged: boolean): LVar
        +update(): void
    }
}

' ─────────────────────────────────────────
' UI
' ─────────────────────────────────────────
package "mindustry.logic — UI" {

    class LCanvas {
        +privileged: boolean
        +dragging: StatementElem
        +hovered: StatementElem
        +targetWidth: float
        --
        +LCanvas()
        +rebuild(): void
        +add(statement: LStatement): void
        +addAt(at: int, statement: LStatement): void
        +save(): String
        +load(asm: String): void
        +{static} useRows(): boolean
        +{static} tooltip(cell: Cell, key: String): void
    }

    class StatementElem <<inner class>> {
        ' inner class of LCanvas; extends Table
    }

    class DragLayout <<inner class>> {
        ' inner class of LCanvas
    }

    class LogicDialog {
        +canvas: LCanvas
        +consumer: Cons<String>
        +privileged: boolean
        +executor: LExecutor
        --
        +LogicDialog()
        +show(code: String, privileged: boolean, consumer: Cons<String>): void
        +{static} typeColor(s: LVar, color: Color): Color
        +showAddDialog(): void
        +setup(): void
    }
}

' ─────────────────────────────────────────
' Enums & Interfaces
' ─────────────────────────────────────────
package "mindustry.logic — Enums & Interfaces" {

    enum LogicOp {
        add, sub, mul, div, idiv, mod, emod, pow
        equal, notEqual, land
        lessThan, lessThanEq
        greaterThan, greaterThanEq, strictEqual
        shl, shr, ushr, or, and, xor, not
        max, min, abs, floor, ceil, round, sqrt
        sin, cos, tan, asin, acos, atan, rand
        --
        +symbol: String
        +unary: boolean
        +function1: Floatc
        +function2: Floatc2
    }

    enum LAccess {
        totalItems, firstItem
        totalLiquids, totalPower
        health, maxHealth, shield, armor
        x, y, velocityX, velocityY, rotation
        team, type, flag, name, controller
        dead, solid, size, range
        shooting, mining, building
    }

    interface Senseable {
        +{static} noSensed: Object
        --
        +sense(sensor: LAccess): double
        +sense(content: Content): double
        +senseObject(sensor: LAccess): Object
    }
}

' ═══════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════

' LExecutor VM — holds instructions and vars (composition)
LExecutor *-right- "instructions\n[ ]" LInstruction : executes
LExecutor *-down- "vars\n[ ]" LVar : stores

' LInstruction is inner interface of LExecutor
LExecutor +.. LInstruction : <<inner interface>>

' LInstruction implementors (inner static classes)
LInstruction <|.. SetI
LInstruction <|.. OpI
LInstruction <|.. JumpI
LInstruction <|.. SenseI
LInstruction <|.. DrawI
LInstruction <|.. PrintI
LInstruction <|.. UnitControlI

' LExecutor loads from LAssembler
LExecutor ..> LAssembler : load(builder)

' Compiler pipeline
LAssembler ..> LParser : parse text
LAssembler ..> GlobalVars : resolve constants
LAssembler ..> LVar : creates / resolves

' LStatement abstract hierarchy
LStatement <|-- SetStatement
LStatement <|-- OperationStatement
LStatement <|-- JumpStatement
LStatement <|-- SensorStatement
LStatement <|-- DrawStatement
LStatement <|-- PrintStatement
LStatement <|-- UnitBindStatement
LStatement <|-- UnitControlStatement
LStatement <|-- RadarStatement
LStatement <|-- SpawnUnitStatement
LStatement <|-- SetRuleStatement
RadarStatement <|-- UnitRadarStatement

' Each LStatement compiles to an LInstruction
LStatement ..> LInstruction : build(LAssembler) →

' LCanvas visual editor
LCanvas ..> LAssembler : save() / load()
LCanvas *-- StatementElem : 1..*
LCanvas *-- DragLayout
StatementElem o-- LStatement : wraps

' LogicDialog top-level UI
LogicDialog *-- LCanvas : contains
LogicDialog o-left- LExecutor : executor ref

' Enum / interface usage
OpI ..> LogicOp : dispatches op
SenseI ..> LAccess : reads property
SenseI ..> Senseable : senses target

@enduml
