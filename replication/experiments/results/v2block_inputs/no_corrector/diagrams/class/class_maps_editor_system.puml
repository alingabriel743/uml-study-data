title Maps & Map Editor System

' ============ EXTERNAL STUBS ============
class Tile {
    +int x, y
    +void setFloor(Floor type)
    +void setBlock(Block type, Team team, int rotation, Prov<Building> ep)
    +void setTeam(Team team)
    +void setOverlay(Block overlay)
}

class Dialog
class BaseDialog

' ============ mindustry.maps ============
package "mindustry.maps" {

    interface MapProvider <<interface>> {
        +Map next(Gamemode mode, Map prev)
    }

    enum ShuffleMode {
        none
        all
        custom
        both
    }

    class Maps {
        -Seq<Map> maps
        -ShuffleMode shuffleMode
        -MapProvider shuffler
        -Map nextMapOverride
        -ObjectSet<Map> previewList
        +{static} Prov<GenerateFilter>[] allFilterTypes
        +{static} String[] defaultMapNames
        +{static} String[] pvpMaps
        --
        +Seq<Map> all()
        +Seq<Map> customMaps()
        +Seq<Map> defaultMaps()
        +Seq<Map> moddedMaps()
        +Map byName(String name)
        +Map getNextMap(Gamemode mode, Map previous)
        +Map loadInternalMap(String name)
        +void load()
        +void reload()
        +Map saveMap(ObjectMap<String,String> baseTags)
        +void importMap(Fi file)
        +void removeMap(Map map)
        +Seq<GenerateFilter> readFilters(String str)
        +void addDefaultOres(Seq<GenerateFilter> filters)
        +void loadPreviews()
        +void setShuffleMode(ShuffleMode mode)
        +void setMapProvider(MapProvider provider)
        +void setNextMapOverride(Map map)
    }

    class Map {
        +boolean custom
        +StringMap tags
        +Fi file
        +int version
        +boolean workshop
        +int width
        +int height
        +Texture texture
        +IntSet teams
        +int spawns
        +LoadedMod mod
        --
        +String name()
        +String author()
        +String description()
        +Rules applyRules(Gamemode mode)
        +Rules rules()
        +Seq<GenerateFilter> filters()
        +Fi previewFile()
        +Fi cacheFile()
        +int getHighScore()
        +void setHighScore(int score)
        +int compareTo(Map map)
    }

    class SectorDamage {
        +{static} boolean rubble
        --
        +{static} void apply(float fraction)
        +{static} float cost(Tile tile)
    }

    note right of SectorDamage
        Phase 1: A* from each spawn to core,
        removes buildings proportionally.
        Phase 2: BFS damage falloff propagation.
    end note
}

