' ============ mindustry.maps.filters ============
package "mindustry.maps.filters" {

    abstract class GenerateFilter {
        +int seed
        --
        +{abstract} FilterOption[] options()
        +void apply(Tiles tiles, GenerateInput in)
        +void apply(GenerateInput in)
        +void draw(Image image)
        +String simpleName()
        +String name()
        +char icon()
        +void randomize()
        +boolean isBuffered()
        +boolean isPost()
        +GenerateFilter copy()
        #float noise(int seedOffset, GenerateInput in, float scl, float mag)
        #float rnoise(float x, float y, float scl, float mag)
    }

    class GenerateInput <<inner>> {
        +int x
        +int y
        +int width
        +int height
        +Floor floor
        +Block block
        +Block overlay
        +long packedData
        --
        +void set(Tile tile)
        +void begin(int w, int h, TileProvider p)
    }

    abstract class FilterOption {
        +Runnable changed
        --
        +{abstract} void build(Table table)
    }

    note right of FilterOption
        Inner subclasses:
        - SliderOption(name, Floatp getter, Floatc setter, min, max)
        - BlockOption(name, Prov<Block> supplier, Cons<Block> consumer, Boolf<Block> filter)
        - ToggleOption(name, Boolp getter, Boolc setter)
        Static predicates: floorsOnly, wallsOnly,
        floorsOptional, wallsOptional, oresOnly, anyOptional
    end note

    class BlendFilter {
        +float radius
        +Block block
        +Block floor
        +Block ignore
        --
        +FilterOption[] options()
        +boolean isBuffered()
        +char icon()
        +void apply(GenerateInput in)
    }

    class ClearFilter {
        +Block target
        +Block replace
        +Block ignore
        --
        +FilterOption[] options()
        +void apply(GenerateInput in)
    }

    class EnemySpawnFilter {
        +int amount
        --
        +FilterOption[] options()
        +void apply(Tiles tiles, GenerateInput in)
        +boolean isPost()
    }

    note bottom of EnemySpawnFilter
        Other GenerateFilter subclasses (12 more):
        ScatterFilter, NoiseFilter, TerrainFilter,
        DistortFilter, RiverNoiseFilter, OreFilter,
        OreMedianFilter, MedianFilter, MirrorFilter,
        CoreSpawnFilter, SpawnPathFilter, LogicFilter
    end note
}

' ============ mindustry.maps.generators ============
package "mindustry.maps.generators" {

    interface WorldGenerator <<interface>> {
        +void generate(Tiles tiles, WorldParams params)
        +void postGenerate(Tiles tiles)
    }

    abstract class BasicGenerator {
        #Rand rand
        #int width
        #int height
        #Tiles tiles
        #Block floor
        #Block block
        #Block ore
        #Schematic defaultLoadout
        --
        +void generate(Tiles tiles, WorldParams params)
        +void median(int radius, double percentile, Block targetFloor)
        +void ores(Seq<Block> ores)
        +void terrain(Block dst, float scl, float mag, float cmag)
        +void noise(Block floor, Block block, int octaves, float falloff, float scl, float threshold)
        +void distort(float scl, float mag)
        +void scatter(Block target, Block dst, float chance)
        +void cells(int iterations, int birthLimit, int deathLimit, int cradius)
        +void cliffs()
        +void blend(Block floor, Block around, float radius)
        +void pass(Intc2 r)
        +void trimDark()
        +void inverseFloodFill(Tile start)
        +Seq<Tile> pathfind(int startX, int startY, int endX, int endY, TileHeuristic th, DistanceHeuristic dh)
        +boolean nearWall(int x, int y)
        +boolean nearAir(int x, int y)
        #{abstract} float noise(float x, float y, double octaves, double falloff, double scl, double mag)
    }

    abstract class PlanetGenerator {
        #int baseSeed
        #int seed
        #Sector sector
        --
        +void generateSector(Sector sector)
        +void onSectorCaptured(Sector sector)
        +void onSectorLost(Sector sector)
        +void beforeSaveWrite(Sector sector)
        +boolean allowLanding(Sector sector)
        +boolean allowAcceleratorLanding(Sector sector)
        +Sector findLaunchCandidate(Sector destination, Sector selected)
        +void addWeather(Sector sector, Rules rules)
        +float getSizeScl()
        +int getSectorSize(Sector sector)
        +void generate(Tiles tiles, Sector sec, WorldParams params)
        #void genTile(Vec3 position, TileGen tile)
        +void getLockedText(Sector hovered, StringBuilder out)
        +TextureRegion getLockedIcon(Sector hovered)
    }

    class SerpuloPlanetGenerator {
    }

    class ErekirPlanetGenerator {
    }

    class AsteroidGenerator {
    }

    class TantrosPlanetGenerator {
    }

    class BlankPlanetGenerator {
    }

    class FileMapGenerator {
        +void generate(Tiles tiles, WorldParams params)
    }
}

' ============ RELATIONSHIPS ============

' Maps nested types
Maps +-- MapProvider : <<defines>>
Maps +-- ShuffleMode : <<defines>>
ShuffleMode ..|> MapProvider

' Maps management
Maps "1" *-- "many" Map : contains
Maps ..> MapProvider : uses

' Map external interfaces
Map ..|> "Comparable<Map>"
Map ..|> Publishable

' Map → filters
Map ..> GenerateFilter : uses via filters()

' Editor hierarchy
MapEditorDialog --|> Dialog
MapEditorDialog ..|> Disposable
MapEditorDialog *-- MapGenerateDialog : generateDialog
MapEditorDialog ..> MapEditor : uses (Vars.editor)

MapGenerateDialog --|> BaseDialog
MapGenerateDialog *-- "many" GenerateFilter : manages
MapGenerateDialog ..> MapEditor : modifies tiles

' MapEditor internals
MapEditor *-- EditorRenderer : renderer
MapEditor *-- OperationStack : stack
MapEditor *-- DrawOperation : currentOp
MapEditor ..> EditorTile : creates

' EditorTile
EditorTile --|> Tile
EditorTile ..> MapEditor : calls addTileOp (undo/redo ops)

' Filter hierarchy
GenerateFilter *-- GenerateInput : <<inner class>>
GenerateFilter ..> FilterOption : uses for UI options

GenerateFilter <|-- BlendFilter
GenerateFilter <|-- ClearFilter
GenerateFilter <|-- EnemySpawnFilter

' Generator hierarchy
BasicGenerator ..|> WorldGenerator
PlanetGenerator --|> BasicGenerator
PlanetGenerator ..|> HexMesher

SerpuloPlanetGenerator --|> PlanetGenerator
ErekirPlanetGenerator --|> PlanetGenerator
AsteroidGenerator --|> PlanetGenerator
TantrosPlanetGenerator --|> PlanetGenerator
BlankPlanetGenerator --|> PlanetGenerator
FileMapGenerator --|> PlanetGenerator

' Cross-system
SectorDamage ..> Tile : uses (cost calculation)

@enduml
