@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EEF2FF
    BorderColor #6366F1
}

title Modding System & Game Type Hierarchy

' ─────────────────────────────────────────────────────────────
' Shared interfaces
' ─────────────────────────────────────────────────────────────
interface Senseable {
    +sense(LAccess): double
}

interface Cloneable

' ─────────────────────────────────────────────────────────────
' Core content type hierarchy  (mindustry.ctype)
' ─────────────────────────────────────────────────────────────
package "mindustry.ctype" {

    abstract class Content {
        +minfo: ContentInfo
        +techNode: TechNode
        +techNodes: Seq<TechNode>
        --
        +init()
        +load()
        +postInit()
        +afterPatch()
        +getDependencies(Cons<Content>)
        +getContentType(): ContentType
        +researchRequirements(): ItemStack[]
    }

    abstract class MappableContent {
        <<@NoPatch>>
        +name: String
        --
        +MappableContent(String name)
    }

    abstract class UnlockableContent {
        +localizedName: String
        +description: String
        +alwaysUnlocked: boolean
        +uiIcon: TextureRegion
        +fullIcon: TextureRegion
        +shownPlanets: Seq<Planet>
        +databaseTabs: Seq<UnlockableContent>
        --
        +isOnPlanet(Planet): boolean
        +isHidden(): boolean
        +loadIcon()
        +setStats()
        +unlocked(): boolean
        +unlock()
    }
}

Content       <|-- MappableContent
MappableContent <|-- UnlockableContent

' ─────────────────────────────────────────────────────────────
' Leaf game content types  (mindustry.type)
' ─────────────────────────────────────────────────────────────
package "mindustry.type" {

    class Item {
        +color: Color
        +explosiveness: float
        +flammability: float
        +radioactivity: float
        +hardness: int
        +cost: float
        +buildable: boolean
        +hidden: boolean
        --
        +Item(String name, Color color)
        +getContentType(): ContentType
        +{static} getAllOres(): Seq<Item>
        +sense(LAccess): double
        +setStats()
    }

    class Liquid {
        +gas: boolean
        +color: Color
        +flammability: float
        +temperature: float
        +heatCapacity: float
        +viscosity: float
        +explosiveness: float
        +effect: StatusEffect
        +boilPoint: float
        +hidden: boolean
        --
        +Liquid(String name, Color color)
        +getContentType(): ContentType
        +willBoil(): boolean
        +canExtinguish(): boolean
        +react(Liquid, float, Tile, float, float): float
        +sense(LAccess): double
    }

    class UnitType {
        +speed: float
        +hitSize: float
        +drag: float
        +accel: float
        +health: float
        +armor: float
        +flying: boolean
        +targetable: boolean
        +mineSpeed: float
        +buildSpeed: float
        +weapons: Seq<Weapon>
        +abilities: Seq<Ability>
        +constructor: Prov<Unit>
        +controller: Func<Unit, UnitController>
        --
        +getContentType(): ContentType
        +draw(Unit)
        +beforeParse()
        +sense(LAccess): double
    }

    class Weapon {
        +name: String
        +bullet: BulletType
        +mirror: boolean
        +alternate: boolean
        +rotate: boolean
        +controllable: boolean
        +autoTarget: boolean
        +reload: float
        +inaccuracy: float
        +shake: float
        +shootPattern: ShootPattern
        +x: float
        +y: float
        --
        +init()
        +load()
        +update(Unit, WeaponMount)
        +shoot(Unit, WeaponMount, boolean)
    }

    class StatusEffect {
        +damageMultiplier: float
        +healthMultiplier: float
        +speedMultiplier: float
        +reloadMultiplier: float
        +buildSpeedMultiplier: float
        +disarm: boolean
        +damage: float
        +permanent: boolean
        +reactive: boolean
        +color: Color
        +affinities: ObjectSet<StatusEffect>
        +opposites: ObjectSet<StatusEffect>
        +transitions: ObjectMap<StatusEffect, TransitionHandler>
        --
        +StatusEffect(String name)
        +getContentType(): ContentType
        +opposite(StatusEffect...)
        +affinity(StatusEffect, TransitionHandler)
        +isHidden(): boolean
    }

    class Weather {
        +duration: float
        +opacityMultiplier: float
        +status: StatusEffect
        +statusDuration: float
        +statusAir: boolean
        +statusGround: boolean
        +type: Prov<WeatherState>
        --
        +Weather(String name, Prov<WeatherState> type)
        +getContentType(): ContentType
        +create(): WeatherState
        +create(float): WeatherState
        +draw(WeatherState)
    }
}

UnlockableContent <|-- Item
UnlockableContent <|-- Liquid
UnlockableContent <|-- UnitType
UnlockableContent <|-- StatusEffect
UnlockableContent <|-- Weather

Item        ..|> Senseable
Liquid      ..|> Senseable
UnitType    ..|> Senseable
Weapon      ..|> Cloneable

UnitType  *-- "Seq<Weapon>" Weapon     : weapons (composition)
Liquid    --> StatusEffect             : effect
Weather   --> StatusEffect             : status
StatusEffect o-- StatusEffect          : affinities / opposites

' ─────────────────────────────────────────────────────────────
' UnitType subclasses  (mindustry.type.unit)
' ─────────────────────────────────────────────────────────────
package "mindustry.type.unit" {
    class ErekirUnitType
    class MissileUnitType
    class NeoplasmUnitType
    class TankUnitType
}

UnitType <|-- ErekirUnitType
UnitType <|-- MissileUnitType
UnitType <|-- NeoplasmUnitType
UnitType <|-- TankUnitType

' ─────────────────────────────────────────────────────────────
' Weapon subclasses  (mindustry.type.weapons)
' ─────────────────────────────────────────────────────────────
package "mindustry.type.weapons" {
    class BuildWeapon
    class MineWeapon
    class PointDefenseWeapon
    class PointDefenseBulletWeapon
    class RepairBeamWeapon
}

Weapon <|-- BuildWeapon
Weapon <|-- MineWeapon
Weapon <|-- PointDefenseWeapon
Weapon <|-- PointDefenseBulletWeapon
Weapon <|-- RepairBeamWeapon

' ─────────────────────────────────────────────────────────────
' Weather subclasses  (mindustry.type.weather)
' ─────────────────────────────────────────────────────────────
package "mindustry.type.weather" {
    class ParticleWeather
    class RainWeather
    class MagneticStorm
    class SolarFlare
}

Weather <|-- ParticleWeather
Weather <|-- RainWeather
Weather <|-- MagneticStorm
Weather <|-- SolarFlare

' ─────────────────────────────────────────────────────────────
' Modding infrastructure  (mindustry.mod)
' ─────────────────────────────────────────────────────────────
package "mindustry.mod" {

    class ContentParser {
        +contentTypes: ObjectMap<Class<?>, ContentType>
        +currentMod: LoadedMod
        +currentContent: Content
        +allowClassResolution: boolean
        +allowAssetLoading: boolean
        +parsers: ObjectMap<ContentType, TypeParser<?>>
        +classParsers: ObjectMap<Class<?>, FieldParser>
        --
        +parse(LoadedMod, String, String, Fi, ContentType): Content
        +readFields(Object, JsonValue)
        +finishParsing()
        +resolve(String, Class<T>): Class<T>
        +locate(ContentType, String): T
        +make(Class<T>): T
        +readBundle(ContentType, String, JsonValue)
        +markError(Content, LoadedMod, Fi, Throwable)
    }

    interface FieldParser <<inner>> {
        +parse(Type, JsonValue): Object
    }

    interface TypeParser <<inner>> {
        +parse(ContentType, String): Content
    }

    interface ParseListener <<inner>> {
        +parsed(Content)
    }

    class DataPatcher {
        +applied: boolean
        +patches: Seq<PatchSet>
        --
        +apply(Seq<String>): void
        +unapply(): void
        +assign(Object, String, Object): void
        +modifiedField(Object, String, Object): void
        +isPatched(Object): boolean
        +reset(Runnable): void
        +warn(String, Object...): void
    }

    class PatchSet <<inner>> {
        +patch: String
        +json: JsonValue
        +name: String
        +error: Throwable
    }

    class FieldData <<inner>> {
        +type: Class<?>
        +elementType: Class<?>
        +keyType: Class<?>
    }

    class ClassMap {
        +{static} classes: ObjectMap<String, Class<?>>
    }
}

ContentParser +-- FieldParser
ContentParser +-- TypeParser
ContentParser +-- ParseListener
DataPatcher   +-- PatchSet
DataPatcher   +-- FieldData

ContentParser  --> ClassMap      : resolves types via
ContentParser ..> Content        : creates & initialises
DataPatcher    --> ContentParser : uses static instance

' ─────────────────────────────────────────────────────────────
' Tech tree  (mindustry.content)
' ─────────────────────────────────────────────────────────────
package "mindustry.content" {

    class TechTree {
        +{static} all: Seq<TechNode>
        +{static} roots: Seq<TechNode>
        --
        +{static} nodeRoot(String, UnlockableContent, Runnable): TechNode
        +{static} node(UnlockableContent, Runnable): TechNode
        +{static} node(UnlockableContent, ItemStack[], Runnable): TechNode
        +{static} nodeProduce(UnlockableContent, Runnable): TechNode
        +{static} context(): TechNode
    }

    class TechNode <<inner>> {
        +depth: int
        +name: String
        +requiresUnlock: boolean
        +content: UnlockableContent
        +requirements: ItemStack[]
        +finishedRequirements: ItemStack[]
        +objectives: Seq<Objective>
        +children: Seq<TechNode>
        +parent: TechNode
        +planet: Planet
        --
        +TechNode(TechNode parent, UnlockableContent content, ItemStack[])
        +each(Cons<TechNode>)
        +setupRequirements(ItemStack[])
        +addPlanet(Planet)
        +reset()
        +save()
        +remove()
    }
}

TechTree +-- TechNode
TechNode o-- TechNode          : parent / children
TechNode --> UnlockableContent : content
ContentParser ..> TechNode     : creates via "research" JSON key

@enduml
