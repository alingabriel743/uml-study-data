@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Networking & IO Serialization

package "mindustry.net" {

    class Administration {
        -bannedIPs: Seq<String>
        -whitelist: Seq<String>
        -chatFilters: Seq<ChatFilter>
        -actionFilters: Seq<ActionFilter>
        -playerInfo: ObjectMap<String, PlayerInfo>
        -kickedIPs: ObjectMap<String, Long>
        -dosBlacklist: ObjectSet<String>
        +blacklistDos(address: String): void
        +isDosBlacklisted(address: String): boolean
        +addChatFilter(filter: ChatFilter): void
        +filterMessage(player: Player, message: String): String
        +addActionFilter(filter: ActionFilter): void
        +allowAction(player: Player, type: ActionType, ...): boolean
        +updatePlayerJoined(id: String, ip: String, name: String): void
        +banPlayer(uuid: String): boolean
        +unbanPlayerIP(ip: String): boolean
        +adminPlayer(id: String, usid: String): boolean
        +getInfo(id: String): PlayerInfo
        +findByName(name: String): ObjectSet<PlayerInfo>
        +save(): void
        +forceSave(): void
    }

    class Config {
        {static} +all: Seq<Config>
        +name: String
        +key: String
        +description: String
        +defaultValue: Object
        +changed: Runnable
        +get(): Object
        +bool(): boolean
        +num(): int
        +string(): String
        +set(value: Object): void
        +isDefault(): boolean
        +isNum(): boolean
        +isBool(): boolean
        +isString(): boolean
    }

    class PlayerInfo <<Serializable>> {
        +id: String
        +lastName: String
        +lastIP: String
        +ips: Seq<String>
        +names: Seq<String>
        +adminUsid: String
        +timesKicked: int
        +timesJoined: int
        +banned: boolean
        +admin: boolean
        +lastKicked: long
        +plainLastName(): String
    }

    interface ChatFilter {
        +filter(player: Player, message: String): String
    }

    interface ActionFilter {
        +allow(action: PlayerAction): boolean
    }

    class TraceInfo {
        +ip: String
        +uuid: String
        +locale: String
        +modded: boolean
        +mobile: boolean
        +timesJoined: int
        +timesKicked: int
        +ips: String[]
        +names: String[]
    }

    class PlayerAction <<Poolable>> {
        +player: Player
        +type: ActionType
        +tile: Tile
        +block: Block
        +rotation: int
        +config: Object
        +unit: Unit
        +set(player: Player, type: ActionType, tile: Tile): PlayerAction
        +reset(): void
    }

    enum ActionType {
        breakBlock
        placeBlock
        rotate
        configure
        withdrawItem
        depositItem
        control
        buildSelect
        command
        removePlanned
        respawn
        pickupBlock
        dropPayload
        pingLocation
    }

    class NetworkIO {
        {static} +writeWorld(player: Player, os: OutputStream): void
        {static} +readWorld(is: InputStream): void
    }
}

package "mindustry.io" {

    abstract class SaveFileReader {
        {static} +fallback: ObjectMap<String, String>
        {static} +modContentNameMap: ObjectMap<String, String>
        {static} #byteOutput: ReusableByteOutStream
        {static} #dataBytes: DataOutputStream
        +readRegion(name: String, stream: DataInput, ...): void
        +writeRegion(name: String, stream: DataOutput, ...): void
        +writeChunk(output: DataOutput, runner: IORunner): void
        +readChunk(input: DataInput, runner: IORunnerLength): int
        +skipChunk(input: DataInput): void
        +writeStringMap(stream: DataOutput, map: ObjectMap): void
        +readStringMap(stream: DataInput): StringMap
        {static} +mapFallback(name: String): String
        {abstract} +read(stream: DataInputStream, ...): void
        {abstract} +write(stream: DataOutputStream): void
    }

    interface IORunner {
        +accept(stream: T): void
    }

    interface IORunnerLength {
        +accept(stream: T, length: int): void
    }

    interface CustomChunk {
        +write(stream: DataOutput): void
        +read(stream: DataInput): void
        +shouldWrite(): boolean
        +writeNet(): boolean
    }

    abstract class SaveVersion {
        +version: int
        {static} #customChunks: OrderedMap<String, CustomChunk>
        {static} +addCustomChunk(name: String, chunk: CustomChunk): void
        +getMeta(stream: DataInput): SaveMeta
        +write(stream: DataOutputStream): void
        +read(stream: DataInputStream, ...): void
        +writeMeta(stream: DataOutput, tags: StringMap): void
        +readMeta(stream: DataInput, context: WorldContext): void
        +writeMap(stream: DataOutput): void
        +readMap(stream: DataInput, context: WorldContext): void
        +writeEntities(stream: DataOutput): void
        +readEntities(stream: DataInput): void
        +writeContentHeader(stream: DataOutput): void
        +readContentHeader(stream: DataInput): void
        +writeCustomChunks(stream: DataOutput, net: boolean): void
        +readCustomChunks(stream: DataInput): void
        +writeMarkers(stream: DataOutput): void
        +readMarkers(stream: DataInput): void
    }

    class SaveMeta {
        +version: int
        +build: int
        +timestamp: long
        +timePlayed: long
        +map: Map
        +wave: int
        +rules: Rules
        +tags: StringMap
        +mods: String[]
    }

    class SaveIO {
        {static} +header: byte[]
        {static} +versions: IntMap<SaveVersion>
        {static} +versionArray: Seq<SaveVersion>
        {static} +getSaveWriter(): SaveVersion
        {static} +getSaveWriter(version: int): SaveVersion
        {static} +save(file: Fi): void
        {static} +write(file: Fi): void
        {static} +write(os: OutputStream, tags: StringMap): void
        {static} +load(file: Fi): void
        {static} +load(is: InputStream, context: WorldContext): void
        {static} +getMeta(file: Fi): SaveMeta
        {static} +isSaveValid(file: Fi): boolean
        {static} +readHeader(input: DataInput): void
        {static} +fileFor(slot: int): Fi
        {static} +getVersion(): SaveVersion
    }

    class MapIO {
        {static} +isImage(file: Fi): boolean
        {static} +createMap(file: Fi, custom: boolean): Map
        {static} +writeMap(file: Fi, map: Map): void
        {static} +loadMap(map: Map): void
        {static} +generatePreview(map: Map): Pixmap
        {static} +writeImage(tiles: Tiles): Pixmap
        {static} +readImage(pixmap: Pixmap, tiles: Tiles): void
        {static} +colorFor(wall: Block, floor: Block, overlay: Block, team: Team): int
    }

    class JsonIO {
        {static} +json: Json
        {static} -jsonBase: CustomJson
        {static} +write(object: Object): String
        {static} +read(type: Class, string: String): T
        {static} +copy(object: T): T
        {static} +writeBytes(value: Object, ...): void
        {static} +readBytes(type: Class, ...): T
        {static} +print(in: String): String
        {static} +classTag(tag: String, type: Class): void
    }
}

package "mindustry.io.versions" {

    class ShortChunkSaveVersion {
    }

    class LegacyRegionSaveVersion {
    }

    abstract class LegacySaveVersion {
    }

    class "Save7..Save11" as SaveRecent {
    }

    class "Save1..Save6" as SaveLegacy {
    }
}

note top of ShortChunkSaveVersion : Overrides chunk reading\nfor legacy unsigned-short length
note top of LegacyRegionSaveVersion : Skips custom chunk region\n(save versions <= 6)
note top of LegacySaveVersion : Abstract base for\nlegacy map reading logic
note bottom of SaveRecent : Concrete current readers\n(extend SaveVersion directly)
note bottom of SaveLegacy : Concrete legacy readers\n(extend legacy hierarchy)

' ── Inheritance hierarchy ──────────────────────────────────────────────────────
SaveVersion --|> SaveFileReader
ShortChunkSaveVersion --|> SaveVersion
LegacyRegionSaveVersion --|> ShortChunkSaveVersion
LegacySaveVersion --|> LegacyRegionSaveVersion
SaveRecent --|> SaveVersion
SaveLegacy --|> LegacySaveVersion

' ── Nested-class containment (Administration) ─────────────────────────────────
Administration +-- Config
Administration +-- PlayerInfo
Administration +-- ChatFilter
Administration +-- ActionFilter
Administration +-- TraceInfo
Administration +-- PlayerAction
Administration +-- ActionType

' ── Nested-interface containment (SaveFileReader) ─────────────────────────────
SaveFileReader +-- IORunner
SaveFileReader +-- IORunnerLength
SaveFileReader +-- CustomChunk

' ── Key associations ──────────────────────────────────────────────────────────
Administration ..> PlayerAction : uses via Pools
Administration ..> Config : reads settings

SaveIO o-- SaveVersion : versionArray
SaveIO ..> SaveMeta : produces
SaveVersion ..> JsonIO : meta serialization
SaveVersion o-- CustomChunk : customChunks

MapIO ..> SaveIO : delegates to
NetworkIO ..> SaveIO : uses getSaveWriter()
NetworkIO ..> JsonIO : writes rules/mapLocales

@enduml
