@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam interface {
    BackgroundColor #EEF2FF
    BorderColor #5C6BC0
}
skinparam enum {
    BackgroundColor #FFF8E1
    BorderColor #F9A825
}

title UI Dialogs & HUD Fragments

' ─────────────────────────────────────────────
' Arc library (external) base types
' ─────────────────────────────────────────────
package "arc (external)" {
    class Dialog <<arc lib>>
    class Table <<arc lib>>
    class Element <<arc lib>>
    class Group <<arc lib>>
}

interface Disposable <<arc lib>>

' ─────────────────────────────────────────────
' mindustry.ui.dialogs
' ─────────────────────────────────────────────
package "mindustry.ui.dialogs" {

    class BaseDialog {
        #boolean wasPaused
        #boolean shouldPause
        --
        +BaseDialog(String title)
        +BaseDialog(String title, DialogStyle style)
        #makeButtonOverlay()
        #onResize(Runnable run)
        +addCloseListener()
        +addCloseButton()
        +addCloseButton(float width)
    }

    class HostDialog {
        +HostDialog()
        +runHost()
    }

    class SettingsMenuDialog {
        -BaseDialog dataDialog
        -BaseDialog planetDataDialog
        --
        +addCategory(String name, Cons<SettingsTable> builder)
        +addCategory(String name, Drawable icon, Cons<SettingsTable> builder)
        +exportData(Fi file)
        +importData(Fi file)
        +addCloseButton()
    }

    class SettingsTable {
        --
        +pref(Setting setting)
        +checkPref(String name, boolean def)
        +checkPref(String name, boolean def, Boolc changed)
        +textPref(String name, String def)
        +areaTextPref(String name, String def)
        +rebuild()
    }

    abstract class Setting {
        +{abstract} add(SettingsTable table)
    }

    class CheckSetting
    class SliderSetting
    class TextSetting
    class AreaTextSetting

    abstract class MapListDialog

    class EditorMapsDialog

    class PausedDialog
    class GameOverDialog
    class JoinDialog
    class SchematicsDialog
    class PlanetDialog
    class CustomRulesDialog
    class ResearchDialog
    class LoadoutDialog
}

note "...and 20+ more extend BaseDialog:\nFileChooser, SectorSelectDialog, ModsDialog,\nDatabaseDialog, CampaignCompleteDialog,\nColorPicker, BansDialog, AdminsDialog, etc." as moreDialogs
BaseDialog .. moreDialogs

' ─────────────────────────────────────────────
' mindustry.editor
' ─────────────────────────────────────────────
package "mindustry.editor" {
    class MapEditorDialog {
        --
        +resumeEditing()
        +resumeAfterPlaytest(Map map)
        +beginEditMap(Fi file)
        +build()
        +dispose()
        +hide()
        -addBlockSelection(Table cont)
        -rebuildBlockSelection(String searchText)
    }
}

' ─────────────────────────────────────────────
' mindustry.ui.fragments
' ─────────────────────────────────────────────
package "mindustry.ui.fragments" {

    class HudFragment {
        +PlacementFragment blockfrag
        +CoreItemsDisplay coreItems
        +boolean shown
        -String hudText
        -boolean showHudText
        -Seq<Block> blocksOut
        -Table lastUnlockTable
        -long lastToast
        -float pauseDisableDur
        --
        +build(Group parent)
        +setHudText(String text)
        +toggleHudText(boolean shown)
        +showToast(String text)
        +showToast(Drawable icon, String text)
        +showToast(Drawable icon, float size, String text)
        +showUnlock(UnlockableContent content)
        +showPauseDisabled()
        +hasToast() : boolean
        +{static} setPlayerTeamEditor(Player p, Team t)
    }

    class ChatFragment {
        -{static} int messagesShown = 10
        -Seq<String> messages
        -float fadetime
        -boolean shown
        -TextField chatfield
        -Label fieldlabel
        -ChatMode mode
        -Font font
        -Seq<String> history
        --
        +build(Group parent)
        +clearMessages()
        +toggle()
        +hide()
        +updateChat()
        +addMessage(String message)
        +nextMode()
        +clearChatInput()
        +shown() : boolean
        #draw()
    }

    enum ChatMode {
        normal
        team
        admin
    }

    class HintsFragment {
        +Seq<Hint> hints
        +Hint current
        ~Group group
        ~ObjectSet<String> events
        ~ObjectSet<Block> placedBlocks
        --
        +build(Group parent)
        +shown() : boolean
        +hide()
        ~checkNext()
        ~display(Hint hint)
        ~complete()
    }

    interface Hint {
        +name() : String
        +text() : String
        +complete() : boolean
        +show()
        +order() : int
        +valid() : boolean
        +finish()
        +finished() : boolean
    }

    enum DefaultHint {
        (30+ tutorial entries)
    }

    class MinimapFragment {
        -boolean shown
        +float panx, pany, zoom, lastZoom
        -float baseSize
        +Element elem
        --
        +build(Group parent)
        +panTo(float relativeX, float relativeY)
        +convert(float relativeX, float relativeY) : Vec2
        +shown() : boolean
        +hide()
        +toggle()
        #getRectBounds() : Rect
    }

    class PlacementFragment
}

' ─────────────────────────────────────────────
' mindustry.ui  (custom widgets)
' ─────────────────────────────────────────────
package "mindustry.ui" {

    class Bar {
        -{static} Rect scissor
        -Floatp fraction
        -CharSequence name
        -float value, lastValue, blink
        -float outlineRadius
        -Color blinkColor, outlineColor
        --
        +Bar(String name, Color color, Floatp fraction)
        +Bar(Prov<CharSequence> name, Prov<Color> color, Floatp fraction)
        +Bar()
        +reset(float value)
        +set(Prov<String> name, Floatp fraction, Color color)
        +snap()
        +outline(Color color, float stroke) : Bar
        +flash()
        +blink(Color color) : Bar
        +draw()
    }

    class ItemsDisplay {
        +boolean collapsed
        --
        +ItemsDisplay()
        +rebuild(ItemSeq items)
        +rebuild(ItemSeq items, boolean[] shine)
    }

    class CoreItemsDisplay {
        --
        +resetUsed()
    }

    class Fonts <<utility>> {
        +{static} Font def
        +{static} Font outline
        +{static} Font icon
        +{static} Font iconLarge
        +{static} Font tech
        +{static} Font logic
        +{static} Font monospace
        --
        +{static} loadFonts()
        +{static} loadContentIcons()
        +{static} getUnicode(String content) : int
        +{static} getUnicodeStr(String content) : String
        +{static} unicodeToName(int unicode) : String
        +{static} registerIcon(String name, String regionName, int ch, TextureRegion r)
        +{static} getGlyph(Font font, char glyph) : TextureRegionDrawable
        +{static} mergeFontAtlas(TextureAtlas atlas)
    }
}

' ─────────────────────────────────────────────
' Inheritance — arc bases
' ─────────────────────────────────────────────
Dialog     <|-- BaseDialog
Dialog     <|-- MapEditorDialog

MapEditorDialog ..|> Disposable

Table      <|-- ChatFragment
Table      <|-- SettingsTable
Table      <|-- ItemsDisplay
Table      <|-- CoreItemsDisplay

Element    <|-- Bar

' ─────────────────────────────────────────────
' Inheritance — dialog hierarchy
' ─────────────────────────────────────────────
BaseDialog <|-- HostDialog
BaseDialog <|-- SettingsMenuDialog
BaseDialog <|-- MapListDialog
BaseDialog <|-- PausedDialog
BaseDialog <|-- GameOverDialog
BaseDialog <|-- JoinDialog
BaseDialog <|-- SchematicsDialog
BaseDialog <|-- PlanetDialog
BaseDialog <|-- CustomRulesDialog
BaseDialog <|-- ResearchDialog
BaseDialog <|-- LoadoutDialog

MapListDialog <|-- EditorMapsDialog

' ─────────────────────────────────────────────
' Inner class / enum nesting
' ─────────────────────────────────────────────
SettingsMenuDialog +-- SettingsTable
SettingsMenuDialog +-- Setting

Setting <|-- CheckSetting
Setting <|-- SliderSetting
Setting <|-- TextSetting
Setting <|-- AreaTextSetting

ChatFragment  +-- ChatMode

HintsFragment +-- Hint
HintsFragment +-- DefaultHint
DefaultHint   ..|> Hint

' ─────────────────────────────────────────────
' Composition & associations
' ─────────────────────────────────────────────
HudFragment *-- PlacementFragment : blockfrag
HudFragment *-- CoreItemsDisplay  : coreItems
HudFragment ..> Bar               : uses (boss bar)
HudFragment ..> HintsFragment     : builds
HudFragment ..> ChatFragment      : manages visibility
HudFragment ..> MinimapFragment   : builds

Bar          ..> Fonts : uses Fonts.outline
ChatFragment ..> Fonts : uses Fonts.def

@enduml
