@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title World, Block & Build Foundation

' ---- External / lightweight stubs ----
interface Senseable <<interface>>
interface Position <<interface>>
interface JsonSerializable <<interface>>
interface "Iterable<Tile>" as IterableTile <<interface>>
class PowerGraph <<external>>
class Floor <<external>>

' ============================================================
package "mindustry.ctype" {
    abstract class UnlockableContent {
        +Stats stats
        +String localizedName
        +String description
        +String details
        +boolean alwaysUnlocked
        +boolean hideDetails
        +boolean hideDatabase
        +void setStats()
        +void setBars()
        +boolean unlocked()
    }
}

' ============================================================
package "mindustry.world" {

    class Block {
        +boolean hasItems
        +boolean hasLiquids
        +boolean hasPower
        +boolean solid
        +boolean rotate
        +boolean update
        +boolean destructible
        +boolean configurable
        +int size
        +int health
        +int itemCapacity
        +float liquidCapacity
        +float armor
        +float scaledHealth
        +float buildTime
        +BuildVisibility buildVisibility
        +EnumSet<BlockFlag> flags
        +Attributes attributes
        +ItemStack[] requirements
        +Prov<Building> buildType
        +Consume[] consumers
        +ConsumePower consPower
        +BlockGroup group
        +Category category
        +int envRequired
        +int envEnabled
        +int envDisabled
        +boolean outputsLiquid
        +boolean outputsPower
        +boolean consumesPower
        +Block(String name)
        +void init()
        +void load()
        +void setStats()
        +void setBars()
        +void drawBase(Tile tile)
        +void drawPlace(int x, int y, int rotation, boolean valid)
        +void drawPotentialLinks(int x, int y)
        +boolean canBeBuilt()
        +boolean environmentBuildable()
        +boolean isPlaceable()
        +boolean isVisible()
    }

    class Building <<generated>> {
        ' Note: generated from BuildingComp by annotation processor
        +transient Tile tile
        +transient Block block
        +transient Seq<Building> proximity
        +transient int rotation
        +transient boolean enabled
        +transient float efficiency
        +transient float optionalEfficiency
        +transient float potentialEfficiency
        +{field} @Nullable PowerModule power
        +{field} @Nullable ItemModule items
        +{field} @Nullable LiquidModule liquids
        +float x
        +float y
        +float health
        +float maxHealth
        +Team team
        +boolean dead
        +transient boolean wasVisible
        +Building init(Tile tile, Team team, boolean shouldAdd, int rotation)
        +Building create(Block block, Team team)
        +void add()
        +void update()
        +void updateTile()
        +void draw()
        +void drawStatus()
        +void placed()
        +void onRemoved()
        +void onDestroyed()
        +void handleItem(Building source, Item item)
        +void handleLiquid(Building source, Liquid liquid, float amount)
        +void configure(Object value)
        +void configured(Unit builder, Object value)
        +void updateProximity()
        +void updateEfficiencyMultiplier()
        +void updateConsumption()
        +void updatePowerGraph()
        +void display(Table table)
        +Object config()
        +void writeBase(Writes write)
        +void readBase(Reads read)
    }

    class Build <<utility>> {
        ' All methods static — no instantiation
        +{static} void beginBreak(Unit unit, Team team, int x, int y)
        +{static} void beginPlace(Unit unit, Block result, Team team, int x, int y, int rotation, Object placeConfig)
        +{static} boolean validPlace(Block type, Team team, int x, int y, int rotation)
        +{static} boolean validPlace(Block type, Team team, int x, int y, int rotation, boolean checkVisible)
        +{static} boolean validPlace(Block type, Team team, int x, int y, int rotation, boolean checkVisible, boolean checkCoreRadius)
        +{static} boolean checkNoUnitOverlap(Block type, int x, int y)
        +{static} boolean validPlaceIgnoreUnits(Block type, Team team, int x, int y, int rotation, boolean checkVisible, boolean checkCoreRadius)
    }

    class Tile {
        +byte data
        +byte floorData
        +byte overlayData
        +int extraData
        +{field} @Nullable Building build
        +short x
        +short y
        #Block block
        #Floor floor
        #Floor overlay
        +Tile(int x, int y)
        +Tile(int x, int y, Block floor, Block overlay, Block wall)
        +int pos()
        +int array()
        +byte relativeTo(int cx, int cy)
        +void setBlock(Block block, Team team, int rotation)
        +Block block()
        +Floor floor()
        +Team team()
        +boolean solid()
        +boolean passable()
        +float drawx()
        +float drawy()
        +float worldx()
        +float worldy()
    }

    class Tiles {
        +final int width
        +final int height
        +final Tile[] array
        +final Puddle[] puddles
        +final Fire[] fires
    }
}

' ============================================================
package "mindustry.core" {
    class World {
        +Tiles tiles
        +int tileChanges
        +int floorChanges
        +final Context context
        +Tile tile(int x, int y)
        +Tile tileBuilding(int x, int y)
        +boolean solid(int x, int y)
        +boolean passable(int x, int y)
        +boolean wallSolid(int x, int y)
        +void addMapLoader(Map map, Runnable loader)
    }
}

' ============================================================
package "mindustry.world.modules" {

    abstract class BlockModule {
        +{abstract} void write(Writes write)
        +void read(Reads read)
        +void read(Reads read, boolean legacy)
    }

    class ItemModule {
        +{static} ItemModule empty
        #int[] items
        #int total
        #int takeRotation
        -WindowedMean[] flow
        +ItemModule copy()
        +void set(ItemModule other)
        +void updateFlow()
        +void write(Writes write)
        +void read(Reads read)
    }

    class LiquidModule {
        -float[] liquids
        -Liquid current
        -WindowedMean[] flow
        +void updateFlow()
        +void stopFlow()
        +float getFlowRate(Liquid liquid)
        +boolean hasFlowLiquid(Liquid liquid)
        +float get(Liquid liquid)
        +void add(Liquid liquid, float amount)
        +void write(Writes write)
        +void read(Reads read)
    }

    class PowerModule {
        +float status
        +boolean init
        +PowerGraph graph
        +IntSeq links
        +void write(Writes write)
        +void read(Reads read)
    }
}

' ============================================================
package "mindustry.world.meta" {

    class Attribute {
        +{static} Attribute[] all
        +{static} ObjectMap<String,Attribute> map
        ' Singletons: heat, spores, water, oil, light, sand, steam
        +final int id
        +final String name
        +float env()
        +{static} Attribute get(String name)
        +{static} Attribute getOrNull(String name)
        +{static} Attribute add(String name)
    }

    class Stat {
        +{static} Seq<Stat> all
        ' Notable: health, armor, size, buildTime, buildCost, speed,
        ' itemCapacity, liquidCapacity, powerUse, basePowerGeneration,
        ' range, damage, reload, drillSpeed, productionTime
        +final StatCat category
        +final String name
    }

    class StatCat {
        ' Singletons: general, power, liquids, items, crafting, function, optional
        +final String name
    }

    class Env <<constants>> {
        ' Integer bitmask — no instantiation
        +{static} final int terrestrial
        +{static} final int space
        +{static} final int underwater
        +{static} final int spores
        +{static} final int scorching
        +{static} final int groundOil
        +{static} final int groundWater
        +{static} final int oxygen
        +{static} final int any
        +{static} final int none
    }

    enum BlockFlag {
        core
        storage
        generator
        turret
        factory
        repair
        battery
        reactor
        extinguisher
        drill
        shield
        launchPad
        unitCargoUnloadPoint
        unitAssembler
        hasFogRadius
        steamVent
        blockRepair
        synced
    }

    class BuildVisibility {
        ' Wraps a Boolp predicate; singletons define rules
        ' Singletons: hidden, shown, debugOnly, editorOnly,
        ' coreZoneOnly, sandboxOnly, campaignOnly, lightingOnly, fogOnly
        +boolean visible()
    }
}

' ============================================================
package "mindustry.world.blocks" {
    class Attributes {
        +float get(Attribute attr)
        +void set(Attribute attr, float value)
        +void add(Attributes other)
        +void add(Attributes other, float scl)
        +void clear()
    }
}

' ============================================================
' INHERITANCE
' ============================================================
Block --|> UnlockableContent
Block ..|> Senseable

ItemModule --|> BlockModule
LiquidModule --|> BlockModule
PowerModule --|> BlockModule

Tile ..|> Position
Tiles ..|> IterableTile
Attributes ..|> JsonSerializable

' ============================================================
' COMPOSITION & AGGREGATION
' ============================================================
World *-- Tiles : tiles
Tiles *-- Tile : array[]

Block *-- Attributes : attributes
Block *-- BuildVisibility : buildVisibility
Block ..> BlockFlag : flags (EnumSet)

Building --> Block : block (type back-ref)
Building --> Tile : tile (placement back-ref)
Building "0..1" *-- "0..1" PowerModule : power\n(if hasPower)
Building "0..1" *-- "0..1" ItemModule : items\n(if hasItems)
Building "0..1" *-- "0..1" LiquidModule : liquids\n(if hasLiquids)
Building "1" o-- "0..*" Building : proximity

Tile "0..1" o-- "0..1" Building : build\n(null for floors)
Tile --> Block : block type
Tile --> Floor : floor
Tile --> Floor : overlay

PowerModule *-- PowerGraph : graph

' ============================================================
' ASSOCIATIONS & DEPENDENCIES
' ============================================================
Stat --> StatCat : category
Attributes ..> Attribute : indexed by Attribute.id

Block ..> Stat : uses in setStats()
Block ..> Building : <<creates via buildType>>

Build ..> World : uses
Build ..> Tile : uses

@enduml
