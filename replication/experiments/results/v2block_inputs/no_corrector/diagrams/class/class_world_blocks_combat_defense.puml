@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #B0A000
    FontSize 11
}

title Defense & Turret Blocks

' =====================================================
' EXTERNAL BASE CLASSES
' =====================================================
class Block <<external>> {
}
class Building <<external>> {
}
class Wall <<external>> {
}

' =====================================================
' INTERFACES
' =====================================================
interface Ranged {
    +range(): float
}
interface RotBlock {
    +buildRotation(): int
}
interface ControlBlock {
    +canControl(): boolean
    +unit(): BlockUnitc
}

' =====================================================
' TURRET BLOCK TYPES
' =====================================================
package "mindustry.world.blocks.defense.turrets" {

    class BaseTurret {
        +range: float
        +rotateSpeed: float
        +activationTime: float
        +fogRadiusMultiplier: float
        +coolant: ConsumeLiquidBase
        +coolantMultiplier: float
        +coolEffect: Effect
        --
        +init(): void
    }

    class ReloadTurret {
        +reload: float
    }

    class Turret {
        +maxAmmo: int
        +ammoPerShot: int
        +consumeAmmoOnce: boolean
        +inaccuracy: float
        +shootCone: float
        +minRange: float
        +targetAir: boolean
        +targetGround: boolean
        +targetBlocks: boolean
        +targetHealing: boolean
        +playerControllable: boolean
        +alwaysShooting: boolean
        +predictTarget: boolean
        +shoot: ShootPattern
        +drawer: DrawBlock
        +heatColor: Color
        +shootSound: Sound
        +recoil: float
        +cooldownTime: float
        +heatRequirement: float
        +maxHeatEfficiency: float
    }

    class ItemTurret {
        +ammoTypes: ObjectMap<Item, BulletType>
    }

    class LiquidTurret {
        +ammoTypes: ObjectMap<Liquid, BulletType>
        +extinguish: boolean
    }

    class ContinuousTurret {
        +shootType: BulletType
        +aimChangeSpeed: float
        +scaleDamageEfficiency: boolean
    }

    class ContinuousLiquidTurret {
        +ammoTypes: ObjectMap<Liquid, BulletType>
        +liquidConsumed: float
    }

    class PointDefenseTurret {
        +retargetTime: float
        +shootCone: float
        +bulletDamage: float
        +shootLength: float
        +color: Color
        +beamEffect: Effect
        +hitEffect: Effect
        +shootEffect: Effect
        +shootSound: Sound
    }
}

' =====================================================
' DEFENSE BLOCK TYPES
' =====================================================
package "mindustry.world.blocks.defense" {

    class BuildTurret {
        +buildSpeed: float
        +buildBeamOffset: float
        +elevation: float
        +unitType: UnitType
        +heatColor: Color
    }

    class BaseShield {
        +radius: float
        +sides: int
        +shieldColor: Color
    }

    class DirectionalForceProjector {
        +width: float
        +length: float
        +shieldHealth: float
        +cooldownNormal: float
        +cooldownLiquid: float
        +cooldownBrokenBase: float
        +absorbEffect: Effect
        +shieldBreakEffect: Effect
    }

    class AutoDoor {
        +checkInterval: float
        +triggerMargin: float
        +openfx: Effect
        +closefx: Effect
        +doorSound: Sound
    }
}

' =====================================================
' BUILD (RUNTIME BEHAVIOR) INNER CLASSES
' =====================================================
package "Build Inner Classes (Runtime)" {

    class BaseTurretBuild {
        +rotation: float
        +activationTimer: float
        --
        +updateTile(): void
    }

    class ReloadTurretBuild {
        +reloadCounter: float
    }

    class TurretBuild {
        +ammo: Seq<AmmoEntry>
        +totalAmmo: int
        +curRecoil: float
        +heat: float
        +logicControlTime: float
        +shootWarmup: float
        +target: Posc
        +targetPos: Vec2
        +unit: BlockUnitc
        +logicShooting: boolean
        +wasShooting: boolean
        +heatReq: float
        --
        +updateTile(): void
        +findTarget(): void
        +shoot(type: BulletType): void
        +bullet(...): void
        +useAmmo(): void
        +isShooting(): boolean
    }

    class ItemTurretBuild {
        --
        +handleItem(src: Building, item: Item): void
    }

    class LiquidTurretBuild {
        --
        +findTarget(): void
    }

    class ContinuousTurretBuild {
        +bullets: Seq<BulletEntry>
        +lastLength: float
        --
        +updateTile(): void
        +updateBullet(entry: BulletEntry): void
        +updateShooting(): void
    }

    class ContinuousLiquidTurretBuild {
        +activated: boolean
    }

    class PointDefenseBuild {
        +target: Bullet
        --
        +updateTile(): void
    }

    class BuildTurretBuild {
        +unit: BlockUnitc
        +following: Unit
        +lastPlan: BlockPlan
        +warmup: float
        --
        +updateTile(): void
    }

    class BaseShieldBuild {
        +broken: boolean
        +hit: float
        +smoothRadius: float
        --
        +updateTile(): void
    }

    class DirectionalForceProjectorBuild {
        +broken: boolean
        +buildup: float
        +hit: float
        +warmup: float
        +shieldRadius: float
        --
        +deflectBullets(): void
    }

    class AutoDoorBuild {
        +open: boolean
        --
        +updateTile(): void
    }
}

' =====================================================
' AMMO & BULLET HELPER CLASSES
' =====================================================
package "Ammo & Bullet Helpers" {

    abstract class AmmoEntry {
        +amount: int
        --
        +{abstract} type(): BulletType
    }

    class ItemEntry {
        +item: Item
        --
        +type(): BulletType
    }

    class BulletEntry {
        +bullet: Bullet
        +x: float
        +y: float
        +rotation: float
        +life: float
    }
}

' =====================================================
' BLOCK TYPE INHERITANCE
' =====================================================
Block <|-- BaseTurret
BaseTurret <|-- ReloadTurret
ReloadTurret <|-- Turret
Turret <|-- ItemTurret
Turret <|-- LiquidTurret
Turret <|-- ContinuousTurret
ContinuousTurret <|-- ContinuousLiquidTurret
ReloadTurret <|-- PointDefenseTurret
BaseTurret <|-- BuildTurret
Block <|-- BaseShield
Block <|-- DirectionalForceProjector
Wall <|-- AutoDoor

' =====================================================
' BUILD CLASS INHERITANCE
' =====================================================
Building <|-- BaseTurretBuild
BaseTurretBuild <|-- ReloadTurretBuild
ReloadTurretBuild <|-- TurretBuild
TurretBuild <|-- ItemTurretBuild
TurretBuild <|-- LiquidTurretBuild
TurretBuild <|-- ContinuousTurretBuild
ContinuousTurretBuild <|-- ContinuousLiquidTurretBuild
ReloadTurretBuild <|-- PointDefenseBuild
BaseTurretBuild <|-- BuildTurretBuild
Building <|-- BaseShieldBuild
Building <|-- DirectionalForceProjectorBuild
Building <|-- AutoDoorBuild

' =====================================================
' INTERFACE IMPLEMENTATIONS
' =====================================================
BaseTurretBuild ..|> Ranged
BaseTurretBuild ..|> RotBlock
TurretBuild ..|> ControlBlock
BuildTurretBuild ..|> ControlBlock
BuildTurretBuild ..|> RotBlock

' =====================================================
' EXEMPLARY INNER CLASS NESTING (Block ↔ Build)
' =====================================================
Turret +-- TurretBuild
ItemTurret +-- ItemTurretBuild
ContinuousTurret +-- ContinuousTurretBuild

note bottom of Turret
  All Block classes contain a matching
  static inner Build class, e.g.:
  Turret.TurretBuild, ItemTurret.ItemTurretBuild
end note

' =====================================================
' COMPOSITION RELATIONSHIPS
' =====================================================
Turret *-- ShootPattern : shoot
Turret *-- DrawBlock : drawer
TurretBuild "1" *-- "0..*" AmmoEntry : ammo
ContinuousTurretBuild "1" *-- "0..*" BulletEntry : bullets

' =====================================================
' AMMO ENTRY HIERARCHY
' =====================================================
AmmoEntry <|-- ItemEntry

@enduml
