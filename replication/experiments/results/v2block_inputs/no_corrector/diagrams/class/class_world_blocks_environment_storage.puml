@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Environment, Storage, Liquid & Sandbox Blocks

' ─── External base classes ───────────────────────────────────────────────────
abstract class Block
abstract class Building

' ─── Interfaces ──────────────────────────────────────────────────────────────
interface Autotiler
interface ChainedBuilding {
    +Building next()
}
interface LaunchAnimator {
    +void drawLaunch()
    +float zoomLaunch()
    +void beginLaunch(boolean)
}
interface Poolable {
    +void reset()
}

' ─── environment ─────────────────────────────────────────────────────────────
package "mindustry.world.blocks.environment" {

    class Floor {
        +String edge
        +float speedMultiplier
        +float dragMultiplier
        +float damageTaken
        +float drownTime
        +boolean isLiquid
        +Liquid liquidDrop
        +boolean allowCorePlacement
        +boolean supportsOverlay
        +Block wall
        +Block decoration
        +boolean autotile
        +int tilingVariants
        --
        +void load()
        +void drawBase(Tile tile)
        +void drawEdges(Tile tile)
        +boolean hasSurface()
        +boolean isDeep()
        +boolean damages()
        +int variant(int x, int y)
    }

    class UpdateRenderState <<static inner>> {
        +Tile tile
        +Floor floor
        +float data
    }

    class Cliff {
        +float size
        +TextureRegion[] cliffs
        --
        +void drawBase(Tile tile)
        +int minimapColor(Tile tile)
    }

    Floor +-- UpdateRenderState
}

' ─── defense ─────────────────────────────────────────────────────────────────
package "mindustry.world.blocks.defense" {

    class Wall {
        +float lightningChance
        +float lightningDamage
        +int lightningLength
        +float chanceDeflect
        +boolean flashHit
        +float crushDamageMultiplier
        --
        +void setStats()
        +void init()
    }

    class WallBuild <<inner>> {
        +float hit
        --
        +void draw()
        +boolean collision(Bullet bullet)
    }

    Wall +-- WallBuild
}

' ─── liquid ──────────────────────────────────────────────────────────────────
package "mindustry.world.blocks.liquid" {

    class LiquidBlock {
    }

    class LiquidBuild <<inner>> {
    }

    class Conduit {
        +Color botColor
        +boolean padCorners
        +boolean leaks
        +Block junctionReplacement
        +Block bridgeReplacement
        --
        +void init()
        +boolean blends(Tile, int, int, int, int, Block)
        +Block getReplacement(BuildPlan, Seq)
        +void handlePlacementLine(Seq)
    }

    class ConduitBuild <<inner>> {
        +float smoothLiquid
        +int blendbits
        +boolean capped
        +boolean backCapped
        --
        +void draw()
        +void updateTile()
        +boolean acceptLiquid(Building, Liquid)
        +void onProximityUpdate()
        +Building next()
    }

    class LiquidBridge {
        +hasItems = false
        +hasLiquids = true
        +outputsLiquid = true
    }

    class LiquidBridgeBuild <<inner>> {
        --
        +void updateTransport(Building other)
        +void doDump()
    }

    LiquidBlock +-- LiquidBuild
    Conduit +-- ConduitBuild
    LiquidBridge +-- LiquidBridgeBuild
}

' ─── distribution ────────────────────────────────────────────────────────────
package "mindustry.world.blocks.distribution" {

    class ItemBridge {
        +int range
        +float transportTime
        +boolean fadeIn
        +float bridgeWidth
        --
        +boolean linkValid(Tile, Tile)
        +boolean positionsValid(int, int, int, int)
    }

    class ItemBridgeBuild <<inner>> {
        +int link
        +float warmup
        +boolean moved
        +float transportCounter
        --
        +boolean acceptItem(Building, Item)
        +boolean acceptLiquid(Building, Liquid)
        +boolean canDump(Building, Item)
    }

    class OverflowGate {
        +float speed
        +boolean invert
    }

    class OverflowGateBuild <<inner>> {
        --
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +Building getTileTarget(Item, Building, boolean)
    }

    ItemBridge +-- ItemBridgeBuild
    OverflowGate +-- OverflowGateBuild
}

' ─── storage ─────────────────────────────────────────────────────────────────
package "mindustry.world.blocks.storage" {

    class StorageBlock {
        +boolean coreMerge
        --
        +boolean outputsItems()
        +{static} void incinerateEffect(Building, Building)
    }

    class StorageBuild <<inner>> {
        +Building linkedCore
        --
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +int getMaximumAccepted(Item)
        +int removeStack(Item, int)
        +boolean canUnload()
        +int explosionItemCap()
    }

    class CoreBlock {
        +UnitType unitType
        +boolean isFirstTier
        +boolean allowSpawn
        +boolean requiresCoreZone
        +boolean incinerateNonBuildable
        +float landDuration
        +float captureInvicibility
        --
        +{static} void playerSpawn(Tile, Player) @Remote
        +boolean canPlaceOn(Tile, Team, int)
        +boolean canReplace(Block)
        +void placeBegan(Tile, Block, Unit)
    }

    class CoreBuild <<inner>> {
        +int storageCapacity
        +Team lastDamage
        +float iframes
        +Vec2 commandPos
        --
        +void updateTile()
        +void onProximityUpdate()
        +boolean acceptItem(Building, Item)
        +void requestSpawn(Player)
        +boolean owns(Building tile)
        +double sense(LAccess)
    }

    class Unloader {
        +float speed
        +boolean allowCoreUnload
    }

    class ContainerStat <<static inner>> {
        +Building building
        +float loadFactor
        +boolean canLoad
        +boolean canUnload
        +boolean notStorage
        +int lastUsed
    }

    class UnloaderBuild <<inner>> {
        +float unloadTimer
        +int rotations
        +Item sortItem
        +Seq<ContainerStat> possibleBlocks
        --
        +void updateTile()
        +void onProximityUpdate()
        +void buildConfiguration(Table)
        +Item config()
    }

    StorageBlock +-- StorageBuild
    CoreBlock +-- CoreBuild
    Unloader +-- UnloaderBuild
    Unloader +-- ContainerStat
}

' ─── sandbox ─────────────────────────────────────────────────────────────────
package "mindustry.world.blocks.sandbox" {

    class ItemSource {
        +int itemsPerSecond
    }

    class ItemSourceBuild <<inner>> {
        +float counter
        +Item outputItem
        --
        +void updateTile()
        +void draw()
        +boolean acceptItem(Building, Item)
        +Item config()
    }

    class LiquidSource {
        +float liquidCapacity
        +boolean outputsLiquid
    }

    class LiquidSourceBuild <<inner>> {
        +Liquid source
        --
        +void updateTile()
        +void draw()
        +Liquid config()
    }

    ItemSource +-- ItemSourceBuild
    LiquidSource +-- LiquidSourceBuild
}

' ═══ Inheritance: Block hierarchy ═══════════════════════════════════════════
Block <|-- Floor
Block <|-- Cliff
Block <|-- Wall
Block <|-- LiquidBlock
Block <|-- ItemBridge
Block <|-- StorageBlock
Block <|-- Unloader
Block <|-- ItemSource
Block <|-- LiquidSource
Block <|-- OverflowGate

StorageBlock <|-- CoreBlock
LiquidBlock <|-- Conduit
ItemBridge <|-- LiquidBridge

' ═══ Inheritance: Building hierarchy ════════════════════════════════════════
Building <|-- WallBuild
Building <|-- LiquidBuild
Building <|-- ItemBridgeBuild
Building <|-- StorageBuild
Building <|-- UnloaderBuild
Building <|-- ItemSourceBuild
Building <|-- LiquidSourceBuild
Building <|-- OverflowGateBuild

LiquidBuild <|-- ConduitBuild
ItemBridgeBuild <|-- LiquidBridgeBuild
StorageBuild <|-- CoreBuild

' ═══ Interface implementations ══════════════════════════════════════════════
Conduit ..|> Autotiler
ConduitBuild ..|> ChainedBuilding
CoreBuild ..|> LaunchAnimator
ContainerStat ..|> Poolable

' ═══ Key associations ════════════════════════════════════════════════════════
StorageBuild --> CoreBuild : linkedCore\n(delegates item ops)
UnloaderBuild o-- ContainerStat : possibleBlocks

@enduml
