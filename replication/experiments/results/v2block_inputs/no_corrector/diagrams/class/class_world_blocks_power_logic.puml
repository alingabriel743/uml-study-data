@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Power & Logic Blocks

' ===== External Base Classes =====
class Block <<external>> {
}
class Building <<external>> {
}
class GenericCrafter <<external>> {
}
class GenericCrafterBuild <<external>> {
}
class LExecutor <<external>> {
}
class FrameBuffer <<external>> {
}
class PowerGraph <<external>> {
}

' ===== Interfaces =====
interface HeatBlock {
    +heat(): float
    +heatFrac(): float
}
interface HeatConsumer {
    +sideHeat(): float[]
    +heatRequirement(): float
}
interface LReadable {
}
interface LWritable {
}
interface Ranged {
}

' ===== Power Package =====
package "mindustry.world.blocks.power" {

    class PowerBlock {
        +update: boolean = true
        +solid: boolean = true
        +hasPower: boolean = true
        +group: BlockGroup = power
    }

    class PowerDistributor {
        +consumesPower: boolean = false
        +outputsPower: boolean = true
    }

    class Battery {
        +drawer: DrawBlock
        +emptyLightColor: Color
        +fullLightColor: Color
        +canOverdrive: boolean = false
        --
        +init()
        +load()
        +drawPlanRegion()
        +icons(): TextureRegion[]
    }

    class BatteryBuild <<inner>> {
        --
        +draw()
        +drawLight()
        +warmup(): float
        +overwrote(Seq<Building>)
        +status(): BlockStatus
    }

    class PowerGenerator {
        +powerProduction: float
        +drawer: DrawBlock
        +explosionRadius: int
        +explosionDamage: int
        +explodeEffect: Effect
        +explosionMinWarmup: float
        --
        +getDisplayedPowerProduction(): float
        +setStats()
        +setBars()
    }

    class GeneratorBuild <<inner>> {
        +productionEfficiency: float
        +generateTime: float
        --
        +getPowerProduction(): float
        +warmup(): float
        +onDestroyed()
        +createExplosion()
    }

    class ConsumeGenerator {
        +itemDuration: float = 120f
        +warmupSpeed: float = 0.05f
        +effectChance: float = 0.01f
        +outputLiquid: LiquidStack
        +explodeOnFull: boolean
        --
        +init()
        +setBars()
        +setStats()
    }

    class ConsumeGeneratorBuild <<inner>> {
        --
        +updateTile()
        +updateEfficiencyMultiplier()
        +consumeTriggerValid(): boolean
        +drawLight()
    }

    class ImpactReactor {
        +warmupSpeed: float = 0.001f
        +lightRadius: float = 115f
        +emitLight: boolean = true
        +explosionDamage: int = 7600
        +explosionMinWarmup: float = 0.3f
    }

    class ImpactReactorBuild <<inner>> {
        +warmup: float
        --
        +updateTile()
        +sense(LAccess): Object
    }

    class BeamNode {
        +range: int = 5
        +laser: TextureRegion
        +laserColor1: Color
        +laserColor2: Color
        +laserWidth: float = 0.4f
        +consumesPower: boolean = false
        +outputsPower: boolean = false
        --
        +getNodeLinks(Tile, Block, Team, Cons<Building>)
        +drawLaser(float, float, float, float, float, float)
    }

    class BeamNodeBuild <<inner>> {
        --
        +updateTile()
        +updateDirections()
        +couldConnect(int, Building, int, int): boolean
        +draw()
        +status(): BlockStatus
    }
}

' ===== Logic Package =====
package "mindustry.world.blocks.logic" {

    class LogicBlock {
        +instructionsPerTick: int = 1
        +maxInstructionsPerTick: int = 40
        +range: float = 80f
        +{static} maxByteLen: int = 102400
        +{static} maxLinks: int = 6000
        --
        +compress(String, Seq<LogicLink>): byte[]
        +getLinkName(Block): String
        +accessible(): boolean
        +drawPlace()
    }

    class LogicLink <<static inner>> {
        +x: int
        +y: int
        +name: String
        +valid: boolean
        +lastBuild: Building
        +logicVar: LVar
        --
        +trySet(LExecutor, Object)
    }

    class LogicBuild <<inner>> {
        +code: String
        +links: Seq<LogicLink>
        +ipt: int
        +tag: String
        +iconTag: char
        --
        +readCompressed(byte[], boolean)
        +updateCode(String, boolean, Seq<LVar>)
        +updateTile()
    }

    class LogicDisplay {
        +displaySize: int = 64
        +scaleFactor: float = 1f
        +maxSides: int = 25
        +{static} displays: Seq<LogicDisplayBuild>
    }

    class LogicDisplayBuild <<inner>> {
        +rootDisplay: LogicDisplayBuild
        +color: float
        +stroke: float
        +operations: long
        --
        +draw()
        +flushCommands(LongSeq)
        +processCommands()
        +sense(LAccess): Object
    }

    class CanvasBlock {
        +canvasSize: int = 8
        +palette: int[]
        +bitsPerPixel: int
        +colorToIndex: IntIntMap
        +padding: float = 0f
    }

    class CanvasBuild <<inner>> {
        --
        +sense(LAccess): Object
        +control(LAccess, double, double, double, double)
    }
}

' ===== Heat Package =====
package "mindustry.world.blocks.heat" {

    class HeatConductor {
        +visualMaxHeat: float = 15f
        +drawer: DrawBlock
        +splitHeat: boolean = false
        +size: int = 3
    }

    class HeatConductorBuild <<inner>> {
        +heat: float
        +sideHeat: float[4]
        +cameFrom: IntSet
        +lastHeatUpdate: long
        --
        +updateHeat()
        +heatFrac(): float
    }
}

' ===== Production Package (Heat) =====
package "mindustry.world.blocks.production" {

    class HeatProducer {
        +heatOutput: float = 10f
        +warmupRate: float = 0.15f
        +drawArrow: boolean = true
    }

    class HeatProducerBuild <<inner>> {
        +heat: float
        --
        +updateTile()
        +heat(): float
        +heatFrac(): float
    }

    class HeatCrafter {
        +heatRequirement: float = 10f
        +overheatScale: float = 1f
        +maxEfficiency: float = 4f
    }

    class HeatCrafterBuild <<inner>> {
        +sideHeat: float[4]
        +heat: float
        --
        +updateTile()
        +shouldConsume(): boolean
        +efficiencyScale(): float
        +warmupTarget(): float
    }
}

' ===== Block Type Inheritance =====
PowerBlock --|> Block
PowerDistributor --|> PowerBlock
Battery --|> PowerDistributor
PowerGenerator --|> PowerDistributor
ConsumeGenerator --|> PowerGenerator
ImpactReactor --|> PowerGenerator
BeamNode --|> PowerBlock

LogicBlock --|> Block
LogicDisplay --|> Block
CanvasBlock --|> Block

HeatConductor --|> Block

HeatProducer --|> GenericCrafter
HeatCrafter --|> GenericCrafter

' ===== Build Class Inheritance =====
BatteryBuild --|> Building
GeneratorBuild --|> Building
ConsumeGeneratorBuild --|> GeneratorBuild
ImpactReactorBuild --|> GeneratorBuild
BeamNodeBuild --|> Building
LogicBuild --|> Building
LogicDisplayBuild --|> Building
CanvasBuild --|> Building
HeatConductorBuild --|> Building
HeatProducerBuild --|> GenericCrafterBuild
HeatCrafterBuild --|> GenericCrafterBuild

' ===== Outer Block → Inner Build (Nesting) =====
Battery *-- BatteryBuild : <<inner>>
PowerGenerator *-- GeneratorBuild : <<inner>>
ConsumeGenerator *-- ConsumeGeneratorBuild : <<inner>>
ImpactReactor *-- ImpactReactorBuild : <<inner>>
BeamNode *-- BeamNodeBuild : <<inner>>
LogicBlock *-- LogicBuild : <<inner>>
LogicBlock *-- LogicLink : <<static inner>>
LogicDisplay *-- LogicDisplayBuild : <<inner>>
CanvasBlock *-- CanvasBuild : <<inner>>
HeatConductor *-- HeatConductorBuild : <<inner>>
HeatProducer *-- HeatProducerBuild : <<inner>>
HeatCrafter *-- HeatCrafterBuild : <<inner>>

' ===== Interface Implementations =====
HeatConductorBuild ..|> HeatBlock
HeatConductorBuild ..|> HeatConsumer
HeatProducerBuild ..|> HeatBlock
HeatCrafterBuild ..|> HeatConsumer
LogicBuild ..|> Ranged
LogicBuild ..|> LReadable
LogicBuild ..|> LWritable
CanvasBuild ..|> LReadable
CanvasBuild ..|> LWritable

' ===== Key Compositions & Dependencies =====
LogicBuild *-- "1" LExecutor : executor
LogicDisplayBuild *-- "1" FrameBuffer : buffer
BeamNodeBuild ..> PowerGraph : manages connections

@enduml
