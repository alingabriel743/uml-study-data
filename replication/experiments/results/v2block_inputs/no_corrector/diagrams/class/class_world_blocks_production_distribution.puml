@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Production & Distribution Blocks

' ─────────────────────────────────────────────
' Interfaces
' ─────────────────────────────────────────────

interface Autotiler {
    +boolean blends(Tile, int, int, int, int, Block)
}

interface ChainedBuilding {
    +Building next()
}

interface ControlBlock {
    +Unit unit()
    +boolean canControl()
}

' ─────────────────────────────────────────────
' Base infrastructure
' ─────────────────────────────────────────────

package "mindustry.world" {
    class Block {
        +boolean hasItems
        +boolean hasLiquids
        +boolean hasPower
        +int itemCapacity
        +Consume[] consumers
        +ConsumePower consPower
    }
}

package "mindustry.gen" {
    class Building {
        +ItemModule items
        +LiquidModule liquids
        +PowerModule power
        +float efficiency
        +Team team
        +void dump()
        +void offload(Item)
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +void consume()
        +void updateTile()
        +boolean shouldConsume()
        +void onProximityUpdate()
    }
}

' ─────────────────────────────────────────────
' Consumer hierarchy
' ─────────────────────────────────────────────

package "mindustry.world.consumers" {
    abstract class Consume {
        +boolean optional
        +boolean booster
        +boolean update
        +Floatf<Building> multiplier
        +void apply(Block)
        +void trigger(Building)
        +void update(Building)
        +float efficiency(Building)
        +boolean ignore()
    }

    class ConsumeItemFilter {
        +Boolf<Item> filter
        +void apply(Block)
        +void trigger(Building)
        +float efficiency(Building)
        +Item getConsumed(Building)
        +float efficiencyMultiplier(Building)
    }

    class ConsumeItemDynamic {
        +Func<Building, ItemStack[]> items
        +void apply(Block)
        +void trigger(Building)
        +float efficiency(Building)
    }

    class ConsumePower {
        +float usage
        +float capacity
        +boolean buffered
        +void apply(Block)
        +float efficiency(Building)
        +float requestedPower(Building)
        +boolean ignore()
    }

    ConsumeItemFilter --|> Consume
    ConsumeItemDynamic --|> Consume
    ConsumePower --|> Consume
}

' ─────────────────────────────────────────────
' Production blocks
' ─────────────────────────────────────────────

package "mindustry.world.blocks.production" {
    class Drill {
        +int tier
        +float drillTime
        +float liquidBoostIntensity
        +float warmupSpeed
        +Item blockedItem
        +ObjectFloatMap<Item> drillMultipliers
        +void init()
        +boolean canPlaceOn(Tile, Team, int)
        +float getDrillTime(Item)
        +void countOre(Tile)
        +Item getDrop(Tile)
    }

    class DrillBuild <<inner>> {
        +float progress
        +float warmup
        +float timeDrilled
        +float lastDrillSpeed
        +Item dominantItem
        +int dominantItems
        +boolean shouldConsume()
        +void onProximityUpdate()
        +void updateTile()
        +void draw()
        +void write(Writes)
        +void read(Reads, byte)
    }

    class BeamDrill {
        +float drillTime
        +int range
        +int tier
        +float optionalBoostIntensity
        +Item blockedItem
        +void init()
        +boolean canPlaceOn(Tile, Team, int)
        +float getDrillTime(Item)
    }

    class BeamDrillBuild <<inner>> {
        +Tile[] facing
        +Point2[] lasers
        +Item lastItem
        +float warmup
        +float boostWarmup
        +float lastDrillSpeed
        +int facingAmount
        +void updateTile()
        +void onProximityUpdate()
        +void updateLasers()
        +boolean shouldConsume()
        +void draw()
    }

    class GenericCrafter {
        +ItemStack outputItem
        +ItemStack[] outputItems
        +LiquidStack outputLiquid
        +LiquidStack[] outputLiquids
        +float craftTime
        +DrawBlock drawer
        +boolean dumpExtraLiquid
        +void init()
        +boolean outputsItems()
    }

    class GenericCrafterBuild <<inner>> {
        +float progress
        +float totalProgress
        +float warmup
        +boolean shouldConsume()
        +void updateTile()
        +float getProgressIncrease(float)
        +void craft()
        +void dumpOutputs()
        +float progress()
        +void write(Writes)
        +void read(Reads, byte)
    }

    class AttributeCrafter {
        +Attribute attribute
        +float baseEfficiency
        +float boostScale
        +float maxBoost
        +float minEfficiency
        +boolean displayEfficiency
        +boolean canPlaceOn(Tile, Team, int)
        +void setBars()
        +void setStats()
    }

    class AttributeCrafterBuild <<inner>> {
        +float attrsum
        +float efficiencyMultiplier()
        +float getProgressIncrease(float)
        +float efficiencyScale()
        +void onProximityUpdate()
        +void pickedUp()
    }

    ' Inner class containment
    Drill +-- DrillBuild
    BeamDrill +-- BeamDrillBuild
    GenericCrafter +-- GenericCrafterBuild
    AttributeCrafter +-- AttributeCrafterBuild

    ' Production hierarchy
    AttributeCrafter --|> GenericCrafter
    AttributeCrafterBuild --|> GenericCrafterBuild
}

' ─────────────────────────────────────────────
' Distribution blocks
' ─────────────────────────────────────────────

package "mindustry.world.blocks.distribution" {
    class Conveyor {
        +float speed
        +float displayedSpeed
        +boolean pushUnits
        +Block junctionReplacement
        +Block bridgeReplacement
        +void init()
        +boolean canReplace(Block)
        +Block getReplacement(BuildPlan, Seq<BuildPlan>)
    }

    class ConveyorBuild <<inner>> {
        +Item[] ids
        +float[] xs, ys
        +int len
        +Building next
        +ConveyorBuild nextc
        +boolean aligned
        +float clogHeat
        +void updateTile()
        +boolean pass(Item)
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +Building next()
    }

    class Router {
        +float speed
    }

    class RouterBuild <<inner>> {
        +Item lastItem
        +Tile lastInput
        +float time
        +BlockUnitc unit
        +void updateTile()
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +Building getTileTarget(Item, Tile, boolean)
        +Unit unit()
        +boolean canControl()
    }

    class DirectionBridge {
        +int range
        +void init()
        +boolean positionsValid(int, int, int, int)
        +void drawBridge(int, float, float, float, float, Color)
    }

    class DirectionBridgeBuild <<inner>> {
        +DirectionBridgeBuild[] occupied
        +DirectionBridgeBuild lastLink
        +DirectionBridgeBuild findLink()
        +void draw()
        +void drawSelect()
    }

    class Sorter {
        +boolean invert
        +boolean outputsItems()
    }

    class SorterBuild <<inner>> {
        +Item sortItem
        +boolean acceptItem(Building, Item)
        +void handleItem(Building, Item)
        +Building getTileTarget(Item, Building, boolean)
        +Item config()
        +void write(Writes)
        +void read(Reads, byte)
    }

    ' Inner class containment
    Conveyor +-- ConveyorBuild
    Router +-- RouterBuild
    DirectionBridge +-- DirectionBridgeBuild
    Sorter +-- SorterBuild
}

' ─────────────────────────────────────────────
' Cross-package: Block extensions
' ─────────────────────────────────────────────

Drill --|> Block
BeamDrill --|> Block
GenericCrafter --|> Block
Conveyor --|> Block
Router --|> Block
DirectionBridge --|> Block
Sorter --|> Block

' Interface implementations
Conveyor ..|> Autotiler
ConveyorBuild ..|> ChainedBuilding
RouterBuild ..|> ControlBlock

' ─────────────────────────────────────────────
' Cross-package: Building extensions
' ─────────────────────────────────────────────

DrillBuild --|> Building
BeamDrillBuild --|> Building
GenericCrafterBuild --|> Building
ConveyorBuild --|> Building
RouterBuild --|> Building
DirectionBridgeBuild --|> Building
SorterBuild --|> Building

' ─────────────────────────────────────────────
' Consumer wiring & notable links
' ─────────────────────────────────────────────

Block o-- Consume : "consumers[]"
Block o-- ConsumePower : "consPower"

ConveyorBuild --> Building : "next"
DirectionBridgeBuild --> DirectionBridgeBuild : "lastLink"

@enduml
