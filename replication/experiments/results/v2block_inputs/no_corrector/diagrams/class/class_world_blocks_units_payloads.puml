@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam arrow {
    Color #495057
    FontSize 10
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
}

title Unit-Production & Payload Blocks

' ========================
' External base types
' ========================
package "External" <<Frame>> #DDE8FF {
    class Block <<external>> #DAEBFF
    class Building <<external>> #DAEBFF
    abstract class AIController <<external>> #DAEBFF
    interface Ranged <<external>> #DAEBFF {
        +range(): float
    }
    interface RotBlock <<external>> #DAEBFF {
        +buildRotation(): float
    }
    class Unit <<external>> #DAEBFF
    class UnitType <<external>> #DAEBFF
    class UnitCommand <<external>> #DAEBFF
}

' ========================
' Payload model
' ========================
package "mindustry.world.blocks.payloads" {

    interface Payload {
        {field} {static} payloadUnit: int = 0
        {field} {static} payloadBlock: int = 1
        --
        +set(x: float, y: float, rotation: float): void
        +draw(): void
        +drawShadow(alpha: float): void
        +size(): float
        +x(): float
        +y(): float
        +requirements(): ItemStack[]
        +buildTime(): float
        +contentEquals(other: Payload): boolean
        +update(unitHolder: Unit, buildingHolder: Building): void
        +dump(): boolean
        +write(write: Writes): void
        +icon(): TextureRegion
        +content(): UnlockableContent
        +{static} write(payload: Payload, write: Writes): void
        +{static} read(read: Reads): T
    }
    note right of Payload : Extends Position.\nStatic read/write handles\npolymorphic payloadUnit\nvs payloadBlock types.

    class BuildPayload {
        -build: Building
        --
        +BuildPayload(block: Block, team: Team)
        +BuildPayload(build: Building)
        +block(): Block
        +place(tile: Tile): void
        +place(tile: Tile, rotation: int): void
        +content(): UnlockableContent
        +requirements(): ItemStack[]
        +buildTime(): float
        +draw(): void
    }

    class UnitPayload {
        -unit: Unit
        -overlayTime: float
        -overlayRegion: TextureRegion
        {field} {static} overlayDuration: float = 40f
        --
        +UnitPayload(unit: Unit)
        +showOverlay(icon: TextureRegion): void
        +dump(): boolean
        +update(unitHolder: Unit, buildingHolder: Building): void
        +size(): float
        +draw(): void
    }
    note bottom of UnitPayload : dump() checks cap,\nsolidity, overlap;\nfires UnitUnloadEvent.

    class PayloadBlock {
        #payloadSpeed: float = 0.7f
        #payloadRotateSpeed: float = 5f
        #regionSuffix: String
        #topRegion: TextureRegion
        #outRegion: TextureRegion
        #inRegion: TextureRegion
        --
        +load(): void
        +{static} blends(build: Building, direction: int): boolean
        +{static} pushOutput(payload: Payload, progress: float): void
    }

    class "PayloadBlockBuild<T extends Payload>" as PayloadBlockBuild {
        #payload: T
        #payVector: Vec2
        #payRotation: float
        #carried: boolean
        --
        +acceptUnitPayload(unit: Unit): boolean
        +canControlSelect(unit: Unit): boolean
        +acceptPayload(source: Building, payload: Payload): boolean
        +handlePayload(source: Building, payload: Payload): void
        +getPayload(): Payload
        +takePayload(): Payload
        +updateTile(): void
        +moveInPayload(): boolean
        +moveOutPayload(): void
        +dumpPayload(): void
        +hasArrived(): boolean
        +drawPayload(): void
    }
    note right of PayloadBlockBuild : moveInPayload(): rotates/\napproaches Vec2.ZERO;\nmoveOutPayload(): drives\npayload to front, then\ndumps or passes onward.

    abstract class BlockProducer {
        #buildSpeed: float = 0.4f
    }
    note right of BlockProducer : size=3, outputsPayload=true,\nhasItems=true, hasPower=true

    abstract class BlockProducerBuild {
        #progress: float
        #time: float
        #heat: float
        --
        +{abstract} recipe(): Block
        +acceptItem(source: Building, item: Item): boolean
        +getMaximumAccepted(item: Item): int
        +acceptPayload(source: Building, payload: Payload): boolean
        +shouldConsume(): boolean
        +updateTile(): void
        +draw(): void
    }
    note bottom of BlockProducerBuild : updateTile(): progress +=\nbuildSpeed * edelta();\nat recipe.buildTime:\npayload = new BuildPayload(recipe, team);\nthen moveOutPayload().

    class Constructor {
        #filter: Seq<Block>
        #minBlockSize: int = 1
        #maxBlockSize: int = 2
        --
        +setStats(): void
        +canProduce(b: Block): boolean
        +getPlanConfigs(options: Seq): void
    }

    class ConstructorBuild {
        -recipe: Block
        --
        +recipe(): Block
        +buildConfiguration(table: Table): void
        +config(): Object
        +drawSelect(): void
    }
}

' ========================
' Unit-production blocks
' ========================
package "mindustry.world.blocks.units" {

    class UnitBlock {
        ' Base for unit-producing factory blocks
    }

    class UnitBuild {
        ' Base build for unit factory blocks
    }

    class Reconstructor {
        #constructTime: float = 120f
        #upgrades: Seq<UnitType[]>
        #capacities: int[]
        #createSound: Sound
        #createSoundVolume: float = 1f
        --
        +init(): void
        +setBars(): void
        +setStats(): void
        +addUpgrade(from: UnitType, to: UnitType): void
        +initCapacities(): void
        +drawPlanRegion(plan: BuildPlan, builds): void
        +afterPatch(): void
    }
    note right of Reconstructor : commandable=true.\ninitCapacities(): scans\nConsumeItems, sets\nconsumer multiplier\nfor team unit cost.

    class ReconstructorBuild {
        -commandPos: Vec2
        -command: UnitCommand
        -constructing: boolean
        --
        +fraction(): float
        +acceptUnitPayload(unit: Unit): boolean
        +canSetCommand(): boolean
        +acceptPayload(source: Building, payload: Payload): boolean
        +updateTile(): void
        +shouldConsume(): boolean
        +unit(): UnitType
        +upgrade(type: UnitType): UnitType
        +hasUpgrade(type: UnitType): boolean
        +constructing(): boolean
        +draw(): void
    }
    note bottom of ReconstructorBuild : updateTile(): if hasUpgrade →\nmoveInPayload() → progress;\nat constructTime:\npayload.unit = upgrade(type).create(team);\nfires UnitCreateEvent.

    class UnitAssembler {
        #areaSize: int = 11
        #droneType: UnitType
        #dronesCreated: int = 4
        #droneConstructTime: float = 240f
        #capacities: int[]
        #plans: Seq<AssemblerUnitPlan>
        #consPayload: ConsumePayloadDynamic
        #consItem: ConsumeItemDynamic
        --
        +getRect(rect: Rect, x, y, rotation): Rect
        +canPlaceOn(tile, team, rotation): boolean
        +init(): void
        +setStats(): void
        +initCapacities(): void
        +{static} assemblerUnitSpawned(tile: Tile): void
        +{static} assemblerDroneSpawned(tile: Tile, id: int): void
    }
    note right of UnitAssembler : acceptsPayload=true,\nhasItems=true, rotate=true,\ngroup=BlockGroup.units,\nflags={unitAssembler}.\n@Remote methods for\nmultiplayer sync.

    class AssemblerUnitPlan {
        +unit: UnitType
        +requirements: Seq<PayloadStack>
        +itemReq: ItemStack[]
        +liquidReq: LiquidStack[]
        +time: float
        --
        +AssemblerUnitPlan(unit, time, requirements)
    }

    class UnitAssemblerBuild {
        -commandPos: Vec2
        -units: Seq<Unit>
        -modules: Seq<UnitAssemblerModuleBuild>
        -blocks: PayloadSeq
        -progress: float
        -warmup: float
        -currentTier: int
        -droneProgress: float
        -wasOccupied: boolean
        --
        +unit(): UnitType
        +plan(): AssemblerUnitPlan
        +shouldConsume(): boolean
        +updateTile(): void
        +droneSpawned(id: int): void
        +spawned(): void
        +checkTier(): void
        +yeetPayload(payload: Payload): void
        +acceptPayload(source, payload): boolean
        +ready(): boolean
        +getUnitSpawn(): Vec2
        +updateModules(build: UnitAssemblerModuleBuild): void
    }
    note bottom of UnitAssemblerBuild : updateTile(): spawns AssemblerAI\ndrones up to dronesCreated;\nyeets accepted payloads\nto spawn area;\ncheckTier(): finds highest\nconsecutive module tier.

    class UnitAssemblerModule {
        ' Companion module to raise tier
    }

    class UnitAssemblerModuleBuild {
        ' Module build instance
    }

    class DroneCenter {
        #unitsSpawned: int = 4
        #droneType: UnitType
        #status: StatusEffect
        #droneConstructTime: float = 180f
        #statusDuration: float = 120f
        #droneRange: float = 50f
        --
        +init(): void
    }
    note right of DroneCenter : //TODO remove (marked for removal).\ninit() sets droneType.aiController\n= EffectDroneAI::new.

    class DroneCenterBuild {
        -units: Seq<Unit>
        -target: Unit
        -droneProgress: float
        -droneWarmup: float
        --
        +updateTile(): void
        +drawConfigure(): void
        +draw(): void
    }
    note right of DroneCenterBuild : Spawns droneType units;\nautotargets nearest non-core\nallied unit. Drones apply\nstatus when within droneRange.

    class EffectDroneAI {
        +updateUnit(): void
    }
    note right of EffectDroneAI : Reads DroneCenterBuild.target\nvia BuildingTetherc;\nmoveTo(target),\napplies status on range.

    class RepairTower {
        #range: float = 80f
        #circleColor: Color
        #circleSpeed: float = 120f
        #circleStroke: float = 3f
        #squareRad: float = 3f
        #healAmount: float = 1f
        #glow: TextureRegion
        --
        +setStats(): void
        +drawPlace(x, y, rotation, valid): void
    }
    note right of RepairTower : update=true, solid=true,\nsuppressable=true,\nflags={repair}

    class RepairTowerBuild {
        -refresh: float
        -warmup: float
        -totalProgress: float
        -targets: Seq<Unit>
        --
        +updateTile(): void
        +shouldConsume(): boolean
        +draw(): void
        +range(): float
        +warmup(): float
        +drawSelect(): void
    }
    note bottom of RepairTowerBuild : Every refreshInterval=6f ticks:\nclears+refills targets via\nUnits.nearby() for damaged units;\nheals each by healAmount*edelta().

    class RepairTurret {
        #repairRadius: float = 50f
        #repairSpeed: float = 0.3f
        #powerUse: float
        #length: float = 5f
        #beamWidth: float = 1f
        #pulseRadius: float = 6f
        #acceptCoolant: boolean = false
        #coolantUse: float = 0.5f
        #coolantMultiplier: float = 1f
        #laserColor: Color
        --
        +setStats(): void
        +init(): void
        +drawPlace(x, y, rotation, valid): void
        +{static} drawBeam(...): void
    }
    note right of RepairTurret : hasPower=true,\ngroup=BlockGroup.projectors,\nflags={repair}.\nOptional ConsumeCoolant.

    class RepairPointBuild {
        -target: Unit
        -offset: Vec2
        -lastEnd: Vec2
        -strength: float
        -rotation: float = 90f
        --
        +updateTile(): void
        +shouldConsume(): boolean
        +draw(): void
        +range(): float
        +buildRotation(): float
        +drawSelect(): void
    }
    note bottom of RepairPointBuild : Heals if angleDist < 30°;\nrotates toward target\nvia slerpDelta;\nretargets every 20 ticks\nvia Units.closest(damaged).
}

' ========================
' Inheritance: external
' ========================
PayloadBlock --|> Block
PayloadBlockBuild --|> Building
BlockProducer --|> PayloadBlock
BlockProducerBuild --|> PayloadBlockBuild

UnitBlock --|> PayloadBlock
UnitBuild --|> PayloadBlockBuild

UnitAssembler --|> PayloadBlock
UnitAssemblerBuild --|> PayloadBlockBuild
UnitAssemblerModule --|> PayloadBlock
UnitAssemblerModuleBuild --|> PayloadBlockBuild

DroneCenter --|> Block
DroneCenterBuild --|> Building
EffectDroneAI --|> AIController

RepairTower --|> Block
RepairTowerBuild --|> Building
RepairTurret --|> Block
RepairPointBuild --|> Building

' ========================
' Payload implementation
' ========================
BuildPayload ..|> Payload
UnitPayload ..|> Payload

' ========================
' Inheritance: unit blocks
' ========================
Constructor --|> BlockProducer
ConstructorBuild --|> BlockProducerBuild
Reconstructor --|> UnitBlock
ReconstructorBuild --|> UnitBuild

' ========================
' Interface implementation
' ========================
RepairTowerBuild ..|> Ranged
RepairPointBuild ..|> Ranged
RepairPointBuild ..|> RotBlock

' ========================
' Inner class containment
' ========================
PayloadBlock +-- PayloadBlockBuild
BlockProducer +-- BlockProducerBuild
Constructor +-- ConstructorBuild
UnitBlock +-- UnitBuild
Reconstructor +-- ReconstructorBuild
UnitAssembler +-- UnitAssemblerBuild
UnitAssembler +-- AssemblerUnitPlan
UnitAssemblerModule +-- UnitAssemblerModuleBuild
DroneCenter +-- DroneCenterBuild
DroneCenter +-- EffectDroneAI
RepairTower +-- RepairTowerBuild
RepairTurret +-- RepairPointBuild

' ========================
' Composition / Aggregation
' ========================
BuildPayload *-right- "1" Building : wraps >
UnitPayload *-right- "1" Unit : wraps >

UnitAssemblerBuild "1" o-- "0..*" UnitAssemblerModuleBuild : modules
UnitAssemblerBuild "1" o-- "0..*" Unit : spawned units
UnitAssemblerBuild ..> AssemblerUnitPlan : selects plan by tier

DroneCenterBuild "1" o-- "0..*" Unit : drone units
RepairTowerBuild "1" o-- "0..*" Unit : heal targets

' ========================
' Key config dependencies
' ========================
Reconstructor ..> UnitCommand : <<config: UnitCommand>>
ReconstructorBuild ..> UnitPayload : accepts & upgrades
ReconstructorBuild ..> UnitType : creates upgraded unit

@enduml
