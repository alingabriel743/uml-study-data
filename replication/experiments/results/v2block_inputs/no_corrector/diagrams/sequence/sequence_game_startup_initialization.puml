@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #495057
skinparam sequenceParticipantBackgroundColor #F8F9FA
skinparam sequenceParticipantFontColor #212529
skinparam sequenceLifeLineBorderColor #6C757D
skinparam sequenceBoxBackgroundColor #E9ECEF
skinparam sequenceBoxBorderColor #6C757D
skinparam noteBackgroundColor #FFF9C4
skinparam noteBorderColor #F9A825

title Game Startup and Initialization

actor OS as os
participant "AndroidLauncher" as android
participant "AppFramework\n(Arc ApplicationCore)" as framework
participant "ClientLauncher" as client
participant "LoadRenderer" as loader
participant "Vars\n(Global Service Locator)" as vars
participant "ContentLoader" as content
participant "Mods" as mods
participant "Control" as control
participant "UI" as ui

== Android Entry Point (mobile path) ==

os -> android: onCreate(Bundle savedInstanceState)
activate android
android -> android: checkFiles(Intent intent)
android -> framework: initialize(new ClientLauncher(), config)
note right of android: Delegates lifecycle\nto Arc ApplicationCore
deactivate android

== Shared ApplicationCore Lifecycle ==

activate framework

framework -> client: init()
activate client
client -> client: setup()
note right of client: Configures Arc\nplatform settings
client -> client: add(Vars)\nnote: registers Vars as ApplicationListener module
client -> loader: new LoadRenderer()
activate loader
note right of loader: Shows loading\nscreen at 20 FPS
deactivate client

== Async Loading Phase ==

framework -> vars: loadAsync()
activate vars

vars -> vars: init()
note right of vars: Instantiates ALL global singletons\n(content, control, ui, logic,\nrenderer, mods, net, world,\nmaps, pathfinder, fogControl...)

vars -> content: new ContentLoader()
activate content
note right of content: Vars.content assigned

vars -> mods: new Mods()
activate mods
note right of mods: Vars.mods assigned

vars -> control: new Control()
activate control
note right of control: Vars.control assigned\nOwns: Saves, SoundControl,\nInputHandler

vars -> ui: new UI()
activate ui
note right of ui: Vars.ui assigned\nOwns: MenuFragment, HudFragment,\nChatFragment, MinimapFragment...

== Content Registration ==

vars -> content: createBaseContent()
note right of content: Registers all base items,\nblocks, units, liquids,\nstatuses, weather, etc.

vars -> mods: loadAsync()
note right of mods: Discovers mod files,\nparses mod.json / hjson
mods -> content: createModContent()
note right of content: Registers mod-provided\ncontent objects

vars -> content: init()
note right of content: Calls initialize(callable)\non each registered content piece

vars -> content: load()
note right of content: Loads textures/assets\nvia AssetManager
content -> content: loadColors()
note right of content: Palette load
deactivate content

deactivate vars

== System Subsystem Loading ==

framework -> control: loadAsync() / loadSync()
note right of control: Sets up Saves,\nSoundControl, InputHandler
deactivate control

framework -> ui: loadAsync() / loadSync()
note right of ui: Loads UI colors,\nbuilds HUD/menu fragments
deactivate ui

== Launch Validation & Finalization ==

framework -> vars: loadAsync() [settings phase]
activate vars
vars -> vars: loadSettings()
note right of vars: Reads player preferences
vars -> vars: checkLaunch()
note right of vars: Validates launch conditions;\nsets failedToLaunch if error
vars -> vars: finishLaunch()
note right of vars: Completes startup sequence
deactivate vars

deactivate mods

== Main Loop & Menu Transition ==

loop every frame at 20 FPS (loading screen)
    framework -> client: update()
    activate client
    client -> loader: render loading progress
    client -> client: monitor loading completion
    deactivate client
end

framework -> client: update() [loading complete]
activate client
client -> loader: dispose loading screen
deactivate loader
client -> ui: menufrag.show()
note right of ui: Shows MainMenuFragment\n— game is ready
deactivate client

deactivate framework

@enduml
