@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam participant {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam sequenceArrowColor #495057
skinparam sequenceLifeLineBorderColor #6C757D
skinparam sequenceGroupBorderColor #6C757D
skinparam sequenceGroupBackgroundColor #E9ECEF
skinparam sequenceGroupFontColor #212529
skinparam noteBorderColor #ADB5BD
skinparam noteBackgroundColor #FFF3CD

title Mod Loading and JavaScript Scripting

actor "Game Init" as Caller

participant "Mods" as Mods
participant "Platform" as Platform
participant "ModClassLoader" as MCL
participant "JVM" as JVM
participant "LoadedMod" as LMod
participant "ContentParser" as CP
participant "Scripts" as Scripts
participant "AndroidRhinoContext" as ARC
participant "AndroidContextFactory" as ACF
participant "BaseAndroidClassLoader\n(InMemory/File)" as BACL
participant "RhinoContext" as Rhino

== MOD DISCOVERY & LOADING ==

Caller -> Mods : load()
activate Mods

Mods -> Mods : scan modDirectory\n(.jar / .zip / folders)
Mods -> Platform : getWorkshopContent(LoadedMod.class)\n[Steam workshop mods]
activate Platform
Platform --> Mods : List<Fi> workshopFiles
deactivate Platform

Mods -> Mods : for each candidate:\nfindMeta(resolveRoot(ZipFi))
Mods -> Mods : resolveDependencies(metas)\n→ OrderedMap<name, ModState>\n[topological sort]

loop for each resolved entry
    Mods -> Mods : loadMod(file, overwrite=false, enabled)
    activate Mods #D4E6F1
    Mods -> Mods : resolveRoot(ZipFi) → zip root Fi
    Mods -> Mods : findMeta(zip) → ModMeta\n(reads mod.json / mod.hjson)

    alt Java mod && enabled
        Mods -> Platform : loadJar(sourceFile, mainLoader)\n→ ClassLoader loader
        activate Platform
        Platform --> Mods : ClassLoader loader
        deactivate Platform
        Mods -> MCL : mainLoader.addChild(loader)
        activate MCL
        MCL --> Mods : (child registered)
        deactivate MCL
        Mods -> JVM : Class.forName(mainClass, true, loader)
        activate JVM
        JVM --> Mods : Class<?> modClass
        deactivate JVM
        Mods -> JVM : modClass.getDeclaredConstructor().newInstance()
        activate JVM
        JVM --> Mods : Mod mainMod
        deactivate JVM
    else Android mod
        Mods -> Mods : mainFile = zip.child('classes.dex')
        note right: Android: DEX class path\nDesktop: walk classpath
    end

    Mods -> LMod : new LoadedMod(file, zip,\nmainMod, loader, meta)
    activate LMod
    LMod --> Mods : loadedMod
    deactivate LMod
    deactivate Mods
end

Mods -> Mods : updateDependencies(mod)\nfor all mods
Mods -> Mods : sortMods() + buildFiles()\n[includes i18n bundles]

deactivate Mods

== CONTENT LOADING ==

Caller -> Mods : loadContent()
activate Mods

Mods -> Mods : orderedMods()\n[dependency-ordered list]

loop for each Java mod
    Mods -> LMod : mod.main.loadContent()
    activate LMod
    LMod --> Mods : (content loaded)
    deactivate LMod
end

loop for each content JSON/hjson file
    Mods -> CP : parser.parse(mod, name,\nfileContent, file, type)
    activate CP
    CP --> Mods : (content registered)
    deactivate CP
end

Mods -> CP : parser.finishParsing()
activate CP
CP --> Mods : (parsing complete)
deactivate CP

Mods -> Mods : fire(ModContentLoadEvent)
deactivate Mods

== SCRIPT LOADING ==

Caller -> Mods : loadScripts()
activate Mods

loop for each enabled mod with scripts/
    Mods -> Mods : find main.js\n(single .js OR scripts/main.js)

    opt Scripts not yet initialized
        Mods -> Platform : platform.createScripts()
        activate Platform

        note over Platform, ARC: Android-only path below

        Platform -> ARC : AndroidRhinoContext.enter(cacheDirectory)
        activate ARC

        opt no global ContextFactory
            ARC -> ACF : new AndroidContextFactory(cacheDir)
            activate ACF
            ACF -> ACF : createClassLoader(parent)\n→ InMemoryAndroidClassLoader [API≥26]\n   OR FileAndroidClassLoader [older]
            ACF --> ARC : factory ready
            deactivate ACF
        end

        ARC -> ACF : factory.enterContext()
        activate ACF
        ACF --> ARC : Context
        deactivate ACF
        ARC --> Platform : Context
        deactivate ARC

        Platform -> Scripts : new Scripts(context)
        activate Scripts
        Scripts -> Rhino : new ImporterTopLevel(context) → scope
        activate Rhino
        Rhino --> Scripts : scope
        deactivate Rhino
        Scripts -> Scripts : setModuleScriptProvider(\n  SoftCachingModuleScriptProvider\n  (new ScriptModuleProvider()))
        Scripts -> Scripts : setSandboxed(true)\n.createRequire(context, scope)\n.install(scope)
        Scripts -> Scripts : run(global.js, wrap=false)\n[load Rhino globals]
        Scripts --> Platform : scripts instance
        deactivate Scripts
        Platform --> Mods : Scripts
        deactivate Platform
    end

    Mods -> Scripts : scripts.run(mod, main.js Fi)
    activate Scripts
    Scripts -> Rhino : evaluateString(scope,\n'modName=...; scriptName=...',\n'initscript.js')
    activate Rhino
    Rhino --> Scripts : (mod context set)
    deactivate Rhino
    Scripts -> Rhino : evaluateString(scope,\n'(function(){"use strict"; <script> })();',\nfile)
    activate Rhino
    Rhino --> Scripts : result
    deactivate Rhino
    Scripts --> Mods : (script executed)
    deactivate Scripts
end

deactivate Mods

== ANDROID BYTECODE COMPILATION (Rhino → DEX) ==

note over Rhino, BACL: Triggered when Rhino generates JVM bytecode\nfor compiled JS functions

Rhino -> BACL : defineClass(name, javaByteCode[])
activate BACL
BACL -> BACL : new DexOptions(); new DexFile(dexOptions)
BACL -> BACL : CfTranslator.translate(context,\nclassFile, ...) → add to DexFile
BACL -> BACL : dexFile.toDex() → new Dex(bytes)

opt oldDex present
    BACL -> BACL : DexMerger.merge([newDex, oldDex])
end

alt InMemoryAndroidClassLoader (API ≥ 26)
    BACL -> JVM : new InMemoryDexClassLoader(\n  ByteBuffer.wrap(dex.getBytes()), parent)\n  .loadClass(name)
    activate JVM
    JVM --> BACL : Class<?>
    deactivate JVM
else FileAndroidClassLoader (older API)
    BACL -> BACL : dex.writeTo(file)
    BACL -> JVM : new DexClassLoader(path, cacheDir,\n  null, parent).loadClass(name)
    activate JVM
    JVM --> BACL : Class<?>
    deactivate JVM
end

BACL --> Rhino : Class<?>
deactivate BACL

@enduml
