@startuml
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #495057
    FontColor #212529
}

left to right direction

title Achievements & Game Statistics

actor "Player" as Player
actor "GameSystem\n(Logic / WaveSpawner)" as GameSystem
actor "Platform\n(Steam / Google Play)" as Platform

rectangle "Achievements & Game Statistics" {

    package "Achievement Management" {
        usecase "Initialize GameService" as UC12
        usecase "Register Game Events" as UC05
        usecase "Complete Achievement" as UC01
        usecase "Check Achievement Progress" as UC02
        usecase "Trigger Event-Based Achievement" as UC04
        usecase "Query Achievement Status" as UC03
        usecase "Check Platform Service Enabled" as UC13
    }

    package "Global Statistics (SStat)" {
        usecase "Update Global Stat" as UC06
        usecase "Save Achievement / Stats State" as UC11
    }

    package "Campaign Statistics" {
        usecase "Win / Lose Game Event" as UC09
        usecase "Record Campaign Statistics" as UC07
        usecase "Save / Load Campaign Stats" as UC08
        usecase "Access Campaign Stats" as UC14
    }

    package "Game Configuration" {
        usecase "Set Game Difficulty" as UC10
    }
}

' --- Player interactions ---
Player --> UC03
Player --> UC14
Player --> UC10

' --- GameSystem interactions ---
GameSystem --> UC12
GameSystem --> UC05
GameSystem --> UC01
GameSystem --> UC02
GameSystem --> UC04
GameSystem --> UC06
GameSystem --> UC07
GameSystem --> UC08
GameSystem --> UC09
GameSystem --> UC11

' --- Platform interactions (use case → external system) ---
UC11 --> Platform : persist achievements\n& stat state
UC06 --> Platform : storeStats()

' --- Include relationships ---
UC04 .> UC01 : <<include>>
UC02 .> UC13 : <<include>>
UC06 .> UC13 : <<include>>

' --- Extend relationships ---
UC09 .> UC07 : <<extend>>

' --- Internal dependency ---
UC05 ..> UC12 : called by

@enduml
