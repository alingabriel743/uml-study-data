@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

left to right direction

title Building Construction & Configuration

actor "Player" as player
actor "Unit\n(Builder)" as unit
actor "Server\n(Build / Call)" as server
actor "Admin\n(Authorization)" as admin

rectangle "Building Construction & Configuration" {

    package "Block Placement" {
        usecase "Select Block to Place" as UC1
        usecase "Place Single Block" as UC2
        usecase "Place Block Line" as UC3
        usecase "Place Block Rectangle" as UC4
        usecase "Upgrade Block" as UC5
    }

    package "Schematic Management" {
        usecase "Use Schematic" as UC6
        usecase "Save Schematic" as UC7
    }

    package "Demolition" {
        usecase "Break / Demolish Block" as UC8
        usecase "Break Area Selection" as UC9
    }

    package "Building Modification" {
        usecase "Configure Building" as UC10
        usecase "Rotate Block" as UC11
    }

    package "Repair & Rebuild" {
        usecase "Repair Derelict Block" as UC12
        usecase "Rebuild Broken Structures" as UC13
    }

    package "Queue & Inventory" {
        usecase "Remove Build Queue Entry" as UC14
        usecase "Toggle Auto-Build" as UC15
        usecase "Drop / Deposit Items" as UC16
    }
}

' --- Primary actor (Player) initiates all build actions ---
player --> UC1
player --> UC2
player --> UC3
player --> UC4
player --> UC5
player --> UC6
player --> UC7
player --> UC8
player --> UC9
player --> UC10
player --> UC11
player --> UC12
player --> UC13
player --> UC14
player --> UC15
player --> UC16

' --- Unit (Builder) executes the queued build plans ---
UC2 --> unit
UC3 --> unit
UC4 --> unit
UC5 --> unit
UC6 --> unit
UC8 --> unit
UC9 --> unit
UC12 --> unit
UC13 --> unit

' --- Server validates and executes @Remote calls ---
UC2  --> server
UC8  --> server
UC10 --> server
UC11 --> server
UC16 --> server

' --- Admin authorises sensitive building operations ---
admin --> UC10
admin --> UC11

' --- Include relationships (base use case always calls included) ---
UC3 ..> UC2 : <<include>>
UC4 ..> UC2 : <<include>>
UC5 ..> UC2 : <<include>>
UC6 ..> UC1 : <<include>>
UC9 ..> UC8 : <<include>>
UC13 ..> UC12 : <<include>>

@enduml
