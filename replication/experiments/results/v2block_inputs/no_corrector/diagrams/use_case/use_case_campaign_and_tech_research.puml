@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Campaign & Technology Research

left to right direction

actor "Player" as player
actor "System\n(Game Engine /\nContentLoader)" as system
actor "Network Client\n(Read-Only)" as netclient

rectangle "Campaign & Technology Research" {

    ' --- Player-facing research use cases ---
    usecase "Browse Tech Tree" as UC_Browse
    usecase "Select Tech Tree Root\n(by Planet)" as UC_SelectRoot
    usecase "View Node Requirements\n& Progress" as UC_ViewReqs
    usecase "Spend Items to\nResearch Node" as UC_Spend
    usecase "Unlock Technology Node" as UC_Unlock
    usecase "View Completed\nNode Info" as UC_ViewInfo

    ' --- Campaign progression use cases ---
    usecase "Complete Sector" as UC_CompleteSector
    usecase "Unlock Campaign Sector" as UC_UnlockSector

    ' --- System-driven use cases ---
    usecase "Load / Initialize Content" as UC_LoadContent
    usecase "Load Erekir Tech Tree" as UC_LoadErekir
    usecase "Rebalance Erekir\nUnits & Turrets" as UC_Rebalance
    usecase "Apply Campaign\nRules to Game" as UC_ApplyRules
    usecase "Track Campaign\nStatistics" as UC_TrackStats

    ' --- Internal sub-behaviors (include / extend targets) ---
    usecase "Check Node Visibility" as UC_CheckNodes
    usecase "Layout Tech Tree\n(BranchTreeLayout)" as UC_Layout
    usecase "Rebuild Item Display" as UC_RebuildItems
    usecase "Fire Research Event" as UC_ResearchEvent
    usecase "Complete Sector Objective" as UC_SectorObjective
}

' ── Player associations ──────────────────────────────────────
player --> UC_Browse
player --> UC_SelectRoot
player --> UC_ViewReqs
player --> UC_Spend
player --> UC_Unlock
player --> UC_ViewInfo
player --> UC_CompleteSector

' ── Network Client (view-only; spending/unlocking disabled) ──
netclient --> UC_Browse
note on link
  Read-only: canSpend()
  returns false for net.client
end note

' ── System associations ──────────────────────────────────────
system --> UC_LoadContent
system --> UC_LoadErekir
system --> UC_Rebalance
system --> UC_ApplyRules
system --> UC_TrackStats

' ── <<include>> relationships (ResearchDialog internals) ──────
UC_Browse ..> UC_CheckNodes   : <<include>>
UC_Browse ..> UC_Layout       : <<include>>
UC_Browse ..> UC_RebuildItems : <<include>>

' ── <<extend>> relationships ─────────────────────────────────
UC_ResearchEvent  ..> UC_Unlock       : <<extend>>
UC_SectorObjective ..> UC_UnlockSector : <<extend>>

' ── Ordering / dependency ────────────────────────────────────
UC_CompleteSector ..> UC_UnlockSector : triggers
UC_Unlock         ..> UC_UnlockSector : <<precedes>>\n(sector node needs\nResearch objective)

@enduml
