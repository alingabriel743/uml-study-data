@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}

title Enemy AI & Pathfinding

left to right direction

actor "WaveTeam\n(Enemy)" as waveTeam
actor "GameEngine" as gameEngine
actor "PlayerBase\n(Target)" as playerBase
actor "World / Tiles" as worldTiles

rectangle "Enemy AI Subsystem\n(mindustry.ai + mindustry.ai.types + AIController)" {

    package "Wave Spawning" {
        usecase "Spawn Enemy Wave" as UC1
    }

    package "Unit Movement" {
        usecase "Navigate to Player Base\n(Ground)" as UC2
        usecase "Navigate to Target\n(Flying)" as UC3
        usecase "Handle Stuck Unit" as UC11
    }

    package "Combat" {
        usecase "Find Attack Target" as UC4
        usecase "Execute Attack" as UC5
    }

    package "Base Building" {
        usecase "Build Enemy Base" as UC6
        usecase "Calculate Attack Path\n(Avoid Blocking)" as UC7
        usecase "Place Base Schematic" as UC8
        usecase "Load Base Part Registry" as UC9
    }

    package "Pathfinding" {
        usecase "Compute A* Path" as UC10
    }
}

' Primary actor: WaveTeam (Enemy) initiates AI-driven actions
waveTeam --> UC1
waveTeam --> UC2
waveTeam --> UC3
waveTeam --> UC4
waveTeam --> UC5
waveTeam --> UC6
waveTeam --> UC11

' System actor: GameEngine drives update loops and initialization
gameEngine --> UC1
gameEngine --> UC9
gameEngine --> UC10

' Secondary target actor: PlayerBase is attacked
UC2 --> playerBase
UC3 --> playerBase
UC5 --> playerBase

' System actor: World / Tiles provides grid data for navigation
UC2 --> worldTiles
UC10 --> worldTiles

' Use case relationships
UC11 ..> UC2  : <<extend>>\n[when stuckTime\n>= threshold]
UC5  ..> UC4  : <<include>>
UC6  ..> UC7  : <<include>>
UC6  ..> UC8  : <<include>>
UC7  ..> UC10 : <<include>>

note bottom of UC10
  A* used by BaseBuilderAI
  for static path calculation.
  Flow-field (Pathfinder) used
  for real-time unit movement.
end note

note right of UC8
  Rejects schematic tiles that
  overlap the calculated path
  (path IntSet from UC7)
end note

@enduml
