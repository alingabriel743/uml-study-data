@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Game Save & Load

left to right direction

actor "Player" as Player
actor "Game System" as GameSystem
actor "Mod" as Mod

rectangle "Game Save & Load System" {
    usecase "Save Game to Slot" as UC1
    usecase "Load Game from Slot" as UC2
    usecase "View Save Preview" as UC3
    usecase "Autosave" as UC4
    usecase "Add New Save Slot" as UC5
    usecase "Import Save File" as UC6
    usecase "Delete Save Slot" as UC9
    usecase "Check Save Validity" as UC7
    usecase "Get Save Metadata" as UC8
    usecase "Generate Map Preview" as UC11
    usecase "Write / Read Custom Chunks" as UC10
}

' Player interactions
Player --> UC1
Player --> UC2
Player --> UC3
Player --> UC5
Player --> UC6
Player --> UC9

' Game System interactions
GameSystem --> UC4
GameSystem --> UC11

' Mod interaction
Mod --> UC10

' Include relationships (always executed as part of base use case)
UC4 ..> UC1 : <<include>>
UC2 ..> UC7 : <<include>>
UC2 ..> UC8 : <<include>>
UC3 ..> UC11 : <<include>>

' Extend relationships (conditionally invoked)
UC1 ..> UC10 : <<extend>>
UC2 ..> UC10 : <<extend>>

@enduml
