@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #495057
    FontColor #212529
}

left to right direction

title Logic Block Programming

actor "Player" as player
actor "LogicBlock\n(in-world)" as logicblock
actor "WorldProcessor\n(privileged)" as worldproc
actor "Building\n(Controllable)" as building
actor "Unit" as unit

rectangle "Logic Block Programming System" {

    package "Code Authoring" {
        usecase "Open Logic Editor\n(LogicDialog)" as UC_Open
        usecase "Write / Edit Logic Code\n(LCanvas)" as UC_Edit
        usecase "Import / Export Code\nvia Clipboard" as UC_Clipboard
    }

    package "Compilation Pipeline" {
        usecase "Parse Text Code\n(LParser)" as UC_Parse
        usecase "Assemble Code\nto Instructions (LAssembler)" as UC_Assemble
    }

    package "Execution Engine" {
        usecase "Execute Logic Program\n(LExecutor per tick)" as UC_Execute
        usecase "Run Logic Script\nDirectly" as UC_RunScript
    }

    package "I/O and Control" {
        usecase "Sense Building Properties\n(SensorStatement)" as UC_Sense
        usecase "Control Building\n(ControlStatement)" as UC_Control
        usecase "Bind / Control Unit\n(UnitBind / UnitControl)" as UC_BindUnit
        usecase "Read / Write Memory\n(MemoryBlock)" as UC_Memory
        usecase "Draw to Display\n(DrawStatement)" as UC_Draw
        usecase "Print to Message\n(PrintStatement)" as UC_Print
    }

    package "Computation and Flow" {
        usecase "Arithmetic / Logic Ops\n(OperationStatement)" as UC_Ops
        usecase "Conditional Jump\n(JumpStatement)" as UC_Jump
        usecase "Locate Targets\n(UnitLocate / Radar)" as UC_Locate
        usecase "Fetch Game Objects\n(FetchStatement)" as UC_Fetch
        usecase "Sync Variables\nover Network (SyncStatement)" as UC_Sync
    }

    package "Privileged Instructions" {
        usecase "Spawn Units / Bullets\n(SpawnUnit / SpawnBullet)" as UC_Spawn
        usecase "Set Game Rules\n(SetRuleStatement)" as UC_SetRules
        usecase "Query World State\n(QueryStatement)" as UC_Query
    }
}

' --- Player authoring relationships ---
player --> UC_Open
player --> UC_Edit
player --> UC_Clipboard

UC_Open  ..> UC_Edit    : <<include>>
UC_Edit  ..> UC_Parse   : <<include>>
UC_Parse ..> UC_Assemble : <<include>>

' --- LogicBlock execution relationships ---
logicblock --> UC_Execute
logicblock --> UC_RunScript
logicblock --> UC_Sense
logicblock --> UC_Control
logicblock --> UC_BindUnit
logicblock --> UC_Memory
logicblock --> UC_Draw
logicblock --> UC_Print
logicblock --> UC_Ops
logicblock --> UC_Jump
logicblock --> UC_Locate
logicblock --> UC_Fetch
logicblock --> UC_Sync

' --- WorldProcessor: inherits LogicBlock + privileged capabilities ---
worldproc --|> logicblock
worldproc --> UC_Spawn
worldproc --> UC_SetRules
worldproc --> UC_Query

' --- Target actor relationships ---
UC_Control --> building
UC_Sense   --> building
UC_BindUnit --> unit

@enduml
