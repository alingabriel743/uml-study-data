@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

title Map Editor & Creation

left to right direction

actor "Player\n(Editor User)" as Player
actor "Platform\n(OS/File System)" as Platform
actor "Steam Workshop" as Steam
actor "Game Engine\n(Logic/State)" as GameEngine

rectangle "Map Editor & Creation" {

    package "Map Lifecycle" {
        usecase "Create New Map" as UC01
        usecase "Load Existing Map" as UC04
        usecase "Import Map from File" as UC02
        usecase "Import Map from Image (PNG)" as UC03
        usecase "Save Map" as UC14
        usecase "Export Map as File" as UC15
        usecase "Export Map as PNG Image" as UC16
        usecase "Publish to Steam Workshop" as UC19
    }

    package "Drawing & Editing" {
        usecase "Draw / Paint Tiles" as UC05
        usecase "Select Drawing Tool" as UC06
        usecase "Select Block Type" as UC07
        usecase "Set Draw Team" as UC08
        usecase "Undo Operation" as UC09
        usecase "Redo Operation" as UC10
    }

    package "Map Configuration" {
        usecase "Resize Map" as UC11
        usecase "Generate Map Procedurally" as UC12
        usecase "Generate Sector Map" as UC22
        usecase "Edit Map Metadata" as UC13
        usecase "Edit Game Rules" as UC13a
        usecase "Edit Waves & Objectives" as UC13b
    }

    package "Testing & Preview" {
        usecase "Playtest Map" as UC17
        usecase "Edit Map In-Game" as UC18
    }

    package "View Controls" {
        usecase "Pan / Zoom Canvas" as UC21
        usecase "Toggle Grid Overlay" as UC20
    }
}

' === Player associations ===
Player --> UC01
Player --> UC04
Player --> UC02
Player --> UC03
Player --> UC14
Player --> UC15
Player --> UC16
Player --> UC19
Player --> UC05
Player --> UC06
Player --> UC07
Player --> UC08
Player --> UC09
Player --> UC10
Player --> UC11
Player --> UC12
Player --> UC22
Player --> UC13
Player --> UC17
Player --> UC18
Player --> UC21
Player --> UC20

' === External actor associations ===
UC02 --> Platform
UC03 --> Platform
UC15 --> Platform
UC16 --> Platform

UC19 --> Steam

UC17 --> GameEngine
UC18 --> GameEngine

' === Include relationships ===
UC17 .> UC14 : <<include>>
UC19 .> UC14 : <<include>>
UC05 .> UC06 : <<include>>
UC05 .> UC07 : <<include>>
UC13 .> UC13a : <<include>>
UC13 .> UC13b : <<include>>

' === Notes ===
note right of UC05
  Tools: pencil, eraser, fill,
  spray, line, pick, zoom.
  Bresenham interpolation on drag.
end note

note right of UC14
  Guard: map name must not be empty.
  Built-in maps cannot be overwritten.
end note

note right of UC19
  Steam builds only.
  Requires description ≥ 4 chars
  and valid gamemode spawn point.
end note

note right of UC13
  Sub-dialogs: Rules, Waves,
  Objectives, Generation Filters,
  Locales, World Processors, Patches.
end note

@enduml
