@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}

title Map Management & Loading

left to right direction

actor "Player" as player
actor "MapEditor\n(Player)" as mapeditor
actor "Game Engine\n/ Server" as gameengine
actor "Platform\n(Workshop / Mods)" as platform

rectangle "Map Management & Loading" {

    usecase "Browse Map Library" as UC1
    usecase "Search & Filter Maps" as UC2
    usecase "Preview Map" as UC3
    usecase "Select Map" as UC4
    usecase "Import Map" as UC5
    usecase "Delete Map" as UC6
    usecase "Save / Export Map" as UC7
    usecase "Load Map for Gameplay" as UC8
    usecase "Generate Map\nPreview Image" as UC9
    usecase "Load Default\n& Mod Maps" as UC10
    usecase "Get Next Map\n(Shuffle)" as UC11

}

' Player interactions
player --> UC1
player --> UC2
player --> UC3
player --> UC4
player --> UC5
player --> UC6
mapeditor --> UC7

' System / engine actors
gameengine --> UC8
gameengine --> UC11
platform --> UC10

' Include relationships
UC1 ..> UC10 : <<include>>
UC3 ..> UC9 : <<include>>
UC4 ..> UC8 : <<include>>
UC5 ..> UC9 : <<include>>
UC7 ..> UC9 : <<include>>

' Extend relationships
UC2 .left.> UC1 : <<extend>>

@enduml
