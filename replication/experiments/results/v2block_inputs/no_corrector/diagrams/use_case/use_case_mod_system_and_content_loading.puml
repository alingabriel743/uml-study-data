@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #495057
    FontColor #212529
}
skinparam arrow {
    Color #495057
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F0AD4E
}

title Mod System & Content Loading

left to right direction

actor "Mod Author" as ModAuthor
actor "Player" as Player
actor "Game System" as GameSystem
actor "Server / Rules" as ServerRules

rectangle "Mod System & Content Loading" {

    ' ── Player-facing use cases ────────────────────────────────────
    usecase "Install Mod\n(import .zip file)" as UC01
    usecase "Enable / Disable Mod" as UC02

    ' ── Mod Author use cases ───────────────────────────────────────
    usecase "Define Content via JSON\n(place .json/.hjson in content/<type>s/)" as UC07
    usecase "Register Java Content\n(override Mod.loadContent())" as UC06

    ' ── Game System orchestration ──────────────────────────────────
    usecase "Load Mod Content\n(two-phase: Java + JSON)" as UC05
    usecase "Load Mod Sprites\n(async atlas repack)" as UC03
    usecase "Load Mod Scripts\n(run scripts/main.js)" as UC04
    usecase "Register All Content\n(ContentLoader.handleContent)" as UC13
    usecase "Initialise & Load Content\n(Content.init / postInit / load)" as UC15
    usecase "Look Up Content\nby Name or ID" as UC14

    ' ── ContentParser internals (sub-use cases) ────────────────────
    usecase "Resolve Class Name\nto Java Class\n(ClassMap + forName)" as UC08
    usecase "Parse Content Fields\n(reflection + deferred reads)" as UC09
    usecase "Locate Existing Content\nby Name (override detection)" as UC10

    ' ── Server / runtime patching ──────────────────────────────────
    usecase "Apply Runtime\nData Patches" as UC11
    usecase "Unapply Data Patches\n(rollback via snapshot)" as UC12

}

' ── Actor associations ────────────────────────────────────────────

Player      --> UC01
Player      --> UC02

ModAuthor   --> UC07
ModAuthor   --> UC06

GameSystem  --> UC05
GameSystem  --> UC03
GameSystem  --> UC04
GameSystem  --> UC13
GameSystem  --> UC15
GameSystem  --> UC14

ServerRules --> UC11
ServerRules --> UC12

' ── Include / extend relationships ───────────────────────────────

UC05 ..> UC06 : <<include>>
UC05 ..> UC07 : <<include>>
UC05 ..> UC13 : <<include>>

UC07 ..> UC08 : <<include>>
UC07 ..> UC09 : <<include>>
UC07 ..> UC10 : <<include>>

UC11 ..> UC12 : <<include>>\n(unapply before re-apply)

UC01 ..> UC05 : <<include>>\n(initialize=true)

@enduml
