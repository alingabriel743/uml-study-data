@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

left to right direction

title Multiplayer & Server Management

actor "Player" as player
actor "Admin" as admin
actor "Server\n(NetServer)" as server
actor "System" as system

rectangle "Multiplayer & Server Management" {

    package "Connection Management" {
        usecase "Host / Open Server" as UC01
        usecase "Connect to Server" as UC02
        usecase "Disconnect from Server" as UC03
        usecase "Submit Client Snapshot" as UC17
        usecase "Sync World State to Client" as UC16
    }

    package "Chat & Commands" {
        usecase "Send Chat Message" as UC04
        usecase "Format Chat Message" as UC24
        usecase "Execute Client Commands" as UC19
        usecase "Custom Packet Communication" as UC25
    }

    package "In-Game Actions" {
        usecase "Perform In-Game Action" as UC05
        usecase "Vote to Kick Player" as UC06
    }

    package "Admin: Player Management" {
        usecase "Kick Player" as UC07
        usecase "Ban Player" as UC08
        usecase "Trace Player" as UC09
        usecase "Switch Team" as UC11
        usecase "Unban Player" as UC13
        usecase "Grant / Revoke Admin" as UC14
        usecase "Kick All Players" as UC15
        usecase "Ban by Name Pattern" as UC21
        usecase "Look Up Player Info" as UC22
    }

    package "Admin: Server Configuration" {
        usecase "Configure Server Settings" as UC18
        usecase "Manage Whitelist" as UC12
        usecase "Subnet / DoS Blacklist" as UC20
        usecase "Trigger Wave" as UC10
    }

    package "System Operations" {
        usecase "Assign Team on Join" as UC23
        usecase "Handle Kick Cooldown" as UC26
    }
}

' --- Actor -> Use Case connections ---

' Player
player --> UC02
player --> UC03
player --> UC04
player --> UC05
player --> UC06
player --> UC17
player --> UC19
player --> UC25

' Admin
admin --> UC07
admin --> UC08
admin --> UC09
admin --> UC10
admin --> UC11
admin --> UC12
admin --> UC13
admin --> UC14
admin --> UC15
admin --> UC18
admin --> UC20
admin --> UC21
admin --> UC22

' Server (NetServer)
server --> UC01
server --> UC16

' System
system --> UC23
system --> UC24
system --> UC26

' --- Include / Extend relationships ---

' UC04: Send Chat Message includes Format Chat Message (always formats)
UC04 ..> UC24 : <<include>>

' UC02: Connect includes Assign Team (always assigns team on join)
UC02 ..> UC23 : <<include>>

' UC06: Vote Kick leads to Disconnect when vote passes
UC06 ..> UC03 : <<include>>

' UC07: Admin Kick leads to Disconnect
UC07 ..> UC03 : <<include>>

' UC02: Connect may extend into Whitelist Check (conditional)
UC02 ..> UC12 : <<extend>>

' UC04: Send Chat may trigger Spam/Rate Limit check (conditional)
UC04 ..> UC20 : <<extend>>

' UC08: Admin Ban may trigger Disconnect (conditional)
UC08 ..> UC03 : <<extend>>

@enduml
