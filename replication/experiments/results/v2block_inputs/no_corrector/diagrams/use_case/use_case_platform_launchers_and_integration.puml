@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #212529
}
skinparam ArrowColor #495057
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F9A825
}

left to right direction

title Platform Launchers & Integration

actor "Android User" as androidUser
actor "Android OS" as androidOS
actor "Rhino Scripting\nEngine" as rhino
actor "Build System\n(Annotation Processor)" as buildSystem
actor "Server Admin /\nNetServer" as serverAdmin
actor "System\n(CrashHandler)" as crashSystem

rectangle "Mindustry Platform Integration" {

    package "Android Platform Launch" {
        usecase "Launch Android App" as UC01
        usecase "Request Runtime Permissions" as UC02
        usecase "Handle File / Share Intent" as UC03
        usecase "Detect Tablet Form Factor" as UC04
    }

    package "Rhino Script Engine (Android)" {
        usecase "Create Android\nScript Context" as UC05
        usecase "Create Class Loader\nfor Scripts" as UC06
        usecase "Release Script Context" as UC07
        usecase "Load Class from DEX\n(File-Backed)" as UC08
        usecase "Load Class from DEX\n(In-Memory)" as UC09
        usecase "Define / Link Class\nfrom Bytecode" as UC10
    }

    package "Crash Reporting" {
        usecase "Handle Application Crash" as UC11
        usecase "Create Crash Report" as UC12
        usecase "Log Exception" as UC13
        usecase "Identify Mod Causing Crash" as UC14
        usecase "Write Exception to File" as UC15
    }

    package "Build-Time Code Generation" {
        usecase "Process Annotations\n(Code Generation)" as UC16
        usecase "Write Generated\nSource File" as UC17
        usecase "Query Annotated Elements" as UC18
    }

    package "Server Integration" {
        usecase "Handle Invalid\nServer Command" as UC19
    }

    package "Platform Services" {
        usecase "Apply Status Effect\nTransition" as UC20
    }

}

' ── Actor associations ──────────────────────────────────────────────────────
androidUser --> UC01
androidUser --> UC03
androidUser --> UC04

androidOS --> UC02

rhino --> UC05
rhino --> UC06
rhino --> UC07

buildSystem --> UC16

serverAdmin --> UC19

crashSystem --> UC11
crashSystem --> UC20

' ── Include / Extend relationships ─────────────────────────────────────────

' Crash handling flow
UC11 .> UC12 : <<include>>
UC11 .> UC14 : <<include>>
UC11 .> UC15 : <<include>>
UC13 .> UC11 : <<extend>>

' DEX class-loading hierarchy
UC06 .> UC08 : <<include>>
UC06 .> UC09 : <<include>>
UC08 .> UC10 : <<include>>
UC09 .> UC10 : <<include>>

' Annotation processing flow
UC16 .> UC17 : <<include>>
UC16 .> UC18 : <<include>>

@enduml
