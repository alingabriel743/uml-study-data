@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #343A40
    FontColor #212529
}
skinparam ArrowColor #495057
skinparam ArrowFontColor #6C757D

left to right direction

title Player Core Gameplay Actions

actor "Player" as player
actor "Game System\n(Control / GameState)" as gamesystem
actor "Server\n(netServer / admins)" as server

rectangle "Mindustry Gameplay" {

    package "Building & Construction" {
        usecase "Place Block" as UC01
        usecase "Use Schematic" as UC02
        usecase "Demolish Structure" as UC03
        usecase "Rotate Block" as UC14
        usecase "Rebuild / Repair Derelict" as UC21
    }

    package "Resource Management" {
        usecase "Mine Resources" as UC04
        usecase "Transfer Items to Building" as UC05
        usecase "Withdraw Items from Building" as UC06
        usecase "Drop Item (Floor)" as UC22
    }

    package "Combat & Unit Control" {
        usecase "Shoot / Attack" as UC07
        usecase "Control Unit (Possess)" as UC08
        usecase "Enter / Control Building" as UC09
        usecase "Command Units (RTS)" as UC10
        usecase "Set Unit Command / Stance" as UC11
        usecase "Command Building" as UC12
    }

    package "Payload Operations" {
        usecase "Pick Up Payload" as UC16
        usecase "Drop Payload" as UC17
    }

    package "Block Interaction" {
        usecase "Configure Block" as UC13
        usecase "Interact with Building (Tap)" as UC15
    }

    package "Game Management" {
        usecase "Respawn" as UC18
        usecase "Ping Location" as UC19
        usecase "Pause / Resume Game" as UC20
    }
}

' ── Player initiates all core actions ────────────────────────────────────────
player --> UC01
player --> UC02
player --> UC03
player --> UC04
player --> UC05
player --> UC06
player --> UC07
player --> UC08
player --> UC09
player --> UC10
player --> UC11
player --> UC12
player --> UC13
player --> UC14
player --> UC15
player --> UC16
player --> UC17
player --> UC18
player --> UC19
player --> UC20
player --> UC21
player --> UC22

' ── Game System orchestrates state transitions ────────────────────────────────
gamesystem --> UC20

' ── Server validates networked / remote-call actions ─────────────────────────
server --> UC01 : <<validates>>
server --> UC03 : <<validates>>
server --> UC05 : <<validates>>
server --> UC06 : <<validates>>
server --> UC08 : <<validates>>
server --> UC09 : <<validates>>
server --> UC10 : <<validates>>
server --> UC13 : <<validates>>
server --> UC14 : <<validates>>
server --> UC18 : <<validates>>
server --> UC19 : <<validates>>

' ── Use-case relationships ────────────────────────────────────────────────────
' Using schematic bulk-places blocks via the same plan mechanism
UC02 .> UC01 : <<include>>
' Rebuilding derelicts reuses the build-plan path
UC21 .> UC01 : <<include>>
' RTS command can extend with explicit stance/order
UC10 .> UC11 : <<extend>>
' Tapping a configurable block shows its config UI
UC15 .> UC13 : <<extend>>

@enduml
