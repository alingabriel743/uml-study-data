@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Resource Distribution & Logistics

left to right direction

actor "Player" as player
actor "Adjacent Building" as adjBuilding
actor "Team" as team
actor "Power System" as powerSystem

rectangle "Resource Distribution & Logistics" {

    package "Router" {
        usecase "Accept Item from\nAdjacent Building" as UC1
        usecase "Route Item Round-Robin\nto Neighbors" as UC2
        usecase "Aim Routing Direction\nManually" as UC3
        usecase "Block Item Input\n(Capacity / Team Check)" as UC4
        usecase "Reject Overflow\nfrom Input Tile" as UC5
    }

    package "DuctRouter" {
        usecase "Accept Item from\nFront Edge Only" as UC6
        usecase "Sort Item by\nConfigured Type" as UC7
        usecase "Forward Sorted Item Straight;\nUnsorted Items Sideways" as UC8
        usecase "Configure Sort\nFilter Item" as UC9
        usecase "Update Minimap Color\non Configure" as UC10
        usecase "Persist Sort-Item Config\nAcross Saves" as UC17
    }

    package "StackRouter" {
        usecase "Buffer Up to\n10 Items" as UC11
        usecase "Bulk Unload Full\nStack to Target" as UC12
        usecase "Delay Unload Until\nEfficiency Timer Fires" as UC13
    }

    package "Item Buffer Utilities" {
        usecase "Accept Item into\nBuffer Slot" as UC14
        usecase "Poll Item from Buffer\nby Speed Threshold" as UC15
        usecase "Accept Item into\nPer-Direction Buffer Slot" as UC16
    }

}

' --- Actor associations ---
player --> UC3
player --> UC9

adjBuilding --> UC1
adjBuilding --> UC6
adjBuilding --> UC12

team --> UC4

powerSystem --> UC13

' --- Include / Extend relationships ---
' Router
UC2 .> UC1 : <<include>>
UC4 .> UC1 : <<extend>>
UC5 .> UC2 : <<extend>>

' DuctRouter
UC8 .> UC7 : <<include>>
UC10 .> UC9 : <<include>>
UC17 .> UC9 : <<extend>>

' StackRouter
UC12 .> UC11 : <<include>>
UC13 .> UC12 : <<extend>>

' Buffer utilities (low-level support)
UC1 .> UC14 : <<include>>
UC2 .> UC15 : <<include>>
UC6 .> UC16 : <<include>>

@enduml
