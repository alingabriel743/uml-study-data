@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

left to right direction
title UI Menus & Navigation

actor "Player\n(Desktop)" as PlayerDesktop
actor "Player\n(Mobile)" as PlayerMobile
actor "GameService\n(Achievements)" as GameService
actor "System\n(HUD Rendering)" as SystemHUD

rectangle "UI Menus & Navigation" {

    package "Main Menu" {
        usecase "Navigate Main Menu" as UC01
        usecase "Start Campaign / Join /\nCustom / Load Game" as UC01a
        usecase "Open Map Editor" as UC01b
        usecase "Access Database & Info" as UC02
        usecase "Adjust Settings" as UC03
        usecase "Manage Mods" as UC04
    }

    package "In-Game HUD" {
        usecase "Toggle / Hide HUD" as UC05
        usecase "View Core Items" as UC06
        usecase "View Wave / Game Status" as UC07
        usecase "Skip Wave" as UC08
        usecase "Pause / Resume Game" as UC09
        usecase "View Toast Notifications" as UC10
        usecase "View Minimap & Position" as UC11
        usecase "View FPS / Performance Stats" as UC12
        usecase "View Custom HUD Text" as UC13
        usecase "Display Hover Information" as UC18
    }

    package "Editor Mode" {
        usecase "Editor Block Selection" as UC14
        usecase "Search Blocks by Name" as UC14a
        usecase "Toggle Block Favorite" as UC14b
        usecase "Select Block for Placement" as UC14c
        usecase "Switch Team" as UC14d
    }

    package "System / Background" {
        usecase "Track Achievements & Stats" as UC15
        usecase "Render Bar Widget" as UC16
        usecase "Load & Display Fonts" as UC17
    }
}

' ── Player (Desktop) ──────────────────────────────────────────────────────────
PlayerDesktop --> UC01
PlayerDesktop --> UC02
PlayerDesktop --> UC03
PlayerDesktop --> UC04
PlayerDesktop --> UC05
PlayerDesktop --> UC06
PlayerDesktop --> UC07
PlayerDesktop --> UC08
PlayerDesktop --> UC09
PlayerDesktop --> UC11
PlayerDesktop --> UC12
PlayerDesktop --> UC18
PlayerDesktop --> UC14

' ── Player (Mobile) ───────────────────────────────────────────────────────────
PlayerMobile --> UC01
PlayerMobile --> UC02
PlayerMobile --> UC03
PlayerMobile --> UC04
PlayerMobile --> UC06
PlayerMobile --> UC07
PlayerMobile --> UC09
PlayerMobile --> UC10

' ── GameService ───────────────────────────────────────────────────────────────
GameService --> UC15
GameService --> UC13

' ── System (HUD Rendering) ────────────────────────────────────────────────────
SystemHUD --> UC16
SystemHUD --> UC17

' ── Include / Extend relationships ────────────────────────────────────────────
UC01 ..> UC01a : <<include>>
UC01 ..> UC01b : <<include>>

UC07 ..> UC16 : <<include>>
UC08 ..> UC07 : <<extend>>

UC14 ..> UC14a : <<include>>
UC14 ..> UC14b : <<include>>
UC14 ..> UC14c : <<include>>
UC14 ..> UC14d : <<include>>

UC10 ..> UC15 : <<extend>>

@enduml
