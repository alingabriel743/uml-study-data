@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Unit Control & Combat

left to right direction

actor "Player" as player
actor "AI Controller" as ai
actor "Remote Player" as remote

rectangle "Unit Control & Combat" {
    usecase "Select Units" as UC1
    note right of UC1 : tap / drag-rect / double-tap\nto select units in commandMode

    usecase "Issue Move Command" as UC2
    usecase "Issue Attack Command" as UC3
    usecase "Set Unit Command Mode" as UC4
    note right of UC4 : move / attack / mine …\nvalidated via UnitType.allowCommand()

    usecase "Set Unit Stance" as UC5
    note right of UC5 : stop clears all commands;\nincompatible stances auto-cleared

    usecase "Directly Control Unit" as UC6
    note right of UC6 : PlayerComp: aim, shoot,\nboost — @SyncLocal fields

    usecase "Command Unit Formation" as UC10
    note right of UC10 : groups by collision layer;\nposition offsets via calculateFormation()

    usecase "Queue / Chain Commands" as UC11
    note right of UC11 : appends to commandQueue\n(max 50); disables formation

    usecase "Auto-Target & Fire Weapons" as UC7
    note right of UC7 : retarget timer (40/90 ticks);\nlead-aim via Predict.intercept()

    usecase "Move Unit (Pathfinding)" as UC8
    note right of UC8 : flow-field pathfinding;\ncircle / orbit / arrive modes

    usecase "Take Damage" as UC9
    note right of UC9 : UnitController.hit(Bullet)\nnotification hook

    usecase "Logic / Remote Control Override" as UC12
    note right of UC12 : LogicAI extends AIController;\nplayers cannot be logic-overridden
}

' Player interactions
player --> UC1
player --> UC2
player --> UC3
player --> UC4
player --> UC5
player --> UC6
player --> UC10
player --> UC11

' AI Controller interactions
ai --> UC7
ai --> UC8
ai --> UC9
ai --> UC12

' Remote Player propagates commands over @Remote RPC
remote --> UC2
remote --> UC3
remote --> UC4
remote --> UC5

' UC11 (Queue Commands) conditionally extends Move and Attack (queue=true flag)
UC11 .> UC2 : <<extend>>
UC11 .> UC3 : <<extend>>

' UC10 (Formation) conditionally triggered from Move Command (finalBatch=true, >1 unit)
UC10 .> UC2 : <<extend>>

' UC12 (Logic override) conditionally overrides AI autonomous behaviour
UC12 .> UC7 : <<extend>>
UC12 .> UC8 : <<extend>>

@enduml
