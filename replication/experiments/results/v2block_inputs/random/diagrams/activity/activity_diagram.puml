@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activityBackgroundColor #F8F9FA
skinparam activityBorderColor #495057
skinparam arrowColor #495057
skinparam activityFontColor #212529
skinparam partitionBackgroundColor #E9ECEF
skinparam partitionBorderColor #6C757D

title Mindustry Building Tile Update Cycle\n(HeatCrafterBuild & PointDefenseBuild)

|#DDEEFF|Game Engine|
start
:Trigger per-tick updateTile()\nfor all active building tiles;

fork
    note right: Heat-based production path
    :Dispatch to HeatCrafter buildings;

    |#FFF3CD|HeatCrafterBuild|
    :Collect sideHeat[4] values\nfrom adjacent HeatProducer tiles;
    :Accumulate total heat input;

    |#E8DAEF|HeatConsumer Interface|
    :Query heatRequirement();

    |#FFF3CD|HeatCrafterBuild|
    if (heat >= heatRequirement?) then (yes)
        :Calculate efficiencyScale()\n= heat / heatRequirement;
        :Determine warmupTarget()\nbased on available heat;

        if (shouldConsume()?\n[all input resources available]) then (yes)
            |#D5F5E3|GenericCrafterBuild|
            :Compute progress increment\n(efficiencyScale × baseRate × delta);
            :Add increment to\ncurrent progress;

            if (progress >= 1.0?) then (complete)
                :Consume input resources\nand/or liquids;
                :Produce output resources\nand/or liquids to neighbors;
                :Reset progress to 0;
                :Trigger craft visual effect;
            else (still in progress)
                :Store accumulated\nprogress for next tick;
            endif
        else (no — inputs depleted)
            |#FFF3CD|HeatCrafterBuild|
            :Mark as not consuming;
            :Stall crafting progress;
        endif
    else (no — insufficient heat)
        :Set efficiencyScale = 0;
        :Decay warmup towards 0;
    endif

    :Update heat warmup\ntowards warmupTarget;
    :Persist updated sideHeat[] state;

fork again
    note right: Point defense turret path
    :Dispatch to PointDefense turrets;

    |#FADBD8|PointDefenseBuild|
    if (shouldConsume()?\n[powered & team active]) then (yes)
        :Scan bullet entities\nwithin turret range;

        if (enemy bullet found?) then (yes)
            :Select nearest/highest-priority\ntarget bullet;
            :Lock target reference;

            if (reload timer expired?) then (yes)
                :Fire point-defense\nlaser beam at target;
                :Apply damage to\nor destroy target bullet;
                :Reset reload timer;
                :Play hit effect\nat bullet position;
            else (reloading)
                :Decrement reload timer\nby delta time;
            endif

            :Draw laser beam\nfrom turret to target;
        else (no target)
            :Clear stale target reference;
            :Remain idle this tick;
        endif
    else (no — disabled or no power)
        :Skip targeting logic;
        :Turret stays inactive;
    endif

end fork

|#DDEEFF|Game Engine|
:Persist tile state changes\nand schedule next tick;
stop

@enduml
