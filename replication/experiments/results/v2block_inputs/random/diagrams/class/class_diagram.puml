@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Class Diagram

' ─── Referenced base types (stubs) ───────────────────────────────────────────
abstract class Turret
abstract class BaseTurretBuild
abstract class GenericCrafterBuild
abstract class Building
abstract class BasicBulletType
abstract class PlanetMesh
abstract class Tile
abstract class BaseDialog
abstract class LStatement
abstract class Consume

interface Entityc
interface HeatBlock
interface LInstruction
interface Drawc
interface Posc
interface Rotc
interface Timedc
interface Unitc
interface Boxed
interface Unit

' ─── Defense Turrets ─────────────────────────────────────────────────────────
package "mindustry.world.blocks.defense.turrets" {

    class PayloadAmmoTurret {
        +ObjectMap<UnlockableContent, BulletType> ammoTypes
        #UnlockableContent[] ammoKeys
        --
        +PayloadAmmoTurret(String name)
        +ammo(Object... objects)
        +limitRange()
        +limitRange(float margin)
        +setStats()
        +init()
    }

    class TractorBeamBuild {
        +Unit target
        +float lastX, lastY, strength
        +boolean any
        +float coolantMultiplier
        --
        +updateTile()
        +shouldConsume()
        +estimateDps()
        +draw()
        +write(Writes write)
        +read(Reads read, byte revision)
    }
}

' ─── Defense (general) ───────────────────────────────────────────────────────
package "mindustry.world.blocks.defense" {

    class DirectionalForceProjectorBuild {
        +boolean broken
        +float buildup, hit, warmup, shieldRadius
        --
        +shouldAmbientSound()
        +pickedUp()
        +updateTile()
        +deflectBullets()
        +draw()
        +drawShield()
    }
}

' ─── Heat blocks ─────────────────────────────────────────────────────────────
package "mindustry.world.blocks.heat" {

    class HeatProducerBuild {
        +float heat
        --
        +updateTile()
        +heatFrac()
        +heat()
        +write(Writes write)
        +read(Reads read, byte revision)
    }
}

' ─── World consumers ─────────────────────────────────────────────────────────
package "mindustry.world.consumers" {

    class ConsumePayloads {
        +Seq<PayloadStack> payloads
        --
        +ConsumePayloads(Seq<PayloadStack> payloads)
        +efficiency(Building build)
        +trigger(Building build)
        +display(Stats stats)
        +build(Building build, Table table)
    }
}

' ─── World (misc) ────────────────────────────────────────────────────────────
package "mindustry.world" {

    class CachedTile {
        --
        +CachedTile()
        +preChanged()
        +changeBuild(Team team, Prov<Building> entityprov, int rotation)
    }

    class ItemBuffer {
        -long[] buffer
        -int index
        --
        +ItemBuffer(int capacity)
        +accepts()
        +accept(Item item, short data)
        +accept(Item item)
        +poll(float speed)
        +remove()
        +write(Writes write)
        +read(Reads read)
    }
}

' ─── Game events ─────────────────────────────────────────────────────────────
package "mindustry.game" {

    class UnitCreateEvent {
        +final Unit unit
        +final Building spawner
        +final Unit spawnerUnit
        --
        +UnitCreateEvent(Unit unit, Building spawner, Unit spawnerUnit)
        +UnitCreateEvent(Unit unit, Building spawner)
    }

    class BlockBuildEndEvent {
        +final Tile tile
        +final Team team
        +final Unit unit
        +final boolean breaking
        +final Object config
        --
        +BlockBuildEndEvent(Tile tile, Unit unit, Team team, boolean breaking, Object config)
    }

    class WinEvent {
    }

    class ClientCreateEvent {
    }
}

' ─── Entity components ───────────────────────────────────────────────────────
package "mindustry.entities.comp" {

    class SyncComp {
        +transient long lastUpdated, updateSpacing
        --
        +snapSync()
        +snapInterpolation()
        +readSync(Reads read)
        +writeSync(Writes write)
        +readSyncManual(FloatBuffer buffer)
        +writeSyncManual(FloatBuffer buffer)
        +afterSync()
        +interpolate()
        +isSyncHidden(Player player)
        +handleSyncHidden()
        +update()
        +remove()
    }

    class DecalComp {
        +float x, y, rotation
        +Color color
        +TextureRegion region
        --
        +draw()
        +clipSize()
    }

    class UnitTetherComp {
        +UnitType type
        +Team team
        +transient Unit spawner
        +int spawnerUnitId
        --
        +afterRead()
        +afterSync()
        +update()
    }
}

' ─── Entity bullets ──────────────────────────────────────────────────────────
package "mindustry.entities.bullet" {

    class InterceptorBulletType {
        --
        +InterceptorBulletType(float speed, float damage)
        +InterceptorBulletType()
        +InterceptorBulletType(float speed, float damage, String bulletSprite)
        +update(Bullet b)
    }
}

' ─── Entities (misc) ─────────────────────────────────────────────────────────
package "mindustry.entities" {

    class UnitSyncContainer {
        +Unit unit
        --
        +UnitSyncContainer()
        +UnitSyncContainer(Unit unit)
    }
}

' ─── IO ──────────────────────────────────────────────────────────────────────
package "mindustry.io" {

    class UnitBox {
        +int id
        --
        +UnitBox(int id)
        +unbox()
        +toString()
    }
}

' ─── Logic ───────────────────────────────────────────────────────────────────
package "mindustry.logic" {

    class DrawFlushI {
        +LVar target
        --
        +DrawFlushI(LVar target)
        +DrawFlushI()
        +run(LExecutor exec)
    }

    class ReadStatement {
        +String output
        +String target
        +String address
        --
        +build(Table table)
        +build(LAssembler builder)
        +category()
    }
}

' ─── UI ──────────────────────────────────────────────────────────────────────
package "mindustry.ui" {

    class Styles {
        +static Drawable black, black9, none, flatDown
        +static ButtonStyle defaultb
        +static TextButtonStyle defaultt, flatt, grayt
        +static ImageButtonStyle defaulti, nodei, emptyi
        +static ScrollPaneStyle defaultPane
        +static SliderStyle defaultSlider
        +static LabelStyle defaultLabel
        +static TextFieldStyle defaultField
        +static CheckBoxStyle defaultCheck
        +static DialogStyle defaultDialog
        +static TreeStyle defaultTree
        --
        +load()
        +createFlatDown()
    }
}

package "mindustry.ui.dialogs" {

    class MapListDialog {
        -BaseDialog activeDialog
        -String searchString
        -Seq<Gamemode> modes
        -Seq<String> availablePlanets
        -Table mapTable
        -TextField searchField
        -boolean showBuiltIn, showCustom, displayType
        -Seq<String> planets
        --
        +MapListDialog(String title, boolean displayType)
        +buildButtons()
        +showMap(Map map)
        +setup()
        +rebuildMaps()
        +showMapFilters()
        +show()
    }
}

' ─── Graphics ────────────────────────────────────────────────────────────────
package "mindustry.graphics" {

    class InverseKinematics {
        -static Vec2[] mat1, mat2
        -static Vec2 temp, temp2, at1
        --
        +solve(float lengthA, float lengthB, Vec2 end, boolean side, Vec2 result)
        +solve(float lengthA, float lengthB, Vec2 end, Vec2 attractor, Vec2 result)
    }
}

package "mindustry.graphics.g3d" {

    class HexMesh {
        --
        +HexMesh(Planet planet, int divisions)
        +HexMesh(Planet planet, HexMesher mesher, int divisions, Shader shader)
        +HexMesh()
        +preRender(PlanetParams params)
    }
}

' ─── AI ──────────────────────────────────────────────────────────────────────
package "mindustry.ai" {

    class PathfindQueue {
        -static double CAPACITY_RATIO_LOW
        -static double CAPACITY_RATIO_HI
        +int[] queue
        +float[] weights
        +int size
        --
        +PathfindQueue()
        +PathfindQueue(int initialCapacity)
        +empty()
        +add(int e, float weight)
        +peek()
        +clear()
        +poll()
    }
}

' ─── Tools ───────────────────────────────────────────────────────────────────
package "mindustry.tools" {

    class ImageTileGenerator {
        -static final int layoutWidth
        -static final int layoutHeight
        -static final Pixmap layout
        --
        +generate(Fi path, String name, Fi outputDir)
    }
}

' ─── Annotations ─────────────────────────────────────────────────────────────
package "mindustry.annotations.util" {

    class ClassSerializer {
        +final ObjectMap<String, String> writers
        +final ObjectMap<String, String> readers
        +final ObjectMap<String, String> mutatorReaders
        +final ObjectMap<String, String> netWriters
        +final ObjectMap<String, String> netReaders
        --
        +ClassSerializer(ObjectMap writers, ObjectMap readers, ...)
        +getNetWriter(String type, String fallback)
        +getNetReader(String type, String fallback)
    }
}

' ─── Inheritance & implementation relationships ───────────────────────────────

' Extends (inheritance)
PayloadAmmoTurret         --|> Turret
TractorBeamBuild          --|> BaseTurretBuild
DirectionalForceProjectorBuild --|> Building
HeatProducerBuild         --|> GenericCrafterBuild
ConsumePayloads           --|> Consume
CachedTile                --|> Tile
MapListDialog             --|> BaseDialog
ReadStatement             --|> LStatement
InterceptorBulletType     --|> BasicBulletType
HexMesh                   --|> PlanetMesh

' Implements (interface realizations)
SyncComp          ..|> Entityc
DecalComp         ..|> Drawc
DecalComp         ..|> Posc
DecalComp         ..|> Rotc
DecalComp         ..|> Timedc
UnitTetherComp    ..|> Unitc
UnitBox           ..|> Boxed
UnitBox           ..|> Unit
DrawFlushI        ..|> LInstruction
HeatProducerBuild ..|> HeatBlock

@enduml
