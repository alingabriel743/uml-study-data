@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Mindustry — Use Case Diagram

left to right direction

' ─────────────────────────────────────────
' Actors
' ─────────────────────────────────────────
actor "Player"          as Player
actor "Server Host"     as Host
actor "Steam Platform"  as Steam
actor "Discord"         as Discord

Host --|> Player

' ─────────────────────────────────────────
' System Boundary
' ─────────────────────────────────────────
rectangle "Mindustry Game" {

    ' ── Gameplay ──────────────────────────
    package "Gameplay" {
        usecase "Launch Game"                as UC_Launch
        usecase "Place Structure"            as UC_Place
        usecase "Remove Structure"           as UC_Remove
        usecase "Validate Placement"         as UC_Validate
        usecase "Spawn Unit"                 as UC_Spawn
        usecase "Complete Sector Objective"  as UC_Sector
    }

    ' ── Logic Programming ─────────────────
    package "Logic Programming" {
        usecase "Write Logic Script"         as UC_Script
        usecase "Manage Global Variables"    as UC_Globals
    }

    ' ── Multiplayer ───────────────────────
    package "Multiplayer" {
        usecase "Host Multiplayer Session"   as UC_Host
        usecase "Join Multiplayer Session"   as UC_Join
        usecase "Load / Save World"          as UC_World
        usecase "Send Chat Message"          as UC_Chat
    }

    ' ── Workshop & Social ─────────────────
    package "Workshop & Social" {
        usecase "Open Workshop"              as UC_Workshop
        usecase "Publish Content"            as UC_Publish
        usecase "View Workshop Listing"      as UC_Listing
        usecase "Get Workshop Content"       as UC_GetContent
        usecase "Invite Friends"             as UC_Invite
        usecase "Apply Mod / Data Patch"     as UC_Patch
    }

    ' ── External Integrations ─────────────
    package "External Integrations" {
        usecase "Update Discord Rich Presence" as UC_Discord
        usecase "Authenticate via Steam"       as UC_SteamAuth
    }
}

' ─────────────────────────────────────────
' Actor → Use Case relationships
' ─────────────────────────────────────────

' Player core actions
Player --> UC_Launch
Player --> UC_Place
Player --> UC_Remove
Player --> UC_Spawn
Player --> UC_Sector
Player --> UC_Script
Player --> UC_Globals
Player --> UC_Join
Player --> UC_Chat
Player --> UC_Workshop
Player --> UC_Listing
Player --> UC_GetContent
Player --> UC_Patch

' Host-specific actions
Host --> UC_Host
Host --> UC_World

' Steam integration
Player --> UC_SteamAuth
Player --> UC_Publish
Player --> UC_Invite
Steam  --> UC_SteamAuth
Steam  --> UC_Workshop
Steam  --> UC_Publish
Steam  --> UC_Invite

' Discord integration
Discord --> UC_Discord
Player  --> UC_Discord

' ─────────────────────────────────────────
' Include / Extend relationships
' ─────────────────────────────────────────
UC_Place   ..> UC_Validate  : <<include>>
UC_Host    ..> UC_World     : <<include>>
UC_Join    ..> UC_World     : <<include>>
UC_Publish ..> UC_Workshop  : <<include>>
UC_Listing ..> UC_Workshop  : <<extend>>

@enduml
