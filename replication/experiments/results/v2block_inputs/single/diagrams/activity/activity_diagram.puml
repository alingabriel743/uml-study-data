@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
    StartColor #495057
    EndColor #495057
}
skinparam swimlane {
    TitleBackgroundColor #E9ECEF
    TitleBorderColor #6C757D
    TitleFontColor #212529
    BorderColor #6C757D
}
skinparam note {
    BackgroundColor #FFF9C4
    BorderColor #F0AD00
    FontColor #212529
}

title Mindustry — Unit AI & Logic Script Update Cycle

|Game Engine|
start
:GameService.init();
:GameService.registerEvents();
note right
  Registers game event listeners,
  initializes achievement tracking,
  sets up transport/block arrays
end note

repeat

  |Game Engine|
  :GameService.checkUpdate();

  |Unit System|
  :Iterate all active units;

  |AIController|
  :afterRead(unit) — restore saved state;
  :resetTimers();
  :updateUnit();

  if (isLogicControllable()?) then (yes)

    |LExecutor|
    if (initialized()?) then (no)
      :load(LAssembler);
      :Initialize LVar[] and LInstruction[];
    endif

    :runOnce() — execute one logic tick;

    if (yield flag set?) then (yes)
      :Suspend execution this tick;
    else (no)
      if (unit timeout?) then (yes)
        :updateTimeout(unit);
        :Skip remaining instructions;
      else (no)
        :Execute all LInstructions;
        :syncVariable() on linked buildings;
        :setFlag() / createMarker() as needed;
      endif
    endif

  else (no)

    |AIController|
    :updateTargeting();
    :retarget() — check timer intervals;
    :findTarget(x, y, range, air, ground);

    if (valid target found?) then (yes)

      :checkTarget(target, x, y, range);

      fork
        :updateMovement();
        if (pathfinding needed?) then (yes)
          :pathfind(pathTarget, stopAtTargetTile);
          :alterPathfind(vec) — apply avoidance;
        else (no)
          :moveTo(target, circleLength, smooth);
        endif
      fork again
        :updateWeapons();
        if (shouldShoot()?) then (yes)
          :faceTarget();
          :Fire at target;
        else (no)
          :stopShooting();
        endif
      end fork

    else (no)

      :faceMovement();
      :getClosestSpawner();
      :pathfind to patrol / spawn point;
      :Increment noTargetTime;

    endif

    :updateVisuals();

  endif

  |GameService|
  :trigger(event, achievement);
  if (achievement condition met?) then (yes)
    :completeAchievement(name);
    :setStat(name, amount);
    :storeStats();
  endif
  note right
    Checks built blocks, units,
    T5 unit tracking, map coverage
  end note

repeat while (game running?) is (yes)

|GameService|
:save();
stop

@enduml
