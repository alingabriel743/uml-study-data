package "mindustry.core" {

    class ClientLauncher {
        -{static} loadingFPS: int
        -nextFrame: long
        -beginTime: long
        -lastTargetFps: long
        -finished: boolean
        -loader: LoadRenderer
        +setup(): void
        +add(module: ApplicationListener): void
        +resize(width: int, height: int): void
        +update(): void
        +exit(): void
        +init(): void
        +resume(): void
        +pause(): void
        +fileDropped(file: Fi): void
    }

    class Vars {
        +{static} failedToLaunch: boolean
        +{static} loadLocales: boolean
        +{static} loadedLogger: boolean
        +{static} steamPlayerName: String
        +{static} minModGameVersion: int
        +{static} minJavaModGameVersion: int
        +{static} showSectorSubmissions: boolean
        +{static} forceBeServers: boolean
        +{static} skipModCode: boolean
        +{static} loadAsync(): void
        +{static} init(): void
        +{static} checkLaunch(): void
        +{static} finishLaunch(): void
        +{static} loadLogger(): void
        +{static} loadSettings(): void
    }
}

' ─────────────────────────────────────────
'  External stubs (referenced only)
' ─────────────────────────────────────────
class AndroidApplication <<external>>
class ContextFactory <<external>>
class ClassLoader <<external>>
class AbstractProcessor <<external>>
class ApplicationCore <<external>>

interface GeneratedClassLoader <<external>>
interface Platform <<external>>
interface Loadable <<external>>
interface Visitor <<external>>

' ─────────────────────────────────────────
'  Inheritance & Implementation
' ─────────────────────────────────────────

' Android hierarchy
AndroidLauncher       --|> AndroidApplication
AndroidContextFactory --|> ContextFactory
BaseAndroidClassLoader --|> ClassLoader
BaseAndroidClassLoader ..|> GeneratedClassLoader
FileAndroidClassLoader --|> BaseAndroidClassLoader
InMemoryAndroidClassLoader --|> BaseAndroidClassLoader

' Annotations — processor hierarchy
BaseProcessor         --|> AbstractProcessor
EntityProcess         --|> BaseProcessor
AssetsProcess         --|> BaseProcessor
StructProcess         --|> BaseProcessor
LoadRegionProcessor   --|> BaseProcessor
LogicStatementProcessor --|> BaseProcessor
RemoteProcess         --|> BaseProcessor

' Annotations — util hierarchy
Smethod               --|> Selement
Stype                 --|> Selement
Svar                  --|> Selement

' Visitor implementation
ValueVisitor          ..|> Visitor

' Core hierarchy
ClientLauncher        --|> ApplicationCore
ClientLauncher        ..|> Platform
Vars                  ..|> Loadable

' ─────────────────────────────────────────
'  Key Associations
' ─────────────────────────────────────────
EntityIO       *-- Revision          : contains >
EntityIO       *-- ClassSerializer   : uses >
Revision       *-- RevisionField     : contains >

EntityProcess  *-- EntityDefinition  : produces >
EntityProcess  *-- GroupDefinition   : produces >

EntityDefinition *-- GroupDefinition : references >

CallGenerator  ..> MethodEntry       : generates from >
CallGenerator  ..> ClassSerializer   : uses >
RemoteProcess  ..> CallGenerator     : delegates >
MethodEntry    ..> Loc               : uses >
MethodEntry    ..> Variant           : uses >
MethodEntry    ..> PacketPriority    : uses >

TypeIOResolver ..> ClassSerializer   : creates >
BaseProcessor  ..> TypeIOResolver    : uses >

@enduml
