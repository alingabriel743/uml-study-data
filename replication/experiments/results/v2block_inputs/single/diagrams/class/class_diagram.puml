@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Class Diagram

' ─────────────────────────────────────────
'  Android
' ─────────────────────────────────────────
package "mindustry.android" {

    class AndroidLauncher {
        +{static} PERMISSION_REQUEST_CODE: int
        -doubleScaleTablets: boolean
        -chooser: FileChooser
        -permCallback: Runnable
        +onCreate(savedInstanceState: Bundle): void
        +onRequestPermissionsResult(requestCode: int, ...): void
        +checkFiles(intent: Intent): void
        +{static} isTablet(context: Context): boolean
    }

    class AndroidRhinoContext {
        +{static} enter(cacheDirectory: File): Context
    }

    class AndroidContextFactory {
        -cacheDirectory: File
        +AndroidContextFactory(cacheDirectory: File)
        +createClassLoader(parent: ClassLoader): ClassLoader
        +onContextReleased(cx: Context): void
    }

    class BaseAndroidClassLoader {
        +BaseAndroidClassLoader(parent: ClassLoader)
        +defineClass(name: String, data: byte[]): Class<?>
        +loadClass(dex: Dex, name: String): Class<?>
        +getLastDex(): Dex
        +reset(): void
        +linkClass(aClass: Class<?>): void
        +loadClass(name: String, resolve: boolean): Class<?>
    }

    class FileAndroidClassLoader {
        -{static} instanceCounter: int
        -dexFile: File
        +FileAndroidClassLoader(parent: ClassLoader, cacheDir: File)
        +loadClass(dex: Dex, name: String): Class<?>
        +getLastDex(): Dex
        +reset(): void
    }

    class InMemoryAndroidClassLoader {
        -last: Dex
        +InMemoryAndroidClassLoader(parent: ClassLoader)
        +loadClass(dex: Dex, name: String): Class<?>
        +getLastDex(): Dex
        +reset(): void
    }
}

' ─────────────────────────────────────────
'  Annotations — core
' ─────────────────────────────────────────
package "mindustry.annotations" {

    class Annotations {
    }

    enum PacketPriority {
        low
        normal
        high
    }

    enum Loc {
        server
        client
        both
        none
    }

    enum Variant {
        one
        all
        both
    }

    class BaseProcessor {
        +{static} packageName: String
        +{static} typeu: Types
        +{static} elementu: Elements
        +{static} filer: Filer
        +{static} messager: Messager
        +{static} trees: Trees
        #round: int
        #rounds: int
        #env: RoundEnvironment
        #rootDirectory: Fi
        +getMethodName(element: Element): String
        +isPrimitive(type: String): boolean
        +instanceOf(type: String, other: String): boolean
        +getDefault(value: String): String
        +typeSize(kind: String): int
        +simpleName(str: String): String
        +write(builder: TypeSpec.Builder): void
        +elements(type: Class<? extends Annotation>): Seq<?>
        +types(type: Class<? extends Annotation>): Seq<?>
        +fields(type: Class<? extends Annotation>): Seq<?>
    }
}

' ─────────────────────────────────────────
'  Annotations — entity
' ─────────────────────────────────────────
package "mindustry.annotations.entity" {

    class EntityIO {
        -{static} json: Json
        -{static} targetSuf: String
        -{static} lastSuf: String
        -serializer: ClassSerializer
        -name: String
        -type: TypeSpec.Builder
        -directory: Fi
        -revisions: Seq<Revision>
        -write: boolean
        -method: MethodSpec.Builder
        -presentFields: ObjectSet<String>
        +EntityIO(name, type, typeFields, serializer, directory)
        +write(method, write, allFields): void
        +writeSync(method, write, allFields): void
        +writeInterpolate(method, fields): void
        +io(type, field, network): void
    }

    class Revision {
        ~version: int
        ~fields: Seq<RevisionField>
        +Revision(version: int, fields: Seq<RevisionField>)
        +equal(specs: Seq<FieldSpec>): boolean
    }

    class RevisionField {
        ~name: String
        ~type: String
        +RevisionField(name: String, type: String)
    }

    class EntityProcess {
        -definitions: Seq<EntityDefinition>
        -groupDefs: Seq<GroupDefinition>
        -baseComponents: Seq<Stype>
        -componentNames: ObjectMap<String, Stype>
        -componentDependencies: ObjectMap<Stype, Seq<Stype>>
        -varInitializers: ObjectMap<String, String>
        -methodBlocks: ObjectMap<String, String>
        -imports: ObjectSet<String>
        -allGroups: Seq<Selement>
        -allDefs: Seq<Selement>
        +process(env: RoundEnvironment): void
        +interfaceName(comp: Stype): String
        +allComponents(type: Selement<?>): Seq<Stype>
        +getDependencies(component: Stype): Seq<Stype>
        +isCompInterface(type: Stype): boolean
        +createName(elem: Selement<?>): String
    }

    class GroupDefinition {
        +name: String
        +baseType: ClassName
        +components: Seq<Stype>
        +spatial: boolean
        +mapping: boolean
        +collides: boolean
        +manualInclusions: ObjectSet<Selement>
        +GroupDefinition(name, bestType, components, spatial, mapping, collides)
        +toString(): String
    }

    class EntityDefinition {
        +groups: Seq<GroupDefinition>
        +components: Seq<Stype>
        +fieldSpecs: Seq<FieldSpec>
        +builder: TypeSpec.Builder
        +naming: Selement
        +name: String
        +extend: TypeName
        +legacy: boolean
        +classID: int
        +EntityDefinition(name, builder, naming, extend, components, groups, fieldSpec, legacy)
        +toString(): String
    }
}

' ─────────────────────────────────────────
'  Annotations — impl
' ─────────────────────────────────────────
package "mindustry.annotations.impl" {

    class AssetsProcess {
        +process(env: RoundEnvironment): void
        +processUI(elements: Set<?>): void
        +processSounds(classname, path, rtype, genid): void
        +capitalize(s: String): String
    }

    class StructProcess {
        +process(env: RoundEnvironment): void
        +bitString(offset, size, totalSize): String
        +varSize(var: Svar): int
        +typeForSize(size: int): String
        +typeSize(kind: TypeKind): int
    }
}

' ─────────────────────────────────────────
'  Annotations — misc
' ─────────────────────────────────────────
package "mindustry.annotations.misc" {

    class LoadRegionProcessor {
        +process(env: RoundEnvironment): void
        +count(str: String, substring: String): int
        +parse(value: String): String
    }

    class LogicStatementProcessor {
        +process(env: RoundEnvironment): void
    }
}

' ─────────────────────────────────────────
'  Annotations — remote
' ─────────────────────────────────────────
package "mindustry.annotations.remote" {

    class CallGenerator {
        +generate(serializer: ClassSerializer, methods: Seq<MethodEntry>): void
        +makeWriter(typespec, ent, serializer): void
        +makeReader(typespec, ent, serializer): void
        +writeCallMethod(classBuilder, ent, toAll, forwarded): void
        +getCheckString(loc: Loc): String
        +writeHandleMethod(ent, isClient): void
    }

    class MethodEntry {
        +className: String
        +targetMethod: String
        +packetClassName: String
        +where: Loc
        +target: Variant
        +local: Loc
        +unreliable: boolean
        +forward: boolean
        +id: int
        +element: Smethod
        +priority: PacketPriority
        +MethodEntry(className, targetMethod, packetClassName, where, target, local, unreliable, forward)
        +hashCode(): int
    }

    class RemoteProcess {
        +{static} callLocation: String
        +process(roundEnv: RoundEnvironment): void
    }

    class SerializerResolver {
        +locate(elem: ExecutableElement, mirror: TypeMirror, write: boolean): String
        +isEntity(mirror: TypeMirror): boolean
    }
}

' ─────────────────────────────────────────
'  Annotations — util
' ─────────────────────────────────────────
package "mindustry.annotations.util" {

    class Selement<T> {
        +e: T
        +Selement(e: T)
        +doc(): String
        +enclosed(): Seq<?>
        +fullName(): String
        +asType(): Stype
        +asVar(): Svar
        +asMethod(): Smethod
        +isVar(): boolean
        +isType(): boolean
        +isMethod(): boolean
        +annotations(): Seq<?>
        +annotation(annotation: Class<A>): A
        +has(annotation: Class<A>): boolean
        +mirror(): TypeMirror
    }

    class Smethod {
        +Smethod(executableElement: ExecutableElement)
        +isAny(mod: Modifier...): boolean
        +is(mod: Modifier): boolean
        +type(): TypeMirror
        +params(): Seq<Svar>
        +isVoid(): boolean
        +ret(): TypeMirror
        +simpleString(): String
        +descString(): String
    }

    class Stype {
        +Stype(typeElement: TypeElement)
        +{static} of(mirror: TypeMirror): Stype
        +fullName(): String
        +interfaces(): Seq<Stype>
        +allInterfaces(): Seq<Stype>
        +isInterface(): boolean
        +superclasses(): Seq<Stype>
        +allSuperclasses(): Seq<Stype>
        +superclass(): Stype
        +fields(): Seq<Svar>
        +methods(): Seq<Smethod>
        +constructors(): Seq<Smethod>
        +mirror(): TypeMirror
    }

    class Svar {
        +Svar(e: VariableElement)
        +descString(): String
        +enclosingType(): Stype
        +isAny(mods: Modifier...): boolean
        +is(mod: Modifier): boolean
        +tree(): JCTree.JCVariableDecl
    }

    class AnnotationProxyMaker {
        -anno: Compound
        -annoType: Class<? extends Annotation>
        +AnnotationProxyMaker(var1: Compound, var2: Class<? extends Annotation>)
        +{static} generateAnnotation(var0: Compound, var1: Class<A>): A
        +generateAnnotation(): Annotation
        +getAllReflectedValues(): Map<?, ?>
        +getAllValues(): Map<?, ?>
        +generateValue(var1: MethodSymbol, var2: Attribute): Object
        +mirrorProxy(t: Type): Object
        +proxify(prov: Prov<T>): T
    }

    class ValueVisitor {
        -meth: MethodSymbol
        -returnClass: Class<?>
        -value: Object
        +ValueVisitor(var2: MethodSymbol)
        +getValue(var1: Attribute): Object
        +visitConstant(var1: Constant): void
        +visitClass(var1: Class): void
        +visitArray(var1: Array): void
        +visitEnum(var1: Enum): void
        +visitCompound(var1: Compound): void
        +visitError(var1: Error): void
        +typeMismatch(var1: Method, var2: Attribute): void
    }

    class TypeIOResolver {
        +{static} resolve(processor: BaseProcessor): ClassSerializer
        +{static} fix(str: String): String
    }

    class ClassSerializer {
        +writers: ObjectMap<String, String>
        +readers: ObjectMap<String, String>
        +mutatorReaders: ObjectMap<String, String>
        +netWriters: ObjectMap<String, String>
        +ClassSerializer(writers, readers, mutatorReaders, netWriters)
        +getNetWriter(type: String, fallback: String): String
        +getNetReader(type: String, fallback: String): String
    }
}

