@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam sequence {
    ArrowColor #495057
    ArrowThickness 2
    LifeLineBorderColor #495057
    LifeLineBackgroundColor #DEE2E6
    ParticipantBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ParticipantFontColor #212529
    ActorBackgroundColor #F8F9FA
    ActorBorderColor #495057
}
skinparam noteBackgroundColor #FFF3CD
skinparam noteBorderColor #CCA700
skinparam noteFontColor #212529

title Mindustry — Remote RPC Code Generation & Android App Startup

== Compile-Time: Remote Method Annotation Processing ==

actor "javac Compiler" as javac
participant "RemoteProcess" as rp <<BaseProcessor>>
participant "SerializerResolver" as sr
participant "MethodEntry" as me <<DataHolder>>
participant "CallGenerator" as cg

javac -> rp : process(roundEnv)
activate rp

rp -> sr : locate(elem, mirror, write=true)
activate sr
note right of sr : Resolves the ClassSerializer\nfor each parameter type
sr --> rp : ClassSerializer
deactivate sr

loop for each @Remote annotated method
    rp -> me : new MethodEntry(\n  className, targetMethod, packetClassName,\n  where, target, local,\n  unreliable, forward, id, element, priority)
    activate me
    me --> rp : MethodEntry
    deactivate me
end

rp -> cg : generate(serializer, methods)
activate cg

cg -> cg : makeWriter(typespec, ent, serializer)
activate cg
note right : Generates a packet\nwriter class that\nserializes call params
cg --> cg : writer TypeSpec
deactivate cg

cg -> cg : makeReader(typespec, ent, serializer)
activate cg
note right : Generates a packet\nreader class that\ndeserializes incoming params
cg --> cg : reader TypeSpec
deactivate cg

cg -> cg : writeCallMethod(classBuilder, ent, toAll, forwarded)
activate cg
note right : Builds the outbound\nRPC call stub:\nchecks locality &\nqueues the packet
cg --> cg : call MethodSpec
deactivate cg

cg -> cg : writeHandleMethod(ent, isClient)
activate cg
note right : Builds the inbound\npacket dispatcher:\nreads packet &\nforwards to target
cg --> cg : handle MethodSpec
deactivate cg

cg --> rp : generated source files
deactivate cg

deactivate rp

== Compile-Time: Entity I/O Serialization Processing ==

actor "javac Compiler" as javac2 #DDE5FF
participant "EntityProcess" as ep <<BaseProcessor>>
participant "EntityIO" as eio <<Serializer>>
participant "TypeIOResolver" as tior

javac2 -> ep : process(env)
activate ep

ep -> ep : allComponents(type)
activate ep
note right : Resolves full\ncomponent list for\neach entity type
ep --> ep : Seq<Stype>
deactivate ep

ep -> ep : getDependencies(component)
activate ep
ep --> ep : Seq<Stype> deps
deactivate ep

ep -> eio : new EntityIO(\n  name, typeBuilder, typeFields,\n  serializer, directory)
activate eio

ep -> tior : locate(elem, mirror, write)
activate tior
tior --> ep : serializer method
deactivate tior

ep -> eio : writeSync(write, useMethod)
activate eio
note right : Generates sync\nread/write code\nfor entity state
eio --> ep : sync methods written
deactivate eio

ep -> eio : writeInterpolate(write)
activate eio
note right : Generates interpolation\nread/write code\nfor smooth rendering
eio --> ep : interpolate methods written
deactivate eio

deactivate eio
deactivate ep

== Runtime: Android App Startup ==

actor "Android OS" as os
participant "AndroidLauncher" as al <<AndroidApplication>>
participant "AndroidContextFactory" as acf
participant "FileAndroidClassLoader" as fcl
participant "ClientLauncher" as cl <<ApplicationCore, Platform>>

os -> al : onCreate(savedInstanceState)
activate al

al -> al : checkFiles(intent)
activate al
note right of al : Validates required\ngame asset files\nexist on device
al --> al
deactivate al

al -> acf : new AndroidContextFactory(cacheDirectory)
activate acf
acf -> fcl : new FileAndroidClassLoader(cacheDirectory)
activate fcl
note right of fcl : Loads precompiled\nDEX classes from disk\nfor script execution
fcl --> acf : classLoader
deactivate fcl
acf --> al : contextFactory ready
deactivate acf

al -> cl : init()
activate cl

cl -> cl : setup()
activate cl
note right of cl : Registers game modules,\ninitializes core systems\n(Logic, Net, UI, World)
cl --> cl
deactivate cl

cl --> al : initialized
deactivate cl

loop game loop active
    os -> al : update()
    al -> cl : update()
    activate cl
    note right of cl : Advances game state,\nrenders frame,\nprocesses network I/O
    cl --> al
    deactivate cl
end

os -> al : onRequestPermissionsResult(\n  requestCode, permissions[], grantResults[])
activate al
note left of al : Handles runtime permission\nresponses (storage, network)\nand fires permCallback
al --> os : handled
deactivate al

deactivate al

@enduml
