@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
}

title Mindustry — Use Case Diagram

left to right direction

' ──────────────────────────────────────────
'  Actors
' ──────────────────────────────────────────
actor "Player"        as player
actor "Android User"  as android
actor "Server Admin"  as admin
actor "AI Controller" as ai

' Android User is a specialised Player
android -|> player

' ──────────────────────────────────────────
'  System boundary
' ──────────────────────────────────────────
rectangle "Mindustry Game System" {

    ' === Core Gameplay ===
    package "Core Gameplay" {
        usecase "Control Unit"              as UC_ControlUnit
        usecase "Issue Unit Command\n(Rally / Attack)" as UC_UnitCommand
        usecase "Build / Place Structure"   as UC_Build
        usecase "Transfer Items to Unit"    as UC_TransferItems
        usecase "Manage Liquids"            as UC_ManageLiquids
    }

    ' === Combat ===
    package "Combat" {
        usecase "Shoot / Attack"            as UC_Shoot
        usecase "Spawn Enemy Waves"         as UC_SpawnWave
    }

    ' === Item Distribution ===
    package "Item Distribution" {
        usecase "Route Items\n(Router / DuctRouter)" as UC_RouteItems
        usecase "Accept / Handle Item Stack" as UC_HandleItems
    }

    ' === Map & Editor ===
    package "Map & Editor" {
        usecase "Edit Map"                  as UC_EditMap
        usecase "View Map Info"             as UC_MapInfo
        usecase "Load / Save Map"           as UC_LoadSaveMap
        usecase "Generate Map Preview"      as UC_MapPreview
    }

    ' === Research & Progression ===
    package "Research & Progression" {
        usecase "Unlock Technology"         as UC_Unlock
        usecase "Complete Achievement"      as UC_Achievement
        usecase "Track Statistics"          as UC_Stats
    }

    ' === Multiplayer & Network ===
    package "Multiplayer & Network" {
        usecase "Connect to Server"         as UC_Connect
        usecase "Handle Network Command"    as UC_NetCommand
        usecase "Report Crash"              as UC_Crash
    }

    ' === Save System ===
    package "Save System" {
        usecase "Save / Load Game State"    as UC_SaveLoad
        usecase "Load Save Preview"         as UC_SavePreview
    }
}

' ──────────────────────────────────────────
'  Player associations
' ──────────────────────────────────────────
player --> UC_ControlUnit
player --> UC_UnitCommand
player --> UC_Build
player --> UC_TransferItems
player --> UC_ManageLiquids
player --> UC_EditMap
player --> UC_MapInfo
player --> UC_LoadSaveMap
player --> UC_Unlock
player --> UC_Achievement
player --> UC_Connect
player --> UC_SaveLoad
player --> UC_SavePreview

' ──────────────────────────────────────────
'  Server Admin associations
' ──────────────────────────────────────────
admin --> UC_Connect
admin --> UC_NetCommand
admin --> UC_Crash
admin --> UC_LoadSaveMap

' ──────────────────────────────────────────
'  AI Controller associations
' ──────────────────────────────────────────
ai --> UC_ControlUnit
ai --> UC_UnitCommand
ai --> UC_Shoot
ai --> UC_SpawnWave
ai --> UC_RouteItems
ai --> UC_HandleItems

' ──────────────────────────────────────────
'  Include / Extend relationships
' ──────────────────────────────────────────
' Controlling a unit optionally leads to shooting
UC_ControlUnit      ..> UC_Shoot          : <<extend>>

' Routing items always involves accepting/handling them
UC_RouteItems       ..> UC_HandleItems    : <<include>>

' Building a structure always involves item/stack handling
UC_Build            ..> UC_HandleItems    : <<include>>

' Completing an achievement always records stats
UC_Achievement      ..> UC_Stats          : <<include>>

' Map preview is generated when loading/saving a map
UC_LoadSaveMap      ..> UC_MapPreview     : <<include>>

' Save preview is loaded as part of save state management
UC_SaveLoad         ..> UC_SavePreview    : <<extend>>

@enduml
