@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam activity {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
    DiamondBackgroundColor #E9ECEF
    DiamondBorderColor #6C757D
}
skinparam swimlane {
    BorderColor #6C757D
    TitleBackgroundColor #DEE2E6
    TitleFontColor #212529
}

title Mindustry Android – App Launch & Script Context Lifecycle

|AndroidLauncher|
start

:onCreate(Bundle savedInstanceState);

:Initialize LibGDX AndroidApplication;

if (isTablet(context)?) then (yes)
    :Enable doubleScaleTablets;
    :Configure high-density display scale;
else (no)
    :Use default display scale;
endif

:checkFiles(Intent intent);

if (Intent contains a file URI?) then (yes)
    :Extract file from Intent;
    :Open FileChooser with file;
    :Queue file for mod loading;
else (no)
    :Continue normal startup;
endif

if (Storage permission required?) then (yes)
    :Set permCallback runnable;
    :requestPermissions(PERMISSION_REQUEST_CODE);

    |AndroidLauncher|
    :onRequestPermissionsResult\n(requestCode, permissions, grantResults);

    if (requestCode == PERMISSION_REQUEST_CODE?) then (yes)
        if (Permission granted?) then (yes)
            :Execute permCallback.run();
        else (no)
            :Log permission denial;
            :Continue without storage access;
        endif
    else (no)
        :Ignore unrecognised request code;
    endif
else (no)
    :No runtime permission needed;
endif

fork
    :Game logic and UI initialization;
fork again
    |AndroidRhinoContext|
    :enter(File cacheDirectory);
    :Create AndroidContextFactory\n(cacheDirectory);
    :Enter Rhino context\nvia factory.enterContext();

    |AndroidContextFactory|
    :createClassLoader(ClassLoader parent);

    if (cacheDirectory != null?) then (yes)
        :new FileAndroidClassLoader\n(parent, cacheDir);
    else (no)
        :new InMemoryAndroidClassLoader(parent);
    endif

    |ClassLoader (BaseAndroidClassLoader)|
    :defineClass(String name, byte[] data);
    :loadClass(Dex dex, String name);
    :linkClass(Class<?> aClass);
    :Class available for Rhino script execution;

    |AndroidContextFactory|
    :onContextReleased(Context cx);
    :((BaseAndroidClassLoader) cx\n    .getApplicationClassLoader()).reset();
    :Release cached Dex / class resources;
end fork

|AndroidLauncher|
:Application running;

stop

@enduml
