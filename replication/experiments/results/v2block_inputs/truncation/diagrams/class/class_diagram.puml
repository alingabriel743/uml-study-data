@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

title Mindustry — Class Diagram

' ─────────────────────────────────────────────
' External stubs (referenced via inheritance)
' ─────────────────────────────────────────────
package "External" #FFFFFF {
    abstract class AndroidApplication <<external>>
    abstract class ContextFactory <<external>>
    abstract class ClassLoader <<external>>
    abstract class AbstractProcessor <<external>>
    interface GeneratedClassLoader <<external>>
    interface Visitor <<external>>
}

' ─────────────────────────────────────────────
' mindustry.android
' ─────────────────────────────────────────────
package "mindustry.android" {

    class AndroidLauncher {
        +{static} final int PERMISSION_REQUEST_CODE = 1
        ~boolean doubleScaleTablets
        ~FileChooser chooser
        ~Runnable permCallback
        +onCreate(Bundle savedInstanceState)
        +onRequestPermissionsResult(int, String[], int[])
        ~checkFiles(Intent intent)
        +{static} isTablet(Context context)
    }

    class AndroidRhinoContext {
        +{static} enter(File cacheDirectory)
    }

    class AndroidContextFactory {
        -final File cacheDirectory
        +AndroidContextFactory(File cacheDirectory)
        +createClassLoader(ClassLoader parent)
        +onContextReleased(Context cx)
    }

    abstract class BaseAndroidClassLoader {
        +BaseAndroidClassLoader(ClassLoader parent)
        +defineClass(String name, byte[] data)
        +loadClass(Dex dex, String name)
        +getLastDex()
        +reset()
        #linkClass(Class<?> aClass)
        +loadClass(String name, boolean resolve)
    }

    class FileAndroidClassLoader {
        -{static} int instanceCounter = 0
        -final File dexFile
        +FileAndroidClassLoader(ClassLoader parent, File cacheDir)
        +loadClass(Dex dex, String name)
        +getLastDex()
        +reset()
    }

    class InMemoryAndroidClassLoader {
        -Dex last
        +InMemoryAndroidClassLoader(ClassLoader parent)
        +loadClass(Dex dex, String name)
        +getLastDex()
        +reset()
    }
}

' ─────────────────────────────────────────────
' mindustry.annotations
' ─────────────────────────────────────────────
package "mindustry.annotations" {

    class Annotations {
    }

    enum PacketPriority {
        low
        normal
        high
    }

    enum Loc {
        server(true, false)
        client(false, true)
        both(true, true)
        none(false, false)
    }

    enum Variant {
        one(true, false)
        all(false, true)
        both(true, true)
    }

    abstract class BaseProcessor {
        +{static} final String packageName = "mindustry.gen"
        +{static} Types typeu
        +{static} Elements elementu
        +{static} Filer filer
        +{static} Messager messager
        +{static} Trees trees
        #int round
        #int rounds = 1
        #RoundEnvironment env
        #Fi rootDirectory
        +init(ProcessingEnvironment env)
        +process(Set<TypeElement>, RoundEnvironment): boolean
        +getSupportedSourceVersion()
        #{abstract} process(RoundEnvironment env)
        +elements(Class<Annotation>)
        +types(Class<Annotation>)
        +write(TypeSpec.Builder builder)
        +err(String message)
    }
}

' ─────────────────────────────────────────────
' mindustry.annotations.entity
' ─────────────────────────────────────────────
package "mindustry.annotations.entity" {

    class EntityIO {
        -{static} final Json json
        -{static} final String targetSuf
        -{static} final StringMap replacements
        -final ClassSerializer serializer
        -final String name
        -final TypeSpec.Builder type
        -final Fi directory
        -final Seq<Revision> revisions
        -boolean write
        -MethodSpec.Builder method
        -ObjectSet<String> presentFields
        +EntityIO(String, TypeSpec.Builder, Seq<FieldSpec>, ClassSerializer, Fi)
        +write(MethodSpec.Builder, boolean, Seq<Svar>)
        +writeSync(MethodSpec.Builder, boolean, Seq<Svar>)
        +writeInterpolate(MethodSpec.Builder, Seq<Svar>)
    }

    class Revision {
        ~int version
        ~Seq<RevisionField> fields
        +Revision(int version, Seq<RevisionField> fields)
        +equal(Seq<FieldSpec> specs)
    }

    class RevisionField {
        ~String name
        ~String type
        +RevisionField(String name, String type)
    }

    class EntityProcess {
        ~Seq<EntityDefinition> definitions
        ~Seq<GroupDefinition> groupDefs
        ~Seq<Stype> baseComponents
        ~ObjectMap<String, Stype> componentNames
        ~ObjectMap<Stype, Seq<Stype>> componentDependencies
        ~ObjectMap<String, String> varInitializers
        ~ObjectMap<String, String> methodBlocks
        ~ClassSerializer serializer
        +process(RoundEnvironment env)
        +allComponents(Selement<?> type)
        +getDependencies(Stype component)
        +createName(Selement<?> elem)
    }

    class GroupDefinition {
        +final String name
        +final ClassName baseType
        +final Seq<Stype> components
        +final boolean spatial
        +final boolean mapping
        +final boolean collides
        +final ObjectSet<Selement> manualInclusions
        +GroupDefinition(String, ClassName, Seq<Stype>, boolean, boolean, boolean)
        +toString()
    }

    class EntityDefinition {
        +final Seq<GroupDefinition> groups
        +final Seq<Stype> components
        +final Seq<FieldSpec> fieldSpecs
        +final TypeSpec.Builder builder
        +final Selement naming
        +final String name
        +final TypeName extend
        +final boolean legacy
        +int classID
        +EntityDefinition(String, Builder, Selement, TypeName, Seq<Stype>, Seq<GroupDefinition>, Seq<FieldSpec>, boolean)
        +toString()
    }
}

' ─────────────────────────────────────────────
' mindustry.annotations.impl
' ─────────────────────────────────────────────
package "mindustry.annotations.impl" {

    class AssetsProcess {
        +process(RoundEnvironment env)
        +processUI(Set<Element> elements)
        +processSounds(String, String, String, boolean)
