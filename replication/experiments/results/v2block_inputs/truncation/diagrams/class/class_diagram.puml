}

' ─────────────────────────────────────────────
' mindustry.annotations.remote
' ─────────────────────────────────────────────
package "mindustry.annotations.remote" {

    class RemoteProcess {
        +{static} final String callLocation = "Call"
        +process(RoundEnvironment roundEnv)
    }

    class CallGenerator {
        +generate(ClassSerializer, Seq<MethodEntry>)
        +makeWriter(TypeSpec.Builder, MethodEntry, ClassSerializer)
        +makeReader(TypeSpec.Builder, MethodEntry, ClassSerializer)
        +writeCallMethod(TypeSpec.Builder, MethodEntry, boolean, boolean)
        +getCheckString(Loc loc)
        +writeHandleMethod(MethodEntry, boolean)
    }

    class MethodEntry {
        +final String className
        +final String targetMethod
        +final String packetClassName
        +final Loc where
        +final Variant target
        +final Loc local
        +final boolean unreliable
        +final boolean forward
        +final int id
        +final Smethod element
        +final PacketPriority priority
        +MethodEntry(String, String, String, Loc, Variant, Loc, boolean, boolean, int, Smethod, PacketPriority)
        +hashCode()
    }

    class SerializerResolver {
        +locate(ExecutableElement, TypeMirror, boolean)
        +isEntity(TypeMirror mirror)
    }
}

' ─────────────────────────────────────────────
' mindustry.annotations.util
' ─────────────────────────────────────────────
package "mindustry.annotations.util" {

    class Selement<T> {
        +final T e
        +Selement(T e)
        +doc()
        +enclosed()
        +fullName()
        +asType()
        +asVar()
        +asMethod()
        +isVar()
        +isType()
        +isMethod()
        +annotation(Class<A>)
        +has(Class<A>)
        +name()
        +toString()
        +equals(Object o)
    }

    class Smethod {
        +Smethod(ExecutableElement)
        +isAny(Modifier... mod)
        +descString()
        +is(Modifier mod)
        +type()
        +params()
        +isVoid()
        +ret()
        +tree()
    }

    class Stype {
        +Stype(TypeElement)
        +{static} of(TypeMirror mirror)
        +fullName()
        +interfaces()
        +allInterfaces()
        +isInterface()
        +superclasses()
        +superclass()
        +fields()
        +methods()
        +constructors()
    }

    class Svar {
        +Svar(VariableElement e)
        +descString()
        +enclosingType()
        +isAny(Modifier... mods)
        +is(Modifier mod)
        +tree()
    }

    class AnnotationProxyMaker {
        -final Compound anno
        -final Class<? extends Annotation> annoType
        +AnnotationProxyMaker(Compound, Class<? extends Annotation>)
        +{static} generateAnnotation(Compound, Class<A>)
        +getAllReflectedValues()
        +getAllValues()
        +generateValue(MethodSymbol, Attribute)
    }

    class ValueVisitor {
        -MethodSymbol meth
        -Class<?> returnClass
        -Object value
        +ValueVisitor(MethodSymbol)
        +getValue(Attribute)
        +visitConstant(Constant)
        +visitClass(Attribute.Class)
        +visitArray(Array)
        +visitEnum(Enum)
        +visitCompound(Compound)
        +visitError(Error)
    }

    class TypeIOResolver {
        +{static} resolve(BaseProcessor processor)
        -{static} fix(String str)
    }
}

' ══════════════════════════════════════════════
' RELATIONSHIPS
' ══════════════════════════════════════════════

' mindustry.android inheritance
AndroidLauncher --|> AndroidApplication
AndroidContextFactory --|> ContextFactory
BaseAndroidClassLoader --|> ClassLoader
BaseAndroidClassLoader ..|> GeneratedClassLoader
FileAndroidClassLoader --|> BaseAndroidClassLoader
InMemoryAndroidClassLoader --|> BaseAndroidClassLoader

' Annotation processor hierarchy
BaseProcessor --|> AbstractProcessor
EntityProcess --|> BaseProcessor
AssetsProcess --|> BaseProcessor
StructProcess --|> BaseProcessor
LoadRegionProcessor --|> BaseProcessor
LogicStatementProcessor --|> BaseProcessor
RemoteProcess --|> BaseProcessor

' util hierarchy
Smethod --|> Selement
Stype --|> Selement
Svar --|> Selement

' Visitor implementation
ValueVisitor ..|> Visitor

' Composition: EntityIO owns Revision objects
EntityIO *-- Revision : revisions
Revision *-- RevisionField : fields

' EntityProcess owns GroupDefinition and EntityDefinition
EntityProcess *-- GroupDefinition : groupDefs
EntityProcess *-- EntityDefinition : definitions
EntityDefinition o-- GroupDefinition : groups

' AnnotationProxyMaker contains ValueVisitor
AnnotationProxyMaker *-- ValueVisitor : inner class

' MethodEntry references enums from Annotations
MethodEntry ..> Loc : where / local
MethodEntry ..> Variant : target
MethodEntry ..> PacketPriority : priority

' CallGenerator uses MethodEntry
CallGenerator ..> MethodEntry : generates

' EntityIO used by EntityProcess
EntityProcess ..> EntityIO : creates

' TypeIOResolver depends on BaseProcessor
TypeIOResolver ..> BaseProcessor : resolve()

@enduml
