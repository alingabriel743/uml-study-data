@startuml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}

skinparam sequenceArrowThickness 2
skinparam roundcorner 5
skinparam sequence {
    ActorBackgroundColor #F8F9FA
    ActorBorderColor #495057
    ParticipantBackgroundColor #F8F9FA
    ParticipantBorderColor #495057
    ArrowColor #495057
    FontColor #212529
    LifeLineBorderColor #6C757D
    LifeLineBackgroundColor #E9ECEF
    BoxBackgroundColor #E9ECEF
    BoxBorderColor #6C757D
}

title Mindustry Android — App Launch & Rhino JS Class Loading

actor "Android OS" as OS
participant "AndroidLauncher\n(extends AndroidApplication)" as launcher
participant "FileChooser" as chooser
participant "permCallback\n(Runnable)" as callback
participant "AndroidContextFactory\n(extends ContextFactory)" as factory
participant "AndroidRhinoContext" as rhinoCtx
participant "FileAndroidClassLoader" as fileLoader
participant "InMemoryAndroidClassLoader" as memLoader
participant "BaseAndroidClassLoader\n(extends ClassLoader)" as baseLoader

== Android Application Launch ==

OS -> launcher : onCreate(savedInstanceState)
activate launcher

launcher -> launcher : isTablet(context)
note right : Checks display metrics\nto determine tablet layout
activate launcher
launcher --> launcher : boolean
deactivate launcher

launcher -> launcher : checkFiles(intent)
activate launcher
launcher --> launcher
deactivate launcher

launcher -> OS : requestPermissions(PERMISSION_REQUEST_CODE = 1)
deactivate launcher

== Runtime Permission Result ==

OS -> launcher : onRequestPermissionsResult(\n  requestCode, permissions[], grantResults[])
activate launcher

alt requestCode == PERMISSION_REQUEST_CODE && all permissions granted
    launcher -> callback : run()
    activate callback
    callback --> launcher
    deactivate callback
else permission denied or wrong request code
    launcher --> OS : (no-op)
end

deactivate launcher

== Rhino JavaScript Engine: Context Factory Setup ==

OS -> factory : new AndroidContextFactory(cacheDirectory)
activate factory
note right : Stores cacheDirectory\nfor class loader creation
factory --> OS : factory instance
deactivate factory

OS -> rhinoCtx : enter(cacheDirectory)
activate rhinoCtx

rhinoCtx -> factory : createClassLoader(parentClassLoader)
activate factory

alt cacheDirectory is available on disk
    factory -> fileLoader : new FileAndroidClassLoader(parent, cacheDir)
    activate fileLoader
    fileLoader -> baseLoader : super(parent)
    activate baseLoader
    baseLoader --> fileLoader
    deactivate baseLoader
    fileLoader --> factory : fileLoader instance
    deactivate fileLoader
else no persistent cache available
    factory -> memLoader : new InMemoryAndroidClassLoader(parent)
    activate memLoader
    memLoader -> baseLoader : super(parent)
    activate baseLoader
    baseLoader --> memLoader
    deactivate baseLoader
    memLoader --> factory : memLoader instance
    deactivate memLoader
end

factory --> rhinoCtx : GeneratedClassLoader
deactivate factory

rhinoCtx --> OS : Context
deactivate rhinoCtx

== Class Loading: Defining & Linking Generated Classes ==

OS -> baseLoader : loadClass(dex, name)
activate baseLoader

baseLoader -> baseLoader : defineClass(name, data)
activate baseLoader
note right : Converts raw bytecode\ninto a Class<?> object
baseLoader --> baseLoader : Class<?>
deactivate baseLoader

baseLoader -> baseLoader : linkClass(aClass)
activate baseLoader
note right : Resolves class references\nand prepares for execution
baseLoader --> baseLoader
deactivate baseLoader

baseLoader --> OS : Class<?>
deactivate baseLoader

OS -> baseLoader : loadClass(name, resolve)
activate baseLoader
baseLoader --> OS : Class<?>
deactivate baseLoader

OS -> baseLoader : getLastDex()
activate baseLoader
baseLoader --> OS : Dex
deactivate baseLoader

== Context Release & Cleanup ==

OS -> factory : onContextReleased(cx)
activate factory

factory -> baseLoader : reset()
activate baseLoader
note right : Clears cached Dex data
baseLoader --> factory
deactivate baseLoader

factory --> OS
deactivate factory

@enduml
