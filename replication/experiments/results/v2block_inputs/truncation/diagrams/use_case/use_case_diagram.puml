@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam backgroundColor #FEFEFE
skinparam class {
    BackgroundColor #F8F9FA
    BorderColor #495057
    ArrowColor #495057
    FontColor #212529
}
skinparam package {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
}
skinparam usecase {
    BackgroundColor #F8F9FA
    BorderColor #495057
    FontColor #212529
    ArrowColor #495057
}
skinparam actor {
    BackgroundColor #DEE2E6
    BorderColor #495057
    FontColor #212529
}
skinparam rectangle {
    BackgroundColor #E9ECEF
    BorderColor #6C757D
    FontColor #343A40
}
skinparam note {
    BackgroundColor #FFF3CD
    BorderColor #FFC107
}

title Mindustry — Use Case Diagram

left to right direction

'─────────── Actors ───────────
actor "Player" as player
actor "Admin" as admin
actor "Server\n(Headless/Hosted)" as server

admin --|> player

'─────────── System Boundary ───────────
rectangle "Mindustry Game" {

    '── Single-Player / Campaign ──
    package "Campaign & Single-Player" {
        usecase "Play Campaign\n(Planet / Sector)" as UC_Campaign
        usecase "Launch Custom Game" as UC_CustomGame
        usecase "Save Game" as UC_Save
        usecase "Load Saved Game" as UC_Load
        usecase "Research Technologies" as UC_Research
        usecase "Configure Custom Rules" as UC_CustomRules
    }

    '── In-Game Actions ──
    package "In-Game Actions" {
        usecase "Place / Remove Blocks" as UC_PlaceBlocks
        usecase "Configure Block" as UC_ConfigBlock
        usecase "View Block Inventory" as UC_Inventory
        usecase "Mine Resources" as UC_Mine
        usecase "Command Units" as UC_CommandUnits
        usecase "Use Schematics" as UC_Schematics
        usecase "Pause / Resume Game" as UC_Pause
    }

    '── Multiplayer ──
    package "Multiplayer" {
        usecase "Host Multiplayer Game" as UC_Host
        usecase "Join Game via Server Browser" as UC_JoinBrowser
        usecase "Join Game via Direct IP" as UC_JoinIP
        usecase "Send Chat Message" as UC_Chat
        usecase "Vote to Kick Player" as UC_VoteKick
        usecase "View Player List" as UC_PlayerList
    }

    '── Admin / Moderation ──
    package "Administration" {
        usecase "Manage Admins" as UC_ManageAdmins
        usecase "Manage Bans" as UC_ManageBans
        usecase "Kick / Ban Player" as UC_KickBan
        usecase "Trace Player Activity" as UC_Trace
        usecase "Open / Close Server" as UC_OpenServer
        usecase "Assign Teams" as UC_AssignTeams
    }

    '── Map Editor ──
    package "Map Editor" {
        usecase "Create / Edit Map" as UC_EditMap
        usecase "Generate Map Procedurally" as UC_GenerateMap
        usecase "Configure Wave Enemies" as UC_ConfigWaves
        usecase "Set Map Objectives" as UC_MapObjectives
        usecase "Set Map Info & Locales" as UC_MapInfo
        usecase "Export / Import Map" as UC_ExportMap
    }

    '── Settings & Customisation ──
    package "Settings & Customisation" {
        usecase "Change Game Settings" as UC_Settings
        usecase "Configure Key Bindings" as UC_Keybinds
        usecase "Change Language" as UC_Language
        usecase "Manage Mods" as UC_Mods
        usecase "View Content Database" as UC_Database
        usecase "View About / Credits" as UC_About
    }
}

'─────────── Player relationships ───────────
player --> UC_Campaign
player --> UC_CustomGame
player --> UC_Save
player --> UC_Load
player --> UC_Research
player --> UC_PlaceBlocks
player --> UC_Mine
player --> UC_CommandUnits
player --> UC_Schematics
player --> UC_Pause
player --> UC_JoinBrowser
player --> UC_JoinIP
player --> UC_Chat
player --> UC_VoteKick
player --> UC_PlayerList
player --> UC_EditMap
player --> UC_Settings
player --> UC_Keybinds
player --> UC_Language
player --> UC_Mods
player --> UC_Database
player --> UC_About

'─────────── Admin relationships ───────────
admin --> UC_ManageAdmins
admin --> UC_ManageBans
admin --> UC_KickBan
admin --> UC_Trace
admin --> UC_Host
admin --> UC_OpenServer
admin --> UC_AssignTeams

'─────────── Server relationships ───────────
server --> UC_OpenServer
server --> UC_AssignTeams
server --> UC_KickBan

'─────────── Include / Extend ───────────
UC_CustomGame .> UC_CustomRules : <<include>>
UC_Host       .> UC_CustomRules : <<include>>
UC_PlaceBlocks .> UC_ConfigBlock : <<extend>>
UC_PlaceBlocks .> UC_Inventory   : <<extend>>
UC_EditMap    .> UC_GenerateMap  : <<extend>>
UC_EditMap    .> UC_ConfigWaves  : <<extend>>
UC_EditMap    .> UC_MapObjectives : <<extend>>
UC_EditMap    .> UC_MapInfo      : <<extend>>
UC_EditMap    .> UC_ExportMap    : <<extend>>
UC_JoinBrowser .> UC_JoinIP      : <<extend>>
UC_VoteKick   .> UC_Chat         : <<include>>

@enduml
